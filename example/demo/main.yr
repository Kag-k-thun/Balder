in main;

use balder::math::_;
use balder::core::{_, application::_, driver, memory, shader};
use balder::interface;
use balder::interface::_;
use balder::interface::widget;
use balder::interface::widget::{button, layout::_, text::_};
use balder::scene::node::{_, node3D::_, node3D::camera, node3D::visual::_, node3D::visual::material::_};
use balder::scene::utils::post::tonemap::operator;
use balder::utils;
use balder::utils::path;

use sdl3::_;

use vulkan;

use std::{config::_, io, math, rand, time::_};
use std::fs;
use std::fs::_;
use std::fs::path;

/**
 * The number of subjects on a side of the crowd standing behind the three in front, set by '--crowd'
 * */
lazy dmut __CROWD__ = copy [0us];

/**
 * The model of the three subjects in front and of the crowd (a glTF file, an OBJ file...), set by '--subject'
 * */
lazy mut __SUBJECT__: [mut [c8]] = copy ["res:/models/suzanne/Suzanne.gltf"];

/**
 * True to cull the instances on the GPU from the start, set by '--gpu-cull' ('G' toggles it)
 * */
lazy dmut __GPU_CULL__ = copy [false];

/**
 * True to cull the instances hidden behind others too when they are culled on the GPU, set by '--occlusion' ('O' toggles
 * it)
 * */
lazy dmut __OCCLUSION__ = copy [false];

/**
 * True for the light to cast shadows from the start, set by '--shadows' ('H' toggles it)
 * */
lazy dmut __SHADOWS__ = copy [false];

/**
 * True for the ambient occlusion of the screen to shade the ambient light from the start, set by '--ambient-occlusion'
 * ('A' toggles it)
 * */
lazy dmut __AMBIENT_OCCLUSION__ = copy [false];

/**
 * The size of the images of the ambient occlusion, in shares of the size of the scene, set by '--occlusion-scale'
 * */
lazy dmut __OCCLUSION_SCALE__ = copy [1.0f];

/**
 * The model (a glTF file, an OBJ file...) standing beside the subjects, set by '--model', empty for none
 * */
lazy mut __MODEL__: [mut [c8]] = copy [""];

/**
 * The exposure of the camera at the start, in stops, set by '--exposure' ('Page Up' and 'Page Down' changing it)
 * */
lazy dmut __EXPOSURE__ = copy [0.0f];

/**
 * The operator of the tone mapping at the start, set by '--tone-map' ('T' cycling through them)
 * */
lazy dmut __TONE_MAP__ = copy [ToneMap::AGX];

/**
 * The file the render graph is written to in json, set by '--graph' ('X' writes it again), empty for none
 * */
lazy mut __GRAPH__: [mut [c8]] = copy [""];

class MyActivity over Activity {

    let dmut _scene: (&Scene)?   = none;
    let dmut _lbl: (&Label)?     = none;
    let dmut _culling: (&Label)? = none;
    let dmut _cam: (&Camera)?    = none;
    let dmut _light: (&Light)?   = none;

    let mut _angle: f32 = 0.0f;

    // The frames drawn before the render graph is written once, the scene being declared in it by then
    let mut _graphCountdown: u32 = 10u32;
    let mut _dist: f32  = 8.0f;

    let mut _movingCam: bool      = false;
    let mut _camStart: (i32, i32) = (0, 0);
    let mut _yaw: f32             = 0.0f;
    let mut _pitch: f32           = 45.0f;
    let mut _camSens: f32         = 1.0f / 5.0f;

    let mut _target: vec3               = makeVec3(0.0f, 0.0f, 0.0f);
    let dmut _subject: (&Node3D)?       = none;
    let dmut _camSpeed: (f32, f32, f32) = (0.0f, 0.0f, 100.0f);
    let dmut _forward: vec3             = makeVec3(0.0f, 0.0f, 0.0f);
    let dmut _right: vec3               = makeVec3(0.0f, 0.0f, 0.0f);

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==============================          ACTIVITY MANAGEMENT          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);

        // Connect the camera to the mouse events
        self.input:.mouseWheel():.connect(self.box, &self:.onWheel);
        self.input:.mouse(MouseInfo(SDL_BUTTON_MIDDLE, KeyEvent::DOWN)):.connect(self.box, &self:.onCameraEnter);
        self.input:.mouse(MouseInfo(SDL_BUTTON_MIDDLE, KeyEvent::RELEASE)):.connect(self.box, &self:.onCameraExit);

        self.input:.keyboard(KeyInfo(SDLK_Z, KeyEvent::ALL)):.connect(self.box, &self:.onMoveForward);
        self.input:.keyboard(KeyInfo(SDLK_S, KeyEvent::ALL)):.connect(self.box, &self:.onMoveBackward);
        self.input:.keyboard(KeyInfo(SDLK_Q, KeyEvent::ALL)):.connect(self.box, &self:.onMoveLeft);
        self.input:.keyboard(KeyInfo(SDLK_D, KeyEvent::ALL)):.connect(self.box, &self:.onMoveRight);
        self.input:.keyboard(KeyInfo(SDLK_LSHIFT, KeyEvent::ALL)):.connect(self.box, &self:.onShift);

        self.input:.keyboard(KeyInfo(SDLK_P, KeyEvent::DOWN)):.connect(self.box, &self:.onOpenAlert);
        self.input:.keyboard(KeyInfo(SDLK_G, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleCulling);
        self.input:.keyboard(KeyInfo(SDLK_O, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleOcclusion);
        self.input:.keyboard(KeyInfo(SDLK_H, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleShadows);
        self.input:.keyboard(KeyInfo(SDLK_A, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleAmbientOcclusion);
        self.input:.keyboard(KeyInfo(SDLK_X, KeyEvent::DOWN)):.connect(self.box, &self:.onExportGraph);
        self.input:.keyboard(KeyInfo(SDLK_PAGEUP, KeyEvent::DOWN)):.connect(self.box, &self:.onExposeMore);
        self.input:.keyboard(KeyInfo(SDLK_PAGEDOWN, KeyEvent::DOWN)):.connect(self.box, &self:.onExposeLess);
        self.input:.keyboard(KeyInfo(SDLK_T, KeyEvent::DOWN)):.connect(self.box, &self:.onCycleToneMap);
        self.input:.keyboard(KeyInfo(SDLK_V, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleVignette);
        self.input:.keyboard(KeyInfo(SDLK_I, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleInvert);
        self.input:.keyboard(KeyInfo(SDLK_B, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleBloom);
        self.input:.keyboard(KeyInfo(SDLK_L, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleGrading);
        self.input:.keyboard(KeyInfo(SDLK_F, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleFxaa);
        self.input:.keyboard(KeyInfo(SDLK_M, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleTaa);

        self.input:.mouseMotion():.connect(self.box, &self:.onMouseMove);

        // Loading the screen content
        //
        println("StyleSheet : ", self.gui:.loadStyleFile("res:/config/app.style")?);
        println("GUI : ", self.gui:.loadGUIFile("res:/config/app.gui")?);

        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("scene") {
            self._scene = w:.getScene();
        }

        if let Ok(dmut l: &Label) = self.gui:.find("fps") {
            self._lbl = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("culling") {
            self._culling = (alias l)?;
        }

        {
            if let Ok(dmut s: &Scene) = alias self._scene {
                self:.createBoxMesh(alias s);
                self:.createCamera(alias s);
                self:.createLight(alias s);
                s.gpuCulling = __GPU_CULL__[0];
                s.occlusionCulling = __OCCLUSION__[0];
                s.toneMap = __TONE_MAP__[0];
                s.ambientOcclusion = __AMBIENT_OCCLUSION__[0];
                s.occlusionScale = __OCCLUSION_SCALE__[0];
            }
        } catch {
            err => {
                log::error #("Main", "Failed to load mesh", err);
            }
        }
    }

    over onUpdate(mut self, _delta_: Duration) {
        if self._graphCountdown != 0u32 {
            self._graphCountdown -= 1u32;
            if self._graphCountdown == 0u32 {
                self:.onExportGraph(KeyInfo(SDLK_X, KeyEvent::DOWN));
            }
        }

        if let Ok(dmut lbl) = alias self._lbl {
            lbl:.setText(std::conv::to!{[c8]} (self.window.getNbFramesLastSecond()));
        }

        if let Ok(dmut lbl) = alias self._culling {
            if let Ok(s) = self._scene {
                let stats = s.cullStats;
                let draws = s.drawStats;
                if s.gpuCulling {
                    let occlusion = if s.occlusionCulling { " with occlusion" } else { "" };
                    lbl:.setText(std::format::format("{} nodes culled on the GPU{}, drawn by {} multi-draws, {} commands, {} instances",
                                                     stats.considered, occlusion, draws.multiDraws, draws.commands, draws.instances));
                } else {
                    lbl:.setText(std::format::format("{} nodes, {} visited: {} outside, {} small, {} drawn by {} multi-draws, {} commands, {} instances",
                                                     stats.considered, stats.visited, stats.outside, stats.small, stats.visible,
                                                     draws.multiDraws, draws.commands, draws.instances));
                }
            }
        }

        if self._camSpeed._0 != 0.0f || self._camSpeed._1 != 0.0f {
            let speed = cast!f32(_delta_.millis) / self._camSpeed._2;
            self._target += (self._camSpeed._0 * speed * self._forward) + (self._camSpeed._1 * speed * self._right);

            self:.computeCamPosition();
        }
    }

    pub fn onQuit(mut self) {
        log::info #("Main", "Closing app");
        self.app:.close(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CAMERA INPUTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn onWheel(mut self, _: i32, _: i32, _: i32, w: i32) {
        self._dist -= cast!f32(w) / 10.0f;
        self:.computeCamPosition();
    }

    pub fn onCameraEnter(mut self, x: i32, y: i32, _: MouseInfo) {
        self._movingCam = true;
        self._camStart = (x, y);
    }

    pub fn onCameraExit(mut self, _: i32, _: i32, _: MouseInfo) {
        self._movingCam = false;
        self._camStart = (0, 0);
    }

    pub fn onMouseMove(mut self, x: i32, y: i32) {
        if self._movingCam {
            self._yaw += (cast!f32(self._camStart._0 - x) * self._camSens);
            self._yaw %= 360.0f;

            self._pitch += cast!f32(self._camStart._1 - y) * self._camSens;
            self._pitch = std::algorithm::comparison::clamp(self._pitch, -45.0f, 89.0f);

            self._camStart = (x, y);

            self:.computeCamPosition();
        }
    }

    pub fn onMoveForward(mut self, info: KeyInfo) {
        if info.type == KeyEvent::DOWN {
            self._camSpeed._0 -= 0.5f;
        } else if info.type == KeyEvent::RELEASE {
            self._camSpeed._0 += 0.5f;
        }
    }

    pub fn onMoveBackward(mut self, info: KeyInfo) {
        if info.type == KeyEvent::DOWN {
            self._camSpeed._0 += 0.5f;
        } else if info.type == KeyEvent::RELEASE {
            self._camSpeed._0 -= 0.5f;
        }
    }

    pub fn onMoveLeft(mut self, info: KeyInfo) {
        if info.type == KeyEvent::DOWN {
            self._camSpeed._1 += 0.5f;
        } else if info.type == KeyEvent::RELEASE {
            self._camSpeed._1 -= 0.5f;
        }
    }

    pub fn onMoveRight(mut self, info: KeyInfo) {
        if info.type == KeyEvent::DOWN {
            self._camSpeed._1 -= 0.5f;
        } else if info.type == KeyEvent::RELEASE {
            self._camSpeed._1 += 0.5f;
        }
    }

    pub fn onShift(mut self, info: KeyInfo) {
        if info.type == KeyEvent::DOWN {
            self._camSpeed._2 = 200.0f;
        } else if info.type == KeyEvent::RELEASE {
            self._camSpeed._2 = 100.0f;
        }
    }

    /**
     * Cull the instances on the GPU, or on the CPU again
     * */
    fn onToggleCulling(mut self, _: KeyInfo) {
        if let Ok(dmut s) = alias self._scene {
            s.gpuCulling = !s.gpuCulling;
            log::info #("Main", "GPU culling :", s.gpuCulling);
        }
    }

    /**
     * Cull the instances hidden behind others too when they are culled on the GPU, or stop culling them
     * */
    fn onToggleOcclusion(mut self, _: KeyInfo) {
        if let Ok(dmut s) = alias self._scene {
            s.occlusionCulling = !s.occlusionCulling;
            log::info #("Main", "Occlusion culling :", s.occlusionCulling);
        }
    }

    /**
     * Cast the shadows of the light, or stop casting them
     * */
    fn onToggleShadows(mut self, _: KeyInfo) {
        if let Ok(dmut l) = alias self._light {
            l.castShadow = !l.castShadow;
            log::info #("Main", "Shadows :", l.castShadow);
        }
    }

    /**
     * Shade the ambient light by the ambient occlusion of the screen, or stop shading it
     * */
    fn onToggleAmbientOcclusion(mut self, _: KeyInfo) {
        if let Ok(dmut s) = alias self._scene {
            s.ambientOcclusion = !s.ambientOcclusion;
            log::info #("Main", "Ambient occlusion :", s.ambientOcclusion);
        }
    }

    /**
     * Raise the exposure of the camera by half a stop
     * */
    fn onExposeMore(mut self, _: KeyInfo) {
        self:.expose(0.5f);
    }

    /**
     * Lower the exposure of the camera by half a stop
     * */
    fn onExposeLess(mut self, _: KeyInfo) {
        self:.expose(-0.5f);
    }

    /**
     * Change the exposure of the camera by a number of stops
     * */
    fn expose(mut self, stops: f32) {
        if let Ok(dmut cam) = alias self._cam {
            cam.exposure = cam.exposure + stops;
            log::info #("Main", "Exposure :", cam.exposure);
        }
    }

    /**
     * Tone map the scene with the next operator: none, ACES, then AgX
     * */
    fn onCycleToneMap(mut self, _: KeyInfo) {
        if let Ok(dmut s) = alias self._scene {
            s.toneMap = match s.toneMap {
                ToneMap::NONE => { ToneMap::ACES }
                ToneMap::ACES => { ToneMap::AGX }
                _             => { ToneMap::NONE }
            };

            log::info #("Main", "Tone mapping :", s.toneMap);
        }
    }

    /**
     * Enable or disable the vignette of the post-process chain of the scene, described in app.gui
     * */
    fn onToggleVignette(mut self, _: KeyInfo) {
        self:.togglePostEffect("vignette");
    }

    /**
     * Enable or disable the inversion of the colours of the post-process chain of the scene, described in app.gui
     * */
    fn onToggleInvert(mut self, _: KeyInfo) {
        self:.togglePostEffect("invert");
    }

    /**
     * Enable or disable the bloom of the post-process chain of the scene, described in app.gui
     * */
    fn onToggleBloom(mut self, _: KeyInfo) {
        self:.togglePostEffect("bloom");
    }

    /**
     * Enable or disable the colour grading through a LUT of the post-process chain of the scene, described in app.gui
     * */
    fn onToggleGrading(mut self, _: KeyInfo) {
        self:.togglePostEffect("lut");
    }

    /**
     * Enable or disable the anti-aliasing (FXAA) of the post-process chain of the scene, described in app.gui
     * */
    fn onToggleFxaa(mut self, _: KeyInfo) {
        self:.togglePostEffect("fxaa");
    }

    /**
     * Enable or disable the anti-aliasing (TAA) of the post-process chain of the scene, described in app.gui
     * */
    fn onToggleTaa(mut self, _: KeyInfo) {
        self:.togglePostEffect("taa");
    }


    /**
     * Enable or disable an effect of the post-process chain of the scene, its passes declared again in the render graph
     * */
    fn togglePostEffect(mut self, name: [c8]) {
        if let Ok(dmut s) = alias self._scene {
            let dmut chain = s:.getPostChain();
            let enabled = !chain.isEnabled(name);
            if chain:.enable(name, enabled) {
                log::info #("Main", "Post effect", name, ":", enabled);
            }
        }
    }

    /**
     * Write the render graph of the window in json in the file of '--graph', the passes of the last frame drawn
     * (tools/passgraph draws it)
     * */
    fn onExportGraph(mut self, _: KeyInfo) {
        let path = __GRAPH__[0];
        if path == "" { return; }

        {
            let dmut file = File::create(Path(path), write-> true);
            file:.write(json::dump(self.window:.getVulkanPipeline().exportGraph()));
            log::info #("Main", "Render graph written to", path);
        } catch {
            err => {
                log::error #("Main", "Failed to write the render graph to", path, err);
            }
        }
    }

    fn onOpenAlert(mut self, _: KeyInfo) {
        let dmut app  = alias self.app;
        let dmut diag = copy MessageDialog(alias app, "Hello, are you alright?");
        diag:.execute();

        match diag.status {
            message::MessageDialogStatus::YES => {
                println("YES!!");
            }
            message::MessageDialogStatus::NO => {
                println("No...");
            }
            _ => {
                println("no answer...");
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn createBoxMesh(mut self, dmut scene: &Scene)
        throws BalderError
    {
        // three subjects side by side, drawn at the levels of detail 0, 2 and 4 from left to right, the last two sharing
        // the geometry of the first
        let dmut __subject__ = copy SolidObjectModel::fromFile("subject", scene:.getRootNode(), __SUBJECT__[0]);
        self:.placeSubject(alias __subject__, -3.0f, 0.0f, (0us)?);

        let dmut lod2 = copy SolidObjectModel::copyOf("subject_lod_2", scene:.getRootNode(), alias __subject__);
        self:.placeSubject(alias lod2, 0.0f, 0.0f, (2us)?);

        let dmut lod4 = copy SolidObjectModel::copyOf("subject_lod_4", scene:.getRootNode(), alias __subject__);
        self:.placeSubject(alias lod4, 3.0f, 0.0f, (4us)?);

        self:.createCrowd(alias scene, alias __subject__);
        self._subject = (alias __subject__)?;
        self:.createModel(alias scene);
        self:.createSpheres(alias scene);

        // the walls are copies of the ground, the three cubes drawn by one instanced command
        let dmut ground = copy SolidObjectModel::fromFile("ground", scene:.getRootNode(), "res:/models/cube/cube.obj");
        let dmut _wall_1_ = copy SolidObjectModel::copyOf("wall_1", scene:.getRootNode(), alias ground);
        let dmut _wall_2_ = copy SolidObjectModel::copyOf("wall_2", scene:.getRootNode(), alias ground);

        // a position is scaled with its node: the ground spans [-15, 15] and the walls stand at x = -15 and z = -15
        ground.position = makeVec3(0.0f, -1.0f, 0.0f);
        ground.scale = makeVec3(30.0f, 0.2f, 30.0f);

        _wall_1_.position = makeVec3(-75.0f, 0.0f, 0.0f);
        _wall_1_.scale = makeVec3(0.2f, 10.0f, 30.0f);

        _wall_2_.position = makeVec3(0.0f, 0.0f, -75.0f);
        _wall_2_.scale = makeVec3(30.0f, 10.0f, 0.2f);
    }

    /**
     * Place the model of '--model' beside the subjects, in the light of the blue spot, two units tall, drawn with no
     * level of detail
     * */
    fn createModel(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let path = __MODEL__[0];
        if path == "" { return; }

        let dmut model = copy SolidObjectModel::fromFile("model", scene:.getRootNode(), path, lods-> false);
        model.scale *= 2.0f;
        model.position = makeVec3(3.25f, 0.0f, 0.75f);

        model.rotation = facingCamera(path);
    }

    /**
     * Place two rows of spheres in front of the subjects, a red dielectric in the front row and gold in the back one,
     * their roughness growing from 0.1 to 0.9 from the left to the right of the camera (from x = 4 to x = -4)
     * */
    fn createSpheres(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let (array, indices) = sphere(24u32, 48u32);
        for i in 0u32 .. 5u32 {
            for metal in [false, true] {
                let mut config = MaterialConfig();
                config.roughness = 0.1f + cast!f32(i) * 0.2f;
                config.metallic = if metal { 1.0f } else { 0.0f };
                config.baseColor = if metal { makeVec3(1.0f, 0.78f, 0.34f) } else { makeVec3(0.8f, 0.05f, 0.05f) };

                let name = std::format::format("sphere_{}_{}", i, metal);
                let dmut material = copy ConstantMaterial(config);
                let dmut ball = copy IndexedMesh3D(name, scene:.getRootNode(), LodChain(indices), array, alias material);

                // a position is scaled with its node: the spheres are 0.8 unit wide, 2 units apart
                let z = if metal { 3.4f } else { 2.2f };
                ball.scale = makeVec3(0.4f, 0.4f, 0.4f);
                ball.position = makeVec3(4.0f - cast!f32(i) * 2.0f, 0.4f, z) / 0.4f;
            }
        }
    }

    /**
     * Make a subject 2.5 units large and place it at (x, 0, z), facing the camera, drawn at a level of detail, or at the
     * level selected from the camera when none
     * */
    fn placeSubject(mut self, dmut subject: &SolidObjectModel, x: f32, z: f32, lod: (usize)?) {
        subject.scale *= 2.5f;
        subject.position = makeVec3(x / 2.5f, 0.0f, z / 2.5f);
        subject.rotation = facingCamera(__SUBJECT__[0]);
        subject:.forceLod(lod);
    }

    /**
     * Place the crowd of copies of a subject behind the three in front, its levels of detail selected from the camera
     * */
    fn createCrowd(mut self, dmut scene: &Scene, dmut model: &SolidObjectModel) {
        let side = __CROWD__[0];
        for i in 0us .. side * side {
            let x = (cast!f32(cast!u64(i % side)) - cast!f32(cast!u64(side)) / 2.0f) * 2.5f;
            let z = -3.0f - cast!f32(cast!u64(i / side)) * 2.5f;

            let dmut copied = copy SolidObjectModel::copyOf("crowd_" ~ std::conv::to!{[c8]} (i),
                                                            scene:.getRootNode(),
                                                            alias model);
            self:.placeSubject(alias copied, x, z, none);
        }
    }

    fn createCamera(mut self, dmut scene: &Scene) {
        let dmut cam = copy PerspectiveCamera("cam", scene:.getRootNode());
        cam.fov = 90.0f;
        cam.exposure = __EXPOSURE__[0];

        self._yaw = 0.0f;
        self._pitch = 45.0f;

        self._cam = (alias cam)?;
        self:.computeCamPosition();
    }

    fn computeCamPosition(mut self) {
        let radius = self._dist;
        if let Ok(dmut cam) = alias self._cam {
            // self._angle = (self._angle + cam.position.x) % 360.0f;
            let mut pos    = cam.position;
            let mut target = self._target;

            let pitchRad = math::utils::radian(self._pitch);
            let yawRad   = math::utils::radian(self._yaw);

            pos.x = target.x + radius * cos(pitchRad) * sin(yawRad);
            pos.y = target.y + radius * sin(pitchRad);
            pos.z = target.z + radius * cos(pitchRad) * cos(yawRad);

            self._forward.x = cos(pitchRad) * sin(yawRad);
            self._forward.y = sin(pitchRad);
            self._forward.z = cos(pitchRad) * cos(yawRad);

            self._right = makeVec3(cos(yawRad), 0.0f, -sin(yawRad));

            cam.target = self._target;
            cam.position = pos;
        }
    }

    /**
     * Light the scene with a light of each type: a dimmed sun casting the shadows, an orange lamp on the side of the
     * subjects at x < 0 fading out at its range, and a blue spot on the other side lighting a disc of the ground
     * */
    fn createLight(mut self, dmut scene: &Scene) {
        let dmut light = copy Light("light", scene:.getRootNode(), castShadow-> __SHADOWS__[0]);
        light.direction = makeVec3(-0.3f, -1.0f, -0.2f);
        light.intensity = 0.6f;
        self._light = (alias light)?;

        let dmut lamp = copy Light("lamp", scene:.getRootNode());
        lamp.type = LightType::POINT;
        lamp.position = makeVec3(-6.0f, 2.0f, 2.0f);
        lamp.color = makeVec3(1.0f, 0.55f, 0.2f);
        lamp.intensity = 5.0f;
        lamp.range = 8.0f;

        let dmut spot = copy Light("spot", scene:.getRootNode());
        spot.type = LightType::SPOT;
        spot.position = makeVec3(6.0f, 6.0f, 2.0f);
        spot.direction = makeVec3(0.0f, -1.0f, -0.2f);
        spot.color = makeVec3(0.3f, 0.5f, 1.0f);
        spot.intensity = 25.0f;
        spot.range = 15.0f;
        spot.innerAngle = 15.0f;
        spot.outerAngle = 25.0f;
    }
}

/**
 * @returns: the vertices of a sphere of radius 1, its normals being its positions, and the indices of its triangles
 * @params:
 *    - rings: the number of rings from pole to pole
 *    - segments: the number of segments around the vertical axis
 * */
fn sphere(rings: u32, segments: u32)-> (MeshArray, [u32]) {
    let mut array = MeshArray();
    let dmut positions: [vec3] = [];
    for r in 0u32 ... rings {
        let theta = cast!f32(r) * math::PI / cast!f32(rings);
        for s in 0u32 ... segments {
            let phi = cast!f32(s) * 2.0f * math::PI / cast!f32(segments);
            positions ~= [makeVec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi))];
        }
    }

    let dmut indices: [u32] = [];
    for r in 0u32 .. rings {
        for s in 0u32 .. segments {
            let a = r * (segments + 1u32) + s;
            let b = a + segments + 1u32;
            indices ~= [a, a + 1u32, b, b, a + 1u32, b + 1u32];
        }
    }

    array.positions = alias positions;
    array.normals = copy positions;
    (array, indices)
}

/**
 * @returns: the rotation turning a model toward the camera of the demo, which looks from the back of the scene: a glTF
 * file faces +z, the other way once imported; the other files keep the orientation they are drawn in (an OBJ has no
 * front)
 * */
fn facingCamera(path: [c8])-> vec3 {
    if path.len >= 5us && (path[$ - 5us .. $] == ".gltf" || path[$ - 4us .. $] == ".glb") {
        return makeVec3(0.0f, math::PI, 0.0f);
    }

    makeVec3(0.0f, 0.0f, 0.0f)
}

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' and 'shaders:/' paths
 * are resolved against
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let dmut parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ (the current directory by default)")
        :.option!{[c8]} ("subject", comments-> "the model (glTF, OBJ...) of the three subjects in front and of the crowd (res:/models/suzanne/Suzanne.gltf by default)")
        :.option!{[c8]} ("crowd", comments-> "the number of subjects on a side of a crowd behind the three in front (none by default)")
        :.option!{[c8]} ("model", comments-> "a model (glTF, OBJ...) to place beside the subjects (none by default)")
        :.flag("gpu-cull", comments-> "cull the instances on the GPU from the start, 'G' toggling it (on the CPU by default)")
        :.flag("occlusion", comments-> "cull the instances hidden behind others when culled on the GPU, 'O' toggling it (off by default)")
        :.flag("shadows", comments-> "the light casts shadows, 'H' toggling them (off by default)")
        :.flag("ambient-occlusion", comments-> "the ambient occlusion of the screen shades the ambient light, 'A' toggling it (off by default)")
        :.option!{[c8]} ("occlusion-scale", comments-> "the size of the ambient occlusion in shares of the size of the scene, from 0.25 to 1 (1 by default)")
        :.option!{[c8]} ("exposure", comments-> "the exposure of the camera in stops, 'Page Up' and 'Page Down' changing it (0 by default)")
        :.option!{[c8]} ("tone-map", comments-> "the operator of the tone mapping, none, aces or agx, 'T' cycling through them (agx by default)")
        :.option!{[c8]} ("graph", comments-> "write the render graph in json in this file once the scene is drawn, 'X' writing it again (none by default)");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
        }

        if let Ok(Str(value-> file)) = cfg["graph"]? {
            __GRAPH__[0] = file;
        }

        if let Ok(Str(value-> subject)) = cfg["subject"]? {
            __SUBJECT__[0] = subject;
        }

        if let Ok(Str(value-> model)) = cfg["model"]? {
            __MODEL__[0] = model;
        }

        if let Ok(Str(value-> side)) = cfg["crowd"]? {
            __CROWD__[0] = std::conv::to!{usize} (side);
        }

        if let Ok(Str(value-> scale)) = cfg["occlusion-scale"]? {
            __OCCLUSION_SCALE__[0] = std::conv::to!{f32} (scale);
        }

        if let Ok(Str(value-> ev)) = cfg["exposure"]? {
            __EXPOSURE__[0] = std::conv::to!{f32} (ev);
        }

        if let Ok(Str(value-> op)) = cfg["tone-map"]? {
            __TONE_MAP__[0] = match op {
                "none" => { ToneMap::NONE }
                "aces" => { ToneMap::ACES }
                "agx"  => { ToneMap::AGX }
                _      => {
                    eprintln("demo: --tone-map expects none, aces or agx");
                    return false;
                }
            };
        }

        __GPU_CULL__[0] = cfg["gpu-cull"].to!{bool} () ?? false;
        __OCCLUSION__[0] = cfg["occlusion"].to!{bool} () ?? false;
        __SHADOWS__[0] = cfg["shadows"].to!{bool} () ?? false;
        __AMBIENT_OCCLUSION__[0] = cfg["ambient-occlusion"].to!{bool} () ?? false;

        true
    } catch {
        err: &std::config::args::errors::CommandLineError => {
            eprintln(parser.explain(err, usage-> "demo"));
            false
        }
        _: &std::conv::errors::CastFailure => {
            eprintln("demo: --crowd expects a number of subjects, --exposure a number of stops, --occlusion-scale a number");
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig("res:/config/app.toml");
        let dmut app = copy Application();
        app:.open!{&MyActivity} (cfg);

        app:.run();
    } catch {
        bd => {
            eprintln(bd);
        }
    }
}
