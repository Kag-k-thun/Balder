// The look of the sidebar of the gallery: a scrolled column of entries

LinearLayout.sidebar {
    overflow: scroll;
    background-color: $panel;
    width: 20%;
    min-width: 160;
    max-width: 360;
}

LinearLayout.sidebar::scrollbar {
    background-color: $edge;
}

LinearLayout.sidebar::scrollbar:hover {
    background-color: $muted;
}

LinearLayout.sidebar::scrollbar:pressed {
    background-color: $focus;
}

PushButton.entry {
    background-color: $panel;
    padding-left: 20;
    height: 30;
}

PushButton.entry:hover {
    background-color: $raised;
}

PushButton.entry:pressed {
    background-color: $accent;
}

PushButton.entry::label {
    text-color: $soft;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}
