// The sidebar of the gallery: an entry per widget and per layout, describing it in the inspector when it is clicked

@component Sidebar () {
    LinearLayout .sidebar {
        Label .section "Widgets";
        PushButton #W_LABEL .entry "Label" {
            on-click: describe ("Label: a text in UTF-8, shaped with the font of its style and wrapped to its width when its style sets text-wrap to wrap. With width or height set to auto, min-content or max-content it is as large as its text.");
        }
        PushButton #W_INPUT .entry "InputText" {
            on-click: describe ("InputText: a single line of text the user types, with a caret, a selection and the clipboard. It validates its text on Enter or when it loses the focus.");
        }
        PushButton #W_PUSH .entry "PushButton" {
            on-click: describe ("PushButton: a label emitting clicked when it is clicked. The chips of the Layouts page are push buttons of width max-content.");
        }
        PushButton #W_MENU .entry "MenuButton" {
            on-click: describe ("MenuButton: a button opening a menu in the menu layout it is in, like File and Help in the menu bar.");
        }
        PushButton #W_CHECK .entry "CheckBox" {
            on-click: describe ("CheckBox: a box the user checks and unchecks with a click, emitting on-toggle. Its box and its mark are parts of its style, the mark coloured in the state checked.");
        }
        PushButton #W_RADIO .entry "RadioButton" {
            on-click: describe ("RadioButton: a box a click checks, the radio buttons of the same group unchecking each other, like the qualities of the Controls page.");
        }
        PushButton #W_SLIDER .entry "Slider" {
            on-click: describe ("Slider: a thumb dragged along a track, or moved by the wheel, to a value between its min and its max, emitting on-change.");
        }
        PushButton #W_SPIN .entry "SpinBox" {
            on-click: describe ("SpinBox: an input of a number, moved by a step with its arrows or the wheel, read when it loses the focus.");
        }
        PushButton #W_PROGRESS .entry "ProgressBar" {
            on-click: describe ("ProgressBar: a bar filled up to its value between its min and its max.");
        }
        PushButton #W_DROPDOWN .entry "Dropdown" {
            on-click: describe ("Dropdown: a button showing the selected item of a list, opening the list in its menu layout to select another, emitting on-change.");
        }
        PushButton #W_LIST .entry "ListView" {
            on-click: describe ("ListView: rows read on demand from a model given by the code, only those shown existing, recycled as it scrolls. Ctrl toggles a row, Shift selects the rows from the last one clicked, emitting on-select.");
        }
        PushButton #W_TREE .entry "TreeView" {
            on-click: describe ("TreeView: the nodes of a model given by the code, a node expanded showing its children under it, indented after the marker expanding it. Only the nodes expanded and the rows shown are read, as in a list view.");
        }
        PushButton #W_TABLE .entry "TableView" {
            on-click: describe ("TableView: the rows of a model in columns under their headers. A click on a header sorts the rows by its column, its right edge resizes it, and the rows scroll horizontally when wider than the table.");
        }
        PushButton #W_SEPARATOR .entry "Separator" {
            on-click: describe ("Separator: a rule between two groups of widgets, a pixel thick across its direction.");
        }
        PushButton #W_IMAGE .entry "Image" {
            on-click: describe ("Image: a picture loaded from a file, as large as the picture, or scaled keeping its ratio.");
        }
        PushButton #W_BOX .entry "Box" {
            on-click: describe ("Box: a rectangle with a background, a border and margins, and no content. The flex row of the Layouts page is made of boxes.");
        }
        PushButton #W_SCENE .entry "Scene3D" {
            on-click: describe ("Scene3D: a 3D scene rendered to a texture and drawn as the background of the widget, on the 3D scene page.");
        }
        Label .section "Layouts";
        PushButton #L_LINEAR .entry "LinearLayout" {
            on-click: describe ("LinearLayout: children side by side, sized along its axis from their flex-basis, flex-grow and flex-shrink, and across it from their style or stretched.");
        }
        PushButton #L_GRID .entry "GridLayout" {
            on-click: describe ("GridLayout: children in cells of equal size, columns by rows.");
        }
        PushButton #L_FLOATING .entry "FloatingLayout" {
            on-click: describe ("FloatingLayout: children at a position of their own, stacked from the first to the last, like the fps counter over the 3D scene.");
        }
        PushButton #L_SCROLL .entry "Scrolling" {
            on-click: describe ("overflow: scroll: a linear layout scrolled over its children instead of shrinking them, like this sidebar when the window is short.");
        }
        PushButton #L_TAB .entry "TabLayout" {
            on-click: describe ("TabLayout: pages selected by their headers, here Layouts, Form and 3D scene.");
        }
        PushButton #L_MENU .entry "MenuLayout" {
            on-click: describe ("MenuLayout: a menu bar above a content, opening the menus of its menu buttons over everything else. It is the root of the gallery.");
        }
        PushButton #L_SPLITTER .entry "Splitter" {
            on-click: describe ("Splitter: panes side by side separated by grips, dragged to share the space of two panes, each staying in the bounds of its style.");
        }
        PushButton #L_OVERLAY .entry "Overlay" {
            on-click: describe ("Overlay: a backdrop greying out the window, a widget centred over it. The dialogs open in one over the gallery, which takes no input until it closes; Escape dismisses it.");
        }
        Label .section "Dialogs";
        PushButton #D_MESSAGE .entry "MessageDialog" {
            on-click: describe ("MessageDialog: a question answered by yes or no, like Help > About. Every dialog opens over the window or in a window of its own, and emits its answer instead of blocking.");
        }
        PushButton #D_CONFIRM .entry "ConfirmDialog" {
            on-click: describe ("ConfirmDialog: an action confirmed or cancelled by buttons named after it, Enter accepting and Escape cancelling.");
        }
        PushButton #D_FILE .entry "FileDialog" {
            on-click: describe ("FileDialog: a file to open, a file to save or a folder, chosen in a table of the entries of a folder, the folders first.");
        }
        PushButton #D_COLOR .entry "ColorDialog" {
            on-click: describe ("ColorDialog: a colour chosen by the sliders of its channels and of its opacity, or by its code typed, next to the colour it started from.");
        }
    }
}
