// The look of the Layouts page of the gallery

// The width under which the flex example is a column: a middle pane of 440, less the paddings of the page
$compact: 408;

LinearLayout.flex-row {
    direction: row;
    background-color: $panel;
    radius: $corner;
    padding: 4;
    height: 64;

    // a column, which keeps its height when the page overflows
    @when (width < $compact) {
        direction: column;
        height: 160;
        flex-shrink: 0;
    }
}

// the purple and the green boxes, on one line whatever the direction of the flex example; it grows by 2 from the width
// of the green box, so that the free space of a row is shared 1 : 2 between the blue and the purple boxes
LinearLayout.flex-pair {
    direction: row;
    background-color: $panel;
    flex: 2 1 auto;
}

Box.grow-one {
    background-color: $accent;
    radius: 4;
    margin: 4;
    flex: 1;
}

Box.grow-two {
    background-color: #8957e5;
    radius: 4;
    margin: 4;
    flex: 2;
}

Box.fixed {
    background-color: $green;
    radius: 4;
    margin: 4;
    width: 120;
}

LinearLayout.chips {
    direction: row;
    background-color: $page;
}

PushButton.chip {
    background-color: $raised;
    border: 1 $edge;
    radius: $round;
    margin: 4;
    padding: 6 14;
}

PushButton.chip:hover {
    background-color: $edge;
    border-color: $muted;
}

PushButton.chip:pressed {
    background-color: $accent;
}

PushButton.chip:focus {
    shadow: 0 0 0 2 $focus;
}

PushButton.chip::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

GridLayout.grid {
    columns: 1fr 1fr 1fr;
    rows: 1fr 1fr;
    background-color: $panel;
    radius: $corner;
    padding: 4;
    height: 140;
}

Box.cell-a {
    background-color: #da3633;
    radius: 4;
    margin: 4;
}

Box.cell-b {
    background-color: #d29922;
    radius: 4;
    margin: 4;
}

Label.cell {
    text-color: $text;
    font-family: $mono;
    font-size: 14;
}
