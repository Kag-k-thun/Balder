// The look of the Data page of the gallery, scrolled when it is higher than the tab

LinearLayout.page.data {
    overflow: scroll;
}

LinearLayout.page.data::scrollbar {
    background-color: $edge;
    radius: $round;
}

LinearLayout.page.data::scrollbar:hover {
    background-color: $muted;
}

LinearLayout.page.data::scrollbar:pressed {
    background-color: $focus;
}

TreeView.tree {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    padding: 4 14 4 4;
    height: 280;
}

TreeView.tree:focus {
    border-color: $focus;
}

TreeView.tree::row {
    background-color: transparent;
    border: 1 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 4 10 4 4;
    radius: 4;
}

TreeView.tree::row:hover {
    background-color: $raised;
}

TreeView.tree::row:selected {
    background-color: $accent;
}

TreeView.tree:focus::row:current {
    border-color: $focus;
}

TreeView.tree::marker {
    background-color: transparent;
    border: 0 transparent;
    text-color: $muted;
    font-family: $font;
    font-size: 14;
    width: 18;
    margin-right: 4;
}

TreeView.tree::marker:hover, TreeView.tree::marker:selected {
    text-color: $text;
}

TreeView.tree::scrollbar {
    background-color: $edge;
    width: 8;
    radius: $round;
}

TreeView.tree::scrollbar:hover, TreeView.tree::scrollbar:pressed {
    background-color: $focus;
}

TableView.table {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    padding: 4 14 14 4;
    height: 320;
}

TableView.table:focus {
    border-color: $focus;
}

TableView.table::header {
    background-color: $raised;
    border-width: 0 0 1 0;
    border-color: $edge;
    text-color: $soft;
    font-family: $font;
    font-weight: bold;
    font-size: 13;
    text-xalign: left;
    padding: 6 10;
}

TableView.table::header:hover {
    text-color: $text;
}

TableView.table::header:ascending, TableView.table::header:descending {
    text-color: $focus;
}

TableView.table::row {
    background-color: transparent;
    border: 1 transparent;
    radius: 4;
}

TableView.table::row:hover {
    background-color: $raised;
}

TableView.table::row:selected {
    background-color: $accent;
}

TableView.table:focus::row:current {
    border-color: $focus;
}

TableView.table::cell {
    background-color: transparent;
    border: 0 transparent;
    text-color: $soft;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 4 10;
}

TableView.table::cell:selected {
    text-color: $text;
}

TableView.table::scrollbar {
    background-color: $edge;
    width: 8;
    height: 8;
    radius: $round;
}

TableView.table::scrollbar:hover, TableView.table::scrollbar:pressed {
    background-color: $focus;
}
