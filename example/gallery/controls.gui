// The Controls page of the gallery: check boxes, radio buttons, a slider, a spin box, a progress bar, a dropdown and an
// image, reporting to the behavior 'controls'

@component ControlsPage () {
    LinearLayout .page .controls {
        Label .heading "Check boxes and radio buttons";
        LinearLayout .choices {
            CheckBox #SHADOWS .check "Shadows" { checked: true; on-toggle: controls::toggled ("Shadows"); }
            CheckBox #BLOOM .check "Bloom" { on-toggle: controls::toggled ("Bloom"); }
        }
        LinearLayout .choices {
            RadioButton #LOW .radio "Low" { group: "quality"; on-toggle: controls::quality ("Low"); }
            RadioButton #MEDIUM .radio "Medium" { group: "quality"; checked: true; on-toggle: controls::quality ("Medium"); }
            RadioButton #HIGH .radio "High" { group: "quality"; on-toggle: controls::quality ("High"); }
        }

        Separator .rule;
        Label .heading "A slider, a spin box and a progress bar showing the same volume";
        LinearLayout .volume {
            Slider #VOLUME .slider 40 { max: 100; step: 1; on-change: controls::volume; }
            SpinBox #VOLUME_VALUE .spin 40 { max: 100; on-change: controls::volume-typed; }
        }
        ProgressBar #LEVEL .level 40 { max: 100; }

        Separator .rule;
        Label .heading "Dropdowns, the second one scrolling over its items";
        LinearLayout .choices {
            Dropdown #THEME .dropdown "Dark", "Light", "High contrast" { selected: 0; on-change: controls::chosen ("THEME"); }
            Dropdown #FONT_SIZE .dropdown "8", "9", "10", "11", "12", "13", "14", "16", "18", "20", "22", "24", "28", "32", "36", "40", "48", "56", "64", "72" {
                selected: 6;
                on-change: controls::chosen ("FONT_SIZE");
            }
        }

        Separator .rule;
        Label .heading "An image, scaled to the page keeping its ratio";
        Image .picture "res:/images/texture.jpg";
    }
}
