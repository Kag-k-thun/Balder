in main;

use balder::core::{_, application::_};
use balder::interface::dialog::message;
use balder::interface::widget::{layout::_, text::_};
use balder::math::_;
use balder::scene::node::{_, node3D::_};
use balder::utils::{log, path};

use std::{config::_, io};
use std::fs::path;
use std::time::dur;

use ::sdl3::_;

/**
 * The entries of the sidebar, (name of the button, description shown in the inspector)
 * */
enum Entries
| LABEL       = ("W_LABEL", "Label: a text in UTF-8, shaped with the font of its style and wrapped to its width when its style sets text-wrap to wrap. With width or height set to auto, min-content or max-content it is as large as its text.")
| INPUT       = ("W_INPUT", "InputText: a single line of text the user types, with a caret, a selection and the clipboard. It validates its text on Enter or when it loses the focus.")
| PUSH        = ("W_PUSH", "PushButton: a label emitting clicked when it is clicked. The chips of the Layouts page are push buttons of width max-content.")
| MENU        = ("W_MENU", "MenuButton: a button opening a menu in the menu layout it is in, like File and Help in the menu bar.")
| BOX         = ("W_BOX", "Box: a rectangle with a background, a border and margins, and no content. The flex row of the Layouts page is made of boxes.")
| SCENE       = ("W_SCENE", "Scene3D: a 3D scene rendered to a texture and drawn as the background of the widget, on the 3D scene page.")
| LINEAR      = ("L_LINEAR", "LinearLayout: children side by side, sized along its axis from their flex-basis, flex-grow and flex-shrink, and across it from their style or stretched.")
| GRID        = ("L_GRID", "GridLayout: children in cells of equal size, columns by rows.")
| FLOATING    = ("L_FLOATING", "FloatingLayout: children at a position of their own, stacked from the first to the last, like the fps counter over the 3D scene.")
| SCROLL      = ("L_SCROLL", "ScrollLayout: a linear layout scrolled over its children instead of shrinking them, like this sidebar when the window is short.")
| TAB         = ("L_TAB", "TabLayout: pages selected by their headers, here Layouts, Form and 3D scene.")
| MENU_LAYOUT = ("L_MENU", "MenuLayout: a menu bar above a content, opening the menus of its menu buttons over everything else. It is the root of the gallery.")
| SPLITTER    = ("L_SPLITTER", "Splitter: panes side by side separated by grips, dragged to share the space of two panes, each staying in the bounds of its style.");

/**
 * A slot showing the description of an entry of the sidebar in the inspector when the entry is clicked
 * */
class EntrySlot {

    // The description of the entry
    let _text: [c8];

    // The label of the inspector showing it
    let dmut _target: &Label;

    pub self (text: [c8], dmut target: &Label)
        with _text = text
        , _target = alias target
    {}

    pub fn onClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self._target:.setText(self._text);
        }
    }
}

/**
 * A gallery of every widget of Balder, laid out with flex sizes and content sizes: a menu bar over a splitter of a
 * scrolled sidebar, tabbed pages and an inspector, above a status bar
 * */
class GalleryActivity over Activity {

    let dmut _status: (&Label)? = none;
    let dmut _fps: (&Label)?    = none;
    let dmut _clock: (&Label)?  = none;

    let dmut _entries: [&EntrySlot] = [];

    // The validated fields of the form
    let mut _name: [c8]  = "";
    let mut _age: [c8]   = "";
    let mut _email: [c8] = "";

    let dmut _cube: (&Node3D)? = none;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);

        println(self.gui:.loadStyleFile(galleryFile("gallery.style"))?);
        println(self.gui:.loadGUIFile(galleryFile("gallery.gui"))?);

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/STATUS") {
            self._status = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/MAIN/TABS/SCENE_PAGE/FPS") {
            self._fps = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BAR/CLOCK") {
            self._clock = (alias l)?;
        }

        self:.connectEntries();
        self:.connectMenus();
        self:.connectForm();
        self:.connectChips();

        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("BODY/MAIN/TABS/SCENE_PAGE/SCENE") {
            if let Ok(dmut scene) = alias w:.getScene() {
                self:.createScene(alias scene);
            }
        }
    }

    over onUpdate(mut self, delta: Duration) {
        let fps = std::conv::to!{[c8]} (self.window.getNbFramesLastSecond()) ~ " fps";
        if let Ok(dmut l) = alias self._fps {
            l:.setText(fps);
        }

        if let Ok(dmut l) = alias self._clock {
            l:.setText(fps);
        }

        if let Ok(dmut cube) = alias self._cube {
            cube.rotation += makeVec3(0.0f, cast!f32(delta.millis) / 1000.0f, cast!f32(delta.millis) / 3000.0f);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Show the description of an entry of the sidebar in the inspector when it is clicked
     * */
    fn connectEntries(mut self) {
        let dmut selection = if let Ok(dmut l: &Label) = self.gui:.find("BODY/MAIN/INSPECTOR/SELECTION") {
            alias l
        } else {
            return;
        };

        cte for e in Entries::__members__ {
            if let Ok(dmut button) = alias self.gui:.find("BODY/MAIN/SIDEBAR/" ~ e._0) {
                let dmut slot = copy EntrySlot(e._1, alias selection);
                button:.clicked():.connect(self.box, &slot:.onClicked);
                self._entries ~= [alias slot];
            }
        }
    }

    fn connectMenus(mut self) {
        if let Ok(dmut quit) = alias self.gui:.find("BAR/FILE/FILE_MENU/QUIT") {
            quit:.clicked():.connect(self.box, &self:.onQuitClicked);
        }

        if let Ok(dmut clear) = alias self.gui:.find("BAR/FILE/FILE_MENU/CLEAR") {
            clear:.clicked():.connect(self.box, &self:.onResetClicked);
        }

        if let Ok(dmut about) = alias self.gui:.find("BAR/HELP/HELP_MENU/ABOUT") {
            about:.clicked():.connect(self.box, &self:.onAboutClicked);
        }
    }

    fn connectForm(mut self) {
        if let Ok(dmut input: &InputText) = self.gui:.find("BODY/MAIN/TABS/FORM/NAME_ROW/NAME") {
            input:.textValidated():.connect(self.box, &self:.onNameValidated);
        }

        if let Ok(dmut input: &InputText) = self.gui:.find("BODY/MAIN/TABS/FORM/AGE_ROW/AGE") {
            input:.textValidated():.connect(self.box, &self:.onAgeValidated);
        }

        if let Ok(dmut input: &InputText) = self.gui:.find("BODY/MAIN/TABS/FORM/EMAIL_ROW/EMAIL") {
            input:.textValidated():.connect(self.box, &self:.onEmailValidated);
        }

        if let Ok(dmut submit) = alias self.gui:.find("BODY/MAIN/TABS/FORM/BUTTONS/SUBMIT") {
            submit:.clicked():.connect(self.box, &self:.onSubmitClicked);
        }

        if let Ok(dmut reset) = alias self.gui:.find("BODY/MAIN/TABS/FORM/BUTTONS/RESET") {
            reset:.clicked():.connect(self.box, &self:.onResetClicked);
        }
    }

    fn connectChips(mut self) {
        for chip in ["CHIPS/CHIP_A", "CHIPS/CHIP_B", "CHIPS/CHIP_C", "GRID/CELL_F"] {
            if let Ok(dmut button) = alias self.gui:.find("BODY/MAIN/TABS/LAYOUTS/" ~ chip) {
                button:.clicked():.connect(self.box, &self:.onChipClicked);
            }
        }
    }

    fn onNameValidated(mut self, text: [c8]) {
        self._name = text;
        self:.setStatus("Name: \"" ~ text ~ "\"");
    }

    fn onAgeValidated(mut self, text: [c8]) {
        self._age = text;
        self:.setStatus("Age: \"" ~ text ~ "\"");
    }

    fn onEmailValidated(mut self, text: [c8]) {
        self._email = text;
        self:.setStatus("Email: \"" ~ text ~ "\"");
    }

    fn onSubmitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.setStatus("Hello " ~ self._name ~ " (" ~ self._age ~ "), we will write to " ~ self._email);
        }
    }

    fn onResetClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        for field in ["NAME_ROW/NAME", "AGE_ROW/AGE", "EMAIL_ROW/EMAIL"] {
            if let Ok(dmut input: &InputText) = self.gui:.find("BODY/MAIN/TABS/FORM/" ~ field) {
                input:.setText("");
            }
        }

        self._name = "";
        self._age = "";
        self._email = "";
        self:.setStatus("The form is cleared");
    }

    fn onChipClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.setStatus("A chip was clicked");
        }
    }

    fn onAboutClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut app  = alias self.app;
        let dmut diag = copy MessageDialog(alias app, "Balder widget gallery, do you like it?");
        diag:.execute();

        match diag.status {
            MessageDialogStatus::YES => { self:.setStatus("Glad you like it!"); }
            MessageDialogStatus::NO  => { self:.setStatus("We will do better"); }
            _ => {}
        }
    }

    fn onQuitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.onQuit();
        }
    }

    fn onQuit(mut self) {
        self.app:.close(alias self);
    }

    fn setStatus(mut self, msg: [c8]) {
        if let Ok(dmut status) = alias self._status {
            status:.setText(msg);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SCENE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A spinning cube on a ground, under a light, seen from above
     * */
    fn createScene(mut self, dmut scene: &Scene) {
        {
            let dmut cube = copy SolidObjectModel::fromFile("cube", scene:.getRootNode(), "res:/models/cube/cube.obj");
            self._cube = (alias cube)?;

            let dmut ground = copy SolidObjectModel::fromFile("ground", scene:.getRootNode(), "res:/models/cube/cube.obj");
            ground.position = makeVec3(0.0f, -2.0f, 0.0f);
            ground.scale = makeVec3(8.0f, 0.2f, 8.0f);
        } catch {
            err => {
                log::error #("Gallery", "Failed to load the cube", err);
            }
        }

        let dmut cam = copy PerspectiveCamera("cam", scene:.getRootNode());
        cam.fov = 70.0f;
        cam.position = makeVec3(4.0f, 4.0f, 6.0f);
        cam.target = makeVec3(0.0f, 0.0f, 0.0f);

        let dmut light = copy Light("light", scene:.getRootNode());
        light.position = makeVec3(-0.3f, -1.0f, -0.2f);
    }
}

/**
 * @returns: the path of a file of the gallery example, under the project directory
 * */
fn galleryFile(name: [c8])-> [c8] {
    getProjectPath().push("example/gallery").push(name).toStr()
}

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' and 'shaders:/' paths
 * are resolved against
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let dmut parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ and example/ (the current directory by default)");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
        }

        true
    } catch {
        err: &std::config::args::errors::CommandLineError => {
            eprintln(parser.explain(err, usage-> "gallery"));
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig(galleryFile("gallery.toml"));
        let dmut app = copy Application();
        app:.open!{&GalleryActivity} (cfg);

        app:.run();
    } catch {
        err => {
            log::error #("Gallery", "Failed to open the gallery", err);
        }
    }
}
