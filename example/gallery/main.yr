in main;

use balder::core::{_, application::_};
use balder::interface;
use balder::interface::dialog::message;
use balder::interface::loader::registry::behavior;
use balder::interface::widget::{layout::_, text::_};
use balder::math::_;
use balder::scene::node::{_, node3D::_};
use balder::utils::{log, path};

use std::{config::_, io};
use std::fs::path;
use std::time::dur;

use ::sdl3::_;

/**
 * The slots of the form of the gallery, mounted under the behavior 'form': the validation of its fields, submit and
 * reset
 * */
class FormBehavior over Behavior {

    // The interface holding the inputs of the form
    let dmut _gui: &WidgetManager;

    // Shows a message in the status bar
    let _status: dg ([c8])-> void;

    // The validated fields of the form
    let mut _name: [c8]  = "";
    let mut _age: [c8]   = "";
    let mut _email: [c8] = "";
    let mut _phone: [c8] = "";

    /**
     * @params:
     *    - gui: the interface holding the inputs of the form
     *    - status: shows a message in the status bar
     * */
    pub self (dmut gui: &WidgetManager, status: dg ([c8])-> void)
        with _gui = alias gui
        , _status = status
    {
        self:.slot("name-set", &self:.onNameValidated);
        self:.slot("age-set", &self:.onAgeValidated);
        self:.slot("email-set", &self:.onEmailValidated);
        self:.slot("phone-set", &self:.onPhoneValidated);
        self:.slot("submit", &self:.onSubmitClicked);
        self:.slot("reset", &self:.onResetClicked);
    }

    fn onNameValidated(mut self, text: [c8]) {
        self._name = text;
        self._status("Name: \"" ~ text ~ "\"");
    }

    fn onAgeValidated(mut self, text: [c8]) {
        self._age = text;
        self._status("Age: \"" ~ text ~ "\"");
    }

    fn onEmailValidated(mut self, text: [c8]) {
        self._email = text;
        self._status("Email: \"" ~ text ~ "\"");
    }

    fn onPhoneValidated(mut self, text: [c8]) {
        self._phone = text;
        self._status("Phone: \"" ~ text ~ "\"");
    }

    fn onSubmitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self._status("Hello " ~ self._name ~ " (" ~ self._age ~ "), we will write to " ~ self._email ~ " or call " ~ self._phone);
        }
    }

    fn onResetClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        for field in ["NAME", "AGE", "EMAIL", "PHONE"] {
            if let Ok(dmut input: &InputText) = self._gui:.find("BODY/MAIN/TABS/FORM/FIELDS/" ~ field ~ "/INPUT") {
                input:.setText("");
            }
        }

        self._name = "";
        self._age = "";
        self._email = "";
        self._phone = "";
        self._status("The form is cleared");
    }
}

/**
 * A gallery of every widget of Balder, laid out with flex sizes and content sizes: a menu bar over a splitter of a
 * scrolled sidebar, tabbed pages and an inspector, above a status bar
 * */
class GalleryActivity over Activity {

    let dmut _status: (&Label)?    = none;
    let dmut _fps: (&Label)?       = none;
    let dmut _clock: (&Label)?     = none;
    let dmut _selection: (&Label)? = none;

    let dmut _cube: (&Node3D)? = none;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);

        // the slots the 'on-…' attributes of gallery.gui name, those of the form under 'form'
        self:.slot("quit", &self:.onQuitClicked);
        self:.slot("about", &self:.onAboutClicked);
        self:.slot("chip", &self:.onChipClicked);
        self:.slot("describe", &self:.onDescribe);
        self:.behavior("form", copy FormBehavior(alias self.gui, &self:.setStatus));

        println(self.gui:.loadStyleFile(galleryFile("gallery.style"))?);
        println(self.gui:.loadGUIFile(galleryFile("gallery.gui"))?);

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/STATUS") {
            self._status = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/MAIN/TABS/SCENE_PAGE/FPS") {
            self._fps = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BAR/CLOCK") {
            self._clock = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/MAIN/INSPECTOR/SELECTION") {
            self._selection = (alias l)?;
        }

        self:.addPhoneRow();

        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("BODY/MAIN/TABS/SCENE_PAGE/SCENE") {
            if let Ok(dmut scene) = alias w:.getScene() {
                self:.createScene(alias scene);
            }
        }
    }

    over onUpdate(mut self, delta: Duration) {
        let fps = std::conv::to!{[c8]} (self.window.getNbFramesLastSecond()) ~ " fps";
        if let Ok(dmut l) = alias self._fps {
            l:.setText(fps);
        }

        if let Ok(dmut l) = alias self._clock {
            l:.setText(fps);
        }

        if let Ok(dmut cube) = alias self._cube {
            cube.rotation += makeVec3(0.0f, cast!f32(delta.millis) / 1000.0f, cast!f32(delta.millis) / 3000.0f);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add the phone row to the form, one more FieldRow, validating its text to the slot 'form::phone-set'
     * */
    fn addPhoneRow(mut self) {
        {
            self.gui:.instantiate("FieldRow", "Phone", parent-> "BODY/MAIN/TABS/FORM/FIELDS", id-> "PHONE",
                                  attributes-> "max-length: 20; only-numbers: true; on-validate: form::phone-set;");
        } catch {
            err => {
                log::error #("Gallery", "Failed to add the phone row", err);
            }
        }
    }

    /**
     * Show the description of an entry of the sidebar, bound by its 'on-click', in the inspector
     * */
    fn onDescribe(mut self, text: [c8], b: u8) {
        if b == SDL_BUTTON_LEFT {
            if let Ok(dmut l) = alias self._selection {
                l:.setText(text);
            }
        }
    }

    fn onChipClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.setStatus("A chip was clicked");
        }
    }

    fn onAboutClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut app  = alias self.app;
        let dmut diag = copy MessageDialog(alias app, "Balder widget gallery, do you like it?");
        diag:.execute();

        match diag.status {
            MessageDialogStatus::YES => { self:.setStatus("Glad you like it!"); }
            MessageDialogStatus::NO  => { self:.setStatus("We will do better"); }
            _ => {}
        }
    }

    fn onQuitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.onQuit();
        }
    }

    fn onQuit(mut self) {
        self.app:.close(alias self);
    }

    fn setStatus(mut self, msg: [c8]) {
        if let Ok(dmut status) = alias self._status {
            status:.setText(msg);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SCENE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A spinning cube on a ground, under a light, seen from above
     * */
    fn createScene(mut self, dmut scene: &Scene) {
        {
            let dmut cube = copy SolidObjectModel::fromFile("cube", scene:.getRootNode(), "res:/models/cube/cube.obj");
            self._cube = (alias cube)?;

            let dmut ground = copy SolidObjectModel::fromFile("ground", scene:.getRootNode(), "res:/models/cube/cube.obj");
            ground.position = makeVec3(0.0f, -2.0f, 0.0f);
            ground.scale = makeVec3(8.0f, 0.2f, 8.0f);
        } catch {
            err => {
                log::error #("Gallery", "Failed to load the cube", err);
            }
        }

        let dmut cam = copy PerspectiveCamera("cam", scene:.getRootNode());
        cam.fov = 70.0f;
        cam.position = makeVec3(4.0f, 4.0f, 6.0f);
        cam.target = makeVec3(0.0f, 0.0f, 0.0f);

        let dmut light = copy Light("light", scene:.getRootNode());
        light.direction = makeVec3(-0.3f, -1.0f, -0.2f);
    }
}

/**
 * @returns: the path of a file of the gallery example, under the project directory
 * */
fn galleryFile(name: [c8])-> [c8] {
    getProjectPath().push("example/gallery").push(name).toStr()
}

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' and 'shaders:/' paths
 * are resolved against
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let dmut parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ and example/ (the current directory by default)");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
        }

        true
    } catch {
        err: &std::config::args::errors::CommandLineError => {
            eprintln(parser.explain(err, usage-> "gallery"));
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig(galleryFile("gallery.toml"));
        let dmut app = copy Application();
        app:.open!{&GalleryActivity} (cfg);

        app:.run();
    } catch {
        err => {
            log::error #("Gallery", "Failed to open the gallery", err);
        }
    }
}
