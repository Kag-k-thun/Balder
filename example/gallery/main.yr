in main;

mod ::project;
mod ::form;
mod ::activity;

use main::{activity, project};
use balder::core::{_, application::_};
use balder::utils::log;

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig(galleryFile("gallery.toml"));
        let dmut app = copy Application();
        app:.open!{&GalleryActivity} (cfg);

        app:.run();
    } catch {
        err => {
            log::error #("Gallery", "Failed to open the gallery", err);
        }
    }
}
