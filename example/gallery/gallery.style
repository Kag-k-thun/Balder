// The widget gallery: every widget of Balder, laid out with flex sizes and content sizes, an unset size being auto

$page: #0d1117;
$panel: #161b22;
$raised: #21262d;
$edge: #30363d;
$text: #e6edf3;
$soft: #c9d1d9;
$muted: #8b949e;
$accent: #1f6feb;
$focus: #388bfd;
$green: #3fb950;
$font: "Noto Sans", sans-serif;
$mono: "DejaVu Sans Mono", monospace;

// The width under which the rows of the form stack their label above their input
$narrow: 560;

// The width under which the flex example is a column: a middle pane of 440, less the paddings of the page
$compact: 408;

MenuLayout.root, LinearLayout.body {
    background-color: $page;
}

// ===================================          MENU BAR          ===================================

LinearLayout.bar {
    direction: row;
    background-color: $panel;
}

MenuButton.menu {
    background-color: $panel;
    padding: 6 14;
}

MenuButton.menu:hover {
    background-color: $raised;
}

MenuButton.menu::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

LinearLayout.popup {
    background-color: $panel;
    border: 1 $edge;
}

PushButton.item {
    background-color: $panel;
    padding: 6 24 6 16;
}

PushButton.item:hover {
    background-color: $accent;
}

PushButton.item::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Box.fill {
    background-color: transparent;
    border-color: transparent;
    flex: 1;
}

Label.clock {
    text-color: $green;
    font-family: $mono;
    font-size: 13;
    padding-right: 12;
}

// ===================================          SPLITTER          ===================================

Splitter.main {
    direction: row;
    background-color: $page;
    border-color: $page;
    flex: 1;
}

Splitter.main::grip {
    width: 4;
    background-color: $edge;
}

Splitter.main::grip:hover {
    background-color: $focus;
}

Splitter.main::bbox {
    width: 12;
}

LinearLayout.sidebar {
    overflow: scroll;
    background-color: $panel;
    width: 20%;
    min-width: 160;
    max-width: 360;
}

LinearLayout.inspector {
    background-color: $panel;
    padding: 12;
    width: 22%;
    min-width: 180;
}

// a narrow window leaves the inspector out, the splitter sharing its space between the sidebar and the tabs
@when (window.width < 900) {
    LinearLayout.inspector { display: none; }
}

Label.section {
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 12;
    text-xalign: left;
    padding-left: 12;
    padding-top: 12;
    padding-bottom: 6;
}

PushButton.entry {
    background-color: $panel;
    padding-left: 20;
    height: 30;
}

PushButton.entry:hover {
    background-color: $raised;
}

PushButton.entry:check {
    background-color: $accent;
}

PushButton.entry::label {
    text-color: $soft;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Label.info, Label.paragraph {
    text-color: $soft;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: top;
    text-wrap: wrap;
}

// =====================================          TABS          =====================================

// a min width of its own fixes the width of the pane, which the rows of the form measure
TabLayout.tabs {
    background-color: $page;
    min-width: 280;
}

TabLayout.tabs::tab {
    background-color: $panel;
    border: 1 $edge;
    text-color: $muted;
    font-family: $font;
    font-size: 14;
}

TabLayout.tabs::tab:hover {
    background-color: $raised;
    text-color: $text;
}

TabLayout.tabs::tab:selected {
    background-color: $page;
    border-color: $focus;
    text-color: $text;
}

LinearLayout.page {
    background-color: $page;
    padding: 16;
}

Label.heading {
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 15;
    text-xalign: left;
    margin-top: 14;
    margin-bottom: 6;
}

LinearLayout.flex-row {
    direction: row;
    background-color: $panel;
    padding: 4;
    height: 64;

    // a column, which keeps its height when the page overflows
    @when (width < $compact) {
        direction: column;
        height: 160;
        flex-shrink: 0;
    }
}

// the purple and the green boxes, on one line whatever the direction of the flex example; it grows by 2 from the width
// of the green box, so that the free space of a row is shared 1 : 2 between the blue and the purple boxes
LinearLayout.flex-pair {
    direction: row;
    background-color: $panel;
    flex: 2 1 auto;
}

Box.grow-one {
    background-color: $accent;
    margin: 4;
    flex: 1;
}

Box.grow-two {
    background-color: #8957e5;
    margin: 4;
    flex: 2;
}

Box.fixed {
    background-color: $green;
    margin: 4;
    width: 120;
}

LinearLayout.chips {
    direction: row;
    background-color: $page;
}

PushButton.chip {
    background-color: $raised;
    border: 1 $edge;
    margin: 4;
    padding: 6 14;
}

PushButton.chip:hover {
    background-color: $edge;
    border-color: $muted;
}

PushButton.chip:check {
    background-color: $accent;
}

PushButton.chip::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

GridLayout.grid {
    columns: 1fr 1fr 1fr;
    rows: 1fr 1fr;
    background-color: $panel;
    padding: 4;
    height: 140;
}

Box.cell-a {
    background-color: #da3633;
    margin: 4;
}

Box.cell-b {
    background-color: #d29922;
    margin: 4;
}

Label.cell {
    text-color: $text;
    font-family: $mono;
    font-size: 14;
}

// =====================================          FORM          =====================================

LinearLayout.row {
    direction: row;
    background-color: $page;

    @when (width < $narrow) {
        direction: column;
    }
}

Label.field {
    text-color: $muted;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    width: 130;

    @when (width < $narrow) {
        width: auto;
        margin-left: 6;
    }
}

InputText.input {
    background-color: $panel;
    border: 2 $edge;
    margin: 6;
    padding: 8;
    flex: 1;
}

InputText.input:hover {
    border-color: #484f58;
}

InputText.input:focus {
    border-color: $focus;
}

InputText.input::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText.input::selection {
    color: #388bfd64;
}

InputText.input::cursor {
    text-color: $text;
}

LinearLayout.buttons {
    direction: row;
    background-color: $page;
    margin-top: 12;
}

PushButton.submit {
    background-color: #238636;
    border: 1 #2ea043;
    margin: 4;
    padding: 8 18;
}

PushButton.submit:hover {
    background-color: #2ea043;
}

PushButton.submit::label {
    text-color: #ffffff;
    font-family: $font;
    font-weight: bold;
    font-size: 14;
}

// ====================================          SCENE          =====================================

FloatingLayout.scene-page {
    background-color: black;
}

Scene3D.scene {
    background-color: black;
    width: 100%;
    height: 100%;
}

Label.fps {
    left: 12;
    top: 12;
    text-color: $green;
    background-color: #000000a0;
    font-family: $mono;
    font-size: 16;
    padding: 6;
}

// ====================================          STATUS          ====================================

Label.status {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding-left: 12;
    padding-top: 4;
    padding-bottom: 4;
}
