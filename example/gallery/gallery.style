// The widget gallery: every widget of Balder, laid out with flex sizes and content sizes

MenuLayout .root {
    background-color: #0d1117;
}

LinearLayout .body {
    background-color: #0d1117;
}

// ===================================          MENU BAR          ===================================

LinearLayout .bar {
    background-color: #161b22;
    height: auto;
}

MenuButton .menu {
    background-color: #161b22;
    padding-left: 14;
    padding-right: 14;
    padding-top: 6;
    padding-bottom: 6;
    width: max-content;
}

MenuButton :hover .menu {
    background-color: #21262d;
}

MenuButton ::label .menu {
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
}

LinearLayout .popup {
    background-color: #161b22;
    border-color: #30363d;
    border: 1;
    width: max-content;
    height: max-content;
}

PushButton .item {
    background-color: #161b22;
    padding-left: 16;
    padding-right: 24;
    padding-top: 6;
    padding-bottom: 6;
    height: auto;
}

PushButton :hover .item {
    background-color: #1f6feb;
}

PushButton ::label .item {
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
}

Box .fill {
    background-color: #000000 : 0;
    border-color: #000000 : 0;
    flex-grow: 1;
    flex-basis: 0;
}

Label .clock {
    text-color: #3fb950;
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 13;
    padding-right: 12;
    width: max-content;
}

// ===================================          SPLITTER          ===================================

Splitter .main {
    background-color: #0d1117;
    border-color: #0d1117;
    flex-grow: 1;
    flex-basis: 0;
}

Splitter ::grip .main {
    width: 4;
    background-color: #30363d;
}

Splitter :hover ::grip .main {
    background-color: #388bfd;
}

Splitter ::bbox .main {
    width: 12;
}

LinearLayout .sidebar {
    background-color: #161b22;
    width: {
        relative: 0.2;
        min: 160;
        max: 360;
    }
}

LinearLayout .inspector {
    background-color: #161b22;
    padding: 12;
    width: {
        relative: 0.22;
        min: 180;
    }
}

Label .section {
    text-color: #8b949e;
    font-family: "Noto Sans", sans-serif;
    font-weight: bold;
    font-size: 12;
    text-xalign: left;
    padding-left: 12;
    padding-top: 12;
    padding-bottom: 6;
    height: auto;
}

PushButton .entry {
    background-color: #161b22;
    padding-left: 20;
    height: 30;
}

PushButton :hover .entry {
    background-color: #21262d;
}

PushButton :check .entry {
    background-color: #1f6feb;
}

PushButton ::label .entry {
    text-color: #c9d1d9;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
}

Label .info {
    text-color: #c9d1d9;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    text-yalign: top;
    text-wrap: wrap;
    height: auto;
}

// =====================================          TABS          =====================================

TabLayout .tabs {
    background-color: #0d1117;
}

TabLayout ::tab .tabs {
    background-color: #161b22;
    border-color: #30363d;
    border: 1;
    text-color: #8b949e;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
}

TabLayout :hover ::tab .tabs {
    background-color: #21262d;
    border-color: #30363d;
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
}

TabLayout :focus ::tab .tabs {
    background-color: #0d1117;
    border-color: #388bfd;
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
}

LinearLayout .page {
    background-color: #0d1117;
    padding: 16;
}

Label .heading {
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-weight: bold;
    font-size: 15;
    text-xalign: left;
    margin-top: 14;
    margin-bottom: 6;
    height: auto;
}

LinearLayout .flex-row {
    background-color: #161b22;
    padding: 4;
    height: 64;
}

Box .grow-one {
    background-color: #1f6feb;
    margin: 4;
    flex-grow: 1;
    flex-basis: 0;
}

Box .grow-two {
    background-color: #8957e5;
    margin: 4;
    flex-grow: 2;
    flex-basis: 0;
}

Box .fixed {
    background-color: #3fb950;
    margin: 4;
    width: 120;
}

LinearLayout .chips {
    background-color: #0d1117;
    height: auto;
}

PushButton .chip {
    background-color: #21262d;
    border-color: #30363d;
    border: 1;
    margin: 4;
    padding-left: 14;
    padding-right: 14;
    padding-top: 6;
    padding-bottom: 6;
    width: max-content;
}

PushButton :hover .chip {
    background-color: #30363d;
    border-color: #8b949e;
}

PushButton :check .chip {
    background-color: #1f6feb;
}

PushButton ::label .chip {
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
}

Label .paragraph {
    text-color: #c9d1d9;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    text-yalign: top;
    text-wrap: wrap;
    height: auto;
}

GridLayout .grid {
    background-color: #161b22;
    padding: 4;
    height: 140;
}

Box .cell-a {
    background-color: #da3633;
    margin: 4;
}

Box .cell-b {
    background-color: #d29922;
    margin: 4;
}

Label .cell {
    text-color: #e6edf3;
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 14;
}

// =====================================          FORM          =====================================

LinearLayout .row {
    background-color: #0d1117;
    height: auto;
}

Label .field {
    text-color: #8b949e;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    width: 130;
}

InputText .input {
    background-color: #161b22;
    border-color: #30363d;
    border: 2;
    margin: 6;
    padding: 8;
    height: auto;
}

InputText :hover .input {
    border-color: #484f58;
}

InputText :focus .input {
    border-color: #388bfd;
}

InputText ::label .input {
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText ::selection .input {
    color: #388bfd : 100;
}

InputText ::cursor .input {
    text-color: #e6edf3;
}

LinearLayout .buttons {
    background-color: #0d1117;
    margin-top: 12;
    height: auto;
}

PushButton .submit {
    background-color: #238636;
    border-color: #2ea043;
    border: 1;
    margin: 4;
    padding-left: 18;
    padding-right: 18;
    padding-top: 8;
    padding-bottom: 8;
    width: max-content;
}

PushButton :hover .submit {
    background-color: #2ea043;
}

PushButton ::label .submit {
    text-color: #ffffff;
    font-family: "Noto Sans", sans-serif;
    font-weight: bold;
    font-size: 14;
}

// ====================================          SCENE          =====================================

FloatingLayout .scene-page {
    background-color: black;
}

Scene3D .scene {
    background-color: black!0;
}

Label .fps {
    text-color: #3fb950;
    background-color: black!0 : 160;
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 16;
    padding: 6;
    width: max-content;
    height: max-content;
}

// ====================================          STATUS          ====================================

Label .status {
    text-color: #8b949e;
    font-family: "Noto Sans", sans-serif;
    font-size: 13;
    text-xalign: left;
    padding-left: 12;
    padding-top: 4;
    padding-bottom: 4;
    height: auto;
}
