// The widget gallery: every widget of Balder, laid out with flex sizes and content sizes, an unset size being auto

@import "theme.style";
@import "sidebar.style";
@import "layouts.style";
@import "form.style";
@import "controls.style";
@import "scene.style";

MenuLayout.root, LinearLayout.body {
    background-color: $page;
}

// ===================================          MENU BAR          ===================================

LinearLayout.bar {
    direction: row;
    background-color: $panel;
}

MenuButton.menu {
    background-color: $panel;
    padding: 6 14;
}

MenuButton.menu:hover {
    background-color: $raised;
}

MenuButton.menu::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

LinearLayout.popup {
    background-color: $panel;
    border: 1 $edge;
}

PushButton.item {
    background-color: $panel;
    padding: 6 24 6 16;
}

PushButton.item:hover {
    background-color: $accent;
}

PushButton.item::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Box.fill {
    background-color: transparent;
    border-color: transparent;
    flex: 1;
}

Label.clock {
    text-color: $green;
    font-family: $mono;
    font-size: 13;
    padding-right: 12;
}

// ===================================          SPLITTER          ===================================

Splitter.main {
    direction: row;
    background-color: $page;
    border-color: $page;
    flex: 1;
}

Splitter.main::grip {
    width: 4;
    background-color: $edge;
}

Splitter.main::grip:hover {
    background-color: $focus;
}

Splitter.main::bbox {
    width: 12;
}

LinearLayout.inspector {
    background-color: $panel;
    padding: 12;
    width: 22%;
    min-width: 180;
}

// a narrow window leaves the inspector out, the splitter sharing its space between the sidebar and the tabs
@when (window.width < 900) {
    LinearLayout.inspector { display: none; }
}

Label.section {
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 12;
    text-xalign: left;
    padding-left: 12;
    padding-top: 12;
    padding-bottom: 6;
}

Label.info, Label.paragraph {
    text-color: $soft;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: top;
    text-wrap: wrap;
}

// =====================================          TABS          =====================================

// a min width of its own fixes the width of the pane, which the rows of the form measure
TabLayout.tabs {
    background-color: $page;
    min-width: 280;
}

TabLayout.tabs::tab {
    background-color: $panel;
    border: 1 $edge;
    text-color: $muted;
    font-family: $font;
    font-size: 14;
}

TabLayout.tabs::tab:hover {
    background-color: $raised;
    text-color: $text;
}

TabLayout.tabs::tab:selected {
    background-color: $page;
    border-color: $focus;
    text-color: $text;
}

LinearLayout.page {
    background-color: $page;
    padding: 16;
}

Label.heading {
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 15;
    text-xalign: left;
    margin-top: 14;
    margin-bottom: 6;
}

// ====================================          STATUS          ====================================

Label.status {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding-left: 12;
    padding-top: 4;
    padding-bottom: 4;
}
