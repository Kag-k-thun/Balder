// The look of the Form page of the gallery, the rows being laid out by field-row.style

LinearLayout.fields, LinearLayout.field-row {
    background-color: $page;
}

Label.field {
    text-color: $muted;
    font-family: $font;
    font-size: 14;
}

InputText.input {
    background-color: $panel;
    border: 2 $edge;
    radius: $corner;
    padding: 8;
}

InputText.input:hover {
    border-color: #484f58;
}

InputText.input:focus {
    border-color: $focus;
}

InputText.input::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText.input::selection {
    color: #388bfd64;
}

InputText.input::cursor {
    text-color: $text;
}

LinearLayout.buttons {
    direction: row;
    background-color: $page;
    margin-top: 12;
}

PushButton.submit {
    background-color: #238636;
    border: 1 #2ea043;
    radius: $round;
    margin: 4;
    padding: 8 18;
}

PushButton.submit:hover {
    background-color: #2ea043;
}

PushButton.submit:focus {
    shadow: 0 0 0 2 $focus;
}

PushButton.submit::label {
    text-color: #ffffff;
    font-family: $font;
    font-weight: bold;
    font-size: 14;
}
