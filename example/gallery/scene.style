// The look of the 3D scene page of the gallery

FloatingLayout.scene-page {
    background-color: black;
}

Scene3D.scene {
    background-color: black;
    width: 100%;
    height: 100%;
}

Label.fps {
    left: 12;
    top: 12;
    text-color: $green;
    background-color: #000000a0;
    font-family: $mono;
    font-size: 16;
    padding: 6;
}

FrameGraph.frames {
    left: 12;
    top: 56;
    width: 280;
    height: 224;
    background-color: $page;
    padding: 6;
}

FrameGraph.frames::cpu, FrameGraph.frames::gpu, FrameGraph.frames::activity, FrameGraph.frames::memory {
    font-family: $mono;
    font-size: 12;
    text-xalign: left;
    text-yalign: top;
}

FrameGraph.frames::cpu { text-color: $green; }
FrameGraph.frames::gpu { text-color: $focus; }
FrameGraph.frames::activity { text-color: #bc8cff; }
FrameGraph.frames::memory { text-color: #d29922; }
