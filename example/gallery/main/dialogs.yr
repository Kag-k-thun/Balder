in dialogs;

use balder::core::application::signal;
use balder::interface;
use balder::interface::dialog;
use balder::interface::dialog::color::utils;
use balder::interface::loader::registry::behavior;
use balder::math::vector;
use balder::utils::log;

use std::fs::path;

use ::sdl3::mouse;

/**
 * The slots of the Dialogs menu of the gallery, mounted under the behavior 'dialogs': each entry opens a dialog over the
 * gallery, or in a window of its own once the check box of the menu is checked, and its answer is shown in the status
 * bar
 * */
pub class DialogsBehavior over Behavior {

    // The interface of the gallery, the dialogs opening over it
    let dmut _gui: &WidgetManager;

    // The emitter of the activity of the gallery, running the slots of the answers
    let dmut _box: &SlotEmitter;

    // Shows a message in the status bar
    let _status: dg ([c8])-> void;

    // Where the dialogs are opened
    let mut _mode: DialogMode = DialogMode::OVERLAY;

    // The colour picked last, the colour dialog starting from it
    let mut _color: vec4 = makeVec4(0.12f, 0.44f, 0.92f, 1.0f);

    // The directory of the file chosen last, the file dialogs starting from it
    let mut _directory: [c8] = "";

    /**
     * @params:
     *    - gui: the interface of the gallery
     *    - box: the emitter of the activity of the gallery
     *    - status: shows a message in the status bar
     * */
    pub self (dmut gui: &WidgetManager, dmut box: &SlotEmitter, status: dg ([c8])-> void)
        with _gui = alias gui
        , _box = alias box
        , _status = status
    {
        self:.slot("windowed", &self:.onWindowedToggled);
        self:.slot("confirm", &self:.onConfirmClicked);
        self:.slot("open", &self:.onOpenClicked);
        self:.slot("save", &self:.onSaveClicked);
        self:.slot("folder", &self:.onFolderClicked);
        self:.slot("color", &self:.onColorClicked);
    }

    fn onWindowedToggled(mut self, checked: bool) {
        self._mode = if checked { DialogMode::WINDOW } else { DialogMode::OVERLAY };
        self._status(if checked { "Dialogs: in windows of their own" } else { "Dialogs: over the gallery" });
    }

    fn onConfirmClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut d = copy ConfirmDialog("Replace the colours of the gallery by those of the system?",
                                        accept-> "Replace", title-> "Confirm");
        d:.answered():.connect(alias self._box, &self:.onConfirmAnswered);
        self:.openDialog(alias d);
    }

    fn onOpenClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.openFileDialog(FileDialogMode::OPEN, "Open a file");
        }
    }

    fn onSaveClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.openFileDialog(FileDialogMode::SAVE, "Save a file");
        }
    }

    fn onFolderClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.openFileDialog(FileDialogMode::DIRECTORY, "Choose a folder");
        }
    }

    fn onColorClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut d = copy ColorDialog(color-> self._color, title-> "Pick a colour");
        d:.answered():.connect(alias self._box, &self:.onColorAnswered);
        self:.openDialog(alias d);
    }

    fn onConfirmAnswered(mut self, accepted: bool) {
        self._status(if accepted { "Confirm: replaced (not really)" } else { "Confirm: cancelled" });
    }

    fn onFileAnswered(mut self, path: ([c8])?) {
        if let Ok(p) = path {
            self._directory = Path(p).parent().toStr();
            self._status("File dialog: " ~ p);
        } else {
            self._status("File dialog: cancelled");
        }
    }

    fn onColorAnswered(mut self, rgba: (vec4)?) {
        if let Ok(c) = rgba {
            self._color = c;
            self._status("Colour: " ~ utils::hexText(c));
        } else {
            self._status("Colour: cancelled");
        }
    }

    /**
     * Open a file dialog from the directory of the file chosen last
     * */
    fn openFileDialog(mut self, mode: FileDialogMode, title: [c8]) {
        let dmut d = copy FileDialog(mode, directory-> self._directory, title-> title);
        d:.answered():.connect(alias self._box, &self:.onFileAnswered);
        self:.openDialog(alias d);
    }

    /**
     * Open a dialog where the check box of the menu says
     * */
    fn openDialog(mut self, dmut d: &Dialog) {
        {
            d:.open(self._mode, alias self._gui);
        } catch {
            err => {
                log::error #("Gallery", "Failed to open the dialog", err);
                self._status("The dialog could not be opened");
            }
        }
    }
}
