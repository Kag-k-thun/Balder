in controls;

use balder::interface;
use balder::interface::loader::registry::behavior;
use balder::interface::widget::button::dropdown;
use balder::interface::widget::range::_;
use balder::interface::widget::text::spin;

use std::conv;

/**
 * The slots of the controls page of the gallery, mounted under the behavior 'controls': the check boxes, the radio
 * buttons and the dropdowns report their choice in the status bar, and the slider, the spin box and the progress bar
 * show the same volume
 * */
pub class ControlsBehavior over Behavior {

    // The interface holding the controls
    let dmut _gui: &WidgetManager;

    // Shows a message in the status bar
    let _status: dg ([c8])-> void;

    /**
     * @params:
     *    - gui: the interface holding the controls
     *    - status: shows a message in the status bar
     * */
    pub self (dmut gui: &WidgetManager, status: dg ([c8])-> void)
        with _gui = alias gui
        , _status = status
    {
        self:.slot("toggled", &self:.onToggled);
        self:.slot("quality", &self:.onQualityChecked);
        self:.slot("volume", &self:.onVolumeSlid);
        self:.slot("volume-typed", &self:.onVolumeTyped);
        self:.slot("chosen", &self:.onChosen);
    }

    fn onToggled(mut self, name: [c8], checked: bool) {
        self._status(name ~ (if checked { ": on" } else { ": off" }));
    }

    fn onQualityChecked(mut self, name: [c8], checked: bool) {
        if checked {
            self._status("Quality: " ~ name);
        }
    }

    fn onVolumeSlid(mut self, volume: f32) {
        if let Ok(dmut s: &SpinBox) = self._gui:.find("BODY/MAIN/TABS/CONTROLS/VOLUME_VALUE") {
            s:.setValue(volume);
        }

        self:.showVolume(volume);
    }

    fn onVolumeTyped(mut self, volume: f32) {
        if let Ok(dmut s: &Slider) = self._gui:.find("BODY/MAIN/TABS/CONTROLS/VOLUME") {
            s:.setValue(volume);
        }

        self:.showVolume(volume);
    }

    /**
     * Show the item selected in a dropdown of the page
     * @params:
     *    - id: the id of the dropdown, bound by its 'on-change'
     *    - index: the index of the item selected
     * */
    fn onChosen(mut self, id: [c8], index: usize) {
        if let Ok(d: &Dropdown) = self._gui:.find("BODY/MAIN/TABS/CONTROLS/" ~ id) {
            self._status(id ~ ": " ~ d.getItems()[index]);
        }
    }

    /**
     * Fill the progress bar to the volume, and show it in the status bar
     * */
    fn showVolume(mut self, volume: f32) {
        if let Ok(dmut p: &ProgressBar) = self._gui:.find("BODY/MAIN/TABS/CONTROLS/LEVEL") {
            p:.setValue(volume);
        }

        self._status("Volume: " ~ to![c8] (volume, prec-> 0u32));
    }
}
