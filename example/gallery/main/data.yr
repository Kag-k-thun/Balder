in data;

use balder::interface;
use balder::interface::loader::registry::behavior;
use balder::interface::widget::table::{model, view};
use balder::interface::widget::tree::{model, view};

use std::conv;

// The number of sections of the tree of the page, and the number of children of each node under them
def SECTIONS = 1000us;
def CHILDREN = 4us;

// The depth of the leaves of the tree of the page: sections, chapters, then pages
def DEPTH = 3us;

// The number of rows of the table of the page
def FILES = 10000us;

// The width of the columns of the table of the page, wider together than the page
def COLUMN_WIDTHS = [200.0f, 110.0f, 110.0f, 120.0f, 130.0f, 320.0f];

/**
 * The nodes of the tree of the page, numbered, computed when the tree shows them: a thousand sections of four chapters
 * of four pages
 * */
class NumberedNodes over TreeModel {

    pub self () {}

    pub over len(self, node: [usize])-> usize {
        if node.len == 0us { SECTIONS } else if node.len < DEPTH { CHILDREN } else { 0us }
    }

    pub over text(self, node: [usize])-> [c8] {
        let names = copy ["Section", "Chapter", "Page"];
        let mut number = "";
        for i, n in node {
            number = number ~ (if i == 0us { "" } else { "." }) ~ to![c8] (n + 1us);
        }

        names[node.len - 1us] ~ " " ~ number
    }
}

/**
 * The rows of the table of the page, files whose kind, size, owner and date are computed from their number when the
 * table shows them
 * */
class GeneratedFiles over TableModel {

    pub self () {}

    pub over len(self)-> usize {
        FILES
    }

    pub over columns(self)-> usize {
        6us
    }

    pub over header(self, column: usize)-> [c8] {
        (copy ["Name", "Kind", "Size", "Owner", "Modified", "Folder"])[column]
    }

    pub over text(self, row: usize, column: usize)-> [c8] {
        let kinds = copy ["Image", "Document", "Archive", "Audio", "Video"];
        let owners = copy ["alice", "bob", "carol", "dave"];
        let extensions = copy ["png", "md", "zip", "ogg", "mkv"];
        let h = scramble(row);
        let kind = h % kinds.len;
        if column == 0us {
            "file-" ~ to![c8] (row + 1us) ~ "." ~ extensions[kind]
        } else if column == 1us {
            kinds[kind]
        } else if column == 2us {
            to![c8] ((h / 7us) % 90000us + 1us) ~ " KB"
        } else if column == 3us {
            owners[(h / 13us) % owners.len]
        } else if column == 4us {
            "2026-" ~ twoDigits((h / 17us) % 12us + 1us) ~ "-" ~ twoDigits((h / 19us) % 28us + 1us)
        } else {
            "/home/" ~ owners[(h / 13us) % owners.len] ~ "/" ~ kinds[kind] ~ "s/" ~ to![c8] (row / 100us)
        }
    }
}

/**
 * The slots of the data page of the gallery, mounted under the behavior 'data': the tree and the table report what is
 * selected and opened in the status bar
 * */
pub class DataBehavior over Behavior {

    // The interface holding the page
    let dmut _gui: &WidgetManager;

    // Shows a message in the status bar
    let _status: dg ([c8])-> void;

    /**
     * @params:
     *    - gui: the interface holding the page
     *    - status: shows a message in the status bar
     * */
    pub self (dmut gui: &WidgetManager, status: dg ([c8])-> void)
        with _gui = alias gui
        , _status = status
    {
        self:.slot("picked", &self:.onPicked);
        self:.slot("reached", &self:.onReached);
        self:.slot("listed", &self:.onListed);
        self:.slot("opened", &self:.onOpened);
    }

    /**
     * Give the tree and the table of the page their rows once the page is loaded, the third chapter of the second
     * section of the tree expanded, and the columns of the table wider together than the page
     * */
    pub fn fill(mut self) {
        if let Ok(dmut t: &TreeView) = self._gui:.find("BODY/MAIN/TABS/DATA/TREE") {
            t:.setModel(copy NumberedNodes());
            t:.expandNode(copy [1us, 2us]);
        }

        if let Ok(dmut t: &TableView) = self._gui:.find("BODY/MAIN/TABS/DATA/TABLE") {
            t:.setModel(copy GeneratedFiles());
            t:.setColumnWidths(copy COLUMN_WIDTHS);
        }
    }

    /**
     * Show the nodes selected in the tree of the page
     * @params:
     *    - nodes: the paths of the selected nodes, in the order of the rows
     * */
    fn onPicked(mut self, nodes: [[usize]]) {
        if nodes.len == 0us {
            self._status("Tree: no node selected");
        } else if nodes.len == 1us {
            self._status("Tree: " ~ pathText(nodes[0]));
        } else {
            self._status("Tree: " ~ to![c8] (nodes.len) ~ " nodes, from " ~ pathText(nodes[0]));
        }
    }

    /**
     * Show the node of the tree of the page Enter was pressed on, or the leaf double clicked
     * @params:
     *    - node: the path of the node
     * */
    fn onReached(mut self, node: [usize]) {
        self._status("Tree: opened " ~ pathText(node));
    }

    /**
     * Show the files selected in the table of the page
     * @params:
     *    - rows: the selected rows of the model, in increasing order
     * */
    fn onListed(mut self, rows: [usize]) {
        if rows.len == 0us {
            self._status("Table: no file selected");
        } else if rows.len == 1us {
            self._status("Table: file-" ~ to![c8] (rows[0] + 1us));
        } else {
            self._status("Table: " ~ to![c8] (rows.len) ~ " files");
        }
    }

    /**
     * Show the file of the table of the page Enter was pressed on, or the file double clicked
     * @params:
     *    - row: the row of the model
     * */
    fn onOpened(mut self, row: usize) {
        self._status("Table: opened file-" ~ to![c8] (row + 1us));
    }
}

/**
 * @returns: a number mixed from the number of a row, the same for the same row
 * */
fn scramble(row: usize)-> usize {
    ((row + 1us) * 2654435761us) % 4294967296us
}

/**
 * @returns: a number below 100 written with two digits
 * */
fn twoDigits(n: usize)-> [c8] {
    (if n < 10us { "0" } else { "" }) ~ to![c8] (n)
}

/**
 * @returns: the numbers of a path, from 1, separated by dots
 * */
fn pathText(node: [usize])-> [c8] {
    let mut result = "";
    for i, n in node {
        result = result ~ (if i == 0us { "" } else { "." }) ~ to![c8] (n + 1us);
    }

    result
}
