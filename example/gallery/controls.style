// The look of the Controls page of the gallery, scrolled when it is higher than the tab

LinearLayout.page.controls {
    overflow: scroll;
}

LinearLayout.page.controls::scrollbar {
    background-color: $edge;
    radius: $round;
}

LinearLayout.page.controls::scrollbar:hover {
    background-color: $muted;
}

LinearLayout.page.controls::scrollbar:pressed {
    background-color: $focus;
}

LinearLayout.choices, LinearLayout.volume {
    direction: row;
    background-color: $page;
}

CheckBox.check, RadioButton.radio {
    background-color: transparent;
    border-color: transparent;
    margin: 4 20 4 0;
}

CheckBox.check::box, RadioButton.radio::box {
    background-color: $panel;
    border: 2 $edge;
    padding: 3;
    margin-right: 8;
}

CheckBox.check::box { radius: 4; }
RadioButton.radio::box { radius: $round; }

CheckBox.check:hover::box, RadioButton.radio:hover::box {
    border-color: $muted;
}

CheckBox.check:focus::box, RadioButton.radio:focus::box {
    border-color: $focus;
}

CheckBox.check::mark, RadioButton.radio::mark {
    background-color: transparent;
    border-color: transparent;
}

CheckBox.check::mark { radius: 2; }
RadioButton.radio::mark { radius: $round; }

CheckBox.check:checked::mark, RadioButton.radio:checked::mark {
    background-color: $focus;
}

CheckBox.check::label, RadioButton.radio::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Separator.rule {
    background-color: $edge;
    margin: 16 0 2 0;
}

Slider.slider {
    background-color: transparent;
    border-color: transparent;
    margin: 4 16 4 0;
    flex: 1;
}

Slider.slider::track {
    background-color: $raised;
    radius: $round;
}

Slider.slider::fill {
    background-color: $accent;
    radius: $round;
}

Slider.slider::thumb {
    background-color: $soft;
    radius: $round;
}

Slider.slider:hover::thumb {
    background-color: $text;
}

Slider.slider:pressed::thumb {
    background-color: $focus;
}

Slider.slider:focus::thumb {
    shadow: 0 0 0 2 $focus;
}

SpinBox.spin {
    background-color: $panel;
    border: 2 $edge;
    radius: $corner;
    padding: 6 8;
    width: 96;
}

SpinBox.spin::prefix {
    width: 30%;
    padding-left: 5%;
    text-color: red;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
    text-overflow: ellipsis;
}

SpinBox.spin:hover {
    border-color: #484f58;
}

SpinBox.spin:focus {
    border-color: $focus;
}

SpinBox.spin::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

SpinBox.spin::selection {
    color: #388bfd64;
}

SpinBox.spin::cursor {
    text-color: $text;
}

SpinBox.spin::up, SpinBox.spin::down {
    background-color: $raised;
    width: 18;
    margin: 1;
    radius: 3;
}

SpinBox.spin::up:hover, SpinBox.spin::down:hover {
    background-color: $edge;
}

SpinBox.spin::up:pressed, SpinBox.spin::down:pressed {
    background-color: $accent;
}

ProgressBar.level {
    background-color: $raised;
    radius: $round;
    margin-top: 8;
}

ProgressBar.level::fill {
    background-color: $green;
    radius: $round;
}

Dropdown.dropdown {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    padding: 6 14;
    margin-right: 16;
    width: 200;
}

Dropdown.dropdown:hover {
    border-color: $muted;
}

Dropdown.dropdown:focus {
    border-color: $focus;
}

Dropdown.dropdown::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Dropdown.dropdown::popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    shadow: 0 4 12 #00000080;
    max-height: 240;
}

Dropdown.dropdown::scrollbar {
    background-color: $edge;
    radius: $round;
}

Dropdown.dropdown::scrollbar:pressed {
    background-color: $focus;
}

Dropdown.dropdown::scrollbar:hover {
    background-color: $focus;
}

Dropdown.dropdown::item {
    background-color: $panel;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 6 14;
    radius: 4;
}

Dropdown.dropdown::item:selected {
    text-color: $focus;
}

Dropdown.dropdown::item:hover {
    background-color: $accent;
    text-color: $text;
}

ListView.list {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    padding: 4 14 4 4;
    height: 240;
    margin-top: 8;
}

ListView.list:focus {
    border-color: $focus;
}

ListView.list::row {
    background-color: transparent;
    border: 1 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 4 10;
    radius: 4;
}

ListView.list::row:hover {
    background-color: $raised;
}

ListView.list::row:selected {
    background-color: $accent;
}

ListView.list:focus::row:current {
    border-color: $focus;
}

ListView.list::scrollbar {
    background-color: $edge;
    width: 8;
    radius: $round;
}

ListView.list::scrollbar:hover, ListView.list::scrollbar:pressed {
    background-color: $focus;
}

Image.picture {
    image-keep-ratio: true;
    radius: 8;
    max-width: 256;
    margin-top: 8;
}

// a tab bar of 32 pixels, the tab selected underlined in the accent, a dot on the tab unsaved, a cross closing the tab
// selected or hovered, a + after the tabs
TabBar.documents {
    background-color: $panel;
    border-width: 0 0 1 0;
    border-color: $edge;
    margin: 4 0;
}

TabBar.documents::tab {
    background-color: transparent;
    border-width: 0 0 2 0;
    border-color: transparent;
    height: 32;
    padding: 0 8 0 10;
    text-color: $muted;
    font-family: $font;
    font-size: 13;
}

TabBar.documents::tab:hover {
    text-color: $soft;
}

TabBar.documents::tab:selected {
    background-color: $page;
    border-color: $accent;
    text-color: $text;
}

TabBar.documents::tab:dragged {
    background-color: $raised;
}

TabBar.documents::dot {
    background-color: $text;
    radius: $round;
    width: 7;
    height: 7;
    margin-left: 6;
}

TabBar.documents::close {
    background-color: transparent;
    border: 0 transparent;
    radius: 3;
    image: "engine:/images/ui/close.svg";
    image-color: $muted;
    image-fill: false;
    width: 16;
    height: 16;
    margin-left: 4;
}

TabBar.documents::close:hover {
    background-color: $raised;
    image-color: $text;
}

TabBar.documents::add {
    background-color: transparent;
    border: 0 transparent;
    radius: 3;
    image: "engine:/images/ui/plus.svg";
    image-color: $soft;
    image-fill: false;
    width: 26;
    height: 24;
    margin: 0 4;
}

TabBar.documents::add:hover {
    background-color: $raised;
    image-color: $text;
}

// a toolbar of 32 pixels, its icons drawn white and tinted by image-color, lit under the cursor, in the focus colour
// while checked, its separators a vertical rule of 16 pixels, its segmented group joined by a seam of a pixel
ToolBar.demo-toolbar {
    direction: row;
    gap: 2;
    background-color: $panel;
    radius: $corner;
    height: 32;
    padding: 4 6;
    margin-bottom: 8;
}

ToolBar.demo-toolbar IconButton {
    background-color: transparent;
    radius: $corner;
    image-color: $soft;
    width: 26;
    height: 24;
    padding: 4 5;
}

ToolBar.demo-toolbar IconButton:hover { background-color: $raised; image-color: $text; }
ToolBar.demo-toolbar IconButton:pressed { background-color: $edge; }
ToolBar.demo-toolbar IconButton:checked { background-color: $raised; image-color: $focus; }

ToolBar.demo-toolbar Separator {
    direction: column;
    background-color: $edge;
    height: 16;
    margin: 4 4;
}

ToolBar.demo-toolbar ToolGroup {
    direction: row;
    gap: 1;
    background-color: $edge;
    radius: $corner;
}

ToolBar.demo-toolbar ToolGroup IconButton { radius: 0; background-color: $raised; }
ToolBar.demo-toolbar ToolGroup IconButton:first { radius: $corner 0 0 $corner; }
ToolBar.demo-toolbar ToolGroup IconButton:last { radius: 0 $corner $corner 0; }
ToolBar.demo-toolbar ToolGroup IconButton:first:last { radius: $corner; }
ToolBar.demo-toolbar ToolGroup IconButton:hover { background-color: $edge; }
ToolBar.demo-toolbar ToolGroup IconButton:checked { background-color: $accent; image-color: $text; }
