// The look of the Controls page of the gallery

LinearLayout.choices, LinearLayout.volume {
    direction: row;
    background-color: $page;
}

CheckBox.check, RadioButton.radio {
    background-color: transparent;
    border-color: transparent;
    margin: 4 20 4 0;
}

CheckBox.check::box, RadioButton.radio::box {
    background-color: $panel;
    border: 2 $edge;
    padding: 3;
    margin-right: 8;
}

CheckBox.check::box { radius: 4; }
RadioButton.radio::box { radius: $round; }

CheckBox.check:hover::box, RadioButton.radio:hover::box {
    border-color: $muted;
}

CheckBox.check:focus::box, RadioButton.radio:focus::box {
    border-color: $focus;
}

CheckBox.check::mark, RadioButton.radio::mark {
    background-color: transparent;
    border-color: transparent;
}

CheckBox.check::mark { radius: 2; }
RadioButton.radio::mark { radius: $round; }

CheckBox.check:checked::mark, RadioButton.radio:checked::mark {
    background-color: $focus;
}

CheckBox.check::label, RadioButton.radio::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Separator.rule {
    background-color: $edge;
    margin: 16 0 2 0;
}

Slider.slider {
    background-color: transparent;
    border-color: transparent;
    margin: 4 16 4 0;
    flex: 1;
}

Slider.slider::track {
    background-color: $raised;
    radius: $round;
}

Slider.slider::fill {
    background-color: $accent;
    radius: $round;
}

Slider.slider::thumb {
    background-color: $soft;
    radius: $round;
}

Slider.slider:hover::thumb {
    background-color: $text;
}

Slider.slider:pressed::thumb {
    background-color: $focus;
}

Slider.slider:focus::thumb {
    shadow: 0 0 0 2 $focus;
}

SpinBox.spin {
    background-color: $panel;
    border: 2 $edge;
    radius: $corner;
    padding: 6 8;
    width: 96;
}

SpinBox.spin:hover {
    border-color: #484f58;
}

SpinBox.spin:focus {
    border-color: $focus;
}

SpinBox.spin::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

SpinBox.spin::selection {
    color: #388bfd64;
}

SpinBox.spin::cursor {
    text-color: $text;
}

SpinBox.spin::up, SpinBox.spin::down {
    background-color: $raised;
    width: 18;
    margin: 1;
    radius: 3;
}

SpinBox.spin::up:hover, SpinBox.spin::down:hover {
    background-color: $edge;
}

SpinBox.spin::up:pressed, SpinBox.spin::down:pressed {
    background-color: $accent;
}

ProgressBar.level {
    background-color: $raised;
    radius: $round;
    margin-top: 8;
}

ProgressBar.level::fill {
    background-color: $green;
    radius: $round;
}

Dropdown.dropdown {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    padding: 6 14;
    margin-right: 16;
    width: 200;
}

Dropdown.dropdown:hover {
    border-color: $muted;
}

Dropdown.dropdown:focus {
    border-color: $focus;
}

Dropdown.dropdown::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Dropdown.dropdown::popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    shadow: 0 4 12 #00000080;
    max-height: 240;
}

Dropdown.dropdown::scrollbar {
    background-color: $edge;
    radius: $round;
}

Dropdown.dropdown::scrollbar:pressed {
    background-color: $focus;
}

Dropdown.dropdown::scrollbar:hover {
    background-color: $focus;
}

Dropdown.dropdown::item {
    background-color: $panel;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 6 14;
    radius: 4;
}

Dropdown.dropdown::item:selected {
    text-color: $focus;
}

Dropdown.dropdown::item:hover {
    background-color: $accent;
    text-color: $text;
}

Image.picture {
    image-keep-ratio: true;
    radius: 8;
    max-width: 256;
    margin-top: 8;
}
