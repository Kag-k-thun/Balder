// The 3D scene page of the gallery: a scene rendered to a texture, its frame rate and its frame times over it

@component ScenePage () {
    FloatingLayout .scene-page {
        Scene3D #SCENE .scene { resolution: 1280 720; }
        Label #FPS .fps "0 fps" { capture-events: false; }
        FrameGraph #FRAMES .frames { frames: 90; capture-events: false; }
    }
}
