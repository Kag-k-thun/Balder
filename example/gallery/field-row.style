// The default look of a FieldRow: its label, of a fixed width, then its input on a row, stacked when the row is narrow

// The width under which the label is stacked above the input
$narrow: 560;

FieldRow {
    direction: row;

    @when (width < $narrow) {
        direction: column;
    }
}

FieldRow > Label.field {
    text-xalign: left;
    width: 130;

    @when (width < $narrow) {
        width: auto;
        margin-left: 6;
    }
}

FieldRow > InputText.input {
    margin: 6;
    flex: 1;
}
