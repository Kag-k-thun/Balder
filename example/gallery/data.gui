// The Data page of the gallery: a tree view and a table view, reporting to the behavior 'data'

@component DataPage () {
    LinearLayout .page .data {
        Label .heading "A tree view of a thousand sections, read on demand as they are expanded";
        TreeView #TREE .tree { multiple: true; on-select: data::picked; on-activate: data::reached; }

        Separator .rule;
        Label .heading "A table of ten thousand files, sorted and resized by its headers";
        TableView #TABLE .table { multiple: true; on-select: data::listed; on-activate: data::opened; }
    }
}
