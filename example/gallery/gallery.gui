@import "sidebar.gui";
@import "layouts.gui";
@import "form.gui";
@import "controls.gui";
@import "data.gui";
@import "scene.gui";

MenuLayout .root {
    LinearLayout #BAR .bar {
        MenuButton #FILE .menu "File" {
            LinearLayout #FILE_MENU .popup {
                PushButton .item "New page";
                PushButton #CLEAR .item "Clear the form" { on-click: form::reset; }
                PushButton #QUIT .item "Quit" { on-click: quit; }
            }
        }
        MenuButton .menu "View" {
            LinearLayout .popup {
                PushButton .item "Layouts" { on-click: switch_tab(0); }
                PushButton .item "Form" { on-click: switch_tab(1); }
                PushButton .item "Controls" { on-click: switch_tab(2); }
                PushButton .item "Data" { on-click: switch_tab(3); }
                PushButton .item "3D scene" { on-click: switch_tab(4); }
            }
        }
        MenuButton #DIALOGS .menu "Dialogs" {
            LinearLayout #DIALOGS_MENU .popup {
                PushButton .item "Confirm an action…" { on-click: dialogs::confirm; }
                PushButton .item "Open a file…" { on-click: dialogs::open; }
                PushButton .item "Save a file…" { on-click: dialogs::save; }
                PushButton .item "Choose a folder…" { on-click: dialogs::folder; }
                PushButton .item "Pick a colour…" { on-click: dialogs::color; }
                Separator .menu-rule;
                CheckBox #WINDOWED .menu-check "In a window of their own" { on-toggle: dialogs::windowed; }
            }
        }
        MenuButton #HELP .menu "Help" {
            LinearLayout #HELP_MENU .popup {
                PushButton #ABOUT .item "About the gallery…" { on-click: about; }
            }
        }
        Box .fill;
        Label #CLOCK .clock "0 fps";
    }

    LinearLayout #BODY .body {
        Splitter #MAIN .main {
            Sidebar #SIDEBAR;

            TabLayout #TABS .tabs {
                LayoutsPage #LAYOUTS { tab: "Layouts"; }
                FormPage #FORM { tab: "Form"; }
                ControlsPage #CONTROLS { tab: "Controls"; }
                DataPage #DATA { tab: "Data"; }
                ScenePage #SCENE_PAGE { tab: "3D scene"; }
            }

            LinearLayout #INSPECTOR .inspector {
                Label .section "Inspector";
                Label #SELECTION .info "Nothing selected yet: click a widget in the sidebar.";
            }
        }

        Label #STATUS .status "Ready";
    }
}
