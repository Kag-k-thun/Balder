MenuLayout .root {
    LinearLayout #BAR .bar {
        MenuButton #FILE .menu "File" {
            LinearLayout #FILE_MENU .popup {
                PushButton .item "New page";
                PushButton #CLEAR .item "Clear the form";
                PushButton #QUIT .item "Quit";
            }
        }
        MenuButton .menu "View" {
            LinearLayout .popup {
                PushButton .item "Layouts";
                PushButton .item "Form";
                PushButton .item "3D scene";
            }
        }
        MenuButton #HELP .menu "Help" {
            LinearLayout #HELP_MENU .popup {
                PushButton #ABOUT .item "About the gallery…";
            }
        }
        Box .fill;
        Label #CLOCK .clock "0 fps";
    }

    LinearLayout #BODY .body {
        Splitter #MAIN .main {
            LinearLayout #SIDEBAR .sidebar {
                Label .section "Widgets";
                PushButton #W_LABEL .entry "Label";
                PushButton #W_INPUT .entry "InputText";
                PushButton #W_PUSH .entry "PushButton";
                PushButton #W_MENU .entry "MenuButton";
                PushButton #W_BOX .entry "Box";
                PushButton #W_SCENE .entry "Scene3D";
                Label .section "Layouts";
                PushButton #L_LINEAR .entry "LinearLayout";
                PushButton #L_GRID .entry "GridLayout";
                PushButton #L_FLOATING .entry "FloatingLayout";
                PushButton #L_SCROLL .entry "Scrolling";
                PushButton #L_TAB .entry "TabLayout";
                PushButton #L_MENU .entry "MenuLayout";
                PushButton #L_SPLITTER .entry "Splitter";
            }

            TabLayout #TABS .tabs {
                LinearLayout #LAYOUTS .page {
                    tab: "Layouts";
                    Label .heading "Flex: the free space shared 1 : 2, a fixed box";
                    LinearLayout .flex-row {
                        Box .grow-one;
                        Box .grow-two;
                        Box .fixed;
                    }

                    Label .heading "Content sizing: buttons as wide as their text";
                    LinearLayout #CHIPS .chips {
                        PushButton #CHIP_A .chip "Short";
                        PushButton #CHIP_B .chip "A longer chip";
                        PushButton #CHIP_C .chip "The longest chip of the row";
                        Box .fill;
                    }

                    Label .heading "A label of height auto, wrapped to its width";
                    Label .paragraph "Balder lays its widgets out in two passes: each layout measures the content of its children first, then places them. A label asks for the height of its lines wrapped to the width it is given, so resizing the window or dragging the grips of the splitter makes this paragraph taller or shorter.";

                    Label .heading "A grid of cells";
                    GridLayout #GRID .grid {
                        Box .cell-a;
                        Label .cell "(1, 0)";
                        Box .cell-b;
                        Label .cell "(0, 1)";
                        Box .cell-b;
                        PushButton #CELL_F .chip "(2, 1)";
                    }
                }

                LinearLayout #FORM .page {
                    tab: "Form";
                    Label .heading "Tell us about yourself";
                    LinearLayout #NAME_ROW .row {
                        Label .field "Name";
                        InputText #NAME .input { max-length: 64; }
                    }
                    LinearLayout #AGE_ROW .row {
                        Label .field "Age";
                        InputText #AGE .input { max-length: 3; only-numbers: true; }
                    }
                    LinearLayout #EMAIL_ROW .row {
                        Label .field "Email address";
                        InputText #EMAIL .input { max-length: 128; }
                    }
                    LinearLayout #BUTTONS .buttons {
                        Box .fill;
                        PushButton #SUBMIT .submit "Submit";
                        PushButton #RESET .chip "Reset";
                    }
                }

                FloatingLayout #SCENE_PAGE .scene-page {
                    tab: "3D scene";
                    Scene3D #SCENE .scene { resolution: 1280 720; }
                    Label #FPS .fps "0 fps" { capture-events: false; }
                }
            }

            LinearLayout #INSPECTOR .inspector {
                Label .section "Inspector";
                Label #SELECTION .info "Nothing selected yet: click a widget in the sidebar.";
            }
        }

        Label #STATUS .status "Ready";
    }
}
