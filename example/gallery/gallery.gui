MenuLayout ROOT (class: "root") {
    LinearLayout BAR (class: "bar", orientation: horizontal) {
        MenuButton FILE (class: "menu") {
            "File";
            LinearLayout FILE_MENU (class: "popup") {
                PushButton NEW (class: "item") { "New page" }
                PushButton CLEAR (class: "item") { "Clear the form" }
                PushButton QUIT (class: "item") { "Quit" }
            }
        }
        MenuButton VIEW (class: "menu") {
            "View";
            LinearLayout VIEW_MENU (class: "popup") {
                PushButton SHOW_LAYOUTS (class: "item") { "Layouts" }
                PushButton SHOW_FORM (class: "item") { "Form" }
                PushButton SHOW_SCENE (class: "item") { "3D scene" }
            }
        }
        MenuButton HELP (class: "menu") {
            "Help";
            LinearLayout HELP_MENU (class: "popup") {
                PushButton ABOUT (class: "item") { "About the gallery…" }
            }
        }
        Box BAR_FILL (class: "fill");
        Label CLOCK (class: "clock") { "0 fps" }
    }

    LinearLayout BODY (class: "body") {
        Splitter MAIN (class: "main", orientation: horizontal) {
            LinearLayout SIDEBAR (class: "sidebar", scrollable: true) {
                Label SIDE_TITLE (class: "section") { "Widgets" }
                PushButton W_LABEL (class: "entry") { "Label" }
                PushButton W_INPUT (class: "entry") { "InputText" }
                PushButton W_PUSH (class: "entry") { "PushButton" }
                PushButton W_MENU (class: "entry") { "MenuButton" }
                PushButton W_BOX (class: "entry") { "Box" }
                PushButton W_SCENE (class: "entry") { "Scene3D" }
                Label SIDE_LAYOUTS (class: "section") { "Layouts" }
                PushButton L_LINEAR (class: "entry") { "LinearLayout" }
                PushButton L_GRID (class: "entry") { "GridLayout" }
                PushButton L_FLOATING (class: "entry") { "FloatingLayout" }
                PushButton L_SCROLL (class: "entry") { "ScrollLayout" }
                PushButton L_TAB (class: "entry") { "TabLayout" }
                PushButton L_MENU (class: "entry") { "MenuLayout" }
                PushButton L_SPLITTER (class: "entry") { "Splitter" }
            }

            TabLayout TABS (class: "tabs") {
                ("Layouts") LinearLayout LAYOUTS (class: "page") {
                    Label FLEX_TITLE (class: "heading") { "Flex: the free space shared 1 : 2, a fixed box" }
                    LinearLayout FLEX_ROW (class: "flex-row", orientation: horizontal) {
                        Box GROW_ONE (class: "grow-one");
                        Box GROW_TWO (class: "grow-two");
                        Box FIXED (class: "fixed");
                    }

                    Label CHIPS_TITLE (class: "heading") { "Content sizing: buttons as wide as their text" }
                    LinearLayout CHIPS (class: "chips", orientation: horizontal) {
                        PushButton CHIP_A (class: "chip") { "Short" }
                        PushButton CHIP_B (class: "chip") { "A longer chip" }
                        PushButton CHIP_C (class: "chip") { "The longest chip of the row" }
                        Box CHIPS_FILL (class: "fill");
                    }

                    Label TEXT_TITLE (class: "heading") { "A label of height auto, wrapped to its width" }
                    Label TEXT (class: "paragraph") { "Balder lays its widgets out in two passes: each layout measures the content of its children first, then places them. A label asks for the height of its lines wrapped to the width it is given, so resizing the window or dragging the grips of the splitter makes this paragraph taller or shorter." }

                    Label GRID_TITLE (class: "heading") { "A grid of cells" }
                    GridLayout GRID (class: "grid", columns: 3, rows: 2) {
                        (0, 0) Box CELL_A (class: "cell-a");
                        (1, 0) Label CELL_B (class: "cell") { "(1, 0)" }
                        (2, 0) Box CELL_C (class: "cell-b");
                        (0, 1) Label CELL_D (class: "cell") { "(0, 1)" }
                        (1, 1) Box CELL_E (class: "cell-b");
                        (2, 1) PushButton CELL_F (class: "chip") { "(2, 1)" }
                    }
                }

                ("Form") LinearLayout FORM (class: "page") {
                    Label FORM_TITLE (class: "heading") { "Tell us about yourself" }
                    LinearLayout NAME_ROW (class: "row", orientation: horizontal) {
                        Label NAME_LABEL (class: "field") { "Name" }
                        InputText NAME (class: "input", len: 64);
                    }
                    LinearLayout AGE_ROW (class: "row", orientation: horizontal) {
                        Label AGE_LABEL (class: "field") { "Age" }
                        InputText AGE (class: "input", len: 3, only-numbers: true);
                    }
                    LinearLayout EMAIL_ROW (class: "row", orientation: horizontal) {
                        Label EMAIL_LABEL (class: "field") { "Email address" }
                        InputText EMAIL (class: "input", len: 128);
                    }
                    LinearLayout BUTTONS (class: "buttons", orientation: horizontal) {
                        Box BUTTONS_FILL (class: "fill");
                        PushButton SUBMIT (class: "submit") { "Submit" }
                        PushButton RESET (class: "chip") { "Reset" }
                    }
                }

                ("3D scene") FloatingLayout SCENE_PAGE (class: "scene-page") {
                    (x: 0, y: 0) Scene3D SCENE (class: "scene", w: 1280, h: 720);
                    (x: 12, y: 12, capture-events: false) Label FPS (class: "fps") { "0 fps" }
                }
            }

            LinearLayout INSPECTOR (class: "inspector") {
                Label INSPECTOR_TITLE (class: "section") { "Inspector" }
                Label SELECTION (class: "info") { "Nothing selected yet: click a widget in the sidebar." }
            }
        }

        Label STATUS (class: "status") { "Ready" }
    }
}
