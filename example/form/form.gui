LinearLayout #FORM .root {
    Label .title "Tell us about yourself";
    LinearLayout #NAME_ROW .row {
        Label .field "Name";
        InputText #NAME .input { max-length: 64; on-validate: name-set; }
    }
    LinearLayout #AGE_ROW .row {
        Label .field "Age";
        InputText #AGE .input { max-length: 3; only-numbers: true; on-validate: age-set; }
    }
    LinearLayout #EMAIL_ROW .row {
        Label .field "Email";
        InputText #EMAIL .input { max-length: 128; on-validate: email-set; }
    }
    Label #SUMMARY .summary;
    LinearLayout #BUTTONS .buttons {
        PushButton #SUBMIT .submit "Submit" { on-click: submit; }
        PushButton #CLEAR .clear "Clear" { on-click: clear; }
    }
}
