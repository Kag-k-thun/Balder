LinearLayout .root {
    background-color: #202328;
}

LinearLayout .row {
    background-color: #202328;
    margin-left: 20;
    margin-right: 20;
    height: 50;
}

LinearLayout .buttons {
    background-color: #202328;
    margin-left: {
        relative: 0.4;
    }
    margin-right: 10;
    height: 60;
}


Label .title {
    text-color: #eeeff2;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 22;
    text-xalign: center;
    margin-top: 10;
    height: 60;
}

Label .field {
    text-color: #9aa3ad;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 18;
    text-xalign: left;
    width: 90;
}

Label .summary {
    text-color: #2fc49f;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 16;
    text-xalign: center;
    margin-top: 10;
    height: 40;
}


InputText .input {
    background-color: #2a2e34;
    border-color: #4a5259;
    border: 2;
    margin: 6;
    width: {
        relative: 0.8;
    }
    padding-left: 6;
    padding-right: 6;
}

InputText :hover .input {
    border-color: #6b747d;
}

InputText :focus .input {
    border-color: #4c98fd;
}

InputText ::label .input {
    text-color: #eeeff2;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 18;
    text-xalign: left;
    text-yalign: center;
}

InputText ::selection .input {
    color: #4c98fd : 120;
}

InputText ::cursor .input {
    text-color: #eeeff2;
}


PushButton .submit {
    background-color: #22252a;
    border-color: #4a5259;
    border: 2;
    margin: 10;
    width: {
        relative: 0.5;
    }
}

PushButton :hover .submit {
    background-color: #cccccc;
    border-color: #ffffff;
}

PushButton ::label .submit {
    text-color: #4c98fd;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 20;
}

PushButton :hover ::label .submit {
    text-color: #2fc49f;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 20;
}

PushButton .clear {
    background-color: #22252a;
    border-color: #4a5259;
    border: 2;
    margin: 10;
    width: {
        relative: 0.5;
    }
}

PushButton :hover .clear {
    background-color: red!40;
    border-color: grey!70;
}

PushButton ::label .clear {
    text-color: #f1bcbd;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 20;
}

PushButton :hover ::label .clear {
    text-color: black;
    font: "res:/fonts/noto/NotoSans-Regular.ttf";
    font-size: 20;
}
