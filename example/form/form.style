// An input form: three fields, a summary, and the buttons submitting and clearing them

$page: #16181d;
$font: "Noto Sans", sans-serif;

LinearLayout.root, LinearLayout.row, LinearLayout.buttons {
    background-color: $page;
}

LinearLayout.row {
    direction: row;
    margin-left: 20;
    margin-right: 20;
    height: 50;
}

LinearLayout.buttons {
    direction: row;
    margin-left: 40%;
    margin-right: 10;
    height: 60;
}

Label.title {
    text-color: #f0f3f6;
    font-family: $font;
    font-weight: bold;
    font-size: 18;
    text-xalign: center;
    margin-top: 10;
    height: 60;
}

Label.field {
    text-color: #8b949e;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    width: 90;
}

Label.summary {
    text-color: #3fb950;
    font-family: $font;
    font-style: italic;
    font-size: 14;
    text-xalign: center;
    text-wrap: wrap;
    margin-top: 10;
    height: 60;
}

// ====================================          INPUTS          ====================================

InputText.input {
    background-color: #1f232a;
    border: 2 #30363d;
    margin: 6;
    width: 80%;
    padding-left: 6;
    padding-right: 6;
}

InputText.input:hover {
    border-color: #484f58;
}

InputText.input:focus {
    border-color: #388bfd;
}

InputText.input::label {
    text-color: #e6edf3;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText.input::selection {
    color: #388bfd64;
}

InputText.input::cursor {
    text-color: #e6edf3;
}

// ====================================          BUTTONS          ===================================

PushButton.submit, PushButton.clear {
    border: 2;
    margin: 10;
    width: 50%;
}

PushButton.submit::label, PushButton.clear::label {
    font-family: $font;
    font-size: 16;
}

PushButton.submit {
    background-color: #1f6feb;
    border-color: #1f6feb;
}

PushButton.submit:hover {
    background-color: #388bfd;
    border-color: #388bfd;
}

PushButton.submit::label {
    text-color: #ffffff;
}

PushButton.clear {
    background-color: #21262d;
    border-color: #30363d;
}

PushButton.clear:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

PushButton.clear::label {
    text-color: #c9d1d9;
}

PushButton.clear:hover::label {
    text-color: #f0f6fc;
}
