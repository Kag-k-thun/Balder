LinearLayout .root {
    background-color: #16181d;
}

LinearLayout .row {
    background-color: #16181d;
    margin-left: 20;
    margin-right: 20;
    height: 50;
}

LinearLayout .buttons {
    background-color: #16181d;
    margin-left: {
        relative: 0.4;
    }
    margin-right: 10;
    height: 60;
}


Label .title {
    text-color: #f0f3f6;
    font-family: "Noto Sans", sans-serif;
    font-weight: bold;
    font-size: 18;
    text-xalign: center;
    margin-top: 10;
    height: 60;
}

Label .field {
    text-color: #8b949e;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    width: 90;
}

Label .summary {
    text-color: #3fb950;
    font-family: "Noto Sans", sans-serif;
    font-style: italic;
    font-size: 14;
    text-xalign: center;
    text-wrap: wrap;
    margin-top: 10;
    height: 60;
}


InputText .input {
    background-color: #1f232a;
    border-color: #30363d;
    border: 2;
    margin: 6;
    width: {
        relative: 0.8;
    }
    padding-left: 6;
    padding-right: 6;
}

InputText :hover .input {
    border-color: #484f58;
}

InputText :focus .input {
    border-color: #388bfd;
}

InputText ::label .input {
    text-color: #e6edf3;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText ::selection .input {
    color: #388bfd : 100;
}

InputText ::cursor .input {
    text-color: #e6edf3;
}


PushButton .submit {
    background-color: #1f6feb;
    border-color: #1f6feb;
    border: 2;
    margin: 10;
    width: {
        relative: 0.5;
    }
}

PushButton :hover .submit {
    background-color: #388bfd;
    border-color: #388bfd;
}

PushButton ::label .submit {
    text-color: #ffffff;
    font-family: "Noto Sans", sans-serif;
    font-size: 16;
}

PushButton :hover ::label .submit {
    text-color: #ffffff;
    font-family: "Noto Sans", sans-serif;
    font-size: 16;
}

PushButton .clear {
    background-color: #21262d;
    border-color: #30363d;
    border: 2;
    margin: 10;
    width: {
        relative: 0.5;
    }
}

PushButton :hover .clear {
    background-color: #30363d;
    border-color: #8b949e;
}

PushButton ::label .clear {
    text-color: #c9d1d9;
    font-family: "Noto Sans", sans-serif;
    font-size: 16;
}

PushButton :hover ::label .clear {
    text-color: #f0f6fc;
    font-family: "Noto Sans", sans-serif;
    font-size: 16;
}
