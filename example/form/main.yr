in main;

use balder::core::{_, application::_};
use balder::interface::widget::text::{input, label};
use balder::utils::{log, path};

use std::{config::_, io};
use std::fs::path;

use ::sdl2::_;

/**
 * A small form of input texts, to try the text input by hand.
 * Each field reports its content when it is validated (Enter, or losing the focus), Submit prints the
 * whole form, and Clear empties it.
 * */
class FormActivity over Activity {

    let mut _name: [c8]  = "";
    let mut _age: [c8]   = "";
    let mut _email: [c8] = "";

    let dmut _summary: (&Label)? = none;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);
        println(self.gui:.loadStyleFile(formFile("form.style"))?);
        println(self.gui:.loadGUIFile(formFile("form.gui"))?);

        if let Ok(dmut name: &InputText) = self.gui:.find("NAME_ROW/NAME") {
            name:.textValidated():.connect(self.box, &self:.onNameValidated);
        }

        if let Ok(dmut age: &InputText) = self.gui:.find("AGE_ROW/AGE") {
            age:.textValidated():.connect(self.box, &self:.onAgeValidated);
        }

        if let Ok(dmut email: &InputText) = self.gui:.find("EMAIL_ROW/EMAIL") {
            email:.textValidated():.connect(self.box, &self:.onEmailValidated);
        }

        if let Ok(dmut submit) = alias self.gui:.find("BUTTONS/SUBMIT") {
            submit:.clicked():.connect(self.box, &self:.onSubmitClicked);
        }

        if let Ok(dmut clear) = alias self.gui:.find("BUTTONS/CLEAR") {
            clear:.clicked():.connect(self.box, &self:.onClearClicked);
        }

        if let Ok(dmut summary: &Label) = self.gui:.find("SUMMARY") {
            self._summary = (alias summary)?;
        }
    }

    fn onNameValidated(mut self, text: [c8]) {
        self._name = text;
        self:.report("name", text);
    }

    fn onAgeValidated(mut self, text: [c8]) {
        self._age = text;
        self:.report("age", text);
    }

    fn onEmailValidated(mut self, text: [c8]) {
        self._email = text;
        self:.report("email", text);
    }

    fn onSubmitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            let msg = "Hello " ~ self._name ~ " (" ~ self._age ~ "), we will write to " ~ self._email;
            println(msg);
            self:.showSummary(msg);
        }
    }

    fn onClearClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            for path in ["NAME_ROW/NAME", "AGE_ROW/AGE", "EMAIL_ROW/EMAIL"] {
                if let Ok(dmut field: &InputText) = self.gui:.find(path) {
                    field:.setText("");
                }
            }

            self._name = "";
            self._age = "";
            self._email = "";
            self:.showSummary("");
        }
    }

    /**
     * Print the validated content of a field, between quotes so the trailing spaces show
     * */
    fn report(mut self, field: [c8], text: [c8]) {
        let msg = field ~ ": \"" ~ text ~ "\"";
        println(msg);
        self:.showSummary(msg);
    }

    fn showSummary(mut self, msg: [c8]) {
        if let Ok(dmut summary) = alias self._summary {
            summary:.setText(msg);
        }
    }

    fn onQuit(mut self) {
        self.app:.close(alias self);
    }
}

/**
 * @returns: the path of a file of the form example, under the project directory
 * */
fn formFile(name: [c8])-> [c8] {
    getProjectPath().push("example/form").push(name).toStr()
}

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' and 'shaders:/' paths
 * are resolved against
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let dmut parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ and example/ (the current directory by default)");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
        }

        true
    } catch {
        err: &std::config::args::errors::CommandLineError => {
            eprintln(parser.explain(err, usage-> "form"));
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig(formFile("form.toml"));
        let dmut app = copy Application();
        app:.open!{&FormActivity} (cfg);

        app:.run();
    } catch {
        err => {
            log::error #("Form", "Failed to open the form", err);
        }
    }
}
