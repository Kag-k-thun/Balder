in main;

mod ::activity;

use main::activity;
use balder::core::{_, application::_};
use balder::scene::physics;
use balder::utils::path;

use std::{config, config::args, io};
use std::fs;

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' paths are resolved against, '--model'
 * choosing the concave model dropped
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ (the current directory by default)")
        :.option!{[c8]} ("model", comments-> "the concave model dropped, a res:/… or a file path, its hulls read from the .hulls next to it (res:/models/teapot/teapot.obj by default)")
        :.flag("debug", comments-> "draw the colliders, the contacts and the joints from the start, 'S', 'C', 'B', 'T' and 'J' toggling the shapes, the contacts, the boxes, the tree of the broadphase and the joints");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
            setEnginePath(Path(dir));
        }

        if let Ok(Str(value-> model)) = cfg["model"]? {
            __MODEL__ = model;
        }

        if cfg["debug"].to!{bool} () ?? false {
            __DEBUG__[0] = PhysicsDebug::SHAPES | PhysicsDebug::CONTACTS | PhysicsDebug::JOINTS;
        }

        true
    } catch {
        err: &std::config::args::CommandLineError => {
            eprintln(parser.explain(err, usage-> "crates"));
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig("res:/config/crates.toml");
        let dmut app = copy Application();
        app:.open!{&CratesActivity} (cfg);

        app:.run();
    } catch {
        bd => {
            eprintln(bd);
        }
    }
}
