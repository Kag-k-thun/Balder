in activity;

use balder::math::_;
use balder::core::{_, application::_};
use balder::interface;
use balder::interface::widget::layout::_;
use balder::scene::node::{node3D::_, node3D::body, node3D::camera, node3D::joint, node3D::visual::_, node3D::visual::material::_};
use balder::scene::physics;
use balder::utils::log;

use sdl3::_;

use std::{math, time};

/**
 * The crates stacked, and the side of a crate, in metres
 * */
def CRATES = 10;
def CRATE = 1.0f;

/**
 * The angle of the slope, in radians (its tangent 0.31), the friction of its board, and the frictions of the two boxes
 * on it, the friction of a contact being the geometric mean of the two: the first sticks (0.5), the second slides (0.16)
 * */
def SLOPE = 0.3f;
def BOARD = 0.5f;
def STICKING = 0.5f;
def SLIDING = 0.05f;

/**
 * The radius of a ball, its mass and the impulse throwing it, in newton seconds
 * */
def BALL = 0.25f;
def BALL_MASS = 2.0f;
def THROW = 30.0f;

/**
 * The links of the chain hanging from its beam, and the length of a link, in metres
 * */
def LINKS = 8;
def LINK = 0.5f;

/**
 * The torque closing the door on its hinge, in newton metres, and the speed it closes at, in radians a second
 * */
def DOOR_CLOSER = 40.0f;
def DOOR_CLOSING = -1.0f;

/**
 * The teapots dropped, their model, its size and the mass of a teapot, their shape the convex decomposition saved next to
 * the model (see SolidObjectModel::decomposition)
 * */
def TEAPOTS = 3;
def TEAPOT = "res:/models/teapot/teapot.obj";
def TEAPOT_SIZE = 1.5f;
def TEAPOT_MASS = 3.0f;

/**
 * The categories of the debug view of the physics drawn from the start (see Scene::physicsDebug), set by '--debug'
 * */
pub lazy dmut __DEBUG__ = copy [0u32];

/**
 * The point the camera turns about
 * */
def CENTRE = makeVec3(0.0f, 2.5f, 0.0f);

/**
 * The solver of the physics to look at: a stack of crates on the ground, two boxes on a slope, one sticking, the other
 * sliding, balls bouncing, a chain swinging from a beam, a door closed by its hinge, a ragdoll tumbling down stairs,
 * teapots falling on each other, concave bodies made of the hulls of their convex decomposition, and a ball thrown
 * from the camera at each press of Space; the right button turns the camera, the wheel zooms; 'S', 'C',
 * 'B', 'T' and 'J' toggle the debug view of the colliders, of the contacts, of the boxes of the colliders, of the tree of
 * the broadphase and of the joints
 * */
pub class CratesActivity over Activity {

    let dmut _scene: (&Scene)? = none;
    let dmut _cam: (&PerspectiveCamera)? = none;

    // The materials of the crates, of the boxes on the slope, of the balls and of the bodies held by joints
    let mut _crate: MaterialConfig = MaterialConfig();
    let mut _ball: MaterialConfig = MaterialConfig();
    let mut _jointed: MaterialConfig = MaterialConfig();

    // The balls thrown, named after their count
    let mut _thrown: u32 = 0u32;

    // The camera turning about the centre: its yaw and its pitch, in degrees, and its distance
    let mut _yaw: f32 = 30.0f;
    let mut _pitch: f32 = -15.0f;
    let mut _distance: f32 = 16.0f;
    let mut _turning: bool = false;
    let mut _turnStart: (i32, i32) = (0, 0);

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {
        self._crate.baseColor = makeVec3(0.7f, 0.45f, 0.2f);
        self._crate.roughness = 0.8f;
        self._ball.baseColor = makeVec3(0.85f, 0.15f, 0.1f);
        self._ball.roughness = 0.4f;
        self._jointed.baseColor = makeVec3(0.25f, 0.45f, 0.75f);
        self._jointed.roughness = 0.6f;
    }

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);
        self.input:.keyboard(KeyInfo(SDLK_SPACE, KeyEvent::DOWN)):.connect(self.box, &self:.onThrow);
        self.input:.keyboard(KeyInfo(SDLK_R, KeyEvent::DOWN)):.connect(self.box, &self:.onThrowRagdoll);
        self.input:.keyboard(KeyInfo(SDLK_S, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleShapes);
        self.input:.keyboard(KeyInfo(SDLK_C, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleContacts);
        self.input:.keyboard(KeyInfo(SDLK_B, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleBoxes);
        self.input:.keyboard(KeyInfo(SDLK_T, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleTree);
        self.input:.keyboard(KeyInfo(SDLK_J, KeyEvent::DOWN)):.connect(self.box, &self:.onToggleJoints);
        self.input:.mouse(MouseInfo(SDL_BUTTON_RIGHT, KeyEvent::DOWN)):.connect(self.box, &self:.onTurnStart);
        self.input:.mouse(MouseInfo(SDL_BUTTON_RIGHT, KeyEvent::RELEASE)):.connect(self.box, &self:.onTurnEnd);
        self.input:.mouseMotion():.connect(self.box, &self:.onMouseMove);
        self.input:.mouseWheel():.connect(self.box, &self:.onWheel);

        {
            self.gui:.loadStyleFile("res:/config/crates.style");
            self.gui:.loadGUIFile("res:/config/crates.gui");
        } catch {
            err => {
                log::error #("Crates", "Failed to load the interface", err);
                return;
            }
        }

        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("scene") {
            self._scene = w:.getScene();
        }

        {
            if let Ok(dmut s: &Scene) = alias self._scene {
                s.background = makeVec3(0.25f, 0.55f, 1.0f);
                s.ambient = makeVec3(0.35f, 0.4f, 0.5f);
                s.ambientOcclusion = true;
                s.physicsDebug = __DEBUG__[0];
                self:.createLight(alias s);
                self:.createGround(alias s);
                self:.createStack(alias s);
                self:.createSlope(alias s);
                self:.createBalls(alias s);
                self:.createChain(alias s);
                self:.createDoor(alias s);
                self:.createRagdoll(alias s);
                self:.createTeapots(alias s);
                self:.createCamera(alias s);
            }
        } catch {
            err => {
                log::error #("Crates", "Failed to build the scene", err);
            }
        }
    }

    over onUpdate(mut self, _: Duration) {
        self:.followCentre();
    }

    pub fn onQuit(mut self) {
        self.app:.close(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          INPUTS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Throw a ball from the camera along the way it looks
     * */
    pub fn onThrow(mut self, _: KeyInfo) {
        if let Ok(dmut s) = alias self._scene {
            if let Ok(cam) = self._cam {
                let look = (cam.target - cam.position).normalized();
                self._thrown += 1u32;

                self.window:.lockFrame();
                {
                    let dmut ball = self:.createBall(alias s, f"thrown-${self._thrown}", cam.position + look, 0.3f);
                    ball:.applyImpulse(look * THROW);
                } catch {
                    err => {
                        log::error #("Crates", "Failed to throw a ball", err);
                    }
                }

                self.window:.unlockFrame();
            }
        }
    }

    pub fn onThrowRagdoll(mut self, _: KeyInfo) {
        if let Ok(dmut s) = alias self._scene {
            if let Ok(cam) = self._cam {
                let look = (cam.target - cam.position).normalized();
                self._thrown += 1u32;

                self.window:.lockFrame();
                {
                    let dmut ball = self:.createRagdoll(alias s, at-> cam.position + look);
                    ball:.applyImpulse(look * THROW);
                } catch {
                    err => {
                        log::error #("Crates", "Failed to throw a ragdoll", err);
                    }
                }

                self.window:.unlockFrame();
            }
        }
    }

    pub fn onToggleShapes(mut self, _: KeyInfo) {
        self:.toggleDebug(PhysicsDebug::SHAPES);
    }

    pub fn onToggleContacts(mut self, _: KeyInfo) {
        self:.toggleDebug(PhysicsDebug::CONTACTS);
    }

    pub fn onToggleBoxes(mut self, _: KeyInfo) {
        self:.toggleDebug(PhysicsDebug::BOXES);
    }

    pub fn onToggleTree(mut self, _: KeyInfo) {
        self:.toggleDebug(PhysicsDebug::BROADPHASE);
    }

    pub fn onToggleJoints(mut self, _: KeyInfo) {
        self:.toggleDebug(PhysicsDebug::JOINTS);
    }

    pub fn onTurnStart(mut self, x: i32, y: i32, _: MouseInfo) {
        self._turning = true;
        self._turnStart = (x, y);
    }

    pub fn onTurnEnd(mut self, _: i32, _: i32, _: MouseInfo) {
        self._turning = false;
    }

    pub fn onMouseMove(mut self, x: i32, y: i32, _: f32, _: f32) {
        if !self._turning { return; }

        self._yaw = (self._yaw + cast!f32(x - self._turnStart._0) * 0.2f) % 360.0f;
        self._pitch = std::algorithm::comparison::clamp(self._pitch + cast!f32(self._turnStart._1 - y) * 0.2f, -80.0f, 10.0f);
        self._turnStart = (x, y);
    }

    pub fn onWheel(mut self, _: i32, _: i32, _: i32, w: i32) {
        self._distance = std::algorithm::comparison::clamp(self._distance - cast!f32(w), 3.0f, 60.0f);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SCENE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The ground, a static plane drawn as a wide grey square
     * */
    fn createGround(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let mut grey = MaterialConfig();
        grey.baseColor = makeVec3(0.6f, 0.62f, 0.6f);
        grey.roughness = 0.9f;

        let dmut ground = copy PhysicsBody3D("ground", alias scene:.getRootNode(), shape-> ColliderShape::plane());
        let (array, indices) = planeMesh();
        let dmut floor = copy IndexedMesh3D("floor", alias ground, LodChain(indices), array, copy ConstantMaterial(grey));
        floor.scale = makeVec3(60.0f, 1.0f, 60.0f);
    }

    /**
     * The stack of CRATES crates, each one on the one under it
     * */
    fn createStack(mut self, dmut scene: &Scene)
        throws BalderError
    {
        for i in 0 .. CRATES {
            let at = makeVec3(0.0f, CRATE * (0.5f + cast!f32(i)), 0.0f);
            self:.createBox(alias scene, f"crate-${i}", at, vec3(), 0.5f);
        }
    }

    /**
     * The slope, a static board turned by SLOPE about Z, and two boxes put on it, the one of a friction above the tangent
     * of the slope sticking, the other sliding down
     * */
    fn createSlope(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let turn = Quaternion::fromAxisAngle(SLOPE, makeVec3(0.0f, 0.0f, 1.0f));
        let size = makeVec3(8.0f, 0.2f, 4.0f);
        let at = makeVec3(-8.0f, 1.5f, 0.0f);

        let dmut board = copy PhysicsBody3D("slope", alias scene:.getRootNode(), shape-> ColliderShape::box(size),
                                            settings-> BodySettings(friction-> BOARD));
        board:.setTransform(at, turn, makeVec3(1.0f, 1.0f, 1.0f));

        let mut grey = MaterialConfig();
        grey.baseColor = makeVec3(0.35f, 0.4f, 0.45f);
        grey.roughness = 0.7f;
        let (array, indices) = cubeMesh();
        let dmut mesh = copy IndexedMesh3D("board", alias board, LodChain(indices), array, copy ConstantMaterial(grey));
        mesh.position = makeVec3(0.0f, -size.y / 2.0f, 0.0f);
        mesh.scale = size;

        // the boxes on the board, side by side across it, a little above it
        let up = turn * makeVec3(0.0f, 1.0f, 0.0f);
        for sticks in [true, false] {
            let z = if sticks { -1.0f } else { 1.0f };
            let place = at + up * (size.y / 2.0f + CRATE / 2.0f + 0.01f) + turn * makeVec3(2.0f, 0.0f, z);
            let dmut box = self:.createBox(alias scene, if sticks { "sticking" } else { "sliding" }, place, vec3(),
                                           if sticks { STICKING } else { SLIDING });
            box:.setTransform(place, turn, makeVec3(1.0f, 1.0f, 1.0f));
        }
    }

    /**
     * A few balls dropped from various heights, bouncing on the ground
     * */
    fn createBalls(mut self, dmut scene: &Scene)
        throws BalderError
    {
        for i in 0 .. 4 {
            let at = makeVec3(5.0f + cast!f32(i) * 1.2f, 2.0f + cast!f32(i) * 1.5f, -2.0f);
            self:.createBall(alias scene, f"ball-${i}", at, 0.2f * cast!f32(i + 1));
        }
    }

    /**
     * A chain of LINKS boxes held by ball joints, laid out along +x from a static beam, swinging down from there
     * */
    fn createChain(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let beam = makeVec3(6.0f, 7.0f, 4.0f);
        let dmut top = copy PhysicsBody3D("beam", alias scene:.getRootNode(), shape-> ColliderShape::box(makeVec3(0.3f, 0.3f, 0.3f)));
        top.position = beam;
        self:.drawBox(alias top, "beam-mesh", makeVec3(0.3f, 0.3f, 0.3f), self._crate);

        let size = makeVec3(LINK, 0.12f, 0.12f);
        let mut previous: &PhysicsBody3D = top;
        for i in 0 .. LINKS {
            let at = beam + makeVec3(LINK * (0.5f + cast!f32(i)), 0.0f, 0.0f);
            let dmut link = self:.createJointed(alias scene, f"link-${i}", ColliderShape::box(size), at, 1.0f);
            self:.drawBox(alias link, f"link-${i}-mesh", size, self._jointed);

            let dmut j = copy Joint3D(f"link-${i}-joint", alias scene:.getRootNode(), previous, link);
            j.position = beam + makeVec3(LINK * cast!f32(i), 0.0f, 0.0f);
            previous = link;
        }
    }

    /**
     * A door on a hinge about +y at the edge of a static post, closed against its lower limit by a weak motor, the balls
     * thrown pushing it open up to its upper limit
     * */
    fn createDoor(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let hinge = makeVec3(-4.0f, 1.1f, 6.0f);
        let dmut post = copy PhysicsBody3D("post", alias scene:.getRootNode(), shape-> ColliderShape::box(makeVec3(0.2f, 2.2f, 0.2f)));
        post.position = hinge - makeVec3(0.1f, 0.0f, 0.0f);
        self:.drawBox(alias post, "post-mesh", makeVec3(0.2f, 2.2f, 0.2f), self._crate);

        let size = makeVec3(1.4f, 2.0f, 0.1f);
        let dmut door = self:.createJointed(alias scene, "door", ColliderShape::box(size), hinge + makeVec3(0.72f, 0.0f, 0.0f), 15.0f);
        self:.drawBox(alias door, "door-mesh", size, self._jointed);

        let settings = JointSettings(kind-> JointKind::HINGE, limited-> true, lower-> 0.0f, upper-> 1.6f,
                                     motor-> true, motorSpeed-> DOOR_CLOSING, maxMotorForce-> DOOR_CLOSER);
        let dmut j = copy Joint3D("door-hinge", alias scene:.getRootNode(), post, door, settings-> settings);
        j:.setTransform(hinge, Quaternion::fromAxisAngle(1.5707963f, makeVec3(0.0f, 0.0f, 1.0f)), makeVec3(1.0f, 1.0f, 1.0f));
    }

    /**
     * Stairs of six steps, and a ragdoll of capsules over the top one, its shoulders and its hips balls, its elbows and
     * its knees limited hinges, pushed off to tumble down
     * */
    fn createRagdoll(mut self, dmut scene: &Scene, at: vec3 = makeVec3(-6.0f, 0.0f, -4.0f))-> dmut &PhysicsBody3D
        throws BalderError
    {
        let foot = at;

        let base = foot + makeVec3(0.0f, 4.0f, -3.0f);
        let dmut torso = self:.createLimb(alias scene, "torso", base, 0.15f, 0.7f, 10.0f);
        let dmut head = self:.createJointed(alias scene, "head", ColliderShape::sphere(0.12f), base + makeVec3(0.0f, 0.5f, 0.0f), 3.0f);
        self:.drawSphere(alias head, "head-mesh", 0.12f);
        self:.join(alias scene, "neck", torso, head, base + makeVec3(0.0f, 0.38f, 0.0f), JointSettings());

        let elbow = JointSettings(kind-> JointKind::HINGE, limited-> true, lower-> 0.0f, upper-> 2.5f);
        let knee = JointSettings(kind-> JointKind::HINGE, limited-> true, lower-> -2.5f, upper-> 0.0f);
        for side in [-1.0f, 1.0f] {
            let name = if side < 0.0f { "left" } else { "right" };
            let shoulder = base + makeVec3(side * 0.22f, 0.28f, 0.0f);
            let arm = self:.createLimb(alias scene, name ~ "-arm", shoulder - makeVec3(0.0f, 0.15f, 0.0f), 0.05f, 0.3f, 2.0f);
            let forearm = self:.createLimb(alias scene, name ~ "-forearm", shoulder - makeVec3(0.0f, 0.45f, 0.0f), 0.05f, 0.3f, 1.5f);
            self:.join(alias scene, name ~ "-shoulder", torso, arm, shoulder, JointSettings());
            self:.join(alias scene, name ~ "-elbow", arm, forearm, shoulder - makeVec3(0.0f, 0.3f, 0.0f), elbow);

            let hip = base + makeVec3(side * 0.1f, -0.38f, 0.0f);
            let thigh = self:.createLimb(alias scene, name ~ "-thigh", hip - makeVec3(0.0f, 0.225f, 0.0f), 0.07f, 0.45f, 4.0f);
            let shin = self:.createLimb(alias scene, name ~ "-shin", hip - makeVec3(0.0f, 0.675f, 0.0f), 0.06f, 0.45f, 3.0f);
            self:.join(alias scene, name ~ "-hip", torso, thigh, hip, JointSettings());
            self:.join(alias scene, name ~ "-knee", thigh, shin, hip - makeVec3(0.0f, 0.45f, 0.0f), knee);
        }

        torso:.setVelocity(makeVec3(0.3f, 0.0f, -2.0f), angular-> makeVec3(-1.0f, 0.0f, 0.0f));
        alias torso
    }

    /**
     * @returns: a dynamic capsule of the ragdoll along y, drawn as a stretched sphere
     * */
    fn createLimb(mut self, dmut scene: &Scene, name: [c8], at: vec3, radius: f32, height: f32, mass: f32)-> dmut &PhysicsBody3D
        throws BalderError
    {
        let dmut limb = self:.createJointed(alias scene, name, ColliderShape::capsule(radius, height), at, mass);
        let (array, indices) = sphereMesh();
        let dmut mesh = copy IndexedMesh3D(name ~ "-mesh", alias limb, LodChain(indices), array,
                                           copy ConstantMaterial(self._jointed));
        mesh.position = makeVec3(0.0f, -height / 2.0f, 0.0f);
        mesh.scale = makeVec3(2.0f * radius, height, 2.0f * radius);

        alias limb
    }

    /**
     * @returns: a dynamic body of a shape and a mass at a point of the world, drawing nothing
     * */
    fn createJointed(mut self, dmut scene: &Scene, name: [c8], shape: ColliderShape, at: vec3, mass: f32)-> dmut &PhysicsBody3D {
        let dmut body = copy PhysicsBody3D(name, alias scene:.getRootNode(), shape-> shape,
                                           settings-> BodySettings(motion-> BodyMotion::DYNAMIC, mass-> mass));
        body.position = at;
        alias body
    }

    /**
     * Join two bodies at an anchor of the world, the axis of a hinge along +x
     * */
    fn join(mut self, dmut scene: &Scene, name: [c8], a: &PhysicsBody3D, b: &PhysicsBody3D, anchor: vec3,
            settings: JointSettings) {
        let dmut j = copy Joint3D(name, alias scene:.getRootNode(), a, b, settings-> settings);
        j.position = anchor;
    }

    /**
     * TEAPOTS teapots dropped on each other, each a dynamic body of the hulls the model of the teapot was decomposed into
     * (res/models/teapot/teapot.hulls, see the decompose tool), drawing a copy of the model
     * */
    fn createTeapots(mut self, dmut scene: &Scene)
        throws BalderError
    {
        let dmut first = self:.createTeapot(alias scene, 0);
        let dmut model = copy SolidObjectModel::fromFile("teapot-0-model", alias first, TEAPOT);
        let shape = model.decomposition().shape();
        first.shape = shape;

        // the meshes of the first teapot shared by the others
        for i in 1 .. TEAPOTS {
            let dmut body = self:.createTeapot(alias scene, i);
            copy SolidObjectModel::copyOf(f"teapot-${i}-model", alias body, alias model);
            body.shape = shape;
        }
    }

    /**
     * @returns: the dynamic body of the i-th teapot, higher and turned more than the one before, its shape not set
     * */
    fn createTeapot(mut self, dmut scene: &Scene, i: i32)-> dmut &PhysicsBody3D {
        let at = makeVec3(-3.0f + 0.3f * cast!f32(i), 1.0f + 2.0f * cast!f32(i), 6.0f);
        let turn = makeVec3(0.5f * cast!f32(i), 1.3f * cast!f32(i), 0.2f);
        let dmut body = copy PhysicsBody3D(f"teapot-${i}", alias scene:.getRootNode(),
                                           settings-> BodySettings(motion-> BodyMotion::DYNAMIC, mass-> TEAPOT_MASS,
                                                                   friction-> 0.5f));
        body:.setTransform(at, turn, makeVec3(TEAPOT_SIZE, TEAPOT_SIZE, TEAPOT_SIZE));
        alias body
    }

    /**
     * Draw a body as a box of a size centred on it
     * */
    fn drawBox(mut self, dmut body: &PhysicsBody3D, name: [c8], size: vec3, material: MaterialConfig)
        throws BalderError
    {
        let (array, indices) = cubeMesh();
        let dmut mesh = copy IndexedMesh3D(name, alias body, LodChain(indices), array, copy ConstantMaterial(material));
        mesh.position = makeVec3(0.0f, -size.y / 2.0f, 0.0f);
        mesh.scale = size;
    }

    /**
     * Draw a body as a sphere of a radius centred on it
     * */
    fn drawSphere(mut self, dmut body: &PhysicsBody3D, name: [c8], radius: f32)
        throws BalderError
    {
        let (array, indices) = sphereMesh();
        let dmut mesh = copy IndexedMesh3D(name, alias body, LodChain(indices), array, copy ConstantMaterial(self._jointed));
        mesh.position = makeVec3(0.0f, -radius, 0.0f);
        mesh.scale = makeVec3(2.0f * radius, 2.0f * radius, 2.0f * radius);
    }

    /**
     * @returns: a dynamic box of side CRATE, drawn as a cube of the colour of the crates
     * */
    fn createBox(mut self, dmut scene: &Scene, name: [c8], at: vec3, rotation: vec3, friction: f32)-> dmut &PhysicsBody3D
        throws BalderError
    {
        let settings = BodySettings(motion-> BodyMotion::DYNAMIC, mass-> 10.0f, friction-> friction);
        let dmut box = copy PhysicsBody3D(name, alias scene:.getRootNode(),
                                          shape-> ColliderShape::box(makeVec3(CRATE, CRATE, CRATE)),
                                          settings-> settings);
        box:.setTransform(at, rotation, makeVec3(1.0f, 1.0f, 1.0f));

        let (array, indices) = cubeMesh();
        let dmut mesh = copy IndexedMesh3D(name ~ "-mesh", alias box, LodChain(indices), array,
                                           copy ConstantMaterial(self._crate));
        mesh.position = makeVec3(0.0f, -CRATE / 2.0f, 0.0f);
        mesh.scale = makeVec3(CRATE, CRATE, CRATE);

        alias box
    }

    /**
     * @returns: a dynamic ball of radius BALL bouncing by a restitution, drawn as a red sphere
     * */
    fn createBall(mut self, dmut scene: &Scene, name: [c8], at: vec3, restitution: f32)-> dmut &PhysicsBody3D
        throws BalderError
    {
        let settings = BodySettings(motion-> BodyMotion::DYNAMIC, mass-> BALL_MASS, restitution-> restitution);
        let dmut ball = copy PhysicsBody3D(name, alias scene:.getRootNode(), shape-> ColliderShape::sphere(BALL),
                                           settings-> settings);
        ball.position = at;

        let (array, indices) = sphereMesh();
        let dmut mesh = copy IndexedMesh3D(name ~ "-mesh", alias ball, LodChain(indices), array,
                                           copy ConstantMaterial(self._ball));
        mesh.position = makeVec3(0.0f, -BALL, 0.0f);
        mesh.scale = makeVec3(2.0f * BALL, 2.0f * BALL, 2.0f * BALL);

        alias ball
    }

    /**
     * A sun casting shadows
     * */
    fn createLight(mut self, dmut scene: &Scene) {
        let dmut sun = copy Light("sun", scene:.getRootNode(), castShadow-> true);
        sun.direction = makeVec3(-0.4f, -1.0f, -0.6f);
        sun.intensity = 2.5f;
        sun.color = makeVec3(1.0f, 0.95f, 0.85f);
    }

    fn createCamera(mut self, dmut scene: &Scene) {
        let dmut cam = copy PerspectiveCamera("cam", scene:.getRootNode());
        cam.fov = 60.0f;
        cam.far = 200.0f;
        self._cam = (alias cam)?;
        self:.followCentre();
    }

    /**
     * Draw a category of the debug view of the physics, or stop drawing it
     * */
    fn toggleDebug(mut self, category: u32) {
        if let Ok(dmut s) = alias self._scene {
            s.physicsDebug = s.physicsDebug ^ category;
        }
    }

    /**
     * Place the camera about the centre, along the yaw and the pitch
     * */
    fn followCentre(mut self) {
        if let Ok(dmut cam) = alias self._cam {
            let pitch = math::utils::radian(self._pitch);
            let yaw = math::utils::radian(self._yaw);
            let look = makeVec3(-cos(pitch) * sin(yaw), sin(pitch), -cos(pitch) * cos(yaw));
            let position = CENTRE - look * self._distance;
            if position != cam.position {
                cam.position = position;
                cam.target = CENTRE;
            }
        }
    }

}
