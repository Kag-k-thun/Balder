in main;

mod ::pack;
mod ::activity;

use main::activity;
use balder::core::{_, application::_};
use balder::utils::path;

use std::{config, config::args, io};
use std::fs;

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' paths are resolved against, '--packs'
 * naming the Mixamo packs of the character
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ (the current directory by default)")
        :.option!{[c8]} ("packs", comments-> "the directories of the Mixamo packs of the character, separated by commas, Tab going from one to the next: X Bot.fbx and its clips, idle, walking, running, strafes, turns and jumps (local_res/models/Locomotion Pack,local_res/models/Female Locomotion Pack by default)");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
        }

        if let Ok(Str(value-> packs)) = cfg["packs"]? {
            let mut dirs: [[c8]] = [];
            let mut start = 0us;
            for i in 0us .. packs.len + 1us {
                if i == packs.len || packs[i] == ',' {
                    dirs ~= [packs[start .. i]];
                    start = i + 1us;
                }
            }

            __PACKS__[0] = dirs;
        }

        true
    } catch {
        err: &std::config::args::CommandLineError => {
            eprintln(parser.explain(err, usage-> "walk"));
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig("res:/config/walk.toml");
        let dmut app = copy Application();
        app:.open!{&WalkActivity} (cfg);

        app:.run();
    } catch {
        bd => {
            eprintln(bd);
        }
    }
}
