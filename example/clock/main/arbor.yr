in arbor;

use main::{gear, mesh_builder};

use balder::core::error;
use balder::math::vector;
use balder::scene::physics;

/**
 * The radius of the arbors, in metres
 * */
pub def AXLE = 0.008f;

/**
 * An arbor of the clock: the gears it carries, turning as one about its axis, the Z axis through its centre
 * */
pub record Arbor {

    // The name of its body
    pub let name: [c8];

    // Its centre in the plane of the clock
    pub let centre: vec2;

    // Its gears, from the back of the clock to its front
    pub let gears: [Gear];

    // Its mass, in kilograms
    pub let mass: f32;

    // The depths the axle runs between
    pub let back: f32;
    pub let front: f32;

    // The collision layers of the planes of its gears, the arbors meshing with it sharing one (see movement::layerOf)
    pub let mut layer: u32 = 1u32;

    pub self (name: [c8], centre: vec2, gears: [Gear], mass: f32, back: f32, front: f32)
        with name = name
        , centre = centre
        , gears = gears
        , mass = mass
        , back = back
        , front = front
    {}

    /**
     * @returns: the shape of the arbor in the space of its body, the teeth of its gears
     * */
    pub fn shape(self)-> ColliderShape
        throws BalderError
    {
        let mut parts: [CompoundPart] = [];
        for g in self.gears {
            parts = parts ~ g.parts();
        }

        ColliderShape::compound(copy CompoundShape(parts))
    }

    /**
     * Draw the gears of the arbor
     * */
    pub fn drawGears(self, dmut mesh: &MeshBuilder) {
        for g in self.gears {
            g.draw(alias mesh, AXLE);
        }
    }

    /**
     * Draw the axle of the arbor, its pivots at both ends
     * */
    pub fn drawAxle(self, dmut mesh: &MeshBuilder) {
        mesh:.cylinder(vec2(), AXLE, self.back, self.front, segments-> 16u32);
    }
}
