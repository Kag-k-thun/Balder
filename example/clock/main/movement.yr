/**
 * The movement of the clock, the centre wheel on the origin of the plane of the clock, its front towards -Z:
 * ```
 * centre (minute hand, 1 turn an hour)  64 teeth ─┐
 *                                                 third pinion, 8 pins
 * third (1 turn in 7.5 minutes)         60 teeth ─┐
 *                                                 escape pinion, 8 pins
 * escape (seconds hand, 1 turn a minute) 30 teeth ─ anchor ─ pendulum (a beat a second)
 *
 * cannon pinion on the centre arbor     10 teeth ─ minute wheel, 30 teeth
 * minute pinion                          8 teeth ─ hour wheel (hour hand), 32 teeth, about the centre
 * ```
 * the escape wheel at the bottom, the anchor under it, the pendulum hanging from the arbor of the anchor
 * @info: the masses of the arbors grow with the square of the ratio of each mesh, so that the two bodies of a mesh push
 * each other as bodies of a like mass along their teeth
 * */
in movement;

use main::{arbor, gear, pendulum};

use balder::math::vector;

use std::math;

/**
 * The depths of the planes the gears mesh in, from the escape wheel at the back to the hour wheel at the front
 * */
pub def ESCAPE_PLANE = 0.0f;
pub def THIRD_PLANE = -0.08f;
pub def CENTRE_PLANE = -0.16f;
pub def CANNON_PLANE = -0.24f;
pub def HOUR_PLANE = -0.32f;

/**
 * The depth of the rod of the pendulum, behind the wheels, of the dial, and of the plates holding the arbors
 * */
pub def ROD_PLANE = 0.08f;
pub def DIAL_PLANE = -0.4f;
pub def BACK_PLATE = 0.035f;
pub def FRONT_PLATE = -0.37f;

/**
 * The distance between two planes
 * */
def PLANE_STEP = 0.08f;

/**
 * The thickness of a wheel, and of a pinion, the length of its pins
 * */
def WHEEL = 0.016f;
def PINION = 0.03f;

/**
 * The modules of the meshes: centre to third, third to escape, the motion work
 * */
def CENTRE_MODULE = 0.016f;
def THIRD_MODULE = 0.014f;
def MOTION_MODULE = 0.012f;

/**
 * The distance from the pivot of the anchor to the centre of the bob, a beat a second
 * */
def PENDULUM = 1.013f;

/**
 * The radius of the tips of the escape wheel
 * */
pub def ESCAPE_TIPS = 0.2f;

/**
 * The mass of the escape arbor, the others following from it
 * */
def ESCAPE_MASS = 0.2f;

/**
 * The centres of the arbors in the plane of the clock
 * */
pub fn centreOf()-> vec2 {
    vec2()
}

pub fn thirdOf()-> vec2 {
    let d = CENTRE_MODULE * cast!f32(64 + 8) / 2.0f;
    let x = -0.25f;
    makeVec2(x, -math::sqrt(d * d - x * x))
}

pub fn escapeOf()-> vec2 {
    let t = thirdOf();
    let d = THIRD_MODULE * cast!f32(60 + 8) / 2.0f;
    makeVec2(0.0f, t.y - math::sqrt(d * d - t.x * t.x))
}

pub fn minuteWheelOf()-> vec2 {
    polar(0.35f, MOTION_MODULE * cast!f32(10 + 30) / 2.0f)
}

/**
 * @returns: the anchor and the pendulum under the escape wheel
 * */
pub fn pendulum()-> Pendulum {
    let e = escapeOf();
    let pivot = e - makeVec2(0.0f, ESCAPE_TIPS * 1.4142136f);
    let mut p = Pendulum(pivot, e, ESCAPE_TIPS, ESCAPE_PLANE, ROD_PLANE, PENDULUM, 6.0f);
    p.layer = layerOf(copy [ESCAPE_PLANE]);
    p
}

/**
 * @returns: the collision layers of planes, a bit per plane from the escape wheel to the hour wheel, so that only the
 * bodies meshing in a plane are tested against each other; none for a depth off the planes (the rod of the pendulum)
 * */
pub fn layerOf(planes: [f32])-> u32 {
    let mut layer = 0u32;
    for z in planes {
        let index = math::round(-z / PLANE_STEP);
        if index >= 0.0f && index < 31.0f {
            layer = layer | (1u32 << cast!u32(index));
        }
    }

    layer
}

/**
 * @returns: an arbor carrying gears, in the layers of their planes
 * */
fn arborOf(name: [c8], centre: vec2, gears: [Gear], mass: f32, back: f32, front: f32)-> Arbor {
    let mut a = Arbor(name, centre, gears, mass, back, front);
    a.layer = layerOf(copy [g.z for g in gears]);
    a
}

/**
 * @returns: the arbors of the movement, the escape wheel first, then the third, the centre, the minute wheel and the
 * hour wheel
 * */
pub fn arbors()-> [Arbor] {
    let c = centreOf(), t = thirdOf(), e = escapeOf(), m = minuteWheelOf();

    // the escape wheel, a tooth just above the first pallet, its pinion led by the third wheel
    let (first, _) = pendulum().palletAngles();
    let escape = Gear(Toothing::RATCHET, 30u32, 2.0f * ESCAPE_TIPS / 30.0f, ESCAPE_PLANE, WHEEL).pointing(first + 0.03f);
    let escapePinion = Gear(Toothing::LANTERN, 8u32, THIRD_MODULE, THIRD_PLANE, PINION).pointing(angleTo(e, t));

    let third = Gear(Toothing::WHEEL, 60u32, THIRD_MODULE, THIRD_PLANE, WHEEL).facing(angleTo(t, e));
    let thirdPinion = Gear(Toothing::LANTERN, 8u32, CENTRE_MODULE, CENTRE_PLANE, PINION).pointing(angleTo(t, c));

    let centre = Gear(Toothing::WHEEL, 64u32, CENTRE_MODULE, CENTRE_PLANE, WHEEL).facing(angleTo(c, t));
    let cannon = Gear(Toothing::WHEEL, 10u32, MOTION_MODULE, CANNON_PLANE, PINION).facing(angleTo(c, m));

    let minute = Gear(Toothing::WHEEL, 30u32, MOTION_MODULE, CANNON_PLANE, WHEEL).pointing(angleTo(m, c));
    let minutePinion = Gear(Toothing::WHEEL, 8u32, MOTION_MODULE, HOUR_PLANE, PINION).facing(angleTo(m, c));

    let hour = Gear(Toothing::WHEEL, 32u32, MOTION_MODULE, HOUR_PLANE, WHEEL).pointing(angleTo(c, m));

    // each arbor as heavy as the one it leads times the square of the ratio of their mesh
    let thirdMass = ESCAPE_MASS * square(third.radius / escapePinion.radius) * square(escape.radius / third.radius);
    let centreMass = thirdMass * square(centre.radius / thirdPinion.radius) * square(third.radius / centre.radius);

    copy [arborOf("escape", e, copy [escape, escapePinion], ESCAPE_MASS, BACK_PLATE, DIAL_PLANE - 0.05f),
          arborOf("third", t, copy [third, thirdPinion], thirdMass, BACK_PLATE, FRONT_PLATE),
          arborOf("centre", c, copy [centre, cannon], centreMass, BACK_PLATE, DIAL_PLANE - 0.06f),
          arborOf("minute-wheel", m, copy [minute, minutePinion], 1.5f, CENTRE_PLANE + 0.03f, FRONT_PLATE),
          arborOf("hour", c, copy [hour], 1.5f, HOUR_PLANE, DIAL_PLANE - 0.03f)]
}

/**
 * @returns: the angle of the direction from a point to another
 * */
fn angleTo(from: vec2, to: vec2)-> f32 {
    math::atan2(to.y - from.y, to.x - from.x)
}

fn square(x: f32)-> f32 {
    x * x
}
