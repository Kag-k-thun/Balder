in main;

mod ::activity;
mod ::arbor;
mod ::gear;
mod ::mesh_builder;
mod ::movement;
mod ::pendulum;

use main::activity;
use balder::core::{_, application::_};
use balder::scene::physics;
use balder::utils::path;

use std::{config, config::args, fs, io};

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' paths are resolved against
 * @returns: false iif the application must not start
 * */
fn readArguments(args: [[c8]])-> bool {
    let parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ (the current directory by default)")
        :.flag("debug", comments-> "draw the colliders, the contacts and the joints from the start, 'S', 'C' and 'J' toggling them");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
            setEnginePath(Path(dir));
        }

        if cfg["debug"].to!{bool} () ?? false {
            __DEBUG__[0] = PhysicsDebug::SHAPES | PhysicsDebug::CONTACTS | PhysicsDebug::JOINTS;
        }

        true
    } catch {
        err: &std::config::args::CommandLineError => {
            eprintln(parser.explain(err, usage-> "clock"));
            false
        }
    }
}

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig("res:/config/clock.toml");
        let dmut app = copy Application();
        app:.open!{&ClockActivity} (cfg);

        app:.run();
    } catch {
        bd => {
            eprintln(bd);
        }
    }
}
