// The editor of {{name}}: the editor of Balder, the actor classes of the game registered in it as the library of the
// game is linked in; run from the directory of the project (the project manager of Balder builds it and runs it)
in main;

use balder_editor;

fn main(args: [[c8]]) {
    runEditor(args, ".", ".deps/Balder");
}
