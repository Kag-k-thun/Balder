// The main scene of a new project: a ground lit by the sun, a cube and a sphere on it (see SceneDescription for the
// format); the scene of a new project takes ids of its own
scene 2;

asset cube mesh "engine:/meshes/cube";
asset plane mesh "engine:/meshes/plane";
asset sphere mesh "engine:/meshes/sphere";

material #faed433f-2cb0-416d-9e17-06743ed07446 "ground" {
    base-color: 0.55 0.55 0.55;
    roughness: 0.9;
}

material #0f51190b-d06f-4fff-b61a-0e3d18e3c282 "cube" {
    base-color: 0.8 0.3 0.2;
    roughness: 0.5;
}

material #ee515d03-3440-4d3b-8fcb-a606610e7ba6 "sphere" {
    base-color: 0.2 0.4 0.8;
    roughness: 0.2;
    metallic: 1;
}

node #87b7e0df-348c-4ee2-b5e4-a54c540e02bf light "sun" {
    position: 0 6 0;
    direction: -0.3 -1 -0.2;
}

node #30c4fd6c-045e-4f5b-925c-bb8d17b6c935 mesh "ground" {
    scale: 20 1 20;
    mesh: @plane;
    materials: #faed433f-2cb0-416d-9e17-06743ed07446;
}

node #030e69b7-ba92-4e55-bd67-5381a2351926 empty "props" {
}

node #75e8622f-285e-414a-8e93-d82ecee1a614 mesh "cube" {
    parent: #030e69b7-ba92-4e55-bd67-5381a2351926;
    position: -1.2 0 0;
    rotation: 0 30 0;
    mesh: @cube;
    materials: #0f51190b-d06f-4fff-b61a-0e3d18e3c282;
}

node #0c203f1a-b872-4e76-b3e0-0c7c95e00c74 mesh "sphere" {
    parent: #030e69b7-ba92-4e55-bd67-5381a2351926;
    position: 1.2 0 0;
    mesh: @sphere;
    materials: #ee515d03-3440-4d3b-8fcb-a606610e7ba6;
}
