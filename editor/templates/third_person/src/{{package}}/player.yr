in player;

use balder::core::application::input::action_state;
use balder::math::vector;
use balder::scene::actors::tags;
use balder::scene::node;
use balder::scene::node::node3D::character;

use std::{math, time};

/**
 * The player of {{name}}: a character walking on the ground, pushed back by the crates, pushing those that move, its
 * camera following it from behind as a node under it
 * @info:
 * =====
 * The player reads the input actions of the project (project.toml [actions], Project > Settings… > Input in the
 * editor): forward and back walk, turn-left and turn-right turn it, run runs and jump jumps; the keys W, A, S, D, Shift
 * and Space by default (by their place on the keyboard: Z, Q, S, D on an AZERTY one), and the left stick, the right
 * trigger and the south button of a gamepad. The player moves once a tick while the game is played, its velocity kept
 * from tick to tick, gravity pulling it down (see CharacterBody3D::moveAndSlide); the editor does not tick it while the
 * scene is edited.
 * ====
 * */
#[actor ("player", category-> "Gameplay")]
pub class Player over CharacterBody3D {

    #[export (label-> "Walking speed", min-> 0.0f, max-> 20.0f, step-> 0.1f, decimals-> 1u32)]
    pub let mut walkSpeed: f32 = 2.5f;

    #[export (label-> "Running speed", min-> 0.0f, max-> 40.0f, step-> 0.1f, decimals-> 1u32)]
    pub let mut runSpeed: f32 = 6.0f;

    // in radians a second, in degrees a second in the scene files and the inspector
    #[export (label-> "Turning speed", degrees-> true, min-> 0.0f, max-> 1000.0f, step-> 5.0f, decimals-> 0u32)]
    pub let mut turnSpeed: f32 = 2.5f;

    #[export (label-> "Jump speed", min-> 0.0f, max-> 50.0f, step-> 0.1f, decimals-> 1u32)]
    pub let mut jumpSpeed: f32 = 5.0f;

    #[export (min-> 0.0f, max-> 100.0f, step-> 0.1f, decimals-> 2u32)]
    pub let mut gravity: f32 = 9.81f;

    // The velocity of the player, in metres a second, kept from tick to tick
    let mut _velocity: vec3 = vec3();

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {
        self.ticked = true;
    }

    /**
     * Turn the player by the actions held, then move it along the way it faces, gravity pulling it down, a jump setting
     * its speed up while it can jump
     * */
    pub over onTick(mut self, delta: Duration) {
        let seconds = cast!f32(delta.allMicros) / 1_000_000.0f;
        let mut turn = 0.0f;
        let mut front = 0.0f;
        let mut running = false;
        let mut jump = false;
        if let Ok(dmut a) = alias self:.actions() {
            turn = a:.axis("turn-left", "turn-right");
            front = a:.axis("back", "forward");
            running = a:.held("run");
            jump = a:.pressed("jump");
        }

        if turn != 0.0f {
            let r = self.rotation;
            self.rotation = makeVec3(r.x, r.y + turn * self.turnSpeed * seconds, r.z);
        }

        let speed = front * (if running { self.runSpeed } else { self.walkSpeed });
        let yaw = self.rotation.y;
        let forward = makeVec3(-sin(yaw), 0.0f, -cos(yaw));

        let mut up = self._velocity.y - self.gravity * seconds;
        if jump && self.canJump {
            up = self.jumpSpeed;
            self:.jumped();
        }

        let wanted = makeVec3(forward.x * speed, up, forward.z * speed);
        self._velocity = self:.moveAndSlide(wanted, delta);
    }

}
