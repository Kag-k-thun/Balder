// The main scene of a third person project: a ground lit by the sun, a stair of crates the player jumps up to a
// platform, a ramp walking down from it, a tall crate climbed from a small one, a crate pushed around, and the player
// (the actor class Player of the library of the game), its camera following it from behind; the scene of a new
// project takes ids of its own
scene 2;

asset cube mesh "engine:/meshes/cube";
asset plane mesh "engine:/meshes/plane";
asset sphere mesh "engine:/meshes/sphere";

material #fbf13760-4659-45b9-a4f6-c62800525481 "ground" {
    base-color: 0.45 0.5 0.45;
    roughness: 0.95;
}

material #0f65b9f5-9847-4868-a905-2c2220040632 "crate" {
    base-color: 0.65 0.45 0.25;
    roughness: 0.8;
}

material #0893b81e-79ec-4a5a-bb2b-b8fac82193c1 "player" {
    base-color: 0.2 0.45 0.85;
    roughness: 0.4;
}

material #8564570e-719f-4c21-a43c-92c7bfef9af8 "nose" {
    base-color: 0.95 0.8 0.2;
    roughness: 0.5;
}

node #9002ad39-2260-4675-8d62-fe8e67471ae8 light "sun" {
    position: 0 8 0;
    direction: -0.4 -1 -0.3;
}

