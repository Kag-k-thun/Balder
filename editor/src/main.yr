in main;

mod ::activity;
mod ::command;
mod ::editor;
mod ::inspector_panel;
mod ::lighting;
mod ::naming;
mod ::orbit;
mod ::outline;
mod ::outline_panel;
mod ::project;
mod ::viewport;

use main::{activity, project};
use balder::core::{_, application::_};
use balder::utils::log;

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    {
        let cfg      = copy BalderConfig(editorFile("editor.toml"));
        let dmut app = copy Application();
        app:.open!{&EditorActivity} (cfg);

        app:.run();
    } catch {
        err => {
            log::error #("Editor", "Failed to open the editor", err);
        }
    }
}
