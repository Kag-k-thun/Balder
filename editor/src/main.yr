in main;

mod ::activity;
mod ::arguments;
mod ::command;
mod ::editor;
mod ::framing;
mod ::ground_grid;
mod ::hulls_panel;
mod ::inspector_panel;
mod ::lighting;
mod ::manager;
mod ::naming;
mod ::orbit;
mod ::outline;
mod ::outline_panel;
mod ::project;
mod ::viewport;

use main::{activity, arguments, manager, project};
use balder::core::{_, application::_};
use balder::utils::{log, path};

use std::fs;
use std::io;

fn main(args: [[c8]]) {
    if !readArguments(args) { return; }

    let project = startProject();
    if project.len != 0us && !Project::isProject(project) {
        eprintln(f"balder-editor: no project in ${project}, its ${Project::FILE} is missing");
        return;
    }

    {
        let dmut app = copy Application();
        if project.len == 0us {
            app:.open!{&ProjectManagerActivity} (copy BalderConfig(editorFile("manager.toml")));
        } else {
            setProjectPath(Path(project));
            app:.open!{&EditorActivity} (copy BalderConfig(editorFile("editor.toml")));
        }

        app:.run();
    } catch {
        err => {
            log::error #("Editor", "Failed to open the editor", err);
        }
    }
}
