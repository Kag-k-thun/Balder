in ground_grid;

use balder::math::vector;
use balder::scene::debug;

use std::algorithm::comparison;
use std::math;

// The cells of the grid on each side of its centre, along each axis
def HALF_CELLS = 40;

// The pieces each line is cut in, its opacity fading away from the centre piece by piece
def PIECES = 16;

// The lines of the grid, encoded in sRGB, and their opacity at the centre: every step, every ten steps
def MINOR_COLOR = makeVec4(0.62f, 0.62f, 0.62f, 0.22f);
def MAJOR_COLOR = makeVec4(0.70f, 0.70f, 0.70f, 0.45f);

// The lines of the axes of the world, X red and Z blue, as the gizmo draws them
def X_AXIS_COLOR = makeVec4(0.90f, 0.32f, 0.32f, 0.85f);
def Z_AXIS_COLOR = makeVec4(0.32f, 0.52f, 0.95f, 0.85f);

/**
 * The grid of the ground of the viewport of the editor, in metres (a unit of the world being a metre): lines on the
 * plane y = 0 every step, every tenth line stronger, the X and the Z axes of the world in red and in blue
 * @info:
 * =====
 * The step follows the height of the eye over the ground, a power of ten (0.1 m, 1 m, 10 m, 100 m...) so that a cell
 * stays about as large on the image (see GroundGrid::stepFor); the grid is centred under the eye, on a line every ten
 * steps so that it does not slide while the eye moves within a cell, and fades away from its centre. The scene hides
 * it (DebugDepth::HIDDEN): it is drawn on the ground where nothing stands over it.
 * ====
 * */
pub record GroundGrid {

    // The distance between two lines, in metres
    pub let step: f32;

    // The centre of the grid, on the ground under the eye
    pub let centre: vec3;

    /**
     * The grid seen from an eye
     * @params:
     *    - eye: the position of the eye, in the world
     * */
    pub self (eye: vec3)
        with step = GroundGrid::stepFor(math::abs(eye.y))
        , centre = GroundGrid::centreUnder(eye, GroundGrid::stepFor(math::abs(eye.y)))
    {}

    /**
     * @returns: true iif the grid draws the same lines as another one
     * */
    pub fn isSame(self, other: GroundGrid)-> bool {
        self.step == other.step && self.centre == other.centre
    }

    /**
     * @returns: the segments of the lines of the grid, each line cut in pieces fading away from the centre
     * */
    pub fn segments(self)-> [DebugSegment] {
        let mut res: [DebugSegment] = [];
        let half = cast!f32(HALF_CELLS) * self.step;
        for i in -HALF_CELLS .. HALF_CELLS + 1 {
            let offset = cast!f32(i) * self.step;
            let major = (i + cast!i32(math::floor(self.centre.x / self.step + 0.5f))) % 10 == 0;
            let x = self.centre.x + offset;
            let z = self.centre.z + offset;

            // the line along Z at x, the Z axis at x = 0; the line along X at z, the X axis at z = 0
            let alongZ = if math::abs(x) < self.step * 0.5f { Z_AXIS_COLOR } else if major { MAJOR_COLOR } else { MINOR_COLOR };
            let majorZ = (i + cast!i32(math::floor(self.centre.z / self.step + 0.5f))) % 10 == 0;
            let alongX = if math::abs(z) < self.step * 0.5f { X_AXIS_COLOR } else if majorZ { MAJOR_COLOR } else { MINOR_COLOR };

            res ~= self.line(makeVec3(x, 0.0f, self.centre.z - half), makeVec3(x, 0.0f, self.centre.z + half), alongZ);
            res ~= self.line(makeVec3(self.centre.x - half, 0.0f, z), makeVec3(self.centre.x + half, 0.0f, z), alongX);
        }

        res
    }

    /**
     * @returns: the pieces of a line of the grid, each as opaque as its middle is near the centre
     * */
    fn line(self, a: vec3, b: vec3, color: vec4)-> [DebugSegment] {
        let mut res: [DebugSegment] = [];
        let half = cast!f32(HALF_CELLS) * self.step;
        for k in 0 .. PIECES {
            let p = a + (b - a) * (cast!f32(k) / cast!f32(PIECES));
            let q = a + (b - a) * (cast!f32(k + 1) / cast!f32(PIECES));
            let far = ((p + q) * 0.5f - self.centre).length() / half;
            let fade = max(0.0f, 1.0f - far * far);
            if fade > 0.0f {
                res ~= [DebugSegment(p, q, makeVec4(color.x, color.y, color.z, color.w * fade), depth-> DebugDepth::HIDDEN)];
            }
        }

        res
    }

}

/**
 * The step and the centre of the grid
 * */
pub mod GroundGrid {

    /**
     * @returns: the step of the grid seen from a height over the ground, in metres: the power of ten under half the height
     * (1 m from 2 m to 20 m), 10 cm at least
     * */
    pub fn stepFor(height: f32)-> f32 {
        let exponent = math::floor(math::log10(max(height, 0.2f) / 2.0f));
        math::pow(10.0f, exponent)
    }

    /**
     * @returns: the centre of a grid of a step seen from an eye: the point of the ground under the eye, on the nearest
     * line every ten steps
     * */
    pub fn centreUnder(eye: vec3, step: f32)-> vec3 {
        let major = step * 10.0f;
        makeVec3(math::floor(eye.x / major + 0.5f) * major, 0.0f, math::floor(eye.z / major + 0.5f) * major)
    }

}
