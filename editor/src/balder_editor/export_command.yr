/**
 * The export of a game from the command line (balder-editor --project <dir> --export <dir>), without opening a window
 * */
in export_command;

use balder_editor::project::game_build;
use balder::core::error;
use balder::game::{export_problem, export_report, game_export, game_library, project};
use balder::utils::path;

use std::{fs, io, time};

/**
 * Export the game of a project: its project installed, the dev build of its library built when it is not up to date
 * and loaded (the classes of its actors checked against it), then the export run (see GameExport), each step printed,
 * then the problems found as `scene: node: message`
 * @params:
 *    - directory: the absolute path of the directory of the project
 *    - output: the absolute path of the directory the folder of the game is written in
 * @returns: true iif the game was exported
 * */
pub fn exportGame(directory: [c8], output: [c8])-> bool {
    {
        setProjectPath(Path(directory));
        let project = copy Project::open(directory);
        project.install();

        let dmut build = copy GameBuild(directory);
        if !build.isUpToDate() {
            println(f"Building the library of ${project.name}");
            build:.build();

            let mut code: (i32)? = none;
            while !code.hasValue {
                sleep(millis(200));
                code = build:.finished();
            }

            if (code ?? 1) != 0 {
                for e in build.errors() { eprintln(e); }
                eprintln(f"balder-editor: the library of ${project.name} does not build, see ${build.log}");
                return false;
            }
        }

        GameLibrary::load(build.library);

        let dmut report = copy ExportReport();
        let dmut export = copy GameExport(project, output, alias report);
        let th = spawn export:.runReported();
        let mut told = "";
        while !report:.isFinished() {
            let text = report:.text();
            if text != told {
                println(text);
                told = text;
            }

            sleep(millis(200));
        }

        th.value;
        GameLibrary::unload();

        for p in report:.problems() {
            eprintln(textOf(p));
        }

        if let Ok(f) = report:.failure() {
            for e in GameBuild::errorsIn(GameExport::logOf(directory)) { eprintln(e); }
            eprintln(f"balder-editor: ${f}");
            return false;
        }

        println(f"Exported ${project.name} to ${report:.result() ?? output}");
        true
    } catch {
        err: &BalderError => {
            eprintln(f"balder-editor: ${err.msg}");
            false
        }
    }
}

/**
 * @returns: a problem of the export on one line, `res:/scenes/main.scene: props/table: missing file …`
 * */
pub fn textOf(p: ExportProblem)-> [c8] {
    let mut res = if p.error { "error: " } else { "warning: " };
    if p.scene.len != 0us { res ~= p.scene ~ ": "; }
    if p.node.len != 0us { res ~= p.node ~ ": "; }
    res ~ p.message
}
