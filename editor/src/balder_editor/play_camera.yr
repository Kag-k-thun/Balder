in play_camera;

use std::uuid;

/**
 * The cameras a scene can be played through in the editor
 * */
pub enum PlayView : u32
| ACTIVE = 0u32 // the active camera of the scene, the game making another one active followed
| CAMERA = 1u32 // a camera of the scene, whichever camera the game makes active
| EDITOR = 2u32; // the camera of the editor, the game watched from the eye of the viewport, its controls moving it

/**
 * The camera a scene is played through in the editor (see PlayBar), chosen by its document: the active camera of the
 * scene, one of its cameras by its id, or the camera of the editor
 * */
@data
pub record PlayCamera {

    // The kind of camera the scene is played through
    pub let mut view: PlayView = PlayView::ACTIVE;

    // The id of the camera of the scene of PlayView::CAMERA (see Node3D.guid), the nodes played keeping the ids of
    // the nodes edited
    pub let mut camera: Uuid = Uuid::nil();

}
