in file_kind;

use std::fs;

/**
 * The kind of a file of a project, which the Files panel shows by its icon and adds to a scene its own way
 * */
pub enum FileKind : u32
| FOLDER   = 0u32
| MODEL    = 1u32 // a model, added as a mesh node of its mesh
| SCENE    = 2u32 // a scene file, its nodes added under an empty
| MATERIAL = 3u32 // a material file, given to a mesh
| TEXTURE  = 4u32 // an image, the base colour map of a material local to the scene given to a mesh
| OTHER    = 5u32;

// The extensions of the scene files and of the material files
def SCENE_EXTENSION = "scene";
def MATERIAL_EXTENSION = "material";

/**
 * The kinds of the files a scene places, their extensions, and their icons
 * */
pub mod FileKinds {

    /**
     * @returns: the kind of a file by its extension, whatever its case
     * @params:
     *    - name: the name of the file
     *    - isDirectory: true for a directory
     * */
    pub fn kindOf(name: [c8], isDirectory: bool)-> FileKind {
        if isDirectory { return FileKind::FOLDER; }

        let ext = lowerCase(Path(name).extension());
        for e in FileKinds::models() if e == ext { return FileKind::MODEL; }
        for e in FileKinds::textures() if e == ext { return FileKind::TEXTURE; }
        if ext == SCENE_EXTENSION { return FileKind::SCENE; }
        if ext == MATERIAL_EXTENSION { return FileKind::MATERIAL; }
        FileKind::OTHER
    }

    /**
     * @returns: the extensions of the models the editor reads
     * */
    pub fn models()-> [[c8]] {
        copy ["gltf", "glb", "obj", "fbx", "dae", "ply", "stl"]
    }

    /**
     * @returns: the extensions of the images a material reads as its maps
     * */
    pub fn textures()-> [[c8]] {
        copy ["png", "jpg", "jpeg", "tga", "bmp"]
    }

    /**
     * @returns: the extensions of the files a scene places: the models, the scenes, the materials and the textures
     * */
    pub fn placeable()-> [[c8]] {
        FileKinds::models() ~ copy [SCENE_EXTENSION, MATERIAL_EXTENSION] ~ FileKinds::textures()
    }

    /**
     * @returns: the name of the icon of a kind, an image of editor/ui/icons/files
     * */
    pub fn iconOf(kind: FileKind)-> [c8] {
        match kind {
            FileKind::FOLDER   => { "folder" }
            FileKind::MODEL    => { "model" }
            FileKind::SCENE    => { "scene" }
            FileKind::MATERIAL => { "material" }
            FileKind::TEXTURE  => { "texture" }
            _                  => { "file" }
        }
    }

    /**
     * @returns: the kind in words, as the status bar tells it
     * */
    pub fn nameOf(kind: FileKind)-> [c8] {
        match kind {
            FileKind::FOLDER   => { "folder" }
            FileKind::MODEL    => { "model" }
            FileKind::SCENE    => { "scene" }
            FileKind::MATERIAL => { "material" }
            FileKind::TEXTURE  => { "texture" }
            _                  => { "file" }
        }
    }
}

/**
 * @returns: a text whose ASCII capitals are lowered
 * */
fn lowerCase(text: [c8])-> [c8] {
    copy [if c >= 'A'c8 && c <= 'Z'c8 { cast!c8(cast!u8(c) + 32u8) } else { c } for c in text]
}
