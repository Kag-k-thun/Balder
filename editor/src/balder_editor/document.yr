in document;

use std::fs;

/**
 * Something opened in the editor in a tab of its own (see the TabBar of the top row): a scene (SceneDocument), or a
 * material (MaterialDocument); a document has a path, a name, the title of its tab, and unsaved changes or not
 * */
@abstract
pub class Document {

    prot {
        // The path of what the document edits, res:/… under the res/ directory of the project, empty for a new document
        let mut _path: [c8] = "";
    }

    prot self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the path of what the document edits, empty for a new document
     * */
    @field
    pub fn path(self)-> [c8] {
        self._path
    }

    /**
     * @returns: the name of the document, in a sentence ('the new scene', 'brick.material')
     * */
    @field
    pub fn name(self)-> [c8];

    /**
     * @returns: the title of the tab of the document
     * */
    @field
    pub fn title(self)-> [c8];

    /**
     * @returns: true iif the document changed since it was opened or saved last
     * */
    @field
    pub fn unsaved(self)-> bool;

    /**
     * @returns: true iif the document is new and was never changed, which a document opened takes the place of
     * */
    @field
    pub fn isBlank(self)-> bool {
        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Give the document its path, where it was opened from or saved in, empty for none
     * */
    @field
    pub fn path(mut self, path: [c8]) {
        self._path = path;
    }

}

/**
 * The names of the documents
 * */
pub mod Document {

    /**
     * @returns: the name of the file of a path without its extension, `level` for `res:/scenes/level.scene`
     * */
    pub fn stem(path: [c8])-> [c8] {
        let file = Path(path).file(), extension = Path(path).extension();
        if extension.len == 0us || extension.len + 1us >= file.len { return file; }
        file[0us .. file.len - extension.len - 1us]
    }

}
