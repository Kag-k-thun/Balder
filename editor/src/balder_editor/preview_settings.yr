in preview_settings;

use balder_editor::orbit;
use balder::scene::node::node3D::camera;

/**
 * The shapes the preview of a material is drawn on
 * */
pub enum PreviewShape : u32
| SPHERE = 0u32
| CUBE   = 1u32
| PLANE  = 2u32
| MESH   = 3u32; // the mesh the material was opened from

/**
 * The lights of the preview of a material
 * */
pub enum PreviewLighting : u32
| STUDIO      = 0u32 // a studio environment and a key light
| SCENE       = 1u32 // the environment of the scene shown in the viewport
| ENVIRONMENT = 2u32; // an HDR map chosen

/**
 * How the preview of a material shows it, kept by its document while another one is shown: the shape it is drawn on,
 * the lights, the background, the channel shown and the eye turning around it
 * */
@data
pub record PreviewSettings {

    // The shape the material is drawn on
    pub let mut shape: PreviewShape = PreviewShape::SPHERE;

    // The mesh the material was opened from, drawn for PreviewShape::MESH, empty for none
    pub let mut mesh: [c8] = "";

    // The lights, and the HDR map of PreviewLighting::ENVIRONMENT
    pub let mut lighting: PreviewLighting = PreviewLighting::STUDIO;
    pub let mut environment: [c8] = "";

    // True when the environment is seen behind the shape, a grey otherwise
    pub let mut background: bool = true;

    // The channel shown, DebugView::NONE for the material lit
    pub let mut channel: DebugView = DebugView::NONE;

    // The eye of the camera, turning around the shape
    pub let mut orbit: OrbitView = OrbitView(distance-> 2.6f, yaw-> 0.6f, pitch-> 0.35f);

}
