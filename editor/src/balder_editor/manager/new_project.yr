in new_project;

use balder_editor::project::project_template;
use balder::core::error;
use balder::core::application::signal;
use balder::interface::dialog;
use balder::interface::loader::registry::behaviors;
use balder::interface::widget::button::dropdown;
use balder::interface::widget::text::{input, label};

use std::{char, fs, stream};

use ::sdl3::mouse;

/**
 * The dialog creating a project from a template, chosen among the templates of the editor in a dropdown (empty, third
 * person, each labelled after its directory), what it holds told under it: its name and the location of its directory, a new folder of the
 * location named after the package of the project (My Game going in my_game, see ProjectTemplate::packageOf), the
 * location chosen by a file dialog over it (Browse…) or typed
 * @info: the dialog creates the project when Create is clicked (not when a field is validated: a field is validated
 * as it loses the focus, Browse… taking it), telling under the fields why it cannot, and emits the absolute path of its
 * directory once it is created, none when it is cancelled
 * */
#[behavior]
pub class NewProjectDialog over Dialog {

    // The location proposed first
    let _location: [c8];

    // The templates a project is created from, the first one chosen first
    let _templates: [&ProjectTemplate];

    // The index of the template chosen among them
    let mut _chosen: usize = 0us;

    // Emitted with the absolute path of the directory of the project created, none when the dialog is cancelled
    let dmut _answered: &Signal!{([c8])?} = copy Signal!{([c8])?} ();

    /**
     * @params:
     *    - guiFile: the .gui file of the dialog
     *    - templates: the templates a project is created from, at least one, the first one chosen first
     *    - location: the location proposed first, the directory the project goes in
     * */
    pub self (guiFile: [c8], templates: [&ProjectTemplate], location: [c8])
        with super(guiFile, "", "New project")
        , _location = location
        , _templates = templates
    {}

    /**
     * @returns: the signal emitted with the absolute path of the directory of the project created, none when the dialog
     * is cancelled
     * */
    pub fn answered(mut self)-> dmut &Signal!{([c8])?} {
        alias self._answered
    }

    pub over dismiss(mut self) {
        self:.answer(none);
    }

    prot over onShow(mut self) {
        self:.setText("LOCATION", self._location);
        self:.setText("NAME", "New game");
        if let Ok(dmut d: &Dropdown) = self:.find("TEMPLATE") {
            d:.setItems(copy [labelOf(t.name) for t in self._templates]);
            d:.setSelected(self._chosen);
        }

        self:.showTemplate();
        self:.focus("NAME");
    }

    /**
     * A template is chosen in the dropdown, what it holds told under it
     * @params:
     *    - index: the index of the template among the templates of the dialog
     * */
    #[slot (name-> "template")]
    fn onTemplateChosen(mut self, index: usize) {
        if index >= self._templates.len { return; }
        self._chosen = index;
        self:.showTemplate();
    }

    /**
     * Tell what a project made from the template chosen holds
     * */
    fn showTemplate(mut self) {
        if self._chosen >= self._templates.len { return; }
        if let Ok(dmut l: &Label) = self:.find("TEMPLATE_NOTE") {
            l:.setText(self._templates[self._chosen].description);
        }
    }

    #[slot (name-> "browse")]
    fn onBrowseClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        if let Ok(dmut g) = alias self._gui {
            let dmut d = copy FileDialog(FileDialogMode::DIRECTORY, directory-> self:.getText("LOCATION"),
                                         title-> "Location of the project");
            d:.answered():.connect(alias g:.getSlotEmitter(), &self:.onLocationChosen);
            {
                d:.open(DialogMode::OVERLAY, alias g);
            } catch {
                err => {
                    self:.setError(f"The file dialog could not be opened: ${err}");
                }
            }
        }
    }

    fn onLocationChosen(mut self, path: ([c8])?) {
        if let Ok(p) = path {
            self:.setText("LOCATION", p);
        }

        self:.focus("NAME");
    }

    #[slot (name-> "accept")]
    fn onAcceptClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.create(); }
    }

    #[slot (name-> "cancel")]
    fn onCancelClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.answer(none); }
    }

    /**
     * Create the project in a new folder of the location, then answer its directory, or tell why it is not created
     * */
    fn create(mut self) {
        let name = self:.getText("NAME");
        let location = self:.getText("LOCATION");
        if location.len == 0us || !Path(location).isAbsolute() {
            self:.setError("The location is the absolute path of a folder");
            return;
        }

        if self._chosen >= self._templates.len {
            self:.setError("The editor has no template to create the project from");
            return;
        }

        let directory = Path(location).push(ProjectTemplate::packageOf(name)).normalize().toStr();
        {
            self._templates[self._chosen].create(name, directory);
        } catch {
            err: &BalderError => {
                self:.setError(err.msg);
                return;
            }
        }

        self:.answer((directory)?);
    }

    /**
     * Close the dialog then emit its answer, a dialog closed already answering nothing
     * */
    fn answer(mut self, directory: ([c8])?) {
        if !self.isOpen { return; }

        self:.close();
        self._answered:.emit(directory);
    }

    /**
     * @returns: the text of an input of the dialog
     * */
    fn getText(mut self, path: [c8])-> [c8] {
        if let Ok(i: &InputText) = self:.find(path) {
            return i.getText();
        }

        ""
    }

    /**
     * Write the text of an input of the dialog
     * */
    fn setText(mut self, path: [c8], text: [c8]) {
        if let Ok(dmut i: &InputText) = self:.find(path) {
            i:.setText(text, moveCursor-> true);
        }
    }

    /**
     * Tell why the project was not created
     * */
    fn setError(mut self, text: [c8]) {
        if let Ok(dmut l: &Label) = self:.find("ERROR") {
            l:.setText(text);
        }
    }
}

/**
 * @returns: the label of a template in the dropdown, its directory in words: third_person reading Third person
 * */
fn labelOf(name: [c8])-> [c8] {
    let dmut s = copy StringStream();
    for i, c in name {
        if c == '_' || c == '-' {
            s:.write(' ');
        } else if i == 0us {
            s:.write(toUpper(c));
        } else {
            s:.write(c);
        }
    }

    s[]
}
