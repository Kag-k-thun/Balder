in build_dialog;

use balder::interface::dialog;
use balder::interface::widget::range::progress;
use balder::interface::widget::text::label;

/**
 * The build of the editor of a project, over the project manager while it lasts: the project, a bar filled as far as
 * the build is, and the step it is at (see BuildProgress); the manager takes no click meanwhile
 * @info: the build cannot be cancelled, gyllir leaving its cache half written when it is stopped: Escape leaves the
 * dialog open, and the manager closes it once the build ends
 * */
pub class BuildDialog over Dialog {

    // The name of the project whose editor is built
    let _name: [c8];

    /**
     * @params:
     *    - guiFile: the .gui file of the dialog
     *    - name: the name of the project whose editor is built
     * */
    pub self (guiFile: [c8], name: [c8])
        with super(guiFile, "", "Building the editor")
        , _name = name
    {}

    /**
     * The build goes on: the dialog stays open
     * */
    pub over dismiss(mut self) {}

    /**
     * Show how far the build is
     * @params:
     *    - done: the share of the build done, from 0 to 1
     *    - step: the step it is at
     * */
    pub fn setProgress(mut self, done: f32, step: [c8]) {
        if let Ok(dmut b: &ProgressBar) = self:.find("BAR") {
            b:.setValue(done);
        }

        if let Ok(dmut l: &Label) = self:.find("STEP") {
            l:.setText(step);
        }
    }

    prot over onShow(mut self) {
        if let Ok(dmut l: &Label) = self:.find("TITLE") {
            l:.setText(f"Building the editor of ${self._name}");
        }

        self:.setProgress(0.0f, "Resolving the dependencies");
    }

}
