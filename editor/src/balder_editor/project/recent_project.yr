in recent_project;

/**
 * A project the editor opened, in the list of the recent projects (see RecentProjects)
 * */
@data
pub record RecentProject {

    // The absolute path of the directory of the project
    let mut directory: [c8] = "";

    // When the editor opened it last, in ISO 8601
    let mut opened: [c8] = "";

    // The scene of the project edited last (res:/…), empty when none was
    let mut scene: [c8] = "";

    // The absolute path of the directory the game was exported to last, empty when it never was
    let mut exportFolder: [c8] = "";

}
