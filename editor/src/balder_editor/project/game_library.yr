in game_library;

use balder::core::error;
use balder::scene::actors::node_classes;
use balder::utils::log;

use etc::dl;

/**
 * The library of the game of a project loaded in the editor, lib<package>.so (see GameBuild): the tags #[actor] of its
 * classes register them as it opens, the Add menu, the inspector and the scene files taking them as the classes of
 * Balder, and its close unregisters them
 * @info:
 * =====
 * One library is loaded at a time (GameLibrary::load closes the one loaded first), so that two projects never share
 * the registry of the node classes. The editor is linked with its symbols exported (the target `editor` of Balder,
 * `exports = true`), the library leaving Balder and the std to it (`host-provided`), so that both run on one runtime.
 * Nothing of the library may outlive its close: the nodes of its classes are dropped first (see EditorActivity's
 * reload), its classes then unregistered, the probes, the members and the schemas read from them with them.
 * ====
 * */
pub class GameLibrary {

    // The library opened
    let dmut _library: &SharedLibrary;

    // The types of the actor classes the library registered, in the order of their registration
    let _classes: [[c8]];

    /**
     * @params:
     *    - library: the library opened
     *    - classes: the types of the actor classes it registered
     * */
    self (dmut library: &SharedLibrary, classes: [[c8]])
        with _library = alias library
        , _classes = classes
    {}

    /**
     * @returns: the path the library was opened from
     * */
    @field
    pub fn path(self)-> [c8] {
        self._library.path()
    }

    /**
     * @returns: the types of the actor classes the library registered, in the order of their registration
     * */
    @field
    pub fn classes(self)-> [[c8]] {
        self._classes
    }

    /**
     * Unregister the actor classes of the library, then close it, logging why it cannot be
     * */
    fn close(mut self) {
        for c in self._classes {
            unregisterActorClass(c);
        }

        {
            self._library:.close();
        } catch {
            err: &SharedLibraryError => {
                log::error #("Editor", f"The library of the game could not be closed: ${err.msg}");
            }
        }
    }

}

/**
 * The library of the game loaded in the editor
 * */
@companion
pub mod GameLibrary {

    /**
     * Load the library of a game, the one loaded before closed first
     * @params:
     *    - path: the absolute path of the library, lib<package>.so
     * @returns: the library loaded
     * @throws:
     *    - &BalderError: if the library cannot be loaded (a missing file, a symbol it uses that the editor does not
     *                    define, a library built against another Balder), the message telling why; no library is
     *                    loaded then
     * */
    pub fn load(path: [c8])-> &GameLibrary
        throws BalderError
    {
        GameLibrary::unload();

        let registered = actorClasses().len;
        {
            let dmut library = copy SharedLibrary(path);
            let mut classes: [[c8]] = [];
            let mut names = "";
            for c in actorClasses()[registered .. $] {
                classes ~= [c.name];
                names ~= (if names.len == 0us { "" } else { ", " }) ~ c.name;
            }

            let loaded = f"Loaded ${path}, its actor classes: ${names}";
            log::info #("Editor", loaded);
            let dmut res = copy GameLibrary(alias library, classes);
            __LOADED__ = (alias res)?;
            return res;
        } catch {
            err: &SharedLibraryError => {
                throw copy BalderError(f"The library of the game could not be loaded: ${err.msg}");
            }
        }
    }

    /**
     * Close the library of the game loaded, its actor classes unregistered; nothing when none is loaded
     * */
    pub fn unload() {
        if let Ok(dmut l) = alias __LOADED__ {
            __LOADED__ = none;
            l:.close();
        }
    }

    /**
     * @returns: the library of the game loaded, none when none is
     * */
    pub fn loaded()-> (&GameLibrary)? {
        __LOADED__
    }

}

/**
 * The library of the game loaded, none when none is
 * */
lazy dmut __LOADED__: (&GameLibrary)? = none;
