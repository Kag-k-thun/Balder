in utils;

/**
 * @returns: true iif a text holds a word
 * */
pub fn contains(text: [c8], word: [c8])-> bool {
    occurrences(text, word, first-> true) != 0u32
}

/**
 * @returns: the number of times a word is in a text, its occurrences not overlapping
 * @params:
 *    - first: true to stop at the first occurrence
 * */
pub fn occurrences(text: [c8], word: [c8], first: bool = false)-> u32 {
    if word.len == 0us || text.len < word.len { return 0u32; }

    let mut res = 0u32;
    let mut i = 0us;
    while i + word.len <= text.len {
        if text[i] == word[0] && text[i .. i + word.len] == word {
            res += 1u32;
            if first { return res; }
            i += word.len;
        } else {
            i += 1us;
        }
    }

    res
}

/**
 * @returns: a text without the escape sequences colouring a terminal
 * */
pub fn plain(text: [c8])-> [c8] {
    let mut res: [c8] = "";
    let mut i = 0us;
    while i < text.len {
        if text[i] == '\u{0x1b}' && i + 1us < text.len && text[i + 1us] == '[' {
            i += 2us;
            while i < text.len && !((text[i] >= 'a' && text[i] <= 'z') || (text[i] >= 'A' && text[i] <= 'Z')) { i += 1us; }
            i += 1us;
        } else {
            res ~= [text[i]];
            i += 1us;
        }
    }

    res
}

/**
 * @returns: a text without the spaces around it
 * */
pub fn trimmed(text: [c8])-> [c8] {
    let mut s = 0us;
    let mut e = text.len;
    while s < e && (text[s] == ' ' || text[s] == '\t') { s += 1us; }
    while e > s && (text[e - 1us] == ' ' || text[e - 1us] == '\t' || text[e - 1us] == '\r') { e -= 1us; }
    text[s .. e]
}
