in game_build;

use balder_editor::project::build_progress;
use balder::core::error;
use balder::game::{game_library, logged_process};
use balder::utils::toml_file;

use std::{algorithm::searching, fs, time};

/**
 * The build of the library of the game of a project: the shared target of its gyllir.toml (`type = "shared"`, see the
 * template of the projects), lib<output>.so, which the editor loads (see GameLibrary)
 * @info:
 * =====
 * The build runs in the background (`gyllir build <target> -v`, in the directory of the project), its output written
 * to a log under the build cache of the project (GameBuild::LOG), from which `progress` tells how far it is and
 * `errors` why it failed; `cancel` stops it, with the compilers gyllir runs (see LoggedProcess):
 * ```
 * let dmut b = copy GameBuild(directory);
 * b:.build();
 * // … at each update
 * if let Ok(code) = b:.finished() {
 *     if code == 0 { GameLibrary::load(b.library); } else { println(b.errors()); }
 * }
 * ```
 * ====
 * */
pub class GameBuild {

    // The absolute path of the directory of the project
    let _directory: [c8];

    // The name of the shared target of the project
    let _target: [c8];

    // The path of the library built, relative to the directory of the project unless absolute
    let _library: [c8];

    // The build running, none before build is called
    let dmut _build: (&LoggedProcess)? = none;

    // True once the build running, or the last one, is cancelled
    let mut _cancelled: bool = false;

    // How far the build running is, and the length of its log read
    let dmut _progress: &BuildProgress = copy BuildProgress(0u32);
    let mut _read: u64 = 0u64;

    /**
     * @params:
     *    - directory: the absolute path of the directory of the project
     * @throws:
     *    - &BalderError: if the gyllir.toml of the project cannot be read, or declares no shared target
     * */
    pub self (directory: [c8])
        with _directory = directory
        , _target = GameLibrary::sharedTarget(directory)._0
        , _library = GameLibrary::fileOf(directory)
        throws BalderError
    {}

    /**
     * @returns: the name of the shared target of the project
     * */
    @field
    pub fn target(self)-> [c8] {
        self._target
    }

    /**
     * @returns: the path of the log of the build, under the build cache of the project
     * */
    @field
    pub fn log(self)-> [c8] {
        Path(self._directory).push(GameBuild::LOG).toStr()
    }

    /**
     * @returns: the absolute path of the library built, lib<output>.so
     * */
    @field
    pub fn library(self)-> [c8] {
        if Path(self._library).isAbsolute() { self._library } else { Path(self._directory).push(self._library).toStr() }
    }

    /**
     * @returns: true iif the library is built and newer than every source it is built from: the .yr files and the
     * gyllir.toml of the project and of its dependencies (Balder, its bindings, the std), their links followed; the
     * build of a library up to date taking gyllir several seconds still, the editor loads it right away
     * */
    pub fn isUpToDate(self)-> bool {
        {
            let built = fileDate(Path(self.library));
            let mut seen: [[c8]] = [];
            !newerSource(Path(self._directory), built, ref seen)
        } catch {
            _ => { false }
        }
    }

    /**
     * @returns: true iif the build was started and is not finished yet
     * */
    pub fn isRunning(mut self)-> bool {
        if let Ok(dmut p) = alias self._build {
            return !p:.isFinished();
        }

        false
    }

    /**
     * @returns: true iif the build running, or the last one, was cancelled
     * */
    @field
    pub fn isCancelled(self)-> bool {
        self._cancelled
    }

    /**
     * Stop the build running, the compilers it runs with it; finished tells once it stopped
     * */
    pub fn cancel(mut self) {
        if let Ok(dmut p) = alias self._build {
            p:.cancel();
            self._cancelled = true;
        }
    }

    /**
     * Start the build of the library, in the background
     * @throws:
     *    - &BalderError: if the build cannot be started
     * */
    pub fn build(mut self)
        throws BalderError
    {
        {
            let log = Path(self.log);
            if !isDir(log.parent()) { createDir(log.parent(), recursive-> true); }

            // the log of the last build goes first, so that it is not read as the one of this build
            if isFile(log) { removeFile(log); }
            self._progress = copy BuildProgress(self.expectedSteps());
            self._read = 0u64;
            self._cancelled = false;
            self._build = (copy LoggedProcess("gyllir", copy ["build", self._target, "-v"], self.log, cwd-> self._directory))?;
        } catch {
            err: &FsError => {
                throw copy BalderError(f"The build of the library of ${self._directory} could not start: ${err}");
            }
        }
    }

    /**
     * @returns: the exit code of the build once it is finished (0 when the library is built, 127 when gyllir is not
     * found), none while it runs or when it was not started
     * */
    pub fn finished(mut self)-> (i32)? {
        let mut code: (i32)? = none;
        if let Ok(dmut p) = alias self._build {
            if p:.isFinished() {
                code = (p:.wait())?;
                self._build = none;
            }
        }

        // the steps of a build that succeeded are those the next one expects
        if let Ok(c) = code && c == 0 {
            self:.readLog();
            {
                toml_file::writeFile(Path(self._directory).push(GameBuild::STEPS).toStr(), f"${self._progress.steps}\n");
            } catch {
                _ => {}
            }
        }

        code
    }

    /**
     * @returns: how far the build running is, its log read up to its end
     * */
    pub fn progress(mut self)-> &BuildProgress {
        self:.readLog();
        self._progress
    }

    /**
     * @returns: the errors of the log of the build, plain, each as the compiler writes it, its message, the place it
     * names and the code there, or a line of gyllir; an error written twice kept once, none when the log names none or
     * cannot be read
     * */
    pub fn errors(self)-> [[c8]] {
        GameBuild::errorsIn(self.log)
    }

    /**
     * Write the errors of the build in a text file of its own, beside the log (GameBuild::ERRORS), to be read without
     * the output of the build around them
     * @returns: the absolute path of the file
     * @throws:
     *    - &BalderError: if the file cannot be written
     * */
    pub fn writeErrors(self, errors: [[c8]])-> [c8]
        throws BalderError
    {
        let file = Path(self._directory).push(GameBuild::ERRORS).toStr();
        let mut text = f"The build of the library of ${self._directory} failed, ${errors.len} errors (its whole output in ${self.log})\n";
        for e in errors {
            text ~= "\n" ~ e ~ "\n";
        }

        toml_file::writeFile(file, text);
        file
    }

    /**
     * Give the progress of the build what its log holds past what was read of it
     * */
    fn readLog(mut self) {
        {
            let dmut f = File::open(Path(self.log));
            if f.len() < self._read {
                // a log written again from its start
                self._progress = copy BuildProgress(self.expectedSteps());
                self._read = 0u64;
            }

            if f.len() > self._read {
                f:.seek(self._read);
                let text = f:.readAll();
                self._read += cast!u64(text.len);
                self._progress:.read(text);
            }

            f:.close();
        } catch {
            _ => {}
        }
    }

    /**
     * @returns: the steps of the last build of the library that succeeded, 0 when they are not known
     * */
    fn expectedSteps(self)-> u32 {
        {
            let dmut f = File::open(Path(self._directory).push(GameBuild::STEPS));
            let text = f:.readAll();
            f:.close();

            let mut res = 0u32;
            for c in text {
                if c < '0' || c > '9' { break; }
                res = res * 10u32 + cast!u32(cast!u8(c) - cast!u8('0'));
            }

            res
        } catch {
            _ => { 0u32 }
        }
    }

}

/**
 * The shared target of a project, and the outputs of its builds
 * */
pub mod GameBuild {

    /**
     * The name of the target of the gyllir.toml of a project made before the library of its game was shared (BAL-128),
     * an editor linking it, ignored
     * */
    pub def EDITOR_TARGET = "editor";

    /**
     * The log of the build of the library, relative to the directory of the project
     * */
    pub def LOG = ".target/game-build.log";

    /**
     * The steps of the last build of the library that succeeded, relative to the directory of the project, read by the
     * next build to tell how far it is
     * */
    pub def STEPS = ".target/game-build.steps";

    /**
     * The errors of the last build of the library that failed, plain (see GameBuild.writeErrors), relative to the
     * directory of the project
     * */
    pub def ERRORS = ".target/game-build-errors.txt";

    /**
     * @returns: the errors of the log of a build of gyllir (the library of the game, the export), plain, each as the
     * compiler writes it, its message, the place it names and the code there, or a line of gyllir; an error written
     * twice kept once, none when the log names none or cannot be read
     * @params:
     *    - log: the absolute path of the log
     * */
    pub fn errorsIn(log: [c8])-> [[c8]] {
        {
            let dmut f = File::open(Path(log));
            let text = f:.readAll();
            f:.close();
            errorsOf(text)
        } catch {
            _ => { [] }
        }
    }

    /**
     * @returns: an error of the build on one line, its message and the place it names, `Error[E3027] : undefined
     * symbol x (src/a.yr:(3,5))`
     * */
    pub fn summary(error: [c8])-> [c8] {
        let mut res: [c8] = "";
        let mut start = 0us;
        for i in 0us .. error.len + 1us {
            if i == error.len || error[i] == '\n' {
                let line = utils::trimmed(error[start .. i]);
                if res.len == 0us {
                    res = line;
                } else if startsWith(line, "-->") {
                    return res ~ " (" ~ utils::trimmed(line[3us .. $]) ~ ")";
                }

                start = i + 1us;
            }
        }

        res
    }

    /**
     * @returns: true iif the gyllir.toml of the project of a directory declares a shared target, false when it does not
     * or cannot be read
     * */
    pub fn has(directory: [c8])-> bool {
        {
            GameLibrary::sharedTarget(directory);
            true
        } catch {
            _ => { false }
        }
    }

    /**
     * @returns: true iif the gyllir.toml of the project of a directory declares the editor of the projects made before
     * the library of their game was shared (a target `editor`), false when it does not or cannot be read
     * */
    pub fn hasEditor(directory: [c8])-> bool {
        {
            let cfg = toml_file::readToml(Path(directory).push("gyllir.toml").toStr());
            if let Ok(targets) = cfg["targets"]? {
                return (targets[GameBuild::EDITOR_TARGET]?).hasValue;
            }

            false
        } catch {
            _ => { false }
        }
    }

}

/**
 * @returns: true iif a directory holds a source newer than a date, a .yr file or a gyllir.toml, in it or under it: the
 * links to directories followed (the dependencies of .deps/), each directory walked once, the build outputs, the
 * resources and the hidden directories (.git, .target) but .deps skipped
 * @params:
 *    - seen: the canonical paths of the directories walked already
 * @throws:
 *    - &FsError: if a directory cannot be read
 * */
fn newerSource(dir: Path, than: Instant, ref mut seen: [[c8]])-> bool
    throws FsError
{
    let real = canonicalize(dir).toStr();
    for s in seen if s == real { return false; }
    seen ~= [real];

    for e in readDir(dir) {
        let name = e.path.file();
        if e.kind == FsEntryKind::FILE {
            if (endsWith(name, ".yr") || name == "gyllir.toml" || name == "gyllir.toml.override") && fileDate(e.path) > than {
                return true;
            }
        } else if (e.kind == FsEntryKind::DIR || (e.kind == FsEntryKind::LINK && isDir(e.path))) && !skipped(name) {
            if newerSource(e.path, than, ref seen) { return true; }
        }
    }

    false
}

/**
 * @returns: true iif a directory holds no source of a build: the build outputs, the resources, the hidden directories
 * but the dependencies (.deps)
 * */
fn skipped(name: [c8])-> bool {
    if name == ".deps" { return false; }
    if name.len != 0us && name[0] == '.' { return true; }
    name == "target" || name == "__doc" || name == "res" || name == "local_res"
}

/**
 * @returns: the errors of the output of gyllir, its colours left in, plain: an error of the compiler from its line
 * `Error[E…] : …` up to the end of its block (the place, the code, the declaration validated), a line `Error …` of
 * gyllir alone; only the lines in an error, or starting one, are made plain, an error written twice is kept once
 * */
fn errorsOf(text: [c8])-> [[c8]] {
    let mut res: [[c8]] = [];
    let mut block: [c8] = "";
    let mut lines = 0u32;
    let mut start = 0us;
    while start < text.len {
        let mut end = start;
        while end < text.len && text[end] != '\n' { end += 1us; }

        let raw = text[start .. end];
        start = end + 1us;
        if block.len == 0us && !utils::contains(raw, "Error") { continue; }

        let line = utils::plain(raw);
        let content = utils::trimmed(line);
        if block.len != 0us {
            // a block ends at an empty line, a message of gyllir (indented by a tab), or another message
            let ends = content.len == 0us || (line.len != 0us && line[0] == '\t') || startsWith(content, "[")
                || startsWith(content, "Error") || startsWith(content, "Warning");
            if !ends && lines < 24u32 {
                block ~= "\n" ~ withoutTrailingSpaces(line);
                lines += 1u32;
                continue;
            }

            res = withError(res, block);
            block = "";
        }

        if startsWith(content, "Error[") {
            block = content;
            lines = 1u32;
        } else if startsWith(content, "Error ") {
            res = withError(res, content);
        }
    }

    if block.len != 0us { res = withError(res, block); }
    res
}

/**
 * @returns: errors and one more, unless they hold it already
 * */
fn withError(errors: [[c8]], error: [c8])-> [[c8]] {
    for e in errors if e == error { return errors; }
    errors ~ [error]
}

/**
 * @returns: a line without the spaces ending it, those starting it kept (the code of an error is indented)
 * */
fn withoutTrailingSpaces(line: [c8])-> [c8] {
    let mut e = line.len;
    while e > 0us && (line[e - 1us] == ' ' || line[e - 1us] == '\t' || line[e - 1us] == '\r') { e -= 1us; }
    line[0us .. e]
}
