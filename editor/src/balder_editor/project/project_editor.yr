in project_editor;

use balder_editor::project::build_progress;
use balder::core::error;

use std::{algorithm::searching, concurrency, config, fs, time};

/**
 * The editor of a project: the target `editor` of its gyllir.toml (see the template of the projects), an executable
 * linking the editor of Balder and the library of the game, the actor classes of the game being registered in it; the
 * project manager builds it with gyllir, then runs it on the project
 * @info:
 * =====
 * The build runs in the background (`gyllir build editor -v`, in the directory of the project), its output written to
 * a log under the build cache of the project (ProjectEditor::LOG), from which `progress` tells how far it is and
 * `errors` why it failed. The editor runs
 * in the directory of the project, which its main takes as its project and from which it finds the engine it was built
 * against (.deps/Balder):
 * ```
 * let dmut e = copy ProjectEditor(directory);
 * e:.build();
 * // … at each update
 * if let Ok(code) = e:.finished() {
 *     if code == 0 { e.run(); } else { println(e.errors()); }
 * }
 * ```
 * ====
 * */
pub class ProjectEditor {

    // The absolute path of the directory of the project
    let _directory: [c8];

    // The path of the executable of the editor, relative to the directory of the project unless absolute
    let _executable: [c8];

    // The build running, none before build is called
    let dmut _build: (&SubProcess)? = none;

    // How far the build running is, and the length of its log read
    let dmut _progress: &BuildProgress = copy BuildProgress(0u32);
    let mut _read: u64 = 0u64;

    /**
     * @params:
     *    - directory: the absolute path of the directory of the project
     * @throws:
     *    - &BalderError: if the gyllir.toml of the project cannot be read, or declares no target `editor`
     * */
    pub self (directory: [c8])
        with _directory = directory
        , _executable = executableOf(directory)
        throws BalderError
    {}

    /**
     * @returns: the path of the log of the build, under the build cache of the project
     * */
    @field
    pub fn log(self)-> [c8] {
        Path(self._directory).push(ProjectEditor::LOG).toStr()
    }

    /**
     * @returns: the absolute path of the executable of the editor
     * */
    @field
    pub fn executable(self)-> [c8] {
        if Path(self._executable).isAbsolute() { self._executable } else { Path(self._directory).push(self._executable).toStr() }
    }

    /**
     * @returns: true iif the editor is built and newer than every source it is built from: the .yr files and the
     * gyllir.toml of the project and of its dependencies (Balder, its bindings, the std), their links followed; the
     * build of an editor up to date taking gyllir several seconds still, the project manager runs it right away
     * */
    pub fn isUpToDate(self)-> bool {
        {
            let built = fileDate(Path(self.executable));
            let mut seen: [[c8]] = [];
            !newerSource(Path(self._directory), built, ref seen)
        } catch {
            _ => { false }
        }
    }

    /**
     * Start the build of the editor, in the background
     * @throws:
     *    - &BalderError: if the build cannot be started
     * */
    pub fn build(mut self)
        throws BalderError
    {
        {
            let log = Path(self.log);
            if !isDir(log.parent()) { createDir(log.parent(), recursive-> true); }

            // the log of the last build goes first, so that it is not read as the one of this build
            if isFile(log) { removeFile(log); }
            self._progress = copy BuildProgress(self.expectedSteps());
            self._read = 0u64;

            // the log is given to sh as its first argument, so that its path is never read as shell syntax
            let dmut p = copy SubProcess("sh", copy ["-c", f"exec gyllir build ${ProjectEditor::TARGET} -v > \"$1\" 2>&1",
                                                    "sh", self.log], cwd-> Path(self._directory));
            p:.start(redirect-> false);
            self._build = (alias p)?;
        } catch {
            err: &FsError => {
                throw copy BalderError(f"The build of the editor of ${self._directory} could not start: ${err}");
            }
        }
    }

    /**
     * @returns: the exit code of the build once it is finished (0 when the editor is built, 127 when gyllir is not
     * found), none while it runs or when it was not started
     * */
    pub fn finished(mut self)-> (i32)? {
        let mut code: (i32)? = none;
        if let Ok(dmut p) = alias self._build {
            if p:.isFinished() { code = (p:.wait())?; }
        }

        // the steps of a build that succeeded are those the next one expects
        if let Ok(c) = code && c == 0 {
            self:.readLog();
            {
                utils::writeFile(Path(self._directory).push(ProjectEditor::STEPS).toStr(), f"${self._progress.steps}\n");
            } catch {
                _ => {}
            }
        }

        code
    }

    /**
     * @returns: how far the build running is, its log read up to its end
     * */
    pub fn progress(mut self)-> &BuildProgress {
        self:.readLog();
        self._progress
    }

    /**
     * @returns: the errors of the log of the build, plain, each as the compiler writes it, its message, the place it
     * names and the code there, or a line of gyllir; an error written twice kept once, none when the log names none or
     * cannot be read
     * */
    pub fn errors(self)-> [[c8]] {
        {
            let dmut f = File::open(Path(self.log));
            let text = f:.readAll();
            f:.close();
            errorsOf(text)
        } catch {
            _ => { [] }
        }
    }

    /**
     * Write the errors of the build in a text file of its own, beside the log (ProjectEditor::ERRORS), to be read
     * without the output of the build around them
     * @returns: the absolute path of the file
     * @throws:
     *    - &BalderError: if the file cannot be written
     * */
    pub fn writeErrors(self, errors: [[c8]])-> [c8]
        throws BalderError
    {
        let file = Path(self._directory).push(ProjectEditor::ERRORS).toStr();
        let mut text = f"The build of the editor of ${self._directory} failed, ${errors.len} errors (its whole output in ${self.log})\n";
        for e in errors {
            text ~= "\n" ~ e ~ "\n";
        }

        utils::writeFile(file, text);
        file
    }

    /**
     * Give the progress of the build what its log holds past what was read of it
     * */
    fn readLog(mut self) {
        {
            let dmut f = File::open(Path(self.log));
            if f.len() < self._read {
                // a log written again from its start
                self._progress = copy BuildProgress(self.expectedSteps());
                self._read = 0u64;
            }

            if f.len() > self._read {
                f:.seek(self._read);
                let text = f:.readAll();
                self._read += cast!u64(text.len);
                self._progress:.read(text);
            }

            f:.close();
        } catch {
            _ => {}
        }
    }

    /**
     * @returns: the steps of the last build of the editor that succeeded, 0 when they are not known
     * */
    fn expectedSteps(self)-> u32 {
        {
            let dmut f = File::open(Path(self._directory).push(ProjectEditor::STEPS));
            let text = f:.readAll();
            f:.close();

            let mut res = 0u32;
            for c in text {
                if c < '0' || c > '9' { break; }
                res = res * 10u32 + cast!u32(cast!u8(c) - cast!u8('0'));
            }

            res
        } catch {
            _ => { 0u32 }
        }
    }

    /**
     * Run the editor built on the project, in its directory; the program running it waits for it before ending (see
     * ProjectEditor::waitRunning), so that the terminal it was started from stays with the editor until it is closed
     * @throws:
     *    - &BalderError: if the editor cannot be run
     * */
    pub fn run(self)
        throws BalderError
    {
        let exe = Path(self.executable);
        if !isFile(exe) {
            throw copy BalderError(f"The editor of the project is missing: ${exe.toStr()}");
        }

        {
            let dmut p = copy SubProcess(exe.toStr(), copy ["--project", self._directory], cwd-> Path(self._directory));
            p:.start(redirect-> false);
            __RUNNING__ ~= [alias p];
        } catch {
            err: &FsError => {
                throw copy BalderError(f"The editor of the project could not run: ${err}");
            }
        }
    }

}

/**
 * The target of the editor of a project
 * */
pub mod ProjectEditor {

    /**
     * The name of the target of the gyllir.toml of a project building its editor
     * */
    pub def TARGET = "editor";

    /**
     * The log of the build of the editor, relative to the directory of the project
     * */
    pub def LOG = ".target/editor-build.log";

    /**
     * The steps of the last build of the editor that succeeded, relative to the directory of the project, read by the
     * next build to tell how far it is
     * */
    pub def STEPS = ".target/editor-build.steps";

    /**
     * The errors of the last build of the editor that failed, plain (see ProjectEditor.writeErrors), relative to the
     * directory of the project
     * */
    pub def ERRORS = ".target/editor-build-errors.txt";

    /**
     * @returns: an error of the build on one line, its message and the place it names, `Error[E3027] : undefined
     * symbol x (src/a.yr:(3,5))`
     * */
    pub fn summary(error: [c8])-> [c8] {
        let mut res: [c8] = "";
        let mut start = 0us;
        for i in 0us .. error.len + 1us {
            if i == error.len || error[i] == '\n' {
                let line = utils::trimmed(error[start .. i]);
                if res.len == 0us {
                    res = line;
                } else if startsWith(line, "-->") {
                    return res ~ " (" ~ utils::trimmed(line[3us .. $]) ~ ")";
                }

                start = i + 1us;
            }
        }

        res
    }

    /**
     * Wait for the editors of projects this program ran (see ProjectEditor.run) to be closed, the project manager
     * ending once the editor it opened ends
     * */
    pub fn waitRunning() {
        for dmut p in alias __RUNNING__ {
            p:.wait();
        }

        __RUNNING__ = [];
    }

    /**
     * @returns: true iif the gyllir.toml of the project of a directory declares a target `editor`, false when it does
     * not or cannot be read
     * */
    pub fn has(directory: [c8])-> bool {
        {
            editorTarget(directory);
            true
        } catch {
            _ => { false }
        }
    }

}

/**
 * The editors of projects this program ran, waited for before it ends
 * */
lazy dmut __RUNNING__: [&SubProcess] = [];

/**
 * @returns: the table of the target `editor` of the gyllir.toml of a project, and the configuration of the package
 * @throws:
 *    - &BalderError: if the file cannot be read, or declares no target `editor`
 * */
fn editorTarget(directory: [c8])-> (&Config, &Config)
    throws BalderError
{
    let file = Path(directory).push("gyllir.toml").toStr();
    let cfg = utils::readToml(file);
    if let Ok(targets) = cfg["targets"]? {
        if let Ok(target) = targets[ProjectEditor::TARGET]? {
            return (target, cfg);
        }
    }

    throw copy BalderError(f"${file} declares no target '${ProjectEditor::TARGET}'");
}

/**
 * @returns: the path of the executable of the editor of a project, relative to its directory unless absolute: the
 * output of its target (its name by default) in its output directory (the one of the package by default, else the
 * directory of the project), as gyllir names them
 * @throws:
 *    - &BalderError: if the gyllir.toml of the project cannot be read, or declares no target `editor`
 * */
fn executableOf(directory: [c8])-> [c8]
    throws BalderError
{
    let (target, cfg) = editorTarget(directory);
    let file = Path(directory).push("gyllir.toml").toStr();
    let mut output = utils::stringOf(target, "output", file, optional-> true);
    if output.len == 0us { output = ProjectEditor::TARGET; }

    let mut dir = utils::stringOf(target, "output-dir", file, optional-> true);
    if dir.len == 0us { dir = utils::stringOf(cfg, "output-dir", file, optional-> true); }
    if dir.len == 0us { return output; }

    Path(dir).push(output).toStr()
}

/**
 * @returns: true iif a directory holds a source newer than a date, a .yr file or a gyllir.toml, in it or under it: the
 * links to directories followed (the dependencies of .deps/), each directory walked once, the build outputs, the
 * resources and the hidden directories (.git, .target) but .deps skipped
 * @params:
 *    - seen: the canonical paths of the directories walked already
 * @throws:
 *    - &FsError: if a directory cannot be read
 * */
fn newerSource(dir: Path, than: Instant, ref mut seen: [[c8]])-> bool
    throws FsError
{
    let real = canonicalize(dir).toStr();
    for s in seen if s == real { return false; }
    seen ~= [real];

    for e in readDir(dir) {
        let name = e.path.file();
        if e.kind == FsEntryKind::FILE {
            if (endsWith(name, ".yr") || name == "gyllir.toml" || name == "gyllir.toml.override") && fileDate(e.path) > than {
                return true;
            }
        } else if (e.kind == FsEntryKind::DIR || (e.kind == FsEntryKind::LINK && isDir(e.path))) && !skipped(name) {
            if newerSource(e.path, than, ref seen) { return true; }
        }
    }

    false
}

/**
 * @returns: true iif a directory holds no source of a build: the build outputs, the resources, the hidden directories
 * but the dependencies (.deps)
 * */
fn skipped(name: [c8])-> bool {
    if name == ".deps" { return false; }
    if name.len != 0us && name[0] == '.' { return true; }
    name == "target" || name == "__doc" || name == "res" || name == "local_res"
}

/**
 * @returns: the errors of the output of gyllir, its colours left in, plain: an error of the compiler from its line
 * `Error[E…] : …` up to the end of its block (the place, the code, the declaration validated), a line `Error …` of
 * gyllir alone; only the lines in an error, or starting one, are made plain, an error written twice is kept once
 * */
fn errorsOf(text: [c8])-> [[c8]] {
    let mut res: [[c8]] = [];
    let mut block: [c8] = "";
    let mut lines = 0u32;
    let mut start = 0us;
    while start < text.len {
        let mut end = start;
        while end < text.len && text[end] != '\n' { end += 1us; }

        let raw = text[start .. end];
        start = end + 1us;
        if block.len == 0us && !utils::contains(raw, "Error") { continue; }

        let line = utils::plain(raw);
        let content = utils::trimmed(line);
        if block.len != 0us {
            // a block ends at an empty line, a message of gyllir (indented by a tab), or another message
            let ends = content.len == 0us || (line.len != 0us && line[0] == '\t') || startsWith(content, "[")
                || startsWith(content, "Error") || startsWith(content, "Warning");
            if !ends && lines < 24u32 {
                block ~= "\n" ~ withoutTrailingSpaces(line);
                lines += 1u32;
                continue;
            }

            res = withError(res, block);
            block = "";
        }

        if startsWith(content, "Error[") {
            block = content;
            lines = 1u32;
        } else if startsWith(content, "Error ") {
            res = withError(res, content);
        }
    }

    if block.len != 0us { res = withError(res, block); }
    res
}

/**
 * @returns: errors and one more, unless they hold it already
 * */
fn withError(errors: [[c8]], error: [c8])-> [[c8]] {
    for e in errors if e == error { return errors; }
    errors ~ [error]
}

/**
 * @returns: a line without the spaces ending it, those starting it kept (the code of an error is indented)
 * */
fn withoutTrailingSpaces(line: [c8])-> [c8] {
    let mut e = line.len;
    while e > 0us && (line[e - 1us] == ' ' || line[e - 1us] == '\t' || line[e - 1us] == '\r') { e -= 1us; }
    line[0us .. e]
}
