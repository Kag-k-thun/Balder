in hulls_panel;

use balder_editor::editor;
use balder::core::application::signal;
use balder::interface;
use balder::interface::widget;
use balder::interface::loader::registry::behaviors;
use balder::interface::widget::button::check;
use balder::interface::widget::text::_;
use balder::math::vector;
use balder::scene::debug;
use balder::scene::node::node3D::mesh_instance;
use balder::scene::node::node3D::visual::primitive;
use balder::scene::physics;
use balder::scene::physics::{convex_decomposition, debug_view};

// The path of the panel of the hulls in the interface of the editor
def HULLS = "BODY/MAIN/INSPECTOR/HULLS";

// The layer of the debug lines of the scene the hulls are drawn in
def HULLS_LAYER = "hulls";

// The colours of the hulls, one after the other, encoded in sRGB
def COLORS = [makeVec4(1.0f, 0.6f, 0.1f, 1.0f), makeVec4(0.3f, 0.75f, 1.0f, 1.0f), makeVec4(0.4f, 0.9f, 0.4f, 1.0f),
              makeVec4(1.0f, 0.4f, 0.7f, 1.0f), makeVec4(1.0f, 0.9f, 0.3f, 1.0f), makeVec4(0.7f, 0.5f, 1.0f, 1.0f),
              makeVec4(0.3f, 0.95f, 0.85f, 1.0f), makeVec4(1.0f, 0.45f, 0.35f, 1.0f)];

/**
 * The panel of the convex hulls of the model selected last, under the panel of its transform, mounted under the
 * behavior 'hulls': the convex decomposition saved next to the model file (see ConvexDecomposition::fileOf), the shape
 * of a body of the hulls of the model (see BodyShape), drawn over the model in the debug lines of the scene, with the
 * settings it was made with
 * @info: the editor does not decompose the models: the export of a project does (BAL-138); a model without hulls saved
 * gives a body the hull of each of its parts (see MeshAsset.hulls)
 * */
#[behavior]
pub class HullsPanel over Behavior {

    // The interface holding the fields
    let dmut _gui: &WidgetManager;

    // The mailbox the slots of the selection are emitted in
    let dmut _box: &SlotEmitter;

    // The editor of the scene, once bound
    let dmut _editor: (&SceneEditor)? = none;

    // The model inspected, the node selected last when it is a model
    let dmut _model: (&MeshInstance3D)? = none;

    // The hulls saved next to the file of the model inspected, none when it has none
    let mut _hulls: (&ConvexDecomposition)? = none;

    // True when the hulls are drawn over the model
    let mut _shown: bool = true;

    // The signal emitted when the hulls are shown or hidden, by the box of the
    // panel or from outside it
    //
    let dmut _shownChanged: &Signal!{bool} = copy Signal!{bool} ();

    /**
     * @params:
     *    - gui: the interface holding the fields
     *    - box: the mailbox the slots of the selection are emitted in
     * */
    pub self (dmut gui: &WidgetManager, dmut box: &SlotEmitter)
        with _gui = alias gui
        , _box = alias box
    {}

    /**
     * Follow the model selected last in the scene of an editor, once the interface is loaded
     * */
    pub fn bind(mut self, dmut editor: &SceneEditor) {
        let dmut scene = alias editor.scene;
        let dmut selection = alias scene.selection;
        selection:.changed():.connect(alias self._box, &self:.onSelectionChanged);
        self._editor = (alias editor)?;

        self:.onSelectionChanged();
    }

    /**
     * @returns: true iff the hulls of the model inspected are drawn over it
     *
     * */
    @field
    pub fn showsHulls(self)-> bool {
        self._shown
    }

    /**
     * Draw the hulls of the model inspected over it, or hide them, the box of
     * the panel following
     *
     * */
    @field
    pub fn showsHulls(mut self, shows: bool) {
        if self._shown == shows {
            return;
        }

        self:.onShown(shows);
        self:.refresh();
    }

    /**
     * @returns: the signal emitted with true when the hulls are shown, false
     * when they are hidden
     *
     * */
    pub fn shownChanged(mut self)-> dmut &Signal!{bool} {
        alias self._shownChanged
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          INSPECTING          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Inspect the node selected last when it is a model: the hulls saved next to its file and their settings
     * */
    fn onSelectionChanged(mut self) {
        let dmut model: (&MeshInstance3D)? = none;
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            let dmut selection = alias scene.selection;
            let dmut nodes = alias selection.nodes;
            if nodes.len != 0us {
                if let dmut m: &MeshInstance3D = alias nodes[$ - 1us] {
                    if m.mesh.primitive == Primitive::NONE { model = (alias m)?; }
                }
            }
        }

        if let Ok(old) = self._model {
            if let Ok(m) = model && m.uid == old.uid { return; }
        }

        self:.inspect(alias model);
    }

    /**
     * Inspect a model, its hulls redrawn each time it moves
     * */
    fn inspect(mut self, dmut model: (&MeshInstance3D)?) {
        if let Ok(dmut old) = alias self._model {
            old:.transformationChanged():.disconnect(&self:.draw);
        }

        self._hulls = none;
        if let Ok(dmut m) = alias model {
            m:.transformationChanged():.connect(alias self._box, &self:.draw);

            // none when the model has no hulls saved, or they cannot be read
            self._hulls = (m.decomposition())?;
        }

        self._model = alias model;
        self:.refresh();
        self:.draw();
    }

    /**
     * Write what the panel knows of the hulls in its fields, without emitting their signals: their number, their
     * vertices and the settings they were made with
     * */
    fn refresh(mut self) {
        if let Ok(dmut c: &CheckBox) = self._gui:.find(HULLS ~ "/SHOWN") {
            c:.setChecked(self._shown);
        }

        let mut state = "No hulls saved: a body takes the hull of each mesh until the project is exported";
        if let Ok(h) = self._hulls {
            let s = h.settings;
            state = f"${h.hulls.len} hulls of ${h.vertexCount} vertices, of a concavity of ${s.concavity * 100.0f}%, ${s.maxHulls} hulls and ${s.maxVertices} vertices at most, ${s.resolution} voxels";
        }

        if let Ok(dmut l: &Label) = self._gui:.find(HULLS ~ "/STATE") {
            l:.setText(state);
        }
    }

    /**
     * Draw the hulls over the model inspected in their layer of the debug lines of the scene, each hull in its colour,
     * or clear the layer when there are none to draw
     * */
    fn draw(mut self) {
        let dmut lines = copy DebugLines();
        if let Ok(m) = self._model && self._shown {
            if let Ok(h) = self._hulls {
                let colors = COLORS;
                for i, hull in h.hulls {
                    debug_view::drawCollider(alias lines, Collider(ColliderShape::hull(hull), m.transformation),
                                             colors[i % colors.len]);
                }
            }
        }

        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            scene:.setDebugLines(HULLS_LAYER, lines.segments);
        }
    }

    #[slot (name-> "shown")]
    fn onShown(mut self, shown: bool) {
        self._shown = shown;
        self:.draw();
        self._shownChanged:.emit(shown);
    }

}
