in manager;

pub mod ::new_project;
mod ::utils;

use balder_editor::{activity, arguments};
use balder_editor::manager::new_project;
use balder_editor::project::{project_template, recent};
use balder::core::{_, application::_};
use balder::game::project;
use balder::interface::dialog;
use balder::interface::widget::{button::push, table::texts, table::view, text::label};
use balder::utils::{log, path};

use std::{fs, io};

use ::sdl3::mouse;

// The templates of the new projects, labelled after their directory in the dropdown of new_project.gui
def TEMPLATES = [
    ("templates/empty", "A ground lit by the sun, a cube and a sphere on it, and an empty library for the actors of the game"),
    ("templates/third_person",
     "A player walking, running and jumping (W, S, A, D, Shift, Space), its camera following it from behind, among crates, stairs and a ramp")
];

// The configuration of the window of the editor, under the directory of the editor
def EDITOR_CONFIG = "editor.toml";

// The paths of the table of the projects and of the actions working on the project selected
def PROJECTS = "BODY/PROJECTS";
def OPEN_ACTION = "BODY/OPEN";
def REMOVE_ACTION = "BODY/REMOVE";

// The class of an action with nothing to do, greyed (see manager.style)
def IDLE = "idle";

/**
 * The project manager of the editor of Balder, its first window, as the one of Godot or the project browser of Unreal:
 * the projects opened last (see RecentProjects), their names, their directories and when they were opened, the one
 * opened last first, and the actions opening one (a double click, Enter or Open), creating one from a template (New
 * project…, see NewProjectDialog), importing one from its directory (Import…), and forgetting one (Remove from the
 * list, its files staying where they are)
 * @info: opening a project makes its directory the one the res:/ paths name (setProjectPath), opens the editor window
 * on it and closes the manager, the editor building and loading the library of its game (see EditorActivity); a
 * project whose directory holds no project.toml any more is listed as missing
 * */
pub class ProjectManagerActivity over Activity {

    // The rows of the table of the projects
    let dmut _model: &TextTableModel = copy TextTableModel(headers-> copy ["Name", "Folder", "Last opened"]);

    // The directories of the projects of the rows, in order
    let mut _directories: [[c8]] = [];

    // The row selected, none when no project is
    let mut _selected: (usize)? = none;

    // The status bar
    let dmut _status: (&Label)? = none;

    // True while a dialog of the manager asks something
    let mut _asking: bool = false;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);

        // the slots the 'on-…' attributes of manager.gui name
        self:.slot("projects::picked", &self:.onPicked);
        self:.slot("projects::reached", &self:.onReached);
        self:.slot("projects::open", &self:.onOpenClicked);
        self:.slot("projects::new", &self:.onNewClicked);
        self:.slot("projects::import", &self:.onImportClicked);
        self:.slot("projects::remove", &self:.onRemoveClicked);
        self:.slot("projects::quit", &self:.onQuitClicked);

        println(self.gui:.loadStyleFile(editorFile("ui/manager.style"))?);
        println(self.gui:.loadGUIFile(editorFile("ui/manager.gui"))?);

        if let Ok(dmut l: &Label) = self.gui:.find("STATUS") {
            self._status = (alias l)?;
        }

        if let Ok(dmut t: &TableView) = self.gui:.find(PROJECTS) {
            t:.setModel(alias self._model);
        }

        self:.refresh();
        self.gui:.setFocus(alias self.gui:.find(PROJECTS));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PROJECTS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onPicked(mut self, rows: [usize]) {
        self._selected = if rows.len == 1us { (rows[0])? } else { none };
        self:.showActions();
    }

    fn onReached(mut self, row: usize) {
        if row < self._directories.len {
            self:.openProject(self._directories[row]);
        }
    }

    fn onOpenClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        if let Ok(row) = self._selected {
            self:.openProject(self._directories[row]);
        } else {
            self:.setStatus("Select a project to open");
        }
    }

    fn onRemoveClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        if let Ok(row) = self._selected {
            let directory = self._directories[row];
            let dmut recent = copy RecentProjects();
            recent:.remove(directory);
            self:.saveRecent(recent);
            self:.refresh();
            self:.setStatus(f"Removed ${directory} from the list, its files staying where they are");
        } else {
            self:.setStatus("Select a project to remove from the list");
        }
    }

    fn onQuitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.onQuit(); }
    }

    fn onQuit(mut self) {
        if !self._asking { self.app:.close(alias self); }
    }

    /**
     * Fill the table with the recent projects, the one opened last first, none selected
     * */
    fn refresh(mut self) {
        let recent = copy RecentProjects();
        let mut rows: [[[c8]]] = [];
        let mut dirs: [[c8]] = [];
        for p in recent.projects {
            rows ~= [copy [utils::nameOf(p.directory), utils::shownDirectory(p.directory), utils::openedText(p.opened)]];
            dirs ~= [p.directory];
        }

        self._directories = dirs;
        self._selected = none;
        self._model:.setRows(rows);
        if let Ok(dmut t: &TableView) = self.gui:.find(PROJECTS) {
            t:.clearSelection();
        }

        self:.showActions();
        if dirs.len == 0us {
            self:.setStatus("No project yet: create one, or import the folder of one");
        }
    }

    /**
     * Grey the actions working on the project selected while none is
     */
    fn showActions(mut self) {
        let classes = if self._selected.hasValue { copy ["action"] } else { copy ["action", IDLE] };
        if let Ok(dmut b: &PushButton) = self.gui:.find(OPEN_ACTION) {
            b:.setClasses(classes ~ ["primary"]);
        }

        if let Ok(dmut b: &PushButton) = self.gui:.find(REMOVE_ACTION) {
            b:.setClasses(classes);
        }
    }

    /**
     * Open the editor on the project of a directory, the manager closing; the status bar tells why it cannot be opened
     * */
    fn openProject(mut self, directory: [c8]) {
        if !Project::isProject(directory) {
            self:.setStatus(f"No project in ${directory}: its ${Project::FILE} is missing");
            return;
        }

        {
            Project::open(directory);
            setProjectPath(Path(directory));
            self.app:.open!{&EditorActivity}(copy BalderConfig(editorFile(EDITOR_CONFIG)));
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to open the project", err);
                self:.setStatus(err.msg);
                return;
            }
        }

        self.app:.close(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DIALOGS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Ask for the name and the location of a new project, proposing the location of the last one created
     */
    fn onNewClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let recent = copy RecentProjects();
        let location = if recent.location.len != 0us { recent.location } else { utils::homeDirectory() };
        let mut templates: [&ProjectTemplate] = [];
        for t in TEMPLATES {
            templates ~= [copy ProjectTemplate(editorFile(t._0), description-> t._1)];
        }

        let dmut d = copy NewProjectDialog(editorFile("ui/new_project.gui"), templates, location);
        d:.answered():.connect(self.box, &self:.onProjectCreated);
        self:.openDialog(alias d);
    }

    /**
     * A project is created: its location is proposed for the next one, and it is opened
     * */
    fn onProjectCreated(mut self, directory: ([c8])?) {
        self._asking = false;
        if let Ok(dir) = directory {
            let dmut recent = copy RecentProjects();
            recent:.setLocation(Path(dir).parent().toStr());
            self:.saveRecent(recent);
            self:.openProject(dir);
        }
    }

    /**
     * Ask for the directory of a project to open, the manager listing it from now on
     */
    fn onImportClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let recent = copy RecentProjects();
        let location = if recent.location.len != 0us { recent.location } else { utils::homeDirectory() };
        let dmut d = copy FileDialog(FileDialogMode::DIRECTORY, directory-> location, title-> "Import a project");
        d:.answered():.connect(self.box, &self:.onImportChosen);
        self:.openDialog(alias d);
    }

    fn onImportChosen(mut self, directory: ([c8])?) {
        self._asking = false;
        if let Ok(dir) = directory {
            self:.openProject(dir);
        }
    }

    /**
     * Open a dialog over the manager, the manager asking something until its answer
     * */
    fn openDialog(mut self, dmut d: &Dialog) {
        {
            d:.open(DialogMode::OVERLAY, alias self.gui);
            self._asking = true;
        } catch {
            err => {
                log::error #("Editor", "Failed to open the dialog", err);
                self:.setStatus("The dialog could not be opened");
            }
        }
    }

    /**
     * Write the recent projects, the status bar telling when they cannot be
     * */
    fn saveRecent(mut self, recent: &RecentProjects) {
        {
            recent.save();
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to save the recent projects", err);
                self:.setStatus(err.msg);
            }
        }
    }

    fn setStatus(mut self, msg: [c8]) {
        if let Ok(dmut status) = alias self._status {
            status:.setText(msg);
        }
    }
}
