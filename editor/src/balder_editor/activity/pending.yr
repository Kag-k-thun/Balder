in pending;

/**
 * What the editor does once the unsaved changes of the documents are saved or discarded (see SceneMenu)
 * */
pub enum Pending : u8
| NOTHING = 0u8
| CLOSE   = 1u8 // close the document asked about
| QUIT    = 2u8 // quit, every document saved or discarded
| MANAGER = 3u8; // go back to the project manager, every document saved or discarded
