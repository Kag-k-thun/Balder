in gizmo_menu;

use balder_editor::activity::editor_context;
use balder_editor::command::{transform, volume};

use balder::core::application::signal;
use balder::interface::loader::registry::behaviors;

use ::sdl3::mouse;

/**
 * The Gizmo menu of the editor, mounted under the behavior 'gizmo': the tool of the gizmo of the viewport (select,
 * translate, rotate, scale), the toolbar over the viewport checking its button; and the drags of the gizmo recorded as
 * commands
 * */
#[behavior]
pub class GizmoMenu over Behavior {

    // What the behaviors of the editor share
    let dmut _ctx: &EditorContext;

    /**
     * @params:
     *    - ctx: what the behaviors of the editor share
     * */
    pub self (dmut ctx: &EditorContext)
        with _ctx = alias ctx
    {}

    /**
     * Follow the drags of the gizmo of the viewport of the context, once the interface is loaded
     * */
    pub fn bind(mut self) {
        if let Ok(dmut v) = alias self._ctx.viewport {
            v:.transformed():.connect(alias self._ctx.box, &self:.onTransformed);
            v:.reshaped():.connect(alias self._ctx.box, &self:.onReshaped);
        }
    }

    #[slot (name-> "select")]
    fn onSelectClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.useTool("SELECT"); }
    }

    #[slot (name-> "translate")]
    fn onTranslateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.useTool("MOVE"); }
    }

    #[slot (name-> "rotate")]
    fn onRotateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.useTool("ROTATE"); }
    }

    #[slot (name-> "scale")]
    fn onScaleClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.useTool("SCALE"); }
    }

    /**
     * Use a tool of the gizmo, the toolbar checking its button
     * */
    fn useTool(mut self, tool: [c8]) {
        if let Ok(dmut b) = alias self._ctx.bars { b:.useTool(tool); }
    }

    /**
     * A drag of the gizmo moved the nodes selected: the change is recorded as a command
     * */
    fn onTransformed(mut self) {
        if let Ok(v) = self._ctx.viewport {
            self._ctx:.run(copy TransformCommand(v.edits, applied-> true));
        }
    }

    /**
     * A drag of a face of a volume, or of the collider of a body, changed its shape: the change is recorded as a command
     * */
    fn onReshaped(mut self) {
        if let Ok(v) = self._ctx.viewport {
            if let Ok(e) = v.volumeEdit {
                self._ctx:.run(copy VolumeCommand(copy [e], applied-> true));
            }
        }
    }
}
