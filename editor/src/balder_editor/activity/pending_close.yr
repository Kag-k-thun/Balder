in pending_close;

use balder_editor::document;
use balder_editor::activity::pending;

/**
 * What waits for the unsaved changes of the documents to be saved or discarded (see SceneMenu): the close of a
 * document, the quitting or the going back to the project manager, every document asked about in turn
 * */
pub class PendingClose {

    // What to do once the unsaved changes are saved or discarded
    pub let mut then: Pending = Pending::NOTHING;

    // The document a close waits for, its unsaved changes saved or discarded
    pub let dmut closing: (&Document)? = none;

    // The documents whose unsaved changes were discarded while quitting, or going back to the project manager
    pub let dmut discarded: [&Document] = [];

    /**
     * Wait for nothing
     * */
    pub self () {}

    /**
     * @returns: true iif the unsaved changes of a document were discarded while quitting, or going back to the project
     * manager
     * */
    pub fn isDiscarded(self, d: &Document)-> bool {
        for x in self.discarded if x is d { return true; }
        false
    }

    /**
     * Wait for nothing any more, a dialog cancelled or a save failed, the unsaved changes kept
     * */
    pub fn cancel(mut self) {
        self.then = Pending::NOTHING;
        self.closing = none;
        self.discarded = [];
    }
}
