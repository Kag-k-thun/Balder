in file_choice;

use balder::utils::path;

use std::fs;

/**
 * A kind of file the editor asks for in a dialog (see EditorContext::choose): the extensions the dialog lists, and the
 * directory it starts from, the one of the file chosen last
 * */
pub class FileChoice {

    // The extensions of the files listed, the first one given to a file to write chosen without it
    pub let extensions: [[c8]];

    // The directory the dialog starts from, the directory of the file chosen last
    pub let mut directory: [c8];

    /**
     * @params:
     *    - extensions: the extensions of the files listed, the first one given to a file to write chosen without it
     *    - under: the directory under the res/ directory of the project the first dialog starts from, res/ itself when
     *             it does not exist
     * */
    pub self (extensions: [[c8]], under: [c8])
        with extensions = extensions
        , directory = projectDirectory(under)
    {}

    /**
     * @returns: a file to write chosen in the dialog, given the first extension when it has another one or none
     * */
    pub fn withExtension(self, path: [c8])-> [c8] {
        if Path(path).extension() == self.extensions[0] { path } else { path ~ "." ~ self.extensions[0] }
    }
}

/**
 * @returns: the absolute path of a directory under the res/ directory of the project, res/ itself when it does not exist
 * */
fn projectDirectory(name: [c8])-> [c8] {
    let dir = ressourcePath().push(name);
    if isDir(dir) { dir.toStr() } else { ressourcePath().toStr() }
}
