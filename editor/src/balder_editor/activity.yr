in activity;

mod ::add_menu;
mod ::edit_menu;
mod ::editor_context;
mod ::file_choice;
mod ::gizmo_menu;
mod ::view_menu;

use balder::core::{_, application::_};
use balder::interface::dialog;
use balder::interface::widget::button::push;
use balder::interface::widget::layout::d3scene;
use balder::interface::widget::tab_bar::{bar, tab_move};
use balder::interface::widget::text::label;
use balder::interface::widget::tree::view;
use balder::math::vector;
use balder::scene::{description::_, editable};
use balder::scene::asset::{assets, material_asset};
use balder::scene::edit::property_edit;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::mesh_instance;
use balder::scene::node::node3D::{camera, transform};
use balder::scene::node::node3D::camera::flight;
use balder::scene::property::value;
use balder::utils::{log, path};

use balder_editor::{arguments, build_error_dialog, connections_panel, dock_rails, document, editor, hulls_panel, inspector_panel, manager, material_document, material_panel, material_preview, material_slots_panel, outline_panel, scene_document, viewport, viewport_bars};
use balder_editor::activity::{add_menu, edit_menu, editor_context, file_choice, gizmo_menu, view_menu};
use balder_editor::command;
use balder_editor::command::{open, property};
use balder_editor::project;
