in activity;

use balder_editor::{arguments, build_error_dialog, command, connections_panel, editor, hulls_panel, inspector_panel, manager, naming, outline_panel, project, viewport};
use balder_editor::command::{add, duplicate, open, projection, remove, transform, volume, wrap};
use balder_editor::project::{game_build, game_library, recent};
use balder::core::{_, application::_};
use balder::interface::dialog;
use balder::interface::widget::{button::menu, button::push, layout::d3scene, layout::linear, text::label, tree::view};
use balder::math::vector;
use balder::scene::{description::_, editable, property::value};
use balder::scene::actors::node_classes;
use balder::scene::asset::mesh_asset;
use balder::scene::gizmo::mode;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{camera, light, marker, path, path_point, volume_shape};
use balder::scene::node::node3D::camera::flight;
use balder::utils::{log, path};

use std::io;
use std::fs;
use std::time;

use ::sdl3::_;

// The configuration of the window of the project manager, under the directory of the editor
def MANAGER_CONFIG = "manager.toml";

// The extension of the scene files
def SCENE_EXTENSION = "scene";

// The paths of the items of the Edit menu undoing and redoing the changes
def UNDO_ITEM = "BAR/EDIT/UNDO";
def REDO_ITEM = "BAR/EDIT/REDO";

// The path of the item of the View menu showing and hiding the icons of the nodes without geometry
def ICONS_ITEM = "BAR/VIEW/ICONS";

// The path of the item of the View menu showing and hiding the grid of the ground
def GRID_ITEM = "BAR/VIEW/GRID";

// The path of the item of the View menu looking through the camera selected, or through the camera of the editor again
def THROUGH_ITEM = "BAR/VIEW/THROUGH";

// The colour seen where nothing is drawn while the scene has no environment, a grey (linear, exposed and tone mapped
// with the scene)
def BACKGROUND = makeVec3(0.07f, 0.07f, 0.075f);

// The path of the Add menu, opened under the cursor by Ctrl+E
def ADD_MENU = "BAR/ADD";

// The path of the group of the Add menu holding the submenus of the categories of the actor classes
def ACTORS_GROUP = "BAR/ADD/ACTORS";

// The class of an item of a menu with nothing to do, greyed (see editor.style)
def IDLE = "idle";

// The path of the button of the menu bar building the library of the game again and loading it
def COMPILE_BUTTON = "BAR/COMPILE";

// The dialog telling why the build of the library of the game failed, under the directory of the editor
def BUILD_ERROR_DIALOG = "ui/build_error.gui";

// How often the status bar tells how far the build of the library of the game is, in milliseconds
def BUILD_REFRESH = 250u64;

/**
 * What the editor does once the unsaved changes of the scene are saved or discarded
 * */
enum Pending : u8
| NOTHING = 0u8
| NEW     = 1u8
| OPEN    = 2u8
| QUIT    = 3u8
| MANAGER = 4u8;


/**
 * The editor of Balder: the outline of the scene on the left, the viewport in the middle, the inspector of the node
 * selected on the right, under a menu bar opening, saving, adding, copying and removing nodes, above a status bar
 * @info:
 * =====
 * The editor edits a project (see Project), the one of the project path (getProjectPath), opened by the project
 * manager or by '--project': it starts on the scene of the project edited last, or on its main scene, or on a new
 * scene. A scene saved under the res/ directory of the project joins its scenes, named after its file, and the path of
 * a scene or a model under it is written res:/…, the project moving with its files. Scene → Back to the project
 * manager closes the editor for the manager.
 * ====
 * @info:
 * =====
 * The library of the game of the project (the shared target of its gyllir.toml, see GameBuild) is loaded in the editor
 * (see GameLibrary), the #[actor] tags of its classes registering them: the Add menu lists them, the inspector edits
 * their nodes and the scene files build them. A library newer than its sources is loaded before the first scene is
 * opened; otherwise it is built in the background, the status bar telling how far, then loaded, the scene rebuilt with
 * its classes. Compile (the button on the right of the menu bar, or Ctrl+R) builds it again and reloads it, a change of
 * the code of an actor taken without leaving the editor: the scene is described as its file would save it, its nodes
 * dropped, the library closed (its classes unregistered) and opened again, then the scene is built again from its
 * description with the classes of the new library, read leniently (an entry, a signal or a connection its class no
 * longer declares dropped and logged, an actor of a class gone kept as an unknown one); its history starts again, its
 * unsaved changes staying unsaved. A build that fails tells its first error in the status bar and in a dialog
 * (BuildErrorDialog), the library loaded staying; a library that cannot be loaded leaves the actors unknown. Going
 * back to the project manager closes the library.
 * ====
 * @info:
 * =====
 * Every change of the scene is a command run through the SceneEditor, which keeps their history; the viewport, focused
 * by a click, takes the keys W, E and R (the gizmo), Delete, Ctrl+D and F, the window Ctrl+Z (undo), Ctrl+Shift+Z and
 * Ctrl+Y (redo), Ctrl+S (save), Ctrl+Shift+S (save as) and Ctrl+E (the Add menu, under the cursor). The items Undo and Redo of the Edit menu name the change they
 * undo or redo. View → Look through the camera selected draws the viewport through a camera of the scene, its moves
 * recorded as commands, until View → Look through the editor camera, or until the camera leaves the scene.
 * The scene has unsaved changes while its history is not where it was at the last save (a change made, or undone),
 * shown in the title of the window and on the right of the status bar. A new scene, blank, has no file yet: its first
 * save asks for one. New, Open and Quit ask whether to save the changes first, or discard them, or do nothing.
 * ====
 * */
pub class EditorActivity over Activity {

    // The project edited, once read
    let dmut _project: (&Project)? = none;

    // The editor of the scene, once the interface is loaded
    let dmut _editor: (&SceneEditor)? = none;

    // The viewport of the scene, once the interface is loaded
    let dmut _viewport: (&EditorViewport)? = none;

    // The status bar
    let dmut _status: (&Label)? = none;

    // The label telling the file of the scene and whether it has unsaved changes
    let dmut _document: (&Label)? = none;

    // The label telling the step of the grid of the ground
    let dmut _gridLabel: (&Label)? = none;

    // The directory of the scene file chosen last, the dialogs of the scenes starting from it
    let mut _directory: [c8] = "";

    // The directory of the model chosen last, the dialog adding a model starting from it, empty before the first one
    let mut _modelDirectory: [c8] = "";

    // The file of the scene, where it is saved, empty for a new scene; res:/… under the res/ directory of the project
    let mut _path: [c8] = "";

    // The speeds of the flights of the viewport in the scene files opened, by their path, each scene flown at its own
    let dmut _flightPaces: [[c8] => f32] = copy [];

    // What to do once the unsaved changes are saved or discarded
    let mut _pending: Pending = Pending::NOTHING;

    // True while a dialog of the editor asks something, the keys saving the scene and the quitting waiting for its
    // answer
    let mut _asking: bool = false;

    // The build of the library of the game of the project, none for a project declaring no shared target
    let dmut _build: (&GameBuild)? = none;

    // Why the project has no library to build, told when it is asked to compile, empty for a project with one
    let mut _noLibrary: [c8] = "";

    // The time since the status bar told how far the build of the library is
    let mut _sinceRefresh: u64 = 0u64;

    // What the status bar tells once the changes the editor made itself are told (see notify), empty for nothing, and
    // true until the update after the one it was given at
    let mut _notice: [c8] = "";
    let mut _noticeWaits: bool = false;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);
        self.input:.keyPressed():.connect(self.box, &self:.onKey);
        self._directory = projectDirectory("scenes");

        // the slots the 'on-…' attributes of editor.gui name: the menus, the outline and the inspector
        self:.slot("scene::new", &self:.onNewClicked);
        self:.slot("scene::open", &self:.onOpenClicked);
        self:.slot("scene::save", &self:.onSaveClicked);
        self:.slot("scene::save-as", &self:.onSaveAsClicked);
        self:.slot("scene::manager", &self:.onManagerClicked);
        self:.slot("scene::quit", &self:.onQuitClicked);
        self:.slot("add::cube", &self:.onAddCube);
        self:.slot("add::sphere", &self:.onAddSphere);
        self:.slot("add::plane", &self:.onAddPlane);
        self:.slot("add::model", &self:.onAddModel);
        self:.slot("add::empty", &self:.onAddEmpty);
        self:.slot("add::marker", &self:.onAddMarker);
        self:.slot("add::spawn", &self:.onAddSpawnPoint);
        self:.slot("add::waypoint", &self:.onAddWaypoint);
        self:.slot("add::socket", &self:.onAddSocket);
        self:.slot("add::path", &self:.onAddPath);
        self:.slot("add::path-point", &self:.onAddPathPoint);
        self:.slot("add::box-volume", &self:.onAddBoxVolume);
        self:.slot("add::sphere-volume", &self:.onAddSphereVolume);
        self:.slot("add::capsule-volume", &self:.onAddCapsuleVolume);
        self:.slot("add::body", &self:.onAddBody);
        self:.slot("add::character", &self:.onAddCharacter);
        self:.slot("add::wrap", &self:.onWrapClicked);
        self:.slot("add::direction", &self:.onAddDirectionLight);
        self:.slot("add::point", &self:.onAddPointLight);
        self:.slot("add::spot", &self:.onAddSpotLight);
        self:.slot("add::perspective", &self:.onAddPerspectiveCamera);
        self:.slot("add::orthographic", &self:.onAddOrthographicCamera);
        self:.slot("add::actor", &self:.onAddActor);
        self:.slot("edit::undo", &self:.onUndoClicked);
        self:.slot("edit::redo", &self:.onRedoClicked);
        self:.slot("edit::duplicate", &self:.onDuplicateClicked);
        self:.slot("edit::delete", &self:.onDeleteClicked);
        self:.slot("edit::frame", &self:.onFrameClicked);
        self:.slot("view::icons", &self:.onIconsClicked);
        self:.slot("view::grid", &self:.onGridClicked);
        self:.slot("view::through", &self:.onThroughClicked);
        self:.slot("gizmo::translate", &self:.onTranslateClicked);
        self:.slot("gizmo::rotate", &self:.onRotateClicked);
        self:.slot("gizmo::scale", &self:.onScaleClicked);
        self:.slot("game::compile", &self:.onCompileClicked);

        let dmut outline = copy OutlinePanel(&self:.setStatus);
        self:.behavior("outline", alias outline);
        let dmut inspector = copy InspectorPanel(alias self.gui, alias self.box, &self:.setStatus);
        self:.behavior("inspector", alias inspector);
        let dmut hulls = copy HullsPanel(alias self.gui, alias self.box);
        self:.behavior("hulls", alias hulls);
        let dmut links = copy ConnectionsPanel(alias self.gui, alias self.box, &self:.setStatus);
        self:.behavior("connections", alias links);

        self.gui:.getRegistry():.register(EditorViewport::schema());
        println(self.gui:.loadStyleFile(editorFile("ui/editor.style"))?);
        println(self.gui:.loadGUIFile(editorFile("ui/editor.gui"))?);

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/FOOT/STATUS") {
            self._status = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/FOOT/DOCUMENT") {
            self._document = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/FOOT/GRID") {
            self._gridLabel = (alias l)?;
        }

        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("BODY/MAIN/VIEW") {
            if let Ok(dmut s: &EditableScene) = alias w:.getScene() {
                s.background = BACKGROUND;
                let dmut e = copy SceneEditor(alias s);
                e:.edited():.connect(self.box, &self:.onEdited);
                self._editor = (alias e)?;
            }
        }

        if let Ok(dmut v: &EditorViewport) = self.gui:.find("BODY/MAIN/VIEW/GIZMO") {
            v:.keyPressed():.connect(self.box, &self:.onViewportKey);
            v:.transformed():.connect(self.box, &self:.onGizmoTransformed);
            v:.reshaped():.connect(self.box, &self:.onGizmoReshaped);
            v:.gridStepped():.connect(self.box, &self:.onGridStepped);
            v:.piloted():.connect(self.box, &self:.onPiloted);
            if let Ok(step) = v.gridStep { self:.onGridStepped(step); }
            self._viewport = (alias v)?;
        }

        if let Ok(dmut e) = alias self._editor {
            if let Ok(dmut t: &TreeView) = self.gui:.find("BODY/MAIN/OUTLINE/TREE") {
                if let Ok(dmut v) = alias self._viewport {
                    outline:.bind(alias t, alias e, alias v, alias self.box);
                }
            }

            inspector:.bind(alias e);
            hulls:.bind(alias e);
            links:.bind(alias e);
        } else {
            log::error #("Editor", "The viewport of the editor has no editable scene");
            return;
        }

        self:.openProject();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PROJECT          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read the project of the project path, put it first in the recent projects, load the library of its game when it
     * is newer than its sources, and open its first scene: the one of the command line, or the scene edited last, or
     * the main scene, or a new scene; the library is built afterwards when it is not up to date
     * */
    fn openProject(mut self) {
        let directory = getProjectPath().toStr();
        {
            let dmut project = copy Project::open(directory);
            self._project = (alias project)?;
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to read the project", err);
                self:.setStatus(err.msg);
            }
        }

        let dmut recent = copy RecentProjects();
        recent:.opened(directory);
        self:.saveRecent(recent);

        let (notice, toBuild) = self:.findLibrary(directory);
        let scene = self.firstScene(recent.sceneOf(directory));
        if scene.len == 0us {
            self:.newScene();
        } else {
            self:.openScene(scene);
        }

        if notice.len != 0us { self:.notify(notice); }
        if toBuild { self:.compile(); }
        self:.showCompile();
    }

    /**
     * @returns: the scene the editor starts on, empty for a new scene: the one of the command line, or the scene of the
     * project edited last, or its main scene, the first one whose file exists
     * @params:
     *    - edited: the scene of the project edited last, empty when none was
     * */
    fn firstScene(self, edited: [c8])-> [c8] {
        let given = startScene();
        if given.len != 0us { return given; }

        let mut candidates: [[c8]] = copy [edited];
        if let Ok(p) = self._project {
            if let Ok(main) = p.mainScenePath() { candidates ~= [main]; }
        }

        for s in candidates if s.len != 0us && isFile(projectPath(s)) {
            return s;
        }

        ""
    }

    /**
     * Keep the scene of the project edited last, the one the editor starts on next time
     * */
    fn keepEdited(mut self, path: [c8]) {
        if path.len == 0us { return; }

        let dmut recent = copy RecentProjects();
        recent:.edited(getProjectPath().toStr(), path);
        self:.saveRecent(recent);
    }

    /**
     * Put a scene saved in the scenes of the project, when it is under its res/ directory
     * @returns: the name of the scene in the project, none when it is not under its res/ directory
     * */
    fn addToProject(mut self, path: [c8])-> ([c8])? {
        if !CustomPathQualifiers::RESSOURCES.isPrefix(Path(path)) { return none; }

        if let Ok(dmut p) = alias self._project {
            if let Ok(name) = p.sceneNamed(path) { return name?; }

            let name = p:.addScene(path);
            {
                p.save();
            } catch {
                err: &BalderError => {
                    log::error #("Editor", "Failed to save the project", err);
                    self:.setStatus(err.msg);
                }
            }

            return name?;
        }

        none
    }

    /**
     * Write the recent projects, logging why they cannot be
     * */
    fn saveRecent(mut self, recent: &RecentProjects) {
        {
            recent.save();
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to save the recent projects", err);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          LIBRARY          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the library of the game of the project, the library of another project closed: loaded right away when it is
     * newer than its sources, so that the first scene is built with its classes
     * @returns: what the status bar tells once the first scene is open, empty for nothing, and true iif the library is
     * to be built
     * */
    fn findLibrary(mut self, directory: [c8])-> ([c8], bool) {
        GameLibrary::unload();
        self:.listActorClasses();
        if !GameBuild::has(directory) {
            if GameBuild::hasEditor(directory) {
                // a project of the template of BAL-128, its editor target linking the library of its game
                self._noLibrary = "The library of the project is not a shared one, its actors staying unknown: give its target type = \"shared\" and host-provided = [\"Balder\"], and remove its target 'editor' (see doc/actors.md)";
                log::warn #("Editor", self._noLibrary);
                return (self._noLibrary, false);
            }

            self._noLibrary = "The project has no library to compile: its gyllir.toml declares no target of type \"shared\"";
            return ("", false);
        }

        {
            let dmut b = copy GameBuild(directory);
            self._build = (alias b)?;
            if b.isUpToDate() {
                return (self:.loadLibrary(b.library), false);
            }

            return ("", true);
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to read the library of the game", err);
                self._noLibrary = err.msg;
                return (err.msg, false);
            }
        }
    }

    /**
     * Load the library of the game, in place of the one loaded, and list its actor classes in the Add menu
     * @returns: what the status bar tells, the classes loaded or why the library could not be
     * */
    fn loadLibrary(mut self, path: [c8])-> [c8] {
        let mut res = "";
        {
            let l = GameLibrary::load(path);
            res = f"Loaded the library of ${self.projectName()}, ${l.classes.len} actor classes";
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to load the library of the game", err);
                res = f"${err.msg}: its actors stay unknown";
            }
        }

        self:.listActorClasses();
        res
    }

    fn onCompileClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.compile(); }
    }

    /**
     * Build the library of the game again, in the background, the status bar telling how far (see onUpdate), then load
     * it (see reload)
     * */
    fn compile(mut self) {
        let dmut b = if let Ok(dmut b) = alias self._build { alias b } else {
            self:.setStatus(self._noLibrary);
            return;
        };

        if b:.isRunning() {
            self:.setStatus(f"The library of ${self.projectName()} is being built");
            return;
        }

        {
            b:.build();
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to build the library of the game", err);
                self:.setStatus(err.msg);
                return;
            }
        }

        self._sinceRefresh = 0u64;
        self:.setStatus(f"Building the library of ${self.projectName()}…");
        self:.showCompile();
    }

    /**
     * Tell how far the build of the library is in the status bar, then load the library once it is built
     * */
    over onUpdate(mut self, delta: Duration) {
        if self._notice.len != 0us {
            if self._noticeWaits {
                self._noticeWaits = false;
            } else {
                self:.setStatus(self._notice);
                self._notice = "";
            }
        }

        let mut code: (i32)? = none;
        let mut status = "";
        if let Ok(dmut b) = alias self._build {
            code = b:.finished();
            self._sinceRefresh += delta.allMillis;
            if !code.hasValue && self._sinceRefresh >= BUILD_REFRESH && b:.isRunning() {
                self._sinceRefresh = 0u64;
                let progress = b:.progress();
                status = f"Building the library of ${self.projectName()}: ${cast!u32(progress.done * 100.0f)}% — ${progress.step}";
            }
        }

        if status.len != 0us { self:.setStatus(status); }
        if let Ok(c) = code { self:.onBuilt(c); }
    }

    /**
     * The library of the game is built, or failed to: it is loaded, the scene rebuilt with its classes, or the status
     * bar tells the first error of the build, and a dialog shows it as the compiler wrote it, the library loaded staying
     * @params:
     *    - code: the exit code of the build
     * */
    fn onBuilt(mut self, code: i32) {
        self:.showCompile();
        if code == 127 {
            self:.setStatus(f"The library of ${self.projectName()} could not be built: gyllir is not found");
        } else if code != 0 {
            self:.onBuildFailed();
        } else {
            self:.reload();
        }
    }

    /**
     * The library of the game did not build: the status bar tells its first error, and a dialog shows it as the
     * compiler wrote it, with the buttons opening the file of all the errors and the whole output of the build
     * */
    fn onBuildFailed(mut self) {
        let b = if let Ok(b) = self._build { b } else { return; };
        let name = self.projectName();
        let errors = b.errors();
        let first = if errors.len != 0us { errors[0] } else { "" };
        let summary = GameBuild::summary(first);
        log::error #("Editor", f"The library of ${name} did not build, see ${b.log}: ${summary}");
        self:.setStatus(if summary.len != 0us { f"The library of ${name} did not build: ${summary}" }
                        else { f"The library of ${name} did not build, see ${b.log}" });

        let mut file = "";
        {
            file = b.writeErrors(errors);
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to write the errors of the build", err);
            }
        }

        // it answers nothing: the editor is not asking while it is open, its overlay taking the clicks
        {
            let dmut d = copy BuildErrorDialog(editorFile(BUILD_ERROR_DIALOG), name, first, file, b.log);
            d:.open(DialogMode::OVERLAY, alias self.gui);
        } catch {
            err => {
                log::error #("Editor", "Failed to open the dialog of the errors of the build", err);
            }
        }
    }

    /**
     * Load the library of the game built, in place of the one loaded, the scene rebuilt with its classes: described as
     * its file would save it, its nodes dropped (with the history naming them) before the library loaded is closed,
     * then built again from its description, read leniently, once the library is loaded; its unsaved changes stay
     * unsaved, and so does a scene that lost what the classes no longer declare
     * */
    fn reload(mut self) {
        let library = if let Ok(b) = self._build { b.library } else { return; };
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };

        let mut content = "";
        {
            let dmut scene = alias e.scene;
            content = copy SceneDescription(alias scene:.getRootNode()).content();
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to describe the scene to reload the library of the game", err);
                self:.setStatus(f"The library was not reloaded: ${err.msg}");
                return;
            }
        }

        let unsaved = e.unsaved;
        let name = self.documentName();
        self:.dropNodes();
        let mut status = self:.loadLibrary(library);
        {
            let description = copy SceneDescription(content, file-> name, lenient-> true);
            for d in description.dropped {
                log::warn #("Editor", f"Reloading the library of the game: ${d}, dropped");
            }

            self:.run(copy OpenCommand(description, name));
            if unsaved || description.dropped.len != 0us { e:.markUnsaved(); }
            if description.dropped.len != 0us {
                status ~= f"; ${description.dropped.len} entries of the scene its classes no longer declare dropped (see the log)";
            }
        } catch {
            err: &BalderError => {
                // never the case of a scene this Balder wrote: kept where it can be read again
                log::error #("Editor", "Failed to build the scene again with the library of the game", err);
                let kept = self.keepContent(content);
                e:.markUnsaved();
                status = f"The scene could not be built again (${err.msg}), kept in ${kept}";
            }
        }

        self:.showDocument();
        self:.showHistory();
        self:.notify(status);
    }

    /**
     * Drop the nodes of the scene, the history naming them dropped with them, so that no node of a class of the library
     * of the game outlives it
     * */
    fn dropNodes(mut self) {
        let nodes: [NodeDescription] = [];
        self:.run(copy OpenCommand(copy SceneDescription(nodes), self.documentName()));
    }

    /**
     * Write the content of a scene in the build cache of the project, the scene a reload could not build again
     * @returns: the path of the file, or why it could not be written
     * */
    fn keepContent(self, content: [c8])-> [c8] {
        let file = getProjectPath().push(".target").push("reloaded.scene");
        {
            if !isDir(file.parent()) { createDir(file.parent(), recursive-> true); }
            let dmut f = File::create(file, write-> true);
            f:.write(content);
            f:.close();
            file.toStr()
        } catch {
            err: &FsError => { f"no file (${err})" }
        }
    }

    /**
     * Grey Compile while the library is being built, or when the project has none
     * */
    fn showCompile(mut self) {
        let running = if let Ok(dmut b) = alias self._build { b:.isRunning() } else { false };
        let idle = running || !self._build.hasValue;
        if let Ok(dmut button: &PushButton) = self.gui:.find(COMPILE_BUTTON) {
            button:.setClasses(if idle { copy ["compile", IDLE] } else { copy ["compile"] });
            button:.setText(if running { "Compiling…" } else { "Compile (Ctrl+R)" });
        }
    }

    /**
     * @returns: the name of the project, for the status bar
     * */
    fn projectName(self)-> [c8] {
        if let Ok(p) = self._project { p.name } else { "the project" }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SCENE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onNewClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::NEW); }
    }

    fn onOpenClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::OPEN); }
    }

    fn onSaveClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.save(); }
    }

    fn onSaveAsClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.saveAs(); }
    }

    fn onQuitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::QUIT); }
    }

    fn onManagerClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::MANAGER); }
    }

    /**
     * The window is closed
     * */
    fn onQuit(mut self) {
        if !self._asking { self:.ask(Pending::QUIT); }
    }

    /**
     * The keys of the window: Ctrl+Z undoes the last change, Ctrl+Shift+Z and Ctrl+Y redo it, Ctrl+S saves the scene,
     * Ctrl+Shift+S saves it in another file, Ctrl+E opens the Add menu under the cursor, Ctrl+R compiles the library of
     * the game and loads it
     * */
    fn onKey(mut self, key: SDL_Keycode, mods: SDL_Keymod) {
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        if !ctrl || self._asking { return; }

        let shift = (mods & SDL_KMOD_SHIFT) != 0u16;
        if (key == SDLK_Z && shift) || key == SDLK_Y {
            self:.redo();
        } else if key == SDLK_Z {
            self:.undo();
        } else if key == SDLK_S && shift {
            self:.saveAs();
        } else if key == SDLK_S {
            self:.save();
        } else if key == SDLK_E && !shift {
            self:.openAddMenu();
        } else if key == SDLK_R && !shift {
            self:.compile();
        }
    }

    /**
     * Replace the nodes of the scene by none, a new scene starting blank, saved in a file of its own
     * */
    fn newScene(mut self) {
        let nodes: [NodeDescription] = [];
        if self:.run(copy OpenCommand(copy SceneDescription(nodes), "a new scene")) {
            self:.keepFlightPace("");
            self._path = "";
        }
    }

    /**
     * Replace the nodes of the scene by those of a scene file
     * */
    fn openScene(mut self, path: [c8]) {
        {
            let description = copy SceneDescription::fromFile(path);
            if self:.run(copy OpenCommand(description, Path(path).file())) {
                let opened = qualifiedPath(path);
                self:.keepFlightPace(opened);
                self._path = opened;
                self:.keepEdited(opened);
            }
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to open the scene", err);
                self:.setStatus(err.msg);
            }
        }
    }

    /**
     * Keep the speed of the flights of the viewport in the scene left, and fly the scene opened at the speed it was
     * flown at, a scene not opened yet (or a new one) at the speed of a flight
     * @params:
     *    - opened: the path of the scene opened, empty for a new scene
     * */
    fn keepFlightPace(mut self, opened: [c8]) {
        if let Ok(dmut v) = alias self._viewport {
            if self._path.len != 0us {
                self._flightPaces[self._path] = v.flightPace;
            }

            v.flightPace = if let Ok(p) = self._flightPaces[opened] { p } else { CameraFlight().pace };
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SAVE          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Do something that drops the scene (open a new scene, open a scene file, quit), asking first whether to save its
     * unsaved changes, discard them or do nothing
     * */
    fn ask(mut self, then: Pending) {
        if !self.unsaved() {
            self:.proceed(then);
            return;
        }

        self._pending = then;
        let question = match then {
            Pending::NEW  => { "before starting a new scene?" }
            Pending::OPEN => { "before opening another scene?" }
            Pending::MANAGER => { "before going back to the project manager?" }
            _             => { "before quitting?" }
        };

        let dmut d = copy MessageDialog(f"Save the changes to ${self.documentName()} ${question}", title-> "Unsaved changes",
                                        yes-> "Save", no-> "Discard", cancel-> "Cancel");
        d:.answered():.connect(self.box, &self:.onUnsavedAnswered);
        self:.openDialog(alias d);
    }

    /**
     * The unsaved changes are saved (the pending action following the save), discarded, or kept, nothing done
     * */
    fn onUnsavedAnswered(mut self, status: MessageDialogStatus) {
        self._asking = false;
        match status {
            MessageDialogStatus::YES => { self:.save(); }
            MessageDialogStatus::NO  => { self:.proceed(self._pending); }
            _ => {
                self._pending = Pending::NOTHING;
                self:.setStatus("Kept the unsaved changes");
            }
        }
    }

    /**
     * Do what was waiting for the unsaved changes to be saved or discarded
     * */
    fn proceed(mut self, then: Pending) {
        self._pending = Pending::NOTHING;
        match then {
            Pending::NEW  => { self:.newScene(); }
            Pending::OPEN => { self:.chooseScene(); }
            Pending::QUIT => { self.app:.close(alias self); }
            Pending::MANAGER => { self:.openManager(); }
            _ => {}
        }
    }

    /**
     * Open the project manager, the editor closing, its nodes dropped and the library of the game closed; not while the
     * library is being built, the build going on
     * */
    fn openManager(mut self) {
        if let Ok(dmut b) = alias self._build && b:.isRunning() {
            self:.setStatus(f"The library of ${self.projectName()} is being built: back to the project manager once it is");
            return;
        }

        self:.dropNodes();
        GameLibrary::unload();
        {
            self.app:.open!{&ProjectManagerActivity}(copy BalderConfig(editorFile(MANAGER_CONFIG)));
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to open the project manager", err);
                self:.setStatus(err.msg);
                return;
            }
        }

        self.app:.close(alias self);
    }

    /**
     * Ask for the scene file to open
     * */
    fn chooseScene(mut self) {
        let dmut d = copy FileDialog(FileDialogMode::OPEN, directory-> self._directory, filters-> sceneExtensions(),
                                     title-> "Open a scene");
        d:.answered():.connect(self.box, &self:.onSceneChosen);
        self:.openDialog(alias d);
    }

    fn onSceneChosen(mut self, path: ([c8])?) {
        self._asking = false;
        if let Ok(p) = path {
            self._directory = Path(p).parent().toStr();
            self:.openScene(qualifiedPath(p));
        }
    }

    /**
     * Save the scene in its file, asking for one when it has none, then do what was waiting for the save
     * */
    fn save(mut self) {
        if self._path.len == 0us {
            self:.saveAs();
        } else if self:.write(self._path) {
            self:.proceed(self._pending);
        }
    }

    /**
     * Ask for the file to save the scene in, then save it there
     * */
    fn saveAs(mut self) {
        let name = if self._path.len == 0us { "scene." ~ SCENE_EXTENSION } else { Path(self._path).file() };
        let dmut d = copy FileDialog(FileDialogMode::SAVE, directory-> self._directory, filters-> sceneExtensions(),
                                     title-> "Save the scene", name-> name);
        d:.answered():.connect(self.box, &self:.onSaveChosen);
        self:.openDialog(alias d);
    }

    /**
     * The file to save the scene in is chosen, given the extension of the scene files when it has none, or the save is
     * cancelled, and with it what was waiting for it
     * */
    fn onSaveChosen(mut self, path: ([c8])?) {
        self._asking = false;
        if let Ok(chosen) = path {
            let p = if Path(chosen).extension() == SCENE_EXTENSION { chosen } else { chosen ~ "." ~ SCENE_EXTENSION };
            self._directory = Path(p).parent().toStr();
            if self:.write(qualifiedPath(p)) {
                self:.proceed(self._pending);
            }
        } else {
            self._pending = Pending::NOTHING;
        }
    }

    /**
     * Write the scene in a file, which becomes its file
     * @returns: true iif the file is written, the status bar telling why it is not
     * */
    fn write(mut self, path: [c8])-> bool {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return false; };
        {
            let dmut scene = alias e.scene;
            let description = copy SceneDescription(alias scene:.getRootNode());
            description.save(path);
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to save the scene", err);
                self:.setStatus(err.msg);
                self._pending = Pending::NOTHING;
                return false;
            }
        }

        self._path = path;
        e:.markSaved();
        self:.keepEdited(path);
        self:.showDocument();

        let file = Path(path).file();
        if let Ok(name) = self:.addToProject(path) {
            self:.setStatus(f"Saved ${file}, the scene '${name}' of the project");
        } else {
            self:.setStatus(f"Saved ${file}, outside the res/ folder of the project: not one of its scenes");
        }

        true
    }

    /**
     * Show the file of the scene and whether it has unsaved changes, in the title of the window and on the right of the
     * status bar
     * */
    fn showDocument(mut self) {
        let unsaved = self.unsaved();
        let name = self.documentName();
        let mark = if unsaved { "*" } else { "" };
        let project = if let Ok(p) = self._project { p.name } else { "no project" };
        self.window:.setName(f"${name}${mark} - ${project} - Balder editor");

        if let Ok(dmut l) = alias self._document {
            let file = if self._path.len == 0us { "New scene, not saved yet" } else { self._path };
            l:.setText(if unsaved { file ~ " — unsaved changes" } else { file });
        }
    }

    /**
     * @returns: true iif the scene has changes not saved, its history not being where it was at the last save
     * */
    fn unsaved(self)-> bool {
        if let Ok(e) = self._editor { e.unsaved } else { false }
    }

    /**
     * @returns: the name of the scene, the name of its file, or 'the new scene'
     * */
    fn documentName(self)-> [c8] {
        if self._path.len == 0us { "the new scene" } else { Path(self._path).file() }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          ADD          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Open the Add menu under the cursor, the menus open closed
     * */
    fn openAddMenu(mut self) {
        if let Ok(dmut menu: &MenuButton) = self.gui:.find(ADD_MENU) {
            let at = self.gui.getMousePosition();
            menu:.openMenuAt(at.x, at.y);
        }
    }

    /**
     * List the actor classes the program registers in the Add menu, in place of those listed: a submenu per category in
     * the order of their first class, the classes of a category in the order of their registration; the Add menu has
     * none of them when the program registers no actor class (no library of a game loaded)
     * */
    fn listActorClasses(mut self) {
        let classes = actorClasses();
        let mut categories: [[c8]] = [];
        for c in classes {
            let mut known = false;
            for k in categories if k == c.category { known = true; }
            if !known { categories ~= [c.category]; }
        }

        self.gui:.holdLayout();
        {
            if let Ok(dmut group: &LinearLayout) = alias self.gui:.find(ACTORS_GROUP) {
                group:.removeChilds();
                group:.setClasses(if categories.len == 0us { copy ["actors", "absent"] } else { copy ["actors"] });
            }

            for i, category in categories {
                let id = f"C${i}";
                self.gui:.instantiate("ActorCategory", category ~ " ▸", parent-> ACTORS_GROUP, id-> id);
                for j, c in classes if c.category == category {
                    self.gui:.instantiate("ActorItem", c.label, parent-> ACTORS_GROUP ~ "/" ~ id ~ "/LIST", id-> f"A${j}",
                                          attributes-> f"on-click: add::actor(${WidgetManager::quoted(c.name)});");
                }
            }
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to list the actor classes in the Add menu", err);
            }
        }

        self.gui:.releaseLayout();
    }

    /**
     * Add a node of an actor class, its properties holding their defaults
     * @params:
     *    - className: the type of the class in the scene files
     * */
    fn onAddActor(mut self, className: [c8], b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.add(NodeDescription::actor(className, className), lift-> 0.0f);
        }
    }

    fn onAddCube(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addPrimitive("cube", MeshAsset::CUBE); }
    }

    fn onAddSphere(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addPrimitive("sphere", MeshAsset::SPHERE); }
    }

    fn onAddPlane(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addPrimitive("plane", MeshAsset::PLANE); }
    }

    fn onAddEmpty(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.add(NodeDescription("empty", NodeKind::EMPTY), lift-> 0.0f);
        }
    }

    fn onAddMarker(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("marker", "generic"); }
    }

    fn onAddSpawnPoint(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("spawn", "spawn"); }
    }

    fn onAddWaypoint(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("waypoint", "waypoint"); }
    }

    fn onAddSocket(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("socket", "socket"); }
    }

    /**
     * Add a path of three points, a curve from the left to the right bending away from the eye
     * */
    fn onAddPath(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut path = NodeDescription("path", NodeKind::PATH);
        let places = [makeVec3(-2.0f, 0.0f, 0.0f), makeVec3(0.0f, 0.0f, -1.5f), makeVec3(2.0f, 0.0f, 0.0f)];
        for i, at in places {
            let mut point = NodeDescription(if i == 0us { "point" } else { f"point_${i + 1us}" }, NodeKind::PATH_POINT);
            point:.set("position", PropertyValue::vector(at));
            path.children ~= [point];
        }

        self:.add(path, lift-> 0.5f);
    }

    /**
     * Insert a point in the path selected after its last point, or in the path of the point selected right after it
     * (see insertedPoint), the status bar telling when no path is selected
     * */
    fn onAddPathPoint(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut nodes = alias self:.selectedNodes();
        if nodes.len != 0us {
            let dmut last = alias nodes[$ - 1us];
            if let dmut p: &Path3D = alias last {
                self:.insertPoint(alias p, none);
                return;
            }

            if let dmut point: &PathPoint3D = alias last {
                if let Ok(dmut parent) = alias point:.getParent() {
                    if let dmut p: &Path3D = alias parent {
                        self:.insertPoint(alias p, point.index?);
                        return;
                    }
                }
            }
        }

        self:.setStatus("Select a path, or a point of a path, to insert a point in it");
    }

    /**
     * Insert a point in a path after one of its points, halfway to the next one, or a step past the last one
     * @params:
     *    - after: the place among the children of the path of the point the new one follows, none for its last point
     * */
    fn insertPoint(mut self, dmut path: &Path3D, after: (usize)?) {
        let points = path.points();
        let mut i = if points.len == 0us { 0us } else { points.len - 1us };
        if let Ok(a) = after {
            for k, p in points if p.index == a { i = k; }
        }

        let mut d = NodeDescription("point", NodeKind::PATH_POINT);
        let mut at = LAST_PLACE;
        if points.len != 0us {
            let from = points[i];
            d:.set("position", PropertyValue::vector(insertedPoint(points, i, path.closed)));
            d:.set("rotation", PropertyValue::vector(from.rotation));
            d:.set("scale", PropertyValue::vector(from.scale));
            at = from.index + 1us;
        }

        self:.run(copy AddCommand(d, alias path, at-> at));
    }

    fn onAddBoxVolume(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.addVolume("box", "box", lift-> 0.5f);
        }
    }

    fn onAddSphereVolume(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.addVolume("sphere_volume", "sphere", lift-> 0.5f);
        }
    }

    fn onAddCapsuleVolume(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.addVolume("capsule", "capsule", lift-> 1.0f);
        }
    }

    /**
     * Add a static body of a unit box, standing on the surface seen at the centre of the viewport
     * */
    fn onAddBody(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.add(NodeDescription("body", NodeKind::BODY), lift-> 0.5f);
        }
    }

    /**
     * Add a character, its capsule standing on the surface seen at the centre of the viewport
     * */
    fn onAddCharacter(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            let d = NodeDescription("character", NodeKind::CHARACTER);
            self:.add(d, lift-> d.value("height").number / 2.0f);
        }
    }

    /**
     * Wrap each node selected in a physics body of a shape fitted to it (see WrapCommand), the status bar telling when
     * none is selected
     * */
    fn onWrapClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut nodes = alias self:.selectedNodes();
        if nodes.len == 0us {
            self:.setStatus("Select the nodes to put in physics bodies");
            return;
        }

        if !self:.run(copy WrapCommand(alias nodes)) {
            self:.setStatus("No node selected goes in a body: a body or a character is one already");
        }
    }

    /**
     * Add a marker of a purpose, on the surface seen at the centre of the viewport
     * */
    fn addMarker(mut self, name: [c8], purpose: [c8]) {
        let mut d = NodeDescription(name, NodeKind::MARKER);
        d:.set("purpose", PropertyValue::choice(purpose));
        self:.add(d, lift-> 0.0f);
    }

    /**
     * Add a volume of a shape, standing on the surface seen at the centre of the viewport
     * @params:
     *    - lift: the half height of the shape, its centre above that surface
     * */
    fn addVolume(mut self, name: [c8], shape: [c8], lift: f32) {
        let mut d = NodeDescription(name, NodeKind::VOLUME);
        d:.set("shape", PropertyValue::choice(shape));
        self:.add(d, lift-> lift);
    }

    fn onAddModel(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let directory = if self._modelDirectory.len != 0us { self._modelDirectory } else { projectDirectory("models") };
        let dmut d = copy FileDialog(FileDialogMode::OPEN, directory-> directory, filters-> modelExtensions(),
                                     title-> "Add a model");
        d:.answered():.connect(self.box, &self:.onModelChosen);
        self:.openDialog(alias d);
    }

    fn onModelChosen(mut self, path: ([c8])?) {
        self._asking = false;
        if let Ok(p) = path {
            self._modelDirectory = Path(p).parent().toStr();

            let mut model = NodeDescription(Path(p).stripExtension().file(), NodeKind::MESH);
            model:.set("mesh", PropertyValue::asset(qualifiedPath(p)));
            self:.add(model, lift-> 0.0f);
        }
    }

    fn onAddDirectionLight(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut sun = NodeDescription("sun", NodeKind::LIGHT);
        sun:.set("direction", PropertyValue::vector(makeVec3(-0.3f, -1.0f, -0.2f)));
        self:.add(sun, lift-> 3.0f);
    }

    fn onAddPointLight(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut lamp = NodeDescription("lamp", NodeKind::LIGHT);
        lamp:.set("light", PropertyValue::choice("point"));
        lamp:.set("intensity", PropertyValue::number(5.0f));
        lamp:.set("range", PropertyValue::number(8.0f));
        self:.add(lamp, lift-> 2.0f);
    }

    fn onAddSpotLight(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut spot = NodeDescription("spot", NodeKind::LIGHT);
        spot:.set("light", PropertyValue::choice("spot"));
        spot:.set("intensity", PropertyValue::number(25.0f));
        spot:.set("range", PropertyValue::number(15.0f));
        self:.add(spot, lift-> 4.0f);
    }

    fn onAddPerspectiveCamera(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addCamera(CameraProjection::PERSPECTIVE); }
    }

    fn onAddOrthographicCamera(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addCamera(CameraProjection::ORTHOGRAPHIC); }
    }

    /**
     * Add a camera of a projection under the root of the scene, where the eye of the viewport stands, looking where it
     * looks, an orthographic camera seeing at the point looked at what the viewport sees there
     * */
    fn addCamera(mut self, projection: CameraProjection) {
        let orbit = if let Ok(v) = self._viewport { v.orbit } else { return; };
        let eye = orbit.eye();
        let back = eye - orbit.target;
        if back.length() == 0.0f { return; }

        let fov = 60.0f;
        let mut d = NodeDescription("camera", NodeKind::CAMERA);
        d:.set("projection", PropertyValue::choice(if projection == CameraProjection::ORTHOGRAPHIC { "orthographic" } else { "perspective" }));
        d:.set("position", PropertyValue::vector(eye));
        d:.set("rotation", PropertyValue::vector(facing(back.normalized(), makeVec3(0.0f, 1.0f, 0.0f)).euler()));
        d:.set("fov", PropertyValue::number(fov));
        d:.set("size", PropertyValue::number(framedSize(fov, back.length())));

        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            self:.run(copy AddCommand(d, alias scene:.getRootNode()));
        }
    }

    /**
     * Add a mesh node drawing a built-in mesh, a cube, a sphere or a plane, with the default material
     * @params:
     *    - mesh: the path of the built-in mesh (MeshAsset::CUBE...)
     * */
    fn addPrimitive(mut self, name: [c8], mesh: [c8]) {
        let mut d = NodeDescription(name, NodeKind::MESH);
        d:.set("mesh", PropertyValue::asset(mesh));
        self:.add(d, lift-> 0.0f);
    }

    /**
     * Add a node under the root of the scene, on the surface seen at the centre of the viewport, or at the point the
     * camera looks at when there is none
     * @params:
     *    - lift: the height of the node above that point (a light hanging over it...)
     * */
    fn add(mut self, description: NodeDescription, lift: f32) {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };
        let lookedAt = if let Ok(v) = self._viewport { v.orbit.target } else { vec3() };

        let mut d = description;
        d:.set("position", PropertyValue::vector(e:.placement(lookedAt) + makeVec3(0.0f, lift, 0.0f)));

        let dmut scene = alias e.scene;
        self:.run(copy AddCommand(d, alias scene:.getRootNode()));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          EDIT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onUndoClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.undo(); }
    }

    fn onRedoClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.redo(); }
    }

    /**
     * Undo the last change of the scene
     * */
    fn undo(mut self) {
        if let Ok(dmut e) = alias self._editor {
            if !e:.undo() { self:.setStatus("Nothing to undo"); }
        }
    }

    /**
     * Redo the last change undone, telling in the status bar why it failed
     * */
    fn redo(mut self) {
        if let Ok(dmut e) = alias self._editor {
            {
                if !e:.redo() { self:.setStatus("Nothing to redo"); }
            } catch {
                err: &BalderError => {
                    log::error #("Editor", "The change could not be redone", err);
                    self:.setStatus(err.msg);
                }
            }
        }
    }

    fn onDuplicateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.duplicateSelection(); }
    }

    fn onDeleteClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.deleteSelection(); }
    }

    fn onFrameClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.frameSelection(); }
    }

    fn duplicateSelection(mut self) {
        let dmut nodes = alias self:.selectedNodes();
        if nodes.len != 0us {
            self:.run(copy DuplicateCommand(alias nodes));
        }
    }

    fn deleteSelection(mut self) {
        let dmut nodes = alias self:.selectedNodes();
        if nodes.len != 0us {
            self:.run(copy RemoveCommand(alias nodes));
        }
    }

    /**
     * Look at the nodes selected, or at every node of the scene when none is
     * */
    fn frameSelection(mut self) {
        let dmut nodes = alias self:.selectedNodes();
        if nodes.len == 0us {
            if let Ok(dmut e) = alias self._editor {
                let dmut scene = alias e.scene;
                for _, dmut c in alias scene:.getRootNode():.getChilds() if let dmut n: &Node3D = alias c {
                    if !isEditorNode(n) { nodes ~= [alias n]; }
                }
            }
        }

        if let Ok(dmut v) = alias self._viewport {
            v:.frame(alias nodes);
        }
    }

    /**
     * @returns: the nodes selected, in a list of their own
     * */
    fn selectedNodes(mut self)-> dmut [&Node3D] {
        let dmut nodes: [&Node3D] = [];
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            let dmut selection = alias scene.selection;
            for dmut n in alias selection.nodes {
                nodes ~= [alias n];
            }
        }

        alias nodes
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          VIEW          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onIconsClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.toggleIcons(); }
    }

    /**
     * Hide the icons of the nodes without geometry in the viewport, or show them, the item of the View menu telling
     * what it does next
     * */
    fn onGridClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        if let Ok(dmut v) = alias self._viewport {
            v.showsGrid = !v.showsGrid;
            if let Ok(dmut item: &PushButton) = self.gui:.find(GRID_ITEM) {
                item:.setText(if v.showsGrid { "Hide the grid" } else { "Show the grid" });
            }

            if let Ok(dmut l) = alias self._gridLabel {
                if !v.showsGrid { l:.setText(""); }
            }

            self:.setStatus(if v.showsGrid { "Showing the grid" } else { "Hiding the grid" });
        }
    }

    /**
     * Look through the camera selected last, or through the camera of the editor again when the viewport looks through
     * a camera of the scene
     * */
    fn onThroughClicked(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut v = if let Ok(dmut v) = alias self._viewport { alias v } else { return; };
        if v.lookedThrough.hasValue {
            v:.lookThrough(none);
            self:.setStatus("Looking through the editor camera");
        } else {
            let dmut nodes = alias self:.selectedNodes();
            let dmut chosen: (&Camera)? = none;
            if nodes.len != 0us {
                if let dmut c: &Camera = alias nodes[$ - 1us] { chosen = (alias c)?; }
            }

            if let Ok(dmut c) = alias chosen {
                v:.lookThrough((alias c)?);
                self:.setStatus("Looking through " ~ c.name.file());
            } else {
                self:.setStatus("Select a camera to look through");
            }
        }

        self:.showThrough();
    }

    /**
     * Name in the item of the View menu the camera it looks through next
     * */
    fn showThrough(mut self) {
        let through = if let Ok(v) = self._viewport { v.lookedThrough.hasValue } else { false };
        if let Ok(dmut item: &PushButton) = self.gui:.find(THROUGH_ITEM) {
            item:.setText(if through { "Look through the editor camera" } else { "Look through the camera selected" });
        }
    }

    /**
     * A move of the controls of the viewport moved the camera it looks through: the move is recorded as a command
     * */
    fn onPiloted(mut self) {
        if let Ok(v) = self._viewport {
            if let Ok(e) = v.pilotEdit {
                self:.run(copy TransformCommand(copy [e], applied-> true));
            }
        }
    }

    /**
     * Tell the step of the grid of the ground in the status bar, in metres
     * */
    fn onGridStepped(mut self, step: f32) {
        if let Ok(dmut l) = alias self._gridLabel {
            l:.setText(f"Grid: ${gridStepText(step)}");
        }
    }

    fn toggleIcons(mut self) {
        if let Ok(dmut v) = alias self._viewport {
            v.showsIcons = !v.showsIcons;
            if let Ok(dmut item: &PushButton) = self.gui:.find(ICONS_ITEM) {
                item:.setText(if v.showsIcons { "Hide the icons" } else { "Show the icons" });
            }

            self:.setStatus(if v.showsIcons { "Showing the icons" } else { "Hiding the icons" });
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          GIZMO          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onTranslateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.setGizmoMode(GizmoMode::TRANSLATE); }
    }

    fn onRotateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.setGizmoMode(GizmoMode::ROTATE); }
    }

    fn onScaleClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.setGizmoMode(GizmoMode::SCALE); }
    }

    fn setGizmoMode(mut self, mode: GizmoMode) {
        if let Ok(dmut v) = alias self._viewport {
            v.mode = mode;
        }
    }

    /**
     * A drag of the gizmo moved the nodes selected: the change is recorded as a command
     * */
    fn onGizmoTransformed(mut self) {
        if let Ok(v) = self._viewport {
            self:.run(copy TransformCommand(v.edits, applied-> true));
        }
    }

    /**
     * A drag of a face of a volume, or of the collider of a body, changed its shape: the change is recorded as a command
     * */
    fn onGizmoReshaped(mut self) {
        if let Ok(v) = self._viewport {
            if let Ok(e) = v.volumeEdit {
                self:.run(copy VolumeCommand(copy [e], applied-> true));
            }
        }
    }

    /**
     * The keys the viewport takes besides those of the gizmo: Delete removes the nodes selected, Ctrl+D copies them, F
     * looks at them
     * */
    fn onViewportKey(mut self, key: SDL_Keycode, mods: SDL_Keymod) {
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        if key == SDLK_DELETE || key == SDLK_BACKSPACE {
            self:.deleteSelection();
        } else if key == SDLK_D && ctrl {
            self:.duplicateSelection();
        } else if key == SDLK_F && !ctrl {
            self:.frameSelection();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          COMMANDS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Change the scene through the editor, telling in the status bar why the change failed
     * @returns: true iif the scene changed
     * */
    fn run(mut self, dmut command: &EditCommand)-> bool {
        if let Ok(dmut e) = alias self._editor {
            {
                return e:.execute(alias command);
            } catch {
                err: &BalderError => {
                    log::error #("Editor", "The change failed", err);
                    self:.setStatus(err.msg);
                }
            }
        }

        false
    }

    /**
     * Tell in the status bar the last change of the scene, executed, undone or redone, whether the scene has unsaved
     * changes, and in the Edit menu the changes to undo and to redo
     * */
    fn onEdited(mut self, _: &EditCommand) {
        if let Ok(e) = self._editor {
            self:.setStatus(e.change);
        }

        // the camera looked through removed, or replaced by a camera of the other projection
        if let Ok(dmut v) = alias self._viewport {
            if v:.checkLookedThrough() { self:.showThrough(); }
        }

        self:.showDocument();
        self:.showHistory();
    }

    /**
     * Name in the items Undo and Redo of the Edit menu the changes they undo and redo, greying an item with nothing to do
     * */
    fn showHistory(mut self) {
        let (undo, redo) = if let Ok(e) = self._editor {
            (if let Ok(c) = e.toUndo { c.describe() } else { "" }, if let Ok(c) = e.toRedo { c.describe() } else { "" })
        } else {
            ("", "")
        };

        self:.showHistoryItem(UNDO_ITEM, "Undo", undo, "Ctrl+Z");
        self:.showHistoryItem(REDO_ITEM, "Redo", redo, "Ctrl+Shift+Z");
    }

    /**
     * Name in an item of the Edit menu the change it undoes or redoes, the item being greyed when there is none
     * @params:
     *    - action: Undo or Redo
     *    - change: the change, empty when there is none
     *    - keys: the shortcut of the item
     * */
    fn showHistoryItem(mut self, path: [c8], action: [c8], change: [c8], keys: [c8]) {
        if let Ok(dmut item: &PushButton) = self.gui:.find(path) {
            if change.len == 0us {
                item:.setText(f"${action} (${keys})");
                item:.setClasses(copy ["item", IDLE]);
            } else {
                item:.setText(f"${action}: ${change} (${keys})");
                item:.setClasses(copy ["item"]);
            }
        }
    }

    /**
     * Open a dialog over the editor, the editor asking something until its answer
     * */
    fn openDialog(mut self, dmut d: &Dialog) {
        {
            d:.open(DialogMode::OVERLAY, alias self.gui);
            self._asking = true;
        } catch {
            err => {
                log::error #("Editor", "Failed to open the dialog", err);
                self:.setStatus("The dialog could not be opened");
            }
        }
    }

    /**
     * Tell something in the status bar after the changes of the scene made meanwhile, which the editor tells as they
     * are delivered, at the start of the next update (the opens of a reload)
     * */
    fn notify(mut self, msg: [c8]) {
        self._notice = msg;
        self._noticeWaits = true;
    }

    fn setStatus(mut self, msg: [c8]) {
        if let Ok(dmut status) = alias self._status {
            status:.setText(msg);
        }
    }
}

/**
 * @returns: the step of the grid, a power of ten in metres, as people read it: 10 cm, 1 m, 100 m, 1 km
 * */
fn gridStepText(step: f32)-> [c8] {
    if step < 0.95f { return f"${cast!i32(step * 100.0f + 0.5f)} cm"; }
    if step < 950.0f { return f"${cast!i32(step + 0.5f)} m"; }
    f"${cast!i32(step / 1000.0f + 0.5f)} km"
}

/**
 * @returns: the extensions of the scene files, the files the dialog opening a scene lists
 * */
fn sceneExtensions()-> [[c8]] {
    copy [SCENE_EXTENSION]
}

/**
 * @returns: the absolute path of a directory under the res/ directory of the project, res/ itself when it does not exist
 * */
fn projectDirectory(name: [c8])-> [c8] {
    let dir = ressourcePath().push(name);
    if isDir(dir) { dir.toStr() } else { ressourcePath().toStr() }
}

/**
 * @returns: where a point inserted in a path after one of its points goes, in the space of the path: halfway to the next
 * point, to the first one past the last point of a closed path; a step past the last point of an open path, the step
 * from the point before it, one unit along X for a path of one point
 * @params:
 *    - points: the points of the path, in their order
 *    - i: the index among them of the point the new one follows
 * */
fn insertedPoint(points: [&PathPoint3D], i: usize, closed: bool)-> vec3 {
    let p = points[i].position;
    if i + 1us < points.len {
        return (p + points[i + 1us].position) / 2.0f;
    }

    if points.len < 2us { return p + makeVec3(1.0f, 0.0f, 0.0f); }
    if closed { return (p + points[0].position) / 2.0f; }

    p + (p - points[i - 1us].position)
}

/**
 * @returns: the extensions of the models the importer reads, the files the dialog adding a model lists
 * */
fn modelExtensions()-> [[c8]] {
    copy ["gltf", "glb", "obj", "fbx", "dae", "ply", "stl"]
}
