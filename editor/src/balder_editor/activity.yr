use balder_editor::{arguments, build_error_dialog, connections_panel, dock_rails, document, editor, hulls_panel, inspector_panel, manager, material_document, material_panel, material_preview, material_slots_panel, naming, outline_panel, scene_document, viewport, viewport_bars};
use balder_editor::command;
