in activity;

mod ::add_menu;
mod ::edit_menu;
mod ::documents;
mod ::editor_context;
mod ::file_choice;
mod ::game_library_behavior;
mod ::gizmo_menu;
mod ::material_documents;
mod ::pending;
mod ::pending_close;
mod ::scene_menu;
mod ::view_menu;

use balder::core::{_, application::_};
use balder::interface::widget::layout::d3scene;
use balder::interface::widget::tree::view;
use balder::scene::editable;
use balder::utils::{log, path};

use balder_editor::{arguments, connections_panel, dock_rails, hulls_panel, inspector_panel, manager, material_document, material_panel, material_preview, material_slots_panel, outline_panel, viewport, viewport_bars};
use balder_editor::activity::{add_menu, documents, edit_menu, editor_context, game_library_behavior, gizmo_menu, material_documents, pending, scene_menu, view_menu};
use balder_editor::project;
use balder_editor::project::{game_library, recent};

use std::{fs, io, time};

use ::sdl3::keycode;

// The configuration of the window of the project manager, under the directory of the editor
def MANAGER_CONFIG = "manager.toml";

// The tool of the inspector, shown before Ctrl+F opens its filter
def INSPECTOR_TOOL = "INSPECTOR";

/**
 * The editor of Balder: the outline of the scene on the left, the viewport in the middle, the inspector of the node
 * selected on the right, under a top row of the menus opening, saving, adding, copying and removing nodes, then of the
 * tabs of the scenes opened, above a status bar
 * @info:
 * =====
 * Each scene opened is a document (SceneDocument) in a tab of its own, with its file, its history, its selection and
 * the eye of the editor camera: a click on a tab (or Ctrl+Tab, Ctrl+Shift+Tab) shows its scene in the viewport, the
 * nodes of the other documents kept out of the scene meanwhile, as they were left; a tab is dragged to another place,
 * closed by its cross, the middle button or Ctrl+W (asking about its unsaved changes first), and + (or Ctrl+N) opens a
 * new scene in a tab of its own. Opening a scene already open shows its tab; a scene opened takes the place of a new
 * scene never changed, and gets a tab of its own otherwise. Closing the last tab leaves a new scene. Quit and Back to
 * the project manager ask about the unsaved changes of each document in turn.
 * ====
 * @info:
 * =====
 * The editor edits a project (see Project), the one of the project path (getProjectPath), opened by the project
 * manager or by '--project': it starts on the scene of the project edited last, or on its main scene, or on a new
 * scene. A scene saved under the res/ directory of the project joins its scenes, named after its file, and the path of
 * a scene or a model under it is written res:/…, the project moving with its files. Scene → Back to the project
 * manager closes the editor for the manager.
 * ====
 * @info:
 * =====
 * The library of the game of the project (the shared target of its gyllir.toml, see GameBuild) is loaded in the editor
 * (see GameLibrary), the #[actor] tags of its classes registering them: the Add menu lists them, the inspector edits
 * their nodes and the scene files build them. A library newer than its sources is loaded before the first scene is
 * opened; otherwise it is built in the background, the status bar telling how far, then loaded, the scene rebuilt with
 * its classes. Compile (the button on the right of the menu bar, or Ctrl+R) builds it again and reloads it, a change of
 * the code of an actor taken without leaving the editor: the scene is described as its file would save it, its nodes
 * dropped, the library closed (its classes unregistered) and opened again, then the scene is built again from its
 * description with the classes of the new library, read leniently (an entry, a signal or a connection its class no
 * longer declares dropped and logged, an actor of a class gone kept as an unknown one); its history starts again, its
 * unsaved changes staying unsaved. A build that fails tells its first error in the status bar and in a dialog
 * (BuildErrorDialog), the library loaded staying; a library that cannot be loaded leaves the actors unknown. Going
 * back to the project manager closes the library.
 * ====
 * @info:
 * =====
 * Every change of the scene is a command run through the SceneEditor, which keeps it in the history of the document
 * shown; the viewport, focused by a click, takes the keys W, E and R (the gizmo), Delete, Ctrl+D and F, the window
 * Ctrl+Z (undo), Ctrl+Shift+Z and Ctrl+Y (redo), Ctrl+N (new scene), Ctrl+O (open), Ctrl+W (close), Ctrl+S (save),
 * Ctrl+Shift+S (save as), Ctrl+Tab and Ctrl+Shift+Tab (the next and the previous tab), Ctrl+E (the Add menu, under
 * the cursor) and Ctrl+F (the filter of the inspector). The items Undo and Redo of the Edit menu name the change they undo or redo. View → Look through the
 * camera selected draws the viewport through a camera of the scene, its moves recorded as commands, until View → Look
 * through the editor camera, or until the camera leaves the scene. A scene has unsaved changes while its history is not
 * where it was at the last save (a change made, or undone), shown by a dot on its tab, in the title of the window and
 * on the right of the status bar. A new scene, blank, has no file yet: its first save asks for one. Closing a scene,
 * Quit and Back to the project manager ask whether to save the changes first, or discard them, or do nothing.
 * ====
 * */
pub class EditorActivity over Activity {

    // What the behaviors of the editor share, the interface, the editor of the scene, the status bar and the dialogs,
    // made with the interface (see ctx)
    let dmut _ctx: (&EditorContext)? = none;

    // The Add menu, the Edit menu and the View menu, once the activity is started
    let dmut _add: (&AddMenu)? = none;
    let dmut _edit: (&EditMenu)? = none;
    let dmut _view: (&ViewMenu)? = none;

    // The documents opened, a tab each, once the activity is started
    let dmut _docs: (&Documents)? = none;

    // The Scene menu, saving the documents and asking about their unsaved changes, once the activity is started
    let dmut _sceneMenu: (&SceneMenu)? = none;

    // The inspector, its filter toggled by Ctrl+F, once the interface is loaded
    let dmut _inspector: (&InspectorPanel)? = none;

    // The library of the game of the project, built and loaded, once the activity is started
    let dmut _library: (&GameLibraryBehavior)? = none;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    /**
     * @returns: what the behaviors of the editor share, made at the first call
     * */
    @{field}
    fn ctx(mut self)-> dmut &EditorContext {
        if let Ok(dmut c) = alias self._ctx { return alias c; }

        let dmut c = copy EditorContext(alias self.gui, alias self.box, alias self.window);
        self._ctx = (alias c)?;
        alias c
    }

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);
        self.input:.keyPressed():.connect(self.box, &self:.onKey);
        let dmut ctx = alias self.ctx;

        // the behaviors the 'on-…' attributes of editor.gui name: the panels, the menus, the tabs and the library
        let dmut docks = copy DockRails(alias self.gui, alias self.box);
        self:.behavior("docks", alias docks);
        let dmut bars = copy ViewportBars(alias self.gui, alias self.box, &ctx:.setStatus);
        self:.behavior("viewport", alias bars);

        let dmut outline = copy OutlinePanel(&ctx:.setStatus);
        self:.behavior("outline", alias outline);
        let dmut inspector = copy InspectorPanel(alias self.gui, alias self.box, &ctx:.setStatus);
        self:.behavior("inspector", alias inspector);
        let dmut hulls = copy HullsPanel(alias self.gui, alias self.box);
        self:.behavior("hulls", alias hulls);
        let dmut links = copy ConnectionsPanel(alias self.gui, alias self.box, &ctx:.setStatus);
        self:.behavior("connections", alias links);
        let dmut slots = copy MaterialSlotsPanel(alias self.gui, alias self.box, &ctx:.setStatus);
        self:.behavior("materials", alias slots);
        let dmut materials = copy MaterialPanel(alias self.gui, alias self.box, &ctx:.setStatus);
        self:.behavior("material", alias materials);

        let dmut add = copy AddMenu(alias ctx);
        self:.behavior("add", alias add);
        self._add = (alias add)?;
        let dmut edit = copy EditMenu(alias ctx, alias materials);
        self:.behavior("edit", alias edit);
        self._edit = (alias edit)?;
        let dmut view = copy ViewMenu(alias ctx);
        self:.behavior("view", alias view);
        self._view = (alias view)?;
        let dmut gizmo = copy GizmoMenu(alias ctx);
        self:.behavior("gizmo", alias gizmo);
        let dmut docs = copy Documents(alias ctx, alias edit, alias view, alias materials);
        self:.behavior("documents", alias docs);
        self._docs = (alias docs)?;
        let dmut materialDocs = copy MaterialDocuments(alias ctx, alias docs, alias materials, alias slots);
        let dmut sceneMenu = copy SceneMenu(alias ctx, alias docs, alias materialDocs);
        self:.behavior("scene", alias sceneMenu);
        sceneMenu:.settled():.connect(&self:.onSettled);
        self._sceneMenu = (alias sceneMenu)?;
        let dmut library = copy GameLibraryBehavior(alias ctx, alias docs);
        self:.behavior("game", alias library);
        library:.actorsChanged():.connect(&add:.listActorClasses);
        self._library = (alias library)?;

        self.gui:.getRegistry():.register(EditorViewport::schema());
        self.gui:.getRegistry():.register(MaterialPreview::schema());
        println(self.gui:.loadStyleFile(editorFile("ui/editor.style"))?);
        println(self.gui:.loadGUIFile(editorFile("ui/editor.gui"))?);

        if docks:.bind() {
            self.ctx.docks = (alias docks)?;
        } else {
            log::error #("Editor", "The interface of the editor has no rails or no docks");
        }

        ctx:.bind();
        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("BODY/MAIN/VIEW") {
            if let Ok(dmut s: &EditableScene) = alias w:.getScene() {
                docs:.bind(alias s);
            }
        }

        if let Ok(dmut v: &EditorViewport) = self.gui:.find("BODY/MAIN/VIEW/GIZMO") {
            v:.keyPressed():.connect(self.box, &self:.onViewportKey);
            self.ctx.viewport = (alias v)?;
        }

        view:.bind();
        gizmo:.bind();

        if let Ok(dmut e) = alias self.ctx.editor {
            if let Ok(dmut t: &TreeView) = self.gui:.find("BODY/MAIN/OUTLINE/TREE") {
                if let Ok(dmut v) = alias self.ctx.viewport {
                    outline:.bind(alias t, alias e, alias v, alias self.box);
                }
            }

            inspector:.bind(alias e);
            hulls:.bind(alias e);
            if let Ok(dmut v) = alias self.ctx.viewport {
                bars:.bind(alias v, alias e, alias hulls, alias self.ctx.docks);
                self.ctx.bars = (alias bars)?;
            }

            links:.bind(alias e);
            slots:.bind(alias e);
            materials:.bind(alias e);

            materialDocs:.bind();
            self._inspector = (alias inspector)?;
        } else {
            log::error #("Editor", "The viewport of the editor has no editable scene");
            return;
        }

        self:.openProject();
    }

    /**
     * Tell in the status bar what waits for the update (see EditorContext::notify), and how far the build of the library
     * of the game is
     * */
    over onUpdate(mut self, delta: Duration) {
        self.ctx:.update();
        if let Ok(dmut l) = alias self._library { l:.update(delta); }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PROJECT          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read the project of the project path, put it first in the recent projects, load the library of its game when it
     * is newer than its sources, and open its first scene: the one of the command line, or the scene edited last, or
     * the main scene, or a new scene; the library is built afterwards when it is not up to date
     * */
    fn openProject(mut self) {
        let dmut docs = if let Ok(dmut x) = alias self._docs { alias x } else { return; };
        let dmut library = if let Ok(dmut l) = alias self._library { alias l } else { return; };
        let directory = getProjectPath().toStr();
        {
            let dmut project = copy Project::open(directory);
            self.ctx.project = (alias project)?;
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to read the project", err);
                self.ctx:.setStatus(err.msg);
            }
        }

        let dmut recent = copy RecentProjects();
        recent:.opened(directory);
        self.ctx:.saveRecent(recent);

        let (notice, toBuild) = library:.findLibrary(directory);
        // the first document is a new scene, which the first scene opened takes the place of
        let scene = self:.firstScene(recent.sceneOf(directory));
        if scene.len != 0us { docs:.openScene(scene); }
        docs:.showDocument();

        if notice.len != 0us { self.ctx:.notify(notice); }
        if toBuild { library:.compile(); }
        library:.showCompile();
    }

    /**
     * @returns: the scene the editor starts on, empty for a new scene: the one of the command line, or the scene of the
     * project edited last, or its main scene, the first one whose file exists
     * @params:
     *    - edited: the scene of the project edited last, empty when none was
     * */
    fn firstScene(mut self, edited: [c8])-> [c8] {
        let given = startScene();
        if given.len != 0us { return given; }

        let mut candidates: [[c8]] = copy [edited];
        if let Ok(p) = self.ctx.project {
            if let Ok(main) = p.mainScenePath() { candidates ~= [main]; }
        }

        for s in candidates if s.len != 0us && isFile(projectPath(s)) {
            return s;
        }

        ""
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          KEYS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The keys of the window: Ctrl+Z undoes the last change, Ctrl+Shift+Z and Ctrl+Y redo it, Ctrl+N opens a new scene,
     * Ctrl+O a scene file, Ctrl+W closes the scene shown, Ctrl+S saves it, Ctrl+Shift+S saves it in another file,
     * Ctrl+Tab and Ctrl+PageDown show the next tab, Ctrl+Shift+Tab and Ctrl+PageUp the previous one, Ctrl+E opens the
     * Add menu under the cursor, Ctrl+R compiles the library of the game and loads it, Ctrl+F opens the filter of the
     * inspector, or closes it
     * */
    fn onKey(mut self, key: SDL_Keycode, mods: SDL_Keymod) {
        let dmut docs = if let Ok(dmut x) = alias self._docs { alias x } else { return; };
        let dmut menu = if let Ok(dmut m) = alias self._sceneMenu { alias m } else { return; };
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        if !ctrl || self.ctx.isAsking() { return; }

        let shift = (mods & SDL_KMOD_SHIFT) != 0u16;
        if (key == SDLK_Z && shift) || key == SDLK_Y {
            if let Ok(dmut e) = alias self._edit { e:.redo(); }
        } else if key == SDLK_Z {
            if let Ok(dmut e) = alias self._edit { e:.undo(); }
        } else if key == SDLK_S && shift {
            menu:.saveAs();
        } else if key == SDLK_S {
            menu:.save();
        } else if key == SDLK_N && !shift {
            docs:.newScene();
        } else if key == SDLK_O && !shift {
            menu:.chooseScene();
        } else if key == SDLK_W && !shift {
            menu:.closeShown();
        } else if (key == SDLK_TAB && !shift) || key == SDLK_PAGEDOWN {
            docs:.showNeighbour(true);
        } else if key == SDLK_TAB || key == SDLK_PAGEUP {
            docs:.showNeighbour(false);
        } else if key == SDLK_E && !shift {
            if let Ok(dmut a) = alias self._add { a:.openAddMenu(); }
        } else if key == SDLK_R && !shift {
            if let Ok(dmut l) = alias self._library { l:.compile(); }
        } else if key == SDLK_F && !shift {
            if let Ok(dmut d) = alias self.ctx.docks { d:.reveal(INSPECTOR_TOOL); }
            if let Ok(dmut b) = alias self.ctx.bars { b:.showMaximized(); }
            if let Ok(dmut i) = alias self._inspector { i:.toggleSearch(); }
        }
    }

    /**
     * The keys the viewport takes besides those of the gizmo: Delete removes the nodes selected, Ctrl+D copies them, F
     * looks at them, Ctrl+Alt+M aligns them with the view, Shift+Space maximizes the viewport, or restores the docks
     * */
    fn onViewportKey(mut self, key: SDL_Keycode, mods: SDL_Keymod) {
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        let shift = (mods & SDL_KMOD_SHIFT) != 0u16;
        let alt = (mods & SDL_KMOD_ALT) != 0u16;
        if key == SDLK_DELETE || key == SDLK_BACKSPACE {
            if let Ok(dmut e) = alias self._edit { e:.deleteSelection(); }
        } else if key == SDLK_D && ctrl {
            if let Ok(dmut e) = alias self._edit { e:.duplicateSelection(); }
        } else if key == SDLK_M && ctrl && alt {
            if let Ok(dmut v) = alias self._view { v:.alignSelection(); }
        } else if key == SDLK_F && !ctrl {
            if let Ok(dmut e) = alias self._edit { e:.frameSelection(); }
        } else if key == SDLK_SPACE && shift && !ctrl {
            if let Ok(dmut b) = alias self.ctx.bars { b:.toggleMaximized(); }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          QUIT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The window is closed
     * */
    fn onQuit(mut self) {
        if self.ctx.isAsking() { return; }
        if let Ok(dmut m) = alias self._sceneMenu { m:.ask(Pending::QUIT); }
    }

    /**
     * Every document is saved or discarded: quit, or go back to the project manager
     * */
    fn onSettled(mut self, then: Pending) {
        match then {
            Pending::QUIT    => { self.app:.close(alias self); }
            Pending::MANAGER => { self:.openManager(); }
            _ => {}
        }
    }

    /**
     * Open the project manager, the editor closing, the nodes of its documents dropped and the library of the game
     * closed; not while the library is being built, the build going on
     * */
    fn openManager(mut self) {
        let dmut docs = if let Ok(dmut x) = alias self._docs { alias x } else { return; };
        if let Ok(dmut l) = alias self._library && l:.isBuilding() {
            self.ctx:.setStatus(f"The library of ${self.ctx.projectName()} is being built: back to the project manager once it is");
            return;
        }

        // the materials of the cache keep the values of their files
        if let Ok(dmut e) = alias self.ctx.editor {
            for dmut d in alias docs:.documents() if let dmut m: &MaterialDocument = alias d {
                if m.unsaved { m:.discard(alias e.scene); }
            }
        }

        docs:.dropNodes();
        GameLibrary::unload();
        {
            self.app:.open!{&ProjectManagerActivity}(copy BalderConfig(editorFile(MANAGER_CONFIG)));
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to open the project manager", err);
                self.ctx:.setStatus(err.msg);
                return;
            }
        }

        self.app:.close(alias self);
    }
}
