in arguments;

use balder::utils::path;

use std::{config, config::args, io};
use std::fs;

/**
 * The directory of the project the editor opens at the start, set by '--project', empty to start on the project manager
 * */
lazy mut __PROJECT__: [mut [c8]] = copy [""];

/**
 * The scene file of the project the editor opens at the start, set by '--scene', empty for the scene edited last
 * */
lazy mut __SCENE__: [mut [c8]] = copy [""];

/**
 * The directory the game of the project is exported to without opening the editor, set by '--export', empty to open
 * the editor
 * */
lazy mut __EXPORT__: [mut [c8]] = copy [""];

/**
 * @returns: the path of a file of the editor, under the directory of the engine
 * */
pub fn editorFile(name: [c8])-> [c8] {
    getEnginePath().push("editor").push(name).toStr()
}

/**
 * @returns: the absolute path of the directory of the project the editor opens at the start, empty to start on the
 * project manager
 * */
pub fn startProject()-> [c8] {
    __PROJECT__[0]
}

/**
 * @returns: the scene file the editor opens at the start, empty for the scene of the project edited last
 * */
pub fn startScene()-> [c8] {
    __SCENE__[0]
}

/**
 * @returns: the absolute path of the directory the game of the project is exported to, without opening the editor,
 * empty to open the editor
 * */
pub fn exportDirectory()-> [c8] {
    __EXPORT__[0]
}

/**
 * Read the command line, '--engine-dir' moving the directory of the engine the 'engine:/' and 'shaders:/' paths and
 * the files of the editor are resolved against, '--project' naming the project to open, '--scene' a scene of it,
 * '--export' the directory its game is exported to without opening the editor
 * @returns: false iif the application must not start
 * */
pub fn readArguments(args: [[c8]])-> bool {
    let parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("engine-dir", comments-> "the directory of the engine, holding res/ and editor/ (the current directory by default)")
        :.option!{[c8]} ("project", comments-> "the directory of the project to open (the project manager by default)")
        :.option!{[c8]} ("scene", comments-> "a scene file of the project to open (the scene edited last by default)")
        :.option!{[c8]} ("export", comments-> "export the game of the project given by --project to this directory, without opening the editor");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["engine-dir"]? {
            setEnginePath(Path(dir).absolute());
        }

        if let Ok(Str(value-> project)) = cfg["project"]? {
            __PROJECT__[0] = Path(project).absolute().toStr();
        }

        if let Ok(Str(value-> scene)) = cfg["scene"]? {
            if __PROJECT__[0].len == 0us {
                eprintln("balder-editor: --scene opens a scene of the project given by --project");
                return false;
            }

            __SCENE__[0] = scene;
        }

        if let Ok(Str(value-> dir)) = cfg["export"]? {
            if __PROJECT__[0].len == 0us {
                eprintln("balder-editor: --export exports the game of the project given by --project");
                return false;
            }

            __EXPORT__[0] = Path(dir).absolute().toStr();
        }

        true
    } catch {
        err: &std::config::args::CommandLineError => {
            eprintln(parser.explain(err, usage-> "balder-editor"));
            false
        }
        err: &FsError => {
            eprintln(f"balder-editor: ${err}");
            false
        }
    }
}
