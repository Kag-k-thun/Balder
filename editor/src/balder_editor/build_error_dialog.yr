in build_error_dialog;

use balder::interface::dialog;
use balder::interface::widget::text::label;

use std::concurrency;

use ::sdl3::mouse;

/**
 * The failure of the build of the library of a project, over the editor: the first error of the compiler as it
 * writes it (its message, the place it names and the code there), and the buttons opening the file of all the errors
 * of the build and its whole output, in the application the desktop opens them with (xdg-open)
 * @info: Close, Escape or a click on Close closes it, the editor taking the clicks again
 * */
pub class BuildErrorDialog over Dialog {

    // The name of the project whose library did not build
    let _name: [c8];

    // The first error of the build, empty when its output names none
    let _error: [c8];

    // The file of the errors of the build, empty when it could not be written, and the whole output of the build
    let _errors: [c8];
    let _log: [c8];

    /**
     * @params:
     *    - guiFile: the .gui file of the dialog
     *    - name: the name of the project whose library did not build
     *    - error: the first error of the build, empty when its output names none
     *    - errors: the file of the errors of the build, empty when it could not be written
     *    - log: the file of the whole output of the build
     * */
    pub self (guiFile: [c8], name: [c8], error: [c8], errors: [c8], log: [c8])
        with super(guiFile, "", "The build failed")
        , _name = name
        , _error = error
        , _errors = errors
        , _log = log
    {
        // the slots the 'on-…' attributes of build_error.gui name
        self:.slot("errors", &self:.onErrorsClicked);
        self:.slot("log", &self:.onLogClicked);
        self:.slot("close", &self:.onCloseClicked);
    }

    pub over dismiss(mut self) {
        self:.close();
    }

    prot over onShow(mut self) {
        self:.setText("TITLE", f"The library of ${self._name} did not build");
        self:.setText("ERROR", if self._error.len != 0us { self._error } else { "The output of the build names no error: see its whole log" });
        self:.setText("NOTE", if self._errors.len != 0us { f"All the errors: ${self._errors}" } else { f"The whole output: ${self._log}" });
        self:.focus("CLOSE");
    }

    fn onErrorsClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.openFile(if self._errors.len != 0us { self._errors } else { self._log }); }
    }

    fn onLogClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.openFile(self._log); }
    }

    fn onCloseClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.close(); }
    }

    /**
     * Open a file in the application the desktop opens it with, the note telling when it cannot be
     * */
    fn openFile(mut self, file: [c8]) {
        {
            let dmut p = copy SubProcess("xdg-open", copy [file]);
            p:.start(redirect-> false);
            __OPENERS__ ~= [alias p];
        } catch {
            _ => {
                self:.setText("NOTE", f"The file could not be opened: ${file}");
            }
        }
    }

    fn setText(mut self, path: [c8], text: [c8]) {
        if let Ok(dmut l: &Label) = self:.find(path) {
            l:.setText(text);
        }
    }

}

/**
 * The xdg-open started, kept so that they are not collected while they run
 * */
lazy dmut __OPENERS__: [&SubProcess] = [];
