in duplicate;

use balder_editor::naming;
use balder_editor::command::{remove, utils};
use balder::scene::editable;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{body, character, empty, light, marker, mesh_instance, path, path_point, volume};
use balder::scene::node::node3D::visual::_;
use balder::utils::log;

/**
 * The copy of nodes beside them, with the nodes under them, the copies being selected
 * @info: the copy of a mesh node draws the mesh asset of the original with its materials (see MeshInstance3D::copyOf),
 * the copy of a mesh its geometry (see IndexedMesh3D::sharing); a camera is not copied. The copies are kept, a copy undone detaching them and redone
 * attaching them again
 * */
pub class DuplicateCommand over EditCommand {

    // The nodes copied
    let dmut _nodes: [&Node3D];

    // The copies, once the command is applied, then the parents they go under
    let dmut _copies: [&Node3D] = [];
    let dmut _parents: [&Node] = [];

    // The nodes selected before the copy, selected again when it is undone
    let dmut _selected: [&Node3D] = [];

    pub self (dmut nodes: [&Node3D])
        with _nodes = alias nodes
    {}

    pub over apply(mut self, dmut scene: &EditableScene)-> bool {
        self._selected = alias selectedNodes(alias scene);
        if self._copies.len == 0us {
            for dmut n in alias self._nodes if !isUnderOneOf(n, self._nodes) {
                if let Ok(dmut parent) = alias n:.getParent() {
                    if let Ok(dmut c) = alias duplicate(alias n, alias parent) {
                        self._copies ~= [alias c];
                        self._parents ~= [alias parent];
                    }
                }
            }
        } else {
            for i, dmut c in alias self._copies {
                c:.attach(alias self._parents[i], at-> LAST_PLACE);
            }
        }

        if self._copies.len == 0us { return false; }

        let dmut selection = alias scene.selection;
        selection:.clear();
        for dmut c in alias self._copies {
            selection:.add(alias c);
        }

        true
    }

    pub over revert(mut self, dmut scene: &EditableScene) {
        for dmut c in alias self._copies {
            c:.dispose();
        }

        reselect(alias scene, alias self._selected);
    }

    pub over describe(self)-> [c8] {
        if self._copies.len == 1us {
            return "Duplicated into " ~ self._copies[0].name.file();
        }

        "Duplicated " ~ std::conv::to!{[c8]} (self._copies.len) ~ " nodes"
    }

    pub over reshapes(self)-> bool {
        true
    }

}

/**
 * @returns: a copy of a node and of the nodes under it, under a parent, at the place of the node, none for a node that
 * is not copied (a camera...)
 * */
fn duplicate(dmut node: &Node3D, dmut parent: &Node)-> dmut (&Node3D)? {
    let name = freeName(alias parent, node.name.file());
    if let Ok(dmut twin) = alias copyAlone(name, alias node, alias parent) {
        twin:.setTransform(node.position, node.rotation, node.scale);

        // the meshes drawing the parts of a mesh node are its own, built by its copy
        for dmut c in alias node:.getChildrenInOrder() if !isReservedName(c.name.file()) {
            if let dmut child: &Node3D = alias c {
                duplicate(alias child, alias twin);
            }
        }

        return (alias twin)?;
    }

    none
}

/**
 * @returns: a copy of a node without the nodes under it, under a parent, none for a node that is not copied
 * */
fn copyAlone(name: [c8], dmut node: &Node3D, dmut parent: &Node)-> dmut (&Node3D)? {
    if let dmut m: &MeshInstance3D = alias node {
        {
            let dmut twin = copy MeshInstance3D::copyOf(name, alias parent, alias m);
            return (alias twin)?;
        } catch {
            err => {
                log::error #("DuplicateCommand", f"${name} not copied:", err);
                return none;
            }
        }
    }

    if let dmut mesh: &IndexedMesh3D = alias node {
        let dmut twin = copy IndexedMesh3D::sharing(name, alias parent, alias mesh.mesh, mesh.material.clone(), shadow-> mesh.castShadow());
        return (alias twin)?;
    }

    if let l: &Light = node {
        return (alias copyLight(name, alias parent, l))?;
    }

    if let _: &Empty3D = node {
        let dmut empty = copy Empty3D(name, alias parent);
        return (alias empty)?;
    }

    if let m: &Marker3D = node {
        let dmut marker = copy Marker3D(name, alias parent, purpose-> m.purpose);
        marker.tags = m.tags;
        return (alias marker)?;
    }

    if let p: &Path3D = node {
        let dmut path = copy Path3D(name, alias parent, curveKind-> p.curveKind, closed-> p.closed);
        return (alias path)?;
    }

    if let _: &PathPoint3D = node {
        let dmut point = copy PathPoint3D(name, alias parent);
        return (alias point)?;
    }

    if let v: &Volume3D = node {
        let dmut volume = copy Volume3D(name, alias parent, shape-> v.shape);
        return (alias volume)?;
    }

    if let c: &CharacterBody3D = node {
        let dmut character = copy CharacterBody3D(name, alias parent, radius-> c.shape.radius, height-> c.shape.height,
                                                  settings-> c.controller.settings, body-> c.settings);
        return (alias character)?;
    }

    if let b: &PhysicsBody3D = node {
        // the copy of a compound sharing the parts of the original, the volumes copied under it in place
        let dmut body = copy PhysicsBody3D(name, alias parent, settings-> b.settings);
        body:.setDescribedShape(b.shape, b.described);
        return (alias body)?;
    }

    none
}

/**
 * @returns: a light shining as another one, under a parent
 * */
fn copyLight(name: [c8], dmut parent: &Node, l: &Light)-> dmut &Light {
    let dmut c = copy Light(name, alias parent, castShadow-> l.castShadow);
    c.type = l.type;
    c.color = l.color;
    c.intensity = l.intensity;
    c.direction = l.direction;
    c.range = l.range;
    c.innerAngle = l.innerAngle;
    c.outerAngle = l.outerAngle;
    c.shadowBias = l.shadowBias;
    c.shadowNormalOffset = l.shadowNormalOffset;
    alias c
}
