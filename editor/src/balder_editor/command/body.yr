in body;

use balder::scene::editable;
use balder::scene::edit::body_edit;

/**
 * A change of the settings and of the shapes of bodies (their motion, their material, their layers, their shape and
 * its sizes), made in the inspector
 * @info: the colliders are built when the change is made (the hulls of a model read from its file, the volumes under a
 * compound gathered), the command keeping them, so undone and redone it reads nothing again
 * */
pub class BodyCommand over EditCommand {

    // The edits of the bodies, from the settings and the shape each had to those it gets
    let mut _edits: [mut BodyEdit];

    // The field of the inspector the change was typed in, the steps of one field merging into one command, empty for a
    // change that merges with none
    let _field: [c8];

    /**
     * @params:
     *    - edits: the edits of the bodies
     *    - field: the field of the inspector the change was typed in, empty for a change that merges with none
     * */
    pub self (edits: [BodyEdit], field: [c8] = "")
        with _edits = copy edits
        , _field = field
    {}

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._edits.len == 0us { return false; }
        for i in 0us .. self._edits.len {
            self._edits[i]:.apply();
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i in 0us .. self._edits.len {
            self._edits[i]:.revert();
        }
    }

    /**
     * A change of the same bodies typed in the same field merges, the bodies going from their settings and their shapes
     * before this change to those after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let b: &BodyCommand = next {
            if self._field.len == 0us || b._field != self._field || b._edits.len != self._edits.len { return false; }
            for i, e in self._edits {
                if e.node.uid != b._edits[i].node.uid { return false; }
            }

            for i in 0us .. self._edits.len {
                self._edits[i] = self._edits[i]:.extendedTo(b._edits[i]);
            }

            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        if self._edits.len == 1us {
            return "Changed the body " ~ self._edits[0].node.name.file();
        }

        f"Changed ${self._edits.len} bodies"
    }

}
