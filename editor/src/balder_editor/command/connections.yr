in connections;

use balder::scene::actors::node_connection;
use balder::scene::editable;
use balder::scene::node::node3D;

/**
 * The change of the connections of the signals of an actor to the slots of other actors (see Node3D.connections): a
 * connection made, or one removed; the scene file saves them, the game making them when it builds the scene
 * */
pub class ConnectionsCommand over EditCommand {

    // The actor whose connections change
    let dmut _node: &Node3D;

    // The connections it gets
    let _connections: [NodeConnection];

    // The change, for the status bar
    let _what: [c8];

    // The connections it had
    let mut _old: [NodeConnection] = [];

    /**
     * @params:
     *    - node: the actor whose connections change
     *    - connections: all the connections it gets
     *    - what: the change, in a few words, for the status bar (`Connected pressed to open of door`)
     * */
    pub self (dmut node: &Node3D, connections: [NodeConnection], what: [c8])
        with _node = alias node
        , _connections = connections
        , _what = what
    {}

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        self._old = self._node.connections;
        self._node.connections = self._connections;
        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        self._node.connections = self._old;
    }

    pub over describe(self)-> [c8] {
        self._what
    }

}
