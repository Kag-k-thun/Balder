in material;

use balder::core::error;
use balder::scene::asset::material_asset;
use balder::scene::editable;
use balder::scene::node::node3D::mesh_instance;
use balder::scene::property::value;

use std::stream;

/**
 * A change of an entry of a material asset (see MaterialAsset::entries), made in the material editor: the material goes
 * from the value it had to the one it gets, and the mesh nodes of the scene drawing it follow (see
 * MeshInstance3D::refresh), those of the documents not shown when they are shown again
 * @info: a material of a file is changed in the history of its own document, a material local to a scene file in the
 * history of its scene; the steps of one field merge into one command
 * */
pub class MaterialCommand over EditCommand {

    // The material changed
    let dmut _material: &MaterialAsset;

    // The entry changed, and its value before and after the change
    let _entry: [c8];
    let _before: PropertyValue;
    let mut _after: PropertyValue;

    // The field of the material editor the change was typed in, the steps of one field merging into one command, empty
    // for a change that merges with none
    let _field: [c8];

    /**
     * @params:
     *    - material: the material changed
     *    - entry: the name of the entry changed (see MaterialAsset::entries)
     *    - after: the value the entry gets
     *    - field: the field of the material editor the change was typed in, empty for a change that merges with none
     * */
    pub self (dmut material: &MaterialAsset, entry: [c8], after: PropertyValue, field: [c8] = "")
        with _material = alias material
        , _entry = entry
        , _before = material.value(entry)
        , _after = after
        , _field = field
    {}

    /**
     * @returns: the material changed
     * */
    @field
    pub fn material(self)-> &MaterialAsset {
        self._material
    }

    /**
     * @throws:
     *    - &BalderError: if the material has no such entry
     * */
    pub over apply(mut self, dmut scene: &EditableScene)-> bool
        throws BalderError
    {
        if self._before == self._after { return false; }
        if !self._material:.setValue(self._entry, self._after) {
            throw copy BalderError(f"A material has no entry '${self._entry}'");
        }

        MeshInstance3D::refreshUnder(alias scene:.getRootNode());
        true
    }

    pub over revert(mut self, dmut scene: &EditableScene) {
        self._material:.setValue(self._entry, self._before);
        MeshInstance3D::refreshUnder(alias scene:.getRootNode());
    }

    /**
     * A change of the same entry of the same material typed in the same field merges, the entry going from its value
     * before this change to its value after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let m: &MaterialCommand = next {
            if self._field.len == 0us || m._field != self._field || m._entry != self._entry { return false; }
            if !(m._material is self._material) { return false; }

            self._after = m._after;
            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        f"Changed the ${wordsOf(self._entry)} of ${self._material.name}"
    }

}

/**
 * @returns: the name of an entry in words, its dashes as spaces: `base color map`
 * */
fn wordsOf(name: [c8])-> [c8] {
    let dmut s = copy StringStream();
    for c in name {
        s:.write(if c == '-' { ' ' } else { c });
    }

    s[]
}
