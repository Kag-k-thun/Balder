in editor;

use balder_editor::{command, history, naming, scene_document};
use balder::core::application::signal;
use balder::core::error;
use balder::math::vector;
use balder::scene::{description, editable};
use balder::scene::node;
use balder::scene::node::node3D::{body, body_shape, mesh_instance};

/**
 * The editor of a scene, the one entry point of its changes: each change is a command (see EditCommand) given to
 * execute, which applies it and emits edited; the scene shows one document at a time (see SceneDocument), switchTo
 * showing another
 * @info:
 * =====
 * The editor keeps the history of the commands executed (EditHistory): undo reverts the last command applied, redo
 * applies again the last command undone, both emitting edited as execute does, so the outline, the inspector and the
 * status bar follow them as any change. A command executed after commands undone drops them; an open starts the history
 * again (see EditCommand::startsHistory). The steps of one field of the inspector merge into one command (see
 * EditCommand::merge), until an undo, a redo or a save. The position of the history when the scene was saved tells
 * whether it has unsaved changes. After each change, the bodies of a compound shape take again the volumes under them
 * (see refitCompounds).
 * ====
 * @info:
 * =====
 * The scene shown is played on a copy of its nodes (see play): its own nodes leave the scene, parked by its document as
 * when another document is shown, and the copy built from their description takes their place, its actors ticked and
 * its physics simulated, until stop drops it and puts them back as they were, whatever the game did to the copy. The
 * scene does not change while it is played: execute refuses the commands, undo and redo do nothing, and showing
 * another document stops the game first.
 * ====
 * */
pub class SceneEditor {

    // The scene edited
    let dmut _scene: &EditableScene;

    // The signal emitted with each command that changed the scene, executed, undone or redone
    let dmut _edited: &Signal!{&EditCommand} = copy Signal!{&EditCommand} ();

    // The history of the changes of the scene
    let dmut _history: &EditHistory;

    // The document shown, whose nodes are in the scene, the history being its own
    let dmut _document: &SceneDocument;

    // The signal emitted when another document is shown, and when the nodes of the scene are replaced by the nodes
    // played, or put back
    let dmut _switched: &Signal!{()} = copy Signal!{()} ();

    // True while the scene shown is played, its nodes parked by its document and a copy of them in the scene
    let mut _played: bool = false;

    /**
     * @params:
     *    - scene: the scene edited
     *    - document: the document shown first, its nodes in the scene
     * */
    pub self (dmut scene: &EditableScene, dmut document: &SceneDocument)
        with _scene = alias scene
        , _history = alias document.history
        , _document = alias document
    {}

    /**
     * @returns: the scene edited
     * */
    @field
    pub fn scene(mut self)-> dmut &EditableScene {
        alias self._scene
    }

    /**
     * @returns: the document shown, whose nodes are in the scene
     * */
    @field
    pub fn document(mut self)-> dmut &SceneDocument {
        alias self._document
    }

    /**
     * @returns: the document shown, whose nodes are in the scene
     * */
    @field
    pub fn document(self)-> &SceneDocument {
        self._document
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DOCUMENTS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Show another document: the nodes of the one shown leave the scene, kept by it with the nodes it had selected, and
     * the nodes of the other enter it, those it had selected selected again; the changes made from now on are kept in
     * its history, and switched is emitted
     * */
    pub fn switchTo(mut self, dmut document: &SceneDocument) {
        if document is self._document { return; }

        self:.stop();
        self._document:.park(alias self._scene);
        document:.unpark(alias self._scene);
        self._document = alias document;
        self._history = alias document.history;
        self._switched:.emit();
    }

    /**
     * @returns: the signal emitted when another document is shown, its nodes in the scene, and when the nodes of the
     * scene shown are replaced by the nodes played, or put back (see play)
     * */
    pub fn switched(mut self)-> dmut &Signal!{()} {
        alias self._switched
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          HISTORY          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Make a change of the scene, kept in the history, or merged into the last command executed (the steps of one field
     * of the inspector), edited being emitted when it changed the scene
     * @returns: true iif the scene changed
     * @throws:
     *    - &BalderError: if the change cannot be made, the message telling why
     * */
    pub fn execute(mut self, dmut command: &EditCommand)-> bool
        throws BalderError
    {
        if self._played { throw copy BalderError(SceneEditor::PLAYED); }
        if command.startsHistory() {
            // the nodes the commands before name are replaced, even when the command fails half way
            self._history:.clear();
        }

        if !command:.apply(alias self._scene) { return false; }

        if command.startsHistory() {
            self._history:.restart();
        } else {
            self._history:.push(alias command);
        }

        self._history:.setChange(command.describe());
        self:.refitCompounds();
        self._edited:.emit(command);
        true
    }

    /**
     * Revert the last command applied, edited being emitted with it
     * @returns: true iif a command was undone, false when there is none to undo or while the scene is played
     * */
    pub fn undo(mut self)-> bool {
        if self._played { return false; }
        let dmut command = if let Ok(dmut c) = alias self._history:.back() { alias c } else { return false; };
        command:.revert(alias self._scene);

        self._history:.setChange("Undone: " ~ command.describe());
        self:.refitCompounds();
        self._edited:.emit(command);
        true
    }

    /**
     * Apply again the last command undone, edited being emitted with it
     * @returns: true iif a command was redone, false when there is none to redo, when it changed nothing, or while the
     * scene is played
     * @throws:
     *    - &BalderError: if the change cannot be made again (a model whose file is gone...), the command staying undone
     * */
    pub fn redo(mut self)-> bool
        throws BalderError
    {
        if self._played { return false; }
        let dmut command = if let Ok(dmut c) = alias self._history:.next() { alias c } else { return false; };
        if !command:.apply(alias self._scene) { return false; }

        self._history:.forward();
        self._history:.setChange("Redone: " ~ command.describe());
        self:.refitCompounds();
        self._edited:.emit(command);
        true
    }

    /**
     * Mark the scene as saved as it stands, the unsaved changes being those made from now on
     * */
    pub fn markSaved(mut self) {
        self._history:.markSaved();
    }

    /**
     * Mark the scene as changed since it was saved, whatever its history: a scene rebuilt from a description of its
     * nodes holding unsaved changes (see GameLibraryBehavior's reload)
     * */
    pub fn markUnsaved(mut self) {
        self._history:.markUnsaved();
    }

    /**
     * @returns: the command undo reverts, none when there is none
     * */
    @field
    pub fn toUndo(self)-> (&EditCommand)? {
        self._history.toUndo
    }

    /**
     * @returns: the command redo applies again, none when there is none
     * */
    @field
    pub fn toRedo(self)-> (&EditCommand)? {
        self._history.toRedo
    }

    /**
     * @returns: true iif the scene changed since it was opened or saved last, the history being elsewhere
     * */
    @field
    pub fn unsaved(self)-> bool {
        self._history.unsaved
    }

    /**
     * @returns: the last change of the scene, in a few words, for the status bar: the command executed, undone or redone
     * */
    @field
    pub fn change(self)-> [c8] {
        self._history.change
    }

    /**
     * @returns: the signal emitted with each command that changed the scene, executed, undone or redone
     * */
    pub fn edited(mut self)-> dmut &Signal!{&EditCommand} {
        alias self._edited
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          PLAYING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iif the scene shown is played, a copy of its nodes in the scene (see play)
     * */
    @field
    pub fn played(self)-> bool {
        self._played
    }

    /**
     * @returns: true iif the scene shown is played but paused, its actors and its physics waiting
     * */
    @field
    pub fn paused(self)-> bool {
        self._played && !self._scene.playing
    }

    /**
     * @returns: the node the nodes of the scene shown hang from: the root of the scene, or the root its document parks
     * them under while it is played, the nodes of the scene being the nodes played
     * */
    pub fn editedRoot(mut self)-> dmut &Node {
        if self._played { return alias self._document:.parkedRoot(); }
        alias self._scene:.getRootNode()
    }

    /**
     * Play the scene shown: its nodes leave the scene, parked by its document with the nodes it has selected, and a
     * copy of them built from their description takes their place, its actors ticked and its physics simulated from the
     * next tick; switched is emitted
     * @returns: the nodes played, under the root of the scene, in order
     * @throws:
     *    - &BalderError: if the nodes cannot be described or built, the scene staying as it is
     * */
    pub fn play(mut self)-> dmut [&Node3D]
        throws BalderError
    {
        if self._played { throw copy BalderError("The scene is played already"); }

        // the materials local to the file stay those of the cache, the nodes played drawing with the nodes edited
        let edited = copy SceneDescription(alias self._scene:.getRootNode());
        let copied = copy SceneDescription(edited.nodes);

        self._document:.park(alias self._scene);
        let dmut built: [&Node3D] = [];
        {
            built = alias copied.build(alias self._scene:.getRootNode());
        } catch {
            err: &BalderError => {
                self:.dropPlayed();
                self._document:.unpark(alias self._scene);
                throw err;
            }
        }

        self._played = true;
        self._scene.playing = true;
        self._switched:.emit();
        alias built
    }

    /**
     * Pause the game played, its actors and its physics waiting, or play it again
     * */
    pub fn pause(mut self, paused: bool) {
        if self._played { self._scene.playing = !paused; }
    }

    /**
     * Play the game paused for one tick, its actors ticked and its physics stepped once
     * */
    pub fn step(mut self) {
        if self.paused { self._scene:.step(); }
    }

    /**
     * Stop playing the scene shown: the nodes played are dropped, whatever the game did to them, and the nodes of the
     * scene put back as they were left, with the nodes they had selected; switched is emitted
     * */
    pub fn stop(mut self) {
        if !self._played { return; }

        self._scene.playing = false;
        self._played = false;
        self:.dropPlayed();
        self._document:.unpark(alias self._scene);
        self._switched:.emit();
    }

    /**
     * Drop the nodes under the root of the scene, the nodes of the editor staying
     * */
    fn dropPlayed(mut self) {
        let dmut selection = alias self._scene.selection;
        selection:.clear();

        let dmut root = alias self._scene:.getRootNode();
        let dmut played: [&Node] = [];
        for dmut n in alias root:.getChildrenInOrder() if !isEditorNode(n) {
            played ~= [alias n];
        }

        for dmut n in alias played { n:.dispose(); }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          PLACEMENT          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: where a node added goes: the point of the surface seen at the centre of the image, or the point the
     * camera looks at when there is none there
     * @params:
     *    - lookedAt: the point the camera looks at
     * */
    pub fn placement(mut self, lookedAt: vec3)-> vec3 {
        let center = makeVec2(cast!f32(self._scene.width) / 2.0f, cast!f32(self._scene.height) / 2.0f);
        if let Ok(ray) = self._scene.rayThroughPixel(center) {
            if let Ok(dmut hit) = alias self._scene:.pick(center) {
                if let Ok(d) = hit:.raycast(ray) {
                    return ray.at(d);
                }
            }
        }

        lookedAt
    }

    /**
     * @returns: where a node dropped on a pixel of the image goes: the point of the surface seen there, or else the
     * ground (y = 0) seen there, or else the point of the ray through the pixel as far from the eye as the point the
     * camera looks at
     * @params:
     *    - pixel: the pixel, in the resolution the scene is rendered at
     *    - lookedAt: the point the camera looks at
     * */
    pub fn placementAt(mut self, pixel: vec2, lookedAt: vec3)-> vec3 {
        let ray = if let Ok(r) = self._scene.rayThroughPixel(pixel) { r } else { return lookedAt; };
        if let Ok(dmut hit) = alias self._scene:.pick(pixel) {
            if let Ok(d) = hit:.raycast(ray) {
                return ray.at(d);
            }
        }

        if ray.direction.y < -1.0e-4f && ray.origin.y > 0.0f {
            return ray.at(-ray.origin.y / ray.direction.y);
        }

        ray.origin + ray.direction * (lookedAt - ray.origin).length()
    }

    /**
     * @returns: the mesh node of the scene seen at a pixel of the image and the index of its part seen there, none when
     * no mesh node is seen there
     * @params:
     *    - pixel: the pixel, in the resolution the scene is rendered at
     * */
    pub fn partAt(mut self, pixel: vec2)-> dmut (&MeshInstance3D, usize)? {
        let dmut hit = if let Ok(dmut h) = alias self._scene:.pick(pixel) { alias h } else { return none; };
        if let Ok(dmut parent) = alias hit:.getParent() {
            if let dmut mesh: &MeshInstance3D = alias parent {
                for i, d in mesh.draws if d is hit {
                    return (alias mesh, i)?;
                }
            }
        }

        none
    }

    /**
     * Give each body of a compound shape the volumes under it as they are now, those moved, reshaped, added or removed
     * by a change; a compound left without a volume keeps the parts it had
     * */
    fn refitCompounds(mut self) {
        let dmut nodes: [&Node] = [];
        self._scene:.getRootNode():.getAllNodes(ref nodes);
        for dmut n in alias nodes if let dmut b: &PhysicsBody3D = alias n {
            if let Ok(d) = b.described && d.kind == BodyShapeKind::COMPOUND {
                {
                    b:.reshape(d);
                } catch {
                    _ => {}
                }
            }
        }
    }

}

@companion
pub mod SceneEditor {

    // What the status bar tells of a change asked while the scene is played
    pub def PLAYED = "The scene is played: stop the game to change it";

}
