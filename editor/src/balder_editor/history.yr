in history;

use balder_editor::command;

/**
 * The history of the changes of a scene: the commands executed, in order, those applied before its position and those
 * undone from it, the position it had when the scene was saved last, and the last change in a few words
 * @info: the SceneEditor applies and reverts the commands, the history only keeps them: a command executed after
 * commands undone drops them, the steps of one field of the inspector merge into the last command until an undo, a redo
 * or a save, and the scene has unsaved changes while the history is not where it was at the last save, or for good once
 * the commands undone past that save are dropped
 * */
pub class EditHistory {

    // The commands executed, in order: those before the position are applied, those from it undone, to be redone
    let dmut _commands: [&EditCommand] = [];

    // The number of commands of the history applied
    let mut _position: usize = 0us;

    // The position of the history when the scene was opened or saved last, none once the commands undone since were
    // dropped, the scene saved being out of reach
    let mut _saved: (usize)? = (0us)?;

    // True when the last command applied takes in the next one executed (see EditCommand::merge), false after an
    // undo, a redo or a save
    let mut _merging: bool = false;

    // The last change of the scene, in a few words
    let mut _change: [c8] = "";

    /**
     * An empty history, of a scene saved as it stands
     * */
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHANGES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Drop every command, the scene being replaced (an open, see EditCommand::startsHistory), the scene saved being out
     * of reach until the replacement is made
     * */
    pub fn clear(mut self) {
        self._commands = [];
        self._position = 0us;
        self._saved = none;
        self._merging = false;
    }

    /**
     * Start again from a scene saved as it stands, every command dropped
     * */
    pub fn restart(mut self) {
        self:.clear();
        self._saved = (0us)?;
    }

    /**
     * Keep a command applied, merged into the last one when it takes it in, the commands undone being dropped; the next
     * command executed may merge into it
     * */
    pub fn push(mut self, dmut command: &EditCommand) {
        if !self:.mergeIntoLast(command) {
            if let Ok(s) = self._saved {
                if s > self._position { self._saved = none; }
            }

            let dmut kept: [&EditCommand] = [];
            for i in 0us .. self._position {
                kept ~= [alias self._commands[i]];
            }

            self._commands = alias kept ~ [alias command];
            self._position += 1us;
        }

        self._merging = true;
    }

    /**
     * Step back over the last command applied, to revert it
     * @returns: the command, none when there is none to undo
     * */
    pub fn back(mut self)-> dmut (&EditCommand)? {
        if self._position == 0us { return none; }

        self._position -= 1us;
        self._merging = false;
        (alias self._commands[self._position])?
    }

    /**
     * Step forward over the last command undone, once it is applied again
     * */
    pub fn forward(mut self) {
        if self._position == self._commands.len { return; }

        self._position += 1us;
        self._merging = false;
    }

    /**
     * Mark the scene as saved as it stands, the unsaved changes being those made from now on
     * */
    pub fn markSaved(mut self) {
        self._saved = (self._position)?;
        self._merging = false;
    }

    /**
     * Mark the scene as changed since it was saved, whatever its history (a scene rebuilt from a description of its
     * nodes holding unsaved changes)
     * */
    pub fn markUnsaved(mut self) {
        self._saved = none;
        self._merging = false;
    }

    /**
     * Stop merging the next command executed into the last one
     * */
    pub fn endMerge(mut self) {
        self._merging = false;
    }

    /**
     * Tell the last change of the scene, for the status bar
     * */
    pub fn setChange(mut self, change: [c8]) {
        self._change = change;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the command undo reverts, none when there is none
     * */
    @field
    pub fn toUndo(self)-> (&EditCommand)? {
        if self._position == 0us { return none; }
        (self._commands[self._position - 1us])?
    }

    /**
     * @returns: the command redo applies again, none when there is none
     * */
    @field
    pub fn toRedo(self)-> (&EditCommand)? {
        if self._position == self._commands.len { return none; }
        (self._commands[self._position])?
    }

    /**
     * @returns: the command redo applies again, none when there is none
     * */
    pub fn next(mut self)-> dmut (&EditCommand)? {
        if self._position == self._commands.len { return none; }
        (alias self._commands[self._position])?
    }

    /**
     * @returns: true iif the scene changed since it was opened or saved last, the history being elsewhere
     * */
    @field
    pub fn unsaved(self)-> bool {
        if let Ok(s) = self._saved {
            return s != self._position;
        }

        true
    }

    /**
     * @returns: true iif the history holds no command, the scene never changed
     * */
    @field
    pub fn isEmpty(self)-> bool {
        self._commands.len == 0us
    }

    /**
     * @returns: the last change of the scene, in a few words: the command executed, undone or redone
     * */
    @field
    pub fn change(self)-> [c8] {
        self._change
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Merge a command applied into the last one executed, when it takes it in
     * @returns: true iif the command is merged
     * */
    fn mergeIntoLast(mut self, command: &EditCommand)-> bool {
        if !self._merging || self._position == 0us || self._position != self._commands.len { return false; }

        self._commands[self._position - 1us]:.merge(command)
    }

}
