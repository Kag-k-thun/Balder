/**
 * The editor of Balder, a library: Balder's own editor (editor/bin) runs it, and so does the editor of a project, its
 * actor classes linked in with the library of its game (see the template of the projects)
 * */
in balder_editor;

mod ::activity;
mod ::arguments;
mod ::command;
mod ::editor;
mod ::ground_grid;
mod ::hulls_panel;
mod ::inspector_panel;
mod ::manager;
mod ::naming;
mod ::orbit;
mod ::outline;
mod ::outline_panel;
mod ::project;
mod ::viewport;

use balder_editor::{activity, arguments, manager, project};
use balder::core::{_, application::_};
use balder::utils::{log, path};

use std::fs;
use std::io;

/**
 * Run the editor on the command line given, its project manager or the editor of a project
 * @params:
 *    - args: the command line, its first element being the program
 *    - defaultProject: the project opened when the command line names none, empty for the project manager
 *    - engine: the directory of the engine when the command line gives none, empty for the current directory
 * */
pub fn runEditor(args: [[c8]], defaultProject: [c8], engine: [c8]) {
    if !readArguments(args, defaultProject, engine) { return; }

    let project = startProject();
    if project.len != 0us && !Project::isProject(project) {
        eprintln(f"balder-editor: no project in ${project}, its ${Project::FILE} is missing");
        return;
    }

    {
        let dmut app = copy Application();
        if project.len == 0us {
            app:.open!{&ProjectManagerActivity} (copy BalderConfig(editorFile("manager.toml")));
        } else {
            setProjectPath(Path(project));
            app:.open!{&EditorActivity} (copy BalderConfig(editorFile("editor.toml")));
        }

        app:.run();
    } catch {
        err => {
            log::error #("Editor", "Failed to open the editor", err);
        }
    }
}
