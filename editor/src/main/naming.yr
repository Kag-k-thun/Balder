in naming;

use balder::scene::description::node_description;
use balder::scene::node;

/**
 * @returns: true iif a node belongs to the editor (its camera, the gizmo), named __...__ (see isReservedName): it is
 * neither shown in the outline, nor removed with the scene, nor saved
 * */
pub fn isEditorNode(node: &Node)-> bool {
    isReservedName(node.name.file())
}

/**
 * @returns: a name no child of a node has, the name given when it is free, or its base followed by the first free number
 * (cube, cube_2, cube_3...)
 * @params:
 *    - parent: the node the named node goes under
 *    - name: the name wanted
 * */
pub fn freeName(dmut parent: &Node, name: [c8])-> [c8] {
    let dmut parents = copy [alias parent];
    freeNameAmong(alias parents, name)
}

/**
 * @returns: a name no child of some nodes has, the name given when it is free, or its base followed by the first free
 * number (see freeName)
 * @params:
 *    - parents: the nodes, a node moving under one renamed under the other before it moves (see ReparentCommand)
 *    - name: the name wanted
 * */
pub fn freeNameAmong(dmut parents: [&Node], name: [c8])-> [c8] {
    if !isTaken(alias parents, name) { return name; }

    let base = baseName(name);
    let mut i = 2us;
    while isTaken(alias parents, base ~ "_" ~ std::conv::to!{[c8]} (i)) {
        i += 1us;
    }

    base ~ "_" ~ std::conv::to!{[c8]} (i)
}

/**
 * @returns: true iif a child of one of some nodes has a name
 * */
fn isTaken(dmut parents: [&Node], name: [c8])-> bool {
    for dmut p in alias parents {
        if p:.getChilds()[name].hasValue { return true; }
    }

    false
}

/**
 * @returns: a name without the number it ends with after an underscore, cube for cube_3
 * */
fn baseName(name: [c8])-> [c8] {
    let mut end = name.len;
    while end > 0us && name[end - 1us] >= '0'c8 && name[end - 1us] <= '9'c8 {
        end -= 1us;
    }

    if end > 1us && end < name.len && name[end - 1us] == '_'c8 {
        return name[0us .. end - 1us];
    }

    name
}
