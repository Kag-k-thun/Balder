in framing;

use balder::core::error;
use balder::scene::node::node3D::camera;

/**
 * The settings of a camera the inspector edits, as its setters take them (see Camera): its field of view (a perspective
 * camera), the height of its view (an orthographic camera) and the planes it sees between
 * */
pub record CameraSettings {

    // The vertical field of view of a perspective camera, in degrees
    pub let fov: f32;

    // The height of the view of an orthographic camera, in world units
    pub let size: f32;

    // The distances from the camera to the planes it sees between
    pub let near: f32;
    pub let far: f32;

    /**
     * The settings of a camera as it stands, a perspective camera keeping the size of the view by default and an
     * orthographic one the field of view by default
     * */
    pub self (cam: &Camera)
        with fov = (if let p: &PerspectiveCamera = cam { p.fov } else { 60.0f })
        , size = (if let o: &OrthoCamera = cam { o.size } else { 10.0f })
        , near = cam.near
        , far = cam.far
    {}

    pub self (fov: f32, size: f32, near: f32, far: f32)
        with fov = fov
        , size = size
        , near = near
        , far = far
    {}

    /**
     * Give the settings to a camera, the field of view to a perspective one and the size of the view to an orthographic
     * one
     * */
    pub fn applyTo(self, dmut cam: &Camera) {
        cam.near = self.near;
        cam.far = self.far;
        if let dmut p: &PerspectiveCamera = alias cam { p.fov = self.fov; }
        if let dmut o: &OrthoCamera = alias cam { o.size = self.size; }
    }

    /**
     * @throws:
     *    - &BalderError: if a camera of the settings would see nothing: a near plane not in front of it, a far plane not
     *                    past the near one, a field of view not between 0 and 180 degrees, or a view of no height
     * */
    pub fn check(self)
        throws BalderError
    {
        if self.near <= 0.0f { throw copy BalderError("The near plane of a camera must be in front of it"); }
        if self.far <= self.near { throw copy BalderError("The far plane of a camera must be past its near plane"); }
        if self.fov <= 0.0f || self.fov >= 180.0f {
            throw copy BalderError("The field of view of a camera must be between 0 and 180 degrees");
        }

        if self.size <= 0.0f { throw copy BalderError("The view of an orthographic camera must have a height"); }
    }

}
