in recent;

use main::project::recent_project;
use balder::core::error;
use balder::utils::log;

use std::{config, env, fs};
use std::time;
use std::time::date;

/**
 * The projects the editor opened, the one opened last first, with the scene of each edited last, kept for the user in
 * the file of the recent projects (see RecentProjects::defaultFile):
 * ```
 * location = "/home/me/games"
 *
 * [[project]]
 * directory = "/home/me/games/my_game"
 * opened = "2026-11-19T21:11:16+00:00"
 * scene = "res:/scenes/main.scene"
 * ```
 * @info: the location is the directory the last project was created in, where the next one is proposed; a list is read
 * again before each change, the project manager and the editor changing the same file
 * */
pub class RecentProjects {

    // The file the projects are kept in
    let _file: [c8];

    // The projects, the one opened last first
    let mut _projects: [RecentProject] = [];

    // The directory the last project was created in, empty when none was
    let mut _location: [c8] = "";

    /**
     * Read the recent projects of a file, none when it does not exist yet, or when it cannot be read (logged)
     * @params:
     *    - file: the file the projects are kept in
     * */
    pub self (file: [c8] = RecentProjects::defaultFile())
        with _file = file
    {
        if !isFile(Path(file)) { return; }

        {
            let cfg = utils::readToml(file);
            self._location = utils::stringOf(cfg, "location", file, optional-> true);
            if let Ok(tables: &Array) = cfg["project"]? {
                for t in tables[] {
                    self._projects ~= [RecentProject(directory-> utils::stringOf(t, "directory", file),
                                                     opened-> utils::stringOf(t, "opened", file, optional-> true),
                                                     scene-> utils::stringOf(t, "scene", file, optional-> true))];
                }
            }
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to read the recent projects", err);
                self._projects = [];
            }
        }
    }

    /**
     * @returns: the projects, the one opened last first
     * */
    @field
    pub fn projects(self)-> [RecentProject] {
        self._projects
    }

    /**
     * @returns: the directory the last project was created in, empty when none was
     * */
    @field
    pub fn location(self)-> [c8] {
        self._location
    }

    /**
     * @returns: the scene of a project edited last, empty when none was, or when the project is not in the list
     * @params:
     *    - directory: the absolute path of the directory of the project
     * */
    pub fn sceneOf(self, directory: [c8])-> [c8] {
        for p in self._projects if p.directory == directory {
            return p.scene;
        }

        ""
    }

    /**
     * Put a project first in the list, opened now, keeping the scene edited last
     * @params:
     *    - directory: the absolute path of the directory of the project
     * */
    pub fn opened(mut self, directory: [c8]) {
        let mut entry = RecentProject(directory-> directory);
        let mut others: [RecentProject] = [];
        for p in self._projects {
            if p.directory == directory { entry.scene = p.scene; } else { others ~= [p]; }
        }

        entry.opened = DateTime(Instant::now()).format(fmt-> DateFormat::ISO8601);
        self._projects = [entry] ~ others;
    }

    /**
     * Keep the scene of a project edited last, the project being opened now when it is not in the list
     * @params:
     *    - directory: the absolute path of the directory of the project
     *    - scene: the path of the scene (res:/…)
     * */
    pub fn edited(mut self, directory: [c8], scene: [c8]) {
        if self._projects.len == 0us || self._projects[0].directory != directory {
            self:.opened(directory);
        }

        let mut first = self._projects[0];
        first.scene = scene;
        self._projects = [first] ~ self._projects[1us .. $];
    }

    /**
     * Take a project out of the list, its files staying where they are
     * */
    pub fn remove(mut self, directory: [c8]) {
        let mut kept: [RecentProject] = [];
        for p in self._projects if p.directory != directory {
            kept ~= [p];
        }

        self._projects = kept;
    }

    /**
     * Change the directory the last project was created in
     * */
    pub fn setLocation(mut self, directory: [c8]) {
        self._location = directory;
    }

    /**
     * Write the file of the recent projects, its directory created when it does not exist
     * @throws:
     *    - &BalderError: if the file cannot be written
     * */
    pub fn save(self)
        throws BalderError
    {
        let dir = Path(self._file).parent();
        if !isDir(dir) {
            {
                createDir(dir, recursive-> true);
            } catch {
                _: &FsError => {
                    throw copy BalderError(f"Not created: ${dir.toStr()}");
                }
            }
        }

        utils::writeFile(self._file, self.content());
    }

    /**
     * @returns: the content of the file of the recent projects
     * */
    pub fn content(self)-> [c8] {
        let mut text = "# The projects the editor of Balder opened, the one opened last first\n";
        if self._location.len != 0us {
            text ~= f"location = ${utils::quoted(self._location)}\n";
        }

        for p in self._projects {
            text ~= f"\n[[project]]\ndirectory = ${utils::quoted(p.directory)}\n";
            if p.opened.len != 0us { text ~= f"opened = ${utils::quoted(p.opened)}\n"; }
            if p.scene.len != 0us { text ~= f"scene = ${utils::quoted(p.scene)}\n"; }
        }

        text
    }

}

/**
 * The file of the recent projects
 * */
pub mod RecentProjects {

    /**
     * @returns: the file the recent projects are kept in, balder/projects.toml under the configuration directory of the
     * user (XDG base directory)
     * */
    pub fn defaultFile()-> [c8] {
        let config = unsafe { env::getVar("XDG_CONFIG_HOME") };
        if config != "" { return config ~ "/balder/projects.toml"; }

        let home = unsafe { env::getVar("HOME") };
        home ~ "/.config/balder/projects.toml"
    }

}
