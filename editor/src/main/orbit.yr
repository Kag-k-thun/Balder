in orbit;

use balder::math::{_, bounds};
use balder::scene::node::node3D::camera;

use std::math;
use std::algorithm::comparison;

// The pitch the eye stops at, short of the poles where the view would turn over, in radian
def MAX_PITCH = 1.55f;

// The distances between the eye and the point it turns around, in units
def MIN_DISTANCE = 0.05f;
def MAX_DISTANCE = 10000.0f;

// The distance the eye looks at a node without volume from (a light...)
def POINT_DISTANCE = 4.0f;

/**
 * The eye of the camera of the editor, turning around a point it looks at
 * @info: the eye sits at a distance from the point, turned by its yaw around the vertical axis (0 from +z) and raised by
 * its pitch above the horizon; the image of the scene mirrors the X axis, the right of the screen being -x for an eye
 * on +z (see right)
 * */
@data
pub record OrbitView {

    // The point the eye turns around and looks at
    pub let mut target: vec3 = vec3();

    // The distance between the eye and the target
    pub let mut distance: f32 = 12.0f;

    // The angle of the eye around the vertical axis through the target, in radian, 0 from +z
    pub let mut yaw: f32 = 0.6f;

    // The angle of the eye above the horizon of the target, in radian
    pub let mut pitch: f32 = 0.45f;

    pub self () {}

    /**
     * @returns: the position of the eye
     * */
    pub fn eye(self)-> vec3 {
        let away = makeVec3(math::cos(self.pitch) * math::sin(self.yaw),
                            math::sin(self.pitch),
                            math::cos(self.pitch) * math::cos(self.yaw));
        self.target + away * self.distance
    }

    /**
     * @returns: the direction toward the right of the image of the scene
     * */
    pub fn right(self)-> vec3 {
        makeVec3(-math::cos(self.yaw), 0.0f, math::sin(self.yaw))
    }

    /**
     * @returns: the direction toward the top of the image of the scene
     * */
    pub fn up(self)-> vec3 {
        makeVec3(-math::sin(self.pitch) * math::sin(self.yaw),
                 math::cos(self.pitch),
                 -math::sin(self.pitch) * math::cos(self.yaw))
    }

    /**
     * Turn the eye around the target, as if the scene were grabbed and dragged
     * @params:
     *    - dx: the move toward the right, in radian
     *    - dy: the move toward the bottom, in radian
     * */
    pub fn orbit(mut self, dx: f32, dy: f32) {
        self.yaw += dx;
        self.pitch = clamp(self.pitch + dy, -MAX_PITCH, MAX_PITCH);
    }

    /**
     * Slide the eye and the target across the view, the scene following the cursor
     * @params:
     *    - dx: the move toward the right, in shares of the distance to the target
     *    - dy: the move toward the bottom, in shares of the distance to the target
     * */
    pub fn pan(mut self, dx: f32, dy: f32) {
        self.target = self.target - self.right() * (dx * self.distance) + self.up() * (dy * self.distance);
    }

    /**
     * Bring the eye closer to the target, or farther from it
     * @params:
     *    - notches: the notches of the wheel, positive to come closer
     * */
    pub fn zoom(mut self, notches: i32) {
        let factor = math::pow(0.85f, cast!f32(notches));
        self.distance = clamp(self.distance * factor, MIN_DISTANCE, MAX_DISTANCE);
    }

    /**
     * Look at a box from a distance it is seen whole at, a box of a single point from a few units
     * */
    pub fn frame(mut self, box: Aabb) {
        if box.isEmpty { return; }

        let radius = box.extent.length();
        self.target = box.center;
        self.distance = if radius <= 0.0f { POINT_DISTANCE } else { clamp(radius * 3.0f, MIN_DISTANCE, MAX_DISTANCE) };
    }

    /**
     * Place a camera at the eye, looking at the target
     * */
    pub fn applyTo(self, dmut camera: &Camera) {
        camera.position = self.eye();
        camera.target = self.target;
    }

}
