in inspector_panel;

use main::{command, editor, lighting, outline};
use main::command::{light, marker, path, rename, transform, volume};
use balder::core::application::signal;
use balder::core::error;
use balder::interface;
use balder::interface::widget;
use balder::interface::loader::registry::behavior;
use balder::interface::widget::button::{check, dropdown};
use balder::interface::widget::text::_;
use balder::math::{_, utils};
use balder::scene::edit;
use balder::scene::edit::volume_edit;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{light, marker, path, path_point, transform, volume, volume_shape};

// The path of the inspector in the interface of the editor, then of its panels, of an object, a light, a marker, a path
// and a volume
def INSPECTOR = "BODY/MAIN/INSPECTOR";
def OBJECT = "BODY/MAIN/INSPECTOR/OBJECT";
def LIGHT = "BODY/MAIN/INSPECTOR/LIGHT";
def MARKER = "BODY/MAIN/INSPECTOR/MARKER";
def PATH = "BODY/MAIN/INSPECTOR/PATH";
def VOLUME = "BODY/MAIN/INSPECTOR/VOLUME";

// The rows of the transform in the panel of an object, then the fields of the axes in each row
def ROWS = ["POSITION", "ROTATION", "SCALE"];
def AXES = ["X", "Y", "Z"];

// The class of a panel or of a row the node inspected does not use, displayed none (see inspector.style)
def ABSENT = "absent";

// The settings of a light a field of its panel changes (see withSetting)
def SET_DIRECTION = 0u32;
def SET_COLOR = 1u32;
def SET_INTENSITY = 2u32;
def SET_RANGE = 3u32;
def SET_INNER = 4u32;
def SET_OUTER = 5u32;
def SET_SHADOWS = 6u32;

// The settings of a volume a field of its panel changes (see withVolumeSetting)
def SET_SHAPE = 0u32;
def SET_SIZE = 1u32;
def SET_RADIUS = 2u32;
def SET_HEIGHT = 3u32;

/**
 * The items of the dropdowns of the inspector, in their order in inspector.gui: the purposes of a marker, the curves of
 * a path, the shapes of a volume
 * */
enum Purposes
| GENERIC  = (0us, MarkerPurpose::GENERIC)
| SPAWN    = (1us, MarkerPurpose::SPAWN)
| WAYPOINT = (2us, MarkerPurpose::WAYPOINT)
| SOCKET   = (3us, MarkerPurpose::SOCKET);

enum Curves
| CATMULL_ROM = (0us, CurveKind::CATMULL_ROM)
| BEZIER      = (1us, CurveKind::BEZIER);

enum Shapes
| BOX     = (0us, VolumeKind::BOX)
| SPHERE  = (1us, VolumeKind::SPHERE)
| CAPSULE = (2us, VolumeKind::CAPSULE);

/**
 * The inspector of the node selected last, on the right of the editor, mounted under the behavior 'inspector': its name,
 * then the panel of its kind, in fields refreshed when the node moves. The panel of an object (a mesh, a model,
 * an empty, a marker, a path, a point of a path, a volume) holds its position, its rotation (in degrees) and its scale;
 * the panel of a light its position, its direction, its colour, its intensity, its range, its cone and its shadows, the
 * fields its type does not use being absent. Under the panel of an object, a marker has the panel of its purpose and
 * its tags, a path the panel of its curve and of whether it is closed, a volume the panel of its shape, the fields its
 * shape does not use being absent
 * @info: a name validated renames the node inspected; a field changed gives its value to every node selected of the
 * kind of the panel, each keeping its other settings; every change goes through the commands of the editor, the steps
 * of one field merging into one command
 * */
pub class InspectorPanel over Behavior {

    // The interface holding the fields
    let dmut _gui: &WidgetManager;

    // The mailbox the slots of the selection and of the node inspected are emitted in
    let dmut _box: &SlotEmitter;

    // Shows a message in the status bar
    let _status: dg ([c8])-> void;

    // The editor of the scene, once bound
    let dmut _editor: (&SceneEditor)? = none;

    // The node inspected, the one selected last, none when none is
    let dmut _node: (&Node3D)? = none;

    /**
     * @params:
     *    - gui: the interface holding the fields
     *    - box: the mailbox the slots of the selection and of the node inspected are emitted in
     *    - status: shows a message in the status bar
     * */
    pub self (dmut gui: &WidgetManager, dmut box: &SlotEmitter, status: dg ([c8])-> void)
        with _gui = alias gui
        , _box = alias box
        , _status = status
    {
        self:.slot("renamed", &self:.onRenamed);
        self:.slot("moved", &self:.onMoved);
        self:.slot("turned", &self:.onTurned);
        self:.slot("scaled", &self:.onScaled);
        self:.slot("aimed", &self:.onAimed);
        self:.slot("colored", &self:.onColored);
        self:.slot("intensified", &self:.onIntensified);
        self:.slot("ranged", &self:.onRanged);
        self:.slot("narrowed", &self:.onNarrowed);
        self:.slot("widened", &self:.onWidened);
        self:.slot("shadowed", &self:.onShadowed);
        self:.slot("purposed", &self:.onPurposed);
        self:.slot("tagged", &self:.onTagged);
        self:.slot("curved", &self:.onCurved);
        self:.slot("closed", &self:.onClosed);
        self:.slot("shaped", &self:.onShaped);
        self:.slot("sized", &self:.onSized);
        self:.slot("rounded", &self:.onRounded);
        self:.slot("heightened", &self:.onHeightened);
    }

    /**
     * Inspect the nodes selected in the scene of an editor, once the interface is loaded
     * */
    pub fn bind(mut self, dmut editor: &SceneEditor) {
        let dmut scene = alias editor.scene;
        let dmut selection = alias scene.selection;
        selection:.changed():.connect(alias self._box, &self:.onSelectionChanged);
        editor:.edited():.connect(alias self._box, &self:.onEdited);
        self._editor = (alias editor)?;

        self:.onSelectionChanged();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          INSPECTING          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Inspect the node selected last
     * */
    fn onSelectionChanged(mut self) {
        let dmut last: (&Node3D)? = none;
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            let dmut selection = alias scene.selection;
            let dmut nodes = alias selection.nodes;
            if nodes.len != 0us {
                last = (alias nodes[$ - 1us])?;
            }
        }

        self:.inspect(alias last);
    }

    /**
     * Refresh the fields after a command, a renaming changing the name shown
     * */
    fn onEdited(mut self, _: &EditCommand) {
        self:.refresh();
    }

    /**
     * Inspect a node, its fields refreshed each time it moves
     * */
    fn inspect(mut self, dmut node: (&Node3D)?) {
        if let Ok(dmut old) = alias self._node {
            old:.transformationChanged():.disconnect(&self:.refresh);
        }

        if let Ok(dmut n) = alias node {
            n:.transformationChanged():.connect(alias self._box, &self:.refresh);
        }

        self._node = alias node;
        self:.refresh();
    }

    /**
     * Write the name and the settings of the node inspected in the fields, without emitting their signals, the panel of
     * its kind present and the other absent
     * */
    fn refresh(mut self) {
        let (kind, name) = if let Ok(n) = self._node { (kindOf(n), n.name.file()) } else { ("Nothing selected", "") };
        if let Ok(dmut l: &Label) = self._gui:.find(INSPECTOR ~ "/KIND") {
            l:.setText(kind);
        }

        if let Ok(dmut input: &InputText) = self._gui:.find(INSPECTOR ~ "/NAME") {
            input:.setText(name);
        }

        let isLight = if let Ok(_: &Light) = self._node { true } else { false };
        self:.setPresent(OBJECT, self._node.hasValue && !isLight);
        self:.setPresent(LIGHT, isLight);
        self:.setPresent(MARKER, if let Ok(_: &Marker3D) = self._node { true } else { false });
        self:.setPresent(PATH, if let Ok(_: &Path3D) = self._node { true } else { false });
        self:.setPresent(VOLUME, if let Ok(_: &Volume3D) = self._node { true } else { false });

        if let Ok(l: &Light) = self._node {
            self:.refreshLight(l);
        } else if let Ok(n) = self._node {
            self:.refreshObject(n);
        }

        if let Ok(m: &Marker3D) = self._node {
            self:.refreshMarker(m);
        } else if let Ok(p: &Path3D) = self._node {
            self:.refreshPath(p);
        } else if let Ok(v: &Volume3D) = self._node {
            self:.refreshVolume(v);
        }
    }

    /**
     * Write the purpose and the tags of a marker in its panel, the tags separated by spaces
     * */
    fn refreshMarker(mut self, marker: &Marker3D) {
        cte for p in Purposes::__members__ {
            if p._1 == marker.purpose { self:.setChoice(MARKER ~ "/PURPOSE", p._0); }
        }

        let mut text = "";
        for i, t in marker.tags {
            text = if i == 0us { t } else { text ~ " " ~ t };
        }

        if let Ok(dmut input: &InputText) = self._gui:.find(MARKER ~ "/TAGS") {
            input:.setText(text);
        }
    }

    /**
     * Write the curve of a path and whether it is closed in its panel
     * */
    fn refreshPath(mut self, path: &Path3D) {
        cte for c in Curves::__members__ {
            if c._1 == path.curveKind { self:.setChoice(PATH ~ "/CURVE", c._0); }
        }

        if let Ok(dmut c: &CheckBox) = self._gui:.find(PATH ~ "/CLOSED") {
            c:.setChecked(path.closed);
        }
    }

    /**
     * Write the shape of a volume in its panel, the rows its shape does not use absent
     * */
    fn refreshVolume(mut self, volume: &Volume3D) {
        let shape = volume.shape;
        cte for k in Shapes::__members__ {
            if k._1 == shape.kind { self:.setChoice(VOLUME ~ "/SHAPE", k._0); }
        }

        self:.setPresent(VOLUME ~ "/SIDES", shape.kind == VolumeKind::BOX);
        self:.setPresent(VOLUME ~ "/RADIUS", shape.kind != VolumeKind::BOX);
        self:.setPresent(VOLUME ~ "/HEIGHT", shape.kind == VolumeKind::CAPSULE);

        self:.setAxes(VOLUME ~ "/SIDES/SIZE", shape.size);
        self:.setNumber(VOLUME ~ "/RADIUS", shape.radius);
        self:.setNumber(VOLUME ~ "/HEIGHT", shape.height);
    }

    /**
     * Select an item of a dropdown, without emitting its signal
     * */
    fn setChoice(mut self, path: [c8], index: usize) {
        if let Ok(dmut d: &Dropdown) = self._gui:.find(path) {
            d:.setSelected(index);
        }
    }

    /**
     * Write the transform of an object in its panel
     * */
    fn refreshObject(mut self, node: &Node3D) {
        let r = node.rotation;
        let values = [node.position, makeVec3(degree(r.x), degree(r.y), degree(r.z)), node.scale];
        for i, row in ROWS {
            self:.setAxes(OBJECT ~ "/" ~ row, values[i]);
        }
    }

    /**
     * Write the settings of a light in its panel, the rows its type does not use absent
     * */
    fn refreshLight(mut self, light: &Light) {
        let type = light.type;
        self:.setPresent(LIGHT ~ "/PLACE", type != LightType::DIRECTION);
        self:.setPresent(LIGHT ~ "/AIM", type != LightType::POINT);
        self:.setPresent(LIGHT ~ "/RANGE", type != LightType::DIRECTION);
        self:.setPresent(LIGHT ~ "/CONE", type == LightType::SPOT);

        self:.setAxes(LIGHT ~ "/PLACE/POSITION", light.position);
        self:.setAxes(LIGHT ~ "/AIM/DIRECTION", light.direction);
        self:.setAxes(LIGHT ~ "/COLOR", light.color);
        self:.setNumber(LIGHT ~ "/INTENSITY", light.intensity);
        self:.setNumber(LIGHT ~ "/RANGE", light.range);
        self:.setNumber(LIGHT ~ "/CONE/INNER", light.innerAngle);
        self:.setNumber(LIGHT ~ "/CONE/OUTER", light.outerAngle);

        if let Ok(dmut c: &CheckBox) = self._gui:.find(LIGHT ~ "/SHADOWS") {
            c:.setChecked(light.castShadow);
        }
    }

    /**
     * Write a vector in a row of three spin boxes (see AxisRow)
     * */
    fn setAxes(mut self, row: [c8], value: vec3) {
        for j, axis in AXES {
            if let Ok(dmut s: &SpinBox) = self._gui:.find(row ~ "/" ~ axis) {
                s:.setValue(component(value, j));
            }
        }
    }

    /**
     * Write a number in the spin box of a row (see NumberRow)
     * */
    fn setNumber(mut self, row: [c8], value: f32) {
        if let Ok(dmut s: &SpinBox) = self._gui:.find(row ~ "/VALUE") {
            s:.setValue(value);
        }
    }

    /**
     * Make a panel or a row present, or absent, taking no room
     * */
    fn setPresent(mut self, path: [c8], present: bool) {
        if let Ok(dmut w) = alias self._gui:.find(path) {
            let mut classes: [[c8]] = [];
            for c in w.getClasses() if c != ABSENT {
                classes ~= [c];
            }

            if !present { classes ~= [ABSENT]; }
            w:.setClasses(classes);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          EDITING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The name was validated: the node inspected is renamed
     * */
    fn onRenamed(mut self, name: [c8]) {
        if let Ok(dmut n) = alias self._node {
            self:.run(copy RenameCommand(alias n, name));
        }

        // a name refused is written back
        self:.refresh();
    }

    /**
     * A field of the position changed: every node selected takes the value along its axis
     * @params:
     *    - axis: 0 for X, 1 for Y, 2 for Z
     * */
    fn onMoved(mut self, axis: u32, value: f32) {
        self:.transformSelection(0u32, axis, value);
    }

    /**
     * A field of the rotation changed, in degrees: every node selected takes the angle along its axis
     * */
    fn onTurned(mut self, axis: u32, value: f32) {
        self:.transformSelection(1u32, axis, radian(value));
    }

    /**
     * A field of the scale changed: every node selected takes the factor along its axis
     * */
    fn onScaled(mut self, axis: u32, value: f32) {
        self:.transformSelection(2u32, axis, value);
    }

    /**
     * A field of the direction of a light changed: every light selected takes the value along its axis
     * */
    fn onAimed(mut self, axis: u32, value: f32) {
        self:.editLights(SET_DIRECTION, axis, value);
    }

    /**
     * A field of the colour of a light changed, 0 for its red, 1 for its green, 2 for its blue
     * */
    fn onColored(mut self, axis: u32, value: f32) {
        self:.editLights(SET_COLOR, axis, value);
    }

    fn onIntensified(mut self, value: f32) {
        self:.editLights(SET_INTENSITY, 0u32, value);
    }

    fn onRanged(mut self, value: f32) {
        self:.editLights(SET_RANGE, 0u32, value);
    }

    fn onNarrowed(mut self, value: f32) {
        self:.editLights(SET_INNER, 0u32, value);
    }

    fn onWidened(mut self, value: f32) {
        self:.editLights(SET_OUTER, 0u32, value);
    }

    fn onShadowed(mut self, casts: bool) {
        self:.editLights(SET_SHADOWS, 0u32, if casts { 1.0f } else { 0.0f });
    }

    /**
     * An item of the purpose of a marker was chosen: every marker selected marks it
     * */
    fn onPurposed(mut self, index: usize) {
        cte for p in Purposes::__members__ {
            if p._0 == index {
                let dmut markers = alias self:.selectedMarkers();
                if markers.len != 0us { self:.run(copy MarkerCommand(alias markers, purpose-> (p._1)?)); }
            }
        }

        self:.refresh();
    }

    /**
     * The tags of a marker were validated: every marker selected takes them, the words of the text
     * */
    fn onTagged(mut self, text: [c8]) {
        let dmut markers = alias self:.selectedMarkers();
        if markers.len != 0us { self:.run(copy MarkerCommand(alias markers, tags-> (wordsOf(text))?)); }

        self:.refresh();
    }

    /**
     * An item of the curve of a path was chosen: every path selected goes through its points that way
     * */
    fn onCurved(mut self, index: usize) {
        cte for c in Curves::__members__ {
            if c._0 == index {
                let dmut paths = alias self:.selectedPaths();
                if paths.len != 0us { self:.run(copy PathCommand(alias paths, curveKind-> (c._1)?)); }
            }
        }

        self:.refresh();
    }

    /**
     * The box of a closed path was toggled: every path selected is closed, or opened
     * */
    fn onClosed(mut self, closed: bool) {
        let dmut paths = alias self:.selectedPaths();
        if paths.len != 0us { self:.run(copy PathCommand(alias paths, closed-> closed?)); }

        self:.refresh();
    }

    /**
     * An item of the shape of a volume was chosen: every volume selected takes that shape, its sizes kept
     * */
    fn onShaped(mut self, index: usize) {
        cte for k in Shapes::__members__ {
            if k._0 == index { self:.editVolumes(SET_SHAPE, 0u32, 0.0f, k._1); }
        }
    }

    /**
     * A field of the size of a box changed: every volume selected takes the side along its axis
     * */
    fn onSized(mut self, axis: u32, value: f32) {
        self:.editVolumes(SET_SIZE, axis, value, VolumeKind::BOX);
    }

    fn onRounded(mut self, value: f32) {
        self:.editVolumes(SET_RADIUS, 0u32, value, VolumeKind::BOX);
    }

    fn onHeightened(mut self, value: f32) {
        self:.editVolumes(SET_HEIGHT, 0u32, value, VolumeKind::BOX);
    }

    /**
     * Give each volume selected a value of a setting of its shape, through a command, the other settings of each one
     * kept
     * @params:
     *    - setting: the setting changed, SET_SHAPE to SET_HEIGHT
     *    - axis: the component of the size of a box changed
     *    - value: the value of a size, a radius or a height
     *    - kind: the kind of shape a volume takes
     * */
    fn editVolumes(mut self, setting: u32, axis: u32, value: f32, kind: VolumeKind) {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };
        let dmut scene = alias e.scene;
        let dmut selection = alias scene.selection;

        let mut edits: [VolumeEdit] = [];
        for dmut n in alias selection.nodes {
            if let dmut v: &Volume3D = alias n {
                edits ~= [VolumeEdit(alias v, withVolumeSetting(v.shape, setting, axis, value, kind), NodeTransform(v))];
            }
        }

        if edits.len != 0us {
            self:.run(copy VolumeCommand(edits, field-> f"volume ${setting} ${axis}"));
        }

        // a value refused (a height under the diameter...) is written back
        self:.refresh();
    }

    /**
     * @returns: the markers selected, in a list of their own
     * */
    fn selectedMarkers(mut self)-> dmut [&Marker3D] {
        let dmut markers: [&Marker3D] = [];
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            let dmut selection = alias scene.selection;
            for dmut n in alias selection.nodes if let dmut m: &Marker3D = alias n {
                markers ~= [alias m];
            }
        }

        alias markers
    }

    /**
     * @returns: the paths selected, in a list of their own
     * */
    fn selectedPaths(mut self)-> dmut [&Path3D] {
        let dmut paths: [&Path3D] = [];
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            let dmut selection = alias scene.selection;
            for dmut n in alias selection.nodes if let dmut p: &Path3D = alias n {
                paths ~= [alias p];
            }
        }

        alias paths
    }

    /**
     * Give each light selected a value of a setting, through a command, the other settings of each one kept
     * @params:
     *    - setting: the setting changed, SET_DIRECTION to SET_SHADOWS
     *    - axis: the component of a vector (the direction, the colour) changed
     *    - value: the value, 0 or 1 for the shadows
     * */
    fn editLights(mut self, setting: u32, axis: u32, value: f32) {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };
        let dmut scene = alias e.scene;
        let dmut selection = alias scene.selection;

        let dmut lights: [&Light] = [];
        let mut settings: [LightSettings] = [];
        for dmut n in alias selection.nodes {
            if let dmut l: &Light = alias n {
                settings ~= [withSetting(LightSettings(l), setting, axis, value)];
                lights ~= [alias l];
            }
        }

        if lights.len != 0us {
            self:.run(copy LightCommand(alias lights, settings, field-> f"light ${setting} ${axis}"));
        }

        // a value refused (a null direction...) is written back
        self:.refresh();
    }

    /**
     * Give each node selected a value along an axis of its position, its rotation or its scale, through a command
     * @params:
     *    - row: 0 for the position, 1 for the rotation (in radian), 2 for the scale
     *    - axis: 0 for X, 1 for Y, 2 for Z
     * */
    fn transformSelection(mut self, row: u32, axis: u32, value: f32) {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };
        let dmut scene = alias e.scene;
        let dmut selection = alias scene.selection;

        let mut edits: [TransformEdit] = [];
        for dmut n in alias selection.nodes {
            let t = NodeTransform(n);
            let after = if row == 0u32 {
                NodeTransform(withComponent(t.position, axis, value), t.rotation, t.scale)
            } else if row == 1u32 {
                NodeTransform(t.position, withComponent(t.rotation, axis, value), t.scale)
            } else {
                NodeTransform(t.position, t.rotation, withComponent(t.scale, axis, value))
            };

            edits ~= [TransformEdit(alias n, after)];
        }

        if edits.len != 0us {
            self:.run(copy TransformCommand(edits, field-> f"transform ${row} ${axis}"));
        }
    }

    /**
     * Change the scene through the editor, telling in the status bar why the change failed
     * */
    fn run(mut self, dmut command: &EditCommand) {
        if let Ok(dmut e) = alias self._editor {
            {
                e:.execute(alias command);
            } catch {
                err: &BalderError => {
                    self._status(err.msg);
                }
            }
        }
    }

}

/**
 * @returns: a component of a vector, 0 for x, 1 for y, 2 for z
 * */
fn component(v: vec3, axis: usize)-> f32 {
    if axis == 0us { v.x } else if axis == 1us { v.y } else { v.z }
}

/**
 * @returns: a vector whose component along an axis is replaced
 * @params:
 *    - axis: 0 for x, 1 for y, 2 for z
 * */
fn withComponent(v: vec3, axis: u32, value: f32)-> vec3 {
    if axis == 0u32 {
        makeVec3(value, v.y, v.z)
    } else if axis == 1u32 {
        makeVec3(v.x, value, v.z)
    } else {
        makeVec3(v.x, v.y, value)
    }
}

/**
 * @returns: the settings of a light, one of them changed
 * @params:
 *    - setting: the setting changed, SET_DIRECTION to SET_SHADOWS
 *    - axis: the component changed of a vector setting (the direction, the colour)
 *    - value: the value, 0 or 1 for the shadows
 * */
fn withSetting(s: LightSettings, setting: u32, axis: u32, value: f32)-> LightSettings {
    LightSettings(if setting == SET_COLOR { withComponent(s.color, axis, value) } else { s.color },
                  if setting == SET_INTENSITY { value } else { s.intensity },
                  if setting == SET_DIRECTION { withComponent(s.direction, axis, value) } else { s.direction },
                  if setting == SET_RANGE { value } else { s.range },
                  if setting == SET_INNER { value } else { s.innerAngle },
                  if setting == SET_OUTER { value } else { s.outerAngle },
                  if setting == SET_SHADOWS { value != 0.0f } else { s.castShadow })
}

/**
 * @returns: the shape of a volume, one of its settings changed
 * @params:
 *    - setting: the setting changed, SET_SHAPE to SET_HEIGHT
 *    - axis: the component of the size of a box changed
 *    - value: the value of a size, a radius or a height
 *    - kind: the kind of shape, for SET_SHAPE
 * */
fn withVolumeSetting(s: VolumeShape, setting: u32, axis: u32, value: f32, kind: VolumeKind)-> VolumeShape {
    if setting == SET_SHAPE { return s.withKind(kind); }
    if setting == SET_SIZE { return VolumeShape(s.kind, withComponent(s.size, axis, value), s.radius, s.height); }
    if setting == SET_RADIUS { return VolumeShape(s.kind, s.size, value, s.height); }

    VolumeShape(s.kind, s.size, s.radius, value)
}

/**
 * @returns: the words of a text, separated by spaces, tabs or commas, the tags of a marker
 * */
fn wordsOf(text: [c8])-> [[c8]] {
    let mut words: [[c8]] = [];
    let mut start = 0us;
    for i in 0us .. text.len + 1us {
        let end = i == text.len || text[i] == ' ' || text[i] == '\t' || text[i] == ',';
        if end {
            if i > start { words ~= [text[start .. i]]; }
            start = i + 1us;
        }
    }

    words
}
