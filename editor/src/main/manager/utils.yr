in utils;

use main::project;

use std::time;
use std::time::date;

/**
 * @returns: the name of the project of a directory, a project missing or unreadable told as such
 * */
pub fn nameOf(directory: [c8])-> [c8] {
    if !Project::isProject(directory) { return "(missing)"; }

    {
        Project::open(directory).name
    } catch {
        _ => { "(unreadable)" }
    }
}

/**
 * @returns: the date a project was opened last, in the time zone of the machine, the text kept as it is when it is not a
 * date
 * @params:
 *    - opened: the date, in ISO 8601
 * */
pub fn openedText(opened: [c8])-> [c8] {
    if opened.len == 0us { return ""; }

    {
        let d = opened.to!{DateTime} ();
        DateTime(d.instant()).format(fmt-> "%Y-%m-%d %H:%M")
    } catch {
        _ => { opened }
    }
}

/**
 * @returns: the directory of a project as the table shows it, '~' standing for the home directory of the user
 * */
pub fn shownDirectory(directory: [c8])-> [c8] {
    let home = unsafe { std::env::getVar("HOME") };
    if home.len != 0us && directory.len > home.len && directory[0us .. home.len] == home && directory[home.len] == '/' {
        return "~" ~ directory[home.len .. $];
    }

    directory
}

/**
 * @returns: the home directory of the user, the root when it is not known
 * */
pub fn homeDirectory()-> [c8] {
    let home = unsafe { std::env::getVar("HOME") };
    if home != "" { home } else { "/" }
}
