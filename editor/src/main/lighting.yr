in lighting;

use balder::math::vector;
use balder::scene::node::node3D::light;

/**
 * The settings of a light the inspector edits, as its setters take them (see Light)
 * */
pub record LightSettings {

    // The colour of the light
    pub let color: vec3;

    // The intensity of the light
    pub let intensity: f32;

    // The direction a direction or a spot light shines along, before the rotation of its node
    pub let direction: vec3;

    // The distance a point or a spot light reaches
    pub let range: f32;

    // The angles between the axis of the cone of a spot light and the edges of its full light and of its light, in
    // degrees
    pub let innerAngle: f32;
    pub let outerAngle: f32;

    // True iif the light casts shadows
    pub let castShadow: bool;

    /**
     * The settings of a light as it stands
     * */
    pub self (light: &Light)
        with color = light.color
        , intensity = light.intensity
        , direction = light.direction
        , range = light.range
        , innerAngle = light.innerAngle
        , outerAngle = light.outerAngle
        , castShadow = light.castShadow
    {}

    pub self (color: vec3, intensity: f32, direction: vec3, range: f32, innerAngle: f32, outerAngle: f32, castShadow: bool)
        with color = color
        , intensity = intensity
        , direction = direction
        , range = range
        , innerAngle = innerAngle
        , outerAngle = outerAngle
        , castShadow = castShadow
    {}

    /**
     * Give the settings to a light, which registers it again in its scene when it starts or stops casting shadows
     * */
    pub fn applyTo(self, dmut light: &Light) {
        light.color = self.color;
        light.intensity = self.intensity;
        light.direction = self.direction;
        light.range = self.range;
        light.innerAngle = self.innerAngle;
        light.outerAngle = self.outerAngle;
        light.castShadow = self.castShadow;
    }

}
