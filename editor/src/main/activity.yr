in activity;

use main::{command, editor, inspector_panel, naming, outline_panel, project, viewport};
use main::command::{add, duplicate, open, remove, transform, volume};
use balder::core::{_, application::_};
use balder::interface::dialog;
use balder::interface::widget::{button::push, layout::d3scene, text::label, tree::view};
use balder::math::vector;
use balder::scene::{description::_, editable};
use balder::scene::gizmo::mode;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{light, marker, path, path_point, volume_shape};
use balder::scene::node::node3D::camera::flight;
use balder::utils::log;

use std::io;
use std::fs;

use ::sdl3::_;

// The scene a new scene starts from, under the directory of the editor
def NEW_SCENE = "scenes/new.scene";

// The extension of the scene files
def SCENE_EXTENSION = "scene";

// The paths of the items of the Edit menu undoing and redoing the changes
def UNDO_ITEM = "BAR/EDIT/UNDO";
def REDO_ITEM = "BAR/EDIT/REDO";

// The path of the item of the View menu showing and hiding the icons of the nodes without geometry
def ICONS_ITEM = "BAR/VIEW/ICONS";

// The class of an item of a menu with nothing to do, greyed (see editor.style)
def IDLE = "idle";

/**
 * What the editor does once the unsaved changes of the scene are saved or discarded
 * */
enum Pending : u8
| NOTHING = 0u8
| NEW     = 1u8
| OPEN    = 2u8
| QUIT    = 3u8;


/**
 * The editor of Balder: the outline of the scene on the left, the viewport in the middle, the inspector of the node
 * selected on the right, under a menu bar opening, saving, adding, copying and removing nodes, above a status bar
 * @info:
 * =====
 * Every change of the scene is a command run through the SceneEditor, which keeps their history; the viewport, focused
 * by a click, takes the keys W, E and R (the gizmo), Delete, Ctrl+D and F, the window Ctrl+Z (undo), Ctrl+Shift+Z and
 * Ctrl+Y (redo), Ctrl+S (save) and Ctrl+Shift+S (save as). The items Undo and Redo of the Edit menu name the change they
 * undo or redo.
 * The scene has unsaved changes while its history is not where it was at the last save (a change made, or undone),
 * shown in the title of the window and on the right of the status bar. A new scene, started from scenes/new.scene, has no file yet: its first save asks for one. New, Open
 * and Quit ask whether to save the changes first, or discard them, or do nothing.
 * ====
 * */
pub class EditorActivity over Activity {

    // The editor of the scene, once the interface is loaded
    let dmut _editor: (&SceneEditor)? = none;

    // The viewport of the scene, once the interface is loaded
    let dmut _viewport: (&EditorViewport)? = none;

    // The status bar
    let dmut _status: (&Label)? = none;

    // The label telling the file of the scene and whether it has unsaved changes
    let dmut _document: (&Label)? = none;

    // The directory of the file chosen last, the file dialogs starting from it
    let mut _directory: [c8] = "";

    // The file of the scene, where it is saved, empty for a new scene
    let mut _path: [c8] = "";

    // The speeds of the flights of the viewport in the scene files opened, by their path, each scene flown at its own
    let dmut _flightPaces: [[c8] => f32] = copy [];

    // What to do once the unsaved changes are saved or discarded
    let mut _pending: Pending = Pending::NOTHING;

    // True while a dialog of the editor asks something, the keys saving the scene and the quitting waiting for its
    // answer
    let mut _asking: bool = false;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onQuit);
        self.input:.keyPressed():.connect(self.box, &self:.onKey);
        self._directory = editorFile("scenes");

        // the slots the 'on-…' attributes of editor.gui name: the menus, the outline and the inspector
        self:.slot("scene::new", &self:.onNewClicked);
        self:.slot("scene::open", &self:.onOpenClicked);
        self:.slot("scene::save", &self:.onSaveClicked);
        self:.slot("scene::save-as", &self:.onSaveAsClicked);
        self:.slot("scene::quit", &self:.onQuitClicked);
        self:.slot("add::cube", &self:.onAddCube);
        self:.slot("add::sphere", &self:.onAddSphere);
        self:.slot("add::plane", &self:.onAddPlane);
        self:.slot("add::model", &self:.onAddModel);
        self:.slot("add::empty", &self:.onAddEmpty);
        self:.slot("add::marker", &self:.onAddMarker);
        self:.slot("add::spawn", &self:.onAddSpawnPoint);
        self:.slot("add::waypoint", &self:.onAddWaypoint);
        self:.slot("add::socket", &self:.onAddSocket);
        self:.slot("add::path", &self:.onAddPath);
        self:.slot("add::path-point", &self:.onAddPathPoint);
        self:.slot("add::box-volume", &self:.onAddBoxVolume);
        self:.slot("add::sphere-volume", &self:.onAddSphereVolume);
        self:.slot("add::capsule-volume", &self:.onAddCapsuleVolume);
        self:.slot("add::direction", &self:.onAddDirectionLight);
        self:.slot("add::point", &self:.onAddPointLight);
        self:.slot("add::spot", &self:.onAddSpotLight);
        self:.slot("edit::undo", &self:.onUndoClicked);
        self:.slot("edit::redo", &self:.onRedoClicked);
        self:.slot("edit::duplicate", &self:.onDuplicateClicked);
        self:.slot("edit::delete", &self:.onDeleteClicked);
        self:.slot("edit::frame", &self:.onFrameClicked);
        self:.slot("view::icons", &self:.onIconsClicked);
        self:.slot("gizmo::translate", &self:.onTranslateClicked);
        self:.slot("gizmo::rotate", &self:.onRotateClicked);
        self:.slot("gizmo::scale", &self:.onScaleClicked);

        let dmut outline = copy OutlinePanel(&self:.setStatus);
        self:.behavior("outline", alias outline);
        let dmut inspector = copy InspectorPanel(alias self.gui, alias self.box, &self:.setStatus);
        self:.behavior("inspector", alias inspector);

        self.gui:.getRegistry():.register(EditorViewport::schema());
        println(self.gui:.loadStyleFile(editorFile("ui/editor.style"))?);
        println(self.gui:.loadGUIFile(editorFile("ui/editor.gui"))?);

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/FOOT/STATUS") {
            self._status = (alias l)?;
        }

        if let Ok(dmut l: &Label) = self.gui:.find("BODY/FOOT/DOCUMENT") {
            self._document = (alias l)?;
        }

        if let Ok(dmut w: &Scene3DLayout) = self.gui:.find("BODY/MAIN/VIEW") {
            if let Ok(dmut s: &EditableScene) = alias w:.getScene() {
                let dmut e = copy SceneEditor(alias s);
                e:.edited():.connect(self.box, &self:.onEdited);
                self._editor = (alias e)?;
            }
        }

        if let Ok(dmut v: &EditorViewport) = self.gui:.find("BODY/MAIN/VIEW/GIZMO") {
            v:.keyPressed():.connect(self.box, &self:.onViewportKey);
            v:.transformed():.connect(self.box, &self:.onGizmoTransformed);
            v:.reshaped():.connect(self.box, &self:.onGizmoReshaped);
            self._viewport = (alias v)?;
        }

        if let Ok(dmut e) = alias self._editor {
            if let Ok(dmut t: &TreeView) = self.gui:.find("BODY/MAIN/OUTLINE/TREE") {
                if let Ok(dmut v) = alias self._viewport {
                    outline:.bind(alias t, alias e, alias v, alias self.box);
                }
            }

            inspector:.bind(alias e);
        } else {
            log::error #("Editor", "The viewport of the editor has no editable scene");
            return;
        }

        let scene = startScene();
        if scene.len == 0us {
            self:.openScene(editorFile(NEW_SCENE), fromTemplate-> true);
        } else {
            self:.openScene(scene);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SCENE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onNewClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::NEW); }
    }

    fn onOpenClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::OPEN); }
    }

    fn onSaveClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.save(); }
    }

    fn onSaveAsClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.saveAs(); }
    }

    fn onQuitClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.ask(Pending::QUIT); }
    }

    /**
     * The window is closed
     * */
    fn onQuit(mut self) {
        if !self._asking { self:.ask(Pending::QUIT); }
    }

    /**
     * The keys of the window: Ctrl+Z undoes the last change, Ctrl+Shift+Z and Ctrl+Y redo it, Ctrl+S saves the scene,
     * Ctrl+Shift+S saves it in another file
     * */
    fn onKey(mut self, key: SDL_Keycode, mods: SDL_Keymod) {
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        if !ctrl || self._asking { return; }

        let shift = (mods & SDL_KMOD_SHIFT) != 0u16;
        if (key == SDLK_Z && shift) || key == SDLK_Y {
            self:.redo();
        } else if key == SDLK_Z {
            self:.undo();
        } else if key == SDLK_S && shift {
            self:.saveAs();
        } else if key == SDLK_S {
            self:.save();
        }
    }

    /**
     * Replace the nodes of the scene by those of a scene file, the viewport looking at them
     * @params:
     *    - fromTemplate: true for the scene a new scene starts from, whose nodes take ids of their own and which is saved
     *                    in a file of its own
     * */
    fn openScene(mut self, path: [c8], fromTemplate: bool = false) {
        {
            let file = copy SceneDescription::fromFile(path);
            let description = if fromTemplate { file.withoutIds() } else { file };
            if self:.run(copy OpenCommand(description, if fromTemplate { "a new scene" } else { Path(path).file() })) {
                let opened = if fromTemplate { "" } else { path };
                self:.keepFlightPace(opened);
                self._path = opened;
            }
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to open the scene", err);
                self:.setStatus(err.msg);
            }
        }
    }

    /**
     * Keep the speed of the flights of the viewport in the scene left, and fly the scene opened at the speed it was
     * flown at, a scene not opened yet (or a new one) at the speed of a flight
     * @params:
     *    - opened: the path of the scene opened, empty for a new scene
     * */
    fn keepFlightPace(mut self, opened: [c8]) {
        if let Ok(dmut v) = alias self._viewport {
            if self._path.len != 0us {
                self._flightPaces[self._path] = v.flightPace;
            }

            v.flightPace = if let Ok(p) = self._flightPaces[opened] { p } else { CameraFlight().pace };
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SAVE          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Do something that drops the scene (open a new scene, open a scene file, quit), asking first whether to save its
     * unsaved changes, discard them or do nothing
     * */
    fn ask(mut self, then: Pending) {
        if !self.unsaved() {
            self:.proceed(then);
            return;
        }

        self._pending = then;
        let question = match then {
            Pending::NEW  => { "before starting a new scene?" }
            Pending::OPEN => { "before opening another scene?" }
            _             => { "before quitting?" }
        };

        let dmut d = copy MessageDialog(f"Save the changes to ${self.documentName()} ${question}", title-> "Unsaved changes",
                                        yes-> "Save", no-> "Discard", cancel-> "Cancel");
        d:.answered():.connect(self.box, &self:.onUnsavedAnswered);
        self:.openDialog(alias d);
    }

    /**
     * The unsaved changes are saved (the pending action following the save), discarded, or kept, nothing done
     * */
    fn onUnsavedAnswered(mut self, status: MessageDialogStatus) {
        self._asking = false;
        match status {
            MessageDialogStatus::YES => { self:.save(); }
            MessageDialogStatus::NO  => { self:.proceed(self._pending); }
            _ => {
                self._pending = Pending::NOTHING;
                self:.setStatus("Kept the unsaved changes");
            }
        }
    }

    /**
     * Do what was waiting for the unsaved changes to be saved or discarded
     * */
    fn proceed(mut self, then: Pending) {
        self._pending = Pending::NOTHING;
        match then {
            Pending::NEW  => { self:.openScene(editorFile(NEW_SCENE), fromTemplate-> true); }
            Pending::OPEN => { self:.chooseScene(); }
            Pending::QUIT => { self.app:.close(alias self); }
            _ => {}
        }
    }

    /**
     * Ask for the scene file to open
     * */
    fn chooseScene(mut self) {
        let dmut d = copy FileDialog(FileDialogMode::OPEN, directory-> self._directory, filters-> sceneExtensions(),
                                     title-> "Open a scene");
        d:.answered():.connect(self.box, &self:.onSceneChosen);
        self:.openDialog(alias d);
    }

    fn onSceneChosen(mut self, path: ([c8])?) {
        self._asking = false;
        if let Ok(p) = path {
            self._directory = Path(p).parent().toStr();
            self:.openScene(p);
        }
    }

    /**
     * Save the scene in its file, asking for one when it has none, then do what was waiting for the save
     * */
    fn save(mut self) {
        if self._path.len == 0us {
            self:.saveAs();
        } else if self:.write(self._path) {
            self:.proceed(self._pending);
        }
    }

    /**
     * Ask for the file to save the scene in, then save it there
     * */
    fn saveAs(mut self) {
        let name = if self._path.len == 0us { "scene." ~ SCENE_EXTENSION } else { Path(self._path).file() };
        let dmut d = copy FileDialog(FileDialogMode::SAVE, directory-> self._directory, filters-> sceneExtensions(),
                                     title-> "Save the scene", name-> name);
        d:.answered():.connect(self.box, &self:.onSaveChosen);
        self:.openDialog(alias d);
    }

    /**
     * The file to save the scene in is chosen, given the extension of the scene files when it has none, or the save is
     * cancelled, and with it what was waiting for it
     * */
    fn onSaveChosen(mut self, path: ([c8])?) {
        self._asking = false;
        if let Ok(chosen) = path {
            let p = if Path(chosen).extension() == SCENE_EXTENSION { chosen } else { chosen ~ "." ~ SCENE_EXTENSION };
            self._directory = Path(p).parent().toStr();
            if self:.write(p) {
                self:.proceed(self._pending);
            }
        } else {
            self._pending = Pending::NOTHING;
        }
    }

    /**
     * Write the scene in a file, which becomes its file
     * @returns: true iif the file is written, the status bar telling why it is not
     * */
    fn write(mut self, path: [c8])-> bool {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return false; };
        {
            let dmut scene = alias e.scene;
            let description = copy SceneDescription(alias scene:.getRootNode());
            description.save(path);
        } catch {
            err: &BalderError => {
                log::error #("Editor", "Failed to save the scene", err);
                self:.setStatus(err.msg);
                self._pending = Pending::NOTHING;
                return false;
            }
        }

        self._path = path;
        e:.markSaved();
        self:.showDocument();
        self:.setStatus("Saved " ~ Path(path).file());
        true
    }

    /**
     * Show the file of the scene and whether it has unsaved changes, in the title of the window and on the right of the
     * status bar
     * */
    fn showDocument(mut self) {
        let unsaved = self.unsaved();
        let name = self.documentName();
        let mark = if unsaved { "*" } else { "" };
        self.window:.setName(f"${name}${mark} - Balder editor");

        if let Ok(dmut l) = alias self._document {
            let file = if self._path.len == 0us { "New scene, not saved yet" } else { self._path };
            l:.setText(if unsaved { file ~ " — unsaved changes" } else { file });
        }
    }

    /**
     * @returns: true iif the scene has changes not saved, its history not being where it was at the last save
     * */
    fn unsaved(self)-> bool {
        if let Ok(e) = self._editor { e.unsaved } else { false }
    }

    /**
     * @returns: the name of the scene, the name of its file, or 'the new scene'
     * */
    fn documentName(self)-> [c8] {
        if self._path.len == 0us { "the new scene" } else { Path(self._path).file() }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          ADD          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onAddCube(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addPrimitive("cube", NodeKind::CUBE); }
    }

    fn onAddSphere(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addPrimitive("sphere", NodeKind::SPHERE); }
    }

    fn onAddPlane(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addPrimitive("plane", NodeKind::PLANE); }
    }

    fn onAddEmpty(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.add(NodeDescription("empty", NodeKind::EMPTY), lift-> 0.0f);
        }
    }

    fn onAddMarker(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("marker", MarkerPurpose::GENERIC); }
    }

    fn onAddSpawnPoint(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("spawn", MarkerPurpose::SPAWN); }
    }

    fn onAddWaypoint(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("waypoint", MarkerPurpose::WAYPOINT); }
    }

    fn onAddSocket(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.addMarker("socket", MarkerPurpose::SOCKET); }
    }

    /**
     * Add a path of three points, a curve from the left to the right bending away from the eye
     * */
    fn onAddPath(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut path = NodeDescription("path", NodeKind::PATH);
        let places = [makeVec3(-2.0f, 0.0f, 0.0f), makeVec3(0.0f, 0.0f, -1.5f), makeVec3(2.0f, 0.0f, 0.0f)];
        for i, at in places {
            let mut point = NodeDescription(if i == 0us { "point" } else { f"point_${i + 1us}" }, NodeKind::PATH_POINT);
            point.position = at;
            path.children ~= [point];
        }

        self:.add(path, lift-> 0.5f);
    }

    /**
     * Insert a point in the path selected after its last point, or in the path of the point selected right after it
     * (see insertedPoint), the status bar telling when no path is selected
     * */
    fn onAddPathPoint(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut nodes = alias self:.selectedNodes();
        if nodes.len != 0us {
            let dmut last = alias nodes[$ - 1us];
            if let dmut p: &Path3D = alias last {
                self:.insertPoint(alias p, none);
                return;
            }

            if let dmut point: &PathPoint3D = alias last {
                if let Ok(dmut parent) = alias point:.getParent() {
                    if let dmut p: &Path3D = alias parent {
                        self:.insertPoint(alias p, point.index?);
                        return;
                    }
                }
            }
        }

        self:.setStatus("Select a path, or a point of a path, to insert a point in it");
    }

    /**
     * Insert a point in a path after one of its points, halfway to the next one, or a step past the last one
     * @params:
     *    - after: the place among the children of the path of the point the new one follows, none for its last point
     * */
    fn insertPoint(mut self, dmut path: &Path3D, after: (usize)?) {
        let points = path.points();
        let mut i = if points.len == 0us { 0us } else { points.len - 1us };
        if let Ok(a) = after {
            for k, p in points if p.index == a { i = k; }
        }

        let mut d = NodeDescription("point", NodeKind::PATH_POINT);
        let mut at = LAST_PLACE;
        if points.len != 0us {
            let from = points[i];
            d.position = insertedPoint(points, i, path.closed);
            d.rotation = from.rotation;
            d.scale = from.scale;
            at = from.index + 1us;
        }

        self:.run(copy AddCommand(d, alias path, at-> at));
    }

    fn onAddBoxVolume(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.addVolume("box", VolumeShape(), lift-> 0.5f);
        }
    }

    fn onAddSphereVolume(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.addVolume("sphere_volume", VolumeShape().withKind(VolumeKind::SPHERE), lift-> 0.5f);
        }
    }

    fn onAddCapsuleVolume(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.addVolume("capsule", VolumeShape().withKind(VolumeKind::CAPSULE), lift-> 1.0f);
        }
    }

    /**
     * Add a marker of a purpose, on the surface seen at the centre of the viewport
     * */
    fn addMarker(mut self, name: [c8], purpose: MarkerPurpose) {
        let mut d = NodeDescription(name, NodeKind::MARKER);
        d.purpose = purpose;
        self:.add(d, lift-> 0.0f);
    }

    /**
     * Add a volume of a shape, standing on the surface seen at the centre of the viewport
     * @params:
     *    - lift: the half height of the shape, its centre above that surface
     * */
    fn addVolume(mut self, name: [c8], shape: VolumeShape, lift: f32) {
        let mut d = NodeDescription(name, NodeKind::VOLUME);
        d.volume = shape;
        self:.add(d, lift-> lift);
    }

    fn onAddModel(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let dmut d = copy FileDialog(FileDialogMode::OPEN, directory-> self._directory, filters-> modelExtensions(),
                                     title-> "Add a model");
        d:.answered():.connect(self.box, &self:.onModelChosen);
        self:.openDialog(alias d);
    }

    fn onModelChosen(mut self, path: ([c8])?) {
        if let Ok(p) = path {
            self._directory = Path(p).parent().toStr();

            let mut model = NodeDescription(Path(p).stripExtension().file(), NodeKind::MODEL);
            model.file = p;
            self:.add(model, lift-> 0.0f);
        }
    }

    fn onAddDirectionLight(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut sun = NodeDescription("sun", NodeKind::LIGHT);
        sun.direction = makeVec3(-0.3f, -1.0f, -0.2f);
        self:.add(sun, lift-> 3.0f);
    }

    fn onAddPointLight(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut lamp = NodeDescription("lamp", NodeKind::LIGHT);
        lamp.light = LightType::POINT;
        lamp.intensity = 5.0f;
        lamp.range = 8.0f;
        self:.add(lamp, lift-> 2.0f);
    }

    fn onAddSpotLight(mut self, b: u8) {
        if b != SDL_BUTTON_LEFT { return; }

        let mut spot = NodeDescription("spot", NodeKind::LIGHT);
        spot.light = LightType::SPOT;
        spot.intensity = 25.0f;
        spot.range = 15.0f;
        self:.add(spot, lift-> 4.0f);
    }

    /**
     * Add a cube, a sphere or a plane, a little grey and rough
     * */
    fn addPrimitive(mut self, name: [c8], kind: NodeKind) {
        let mut d = NodeDescription(name, kind);
        d.material.baseColor = makeVec3(0.8f, 0.8f, 0.8f);
        d.material.roughness = 0.6f;
        self:.add(d, lift-> 0.0f);
    }

    /**
     * Add a node under the root of the scene, on the surface seen at the centre of the viewport, or at the point the
     * camera looks at when there is none
     * @params:
     *    - lift: the height of the node above that point (a light hanging over it...)
     * */
    fn add(mut self, description: NodeDescription, lift: f32) {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };
        let lookedAt = if let Ok(v) = self._viewport { v.orbit.target } else { vec3() };

        let mut d = description;
        d.position = e:.placement(lookedAt) + makeVec3(0.0f, lift, 0.0f);

        let dmut scene = alias e.scene;
        self:.run(copy AddCommand(d, alias scene:.getRootNode()));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          EDIT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onUndoClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.undo(); }
    }

    fn onRedoClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.redo(); }
    }

    /**
     * Undo the last change of the scene
     * */
    fn undo(mut self) {
        if let Ok(dmut e) = alias self._editor {
            if !e:.undo() { self:.setStatus("Nothing to undo"); }
        }
    }

    /**
     * Redo the last change undone, telling in the status bar why it failed
     * */
    fn redo(mut self) {
        if let Ok(dmut e) = alias self._editor {
            {
                if !e:.redo() { self:.setStatus("Nothing to redo"); }
            } catch {
                err: &BalderError => {
                    log::error #("Editor", "The change could not be redone", err);
                    self:.setStatus(err.msg);
                }
            }
        }
    }

    fn onDuplicateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.duplicateSelection(); }
    }

    fn onDeleteClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.deleteSelection(); }
    }

    fn onFrameClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.frameSelection(); }
    }

    fn duplicateSelection(mut self) {
        let dmut nodes = alias self:.selectedNodes();
        if nodes.len != 0us {
            self:.run(copy DuplicateCommand(alias nodes));
        }
    }

    fn deleteSelection(mut self) {
        let dmut nodes = alias self:.selectedNodes();
        if nodes.len != 0us {
            self:.run(copy RemoveCommand(alias nodes));
        }
    }

    /**
     * Look at the nodes selected, or at every node of the scene when none is
     * */
    fn frameSelection(mut self) {
        let dmut nodes = alias self:.selectedNodes();
        if nodes.len == 0us {
            if let Ok(dmut e) = alias self._editor {
                let dmut scene = alias e.scene;
                for _, dmut c in alias scene:.getRootNode():.getChilds() if let dmut n: &Node3D = alias c {
                    if !isEditorNode(n) { nodes ~= [alias n]; }
                }
            }
        }

        if let Ok(dmut v) = alias self._viewport {
            v:.frame(alias nodes);
        }
    }

    /**
     * @returns: the nodes selected, in a list of their own
     * */
    fn selectedNodes(mut self)-> dmut [&Node3D] {
        let dmut nodes: [&Node3D] = [];
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            let dmut selection = alias scene.selection;
            for dmut n in alias selection.nodes {
                nodes ~= [alias n];
            }
        }

        alias nodes
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          VIEW          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onIconsClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.toggleIcons(); }
    }

    /**
     * Hide the icons of the nodes without geometry in the viewport, or show them, the item of the View menu telling
     * what it does next
     * */
    fn toggleIcons(mut self) {
        if let Ok(dmut v) = alias self._viewport {
            v.showsIcons = !v.showsIcons;
            if let Ok(dmut item: &PushButton) = self.gui:.find(ICONS_ITEM) {
                item:.setText(if v.showsIcons { "Hide the icons" } else { "Show the icons" });
            }

            self:.setStatus(if v.showsIcons { "Showing the icons" } else { "Hiding the icons" });
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          GIZMO          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onTranslateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.setGizmoMode(GizmoMode::TRANSLATE); }
    }

    fn onRotateClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.setGizmoMode(GizmoMode::ROTATE); }
    }

    fn onScaleClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT { self:.setGizmoMode(GizmoMode::SCALE); }
    }

    fn setGizmoMode(mut self, mode: GizmoMode) {
        if let Ok(dmut v) = alias self._viewport {
            v.mode = mode;
        }
    }

    /**
     * A drag of the gizmo moved the nodes selected: the change is recorded as a command
     * */
    fn onGizmoTransformed(mut self) {
        if let Ok(v) = self._viewport {
            self:.run(copy TransformCommand(v.edits, applied-> true));
        }
    }

    /**
     * A drag of a face of a volume changed its shape: the change is recorded as a command
     * */
    fn onGizmoReshaped(mut self) {
        if let Ok(v) = self._viewport {
            if let Ok(e) = v.volumeEdit {
                self:.run(copy VolumeCommand(copy [e], applied-> true));
            }
        }
    }

    /**
     * The keys the viewport takes besides those of the gizmo: Delete removes the nodes selected, Ctrl+D copies them, F
     * looks at them
     * */
    fn onViewportKey(mut self, key: SDL_Keycode, mods: SDL_Keymod) {
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        if key == SDLK_DELETE || key == SDLK_BACKSPACE {
            self:.deleteSelection();
        } else if key == SDLK_D && ctrl {
            self:.duplicateSelection();
        } else if key == SDLK_F && !ctrl {
            self:.frameSelection();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          COMMANDS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Change the scene through the editor, telling in the status bar why the change failed
     * @returns: true iif the scene changed
     * */
    fn run(mut self, dmut command: &EditCommand)-> bool {
        if let Ok(dmut e) = alias self._editor {
            {
                return e:.execute(alias command);
            } catch {
                err: &BalderError => {
                    log::error #("Editor", "The change failed", err);
                    self:.setStatus(err.msg);
                }
            }
        }

        false
    }

    /**
     * Tell in the status bar the last change of the scene, executed, undone or redone, whether the scene has unsaved
     * changes, and in the Edit menu the changes to undo and to redo
     * */
    fn onEdited(mut self, _: &EditCommand) {
        if let Ok(e) = self._editor {
            self:.setStatus(e.change);
        }

        self:.showDocument();
        self:.showHistory();
    }

    /**
     * Name in the items Undo and Redo of the Edit menu the changes they undo and redo, greying an item with nothing to do
     * */
    fn showHistory(mut self) {
        let (undo, redo) = if let Ok(e) = self._editor {
            (if let Ok(c) = e.toUndo { c.describe() } else { "" }, if let Ok(c) = e.toRedo { c.describe() } else { "" })
        } else {
            ("", "")
        };

        self:.showHistoryItem(UNDO_ITEM, "Undo", undo, "Ctrl+Z");
        self:.showHistoryItem(REDO_ITEM, "Redo", redo, "Ctrl+Shift+Z");
    }

    /**
     * Name in an item of the Edit menu the change it undoes or redoes, the item being greyed when there is none
     * @params:
     *    - action: Undo or Redo
     *    - change: the change, empty when there is none
     *    - keys: the shortcut of the item
     * */
    fn showHistoryItem(mut self, path: [c8], action: [c8], change: [c8], keys: [c8]) {
        if let Ok(dmut item: &PushButton) = self.gui:.find(path) {
            if change.len == 0us {
                item:.setText(f"${action} (${keys})");
                item:.setClasses(copy ["item", IDLE]);
            } else {
                item:.setText(f"${action}: ${change} (${keys})");
                item:.setClasses(copy ["item"]);
            }
        }
    }

    /**
     * Open a dialog over the editor, the editor asking something until its answer
     * */
    fn openDialog(mut self, dmut d: &Dialog) {
        {
            d:.open(DialogMode::OVERLAY, alias self.gui);
            self._asking = true;
        } catch {
            err => {
                log::error #("Editor", "Failed to open the dialog", err);
                self:.setStatus("The dialog could not be opened");
            }
        }
    }

    fn setStatus(mut self, msg: [c8]) {
        if let Ok(dmut status) = alias self._status {
            status:.setText(msg);
        }
    }
}

/**
 * @returns: the extensions of the scene files, the files the dialog opening a scene lists
 * */
fn sceneExtensions()-> [[c8]] {
    copy [SCENE_EXTENSION]
}

/**
 * @returns: where a point inserted in a path after one of its points goes, in the space of the path: halfway to the next
 * point, to the first one past the last point of a closed path; a step past the last point of an open path, the step
 * from the point before it, one unit along X for a path of one point
 * @params:
 *    - points: the points of the path, in their order
 *    - i: the index among them of the point the new one follows
 * */
fn insertedPoint(points: [&PathPoint3D], i: usize, closed: bool)-> vec3 {
    let p = points[i].position;
    if i + 1us < points.len {
        return (p + points[i + 1us].position) / 2.0f;
    }

    if points.len < 2us { return p + makeVec3(1.0f, 0.0f, 0.0f); }
    if closed { return (p + points[0].position) / 2.0f; }

    p + (p - points[i - 1us].position)
}

/**
 * @returns: the extensions of the models the importer reads, the files the dialog adding a model lists
 * */
fn modelExtensions()-> [[c8]] {
    copy ["gltf", "glb", "obj", "fbx", "dae", "ply", "stl"]
}
