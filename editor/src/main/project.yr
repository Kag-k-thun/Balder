in project;

use balder::utils::path;

use std::{config::_, io};
use std::fs::path;

/**
 * The scene file the editor opens at the start, set by '--scene', empty for a new scene
 * */
lazy mut __SCENE__: [mut [c8]] = copy [""];

/**
 * @returns: the path of a file of the editor, under the project directory
 * */
pub fn editorFile(name: [c8])-> [c8] {
    getProjectPath().push("editor").push(name).toStr()
}

/**
 * @returns: the scene file the editor opens at the start, empty for a new scene
 * */
pub fn startScene()-> [c8] {
    __SCENE__[0]
}

/**
 * Read the command line, '--work-dir' moving the project directory the 'res:/' and 'shaders:/' paths are resolved
 * against, '--scene' naming the scene file to open
 * @returns: false iif the application must not start
 * */
pub fn readArguments(args: [[c8]])-> bool {
    let dmut parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("work-dir", comments-> "the directory holding res/ and editor/ (the current directory by default)")
        :.option!{[c8]} ("scene", comments-> "the scene file to open (a new scene by default)");

    {
        let cfg = parser.parse(args);
        if let Ok(Str(value-> dir)) = cfg["work-dir"]? {
            setProjectPath(Path(dir));
        }

        if let Ok(Str(value-> scene)) = cfg["scene"]? {
            __SCENE__[0] = scene;
        }

        true
    } catch {
        err: &std::config::args::errors::CommandLineError => {
            eprintln(parser.explain(err, usage-> "balder-editor"));
            false
        }
    }
}
