in outline_panel;

use main::{command, editor, outline, viewport};
use balder::core::application::signal;
use balder::interface::loader::registry::behavior;
use balder::interface::widget::tree::view;
use balder::scene::node::node3D;

/**
 * The outline of the scene, a tree view on the left of the editor, mounted under the behavior 'outline': a click selects
 * the node of a row, Enter or a double click looks at it, and the rows follow the selection of the scene
 * */
pub class OutlinePanel over Behavior {

    // The nodes of the scene the tree shows
    let dmut _outline: &SceneOutline = copy SceneOutline();

    // The tree showing the outline, once bound
    let dmut _tree: (&TreeView)? = none;

    // The editor of the scene, once bound
    let dmut _editor: (&SceneEditor)? = none;

    // The viewport looking at the nodes, once bound
    let dmut _viewport: (&EditorViewport)? = none;

    pub self () {
        self:.slot("picked", &self:.onPicked);
        self:.slot("reached", &self:.onReached);
    }

    /**
     * Show the nodes of the scene of an editor in a tree, once the interface is loaded, following its selection and its
     * changes
     * @params:
     *    - box: the mailbox the slots of the selection and of the editor are emitted in
     * */
    pub fn bind(mut self, dmut tree: &TreeView, dmut editor: &SceneEditor, dmut viewport: &EditorViewport, dmut box: &SlotEmitter) {
        tree:.setModel(alias self._outline);
        self._tree = (alias tree)?;
        self._viewport = (alias viewport)?;

        let dmut scene = alias editor.scene;
        let dmut selection = alias scene.selection;
        selection:.changed():.connect(alias box, &self:.onSelectionChanged);
        editor:.edited():.connect(alias box, &self:.onEdited);
        self._editor = (alias editor)?;

        self:.rebuild();
    }

    /**
     * Build the outline again after a command adding, removing or renaming nodes
     * */
    fn onEdited(mut self, command: &EditCommand) {
        if command.reshapes() {
            self:.rebuild();
        }
    }

    /**
     * Take the nodes of the scene again, the rows of the selection selected
     * */
    fn rebuild(mut self) {
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            self._outline:.build(alias scene:.getRootNode());
        }

        self:.onSelectionChanged();
    }

    /**
     * Select the rows of the nodes selected, without emitting on-select
     * */
    fn onSelectionChanged(mut self) {
        let mut paths: [[usize]] = [];
        if let Ok(dmut e) = alias self._editor {
            let dmut scene = alias e.scene;
            for n in scene.selection.nodes {
                if let Ok(p) = self._outline.pathOf(n) { paths ~= [p]; }
            }
        }

        if let Ok(dmut t) = alias self._tree {
            t:.setSelected(paths);
        }
    }

    /**
     * The user selected rows: their nodes are selected in the scene
     * @params:
     *    - paths: the paths of the rows selected, in their order
     * */
    fn onPicked(mut self, paths: [[usize]]) {
        let dmut e = if let Ok(dmut e) = alias self._editor { alias e } else { return; };
        let dmut scene = alias e.scene;
        let dmut selection = alias scene.selection;

        let dmut nodes: [&Node3D] = [];
        for p in paths if let Ok(dmut n) = alias self._outline:.nodeAt(p) {
            nodes ~= [alias n];
        }

        if nodes.len == 1us {
            selection:.select(alias nodes[0]);
            return;
        }

        selection:.clear();
        for dmut n in alias nodes {
            selection:.add(alias n);
        }
    }

    /**
     * The user pressed Enter on a row, or double clicked a leaf: the viewport looks at its node
     * */
    fn onReached(mut self, path: [usize]) {
        if let Ok(dmut n) = alias self._outline:.nodeAt(path) {
            if let Ok(dmut v) = alias self._viewport {
                let dmut nodes = copy [alias n];
                v:.frame(alias nodes);
            }
        }
    }

}
