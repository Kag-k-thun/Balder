in path;

use balder::math::curve;
use balder::scene::editable;
use balder::scene::node::node3D::path;

/**
 * A change of how the curves of paths go through their points, or of whether they go back to their first one, made in
 * the inspector
 * */
pub class PathCommand over EditCommand {

    // The paths changed
    let dmut _paths: [&Path3D];

    // The kind of curve the paths get, none to keep theirs
    let _curveKind: (CurveKind)?;

    // Whether the paths get closed, none to keep theirs
    let _closed: (bool)?;

    // The kind of curve each path had and whether it was closed, given back when the command is reverted
    let mut _before: [(CurveKind, bool)] = [];

    /**
     * @params:
     *    - paths: the paths changed
     *    - curveKind: the kind of curve they get, none to keep theirs
     *    - closed: true to close them, false to open them, none to keep them as they are
     * */
    pub self (dmut paths: [&Path3D], curveKind: (CurveKind)? = none, closed: (bool)? = none)
        with _paths = alias paths
        , _curveKind = curveKind
        , _closed = closed
    {
        for p in paths {
            self._before ~= [(p.curveKind, p.closed)];
        }
    }

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._paths.len == 0us { return false; }
        for dmut p in alias self._paths {
            if let Ok(k) = self._curveKind { p.curveKind = k; }
            if let Ok(c) = self._closed { p.closed = c; }
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i, dmut p in alias self._paths {
            p.curveKind = self._before[i]._0;
            p.closed = self._before[i]._1;
        }
    }

    pub over describe(self)-> [c8] {
        if self._paths.len == 1us {
            return "Changed the path " ~ self._paths[0].name.file();
        }

        f"Changed ${self._paths.len} paths"
    }

}
