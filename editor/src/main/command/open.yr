in open;

use main::naming;
use balder::core::error;
use balder::scene::{description, editable};
use balder::scene::node;
use balder::scene::node::node3D;

/**
 * The replacement of the nodes of the scene by those of a scene file, the nodes of the editor (its camera...) staying
 * @info: the nodes replaced and the nodes built are kept, an open reverted attaching the first ones again in place of
 * the others; the editor starts its history again with an open, which is not undone
 * */
pub class OpenCommand over EditCommand {

    // The scene to build
    let _description: &SceneDescription;

    // The name of the scene, for the status bar
    let _name: [c8];

    // The nodes of the scene replaced, under its root
    let dmut _replaced: [&Node] = [];

    // The nodes built from the scene file, under the root of the scene, once the command is applied
    let dmut _built: [&Node3D] = [];

    /**
     * @params:
     *    - description: the scene to build
     *    - name: the name of the scene, its file
     * */
    pub self (description: &SceneDescription, name: [c8])
        with _description = description
        , _name = name
    {}

    /**
     * @throws:
     *    - &BalderError: if the file of a model cannot be loaded, the nodes before it being built
     * */
    pub over apply(mut self, dmut scene: &EditableScene)-> bool
        throws BalderError
    {
        let dmut selection = alias scene.selection;
        selection:.clear();

        let dmut root = alias scene:.getRootNode();
        let dmut removed: [&Node] = [];
        for dmut n in alias root:.getChildrenInOrder() if !isEditorNode(n) {
            removed ~= [alias n];
        }

        for dmut n in alias removed {
            n:.dispose();
        }

        self._replaced = alias removed;
        if self._built.len == 0us {
            self._built = alias self._description.build(alias root);
        } else {
            for dmut n in alias self._built {
                n:.attach(alias root, at-> LAST_PLACE);
            }
        }

        true
    }

    pub over revert(mut self, dmut scene: &EditableScene) {
        let dmut selection = alias scene.selection;
        selection:.clear();

        for dmut n in alias self._built {
            n:.dispose();
        }

        let dmut root = alias scene:.getRootNode();
        for dmut n in alias self._replaced {
            n:.attach(alias root, at-> LAST_PLACE);
        }
    }

    pub over describe(self)-> [c8] {
        "Opened " ~ self._name
    }

    pub over reshapes(self)-> bool {
        true
    }

    pub over startsHistory(self)-> bool {
        true
    }

}
