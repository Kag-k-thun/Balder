in open;

use main::naming;
use balder::core::error;
use balder::scene::{description, editable};
use balder::scene::node;

/**
 * The replacement of the nodes of the scene by those of a scene file, the nodes of the editor (its camera...) staying
 * */
pub class OpenCommand over EditCommand {

    // The scene to build
    let _description: &SceneDescription;

    // The name of the scene, for the status bar
    let _name: [c8];

    /**
     * @params:
     *    - description: the scene to build
     *    - name: the name of the scene, its file
     * */
    pub self (description: &SceneDescription, name: [c8])
        with _description = description
        , _name = name
    {}

    /**
     * @throws:
     *    - &BalderError: if the file of a model cannot be loaded, the nodes before it being built
     * */
    pub over apply(mut self, dmut scene: &EditableScene)-> bool
        throws BalderError
    {
        let dmut selection = alias scene.selection;
        selection:.clear();

        let dmut root = alias scene:.getRootNode();
        let dmut removed: [&Node] = [];
        for _, dmut n in alias root:.getChilds() if !isEditorNode(n) {
            removed ~= [alias n];
        }

        for dmut n in alias removed {
            n:.dispose();
        }

        self._description.build(alias root);
        true
    }

    pub over describe(self)-> [c8] {
        "Opened " ~ self._name
    }

    pub over reshapes(self)-> bool {
        true
    }

}
