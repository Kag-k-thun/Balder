in remove;

use main::command::utils;
use balder::core::dispose;
use balder::scene::editable;
use balder::scene::node;
use balder::scene::node::node3D;

/**
 * The removal of nodes from the scene, with the nodes under them
 * @info: the nodes removed are kept with the parents they were under and their places among the children of the
 * parents, a removal undone attaching them there again
 * */
pub class RemoveCommand over EditCommand {

    // The nodes removed
    let dmut _nodes: [&Node3D];

    // The nodes detached from their parents, those under no other node removed, then the parents they were under and
    // their places among the children of the parents, when they were detached
    let dmut _detached: [&Node3D] = [];
    let dmut _parents: [&Node] = [];
    let mut _places: [usize] = [];

    // The nodes selected before the removal, selected again when it is undone
    let dmut _selected: [&Node3D] = [];

    pub self (dmut nodes: [&Node3D])
        with _nodes = alias nodes
    {}

    pub over apply(mut self, dmut scene: &EditableScene)-> bool {
        if self._nodes.len == 0us { return false; }

        self._selected = alias selectedNodes(alias scene);
        self._detached = [];
        self._parents = [];
        self._places = [];

        // a node under another one removed leaves with it
        for dmut n in alias self._nodes if !isUnderOneOf(n, self._nodes) {
            if let Ok(dmut p) = alias n:.getParent() {
                self._detached ~= [alias n];
                self._parents ~= [alias p];
                self._places ~= [n.index];
                n:.dispose();
            }
        }

        self._detached.len != 0us
    }

    pub over revert(mut self, dmut scene: &EditableScene) {
        // the last node detached goes back first, each finding the children of its parent as it left them
        for i in 0us .. self._detached.len {
            let j = self._detached.len - 1us - i;
            self._detached[j]:.attach(alias self._parents[j], at-> self._places[j]);
        }

        reselect(alias scene, alias self._selected);
    }

    pub over describe(self)-> [c8] {
        if self._nodes.len == 1us {
            return "Deleted " ~ self._nodes[0].name.file();
        }

        "Deleted " ~ std::conv::to!{[c8]} (self._nodes.len) ~ " nodes"
    }

    pub over reshapes(self)-> bool {
        true
    }

}

/**
 * @returns: true iif a node is under one of some nodes, its path starting with theirs
 * */
pub fn isUnderOneOf(node: &Node, nodes: [&Node3D])-> bool {
    for n in nodes {
        if n.uid != node.uid && n.name.isPrefix(node.name) { return true; }
    }

    false
}
