in remove;

use balder::core::dispose;
use balder::scene::editable;
use balder::scene::node;
use balder::scene::node::node3D;

/**
 * The removal of nodes from the scene, with the nodes under them
 * */
pub class RemoveCommand over EditCommand {

    // The nodes removed
    let dmut _nodes: [&Node3D];

    pub self (dmut nodes: [&Node3D])
        with _nodes = alias nodes
    {}

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._nodes.len == 0us { return false; }

        // a node under another one removed leaves with it
        for dmut n in alias self._nodes if !isUnderOneOf(n, self._nodes) {
            n:.dispose();
        }

        true
    }

    pub over describe(self)-> [c8] {
        if self._nodes.len == 1us {
            return "Deleted " ~ self._nodes[0].name.file();
        }

        "Deleted " ~ std::conv::to!{[c8]} (self._nodes.len) ~ " nodes"
    }

    pub over reshapes(self)-> bool {
        true
    }

}

/**
 * @returns: true iif a node is under one of some nodes, its path starting with theirs
 * */
pub fn isUnderOneOf(node: &Node, nodes: [&Node3D])-> bool {
    for n in nodes {
        if n.uid != node.uid && n.name.isPrefix(node.name) { return true; }
    }

    false
}
