in duplicate;

use main::naming;
use main::command::remove;
use balder::scene::editable;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{group, light, solid};
use balder::scene::node::node3D::visual::_;

/**
 * The copy of nodes beside them, with the nodes under them, the copies being selected
 * @info: the copy of a mesh or of a model draws the geometry of the original (see IndexedMesh3D::sharing and
 * SolidObjectModel::copyOf); a camera is not copied
 * */
pub class DuplicateCommand over EditCommand {

    // The nodes copied
    let dmut _nodes: [&Node3D];

    // The names of the copies
    let mut _copies: [[c8]] = [];

    pub self (dmut nodes: [&Node3D])
        with _nodes = alias nodes
    {}

    pub over apply(mut self, dmut scene: &EditableScene)-> bool {
        let dmut copies: [&Node3D] = [];
        for dmut n in alias self._nodes if !isUnderOneOf(n, self._nodes) {
            if let Ok(dmut parent) = alias n:.getParent() {
                if let Ok(dmut c) = alias duplicate(alias n, alias parent) {
                    copies ~= [alias c];
                }
            }
        }

        if copies.len == 0us { return false; }

        let dmut selection = alias scene.selection;
        selection:.clear();
        self._copies = [];
        for dmut c in alias copies {
            selection:.add(alias c);
            self._copies ~= [c.name.file()];
        }

        true
    }

    pub over describe(self)-> [c8] {
        if self._copies.len == 1us {
            return "Duplicated into " ~ self._copies[0];
        }

        "Duplicated " ~ std::conv::to!{[c8]} (self._copies.len) ~ " nodes"
    }

    pub over reshapes(self)-> bool {
        true
    }

}

/**
 * @returns: a copy of a node and of the nodes under it, under a parent, at the place of the node, none for a node that
 * is not copied (a camera...)
 * */
fn duplicate(dmut node: &Node3D, dmut parent: &Node)-> dmut (&Node3D)? {
    let name = freeName(alias parent, node.name.file());
    if let dmut model: &SolidObjectModel = alias node {
        // the copy of a model copies its meshes
        let dmut twin = copy SolidObjectModel::copyOf(name, alias parent, alias model);
        twin:.setTransform(node.position, node.rotation, node.scale);
        return (alias twin)?;
    }

    if let Ok(dmut twin) = alias copyAlone(name, alias node, alias parent) {
        twin:.setTransform(node.position, node.rotation, node.scale);
        for _, dmut c in alias node:.getChilds() if let dmut child: &Node3D = alias c {
            duplicate(alias child, alias twin);
        }

        return (alias twin)?;
    }

    none
}

/**
 * @returns: a copy of a node without the nodes under it, under a parent, none for a node that is not copied
 * */
fn copyAlone(name: [c8], dmut node: &Node3D, dmut parent: &Node)-> dmut (&Node3D)? {
    if let dmut mesh: &IndexedMesh3D = alias node {
        let dmut twin = copy IndexedMesh3D::sharing(name, alias parent, alias mesh.mesh, mesh.material.clone(), shadow-> mesh.castShadow());
        return (alias twin)?;
    }

    if let l: &Light = node {
        return (alias copyLight(name, alias parent, l))?;
    }

    if let _: &Group3D = node {
        let dmut group = copy Group3D(name, alias parent);
        return (alias group)?;
    }

    none
}

/**
 * @returns: a light shining as another one, under a parent
 * */
fn copyLight(name: [c8], dmut parent: &Node, l: &Light)-> dmut &Light {
    let dmut c = copy Light(name, alias parent, castShadow-> l.castShadow);
    c.type = l.type;
    c.color = l.color;
    c.intensity = l.intensity;
    c.direction = l.direction;
    c.range = l.range;
    c.innerAngle = l.innerAngle;
    c.outerAngle = l.outerAngle;
    c.shadowBias = l.shadowBias;
    c.shadowNormalOffset = l.shadowNormalOffset;
    alias c
}
