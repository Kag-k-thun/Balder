in property;

use balder::core::error;
use balder::scene::editable;
use balder::scene::edit::property_edit;

use std::stream;

/**
 * A change of a property of nodes (see NodeProperty), made in the inspector: the one command of every field the schemas
 * of the nodes declare, each node going from the value it had to the value it gets
 * @info: the nodes are checked first, a value refused by one of them (a light along a null direction, a far plane before
 * the near one) changing none of them
 * */
pub class PropertyCommand over EditCommand {

    // The edits of the nodes, from the value each had to the one it gets
    let mut _edits: [mut PropertyEdit];

    // The field of the inspector the change was typed in, the steps of one field merging into one command, empty for a
    // change that merges with none
    let _field: [c8];

    /**
     * @params:
     *    - edits: the edits of the nodes
     *    - field: the field of the inspector the change was typed in, empty for a change that merges with none
     * */
    pub self (edits: [PropertyEdit], field: [c8] = "")
        with _edits = copy edits
        , _field = field
    {}

    /**
     * @throws:
     *    - &BalderError: if a node refuses its value (see NodeProperty::check), the nodes keeping theirs
     * */
    pub over apply(mut self, dmut _: &EditableScene)-> bool
        throws BalderError
    {
        if self._edits.len == 0us { return false; }
        for e in self._edits {
            let refused = e.check();
            if refused.len != 0us { throw copy BalderError(refused); }
        }

        for i in 0us .. self._edits.len {
            self._edits[i]:.apply();
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for j in 0us .. self._edits.len {
            self._edits[self._edits.len - 1us - j]:.revert();
        }
    }

    /**
     * A change of the same properties of the same nodes typed in the same field merges, the nodes going from their
     * values before this change to their values after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let p: &PropertyCommand = next {
            if self._field.len == 0us || p._field != self._field || p._edits.len != self._edits.len { return false; }
            for i, e in self._edits {
                let other = p._edits[i];
                if e.node.uid != other.node.uid || e.property.key() != other.property.key() { return false; }
            }

            for i in 0us .. self._edits.len {
                self._edits[i] = self._edits[i]:.extendedTo(p._edits[i].after);
            }

            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        if self._edits.len == 0us { return "Changed nothing"; }

        let what = wordsOf(self._edits[0].property.name);
        if self._edits.len == 1us {
            return f"Changed the ${what} of ${self._edits[0].node.name.file()}";
        }

        f"Changed the ${what} of ${self._edits.len} nodes"
    }

}

/**
 * @returns: the name of a property in words, its dashes as spaces: `inner angle`
 * */
fn wordsOf(name: [c8])-> [c8] {
    let dmut s = copy StringStream();
    for c in name {
        s:.write(if c == '-' { ' ' } else { c });
    }

    s[]
}
