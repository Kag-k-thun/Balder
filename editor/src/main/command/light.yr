in light;

use main::lighting;
use balder::core::error;
use balder::math::vector;
use balder::scene::editable;
use balder::scene::node::node3D::light;

/**
 * A change of the settings of lights (their colour, their intensity, their shadows...), made in the inspector
 * @info: one direction light casts shadows at a time, the others casting none whatever their settings (see
 * Light::castShadow)
 * */
pub class LightCommand over EditCommand {

    // The lights changed
    let dmut _lights: [&Light];

    // The settings each light gets, in the order of the lights
    let mut _settings: [LightSettings];

    // The settings each light had, given back when the command is reverted
    let mut _before: [LightSettings] = [];

    // The field of the inspector the change was typed in, the steps of one field merging into one command
    let _field: [c8];

    /**
     * @params:
     *    - lights: the lights changed
     *    - settings: the settings each one gets, in their order
     *    - field: the field of the inspector the change was typed in, empty for a change that merges with none
     * */
    pub self (dmut lights: [&Light], settings: [LightSettings], field: [c8] = "")
        with _lights = alias lights
        , _settings = settings
        , _field = field
    {
        for l in lights {
            self._before ~= [LightSettings(l)];
        }
    }

    /**
     * @throws:
     *    - &BalderError: if a light would shine along no direction, the lights keeping their settings
     * */
    pub over apply(mut self, dmut _: &EditableScene)-> bool
        throws BalderError
    {
        if self._lights.len == 0us { return false; }
        for s in self._settings if s.direction.length() == 0.0f {
            throw copy BalderError("A light cannot shine along a null direction");
        }

        for i, dmut l in alias self._lights {
            self._settings[i].applyTo(alias l);
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i, dmut l in alias self._lights {
            self._before[i].applyTo(alias l);
        }
    }

    /**
     * A change of the same lights typed in the same field merges, the lights going from their settings before this change
     * to their settings after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let l: &LightCommand = next {
            if self._field.len == 0us || l._field != self._field || l._lights.len != self._lights.len { return false; }
            for i, light in self._lights {
                if light.uid != l._lights[i].uid { return false; }
            }

            self._settings = l._settings;
            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        if self._lights.len == 1us {
            return "Changed the light " ~ self._lights[0].name.file();
        }

        "Changed " ~ std::conv::to!{[c8]} (self._lights.len) ~ " lights"
    }

}
