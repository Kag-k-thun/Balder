in light;

use main::lighting;
use balder::core::error;
use balder::math::vector;
use balder::scene::editable;
use balder::scene::node::node3D::light;

/**
 * A change of the settings of lights (their colour, their intensity, their shadows...), made in the inspector
 * @info: one direction light casts shadows at a time, the others casting none whatever their settings (see
 * Light::castShadow)
 * */
pub class LightCommand over EditCommand {

    // The lights changed
    let dmut _lights: [&Light];

    // The settings each light gets, in the order of the lights
    let _settings: [LightSettings];

    /**
     * @params:
     *    - lights: the lights changed
     *    - settings: the settings each one gets, in their order
     * */
    pub self (dmut lights: [&Light], settings: [LightSettings])
        with _lights = alias lights
        , _settings = settings
    {}

    /**
     * @throws:
     *    - &BalderError: if a light would shine along no direction, the lights keeping their settings
     * */
    pub over apply(mut self, dmut _: &EditableScene)-> bool
        throws BalderError
    {
        if self._lights.len == 0us { return false; }
        for s in self._settings if s.direction.length() == 0.0f {
            throw copy BalderError("A light cannot shine along a null direction");
        }

        for i, dmut l in alias self._lights {
            self._settings[i].applyTo(alias l);
        }

        true
    }

    pub over describe(self)-> [c8] {
        if self._lights.len == 1us {
            return "Changed the light " ~ self._lights[0].name.file();
        }

        "Changed " ~ std::conv::to!{[c8]} (self._lights.len) ~ " lights"
    }

}
