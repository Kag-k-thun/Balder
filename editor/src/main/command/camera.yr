in camera;

use main::framing;
use balder::core::error;
use balder::scene::editable;
use balder::scene::node::node3D::camera;

/**
 * A change of the settings of cameras (their field of view, the height of their view, their planes), made in the
 * inspector
 * */
pub class CameraCommand over EditCommand {

    // The cameras changed
    let dmut _cameras: [&Camera];

    // The settings each camera gets, in the order of the cameras
    let mut _settings: [CameraSettings];

    // The settings each camera had, given back when the command is reverted
    let mut _before: [CameraSettings] = [];

    // The field of the inspector the change was typed in, the steps of one field merging into one command
    let _field: [c8];

    /**
     * @params:
     *    - cameras: the cameras changed
     *    - settings: the settings each one gets, in their order
     *    - field: the field of the inspector the change was typed in, empty for a change that merges with none
     * */
    pub self (dmut cameras: [&Camera], settings: [CameraSettings], field: [c8] = "")
        with _cameras = alias cameras
        , _settings = settings
        , _field = field
    {
        for c in cameras {
            self._before ~= [CameraSettings(c)];
        }
    }

    /**
     * @throws:
     *    - &BalderError: if a camera would see nothing (see CameraSettings::check), the cameras keeping their settings
     * */
    pub over apply(mut self, dmut _: &EditableScene)-> bool
        throws BalderError
    {
        if self._cameras.len == 0us { return false; }
        for s in self._settings {
            s.check();
        }

        for i, dmut c in alias self._cameras {
            self._settings[i].applyTo(alias c);
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i, dmut c in alias self._cameras {
            self._before[i].applyTo(alias c);
        }
    }

    /**
     * A change of the same cameras typed in the same field merges, the cameras going from their settings before this
     * change to their settings after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let c: &CameraCommand = next {
            if self._field.len == 0us || c._field != self._field || c._cameras.len != self._cameras.len { return false; }
            for i, cam in self._cameras {
                if cam.uid != c._cameras[i].uid { return false; }
            }

            self._settings = c._settings;
            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        if self._cameras.len == 1us {
            return "Changed the camera " ~ self._cameras[0].name.file();
        }

        f"Changed ${self._cameras.len} cameras"
    }

}
