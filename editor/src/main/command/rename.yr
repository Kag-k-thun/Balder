in rename;

use balder::core::error;
use balder::scene::editable;
use balder::scene::node;
use balder::scene::node::node3D;

/**
 * The renaming of a node among the children of its parent
 * */
pub class RenameCommand over EditCommand {

    // The node renamed
    let dmut _node: &Node3D;

    // The name it gets
    let _name: [c8];

    // The name it had
    let mut _old: [c8] = "";

    pub self (dmut node: &Node3D, name: [c8])
        with _node = alias node
        , _name = name
    {}

    /**
     * @throws:
     *    - &BalderError: if the name is empty, holds a '/', or names another child of the parent
     * */
    pub over apply(mut self, dmut _: &EditableScene)-> bool
        throws BalderError
    {
        self._old = self._node.name.file();
        if self._old == self._name { return false; }

        if !isValidName(self._name) {
            throw copy BalderError("A node cannot be named '" ~ self._name ~ "', empty or holding a '/'");
        }

        if !self._node:.rename(self._name) {
            throw copy BalderError("Another node is named '" ~ self._name ~ "' there");
        }

        true
    }

    pub over describe(self)-> [c8] {
        "Renamed " ~ self._old ~ " to " ~ self._name
    }

    pub over reshapes(self)-> bool {
        true
    }

}
