in add;

use main::naming;
use main::command::utils;
use balder::core::error;
use balder::scene::description::node_description;
use balder::scene::editable;
use balder::scene::node;
use balder::scene::node::node3D;

/**
 * The addition of a node, built from its description under a parent, then selected alone
 * @info: the node built is kept, an addition undone detaching it and redone attaching it again
 * */
pub class AddCommand over EditCommand {

    // The node to build, its name made free among the children of the parent when it is applied
    let mut _description: NodeDescription;

    // The node the new one goes under
    let dmut _parent: &Node;

    // The node built, once the command is applied
    let dmut _node: (&Node3D)? = none;

    // The nodes selected before the addition, selected again when it is undone
    let dmut _selected: [&Node3D] = [];

    /**
     * @params:
     *    - description: the node to add
     *    - parent: the node it goes under
     * */
    pub self (description: NodeDescription, dmut parent: &Node)
        with _description = description
        , _parent = alias parent
    {}

    /**
     * @throws:
     *    - &BalderError: if the file of a model cannot be loaded
     * */
    pub over apply(mut self, dmut scene: &EditableScene)-> bool
        throws BalderError
    {
        self._selected = alias selectedNodes(alias scene);
        if let Ok(dmut built) = alias self._node {
            if !built:.attach(alias self._parent, at-> LAST_PLACE) { return false; }
        } else {
            self._description.name = freeName(alias self._parent, self._description.name);
            let dmut built = alias self._description.build(alias self._parent);
            self._node = (alias built)?;
        }

        if let Ok(dmut node) = alias self._node {
            let dmut selection = alias scene.selection;
            selection:.select(alias node);
        }

        true
    }

    pub over revert(mut self, dmut scene: &EditableScene) {
        if let Ok(dmut node) = alias self._node {
            node:.dispose();
        }

        reselect(alias scene, alias self._selected);
    }

    pub over describe(self)-> [c8] {
        "Added " ~ self._description.name
    }

    pub over reshapes(self)-> bool {
        true
    }

}
