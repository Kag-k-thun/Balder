in marker;

use balder::scene::editable;
use balder::scene::node::node3D::marker;

/**
 * A change of what markers mark, or of the tags they are looked up by, made in the inspector
 * */
pub class MarkerCommand over EditCommand {

    // The markers changed
    let dmut _markers: [&Marker3D];

    // The purpose the markers get, none to keep theirs
    let _purpose: (MarkerPurpose)?;

    // The tags the markers get, none to keep theirs
    let _tags: ([[c8]])?;

    // The purpose and the tags each marker had, given back when the command is reverted
    let mut _before: [(MarkerPurpose, [[c8]])] = [];

    /**
     * @params:
     *    - markers: the markers changed
     *    - purpose: the purpose they get, none to keep theirs
     *    - tags: the tags they get, none to keep theirs
     * */
    pub self (dmut markers: [&Marker3D], purpose: (MarkerPurpose)? = none, tags: ([[c8]])? = none)
        with _markers = alias markers
        , _purpose = purpose
        , _tags = tags
    {
        for m in markers {
            self._before ~= [(m.purpose, m.tags)];
        }
    }

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._markers.len == 0us { return false; }
        for dmut m in alias self._markers {
            if let Ok(p) = self._purpose { m.purpose = p; }
            if let Ok(t) = self._tags { m.tags = t; }
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i, dmut m in alias self._markers {
            m.purpose = self._before[i]._0;
            m.tags = self._before[i]._1;
        }
    }

    pub over describe(self)-> [c8] {
        if self._markers.len == 1us {
            return "Changed the marker " ~ self._markers[0].name.file();
        }

        f"Changed ${self._markers.len} markers"
    }

}
