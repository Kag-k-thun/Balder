in transform;

use balder::scene::{edit, editable};

/**
 * A change of the transforms of nodes, typed in the inspector or dragged with the gizmo
 * */
pub class TransformCommand over EditCommand {

    // The edits of the nodes, from the transform each had to the one it gets
    let mut _edits: [mut TransformEdit];

    // True when the nodes have the transforms of the edits already: the gizmo moved them during its drag, or the
    // command was applied and not reverted since
    let mut _applied: bool;

    // The field of the inspector the change was typed in, the steps of one field merging into one command, empty for a
    // change that merges with none
    let _field: [c8];

    /**
     * @params:
     *    - edits: the edits of the nodes
     *    - applied: true when the nodes were moved already (by the gizmo), the command recording the change only
     *    - field: the field of the inspector the change was typed in, empty for a change that merges with none (a drag of
     *             the gizmo)
     * */
    pub self (edits: [TransformEdit], applied: bool = false, field: [c8] = "")
        with _edits = copy edits
        , _applied = applied
        , _field = field
    {}

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._edits.len == 0us { return false; }
        if !self._applied {
            for i in 0us .. self._edits.len {
                self._edits[i]:.apply();
            }

            self._applied = true;
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i in 0us .. self._edits.len {
            self._edits[i]:.revert();
        }

        self._applied = false;
    }

    /**
     * A change of the same nodes typed in the same field merges, the nodes going from their transforms before this
     * change to their transforms after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let t: &TransformCommand = next {
            if self._field.len == 0us || t._field != self._field || t._edits.len != self._edits.len { return false; }
            for i, e in self._edits {
                if e.node.uid != t._edits[i].node.uid { return false; }
            }

            for i in 0us .. self._edits.len {
                self._edits[i] = self._edits[i]:.extendedTo(t._edits[i].after);
            }

            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        if self._edits.len == 1us {
            return "Transformed " ~ self._edits[0].node.name.file();
        }

        "Transformed " ~ std::conv::to!{[c8]} (self._edits.len) ~ " nodes"
    }

}
