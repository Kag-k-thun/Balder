in transform;

use balder::scene::{edit, editable};

/**
 * A change of the transforms of nodes, typed in the inspector or dragged with the gizmo
 * */
pub class TransformCommand over EditCommand {

    // The edits of the nodes, from the transform each had to the one it gets
    let mut _edits: [mut TransformEdit];

    // True when the nodes have the transforms of the edits already, the gizmo having moved them during its drag
    let mut _applied: bool;

    /**
     * @params:
     *    - edits: the edits of the nodes
     *    - applied: true when the nodes were moved already (by the gizmo), the command recording the change only
     * */
    pub self (edits: [TransformEdit], applied: bool = false)
        with _edits = copy edits
        , _applied = applied
    {}

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._edits.len == 0us { return false; }
        if !self._applied {
            for i in 0us .. self._edits.len {
                self._edits[i]:.apply();
            }

            self._applied = true;
        }

        true
    }

    pub over describe(self)-> [c8] {
        if self._edits.len == 1us {
            return "Transformed " ~ self._edits[0].node.name.file();
        }

        "Transformed " ~ std::conv::to!{[c8]} (self._edits.len) ~ " nodes"
    }

}
