in active_camera;

use balder::scene::editable;
use balder::scene::node::node3D::camera;

/**
 * The choice of the active camera of the scene, the one a game draws it through, made in the inspector
 * @info: the viewport keeps drawing the scene through the camera of the editor, the active camera being only marked
 * */
pub class ActiveCameraCommand over EditCommand {

    // The camera made active
    let dmut _camera: &Camera;

    // The active camera before the change, made active again when the command is reverted
    let dmut _before: (&Camera)? = none;

    pub self (dmut cam: &Camera)
        with _camera = alias cam
    {}

    pub over apply(mut self, dmut scene: &EditableScene)-> bool {
        let dmut before = alias scene:.getActiveCamera();
        if let Ok(b) = before && b is self._camera { return false; }

        self._before = alias before;
        scene:.setActiveCamera(alias self._camera);
        true
    }

    pub over revert(mut self, dmut scene: &EditableScene) {
        if let Ok(dmut b) = alias self._before {
            scene:.setActiveCamera(alias b);
        }
    }

    pub over describe(self)-> [c8] {
        "Made " ~ self._camera.name.file() ~ " the active camera"
    }

}
