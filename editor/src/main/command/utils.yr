in utils;

use balder::scene::editable;
use balder::scene::node::node3D;

/**
 * @returns: the nodes selected in a scene, in a list of their own, a command keeping those it found to select them again
 * once reverted
 * */
pub fn selectedNodes(dmut scene: &EditableScene)-> dmut [&Node3D] {
    let dmut nodes: [&Node3D] = [];
    let dmut selection = alias scene.selection;
    for dmut n in alias selection.nodes {
        nodes ~= [alias n];
    }

    alias nodes
}

/**
 * Select some nodes of a scene, and them only, those a command reverted found selected
 * */
pub fn reselect(dmut scene: &EditableScene, dmut nodes: [&Node3D]) {
    let dmut selection = alias scene.selection;
    selection:.clear();
    for dmut n in alias nodes {
        selection:.add(alias n);
    }
}
