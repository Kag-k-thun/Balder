in volume;

use balder::scene::editable;
use balder::scene::edit::volume_edit;

/**
 * A change of the shapes of volumes, typed in the inspector or dragged by a face with the gizmo, the centre of a volume
 * following a face moved on its own
 * */
pub class VolumeCommand over EditCommand {

    // The edits of the volumes, from the shape and the transform each had to those it gets
    let mut _edits: [mut VolumeEdit];

    // True when the volumes have the shapes of the edits already: the gizmo changed them during its drag, or the
    // command was applied and not reverted since
    let mut _applied: bool;

    // The field of the inspector the change was typed in, the steps of one field merging into one command, empty for a
    // change that merges with none
    let _field: [c8];

    /**
     * @params:
     *    - edits: the edits of the volumes
     *    - applied: true when the volumes were changed already (by the gizmo), the command recording the change only
     *    - field: the field of the inspector the change was typed in, empty for a change that merges with none (a drag of
     *             the gizmo)
     * */
    pub self (edits: [VolumeEdit], applied: bool = false, field: [c8] = "")
        with _edits = copy edits
        , _applied = applied
        , _field = field
    {}

    pub over apply(mut self, dmut _: &EditableScene)-> bool {
        if self._edits.len == 0us { return false; }
        if !self._applied {
            for i in 0us .. self._edits.len {
                self._edits[i]:.apply();
            }

            self._applied = true;
        }

        true
    }

    pub over revert(mut self, dmut _: &EditableScene) {
        for i in 0us .. self._edits.len {
            self._edits[i]:.revert();
        }

        self._applied = false;
    }

    /**
     * A change of the same volumes typed in the same field merges, the volumes going from their shapes before this
     * change to their shapes after the other
     * */
    pub over merge(mut self, next: &EditCommand)-> bool {
        if let v: &VolumeCommand = next {
            if self._field.len == 0us || v._field != self._field || v._edits.len != self._edits.len { return false; }
            for i, e in self._edits {
                if e.node.uid != v._edits[i].node.uid { return false; }
            }

            for i in 0us .. self._edits.len {
                self._edits[i] = self._edits[i]:.extendedTo(v._edits[i].after, v._edits[i].placedAfter);
            }

            return true;
        }

        false
    }

    pub over describe(self)-> [c8] {
        if self._edits.len == 1us {
            return "Reshaped the volume " ~ self._edits[0].node.name.file();
        }

        f"Reshaped ${self._edits.len} volumes"
    }

}
