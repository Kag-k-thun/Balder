in outline;

use main::naming;
use balder::interface::widget::tree::model;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{camera, group, light, solid};
use balder::scene::node::node3D::visual::_;

/**
 * The nodes of a scene as a tree view shows them: the 3D nodes under the root, those of the editor left out (see
 * isEditorNode), the children of each node in the order they were created
 * @info: the outline is a picture of the tree of the nodes when it was built, built again after a change adding,
 * removing or renaming nodes (see build)
 * */
pub class SceneOutline over TreeModel {

    // The nodes under the root, each with the nodes under it
    let dmut _items: [&OutlineItem] = [];

    pub self ()
        with super()
    {}

    /**
     * Take the nodes under a root again, the views showing the outline reading it again
     * */
    pub fn build(mut self, dmut root: &Node) {
        self._items = alias itemsUnder(alias root);
        self.changed();
    }

    pub over len(self, node: [usize])-> usize {
        if node.len == 0us { return self._items.len; }
        if let Ok(i) = self.find(node) { i.children.len } else { 0us }
    }

    pub over text(self, node: [usize])-> [c8] {
        if let Ok(i) = self.find(node) {
            return i.node.name.file();
        }

        ""
    }

    /**
     * @returns: the node at a path of the outline, none when the path names no node
     * */
    pub fn nodeAt(mut self, path: [usize])-> dmut (&Node3D)? {
        let dmut items = alias self._items;
        let dmut found: (&Node3D)? = none;
        for i in path {
            if i >= items.len { return none; }
            found = (alias items[i].node)?;
            items = alias items[i].children;
        }

        alias found
    }

    /**
     * @returns: the path of a node in the outline, none when the outline does not show it
     * */
    pub fn pathOf(self, node: &Node)-> ([usize])? {
        pathIn(self._items, node.uid)
    }

    /**
     * @returns: the item of a path, none when the path names no node
     * */
    fn find(self, path: [usize])-> (&OutlineItem)? {
        let mut items = self._items;
        let mut found: (&OutlineItem)? = none;
        for i in path {
            if i >= items.len { return none; }
            found = (items[i])?;
            items = items[i].children;
        }

        found
    }

}

/**
 * A node of the outline, and the nodes under it
 * */
class OutlineItem {

    pub let dmut node: &Node3D;

    pub let dmut children: [&OutlineItem];

    pub self (dmut node: &Node3D, dmut children: [&OutlineItem])
        with node = alias node
        , children = alias children
    {}

}

/**
 * @returns: the items of the 3D nodes under a node, those of the editor left out, in the order they were created
 * */
fn itemsUnder(dmut parent: &Node)-> dmut [&OutlineItem] {
    let dmut nodes: [&Node3D] = [];
    for _, dmut c in alias parent:.getChilds() if let dmut n: &Node3D = alias c {
        if !isEditorNode(n) {
            nodes ~= [alias n];
        }
    }

    // the children are held by name: they are sorted by their uniq id, which grows as they are created
    for i in 1us .. nodes.len {
        let mut j = i;
        while j > 0us && nodes[j - 1us].uid > nodes[j].uid {
            let dmut swapped = alias nodes[j];
            nodes[j] = alias nodes[j - 1us];
            nodes[j - 1us] = alias swapped;
            j -= 1us;
        }
    }

    let dmut items: [&OutlineItem] = [];
    for dmut n in alias nodes {
        items ~= [copy OutlineItem(alias n, alias itemsUnder(alias n))];
    }

    alias items
}

/**
 * @returns: the path of the node of a uniq id among items, none when none of them is that node
 * */
fn pathIn(items: [&OutlineItem], uid: usize)-> ([usize])? {
    for i, item in items {
        if item.node.uid == uid { return (copy [i])?; }
        if let Ok(p) = pathIn(item.children, uid) {
            return (copy [i] ~ p)?;
        }
    }

    none
}

/**
 * @returns: what a node is, in a word
 * */
pub fn kindOf(node: &Node3D)-> [c8] {
    if let l: &Light = node {
        return match l.type {
            LightType::DIRECTION => { "direction light" }
            LightType::POINT     => { "point light" }
            LightType::SPOT      => { "spot light" }
            _                    => { "light" }
        };
    }

    if let _: &SolidObjectModel = node { return "model"; }
    if let _: &IndexedMesh3D = node { return "mesh"; }
    if let _: &Group3D = node { return "group"; }
    if let _: &Camera = node { return "camera"; }
    "node"
}
