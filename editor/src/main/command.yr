in command;

pub mod ::add;
pub mod ::duplicate;
pub mod ::light;
pub mod ::open;
pub mod ::remove;
pub mod ::rename;
pub mod ::transform;

use balder::core::error;
use balder::scene::editable;

/**
 * A change of the scene of the editor, made through SceneEditor::execute, the one way the editor changes the scene
 * @info: a command is built from what the change needs, then applied once by the editor, which tells the outline, the
 * inspector and the status bar what changed; undoing a command will revert it there
 * */
@abstract
pub class EditCommand {

    prot self () {}

    /**
     * Make the change in a scene
     * @returns: true iif the scene changed
     * @throws:
     *    - &BalderError: if the change cannot be made (a model whose file cannot be read...)
     * */
    pub fn apply(mut self, dmut scene: &EditableScene)-> bool
        throws BalderError;

    /**
     * @returns: the change, in a few words, for the status bar
     * */
    pub fn describe(self)-> [c8];

    /**
     * @returns: true iif the command adds, removes or renames nodes, the outline being built again
     * */
    pub fn reshapes(self)-> bool {
        false
    }

}
