in command;

pub mod ::add;
pub mod ::duplicate;
pub mod ::light;
pub mod ::open;
pub mod ::remove;
pub mod ::rename;
pub mod ::transform;
pub mod ::utils;

use balder::core::error;
use balder::scene::editable;

/**
 * A change of the scene of the editor, made through SceneEditor::execute, the one way the editor changes the scene
 * @info: a command is built from what the change needs, then applied by the editor, which tells the outline, the
 * inspector and the status bar what changed; the editor keeps it, reverting it to undo it and applying it again to redo
 * it, the scene being each time as the command left it or found it
 * */
@abstract
pub class EditCommand {

    prot self () {}

    /**
     * Make the change in a scene, the first time the command is executed and each time it is redone
     * @returns: true iif the scene changed
     * @throws:
     *    - &BalderError: if the change cannot be made (a model whose file cannot be read...)
     * */
    pub fn apply(mut self, dmut scene: &EditableScene)-> bool
        throws BalderError;

    /**
     * Undo the change apply made, the scene being as apply left it (the commands applied after this one are reverted
     * first), the nodes the command found selected being selected again
     * @info: a command reverted is applied again to redo it, on the scene as it found it
     * */
    pub fn revert(mut self, dmut scene: &EditableScene);

    /**
     * Merge into this command another one applied right after it, the two being undone as one change: the steps of one
     * field of the inspector, its arrows clicked or its keys held
     * @returns: true iif the command is merged into this one, which makes both changes from now on
     * */
    pub fn merge(mut self, next: &EditCommand)-> bool {
        next;
        false
    }

    /**
     * @returns: the change, in a few words, for the status bar
     * */
    pub fn describe(self)-> [c8];

    /**
     * @returns: true iif the command adds, removes or renames nodes, the outline being built again
     * */
    pub fn reshapes(self)-> bool {
        false
    }

    /**
     * @returns: true iif the command starts the history of the editor again, the commands before it no longer undone,
     * nor itself: an open, replacing the scene
     * */
    pub fn startsHistory(self)-> bool {
        false
    }

}
