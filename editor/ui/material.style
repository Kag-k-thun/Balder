// The look of the material editor: its preview takes the room the panels leave, the bar of its choices under it, then
// the properties and the information in panels of the width of the inspector

// the material editor while a scene is shown, taking no room, the panels of the scenes while a material is shown, and
// the menus acting on the scene with them
Splitter.absent, MenuButton.absent, PushButton.absent {
    display: none;
}

// the notes of the material editor, longer than the width of its panels
Label.long {
    text-wrap: wrap;
}

LinearLayout.material-view {
    flex: 1;
    min-width: 320;
}

Scene3D.preview {
    background-color: black;
    flex: 1;
}

LinearLayout.preview-bar {
    direction: row;
    background-color: $panel;
    border-width: 1 0 0 0;
    border-color: $edge;
    height: 34;
    padding: 2 0;
}

Dropdown.preview-choice {
    flex: 0;
    min-width: 150;
}

PushButton.preview-action {
    flex: 0;
    min-width: 70;
}

// a path, then the buttons choosing an image and removing the map
LinearLayout.map {
    direction: row;
    background-color: transparent;
    margin: 0 6 4 0;
}

// a path longer than the room left by the buttons is scrolled in its field, the buttons staying beside it
InputText.map-path {
    flex: 1;
    min-width: 40;
    margin-right: 2;
}

PushButton.map-button {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    width: 24;
    height: 22;
    margin-left: 2;
}

PushButton.map-button:hover {
    background-color: $edge;
}

PushButton.map-button::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
}

// the fields of a material read only, greyed: Extract to a file makes a copy that can be changed
SpinBox.spin.idle::label, InputText.input.idle::label, PushButton.map-button.idle::label {
    text-color: $muted;
}

PushButton.map-button.idle, PushButton.map-button.idle:hover {
    background-color: $page;
}
