// The settings of a project, over the look of the dialogs of Balder (engine:/dialog/dialog.style): a page per tab, a
// row per setting, its caption in a column of the same width on every page

LinearLayout.dialog.dialog-settings {
    width: 680;
    max-width: none;
}

// the pages are as tall as the longest one, the tabs sized by none of their content
.dialog TabLayout.settings-tabs {
    background-color: transparent;
    border: 0;
    margin: 4 0 8 0;
    height: 520;
}

.dialog TabLayout.settings-tabs::tab {
    background-color: #17191d;
    text-color: #9aa3ab;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    padding: 4 14;
    margin-right: 2;
    radius: 6 6 0 0;
}

.dialog TabLayout.settings-tabs::tab:hover { text-color: #eeeff2; }
.dialog TabLayout.settings-tabs::tab:selected { background-color: #2a2e35; text-color: #eeeff2; }

.dialog LinearLayout.settings-page {
    background-color: #2a2e35;
    padding: 10 8;
    radius: 0 6 6 6;
}

.dialog Label.dialog-caption.settings-caption {
    width: 150;
}

.dialog Label.settings-section {
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-xalign: left;
    margin: 12 3 4 3;
}

.dialog Label.dialog-note {
    text-color: #9aa3ab;
    text-xalign: left;
    text-wrap: wrap;
    font-size: 13;
    margin: 0 3 8 3;
}

// the fields that are not inputs, as wide as them and in their colours
.dialog SpinBox.settings-spin, .dialog Dropdown.settings-choice {
    background-color: #17191d;
    border: 1 #4a5259;
    radius: 6;
    padding: 2 6;
    margin-right: 6;
    flex: 1;
}

.dialog SpinBox.settings-spin:hover, .dialog Dropdown.settings-choice:hover { border-color: #5d6670; }
.dialog SpinBox.settings-spin:focus, .dialog Dropdown.settings-choice:focus { border-color: #4c98fd; }

.dialog SpinBox.settings-spin::label, .dialog Dropdown.settings-choice::label {
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 15;
    text-xalign: left;
}

.dialog SpinBox.settings-spin::prefix {
    text-color: #9aa3ab;
    font-family: "Noto Sans", sans-serif;
    font-size: 13;
}

.dialog SpinBox.settings-spin::up, .dialog SpinBox.settings-spin::down {
    background-color: #2a2e35;
    width: 12;
    margin: 1;
    radius: 2;
}

.dialog Dropdown.settings-choice::popup {
    background-color: #202328;
    border: 1 #4a5259;
    radius: 6;
    padding: 4 0;
}

.dialog Dropdown.settings-choice::item {
    background-color: #202328;
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 15;
    text-xalign: left;
    height: 28;
    padding: 0 8;
    radius: 0;
}

.dialog Dropdown.settings-choice::item:hover { background-color: #4c98fd; }

.dialog CheckBox.settings-check {
    background-color: transparent;
    border-color: transparent;
    margin: 4 3;
}

.dialog CheckBox.settings-check::box {
    background-color: #17191d;
    border: 1 #4a5259;
    radius: 4;
    padding: 3;
    margin-right: 8;
}

.dialog CheckBox.settings-check:focus::box { border-color: #4c98fd; }
.dialog CheckBox.settings-check::mark { background-color: transparent; radius: 2; }
.dialog CheckBox.settings-check:checked::mark { background-color: #4c98fd; }

.dialog CheckBox.settings-check::label {
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 15;
    text-xalign: left;
}

// the actions of the game, a row each: its name and its bindings
.dialog ListView.settings-actions {
    background-color: #17191d;
    border: 1 #4a5259;
    radius: 6;
    height: 220;
    margin: 0 3 8 3;
}

.dialog ListView.settings-actions:focus { border-color: #4c98fd; }

.dialog ListView.settings-actions::row {
    text-color: #eeeff2;
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 13;
    text-xalign: left;
    height: 24;
    padding: 0 8;
}

.dialog ListView.settings-actions::row:hover { background-color: #2a2e35; }
.dialog ListView.settings-actions::row:selected { background-color: #4c98fd; }
