// The failure of the build of the editor of a project, over the project manager: the first error of the compiler, and
// the buttons opening the file of all the errors and the whole output of the build

@style "engine:/dialog/dialog.style";
@style "build.style";

LinearLayout #DIALOG .dialog .dialog-build-error {
    Label #TITLE .dialog-question "The editor did not build";
    Label #ERROR .build-error "";
    Label #NOTE .build-note "";
    LinearLayout .dialog-buttons {
        PushButton .dialog-tool "Open the errors" { on-click: errors; }
        PushButton .dialog-tool .dialog-tool-after "Open the whole output" { on-click: log; }
        Box .dialog-fill;
        PushButton #CLOSE .dialog-accept "Close" { on-click: close; }
    }
}
