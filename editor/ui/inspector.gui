// The inspector of the node selected last, reporting to the behavior 'inspector': its name, then a section of fields
// for each group of the properties of the nodes selected (see NodeSchema), built by the code from the schemas of the
// node classes out of the rows below; a model has the panel of its convex hulls too, reporting to the behavior 'hulls'.
// Each section is folded by the user under its header, and the inspector scrolls over the sections taller than it

// A section of the fields of a group of properties, its rows inserted by the code
@component PropertySection ($title, $expanded: true) {
    Collapsible .fold $title { expanded: $expanded; }
}

// A field of a single number under its label
@component NumberRow ($label, $min, $max, $step, $decimals, $on-change: none) {
    LinearLayout .group {
        Label .field $label;
        SpinBox #VALUE .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-change; }
    }
}

// A row of three spin boxes under its label, the X, the Y and the Z of a vector, each changed to the slot of its axis
@component VectorRow ($label, $min, $max, $step, $decimals, $on-x: none, $on-y: none, $on-z: none) {
    LinearLayout .group {
        Label .field $label;
        LinearLayout .axes {
            SpinBox #X .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-x; }
            SpinBox #Y .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-y; }
            SpinBox #Z .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-z; }
        }
    }
}

// A box checked or not, its label beside it
@component CheckRow ($label, $on-toggle: none) {
    CheckBox .check $label { on-toggle: $on-toggle; }
}

// The choices of a property in a dropdown under its label
@component ChoiceRow ($label, $items, $on-change: none) {
    LinearLayout .group {
        Label .field $label;
        Dropdown #VALUE .dropdown $items { on-change: $on-change; }
    }
}

// A text under its label, applied when Enter is pressed
@component TextRow ($label, $on-validate: none) {
    LinearLayout .group {
        Label .field $label;
        InputText #VALUE .input { max-length: 256; on-validate: $on-validate; }
    }
}

// What a property of the node is, the editor not changing it
@component NoteRow ($text) {
    LinearLayout .group {
        Label #VALUE .note $text;
    }
}

// The 32 collision layers under their label, in four rows of eight boxes inserted by the code
@component LayersRow ($label) {
    LinearLayout .group {
        Label .field $label;
    }
}

@component BitRow () {
    LinearLayout .bits;
}

@component BitBox ($label, $on-toggle: none) {
    CheckBox .bit $label { on-toggle: $on-toggle; }
}

// The convex decomposition saved next to the file of a model, the shape of a body of its hulls, drawn over the model;
// the export of the project decomposes the models, not the editor
@component HullsPanel () {
    Collapsible .fold "Convex hulls" {
        CheckBox #SHOWN .check "Show the hulls" { on-toggle: hulls::shown; }
        Label #STATE .note "No hulls saved";
    }
}

@component Inspector () {
    LinearLayout .panel .inspector {
        Label .section "INSPECTOR";
        Label #KIND .kind "Nothing selected";

        Label .field "Name";
        InputText #NAME .input { max-length: 64; on-validate: inspector::renamed; }

        LinearLayout #PROPERTIES .group;
        HullsPanel #HULLS;
    }
}
