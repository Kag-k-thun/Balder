// The inspector of the node selected last, reporting to the behavior 'inspector': the icon of its kind, its name and
// its kind, then a section of fields for each group of the properties of the nodes selected (see NodeSchema), built by
// the code from the schemas of the node classes out of the rows below; a mesh has the panel of its materials, reporting to the behavior 'materials', a
// model the panel of its convex hulls too, reporting to the behavior 'hulls',
// and an actor the panel of its connections, reporting to the behavior 'connections'.
// Each section is folded by the user under its header, and the inspector scrolls over the sections taller than it

// A section of the fields of a group of properties, its rows inserted by the code
@component PropertySection ($title, $expanded: true) {
    Collapsible .fold $title { expanded: $expanded; }
}

// A row of a property: its label on the left, in a column of the same width in every row, and its field filling the
// rest of the row (see LinearLayout.row)

// A field of a single number beside its label
@component NumberRow ($label, $min, $max, $step, $decimals, $on-change: none) {
    LinearLayout .row {
        Label .row-label $label;
        SpinBox #VALUE .spin .value { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-change; }
    }
}

// Three spin boxes beside their label, the X, the Y and the Z of a vector, each lettered by its prefix and changed to
// the slot of its axis; a colour letters them R, G and B
@component VectorRow ($label, $min, $max, $step, $decimals, $on-x: none, $on-y: none, $on-z: none,
                      $x: "X", $y: "Y", $z: "Z") {
    LinearLayout .row {
        Label .row-label $label;
        LinearLayout .axes .value {
            SpinBox #X .spin .axis .x { prefix: $x; min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-x; }
            SpinBox #Y .spin .axis .y { prefix: $y; min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-y; }
            SpinBox #Z .spin .axis .z { prefix: $z; min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-z; }
        }
    }
}

// A box checked or not beside its label
@component CheckRow ($label, $on-toggle: none) {
    LinearLayout .row {
        Label .row-label $label;
        CheckBox #VALUE .check .value "" { on-toggle: $on-toggle; }
    }
}

// The choices of a property in a dropdown beside its label
@component ChoiceRow ($label, $items, $on-change: none) {
    LinearLayout .row {
        Label .row-label $label;
        Dropdown #VALUE .dropdown .value $items { on-change: $on-change; }
    }
}

// A text beside its label, applied when Enter is pressed
@component TextRow ($label, $on-validate: none) {
    LinearLayout .row {
        Label .row-label $label;
        InputText #VALUE .input .value { max-length: 256; on-validate: $on-validate; }
    }
}

// What a property of the node is, the editor not changing it, across the width of the row
@component NoteRow ($text) {
    LinearLayout .group {
        Label #VALUE .note $text;
    }
}

// The 32 collision layers under their label, alone on its row, in four rows of eight boxes inserted by the code across
// the width of the inspector, eight boxes not fitting in the column of the fields
@component LayersRow ($label) {
    LinearLayout .group {
        LinearLayout .row {
            Label .row-label $label;
        }
    }
}

@component BitRow () {
    LinearLayout .bits;
}

@component BitBox ($label, $on-toggle: none) {
    CheckBox .bit $label { on-toggle: $on-toggle; }
}

// The convex decomposition saved next to the file of a model, the shape of a body of its hulls, drawn over the model;
// the export of the project decomposes the models, not the editor
@component HullsPanel () {
    Collapsible .fold "Convex hulls" {
        CheckBox #SHOWN .check "Show the hulls" { on-toggle: hulls::shown; }
        Label #STATE .note "No hulls saved";
    }
}

// The connections of the signals of the actor inspected to the slots of the actors of the scene, which the game makes
// as it builds the scene: one picked in the table is removed, another made from a signal of the actor, an actor of the
// scene and one of its slots taking the payload of the signal
@component ConnectionsPanel () {
    Collapsible .fold "Connections" {
        TableView #TABLE .connections { on-select: connections::picked; }
        PushButton #REMOVE .action "Remove the connection" { on-click: connections::remove; }
        Label .field "Signal";
        Dropdown #SIGNAL .dropdown { on-change: connections::signal; }
        Label .field "Actor receiving it";
        Dropdown #TARGET .dropdown { on-change: connections::target; }
        Label .field "Slot";
        Dropdown #SLOT .dropdown;
        PushButton #CONNECT .action "Connect" { on-click: connections::connect; }
    }
}

// The materials of the parts of the mesh inspected, assets shared by the meshes drawing them: the part picked has its
// material edited in a tab of its own, given a copy of it local to the scene or in a file, another material file, or
// its own again
@component MaterialSlotsPanel () {
    Collapsible .fold "Materials" {
        TableView #TABLE .connections { on-select: materials::picked; }
        PushButton #EDIT .action "Edit the material" { on-click: materials::edit; tooltip: "Open the material in a tab of its own"; }
        PushButton #UNIQUE .action "Make unique" { on-click: materials::unique;
                                                   tooltip: "Give the part a copy of its material, local to the scene"; }
        PushButton #DUPLICATE .action "Duplicate to a file…" { on-click: materials::duplicate;
                                                               tooltip: "Give the part a copy of its material, in a .material file"; }
        PushButton #CHOOSE .action "Use a material file…" { on-click: materials::choose; }
        PushButton #OWN .action "Use the part's own" { on-click: materials::own;
                                                       tooltip: "Draw the part with the material of its mesh"; }
    }
}

@component Inspector () {
    LinearLayout .panel .inspector {
        Label .section "INSPECTOR";

        // the icon of the kind of the node, then its name, edited in place, over its kind
        LinearLayout #HEAD .head {
            Box #ICON .kind-icon;
            LinearLayout .head-text {
                InputText #NAME .title { max-length: 64; on-validate: inspector::renamed; }
                Label #KIND .kind "Nothing selected";
            }
        }

        LinearLayout #PROPERTIES .group;
        MaterialSlotsPanel #MATERIALS;
        HullsPanel #HULLS;
        ConnectionsPanel #CONNECTIONS;
    }
}

