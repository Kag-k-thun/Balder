// The inspector of the node selected last, reporting to the behavior 'inspector': its name, then the fields of an object
// (its transform) or those of a light, the panel of the other kind absent

// A row of three spin boxes, the X, the Y and the Z of a vector, each changed to the slot of its axis
@component AxisRow ($min, $max, $step, $decimals, $on-x: none, $on-y: none, $on-z: none) {
    LinearLayout .axes {
        SpinBox #X .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-x; }
        SpinBox #Y .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-y; }
        SpinBox #Z .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-z; }
    }
}

// A field of a single number under its label
@component NumberRow ($label, $min, $max, $step, $decimals, $on-change: none) {
    LinearLayout .group {
        Label .field $label;
        SpinBox #VALUE .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-change; }
    }
}

// The fields of a mesh, a model or a group: its transform
@component ObjectPanel () {
    LinearLayout .group {
        Label .field "Position";
        AxisRow #POSITION {
            min: -10000; max: 10000; step: 0.01; decimals: 2;
            on-x: inspector::moved(0); on-y: inspector::moved(1); on-z: inspector::moved(2);
        }

        Label .field "Rotation (degrees)";
        AxisRow #ROTATION {
            min: -720; max: 720; step: 0.1; decimals: 1;
            on-x: inspector::turned(0); on-y: inspector::turned(1); on-z: inspector::turned(2);
        }

        Label .field "Scale";
        AxisRow #SCALE {
            min: -1000; max: 1000; step: 0.01; decimals: 2;
            on-x: inspector::scaled(0); on-y: inspector::scaled(1); on-z: inspector::scaled(2);
        }
    }
}

// The fields of a light, those its type does not use absent: the position of a point or a spot light, the direction
// of a direction or a spot light, the range of a point or a spot light and the cone of a spot light
@component LightPanel () {
    LinearLayout .group {
        LinearLayout #PLACE .group {
            Label .field "Position";
            AxisRow #POSITION {
                min: -10000; max: 10000; step: 0.01; decimals: 2;
                on-x: inspector::moved(0); on-y: inspector::moved(1); on-z: inspector::moved(2);
            }
        }

        LinearLayout #AIM .group {
            Label .field "Direction";
            AxisRow #DIRECTION {
                min: -1; max: 1; step: 0.05; decimals: 2;
                on-x: inspector::aimed(0); on-y: inspector::aimed(1); on-z: inspector::aimed(2);
            }
        }

        Label .field "Colour";
        AxisRow #COLOR {
            min: 0; max: 1; step: 0.01; decimals: 2;
            on-x: inspector::colored(0); on-y: inspector::colored(1); on-z: inspector::colored(2);
        }

        NumberRow #INTENSITY "Intensity" { min: 0; max: 100000; step: 0.1; decimals: 2; on-change: inspector::intensified; }
        NumberRow #RANGE "Range" { min: 0; max: 100000; step: 0.1; decimals: 2; on-change: inspector::ranged; }

        LinearLayout #CONE .group {
            NumberRow #INNER "Inner angle (degrees)" { min: 0; max: 90; step: 0.5; decimals: 1; on-change: inspector::narrowed; }
            NumberRow #OUTER "Outer angle (degrees)" { min: 0; max: 90; step: 0.5; decimals: 1; on-change: inspector::widened; }
        }

        CheckBox #SHADOWS .check "Casts shadows" { on-toggle: inspector::shadowed; }
    }
}

@component Inspector () {
    LinearLayout .panel .inspector {
        Label .section "INSPECTOR";
        Label #KIND .kind "Nothing selected";

        Label .field "Name";
        InputText #NAME .input { max-length: 64; on-validate: inspector::renamed; }

        ObjectPanel #OBJECT;
        LightPanel #LIGHT;
    }
}
