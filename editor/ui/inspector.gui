// The inspector of the node selected last, reporting to the behavior 'inspector': its name, then the fields of an object
// (its transform) or those of a light, then those of a marker, a path, a volume, a body or a camera, the panels of the other kinds
// absent; a model has the panel of its convex hulls too, reporting to the behavior 'hulls'. Each panel is a section the
// user folds under its header, and the inspector scrolls over the sections taller than it

// A row of three spin boxes, the X, the Y and the Z of a vector, each changed to the slot of its axis
@component AxisRow ($min, $max, $step, $decimals, $on-x: none, $on-y: none, $on-z: none) {
    LinearLayout .axes {
        SpinBox #X .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-x; }
        SpinBox #Y .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-y; }
        SpinBox #Z .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-z; }
    }
}

// A field of a single number under its label
@component NumberRow ($label, $min, $max, $step, $decimals, $on-change: none) {
    LinearLayout .group {
        Label .field $label;
        SpinBox #VALUE .spin { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-change; }
    }
}

// The fields of a mesh, a model or an empty: its transform
@component ObjectPanel () {
    Collapsible .fold "Transform" {
        Label .field "Position";
        AxisRow #POSITION {
            min: -10000; max: 10000; step: 0.01; decimals: 2;
            on-x: inspector::moved(0); on-y: inspector::moved(1); on-z: inspector::moved(2);
        }

        Label .field "Rotation (degrees)";
        AxisRow #ROTATION {
            min: -720; max: 720; step: 0.1; decimals: 1;
            on-x: inspector::turned(0); on-y: inspector::turned(1); on-z: inspector::turned(2);
        }

        Label .field "Scale";
        AxisRow #SCALE {
            min: -1000; max: 1000; step: 0.01; decimals: 2;
            on-x: inspector::scaled(0); on-y: inspector::scaled(1); on-z: inspector::scaled(2);
        }
    }
}

// The fields of a light, those its type does not use absent: the position of a point or a spot light, the direction
// of a direction or a spot light, the range of a point or a spot light and the cone of a spot light
@component LightPanel () {
    Collapsible .fold "Light" {
        LinearLayout #PLACE .group {
            Label .field "Position";
            AxisRow #POSITION {
                min: -10000; max: 10000; step: 0.01; decimals: 2;
                on-x: inspector::moved(0); on-y: inspector::moved(1); on-z: inspector::moved(2);
            }
        }

        LinearLayout #AIM .group {
            Label .field "Direction";
            AxisRow #DIRECTION {
                min: -1; max: 1; step: 0.05; decimals: 2;
                on-x: inspector::aimed(0); on-y: inspector::aimed(1); on-z: inspector::aimed(2);
            }
        }

        Label .field "Colour";
        AxisRow #COLOR {
            min: 0; max: 1; step: 0.01; decimals: 2;
            on-x: inspector::colored(0); on-y: inspector::colored(1); on-z: inspector::colored(2);
        }

        NumberRow #INTENSITY "Intensity" { min: 0; max: 100000; step: 0.1; decimals: 2; on-change: inspector::intensified; }
        NumberRow #RANGE "Range" { min: 0; max: 100000; step: 0.1; decimals: 2; on-change: inspector::ranged; }

        LinearLayout #CONE .group {
            NumberRow #INNER "Inner angle (degrees)" { min: 0; max: 90; step: 0.5; decimals: 1; on-change: inspector::narrowed; }
            NumberRow #OUTER "Outer angle (degrees)" { min: 0; max: 90; step: 0.5; decimals: 1; on-change: inspector::widened; }
        }

        CheckBox #SHADOWS .check "Casts shadows" { on-toggle: inspector::shadowed; }
    }
}

// The fields of a marker: what it marks, and the tags the game looks it up by
@component MarkerPanel () {
    Collapsible .fold "Marker" {
        Label .field "Purpose";
        Dropdown #PURPOSE .dropdown "Generic", "Spawn point", "Waypoint", "Socket" { on-change: inspector::purposed; }

        Label .field "Tags, separated by spaces";
        InputText #TAGS .input { max-length: 256; on-validate: inspector::tagged; }
    }
}

// The fields of a path: how its curve goes from a point to the next, and whether it goes back to the first one
@component PathPanel () {
    Collapsible .fold "Path" {
        Label .field "Curve";
        Dropdown #CURVE .dropdown "Catmull-Rom", "Bézier" { on-change: inspector::curved; }

        CheckBox #CLOSED .check "Closed" { on-toggle: inspector::closed; }
    }
}

// The fields of a volume, those its shape does not use absent: the sides of a box, the radius of a sphere or of a
// capsule, the height of a capsule
@component VolumePanel () {
    Collapsible .fold "Volume" {
        Label .field "Shape";
        Dropdown #SHAPE .dropdown "Box", "Sphere", "Capsule" { on-change: inspector::shaped; }

        LinearLayout #SIDES .group {
            Label .field "Size";
            AxisRow #SIZE {
                min: 0.01; max: 10000; step: 0.05; decimals: 2;
                on-x: inspector::sized(0); on-y: inspector::sized(1); on-z: inspector::sized(2);
            }
        }

        NumberRow #RADIUS "Radius" { min: 0.01; max: 10000; step: 0.05; decimals: 2; on-change: inspector::rounded; }
        NumberRow #HEIGHT "Height, the caps included" { min: 0.02; max: 10000; step: 0.05; decimals: 2; on-change: inspector::heightened; }
    }
}

// The fields of a body or of a character, in four sections, the rows its motion and its shape do not use absent: how it
// moves, its shape and its sizes (the model of its hulls or its mesh told under them) and whether it is a trigger; the
// numbers of its material; the settings of a dynamic body, absent for the others; then the layers it is in and the
// layers it touches, one box by layer, folded at first. A character has neither a motion nor a shape to choose, its
// capsule only sized
@component BodyPanel () {
    LinearLayout .group {
        Collapsible .fold "Physics body" {
            LinearLayout #MOVES .group {
                Label .field "Motion";
                Dropdown #MOTION .dropdown "Static", "Kinematic", "Dynamic" { on-change: inspector::moving; }
            }

            LinearLayout #FORM .group {
                Label .field "Shape";
                Dropdown #SHAPE .dropdown "Box", "Sphere", "Capsule", "Cylinder", "Plane", "Hulls of the model",
                                          "Mesh of the model", "Compound of the volumes" { on-change: inspector::outlined; }
            }

            LinearLayout #SIDES .group {
                Label .field "Size";
                AxisRow #SIZE {
                    min: 0.01; max: 10000; step: 0.05; decimals: 2;
                    on-x: inspector::bodySized(0); on-y: inspector::bodySized(1); on-z: inspector::bodySized(2);
                }
            }

            NumberRow #RADIUS "Radius" { min: 0.01; max: 10000; step: 0.05; decimals: 2; on-change: inspector::bodyRounded; }
            NumberRow #HEIGHT "Height" { min: 0.01; max: 10000; step: 0.05; decimals: 2; on-change: inspector::bodyHeightened; }
            LinearLayout #SOURCE .group {
                Label #MODEL .note "";
            }

            CheckBox #TRIGGER .check "Trigger, stopping nothing" { on-toggle: inspector::switched(2); }
        }

        Collapsible .fold "Material" {
            NumberRow #FRICTION "Friction" { min: 0; max: 10; step: 0.05; decimals: 2; on-change: inspector::tuned(1); }
            NumberRow #RESTITUTION "Restitution" { min: 0; max: 1; step: 0.05; decimals: 2; on-change: inspector::tuned(2); }
        }

        Collapsible #DYNAMIC .fold "Dynamics" {
            NumberRow #MASS "Mass (kg)" { min: 0.001; max: 1000000; step: 0.1; decimals: 3; on-change: inspector::tuned(0); }
            NumberRow #LINEAR "Linear damping" { min: 0; max: 100; step: 0.01; decimals: 2; on-change: inspector::tuned(3); }
            NumberRow #ANGULAR "Angular damping" { min: 0; max: 100; step: 0.01; decimals: 2; on-change: inspector::tuned(4); }
            NumberRow #ROLLING "Rolling friction" { min: 0; max: 10; step: 0.01; decimals: 2; on-change: inspector::tuned(5); }
            NumberRow #SPINNING "Spinning friction" { min: 0; max: 10; step: 0.01; decimals: 2; on-change: inspector::tuned(6); }
            CheckBox #SLEEPS .check "Can sleep" { on-toggle: inspector::switched(0); }
            CheckBox #BULLET .check "Bullet, advanced along its motion" { on-toggle: inspector::switched(1); }
        }

        Collapsible .fold "Collision layers" { expanded: false;
            Label .field "Layers it is in";
            LinearLayout #LAYER .group {
                LinearLayout #R0 .bits {
                    CheckBox #B0 .bit "0" { on-toggle: inspector::layered(0); }
                    CheckBox #B1 .bit "1" { on-toggle: inspector::layered(1); }
                    CheckBox #B2 .bit "2" { on-toggle: inspector::layered(2); }
                    CheckBox #B3 .bit "3" { on-toggle: inspector::layered(3); }
                    CheckBox #B4 .bit "4" { on-toggle: inspector::layered(4); }
                    CheckBox #B5 .bit "5" { on-toggle: inspector::layered(5); }
                    CheckBox #B6 .bit "6" { on-toggle: inspector::layered(6); }
                    CheckBox #B7 .bit "7" { on-toggle: inspector::layered(7); }
                }
                LinearLayout #R1 .bits {
                    CheckBox #B8 .bit "8" { on-toggle: inspector::layered(8); }
                    CheckBox #B9 .bit "9" { on-toggle: inspector::layered(9); }
                    CheckBox #B10 .bit "10" { on-toggle: inspector::layered(10); }
                    CheckBox #B11 .bit "11" { on-toggle: inspector::layered(11); }
                    CheckBox #B12 .bit "12" { on-toggle: inspector::layered(12); }
                    CheckBox #B13 .bit "13" { on-toggle: inspector::layered(13); }
                    CheckBox #B14 .bit "14" { on-toggle: inspector::layered(14); }
                    CheckBox #B15 .bit "15" { on-toggle: inspector::layered(15); }
                }
                LinearLayout #R2 .bits {
                    CheckBox #B16 .bit "16" { on-toggle: inspector::layered(16); }
                    CheckBox #B17 .bit "17" { on-toggle: inspector::layered(17); }
                    CheckBox #B18 .bit "18" { on-toggle: inspector::layered(18); }
                    CheckBox #B19 .bit "19" { on-toggle: inspector::layered(19); }
                    CheckBox #B20 .bit "20" { on-toggle: inspector::layered(20); }
                    CheckBox #B21 .bit "21" { on-toggle: inspector::layered(21); }
                    CheckBox #B22 .bit "22" { on-toggle: inspector::layered(22); }
                    CheckBox #B23 .bit "23" { on-toggle: inspector::layered(23); }
                }
                LinearLayout #R3 .bits {
                    CheckBox #B24 .bit "24" { on-toggle: inspector::layered(24); }
                    CheckBox #B25 .bit "25" { on-toggle: inspector::layered(25); }
                    CheckBox #B26 .bit "26" { on-toggle: inspector::layered(26); }
                    CheckBox #B27 .bit "27" { on-toggle: inspector::layered(27); }
                    CheckBox #B28 .bit "28" { on-toggle: inspector::layered(28); }
                    CheckBox #B29 .bit "29" { on-toggle: inspector::layered(29); }
                    CheckBox #B30 .bit "30" { on-toggle: inspector::layered(30); }
                    CheckBox #B31 .bit "31" { on-toggle: inspector::layered(31); }
                }
            }

            Label .field "Layers it touches";
            LinearLayout #MASK .group {
                LinearLayout #R0 .bits {
                    CheckBox #B0 .bit "0" { on-toggle: inspector::masked(0); }
                    CheckBox #B1 .bit "1" { on-toggle: inspector::masked(1); }
                    CheckBox #B2 .bit "2" { on-toggle: inspector::masked(2); }
                    CheckBox #B3 .bit "3" { on-toggle: inspector::masked(3); }
                    CheckBox #B4 .bit "4" { on-toggle: inspector::masked(4); }
                    CheckBox #B5 .bit "5" { on-toggle: inspector::masked(5); }
                    CheckBox #B6 .bit "6" { on-toggle: inspector::masked(6); }
                    CheckBox #B7 .bit "7" { on-toggle: inspector::masked(7); }
                }
                LinearLayout #R1 .bits {
                    CheckBox #B8 .bit "8" { on-toggle: inspector::masked(8); }
                    CheckBox #B9 .bit "9" { on-toggle: inspector::masked(9); }
                    CheckBox #B10 .bit "10" { on-toggle: inspector::masked(10); }
                    CheckBox #B11 .bit "11" { on-toggle: inspector::masked(11); }
                    CheckBox #B12 .bit "12" { on-toggle: inspector::masked(12); }
                    CheckBox #B13 .bit "13" { on-toggle: inspector::masked(13); }
                    CheckBox #B14 .bit "14" { on-toggle: inspector::masked(14); }
                    CheckBox #B15 .bit "15" { on-toggle: inspector::masked(15); }
                }
                LinearLayout #R2 .bits {
                    CheckBox #B16 .bit "16" { on-toggle: inspector::masked(16); }
                    CheckBox #B17 .bit "17" { on-toggle: inspector::masked(17); }
                    CheckBox #B18 .bit "18" { on-toggle: inspector::masked(18); }
                    CheckBox #B19 .bit "19" { on-toggle: inspector::masked(19); }
                    CheckBox #B20 .bit "20" { on-toggle: inspector::masked(20); }
                    CheckBox #B21 .bit "21" { on-toggle: inspector::masked(21); }
                    CheckBox #B22 .bit "22" { on-toggle: inspector::masked(22); }
                    CheckBox #B23 .bit "23" { on-toggle: inspector::masked(23); }
                }
                LinearLayout #R3 .bits {
                    CheckBox #B24 .bit "24" { on-toggle: inspector::masked(24); }
                    CheckBox #B25 .bit "25" { on-toggle: inspector::masked(25); }
                    CheckBox #B26 .bit "26" { on-toggle: inspector::masked(26); }
                    CheckBox #B27 .bit "27" { on-toggle: inspector::masked(27); }
                    CheckBox #B28 .bit "28" { on-toggle: inspector::masked(28); }
                    CheckBox #B29 .bit "29" { on-toggle: inspector::masked(29); }
                    CheckBox #B30 .bit "30" { on-toggle: inspector::masked(30); }
                    CheckBox #B31 .bit "31" { on-toggle: inspector::masked(31); }
                }
            }
        }
    }
}

// The fields of a camera, the field of view of a perspective camera and the height of the view of an orthographic one
// absent for the other: how it projects, the planes it sees between, and whether it is the active camera of the scene,
// the one the game draws it through
@component CameraPanel () {
    Collapsible .fold "Camera" {
        Label .field "Projection";
        Dropdown #PROJECTION .dropdown "Perspective", "Orthographic" { on-change: inspector::projected; }

        NumberRow #FOV "Field of view (degrees)" { min: 1; max: 179; step: 0.5; decimals: 1; on-change: inspector::framed(0); }
        NumberRow #SIZE "Height of the view" { min: 0.1; max: 100000; step: 0.1; decimals: 2; on-change: inspector::framed(1); }
        NumberRow #NEAR "Near plane" { min: 0.01; max: 100000; step: 0.01; decimals: 2; on-change: inspector::framed(2); }
        NumberRow #FAR "Far plane" { min: 1; max: 1000000; step: 1; decimals: 1; on-change: inspector::framed(3); }

        CheckBox #ACTIVE .check "Active, the game seen through it" { on-toggle: inspector::activated; }
    }
}

// The convex decomposition saved next to the file of a model, the shape of a body of its hulls, drawn over the model;
// the export of the project decomposes the models, not the editor
@component HullsPanel () {
    Collapsible .fold "Convex hulls" {
        CheckBox #SHOWN .check "Show the hulls" { on-toggle: hulls::shown; }
        Label #STATE .note "No hulls saved";
    }
}

@component Inspector () {
    LinearLayout .panel .inspector {
        Label .section "INSPECTOR";
        Label #KIND .kind "Nothing selected";

        Label .field "Name";
        InputText #NAME .input { max-length: 64; on-validate: inspector::renamed; }

        ObjectPanel #OBJECT;
        LightPanel #LIGHT;
        MarkerPanel #MARKER;
        PathPanel #PATH;
        VolumePanel #VOLUME;
        BodyPanel #BODY;
        CameraPanel #CAMERA;
        HullsPanel #HULLS;
    }
}
