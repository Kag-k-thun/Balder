// The build of the editor of a project, over the look of the dialogs of Balder (engine:/dialog/dialog.style)

LinearLayout.dialog.dialog-build {
    width: 560;
    max-width: none;
}

.dialog ProgressBar.build-bar {
    background-color: #2a2f36;
    radius: 999;
    height: 10;
    margin: 8 3 8 3;
}

.dialog ProgressBar.build-bar::fill {
    background-color: #2f81f7;
    radius: 999;
}

// the step of the build: the target compiled, and its modules
.dialog Label.build-step {
    text-color: #e6edf3;
    text-xalign: left;
    font-size: 14;
    margin: 0 3 4 3;
}

.dialog Label.build-note {
    text-color: #9aa3ab;
    text-xalign: left;
    text-wrap: wrap;
    font-size: 13;
    margin: 0 3 4 3;
}

// the failure of a build: its first error as the compiler writes it, in a box
LinearLayout.dialog.dialog-build-error {
    width: 860;
    max-width: none;
}

.dialog Label.build-error {
    background-color: #0d1117;
    border: 1 #30363d;
    radius: 6;
    padding: 10 12;
    margin: 4 3 8 3;
    text-color: #ffa198;
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 13;
    text-xalign: left;
    text-wrap: wrap;
}
