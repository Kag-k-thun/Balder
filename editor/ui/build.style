// The failure of the build of the library of a project, over the look of the dialogs of Balder
// (engine:/dialog/dialog.style)

.dialog Label.build-note {
    text-color: #9aa3ab;
    text-xalign: left;
    text-wrap: wrap;
    font-size: 13;
    margin: 0 3 4 3;
}

// its first error as the compiler writes it, in a box
LinearLayout.dialog.dialog-build-error {
    width: 860;
    max-width: none;
}

.dialog Label.build-error {
    background-color: #0d1117;
    border: 1 #30363d;
    radius: 6;
    padding: 10 12;
    margin: 4 3 8 3;
    text-color: #ffa198;
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 13;
    text-xalign: left;
    text-wrap: wrap;
}
