// The editor of Balder: the outline of the scene on the left, its viewport in the middle, the inspector of the node
// selected on the right, under a menu bar and above a status bar, which tells on its right the file of the scene and
// whether it has unsaved changes; the Add menu, its kinds of nodes grouped in submenus, opens under the cursor with
// Ctrl+E as well, its Physics submenu adding a body, a character, or a body around each node selected
@import "inspector.gui";

MenuLayout .root {
    LinearLayout #BAR .bar {
        MenuButton .menu "Scene" {
            LinearLayout .popup {
                PushButton .item "New scene" { on-click: scene::new; }
                PushButton .item "Open a scene…" { on-click: scene::open; }
                Separator .menu-rule;
                PushButton .item "Save (Ctrl+S)" { on-click: scene::save; }
                PushButton .item "Save as… (Ctrl+Shift+S)" { on-click: scene::save-as; }
                Separator .menu-rule;
                PushButton .item "Back to the project manager" { on-click: scene::manager; }
                PushButton .item "Quit" { on-click: scene::quit; }
            }
        }
        MenuButton #ADD .menu "Add" {
            LinearLayout .popup {
                MenuButton .submenu "Mesh ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Cube" { on-click: add::cube; }
                        PushButton .item "Sphere" { on-click: add::sphere; }
                        PushButton .item "Plane" { on-click: add::plane; }
                        PushButton .item "Model from a file…" { on-click: add::model; }
                    }
                }
                MenuButton .submenu "Light ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Direction light" { on-click: add::direction; }
                        PushButton .item "Point light" { on-click: add::point; }
                        PushButton .item "Spot light" { on-click: add::spot; }
                    }
                }
                MenuButton .submenu "Marker ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Marker" { on-click: add::marker; }
                        PushButton .item "Spawn point" { on-click: add::spawn; }
                        PushButton .item "Waypoint" { on-click: add::waypoint; }
                        PushButton .item "Socket" { on-click: add::socket; }
                    }
                }
                MenuButton .submenu "Path ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Path" { on-click: add::path; }
                        PushButton .item "Point of the path, after the selection" { on-click: add::path-point; }
                    }
                }
                MenuButton .submenu "Volume ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Box volume" { on-click: add::box-volume; }
                        PushButton .item "Sphere volume" { on-click: add::sphere-volume; }
                        PushButton .item "Capsule volume" { on-click: add::capsule-volume; }
                    }
                }
                MenuButton .submenu "Physics ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Body" { on-click: add::body; }
                        PushButton .item "Character" { on-click: add::character; }
                        Separator .menu-rule;
                        PushButton .item "Physics body around the selection" { on-click: add::wrap; }
                    }
                }
                Separator .menu-rule;
                PushButton .item "Empty" { on-click: add::empty; }
            }
        }
        MenuButton #EDIT .menu "Edit" {
            LinearLayout .popup {
                PushButton #UNDO .item .idle "Undo (Ctrl+Z)" { on-click: edit::undo; }
                PushButton #REDO .item .idle "Redo (Ctrl+Shift+Z)" { on-click: edit::redo; }
                Separator .menu-rule;
                PushButton .item "Duplicate (Ctrl+D)" { on-click: edit::duplicate; }
                PushButton .item "Delete (Del)" { on-click: edit::delete; }
                Separator .menu-rule;
                PushButton .item "Frame the selection (F)" { on-click: edit::frame; }
            }
        }
        MenuButton #VIEW .menu "View" {
            LinearLayout .popup {
                PushButton #ICONS .item "Hide the icons" { on-click: view::icons; }
            }
        }
        MenuButton .menu "Gizmo" {
            LinearLayout .popup {
                PushButton .item "Translate (W)" { on-click: gizmo::translate; }
                PushButton .item "Rotate (E)" { on-click: gizmo::rotate; }
                PushButton .item "Scale (R)" { on-click: gizmo::scale; }
            }
        }
    }

    LinearLayout #BODY .body {
        Splitter #MAIN .main {
            LinearLayout #OUTLINE .panel .outline {
                Label .section "SCENE";
                TreeView #TREE .tree { multiple: true; draggable: true; on-select: outline::picked; on-activate: outline::reached;
                                       on-drop: outline::dropped; }
            }

            Scene3D #VIEW .viewport { resolution: 1280 720; editable: true;
                EditorViewport #GIZMO;
            }

            Inspector #INSPECTOR;
        }

        LinearLayout #FOOT .footer {
            Label #STATUS .status "Ready";
            Label #DOCUMENT .status .document "";
        }
    }
}
