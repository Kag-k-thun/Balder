// The editor of Balder: the outline of the scene on the left, its viewport in the middle, the inspector of the node
// selected on the right, under a menu bar and above a status bar
@import "inspector.gui";

MenuLayout .root {
    LinearLayout #BAR .bar {
        MenuButton .menu "Scene" {
            LinearLayout .popup {
                PushButton .item "New scene" { on-click: scene::new; }
                PushButton .item "Open a scene…" { on-click: scene::open; }
                Separator .menu-rule;
                PushButton .item "Quit" { on-click: scene::quit; }
            }
        }
        MenuButton .menu "Add" {
            LinearLayout .popup {
                PushButton .item "Cube" { on-click: add::cube; }
                PushButton .item "Sphere" { on-click: add::sphere; }
                PushButton .item "Plane" { on-click: add::plane; }
                PushButton .item "Model from a file…" { on-click: add::model; }
                Separator .menu-rule;
                PushButton .item "Group" { on-click: add::group; }
                Separator .menu-rule;
                PushButton .item "Direction light" { on-click: add::direction; }
                PushButton .item "Point light" { on-click: add::point; }
                PushButton .item "Spot light" { on-click: add::spot; }
            }
        }
        MenuButton .menu "Edit" {
            LinearLayout .popup {
                PushButton .item "Duplicate (Ctrl+D)" { on-click: edit::duplicate; }
                PushButton .item "Delete (Del)" { on-click: edit::delete; }
                Separator .menu-rule;
                PushButton .item "Frame the selection (F)" { on-click: edit::frame; }
            }
        }
        MenuButton .menu "Gizmo" {
            LinearLayout .popup {
                PushButton .item "Translate (W)" { on-click: gizmo::translate; }
                PushButton .item "Rotate (E)" { on-click: gizmo::rotate; }
                PushButton .item "Scale (R)" { on-click: gizmo::scale; }
            }
        }
    }

    LinearLayout #BODY .body {
        Splitter #MAIN .main {
            LinearLayout #OUTLINE .panel .outline {
                Label .section "SCENE";
                TreeView #TREE .tree { multiple: true; on-select: outline::picked; on-activate: outline::reached; }
            }

            Scene3D #VIEW .viewport { resolution: 1280 720; editable: true;
                EditorViewport #GIZMO;
            }

            Inspector #INSPECTOR;
        }

        Label #STATUS .status "Ready";
    }
}
