// The editor of Balder: the outline of the scene on the left, its viewport in the middle, the inspector of the node
// selected on the right, under a top row and above a status bar, which tells on its right the file of the scene and
// whether it has unsaved changes. The top row holds the logo, the menus, the tabs of the scenes opened (each a
// document, + opening a new scene), then Compile, which builds the library of the game again and loads it, and Play,
// Pause and Stop, idle until the play mode comes; the Add menu, its kinds of nodes grouped in submenus, opens under the
// cursor with Ctrl+E as well, its Physics submenu adding a body, a character, or a body around each node selected, the
// actor classes of the game following in a submenu per category; the View menu looks through the camera selected
@import "inspector.gui";
@import "material.gui";
@import "docks.gui";
@import "viewport.gui";

// A submenu of the Add menu listing the actor classes of a category, inserted by the code, the classes in LIST
@component ActorCategory ($title) {
    MenuButton .submenu $title { open-on-hover: true;
        LinearLayout #LIST .popup;
    }
}

// An actor class in the submenu of its category
@component ActorItem ($label, $on-click: none) {
    PushButton .item $label { on-click: $on-click; }
}

MenuLayout .root {
    LinearLayout #BAR .bar {
        Box .logo;
        MenuButton .menu "Scene" {
            LinearLayout .popup {
                PushButton .item "New scene" { shortcut: "Ctrl+N"; on-click: scene::new; }
                PushButton .item "Open a scene…" { shortcut: "Ctrl+O"; on-click: scene::open; }
                PushButton .item "Close the tab" { shortcut: "Ctrl+W"; on-click: scene::close; }
                Separator .menu-rule;
                PushButton .item "New material…" { on-click: scene::new-material; }
                PushButton .item "Open a material…" { on-click: scene::open-material; }
                Separator .menu-rule;
                PushButton .item "Save" { shortcut: "Ctrl+S"; on-click: scene::save; }
                PushButton .item "Save as…" { shortcut: "Ctrl+Shift+S"; on-click: scene::save-as; }
                Separator .menu-rule;
                PushButton .item "Back to the project manager" { on-click: scene::manager; }
                PushButton .item "Quit" { on-click: scene::quit; }
            }
        }
        MenuButton #ADD .menu "Add" {
            LinearLayout .popup {
                MenuButton .submenu "Mesh ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Cube" { on-click: add::node("cube"); }
                        PushButton .item "Sphere" { on-click: add::node("sphere"); }
                        PushButton .item "Plane" { on-click: add::node("plane"); }
                        PushButton .item "Model from a file…" { on-click: add::model; }
                    }
                }
                MenuButton .submenu "Light ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Direction light" { on-click: add::node("direction"); }
                        PushButton .item "Point light" { on-click: add::node("point"); }
                        PushButton .item "Spot light" { on-click: add::node("spot"); }
                    }
                }
                MenuButton .submenu "Marker ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Marker" { on-click: add::node("marker"); }
                        PushButton .item "Spawn point" { on-click: add::node("spawn"); }
                        PushButton .item "Waypoint" { on-click: add::node("waypoint"); }
                        PushButton .item "Socket" { on-click: add::node("socket"); }
                    }
                }
                MenuButton .submenu "Path ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Path" { on-click: add::path; }
                        PushButton .item "Point of the path, after the selection" { on-click: add::path-point; }
                    }
                }
                MenuButton .submenu "Volume ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Box volume" { on-click: add::node("box-volume"); }
                        PushButton .item "Sphere volume" { on-click: add::node("sphere-volume"); }
                        PushButton .item "Capsule volume" { on-click: add::node("capsule-volume"); }
                    }
                }
                MenuButton .submenu "Physics ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Body" { on-click: add::node("body"); }
                        PushButton .item "Character" { on-click: add::node("character"); }
                        Separator .menu-rule;
                        PushButton .item "Physics body around the selection" { on-click: add::wrap; }
                    }
                }
                MenuButton .submenu "Camera ▸" { open-on-hover: true;
                    LinearLayout .popup {
                        PushButton .item "Perspective camera" { on-click: add::camera("perspective"); }
                        PushButton .item "Orthographic camera" { on-click: add::camera("orthographic"); }
                    }
                }
                LinearLayout #ACTORS .actors .absent;
                Separator .menu-rule;
                PushButton .item "Empty" { on-click: add::node("empty"); }
            }
        }
        MenuButton #EDIT .menu "Edit" {
            LinearLayout .popup {
                PushButton #UNDO .item .idle "Undo" { shortcut: "Ctrl+Z"; on-click: edit::undo; }
                PushButton #REDO .item .idle "Redo" { shortcut: "Ctrl+Shift+Z"; on-click: edit::redo; }
                Separator .menu-rule;
                PushButton .item "Duplicate" { shortcut: "Ctrl+D"; on-click: edit::duplicate; }
                PushButton .item "Delete" { shortcut: "Del"; on-click: edit::delete; }
                Separator .menu-rule;
                PushButton .item "Frame the selection" { shortcut: "F"; on-click: edit::frame; }
            }
        }
        MenuButton #VIEW .menu "View" {
            LinearLayout .popup {
                PushButton #ICONS .item "Hide the icons" { on-click: view::icons; }
                PushButton #GRID .item "Hide the grid" { on-click: view::grid; }
                Separator .menu-rule;
                PushButton #THROUGH .item "Look through the camera selected" { on-click: view::through; }
            }
        }
        MenuButton #GIZMO .menu "Gizmo" {
            LinearLayout .popup {
                PushButton .item "Select" { shortcut: "Q"; on-click: gizmo::select; }
                PushButton .item "Translate" { shortcut: "W"; on-click: gizmo::translate; }
                PushButton .item "Rotate" { shortcut: "E"; on-click: gizmo::rotate; }
                PushButton .item "Scale" { shortcut: "R"; on-click: gizmo::scale; }
            }
        }

        Box .bar-seam;
        TabBar #DOCUMENTS .documents { on-select: documents::select; on-close: documents::close;
                                       on-move: documents::move; on-add: documents::new; }

        PushButton #COMPILE .compile .idle "Compile" {
            shortcut: "Ctrl+R";
            on-click: game::compile;
            tooltip: "Build the library of the game again and load it in the editor";
        }
        LinearLayout .transport {
            PushButton #PLAY .play .idle "Play" { tooltip: "Play the scene: not available yet"; }
            IconButton #PAUSE .idle "Pause the game: not available yet" { icon: "engine:/images/ui/pause.svg"; }
            IconButton #STOP .idle "Stop the game: not available yet" { icon: "engine:/images/ui/stop.svg"; }
        }
    }

    LinearLayout #BODY .body {
        // the rails on the outer edges, the docks and the viewport between them, the material editor in their place
        // while a material is shown; the docks and their slots have no id, so that a panel is BODY/MAIN/<id> in
        // whichever slot it is
        LinearLayout .work {
            DockRail #LEFT_RAIL .left;

            Splitter #MAIN .main {
                Splitter .dock .left {
                    LinearLayout .slot {
                        LinearLayout #OUTLINE .panel .outline {
                            DockHead "SCENE" { on-fold: docks::fold("OUTLINE"); }
                            TreeView #TREE .tree { multiple: true; draggable: true; on-select: outline::picked;
                                                   on-activate: outline::reached; on-drop: outline::dropped; }
                        }
                    }
                    LinearLayout .slot {
                        DockPlaceholder #FILES "FILES" { note: "The files of the project come with BAL-210";
                                                         on-fold: docks::fold("FILES"); }
                        DockPlaceholder #CAMERA "CAMERA" { note: "What the active camera sees comes with BAL-211";
                                                           on-fold: docks::fold("CAMERA"); }
                        DockPlaceholder #SETTINGS "PROJECT" { note: "The settings of the project come with BAL-138";
                                                              on-fold: docks::fold("SETTINGS"); }
                    }
                }

                // the toolbar and the path of the selection over the viewport, in a column without id so that the
                // viewport stays BODY/MAIN/VIEW
                LinearLayout .centre {
                    ToolBar #TOOLS .viewport-tools {
                        ToolGroup #TRANSFORM {
                            IconButton #SELECT "Select" { icon: "engine:/images/ui/select.svg"; shortcut: "Q";
                                                          checkable: true; group: "gizmo-tool";
                                                          on-toggle: viewport::tool("SELECT"); }
                            IconButton #MOVE "Move" { icon: "engine:/images/ui/move.svg"; shortcut: "W";
                                                      checkable: true; group: "gizmo-tool"; checked: true;
                                                      on-toggle: viewport::tool("MOVE"); }
                            IconButton #ROTATE "Rotate" { icon: "engine:/images/ui/rotate.svg"; shortcut: "E";
                                                          checkable: true; group: "gizmo-tool";
                                                          on-toggle: viewport::tool("ROTATE"); }
                            IconButton #SCALE "Scale" { icon: "engine:/images/ui/scale.svg"; shortcut: "R";
                                                        checkable: true; group: "gizmo-tool";
                                                        on-toggle: viewport::tool("SCALE"); }
                        }
                        Dropdown #SPACE .tool { on-change: viewport::space; }
                        Separator;
                        LinearLayout #SNAP .snaps {
                            SnapStep #TRANSLATION "Snap the moves, Ctrl moving freely" {
                                icon: "engine:/images/ui/snap.svg"; min: 0.05; max: 100.0; step: 0.05; decimals: 2;
                                unit: "m"; on-toggle: viewport::snap("TRANSLATION"); on-change: viewport::step("TRANSLATION");
                            }
                            SnapStep #ANGLE "Snap the rotations, Ctrl turning freely" {
                                icon: "engine:/images/ui/rotate.svg"; min: 0.05; max: 180.0; step: 0.05; decimals: 2;
                                unit: "°"; on-toggle: viewport::snap("ANGLE"); on-change: viewport::step("ANGLE");
                            }
                            SnapStep #FACTOR "Snap the scales, Ctrl scaling freely" {
                                icon: "engine:/images/ui/scale.svg"; min: 0.05; max: 10.0; step: 0.05; decimals: 2;
                                on-toggle: viewport::snap("FACTOR"); on-change: viewport::step("FACTOR");
                            }
                        }
                        Box .spring;
                        Dropdown #DISPLAY .tool { on-change: viewport::display; }
                        MenuButton #OVERLAYS .tool-menu "Overlays" {
                            LinearLayout .popup {
                                CheckBox #GRID .check .overlay "Grid" { checked: true; on-toggle: viewport::overlay("GRID"); }
                                CheckBox #ICONS .check .overlay "Icons" { checked: true; on-toggle: viewport::overlay("ICONS"); }
                                CheckBox #COLLIDERS .check .overlay "Colliders" { checked: true;
                                                                                  on-toggle: viewport::overlay("COLLIDERS"); }
                                CheckBox #HULLS .check .overlay "Convex hulls" { checked: true;
                                                                                 on-toggle: viewport::overlay("HULLS"); }
                            }
                        }
                        IconButton #MAXIMIZE "Maximize the viewport" { icon: "engine:/images/ui/maximize.svg";
                                                                       shortcut: "Shift+Space"; on-click: viewport::maximize; }
                    }

                    LinearLayout #PATH .path-bar {
                        LinearLayout #CRUMBS .crumbs;
                        Label #POSITION .path-position "";
                    }

                    // the scene, the camera of the view over its top left corner, and the name of its axis view under
                    // the orientation gizmo drawn in its top right corner (see ViewGizmo), in a layout without id so
                    // that the viewport stays BODY/MAIN/VIEW
                    FloatingLayout .view-stack {
                        Scene3D #VIEW .viewport { resolution: 1280 720; editable: true;
                            EditorViewport #GIZMO;
                        }

                        LinearLayout #VIEW_CAMERA .camera-chip {
                            IconButton #MORE "Camera of the view" { icon: "engine:/images/ui/more.svg";
                                                                     on-click: viewport::camera; }
                            MenuButton #CHIP .chip "Perspective · 60°" {
                                LinearLayout .popup .camera-menu {
                                    LinearLayout .camera-head {
                                        Label .camera-title "Camera";
                                        Label #SCENE .camera-note "";
                                    }
                                    LinearLayout .camera-row {
                                        Label .camera-label "View through";
                                        Dropdown #THROUGH .camera-through { on-change: viewport::through; }
                                    }
                                    Separator .menu-rule;
                                    LinearLayout #PROJECTION .projection {
                                        RadioButton #PERSPECTIVE .segment "Perspective" {
                                            group: "view-projection"; checked: true;
                                            on-toggle: viewport::projection("PERSPECTIVE");
                                        }
                                        RadioButton #ORTHOGRAPHIC .segment "Orthographic" {
                                            group: "view-projection"; on-toggle: viewport::projection("ORTHOGRAPHIC");
                                        }
                                    }
                                    LinearLayout #FOV .camera-row {
                                        Label .camera-label "Field of view";
                                        Slider #VALUE .camera-slider { min: 10; max: 120; step: 1; value: 60;
                                                                       on-change: viewport::fov; }
                                        Label #TEXT .camera-value "60°";
                                    }
                                    LinearLayout #SIZE .camera-row {
                                        Label .camera-label "Size";
                                        SpinBox #VALUE .camera-field { min: 0.1; max: 100000.0; step: 0.5; decimals: 2;
                                                                       on-change: viewport::size; }
                                    }
                                    LinearLayout .camera-row {
                                        Label .camera-label "Near · far";
                                        SpinBox #NEAR .camera-field { min: 0.01; max: 100000.0; step: 0.01; decimals: 2;
                                                                      on-change: viewport::near; }
                                        SpinBox #FAR .camera-field { min: 1.0; max: 1000000.0; step: 10.0; decimals: 0;
                                                                     on-change: viewport::far; }
                                    }
                                    Separator .menu-rule;
                                    Label .camera-caption "ALIGN THE VIEW";
                                    GridLayout .align-views {
                                        PushButton .view-button "Top" { shortcut: "7"; on-click: viewport::align("Top"); }
                                        PushButton .view-button "Front" { cell: 1 0; shortcut: "1";
                                                                          on-click: viewport::align("Front"); }
                                        PushButton .view-button "Right" { cell: 2 0; shortcut: "3";
                                                                          on-click: viewport::align("Right"); }
                                        PushButton .view-button "Bottom" { cell: 0 1; shortcut: "Ctrl+7";
                                                                           on-click: viewport::align("Bottom"); }
                                        PushButton .view-button "Back" { cell: 1 1; shortcut: "Ctrl+1";
                                                                         on-click: viewport::align("Back"); }
                                        PushButton .view-button "Left" { cell: 2 1; shortcut: "Ctrl+3";
                                                                         on-click: viewport::align("Left"); }
                                    }
                                    Separator .menu-rule;
                                    PushButton .item "Frame the selection" { shortcut: "F"; on-click: edit::frame; }
                                    PushButton .item "Align the selection with the view" { shortcut: "Ctrl+Alt+M";
                                                                                           on-click: view::align; }
                                    PushButton .item "Reset the camera" { on-click: viewport::reset; }
                                }
                            }
                        }

                        Label #VIEW_AXIS .axis-name .absent "" { capture-events: false; }
                    }
                }

                Splitter .dock .right {
                    LinearLayout .slot {
                        Inspector #INSPECTOR;
                    }
                    LinearLayout .slot {
                        DockPlaceholder #SIGNALS "SIGNALS" { note: "The signals of the actors come with BAL-128";
                                                             on-fold: docks::fold("SIGNALS"); }
                        DockPlaceholder #HISTORY "HISTORY" { note: "The changes of the scene, undone up to one of them, come with BAL-215";
                                                             on-fold: docks::fold("HISTORY"); }
                    }
                }
            }

            MaterialEditor #MATERIAL .absent;

            DockRail #RIGHT_RAIL .right;
        }

        LinearLayout #FOOT .footer {
            Label #STATUS .status "Ready";
            Label #GRID .status .grid "";
            Label #DOCUMENT .status .document "";
        }
    }
}
