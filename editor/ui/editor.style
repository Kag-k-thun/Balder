// The editor of Balder: a top row of the menus and the tabs of the documents, the outline, the viewport and the
// inspector side by side, a status bar; no space between the panels but a seam of a pixel, the space inside the rows,
// never around them

@import "theme.style";
@import "inspector.style";
@import "material.style";

MenuLayout.root, LinearLayout.body {
    background-color: $page;
}

// ===================================          TOP ROW          ====================================

// a row of 32 pixels, a seam under it: the logo, the menus, a seam, the tabs of the documents, Compile, Play, Pause and
// Stop
LinearLayout.bar {
    direction: row;
    background-color: $page;
    border-width: 0 0 1 0;
    border-color: $edge;
}

// the logo, 18 pixels in the accent, in a square of the row
Box.logo {
    background-color: transparent;
    image: "engine:/images/ui/logo.svg";
    image-color: $focus;
    image-fill: false;
    width: 36;
    height: 32;
    padding: 7 9;
}

MenuButton.menu {
    background-color: $page;
    radius: 0;
    height: 32;
    padding: 0 8;
}

MenuButton.menu:hover {
    background-color: $raised;
}

MenuButton.menu:focus {
    shadow: 0 0 0 1 $focus;
}

MenuButton.menu::label {
    text-color: $text;
    font-family: $font;
    font-size: 13;
}

LinearLayout.popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $popup-corner;
    padding: 4 0;
    shadow: 0 4 12 #00000080;
}

// an item of a menu, 24 pixels high, its shortcut on its right edge
PushButton.item {
    background-color: $panel;
    radius: 0;
    height: 24;
    padding: 0 12 0 10;
}

PushButton.item:hover, PushButton.item:focus {
    background-color: $accent;
}

PushButton.item::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

PushButton.item::shortcut {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: right;
    margin-left: 24;
}

PushButton.item:hover::shortcut, PushButton.item:focus::shortcut {
    text-color: $soft;
}

// an item of a menu opening a submenu on its right, as it is hovered (the categories of the Add menu)
MenuButton.submenu {
    background-color: $panel;
    radius: 0;
    height: 24;
    padding: 0 12 0 10;
    popup-align: right top;
}

MenuButton.submenu:hover, MenuButton.submenu:focus {
    background-color: $accent;
}

MenuButton.submenu::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

MenuButton.submenu::shortcut {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: right;
    margin-left: 24;
}

MenuButton.submenu:hover::shortcut, MenuButton.submenu:focus::shortcut {
    text-color: $soft;
}

// the submenus of the categories of the actor classes in the Add menu, taking no room without actor classes
LinearLayout.actors {
    background-color: transparent;
}

LinearLayout.actors.absent {
    display: none;
}

// the seam between the menus and the tabs
Box.bar-seam {
    background-color: $edge;
    width: 1;
    height: 20;
    margin: 6 6;
}

// the tabs of the documents, taking the room the menus and the buttons leave, the tab shown on the panel colour and
// underlined in the accent, a dot on the tabs with unsaved changes, a cross closing the tab shown or hovered, + after
// the tabs opening a new scene
TabBar.documents {
    background-color: transparent;
    flex: 1;
}

TabBar.documents::tab {
    background-color: transparent;
    border-width: 0 0 2 0;
    border-color: transparent;
    height: 32;
    padding: 0 8 0 10;
    text-color: $muted;
    font-family: $font;
    font-size: 12;
}

TabBar.documents::tab:hover {
    text-color: $soft;
}

TabBar.documents::tab:selected {
    background-color: $panel;
    border-color: $accent;
    text-color: $text;
}

TabBar.documents::tab:dragged {
    background-color: $raised;
}

// the icon of a scene before its title
TabBar.documents::icon {
    background-color: transparent;
    border: 0 transparent;
    image: "engine:/images/ui/scene.svg";
    image-color: $muted;
    image-fill: false;
    width: 14;
    height: 14;
    margin-right: 6;
}

TabBar.documents::icon:selected {
    image-color: $focus;
}

TabBar.documents::dot {
    background-color: $text;
    border: 0 transparent;
    radius: $round;
    width: 7;
    height: 7;
    margin-left: 6;
}

TabBar.documents::close {
    background-color: transparent;
    border: 0 transparent;
    radius: $corner;
    image: "engine:/images/ui/close.svg";
    image-color: $muted;
    image-fill: false;
    width: 16;
    height: 16;
    padding: 2;
    margin-left: 4;
}

TabBar.documents::close:hover {
    background-color: $raised;
    image-color: $text;
}

TabBar.documents::close:pressed {
    background-color: $edge;
}

TabBar.documents::add {
    background-color: transparent;
    border: 0 transparent;
    radius: $corner;
    image: "engine:/images/ui/plus.svg";
    image-color: $soft;
    image-fill: false;
    width: 26;
    height: 24;
    padding: 5 6;
    margin: 0 4;
}

TabBar.documents::add:hover {
    background-color: $raised;
    image-color: $text;
}

// the button building the library of the game again and loading it, greyed while a build runs or for a project
// without a library
PushButton.compile {
    background-color: #238636;
    radius: $corner;
    height: 24;
    padding: 0 10;
    margin: 4 4 4 8;
}

PushButton.compile:hover {
    background-color: #2ea043;
}

PushButton.compile:focus {
    shadow: 0 0 0 1 $focus;
}

PushButton.compile::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
}

PushButton.compile::shortcut {
    text-color: $soft;
    font-family: $font;
    font-size: 12;
    margin-left: 8;
}

PushButton.compile.idle, PushButton.compile.idle:hover {
    background-color: $raised;
}

PushButton.compile.idle::label, PushButton.compile.idle::shortcut {
    text-color: $muted;
}

// The camera the game is played through, Play, Pause, Step and Stop on the right of the top row
LinearLayout.transport {
    direction: row;
    background-color: transparent;
    padding: 0 8 0 4;
}

LinearLayout.transport IconButton {
    margin: 4 0;
}

Dropdown.play-camera {
    margin: 4 6 4 0;
}

PushButton.play {
    background-color: #238636;
    radius: $corner;
    height: 24;
    padding: 0 10;
    margin: 4 2 4 0;
}

PushButton.play:hover {
    background-color: #2ea043;
}

PushButton.play::label {
    text-color: #ffffff;
    font-family: $font;
    font-size: 12;
    font-weight: bold;
}

PushButton.play.idle, PushButton.play.idle:hover {
    background-color: $raised;
}

PushButton.play.idle::label {
    text-color: $muted;
}

PushButton.control {
    background-color: transparent;
    radius: $corner;
    image-color: $soft;
    image-fill: false;
    width: 26;
    height: 24;
    padding: 4 5;
    margin: 4 0;
}

PushButton.control:hover {
    background-color: $raised;
}

PushButton.control.idle, PushButton.control.idle:hover {
    background-color: transparent;
    image-color: $edge;
}

PushButton.pause { image: "engine:/images/ui/pause.svg"; }
PushButton.stop { image: "engine:/images/ui/stop.svg"; }

// an item with nothing to do (Undo with no change to undo...)
PushButton.item.idle::label {
    text-color: $muted;
}

Separator.menu-rule {
    background-color: $edge;
    margin: 4 0;
}

// ===================================          PANELS          =====================================

// the docks and the viewport side by side, a grip of a pixel between them, dragged within 5 pixels
Splitter.main {
    direction: row;
    background-color: $page;
    border-color: $page;
    flex: 1;
}

Splitter.main::grip {
    width: 1;
    background-color: $edge;
    radius: 0;
}

Splitter.main::grip:hover {
    background-color: $focus;
}

Splitter.main::bbox {
    width: 5;
}

LinearLayout.panel {
    background-color: $panel;
    padding: 0;
}

LinearLayout.outline {
    width: 18%;
    min-width: 180;
}

Label.section {
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 11;
    text-xalign: left;
    height: 26;
    padding: 0 8;
}

// ===================================          OUTLINE          ====================================

// the tree fills its dock, its rows 22 pixels high, a level indented by 14
TreeView.tree {
    background-color: $panel;
    border: 0;
    radius: 0;
    padding: 0;
    flex: 1;
    indent: 14;
}

TreeView.tree::row {
    background-color: transparent;
    border: 1 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    height: 22;
    padding: 0 6 0 4;
    radius: 0;
}

TreeView.tree::row:hover {
    background-color: $raised;
}

TreeView.tree::row:selected {
    background-color: $accent;
}

TreeView.tree:focus::row:current {
    border-color: $focus;
}

TreeView.tree::row:drop {
    border-color: $focus;
    background-color: $raised;
}

TreeView.tree::drop {
    background-color: $focus;
    height: 2;
    radius: 1;
}

// a chevron of 12 pixels before a node having children
TreeView.tree::marker {
    background-color: transparent;
    border: 0 transparent;
    image: $chevron-right;
    image-color: $muted;
    image-fill: false;
    width: 12;
    margin-right: 4;
}

TreeView.tree::marker:expanded {
    image: $chevron-down;
}

TreeView.tree::marker:hover, TreeView.tree::marker:selected {
    image-color: $text;
}

// the icon of the kind of a node, between its marker and its name
TreeView.tree::icon {
    background-color: transparent;
    border: 0 transparent;
    width: 14;
    margin-right: 4;
    image-keep-ratio: true;
}

TreeView.tree::scrollbar {
    background-color: $edge;
    width: 6;
    radius: $round;
}

TreeView.tree::scrollbar:hover, TreeView.tree::scrollbar:pressed {
    background-color: $focus;
}

// ====================================          FILES          =====================================

// the files of the project: a head with the kinds shown, a bar of the filter and New folder, the tree, then the footer
// telling the file selected, in the monospaced font of the paths
LinearLayout.files {
    direction: column;
}

Dropdown.kinds {
    height: 22;
    margin: 2 0;
}

LinearLayout.files-bar {
    direction: row;
    background-color: transparent;
    height: 28;
    padding: 0 4 4 4;
    gap: 2;
}

Label.files-root {
    text-color: $soft;
    font-family: $mono;
    font-size: 12;
    text-yalign: center;
    padding: 0 4;
}

// the filter: a loupe in the field, the text after it
LinearLayout.files-filter {
    direction: row;
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    height: 22;
    flex: 1;
    padding: 0 0 0 6;
}

Box.files-loupe {
    background-color: transparent;
    border: 0 transparent;
    image: "engine:/images/ui/search.svg";
    image-color: $muted;
    image-fill: false;
    width: 13;
    height: 13;
    margin: 4 2 0 0;
}

InputText.files-search {
    background-color: transparent;
    border-color: transparent;
    flex: 1;
    height: 20;
}

InputText.files-search:hover, InputText.files-search:focus {
    border-color: transparent;
}

TreeView.files-tree {
    flex: 1;
}

// the scene shown, in the colour of the focus
TreeView.files-tree::row:marked {
    text-color: $focus;
}

TreeView.files-tree::row:marked:selected {
    text-color: $text;
}

// the icon of the files dragged out of the tree, under the cursor, over the viewport or the outline
TreeView.files-tree::ghost {
    background-color: transparent;
    border: 0 transparent;
    width: 20;
    height: 20;
    image-keep-ratio: true;
}

// the field renaming a file in place, over the text of its row
InputText.tree-edit {
    background-color: $page;
    border: 1 $focus;
    radius: 0;
    padding: 0 4;
}

InputText.tree-edit::label {
    text-color: $text;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    text-yalign: center;
}

InputText.tree-edit::selection {
    color: #388bfd64;
}

InputText.tree-edit::cursor {
    text-color: $text;
}

Label.files-foot {
    background-color: transparent;
    border-width: 1 0 0 0;
    border-color: $edge;
    text-color: $muted;
    font-family: $mono;
    font-size: 11;
    text-xalign: left;
    text-overflow: ellipsis;
    height: 24;
    padding: 0 8;
}

// ===================================          VIEWPORT          ===================================

// the column of the viewport: its toolbar, the path of the selection, then the image of the scene, a seam of a pixel
// between them (the background showing through)
LinearLayout.centre {
    direction: column;
    background-color: $edge;
    flex: 1;
    min-width: 320;
}

// the scene, and over its corners the camera of the view and the name of its axis view
FloatingLayout.view-stack {
    background-color: black;
    flex: 1;
}

Scene3D.viewport {
    background-color: black;
    width: 100%;
    height: 100%;
}

ToolBar.viewport-tools {
    margin-bottom: 1;
}

// the room between the tools of the gizmo and those of the display, pushing the latter to the right
Box.spring {
    background-color: transparent;
    border: 0 transparent;
    flex: 1;
}

// a choice of the toolbar: its text, lit under the cursor, its list in the colours of the menus
Dropdown.tool {
    background-color: transparent;
    border: 1 transparent;
    radius: $corner;
    height: 24;
    padding: 0 6 0 8;
}

Dropdown.tool:hover { background-color: $raised; }
Dropdown.tool:focus { border-color: $focus; }

Dropdown.tool::label {
    text-color: $soft;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

Dropdown.tool::popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $popup-corner;
    padding: 4 0;
    shadow: 0 4 12 #00000080;
}

Dropdown.tool::item {
    background-color: $panel;
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    height: 22;
    padding: 0 8;
    radius: 0;
}

Dropdown.tool::item:selected { text-color: $focus; }
Dropdown.tool::item:hover { background-color: $accent; text-color: $text; }

// the Overlays menu, its boxes in a popup of the menus
MenuButton.tool-menu {
    background-color: transparent;
    radius: $corner;
    height: 24;
    padding: 0 8;
}

MenuButton.tool-menu:hover { background-color: $raised; }

MenuButton.tool-menu::label {
    text-color: $soft;
    font-family: $font;
    font-size: 12;
}

CheckBox.overlay {
    height: 24;
    margin: 0;
    padding: 0 12 0 10;
}

// the snapping steps: three segments joined by a seam of a pixel, as a tool group; the toggle lit in the focus colour
// while its kind snaps, the step in the mono face, its arrows hidden for room, the wheel still stepping it
LinearLayout.snaps {
    direction: row;
    gap: 1;
    background-color: $edge;
    radius: $corner;
}

LinearLayout.snap {
    direction: row;
    background-color: $raised;
    height: 24;
    padding: 0 6 0 0;
}

IconButton.snap-toggle {
    background-color: transparent;
    radius: 0;
    width: 24;
    padding: 5 4;
}

IconButton.snap-toggle:hover { background-color: $edge; }
IconButton.snap-toggle:checked { background-color: transparent; image-color: $focus; }

SpinBox.snap-step {
    background-color: transparent;
    border: 1 transparent;
    radius: $corner;
    height: 22;
    width: 50;
    padding: 0 2;
}

SpinBox.snap-step:focus { border-color: $focus; }

SpinBox.snap-step::label {
    text-color: $soft;
    font-family: $mono;
    font-size: 12;
    text-xalign: right;
    text-yalign: center;
}

SpinBox.snap-step::up, SpinBox.snap-step::down {
    width: 0;
    margin: 0;
}

Label.snap-unit {
    text-color: $muted;
    font-family: $mono;
    font-size: 12;
    padding: 0 0 0 2;
}

// the path of the selection: 24 pixels, the crumbs on the left, the position on the right
LinearLayout.path-bar {
    direction: row;
    background-color: $panel;
    height: 24;
    padding: 0 6;
    margin-bottom: 1;
}

LinearLayout.crumbs, LinearLayout.crumb-node {
    direction: row;
    background-color: transparent;
}

PushButton.crumb {
    background-color: transparent;
    radius: $corner;
    height: 22;
    padding: 0 4;
}

PushButton.crumb:hover { background-color: $raised; }

PushButton.crumb::label {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
}

Box.crumb-seam {
    background-color: transparent;
    border: 0 transparent;
    image: $chevron-right;
    image-color: #6e7681;
    image-fill: false;
    width: 12;
    height: 12;
    margin: 6 1;
}

LinearLayout.crumb-node {
    padding: 0 4;
}

Box.crumb-icon {
    background-color: transparent;
    border: 0 transparent;
    image-fill: false;
    width: 13;
    height: 13;
    margin: 5 4 0 0;
}

Label.crumb-name {
    text-color: $text;
    font-family: $font;
    font-size: 12;
}

Label.path-position {
    text-color: $muted;
    font-family: $mono;
    font-size: 11;
    text-xalign: right;
    flex: 1;
}

// ⋮ and the chip telling the projection of the view, both opening the camera menu, over the top left corner
LinearLayout.camera-chip {
    direction: row;
    gap: 4;
    left: 8;
    top: 8;
    background-color: transparent;
}

LinearLayout.camera-chip IconButton {
    background-color: $glass;
    radius: $corner;
    width: 24;
    height: 24;
    padding: 4;
}

LinearLayout.camera-chip IconButton:hover { background-color: $raised; }

MenuButton.chip {
    background-color: $glass;
    radius: $corner;
    height: 24;
    padding: 0 8;
}

MenuButton.chip:hover { background-color: $raised; }

MenuButton.chip::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
}

// the camera menu: rows of 24 pixels, a label column of 96, the field the other projection reads greyed in place
LinearLayout.camera-menu {
    width: 320;
}

LinearLayout.camera-head, LinearLayout.camera-row, LinearLayout.projection {
    direction: row;
    gap: 6;
    background-color: transparent;
    height: 24;
    padding: 0 10;
}

LinearLayout.projection {
    gap: 0;
    height: 30;
    padding: 2 10 4;
}

Label.camera-title {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    flex: 1;
}

Label.camera-note, Label.camera-caption {
    text-color: $muted;
    font-family: $font;
    font-size: 11;
}

Label.camera-note { text-xalign: right; }
Label.camera-caption { text-xalign: left; padding: 4 10 2; }

Label.camera-label {
    text-color: $soft;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    width: 96;
}

Label.camera-value {
    text-color: $text;
    font-family: $mono;
    font-size: 12;
    text-xalign: right;
    width: 34;
}

Dropdown.camera-through {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    height: 20;
    padding: 0 6;
    flex: 1;
}

Dropdown.camera-through::label { text-color: $text; font-family: $font; font-size: 12; text-xalign: left; }
Dropdown.camera-through::popup { background-color: $panel; border: 1 $edge; radius: $popup-corner; padding: 4 0; }
Dropdown.camera-through::item { background-color: $panel; text-color: $text; font-family: $font; font-size: 12;
                                text-xalign: left; height: 22; padding: 0 8; radius: 0; }
Dropdown.camera-through::item:selected { text-color: $focus; }
Dropdown.camera-through::item:hover { background-color: $accent; text-color: $text; }

SpinBox.camera-field {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    height: 20;
    flex: 1;
}

SpinBox.camera-field:focus { border-color: $focus; }
SpinBox.camera-field::label { text-color: $text; font-family: $mono; font-size: 12; }

// the arrows of a field, as those of the inspector
SpinBox.camera-field::up, SpinBox.camera-field::down {
    background-color: $raised;
    width: 12;
    margin: 1;
    radius: 2;
}

SpinBox.camera-field::up:hover, SpinBox.camera-field::down:hover { background-color: $edge; }
SpinBox.camera-field::up:pressed, SpinBox.camera-field::down:pressed { background-color: $accent; }

Slider.camera-slider {
    background-color: transparent;
    border: 0 transparent;
    height: 14;
    flex: 1;
}

Slider.camera-slider::track { background-color: $edge; height: 4; radius: 2; }
Slider.camera-slider::fill { background-color: $focus; radius: 2; }
Slider.camera-slider::thumb { background-color: $text; width: 12; height: 12; radius: $round; }
Slider.camera-slider:focus::thumb { shadow: 0 0 0 2 $accent; }

// the field the other projection reads, greyed, not hidden, so that the menu keeps its height
LinearLayout.camera-row.idle Label.camera-label, LinearLayout.camera-row.idle Label.camera-value { text-color: #6e7681; }
LinearLayout.camera-row.idle SpinBox.camera-field::label { text-color: #6e7681; }
LinearLayout.camera-row.idle Slider.camera-slider::fill { background-color: $muted; }

// the projection: two halves of one segment, the one in use in the accent
RadioButton.segment {
    background-color: $raised;
    border: 1 $edge;
    radius: 0;
    height: 22;
    flex: 1;
}

RadioButton.segment:checked { background-color: $accent; }
RadioButton.segment::box { width: 0; height: 0; margin: 0; }
RadioButton.segment::label { text-color: $soft; font-family: $font; font-size: 12; text-xalign: center; }
RadioButton.segment:checked::label { text-color: $text; }

// the axis views, three a row, the key of each on its right
GridLayout.align-views {
    background-color: transparent;
    padding: 2 10 4;
}

PushButton.view-button {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    height: 24;
    margin: 1;
    padding: 0 6;
}

PushButton.view-button:hover { background-color: $edge; }
PushButton.view-button::label { text-color: $text; font-family: $font; font-size: 12; text-xalign: left; }
PushButton.view-button::shortcut { text-color: $muted; font-family: $mono; font-size: 10; text-xalign: right;
                                   margin-left: 4; }

// the name of the axis view, under the orientation gizmo (12 pixels from the corner, a disc of 80), absent off the
// axis views
Label.axis-name {
    background-color: $glass;
    radius: $corner;
    text-color: $text;
    font-family: $font;
    font-size: 11;
    text-xalign: center;
    right: 12;
    top: 98;
    width: 80;
    padding: 2 6;
}

Label.axis-name.absent {
    display: none;
}

// ====================================          STATUS          ====================================

// a bar of 22 pixels, a seam above it
LinearLayout.footer {
    direction: row;
    background-color: $panel;
    border-width: 1 0 0 0;
    border-color: $edge;
    height: 22;
}

Label.status {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    padding: 0 8;
    flex: 1;
}

// the file of the scene, and whether it has unsaved changes
Label.document {
    text-xalign: right;
    flex: 0;
}

// the step of the grid of the ground, in metres
Label.grid {
    text-xalign: right;
    flex: 0;
}

// ===================================          DOCKS          ======================================

// the room under the top row: the rails on the outer edges, the docks and the viewport between them
LinearLayout.work {
    direction: row;
    background-color: $page;
    flex: 1;
}

// a dock: its top slot over its bottom slot, a grip of a pixel between them, dragged within 5 pixels
Splitter.dock {
    direction: column;
    background-color: $panel;
    border-color: $panel;
}

Splitter.dock.left { width: 18%; min-width: 180; }
Splitter.dock.right { width: 22%; min-width: 280; }

Splitter.dock::grip {
    height: 1;
    background-color: $edge;
    radius: 0;
}

Splitter.dock::grip:hover {
    background-color: $focus;
}

Splitter.dock::bbox {
    height: 5;
}

// a slot shows the panel of its tool shown, the others absent
LinearLayout.slot {
    background-color: $panel;
    padding: 0;
}

// a panel fills its slot whatever its width elsewhere (the outline, the inspector), the dock bounding it
LinearLayout.slot LinearLayout.panel {
    flex: 1;
    width: auto;
    min-width: 0;
}

// the head of a panel: its title, the button folding the dock on its right
LinearLayout.dock-head {
    direction: row;
    background-color: transparent;
    height: 26;
}

LinearLayout.dock-head Label.section {
    flex: 1;
}

IconButton.fold {
    width: 26;
    height: 26;
    padding: 5;
    radius: 0;
}

// the panel of a tool still to come
Label.placeholder-note {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    text-wrap: wrap;
    padding: 4 8;
}

// ===================================          RAILS          ======================================

// a rail of 36 pixels on an outer edge of the window, a seam on its inner side: a button of 36 by 32 per tool, the
// tool shown marked by a line of 2 pixels in the accent on its inner side, a rule between the tools of the top and
// those of the bottom, the tools of the foot at its end
DockRail {
    direction: column;
    background-color: $page;
    width: 36;
    padding: 4 0;
    gap: 2;
}

DockRail.left { border-width: 0 1 0 0; border-color: $edge; }
DockRail.right { border-width: 0 0 0 1; border-color: $edge; }

DockRail IconButton {
    width: 36;
    height: 32;
    padding: 8 9;
    radius: 0;
    border-color: transparent;
}

DockRail.left IconButton { border-width: 0 2 0 0; }
DockRail.right IconButton { border-width: 0 0 0 2; }
DockRail IconButton:hover { background-color: $raised; }
DockRail IconButton:checked { background-color: transparent; border-color: $accent; image-color: $text; }

// the tool dragged, and the place it would go to: a line of 2 pixels in the gap above or below a tool
DockRail IconButton.dragged { background-color: $raised; image-color: $muted; }
DockRail IconButton.drop-before { shadow: 0 -2 0 0 $focus; }
DockRail IconButton.drop-after { shadow: 0 2 0 0 $focus; }

DockRail Separator {
    direction: row;
    background-color: $edge;
    margin: 6 8;
}

// the room left before the tools of the foot
DockRail Box {
    background-color: transparent;
    flex: 1;
}

// the rails while a material is shown, out with the panels of the scene
DockRail.absent {
    display: none;
}
