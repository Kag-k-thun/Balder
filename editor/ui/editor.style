// The editor of Balder: a menu bar, the outline, the viewport and the inspector side by side, a status bar

@import "theme.style";
@import "inspector.style";

MenuLayout.root, LinearLayout.body {
    background-color: $page;
}

// ===================================          MENU BAR          ===================================

LinearLayout.bar {
    direction: row;
    background-color: $panel;
}

MenuButton.menu {
    background-color: $panel;
    radius: 4;
    padding: 6 14;
}

MenuButton.menu:hover {
    background-color: $raised;
}

MenuButton.menu:focus {
    shadow: 0 0 0 2 $focus;
}

MenuButton.menu::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

LinearLayout.popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    shadow: 0 4 12 #00000080;
}

PushButton.item {
    background-color: $panel;
    radius: 4;
    padding: 6 24 6 16;
}

PushButton.item:hover, PushButton.item:focus {
    background-color: $accent;
}

PushButton.item::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Separator.menu-rule {
    background-color: $edge;
    margin: 4 8;
}

// ===================================          PANELS          =====================================

Splitter.main {
    direction: row;
    background-color: $page;
    border-color: $page;
    flex: 1;
}

Splitter.main::grip {
    width: 4;
    background-color: $edge;
    radius: $round;
}

Splitter.main::grip:hover {
    background-color: $focus;
}

Splitter.main::bbox {
    width: 8;
}

LinearLayout.panel {
    background-color: $panel;
    padding: 8;
}

LinearLayout.outline {
    width: 18%;
    min-width: 180;
}

Label.section {
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 12;
    text-xalign: left;
    padding: 6 4;
}

// ===================================          OUTLINE          ====================================

TreeView.tree {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    padding: 4 12 4 4;
    flex: 1;
}

TreeView.tree:focus {
    border-color: $focus;
}

TreeView.tree::row {
    background-color: transparent;
    border: 1 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 3 10 3 4;
    radius: 4;
}

TreeView.tree::row:hover {
    background-color: $raised;
}

TreeView.tree::row:selected {
    background-color: $accent;
}

TreeView.tree:focus::row:current {
    border-color: $focus;
}

TreeView.tree::marker {
    background-color: transparent;
    border: 0 transparent;
    text-color: $muted;
    font-family: $font;
    font-size: 14;
    width: 18;
    margin-right: 4;
}

TreeView.tree::marker:hover, TreeView.tree::marker:selected {
    text-color: $text;
}

TreeView.tree::scrollbar {
    background-color: $edge;
    width: 8;
    radius: $round;
}

TreeView.tree::scrollbar:hover, TreeView.tree::scrollbar:pressed {
    background-color: $focus;
}

// ===================================          VIEWPORT          ===================================

Scene3D.viewport {
    background-color: black;
    flex: 1;
    min-width: 320;
}

// ====================================          STATUS          ====================================

Label.status {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding: 4 12;
}
