// The editor of Balder: a top row of the menus and the tabs of the documents, the outline, the viewport and the
// inspector side by side, a status bar; no space between the panels but a seam of a pixel, the space inside the rows,
// never around them

@import "theme.style";
@import "inspector.style";
@import "material.style";

MenuLayout.root, LinearLayout.body {
    background-color: $page;
}

// ===================================          TOP ROW          ====================================

// a row of 32 pixels, a seam under it: the logo, the menus, a seam, the tabs of the documents, Compile, Play, Pause and
// Stop
LinearLayout.bar {
    direction: row;
    background-color: $page;
    border-width: 0 0 1 0;
    border-color: $edge;
}

// the logo, 18 pixels in the accent, in a square of the row
Box.logo {
    background-color: transparent;
    image: "engine:/images/ui/logo.svg";
    image-color: $focus;
    image-fill: false;
    width: 36;
    height: 32;
    padding: 7 9;
}

MenuButton.menu {
    background-color: $page;
    radius: 0;
    height: 32;
    padding: 0 8;
}

MenuButton.menu:hover {
    background-color: $raised;
}

MenuButton.menu:focus {
    shadow: 0 0 0 1 $focus;
}

MenuButton.menu::label {
    text-color: $text;
    font-family: $font;
    font-size: 13;
}

LinearLayout.popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $popup-corner;
    padding: 4 0;
    shadow: 0 4 12 #00000080;
}

// an item of a menu, 24 pixels high, its shortcut on its right edge
PushButton.item {
    background-color: $panel;
    radius: 0;
    height: 24;
    padding: 0 12 0 10;
}

PushButton.item:hover, PushButton.item:focus {
    background-color: $accent;
}

PushButton.item::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

PushButton.item::shortcut {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: right;
    margin-left: 24;
}

PushButton.item:hover::shortcut, PushButton.item:focus::shortcut {
    text-color: $soft;
}

// an item of a menu opening a submenu on its right, as it is hovered (the categories of the Add menu)
MenuButton.submenu {
    background-color: $panel;
    radius: 0;
    height: 24;
    padding: 0 12 0 10;
    popup-align: right top;
}

MenuButton.submenu:hover, MenuButton.submenu:focus {
    background-color: $accent;
}

MenuButton.submenu::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

MenuButton.submenu::shortcut {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: right;
    margin-left: 24;
}

MenuButton.submenu:hover::shortcut, MenuButton.submenu:focus::shortcut {
    text-color: $soft;
}

// the submenus of the categories of the actor classes in the Add menu, taking no room without actor classes
LinearLayout.actors {
    background-color: transparent;
}

LinearLayout.actors.absent {
    display: none;
}

// the seam between the menus and the tabs
Box.bar-seam {
    background-color: $edge;
    width: 1;
    height: 20;
    margin: 6 6;
}

// the tabs of the documents, taking the room the menus and the buttons leave, the tab shown on the panel colour and
// underlined in the accent, a dot on the tabs with unsaved changes, a cross closing the tab shown or hovered, + after
// the tabs opening a new scene
TabBar.documents {
    background-color: transparent;
    flex: 1;
}

TabBar.documents::tab {
    background-color: transparent;
    border-width: 0 0 2 0;
    border-color: transparent;
    height: 32;
    padding: 0 8 0 10;
    text-color: $muted;
    font-family: $font;
    font-size: 12;
}

TabBar.documents::tab:hover {
    text-color: $soft;
}

TabBar.documents::tab:selected {
    background-color: $panel;
    border-color: $accent;
    text-color: $text;
}

TabBar.documents::tab:dragged {
    background-color: $raised;
}

// the icon of a scene before its title
TabBar.documents::icon {
    background-color: transparent;
    border: 0 transparent;
    image: "engine:/images/ui/scene.svg";
    image-color: $muted;
    image-fill: false;
    width: 14;
    height: 14;
    margin-right: 6;
}

TabBar.documents::icon:selected {
    image-color: $focus;
}

TabBar.documents::dot {
    background-color: $text;
    border: 0 transparent;
    radius: $round;
    width: 7;
    height: 7;
    margin-left: 6;
}

TabBar.documents::close {
    background-color: transparent;
    border: 0 transparent;
    radius: $corner;
    image: "engine:/images/ui/close.svg";
    image-color: $muted;
    image-fill: false;
    width: 16;
    height: 16;
    padding: 2;
    margin-left: 4;
}

TabBar.documents::close:hover {
    background-color: $raised;
    image-color: $text;
}

TabBar.documents::close:pressed {
    background-color: $edge;
}

TabBar.documents::add {
    background-color: transparent;
    border: 0 transparent;
    radius: $corner;
    image: "engine:/images/ui/plus.svg";
    image-color: $soft;
    image-fill: false;
    width: 26;
    height: 24;
    padding: 5 6;
    margin: 0 4;
}

TabBar.documents::add:hover {
    background-color: $raised;
    image-color: $text;
}

// the button building the library of the game again and loading it, greyed while a build runs or for a project
// without a library
PushButton.compile {
    background-color: #238636;
    radius: $corner;
    height: 24;
    padding: 0 10;
    margin: 4 4 4 8;
}

PushButton.compile:hover {
    background-color: #2ea043;
}

PushButton.compile:focus {
    shadow: 0 0 0 1 $focus;
}

PushButton.compile::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
}

PushButton.compile::shortcut {
    text-color: $soft;
    font-family: $font;
    font-size: 12;
    margin-left: 8;
}

PushButton.compile.idle, PushButton.compile.idle:hover {
    background-color: $raised;
}

PushButton.compile.idle::label, PushButton.compile.idle::shortcut {
    text-color: $muted;
}

// Play, Pause and Stop on the right of the top row, idle until the play mode comes
LinearLayout.transport {
    direction: row;
    background-color: transparent;
    padding: 0 8 0 4;
}


// Play, Pause and Stop on the right of the top row, idle until the play mode comes
LinearLayout.transport IconButton {
    margin: 4 0;
}

PushButton.play {
    background-color: #238636;
    radius: $corner;
    height: 24;
    padding: 0 10;
    margin: 4 2 4 0;
}

PushButton.play:hover {
    background-color: #2ea043;
}

PushButton.play::label {
    text-color: #ffffff;
    font-family: $font;
    font-size: 12;
    font-weight: bold;
}

PushButton.play.idle, PushButton.play.idle:hover {
    background-color: $raised;
}

PushButton.play.idle::label {
    text-color: $muted;
}

PushButton.control {
    background-color: transparent;
    radius: $corner;
    image-color: $soft;
    image-fill: false;
    width: 26;
    height: 24;
    padding: 4 5;
    margin: 4 0;
}

PushButton.control:hover {
    background-color: $raised;
}

PushButton.control.idle, PushButton.control.idle:hover {
    background-color: transparent;
    image-color: $edge;
}

PushButton.pause { image: "engine:/images/ui/pause.svg"; }
PushButton.stop { image: "engine:/images/ui/stop.svg"; }

// an item with nothing to do (Undo with no change to undo...)
PushButton.item.idle::label {
    text-color: $muted;
}

Separator.menu-rule {
    background-color: $edge;
    margin: 4 0;
}

// ===================================          PANELS          =====================================

// the docks and the viewport side by side, a grip of a pixel between them, dragged within 5 pixels
Splitter.main {
    direction: row;
    background-color: $page;
    border-color: $page;
    flex: 1;
}

Splitter.main::grip {
    width: 1;
    background-color: $edge;
    radius: 0;
}

Splitter.main::grip:hover {
    background-color: $focus;
}

Splitter.main::bbox {
    width: 5;
}

LinearLayout.panel {
    background-color: $panel;
    padding: 0;
}

LinearLayout.outline {
    width: 18%;
    min-width: 180;
}

Label.section {
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 11;
    text-xalign: left;
    height: 26;
    padding: 0 8;
}

// ===================================          OUTLINE          ====================================

// the tree fills its dock, its rows 22 pixels high, a level indented by 14
TreeView.tree {
    background-color: $panel;
    border: 0;
    radius: 0;
    padding: 0;
    flex: 1;
    indent: 14;
}

TreeView.tree::row {
    background-color: transparent;
    border: 1 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    height: 22;
    padding: 0 6 0 4;
    radius: 0;
}

TreeView.tree::row:hover {
    background-color: $raised;
}

TreeView.tree::row:selected {
    background-color: $accent;
}

TreeView.tree:focus::row:current {
    border-color: $focus;
}

TreeView.tree::row:drop {
    border-color: $focus;
    background-color: $raised;
}

TreeView.tree::drop {
    background-color: $focus;
    height: 2;
    radius: 1;
}

// a chevron of 12 pixels before a node having children
TreeView.tree::marker {
    background-color: transparent;
    border: 0 transparent;
    image: $chevron-right;
    image-color: $muted;
    image-fill: false;
    width: 12;
    margin-right: 4;
}

TreeView.tree::marker:expanded {
    image: $chevron-down;
}

TreeView.tree::marker:hover, TreeView.tree::marker:selected {
    image-color: $text;
}

// the icon of the kind of a node, between its marker and its name
TreeView.tree::icon {
    background-color: transparent;
    border: 0 transparent;
    width: 14;
    margin-right: 4;
    image-keep-ratio: true;
}

TreeView.tree::scrollbar {
    background-color: $edge;
    width: 6;
    radius: $round;
}

TreeView.tree::scrollbar:hover, TreeView.tree::scrollbar:pressed {
    background-color: $focus;
}

// ===================================          VIEWPORT          ===================================

Scene3D.viewport {
    background-color: black;
    flex: 1;
    min-width: 320;
}

// ====================================          STATUS          ====================================

// a bar of 22 pixels, a seam above it
LinearLayout.footer {
    direction: row;
    background-color: $panel;
    border-width: 1 0 0 0;
    border-color: $edge;
    height: 22;
}

Label.status {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    padding: 0 8;
    flex: 1;
}

// the file of the scene, and whether it has unsaved changes
Label.document {
    text-xalign: right;
    flex: 0;
}

// the step of the grid of the ground, in metres
Label.grid {
    text-xalign: right;
    flex: 0;
}
