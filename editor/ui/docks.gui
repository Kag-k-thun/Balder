// The docks of the editor: the head of a panel, its title and the button folding the dock it is in, and the panel of a
// tool still to come, its note telling which work item brings it

// The head of a panel of a dock: its title, then the button folding the whole dock, the viewport taking its room
@component DockHead ($title, $on-fold: none) {
    LinearLayout .dock-head {
        Label .section $title;
        IconButton .fold "Fold the dock" { icon: "engine:/images/ui/dock-fold.svg"; on-click: $on-fold; }
    }
}

// The panel of a tool still to come
@component DockPlaceholder ($title, $note: "", $on-fold: none) {
    LinearLayout .panel .placeholder {
        DockHead $title { on-fold: $on-fold; }
        Label .placeholder-note $note;
    }
}
