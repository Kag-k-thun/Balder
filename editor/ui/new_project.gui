// The dialog creating a project: the template it starts from and what it holds, its name, the location of its folder (a
// new folder named after the project), and the buttons answering

@style "engine:/dialog/dialog.style";
@style "new_project.style";

LinearLayout #DIALOG .dialog .dialog-project {
    Label .dialog-question "New project";
    LinearLayout .dialog-row {
        Label .dialog-caption .dialog-caption-wide "Template";
        Dropdown #TEMPLATE .dialog-template { on-change: template; }
    }
    Label #TEMPLATE_NOTE .dialog-note "";
    LinearLayout .dialog-row {
        Label .dialog-caption .dialog-caption-wide "Name";
        InputText #NAME .dialog-input { max-length: 256; }
    }
    LinearLayout .dialog-row {
        Label .dialog-caption .dialog-caption-wide "Location";
        InputText #LOCATION .dialog-input { max-length: 4096; }
        PushButton .dialog-tool .dialog-tool-after "Browse…" { on-click: browse; }
    }
    Label .dialog-note "The project goes in a new folder of the location, named after it: My Game in my_game";
    Label #ERROR .dialog-error "";
    LinearLayout .dialog-buttons {
        Box .dialog-fill;
        PushButton #CANCEL .dialog-cancel "Cancel" { on-click: cancel; }
        PushButton #ACCEPT .dialog-accept "Create" { on-click: accept; }
    }
}
