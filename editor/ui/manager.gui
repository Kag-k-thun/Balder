// The project manager of the editor of Balder, its first window: the projects opened last on the left, the one opened
// last first, the buttons opening, creating, importing and forgetting a project on the right, under a title and above
// a status bar telling why a project cannot be opened
LinearLayout .manager {
    LinearLayout .manager-head {
        Label .manager-title "Balder";
        Label .manager-subtitle "Projects";
    }

    LinearLayout #BODY .manager-body {
        TableView #PROJECTS .projects { on-select: projects::picked; on-activate: projects::reached; }

        LinearLayout .actions {
            PushButton #OPEN .action .primary "Open" { on-click: projects::open; }
            PushButton .action "New project…" { on-click: projects::new; }
            PushButton .action "Import…" { on-click: projects::import; }
            Separator .action-rule;
            PushButton #REMOVE .action "Remove from the list" { on-click: projects::remove; }
            Box .action-fill;
            PushButton .action "Quit" { on-click: projects::quit; }
        }
    }

    Label #STATUS .manager-status "";
}
