// The material editor, shown in place of the outline, the viewport and the inspector while a material is the document
// shown, reporting to the behavior 'material': a large preview of the material on a shape, turned with the mouse, under
// lights chosen, lit or a channel alone; the properties of the material grouped by what they do, each factor with the
// map multiplying it; and what the editor knows of it: the shader it is drawn with, its textures, what looks wrong, and
// the nodes of the scenes opened drawing it (a row picked selects its node)
@import "inspector.gui";

// The texture of a map beside its label (see NumberRow): its path, applied when Enter is pressed, a button choosing an
// image, another removing the map; what the map holds is told by the tooltip of the label
@component MapRow ($label, $on-validate: none, $on-browse: none, $on-clear: none, $tooltip: "") {
    LinearLayout .row {
        Label .row-label $label { tooltip: $tooltip; }
        LinearLayout .map .value {
            InputText #VALUE .input .map-path { max-length: 256; on-validate: $on-validate; }
            PushButton #BROWSE .map-button "…" { on-click: $on-browse; tooltip: "Choose an image"; }
            PushButton #CLEAR .map-button "×" { on-click: $on-clear; tooltip: "Remove the map"; }
        }
    }
}

@component MaterialEditor () {
    Splitter .main {
        LinearLayout #VIEW .panel .material-view {
            Label .section "PREVIEW";
            Scene3D #PREVIEW .preview { resolution: 960 720; editable: true;
                MaterialPreview #ORBIT;
            }
            LinearLayout .preview-bar {
                Dropdown #SHAPE .dropdown .preview-choice "Sphere", "Cube", "Plane", "Mesh opened from" { on-change: material::shape; }
                Dropdown #LIGHTING .dropdown .preview-choice "Studio", "Environment of the scene", "HDR map…" { on-change: material::lighting; }
                Dropdown #CHANNEL .dropdown .preview-choice "Lit", "Base colour", "Roughness", "Metallic", "Normals", "Occlusion", "Emissive" { on-change: material::channel; }
                CheckBox #BACKGROUND .check "Background" { on-toggle: material::background; }
                PushButton .action .preview-action "Frame" { on-click: material::frame; tooltip: "Look at the whole shape"; }
            }
        }

        LinearLayout #PROPERTIES .panel .inspector {
            Label .section "MATERIAL";
            Label #KIND .kind "No material";
            Label #ORIGIN .note .long "";
            PushButton #EXTRACT .action "Extract to a file…" { on-click: material::extract;
                                                                tooltip: "Write the material in a .material file, the meshes of the scene drawing it drawing the file"; }

            Collapsible #BASE .fold "Base colour" {
                VectorRow #COLOR "Colour (linear)" { min: 0; max: 1; step: 0.01; decimals: 3; x: "R"; y: "G"; z: "B";
                                                     on-x: material::axis("base-color", 0); on-y: material::axis("base-color", 1);
                                                     on-z: material::axis("base-color", 2); }
                MapRow #MAP "Map" { tooltip: "sRGB"; on-validate: material::map("base-color-map");
                                    on-browse: material::browse("base-color-map"); on-clear: material::clear("base-color-map"); }
            }

            Collapsible #SURFACE .fold "Metal and roughness" {
                NumberRow #METALLIC "Metallic" { min: 0; max: 1; step: 0.01; decimals: 3; on-change: material::number("metallic"); }
                NumberRow #ROUGHNESS "Roughness" { min: 0; max: 1; step: 0.01; decimals: 3; on-change: material::number("roughness"); }
                NumberRow #SPECULAR "Specular" { min: 0; max: 1; step: 0.01; decimals: 3; on-change: material::number("specular"); }
                MapRow #MAP "Map" { tooltip: "Roughness in green, metalness in blue";
                                    on-validate: material::map("metallic-roughness-map");
                                    on-browse: material::browse("metallic-roughness-map");
                                    on-clear: material::clear("metallic-roughness-map"); }
            }

            Collapsible #NORMALS .fold "Normals" {
                NumberRow #STRENGTH "Strength" { min: 0; max: 4; step: 0.05; decimals: 2; on-change: material::number("normal-strength"); }
                MapRow #MAP "Map" { tooltip: "Tangent space"; on-validate: material::map("normal-map");
                                    on-browse: material::browse("normal-map"); on-clear: material::clear("normal-map"); }
            }

            Collapsible #OCCLUSION .fold "Occlusion" {
                NumberRow #STRENGTH "Strength" { min: 0; max: 1; step: 0.01; decimals: 3; on-change: material::number("occlusion"); }
                MapRow #MAP "Map" { tooltip: "Occlusion in red"; on-validate: material::map("occlusion-map");
                                    on-browse: material::browse("occlusion-map"); on-clear: material::clear("occlusion-map"); }
            }

            Collapsible #EMISSION .fold "Emission" {
                VectorRow #COLOR "Colour (linear)" { min: 0; max: 1; step: 0.01; decimals: 3; x: "R"; y: "G"; z: "B";
                                                     on-x: material::axis("emissive", 0); on-y: material::axis("emissive", 1);
                                                     on-z: material::axis("emissive", 2); }
                NumberRow #STRENGTH "Strength (HDR)" { min: 0; max: 1000; step: 0.1; decimals: 2; on-change: material::number("emissive-strength"); }
                MapRow #MAP "Map" { tooltip: "sRGB"; on-validate: material::map("emissive-map");
                                    on-browse: material::browse("emissive-map"); on-clear: material::clear("emissive-map"); }
            }

            Collapsible #UV .fold "Texture coordinates" {
                NumberRow #TILING_U "Tiling along u" { min: -1000; max: 1000; step: 0.1; decimals: 2; on-change: material::number("tiling-u"); }
                NumberRow #TILING_V "Tiling along v" { min: -1000; max: 1000; step: 0.1; decimals: 2; on-change: material::number("tiling-v"); }
                NumberRow #OFFSET_U "Offset along u" { min: -1000; max: 1000; step: 0.01; decimals: 3; on-change: material::number("offset-u"); }
                NumberRow #OFFSET_V "Offset along v" { min: -1000; max: 1000; step: 0.01; decimals: 3; on-change: material::number("offset-v"); }
            }
        }

        LinearLayout #INFO .panel .inspector {
            Label .section "INFORMATION";
            Collapsible .fold "Shader" {
                Label #SHADER .note .long "";
            }
            Collapsible .fold "Textures" {
                TableView #TEXTURES .connections;
            }
            Collapsible .fold "Warnings" {
                Label #WARNINGS .note .long "None";
            }
            Collapsible .fold "Used by" {
                TableView #USERS .connections { on-select: material::user; }
                Label .note "A row picked selects its node, its scene shown";
            }
        }
    }
}
