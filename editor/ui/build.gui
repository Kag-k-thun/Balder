// The build of the editor of a project, over the project manager while it lasts: the project, a bar filled as far as
// the build is, and the step it is at; it has no button, the manager closing it once the build ends

@style "engine:/dialog/dialog.style";
@style "build.style";

LinearLayout #DIALOG .dialog .dialog-build {
    Label #TITLE .dialog-question "Building the editor";
    ProgressBar #BAR .build-bar 0 { max: 1; }
    Label #STEP .build-step "";
    Label .build-note "The editor of the project is built with its actor classes, then opens on it";
}
