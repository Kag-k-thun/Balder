// The dialog creating a project, over the look of the dialogs of Balder (engine:/dialog/dialog.style)

LinearLayout.dialog.dialog-project {
    width: 600;
    max-width: none;
}

.dialog Label.dialog-caption.dialog-caption-wide {
    width: 80;
}

// the rule telling where the project goes
.dialog Label.dialog-note {
    text-color: #9aa3ab;
    text-xalign: left;
    text-wrap: wrap;
    font-size: 13;
    margin: 0 3 8 3;
}

// the dropdown of the templates, as wide as the inputs, its list opened over the dialog
.dialog Dropdown.dialog-template {
    background-color: #17191d;
    border: 1 #4a5259;
    radius: 6;
    padding: 4 8;
    flex: 1;
}

.dialog Dropdown.dialog-template:hover { border-color: #5d6670; }
.dialog Dropdown.dialog-template:focus { border-color: #4c98fd; }

.dialog Dropdown.dialog-template::label {
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 15;
    text-xalign: left;
}

.dialog Dropdown.dialog-template::popup {
    background-color: #202328;
    border: 1 #4a5259;
    radius: 6;
    padding: 4 0;
    shadow: 0 4 12 #00000080;
}

.dialog Dropdown.dialog-template::item {
    background-color: #202328;
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 15;
    text-xalign: left;
    height: 28;
    padding: 0 8;
    radius: 0;
}

.dialog Dropdown.dialog-template::item:selected { text-color: #4c98fd; }
.dialog Dropdown.dialog-template::item:hover { background-color: #4c98fd; text-color: #eeeff2; }
