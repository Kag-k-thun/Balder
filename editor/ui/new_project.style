// The dialog creating a project, over the look of the dialogs of Balder (engine:/dialog/dialog.style)

LinearLayout.dialog.dialog-project {
    width: 600;
    max-width: none;
}

.dialog Label.dialog-caption.dialog-caption-wide {
    width: 80;
}

// the rule telling where the project goes
.dialog Label.dialog-note {
    text-color: #9aa3ab;
    text-xalign: left;
    text-wrap: wrap;
    font-size: 13;
    margin: 0 3 8 3;
}
