// The dialog of the settings of a project, its project.toml: what the game is and what its export ships (General), its
// window and the resolution it renders at (Window), and its input actions and their bindings (Input); OK writes them

@style "engine:/dialog/dialog.style";
@style "project_settings.style";

LinearLayout #DIALOG .dialog .dialog-settings {
    Label .dialog-question "Project settings";
    TabLayout #TABS .settings-tabs {
        LinearLayout #GENERAL .settings-page { tab: "General";
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Name";
                InputText #NAME .dialog-input { max-length: 256; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Main scene";
                Dropdown #MAIN_SCENE .settings-choice;
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Shipped as is";
                InputText #INCLUDE .dialog-input { max-length: 4096; }
            }
            Label .dialog-note "The files or folders the code loads by path, shipped with the scenes: res:/audio, res:/data/levels.toml";
            CheckBox #ARCHIVE .settings-check "Pack the export in a .tar.gz";
            Label .settings-section "Hulls of the dynamic bodies, decomposed at export";
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Hulls at most";
                SpinBox #HULLS .settings-spin { min: 1; max: 256; step: 1; decimals: 0; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Vertices of a hull";
                SpinBox #VERTICES .settings-spin { min: 4; max: 256; step: 1; decimals: 0; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Concavity";
                SpinBox #CONCAVITY .settings-spin { min: 0; max: 1; step: 0.005; decimals: 3; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Voxels";
                SpinBox #RESOLUTION .settings-spin { min: 8; max: 512; step: 8; decimals: 0; }
            }
        }
        LinearLayout #WINDOW .settings-page { tab: "Window";
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Title";
                InputText #TITLE .dialog-input { max-length: 256; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Width";
                SpinBox #WIDTH_SHARE .settings-spin { min: 10; max: 100; step: 5; decimals: 0; prefix: "% "; on-change: size; }
                SpinBox #WIDTH_MIN .settings-spin { min: 0; max: 16384; step: 16; decimals: 0; prefix: "min "; on-change: size; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Height";
                SpinBox #HEIGHT_SHARE .settings-spin { min: 10; max: 100; step: 5; decimals: 0; prefix: "% "; on-change: size; }
                SpinBox #HEIGHT_MIN .settings-spin { min: 0; max: 16384; step: 16; decimals: 0; prefix: "min "; on-change: size; }
            }
            Label .dialog-note "The window opens at this share of the screen, at least the minimum, in pixels";
            CheckBox #RESIZABLE .settings-check "Resizable";
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Render resolution";
                SpinBox #RENDER_W .settings-spin { min: 64; max: 7680; step: 16; decimals: 0; }
                SpinBox #RENDER_H .settings-spin { min: 64; max: 4320; step: 16; decimals: 0; }
            }
            Label .dialog-note "The scene renders at this resolution, scaled to the window";
        }
        LinearLayout #INPUT .settings-page { tab: "Input";
            ListView #ACTIONS .settings-actions { on-select: select-action; }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Action";
                InputText #ACTION_NAME .dialog-input { max-length: 64; }
                PushButton .dialog-tool .dialog-tool-after "Add" { on-click: add-action; }
                PushButton .dialog-tool .dialog-tool-after "Remove" { on-click: remove-action; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption .settings-caption "Bindings";
                PushButton #CAPTURE .dialog-tool "Add a binding…" { on-click: add-binding; }
                PushButton .dialog-tool .dialog-tool-after "Remove the last" { on-click: remove-binding; }
            }
            Label #CAPTURE_NOTE .dialog-note "Select an action, then add the key, mouse button or gamepad input it reads";
        }
    }
    Label #ERROR .dialog-error "";
    LinearLayout .dialog-buttons {
        Box .dialog-fill;
        PushButton #CANCEL .dialog-cancel "Cancel" { on-click: cancel; }
        PushButton #ACCEPT .dialog-accept "OK" { on-click: accept; }
    }
}
