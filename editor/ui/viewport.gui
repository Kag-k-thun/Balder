// The bars over the viewport: a snapping step of the toolbar, and the crumbs of the path of the selection, instantiated
// by the code (see ViewportBars)

// A snapping step: the toggle snapping a kind of change without a key, its step typed or rolled by the wheel, its unit
@component SnapStep ($name, $icon, $min, $max, $step, $decimals, $unit: "", $on-toggle: none, $on-change: none) {
    LinearLayout .snap {
        IconButton #ON .snap-toggle $name { icon: $icon; checkable: true; on-toggle: $on-toggle; }
        SpinBox #STEP .snap-step { min: $min; max: $max; step: $step; decimals: $decimals; on-change: $on-change; }
        Label .snap-unit $unit;
    }
}

// A crumb of the path: the scene or a parent of the node selected last, a click selecting it
@component Crumb ($label, $on-click: none) {
    PushButton .crumb $label { on-click: $on-click; }
}

// The chevron between two crumbs
@component CrumbSeam () {
    Box .crumb-seam;
}

// The node selected last, its icon before its name
@component CrumbNode ($label) {
    LinearLayout .crumb-node {
        Box #ICON .crumb-icon;
        Label .crumb-name $label;
    }
}
