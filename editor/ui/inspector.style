// The look of the inspector: the kind of the node, then its name and the sections of its fields, a row each, its label
// on the left and its field on the right; the sections fold edge to edge, the rows keeping an inset of 8 pixels from
// the seams

// the inspector scrolls over sections taller than the window instead of growing the editor, its scrollbar drawn over
// the right inset of the fields
LinearLayout.inspector {
    width: 22%;
    min-width: 280;
    overflow: scroll;
    scroll-speed: 4;
    padding: 0;
}

LinearLayout.inspector::scrollbar {
    background-color: $edge;
    width: 6;
    radius: $round;
}

LinearLayout.inspector::scrollbar:hover, LinearLayout.inspector::scrollbar:pressed {
    background-color: $focus;
}

Label.kind {
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 13;
    text-xalign: left;
    height: 32;
    padding: 0 8;
}

// a row of a property: its label, in a column of the same width in every row (a part of the width of the inspector, the
// parent of every row), cut when longer, then its field filling the rest, centred in the row
LinearLayout.row {
    direction: row;
    height: 24;
    padding: 0 8;
    background-color: transparent;
}

Label.row-label {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    text-yalign: center;
    text-overflow: ellipsis;
    width: 40%;
    min-width: 96;
    max-width: 104;
    flex: none;
    padding-right: 6;
}

LinearLayout.row > .value {
    flex: 1;
    height: 20;
    margin: 2 0;
}

// a label above its field, in the panel of the connections
Label.field {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    padding: 6 8 2 8;
}

InputText.input {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    height: 22;
    padding: 0 6;
}

InputText.input:hover, SpinBox.spin:hover {
    border-color: #484f58;
}

InputText.input:focus, SpinBox.spin:focus {
    border-color: $focus;
}

InputText.input::label, SpinBox.spin::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    text-yalign: center;
}

InputText.input::selection, SpinBox.spin::selection {
    color: #388bfd64;
}

InputText.input::cursor, SpinBox.spin::cursor {
    text-color: $text;
}

LinearLayout.axes {
    direction: row;
    background-color: transparent;
}

SpinBox.spin {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    height: 22;
    padding: 0 4;
    margin-right: 2;
    flex: 1;
    min-width: 60;
}

SpinBox.spin::up, SpinBox.spin::down {
    background-color: $raised;
    width: 12;
    margin: 1;
    radius: 2;
}

SpinBox.spin::up:hover, SpinBox.spin::down:hover {
    background-color: $edge;
}

SpinBox.spin::up:pressed, SpinBox.spin::down:pressed {
    background-color: $accent;
}

// a field of a vector, a third of the row, lettered by the colour of its axis; its arrows hidden for room, the wheel
// still stepping it
SpinBox.spin.axis {
    height: 20;
    min-width: 0;
    flex: 1;
    margin-right: 2;
}

SpinBox.spin.axis.z {
    margin-right: 0;
}

SpinBox.spin.axis::label, SpinBox.spin.axis::prefix {
    font-family: $mono;
    font-size: 12;
}

SpinBox.spin.axis::prefix {
    width: 10;
    padding-left: 4;
}

SpinBox.spin.axis.x::prefix { text-color: $x-axis; }
SpinBox.spin.axis.y::prefix { text-color: $y-axis; }
SpinBox.spin.axis.z::prefix { text-color: $z-axis; }

SpinBox.spin.axis::up, SpinBox.spin.axis::down {
    width: 0;
    margin: 0;
}

// the fields gathered: the panel of an object, the panel of a light and the rows of a light its type uses
LinearLayout.group {
    background-color: transparent;
}

// a section or a row the node inspected does not use, taking no room
LinearLayout.absent, Collapsible.absent {
    display: none;
}

CheckBox.check {
    background-color: transparent;
    border-color: transparent;
    margin: 4 8;
}

CheckBox.check::box {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    padding: 3;
    margin-right: 8;
}

CheckBox.check:hover::box {
    border-color: #484f58;
}

CheckBox.check:focus::box {
    border-color: $focus;
}

CheckBox.check::mark {
    background-color: transparent;
    border-color: transparent;
    radius: 2;
}

CheckBox.check:checked::mark {
    background-color: $focus;
}

CheckBox.check::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

// the choices of a field (the purpose of a marker, the curve of a path, the shape of a volume), its list opened under it
Dropdown.dropdown {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    height: 22;
    padding: 0 6;
    margin: 0 8 4 8;
}

Dropdown.dropdown:hover {
    border-color: #484f58;
}

Dropdown.dropdown:focus {
    border-color: $focus;
}

Dropdown.dropdown::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
}

Dropdown.dropdown::popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $popup-corner;
    padding: 4 0;
    shadow: 0 4 12 #00000080;
    max-height: 240;
}

Dropdown.dropdown::item {
    background-color: $panel;
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    height: 22;
    padding: 0 8;
    radius: 0;
}

Dropdown.dropdown::item:selected {
    text-color: $focus;
}

Dropdown.dropdown::item:hover {
    background-color: $accent;
    text-color: $text;
}

// a section of the fields, folded under its header: the transform, a light, a marker, a path, a volume, the sections of
// a body, the convex hulls of a model; the sections stack edge to edge, a seam on top of each header
Collapsible.fold {
    background-color: transparent;
    margin: 0;
}

Collapsible.fold::header {
    background-color: $raised;
    border-width: 1 0 0 0;
    border-color: $edge;
    radius: 0;
    height: 24;
    padding: 0 8;
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 12;
    text-xalign: left;
}

Collapsible.fold::header:hover {
    background-color: $edge;
}

Collapsible.fold:focus::header {
    shadow: 0 0 0 1 $focus;
}

// a chevron of 12 pixels before the title
Collapsible.fold::marker {
    background-color: transparent;
    border: 0 transparent;
    image: $chevron-right;
    image-color: $muted;
    image-fill: false;
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    width: 12;
    margin-right: 6;
}

Collapsible.fold:expanded::marker {
    image: $chevron-down;
}

Collapsible.fold::marker:hover {
    image-color: $text;
    text-color: $text;
}

// what a panel tells of its node: the hulls saved next to a model, the model of the hulls or the mesh of a body
Label.note {
    text-color: $muted;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    padding: 4 8;
}

// the layers of a body, a row of eight boxes, each under its number
LinearLayout.bits {
    direction: row;
    background-color: transparent;
    margin: 0 8;
}

CheckBox.bit {
    background-color: transparent;
    border-color: transparent;
    margin: 2 2 2 0;
    flex: 1;
}

CheckBox.bit::box {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    padding: 2;
    margin-right: 2;
}

CheckBox.bit:hover::box {
    border-color: #484f58;
}

CheckBox.bit::mark {
    background-color: transparent;
    border-color: transparent;
    radius: 2;
}

CheckBox.bit:checked::mark {
    background-color: $focus;
}

CheckBox.bit::label {
    text-color: $muted;
    font-family: $font;
    font-size: 11;
    text-xalign: left;
}

// the connections of the actor inspected, a row each, and the actions removing one and making one
TableView.connections {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    height: 120;
    margin: 4 8;
    text-color: $text;
    font-family: $font;
    font-size: 12;
}
TableView.connections:focus { border-color: $focus; }

TableView.connections::header {
    background-color: $page;
    border-width: 0 0 1 0;
    border-color: $edge;
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 11;
    text-xalign: left;
    height: 22;
    padding: 0 6;
}

TableView.connections::row {
    background-color: transparent;
    border: 1 transparent;
    radius: 0;
}
TableView.connections::row:hover { background-color: $raised; }
TableView.connections::row:selected { background-color: $accent; }
TableView.connections:focus::row:current { border-color: $focus; }

TableView.connections::cell {
    background-color: transparent;
    border: 0 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 12;
    text-xalign: left;
    height: 22;
    padding: 0 6;
}

TableView.connections::scrollbar {
    background-color: $edge;
    width: 6;
    height: 6;
    radius: $round;
}

PushButton.action {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    height: 22;
    padding: 0 10;
    margin: 4 8;
}
PushButton.action:hover { background-color: $edge; }
PushButton.action:focus { shadow: 0 0 0 1 $focus; }

PushButton.action::label {
    text-color: $text;
    font-family: $font;
    font-size: 12;
}
