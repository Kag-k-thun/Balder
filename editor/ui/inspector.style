// The look of the inspector: the kind of the node, then its name and the fields of an object or of a light, a label above
// each field

LinearLayout.inspector {
    width: 22%;
    min-width: 240;
}

Label.kind {
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 15;
    text-xalign: left;
    padding: 4 4 10 4;
}

Label.field {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding: 8 4 4 4;
}

InputText.input {
    background-color: $page;
    border: 2 $edge;
    radius: $corner;
    padding: 6 8;
}

InputText.input:hover, SpinBox.spin:hover {
    border-color: #484f58;
}

InputText.input:focus, SpinBox.spin:focus {
    border-color: $focus;
}

InputText.input::label, SpinBox.spin::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText.input::selection, SpinBox.spin::selection {
    color: #388bfd64;
}

InputText.input::cursor, SpinBox.spin::cursor {
    text-color: $text;
}

LinearLayout.axes {
    direction: row;
    background-color: transparent;
}

SpinBox.spin {
    background-color: $page;
    border: 2 $edge;
    radius: $corner;
    padding: 4 6;
    margin-right: 4;
    flex: 1;
    min-width: 60;
}

SpinBox.spin::up, SpinBox.spin::down {
    background-color: $raised;
    width: 14;
    margin: 1;
    radius: 3;
}

SpinBox.spin::up:hover, SpinBox.spin::down:hover {
    background-color: $edge;
}

SpinBox.spin::up:pressed, SpinBox.spin::down:pressed {
    background-color: $accent;
}

// the fields gathered: the panel of an object, the panel of a light and the rows of a light its type uses
LinearLayout.group {
    background-color: transparent;
}

// a panel or a row the node inspected does not use, taking no room
LinearLayout.absent {
    display: none;
}

CheckBox.check {
    background-color: transparent;
    border-color: transparent;
    margin: 4 0;
}

CheckBox.check::box {
    background-color: $page;
    border: 2 $edge;
    radius: 4;
    padding: 3;
    margin-right: 8;
}

CheckBox.check:hover::box {
    border-color: #484f58;
}

CheckBox.check:focus::box {
    border-color: $focus;
}

CheckBox.check::mark {
    background-color: transparent;
    border-color: transparent;
    radius: 2;
}

CheckBox.check:checked::mark {
    background-color: $focus;
}

CheckBox.check::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}
