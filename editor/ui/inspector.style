// The look of the inspector: the kind of the node, then its name and the sections of its fields, a label above each
// field

// the inspector scrolls over sections taller than the window instead of growing the editor, its scrollbar in the right
// padding
LinearLayout.inspector {
    width: 22%;
    min-width: 240;
    overflow: scroll;
    scroll-speed: 4;
    padding: 8 14 8 8;
}

LinearLayout.inspector::scrollbar {
    background-color: $edge;
    width: 6;
    radius: $round;
}

LinearLayout.inspector::scrollbar:hover, LinearLayout.inspector::scrollbar:pressed {
    background-color: $focus;
}

Label.kind {
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 15;
    text-xalign: left;
    padding: 4 4 10 4;
}

Label.field {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding: 8 4 4 4;
}

InputText.input {
    background-color: $page;
    border: 2 $edge;
    radius: $corner;
    padding: 6 8;
}

InputText.input:hover, SpinBox.spin:hover {
    border-color: #484f58;
}

InputText.input:focus, SpinBox.spin:focus {
    border-color: $focus;
}

InputText.input::label, SpinBox.spin::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    text-yalign: center;
}

InputText.input::selection, SpinBox.spin::selection {
    color: #388bfd64;
}

InputText.input::cursor, SpinBox.spin::cursor {
    text-color: $text;
}

LinearLayout.axes {
    direction: row;
    background-color: transparent;
}

SpinBox.spin {
    background-color: $page;
    border: 2 $edge;
    radius: $corner;
    padding: 4 6;
    margin-right: 4;
    flex: 1;
    min-width: 60;
}

SpinBox.spin::up, SpinBox.spin::down {
    background-color: $raised;
    width: 14;
    margin: 1;
    radius: 3;
}

SpinBox.spin::up:hover, SpinBox.spin::down:hover {
    background-color: $edge;
}

SpinBox.spin::up:pressed, SpinBox.spin::down:pressed {
    background-color: $accent;
}

// the fields gathered: the panel of an object, the panel of a light and the rows of a light its type uses
LinearLayout.group {
    background-color: transparent;
}

// a section or a row the node inspected does not use, taking no room
LinearLayout.absent, Collapsible.absent, CheckBox.absent {
    display: none;
}

CheckBox.check {
    background-color: transparent;
    border-color: transparent;
    margin: 4 0;
}

CheckBox.check::box {
    background-color: $page;
    border: 2 $edge;
    radius: 4;
    padding: 3;
    margin-right: 8;
}

CheckBox.check:hover::box {
    border-color: #484f58;
}

CheckBox.check:focus::box {
    border-color: $focus;
}

CheckBox.check::mark {
    background-color: transparent;
    border-color: transparent;
    radius: 2;
}

CheckBox.check:checked::mark {
    background-color: $focus;
}

CheckBox.check::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

// the choices of a field (the purpose of a marker, the curve of a path, the shape of a volume), its list opened under it
Dropdown.dropdown {
    background-color: $page;
    border: 2 $edge;
    radius: $corner;
    padding: 6 8;
}

Dropdown.dropdown:hover {
    border-color: #484f58;
}

Dropdown.dropdown:focus {
    border-color: $focus;
}

Dropdown.dropdown::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
}

Dropdown.dropdown::popup {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    shadow: 0 4 12 #00000080;
    max-height: 240;
}

Dropdown.dropdown::item {
    background-color: $panel;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 6 8;
    radius: 4;
}

Dropdown.dropdown::item:selected {
    text-color: $focus;
}

Dropdown.dropdown::item:hover {
    background-color: $accent;
    text-color: $text;
}

// a section of the fields, folded under its header: the transform, a light, a marker, a path, a volume, the sections of
// a body, the convex hulls of a model
Collapsible.fold {
    background-color: transparent;
    margin-top: 10;
}

Collapsible.fold::header {
    background-color: $raised;
    radius: $corner;
    padding: 6 8;
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 13;
    text-xalign: left;
}

Collapsible.fold::header:hover {
    background-color: $edge;
}

Collapsible.fold:focus::header {
    shadow: 0 0 0 2 $focus;
}

Collapsible.fold::marker {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    padding: 0 8 0 0;
}

Collapsible.fold::marker:hover {
    text-color: $text;
}

// what a panel tells of its node: the hulls saved next to a model, the model of the hulls or the mesh of a body
Label.note {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding: 4 4;
}

// the layers of a body, a row of eight boxes, each under its number
LinearLayout.bits {
    direction: row;
    background-color: transparent;
}

CheckBox.bit {
    background-color: transparent;
    border-color: transparent;
    margin: 2 2 2 0;
    flex: 1;
}

CheckBox.bit::box {
    background-color: $page;
    border: 2 $edge;
    radius: 3;
    padding: 2;
    margin-right: 2;
}

CheckBox.bit:hover::box {
    border-color: #484f58;
}

CheckBox.bit::mark {
    background-color: transparent;
    border-color: transparent;
    radius: 2;
}

CheckBox.bit:checked::mark {
    background-color: $focus;
}

CheckBox.bit::label {
    text-color: $muted;
    font-family: $font;
    font-size: 11;
    text-xalign: left;
}

// the connections of the actor inspected, a row each, and the actions removing one and making one
TableView.connections {
    background-color: $page;
    border: 1 $edge;
    radius: $corner;
    height: 120;
    margin: 4 0;
    text-color: $text;
    font-family: $font;
    font-size: 13;
}
TableView.connections:focus { border-color: $focus; }

TableView.connections::header {
    background-color: $page;
    border-width: 0 0 1 0;
    border-color: $edge;
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 12;
    text-xalign: left;
    padding: 4 6;
}

TableView.connections::row {
    background-color: transparent;
    border: 1 transparent;
    radius: 4;
}
TableView.connections::row:hover { background-color: $raised; }
TableView.connections::row:selected { background-color: $accent; }
TableView.connections:focus::row:current { border-color: $focus; }

TableView.connections::cell {
    background-color: transparent;
    border: 0 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding: 4 6;
}

TableView.connections::scrollbar {
    background-color: $edge;
    width: 6;
    height: 6;
    radius: $round;
}

PushButton.action {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    padding: 6 12;
    margin: 4 0;
}
PushButton.action:hover { background-color: $edge; }
PushButton.action:focus { shadow: 0 0 0 2 $focus; }

PushButton.action::label {
    text-color: $text;
    font-family: $font;
    font-size: 13;
}
