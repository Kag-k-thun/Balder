// The colours and the fonts of the editor, the constants of its sheets

$page: #0d1117;
$panel: #161b22;
$raised: #21262d;
$edge: #30363d;
$text: #e6edf3;
$soft: #c9d1d9;
$muted: #8b949e;
$accent: #1f6feb;
$focus: #388bfd;
$green: #3fb950;
$font: "Noto Sans", sans-serif;
$mono: "DejaVu Sans Mono", monospace;

// The radius of the corners of the buttons, the fields and the panels, and a radius wider than any widget, fitted to
// half its shortest side: a circle of a square, a pill of a bar
$corner: 6;
$round: 999;

// The tooltips of the buttons, in the colours of the menus, their shortcut muted
Tooltip {
    background-color: $raised;
    border: 1 $edge;
    radius: 4;
    text-color: $text;
    font-family: $font;
    font-size: 13;
}

Tooltip::shortcut {
    text-color: $muted;
}
