// The colours and the fonts of the editor, the constants of its sheets

$page: #0d1117;
$panel: #161b22;
$raised: #21262d;
$edge: #30363d;
$text: #e6edf3;
$soft: #c9d1d9;
$muted: #8b949e;
$accent: #1f6feb;
$focus: #388bfd;
$green: #3fb950;
// The ground of what lies over the scene (the chip of the camera, the name of the axis view), the scene showing through
$glass: #161b22cc;
// The colours of the axes, those of the gizmo (see colorOf of the gizmo parts), lettering the fields of a vector
$x-axis: #f0424f;
$y-axis: #85d426;
$z-axis: #3d85fa;

$font: "Noto Sans", sans-serif;
$mono: "DejaVu Sans Mono", monospace;

// The radius of the corners of the buttons and the fields, of the popups (the menus, the lists of the dropdowns), and a
// radius wider than any widget, fitted to half its shortest side: a circle of a square, a pill of a bar; the panels are
// square, so that the docks read as one window
$corner: 3;
$popup-corner: 4;
$round: 999;

// The chevron of what folds, pointing right while it is collapsed and down while it is expanded
$chevron-right: "engine:/images/ui/chevron-right.svg";
$chevron-down: "engine:/images/ui/chevron-down.svg";

// The tooltips of the buttons, in the colours of the menus, their shortcut muted
Tooltip {
    background-color: $raised;
    border: 1 $edge;
    radius: $popup-corner;
    text-color: $text;
    font-family: $font;
    font-size: 13;
}

Tooltip::shortcut {
    text-color: $muted;
}

// The icon buttons: an icon of 16 pixels in a button of 26 by 24, drawn white and tinted by image-color, lit under the
// cursor, darker while pressed, and in the focus colour while checked
IconButton {
    background-color: transparent;
    radius: $corner;
    image-color: $soft;
    width: 26;
    height: 24;
    padding: 4 5;
}

IconButton:hover { background-color: $raised; image-color: $text; }
IconButton:pressed { background-color: $edge; }
IconButton:checked { background-color: $raised; image-color: $focus; }

// a button with nothing to do yet
IconButton.idle, IconButton.idle:hover { background-color: transparent; image-color: $edge; }

// a toolbar: its tools in a row, 2 pixels apart, the separators a vertical rule of 16 pixels
ToolBar {
    direction: row;
    gap: 2;
    background-color: $panel;
    height: 32;
    padding: 4 6;
}

ToolBar Separator {
    direction: column;
    background-color: $edge;
    height: 16;
    margin: 4 4;
}

// a segmented group: its buttons joined by a seam of a pixel, its background showing through the gap, only its outer
// corners rounded
ToolGroup {
    direction: row;
    gap: 1;
    background-color: $edge;
    radius: $corner;
}

ToolGroup IconButton { radius: 0; background-color: $raised; }
ToolGroup IconButton:first { radius: $corner 0 0 $corner; }
ToolGroup IconButton:last { radius: 0 $corner $corner 0; }
ToolGroup IconButton:first:last { radius: $corner; }
ToolGroup IconButton:hover { background-color: $edge; }
ToolGroup IconButton:checked { background-color: $accent; image-color: $text; }
