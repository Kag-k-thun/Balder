// The project manager of the editor of Balder: a title, the table of the projects and the column of the actions, a
// status bar

@import "theme.style";

LinearLayout.manager {
    background-color: $page;
    padding: 20 24 12 24;
}

LinearLayout.manager-head {
    direction: row;
    background-color: transparent;
    margin-bottom: 16;
}

Label.manager-title {
    text-color: $text;
    font-family: $font;
    font-weight: bold;
    font-size: 24;
    text-xalign: left;
    margin-right: 12;
}

Label.manager-subtitle {
    text-color: $muted;
    font-family: $font;
    font-size: 24;
    text-xalign: left;
}

LinearLayout.manager-body {
    direction: row;
    background-color: transparent;
    flex: 1;
}

Label.manager-status {
    text-color: $muted;
    font-family: $font;
    font-size: 13;
    text-xalign: left;
    padding: 8 2 0 2;
}

// ===================================          PROJECTS          ===================================

TableView.projects {
    background-color: $panel;
    border: 1 $edge;
    radius: $corner;
    padding: 2 12 12 2;
    margin-right: 16;
    flex: 1;
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

TableView.projects:focus { border-color: $focus; }

TableView.projects::header {
    background-color: $panel;
    border-width: 0 0 1 0;
    border-color: $edge;
    text-color: $muted;
    font-family: $font;
    font-weight: bold;
    font-size: 13;
    text-xalign: left;
    padding: 6 10;
}

TableView.projects::header:hover { text-color: $text; }
TableView.projects::header:ascending, TableView.projects::header:descending { text-color: $focus; }

TableView.projects::row {
    background-color: transparent;
    border: 1 transparent;
    radius: 4;
}

TableView.projects::row:hover { background-color: $raised; }
TableView.projects::row:selected { background-color: $accent; }
TableView.projects:focus::row:current { border-color: $focus; }

TableView.projects::cell {
    background-color: transparent;
    border: 0 transparent;
    text-color: $text;
    font-family: $font;
    font-size: 14;
    text-xalign: left;
    padding: 6 10;
}

TableView.projects::scrollbar {
    background-color: $edge;
    width: 8;
    height: 8;
    radius: $round;
}

TableView.projects::scrollbar:hover, TableView.projects::scrollbar:pressed { background-color: $focus; }

// ===================================          ACTIONS          ====================================

LinearLayout.actions {
    background-color: transparent;
    width: 220;
    padding: 2;
}

PushButton.action {
    background-color: $raised;
    border: 1 $edge;
    radius: $corner;
    padding: 8 16;
    margin-bottom: 8;
}

PushButton.action:hover { background-color: $edge; }
PushButton.action:focus { shadow: 0 0 0 2 $focus; }

PushButton.action::label {
    text-color: $text;
    font-family: $font;
    font-size: 14;
}

PushButton.action.primary {
    background-color: $accent;
    border-color: $focus;
}

PushButton.action.primary:hover { background-color: $focus; }

// an action with nothing to do (Open and Remove while no project is selected)
PushButton.action.idle::label { text-color: $muted; }

Separator.action-rule {
    background-color: $edge;
    margin: 4 0 12 0;
}

Box.action-fill {
    background-color: transparent;
    border-color: transparent;
    flex: 1;
}
