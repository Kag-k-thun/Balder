// The look of the tooltips of Balder. The widget manager loads it with the first tooltip, at the origin of the
// components: every sheet of the application wins over it

Tooltip {
    background-color: #202328;
    border: 1 #4a5259;
    radius: 4;
    shadow: 0 2 8 #00000080;
    padding: 4 8;
    max-width: 320;
    text-color: #eeeff2;
    font-family: "Noto Sans", sans-serif;
    font-size: 13;
    text-wrap: wrap;
    delay: 500ms;
}

Tooltip::label {
    text-xalign: left;
}

// the shortcut, muted, set apart from the text
Tooltip::shortcut {
    text-color: #9aa3ab;
    margin-left: 16;
}
