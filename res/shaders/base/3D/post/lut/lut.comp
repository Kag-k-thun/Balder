#version 450 core

layout (local_size_x = 16, local_size_y = 16) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The colours of the screen, encoded in sRGB, written by the pass before it
layout (binding = 1) uniform sampler2D inputTex;

// The lookup table: the colour graded of each colour of the screen, both encoded in sRGB, red along x, green along y
// and blue along z
layout (binding = 2) uniform sampler3D lut;

// The grading (balder::scene::utils::post::lut::LutEffect)
layout (binding = 3) uniform Params {
    // The share of the colour graded in the colour written, from 0 (none) to 1
    float contribution;
} params;

// The colours of the screen graded, still encoded in sRGB
layout (set = 0, binding = 0, rgba8) uniform writeonly image2D outTex;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

void main () {
    ivec2 texelCoord = ivec2 (gl_GlobalInvocationID.xy);
    ivec2 size = imageSize (outTex);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    vec4 color = texelFetch (inputTex, texelCoord, 0);

    // the entries are at the centres of the texels of the table, the first one at half a texel from its edge
    float n = float (textureSize (lut, 0).x);
    vec3 graded = textureLod (lut, clamp (color.rgb, 0.0, 1.0) * ((n - 1.0) / n) + 0.5 / n, 0.0).rgb;

    imageStore (outTex, texelCoord, vec4 (mix (color.rgb, graded, params.contribution), color.a));
}
