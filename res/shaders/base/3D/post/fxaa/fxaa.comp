#version 450 core

layout (local_size_x = 16, local_size_y = 16) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The colours of the screen, encoded in sRGB, written by the pass before it, sampled bilinearly
layout (binding = 1) uniform sampler2D inputTex;

// The anti-aliasing (balder::scene::utils::post::fxaa::FxaaEffect)
layout (binding = 2) uniform Params {
    // The share of the sub-pixel aliasing removed, from 0 (sharper) to 1 (softer)
    float subpix;

    // The contrast of the luma a texel needs with its neighbours to be on an edge, relative to the brightest of them
    float edgeThreshold;

    // The contrast under which the dark texels are never on an edge
    float edgeThresholdMin;
} params;

// The colours of the screen, their edges smoothed, still encoded in sRGB
layout (set = 0, binding = 0, rgba8) uniform writeonly image2D outTex;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          FXAA          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The steps of the search of the ends of an edge, in texels: the quality preset 12 of FXAA 3.11 (Timothy Lottes), the
// last step a guess past the last texel read
const int STEPS = 5;
const float STEP [STEPS] = float [STEPS] (1.0, 1.5, 2.0, 4.0, 12.0);

/**
 * @returns: the luma of a colour encoded in sRGB, perceptual as FXAA expects it
 */
float luma (vec3 c) {
    return dot (c, vec3 (0.299, 0.587, 0.114));
}

/**
 * @returns: the luma of the screen at a position, between texels
 */
float lumaAt (vec2 pos) {
    return luma (textureLod (inputTex, pos, 0.0).rgb);
}

// The luma of the texel at an offset from a position, the offset a constant
#define LUMA_OFF(pos, x, y) luma (textureLodOffset (inputTex, pos, 0.0, ivec2 (x, y)).rgb)

/**
 * @returns: the colour of the screen at a texel, its edge smoothed: FXAA 3.11, quality version
 * @params:
 *    - posM: the centre of the texel
 *    - rcp: the size of a texel
 */
vec4 fxaa (vec2 posM, vec2 rcp) {
    vec4 rgbM = textureLod (inputTex, posM, 0.0);
    float lumaM = luma (rgbM.rgb);
    float lumaS = LUMA_OFF (posM, 0, 1);
    float lumaE = LUMA_OFF (posM, 1, 0);
    float lumaN = LUMA_OFF (posM, 0, -1);
    float lumaW = LUMA_OFF (posM, -1, 0);

    // the contrast around the texel, too low for an edge
    float rangeMax = max (max (lumaN, lumaW), max (lumaE, max (lumaS, lumaM)));
    float rangeMin = min (min (lumaN, lumaW), min (lumaE, min (lumaS, lumaM)));
    float range = rangeMax - rangeMin;
    if (range < max (params.edgeThresholdMin, rangeMax * params.edgeThreshold)) {
        return rgbM;
    }

    float lumaNW = LUMA_OFF (posM, -1, -1);
    float lumaSE = LUMA_OFF (posM, 1, 1);
    float lumaNE = LUMA_OFF (posM, 1, -1);
    float lumaSW = LUMA_OFF (posM, -1, 1);

    // the direction of the edge, horizontal or vertical
    float lumaNS = lumaN + lumaS;
    float lumaWE = lumaW + lumaE;
    float lumaNESE = lumaNE + lumaSE;
    float lumaNWNE = lumaNW + lumaNE;
    float lumaNWSW = lumaNW + lumaSW;
    float lumaSWSE = lumaSW + lumaSE;

    float edgeHorz = abs (-2.0 * lumaW + lumaNWSW) + abs (-2.0 * lumaM + lumaNS) * 2.0 + abs (-2.0 * lumaE + lumaNESE);
    float edgeVert = abs (-2.0 * lumaS + lumaSWSE) + abs (-2.0 * lumaM + lumaWE) * 2.0 + abs (-2.0 * lumaN + lumaNWNE);
    bool horzSpan = edgeHorz >= edgeVert;

    // the sub-pixel aliasing, the contrast of the texel with the average of its neighbours
    float subpixA = (lumaNS + lumaWE) * 2.0 + lumaNWSW + lumaNESE;
    float subpixB = subpixA * (1.0 / 12.0) - lumaM;
    float subpixC = clamp (abs (subpixB) / range, 0.0, 1.0);
    float subpixD = -2.0 * subpixC + 3.0;
    float subpixF = subpixD * subpixC * subpixC;

    // the side of the edge, the neighbour across it of the strongest gradient
    if (!horzSpan) {
        lumaN = lumaW;
        lumaS = lumaE;
    }

    float lengthSign = horzSpan ? rcp.y : rcp.x;
    float gradientN = lumaN - lumaM;
    float gradientS = lumaS - lumaM;
    bool pairN = abs (gradientN) >= abs (gradientS);
    float gradient = max (abs (gradientN), abs (gradientS));
    if (pairN) {
        lengthSign = -lengthSign;
    }

    float lumaNN = (pairN ? lumaN : lumaS) + lumaM;
    float gradientScaled = gradient * 0.25;
    bool lumaMLTZero = lumaM - lumaNN * 0.5 < 0.0;

    // the search of the ends of the edge, from the boundary between the two sides, along the edge
    vec2 posB = posM;
    vec2 offNP = horzSpan ? vec2 (rcp.x, 0.0) : vec2 (0.0, rcp.y);
    if (horzSpan) {
        posB.y += lengthSign * 0.5;
    } else {
        posB.x += lengthSign * 0.5;
    }

    vec2 posN = posB - offNP * STEP [0];
    vec2 posP = posB + offNP * STEP [0];
    float lumaEndN = lumaAt (posN) - lumaNN * 0.5;
    float lumaEndP = lumaAt (posP) - lumaNN * 0.5;
    bool doneN = abs (lumaEndN) >= gradientScaled;
    bool doneP = abs (lumaEndP) >= gradientScaled;
    if (!doneN) posN -= offNP * STEP [1];
    if (!doneP) posP += offNP * STEP [1];

    for (int i = 2; i < STEPS && !(doneN && doneP); i++) {
        if (!doneN) {
            lumaEndN = lumaAt (posN) - lumaNN * 0.5;
            doneN = abs (lumaEndN) >= gradientScaled;
            if (!doneN) posN -= offNP * STEP [i];
        }

        if (!doneP) {
            lumaEndP = lumaAt (posP) - lumaNN * 0.5;
            doneP = abs (lumaEndP) >= gradientScaled;
            if (!doneP) posP += offNP * STEP [i];
        }
    }

    // the offset of the texel toward the side of the edge, by its distance to the nearest end
    float dstN = horzSpan ? posM.x - posN.x : posM.y - posN.y;
    float dstP = horzSpan ? posP.x - posM.x : posP.y - posM.y;
    bool directionN = dstN < dstP;
    bool goodSpan = directionN ? ((lumaEndN < 0.0) != lumaMLTZero) : ((lumaEndP < 0.0) != lumaMLTZero);
    float pixelOffset = goodSpan ? 0.5 - min (dstN, dstP) / (dstN + dstP) : 0.0;
    float pixelOffsetSubpix = max (pixelOffset, subpixF * subpixF * params.subpix);

    if (horzSpan) {
        posM.y += pixelOffsetSubpix * lengthSign;
    } else {
        posM.x += pixelOffsetSubpix * lengthSign;
    }

    return vec4 (textureLod (inputTex, posM, 0.0).rgb, rgbM.a);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

void main () {
    ivec2 texelCoord = ivec2 (gl_GlobalInvocationID.xy);
    ivec2 size = imageSize (outTex);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    vec2 rcp = 1.0 / vec2 (size);
    imageStore (outTex, texelCoord, fxaa ((vec2 (texelCoord) + 0.5) * rcp, rcp));
}
