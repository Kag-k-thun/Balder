#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The level of the downsampling of the size written, the light the stage before it wrote for the last pass
layout (binding = 1) uniform sampler2D inputTex;

// The blurred levels below, half the size written
layout (binding = 2) uniform sampler2D low;

// The bloom (balder::scene::utils::post::bloom::BloomEffect)
layout (binding = 3) uniform Params {
    // The brightness of the light, exposed, from which it blooms
    float threshold;

    // The softness of the threshold
    float knee;

    // The share of the bloom added to the light
    float intensity;

    // The radius of the tent upsampling the levels, in texels of the level read
    float radius;
} params;

// The level written, 0 for the light of the stage after it, the bloom added to the light with its intensity
layout (push_constant) uniform Level {
    uint level;
} pc;

// The level written, linear light
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2D outTex;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the blurred levels below at a position, through a 3x3 tent of bilinear taps
 */
vec3 tent (vec2 uv, vec2 texel) {
    vec3 sum = textureLod (low, uv, 0.0).rgb * 4.0;
    sum += textureLod (low, uv + texel * vec2 (-1.0,  0.0), 0.0).rgb * 2.0;
    sum += textureLod (low, uv + texel * vec2 ( 1.0,  0.0), 0.0).rgb * 2.0;
    sum += textureLod (low, uv + texel * vec2 ( 0.0, -1.0), 0.0).rgb * 2.0;
    sum += textureLod (low, uv + texel * vec2 ( 0.0,  1.0), 0.0).rgb * 2.0;
    sum += textureLod (low, uv + texel * vec2 (-1.0, -1.0), 0.0).rgb;
    sum += textureLod (low, uv + texel * vec2 ( 1.0, -1.0), 0.0).rgb;
    sum += textureLod (low, uv + texel * vec2 (-1.0,  1.0), 0.0).rgb;
    sum += textureLod (low, uv + texel * vec2 ( 1.0,  1.0), 0.0).rgb;

    return sum * (1.0 / 16.0);
}

void main () {
    ivec2 texelCoord = ivec2 (gl_GlobalInvocationID.xy);
    ivec2 size = imageSize (outTex);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    vec2 uv = (vec2 (texelCoord) + 0.5) / vec2 (size);
    vec2 texel = params.radius / vec2 (textureSize (low, 0));

    vec3 bloom = tent (uv, texel);
    vec4 base = texelFetch (inputTex, texelCoord, 0);
    if (pc.level == 0u) {
        imageStore (outTex, texelCoord, vec4 (base.rgb + bloom * params.intensity, base.a));
    } else {
        imageStore (outTex, texelCoord, vec4 (base.rgb + bloom, 1.0));
    }
}
