#version 450 core

layout (local_size_x = 16, local_size_y = 16) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The blend of the frame with the history, linear light
layout (binding = 1) uniform sampler2D inputTex;

// The anti-aliasing (balder::scene::utils::post::taa::TaaEffect)
layout (binding = 2) uniform Params {
    // The weight of the frame and the clipping of the history (see the resolve)
    float blend;
    float clip;

    // The strength of the sharpening, 0 for none
    float sharpness;

    // 1 when the frame forgets the history
    uint reset;
} params;

// 0 to copy the blend into the history, 1 to sharpen it into the image of the stage
layout (push_constant) uniform Level {
    uint level;
} pc;

// The history, or the light read by the stage after it
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2D outTex;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the light of a texel of the blend, at the edge of the image for the texels past it
 */
vec3 lightAt (ivec2 texel, ivec2 size) {
    return texelFetch (inputTex, clamp (texel, ivec2 (0), size - 1), 0).rgb;
}

void main () {
    ivec2 texelCoord = ivec2 (gl_GlobalInvocationID.xy);
    ivec2 size = imageSize (outTex);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    vec4 light = texelFetch (inputTex, texelCoord, 0);
    if (pc.level == 0u || params.sharpness <= 0.0) {
        imageStore (outTex, texelCoord, light);
        return;
    }

    // an unsharp mask over the cross around the texel, kept between its darkest and its brightest texels so the edges
    // get no halo
    vec3 n = lightAt (texelCoord + ivec2 (0, -1), size);
    vec3 s = lightAt (texelCoord + ivec2 (0, 1), size);
    vec3 e = lightAt (texelCoord + ivec2 (1, 0), size);
    vec3 w = lightAt (texelCoord + ivec2 (-1, 0), size);

    vec3 sharp = light.rgb + params.sharpness * (4.0 * light.rgb - n - s - e - w);
    vec3 lo = min (light.rgb, min (min (n, s), min (e, w)));
    vec3 hi = max (light.rgb, max (max (n, s), max (e, w)));

    imageStore (outTex, texelCoord, vec4 (clamp (sharp, lo, hi), light.a));
}
