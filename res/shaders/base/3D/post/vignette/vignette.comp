#version 450 core

layout (local_size_x = 16, local_size_y = 16) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The light the camera sees at each texel, linear and unbounded, written by the pass before it
layout (binding = 1) uniform sampler2D inputTex;

// The vignette (balder::scene::utils::post::vignette::VignetteEffect)
layout (binding = 2) uniform Params {
    // The share of the light lost in the corners, from 0 (none) to 1 (black corners)
    float intensity;

    // The distance from the centre where the light starts to fall, 1 being a corner
    float radius;

    // The distance over which the light falls, from the radius
    float softness;
} params;

// The light darkened toward the edges of the image, still linear, read by the pass after it
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2D outTex;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

void main () {
    ivec2 texelCoord = ivec2 (gl_GlobalInvocationID.xy);
    ivec2 size = imageSize (outTex);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    // the distance from the centre, 1 in the corners whatever the aspect of the image
    vec2 centered = (vec2 (texelCoord) + 0.5) / vec2 (size) * 2.0 - 1.0;
    float dist = length (centered) / sqrt (2.0);

    float fall = smoothstep (params.radius, params.radius + max (params.softness, 1e-4), dist);
    vec4 light = texelFetch (inputTex, texelCoord, 0);

    imageStore (outTex, texelCoord, vec4 (light.rgb * (1.0 - params.intensity * fall), light.a));
}
