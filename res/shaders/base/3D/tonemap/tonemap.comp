#version 450 core

layout (local_size_x = 16, local_size_y = 16) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The light the camera sees at each texel, linear and unbounded, written by the pass before it
layout (binding = 1) uniform sampler2D radiance;

// The camera of the scene, its exposure after its matrices and its position
layout (binding = 2) uniform Camera {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    vec3 eyePos;

    // The exposure, in stops
    float exposure;
} camera;

// The operators of the tone mapping (balder::scene::utils::post::tonemap::operator::ToneMap)
const uint NONE = 0;
const uint ACES = 1;
const uint AGX  = 2;

layout (binding = 3) uniform ToneMap {
    uint operator;
} toneMap;

// The colours of the screen, encoded in sRGB: a storage image cannot be sRGB, the bytes are encoded here and written
// through a unorm view of the image, the screen sampling it through an sRGB view
layout (set = 0, binding = 0, rgba8) uniform writeonly image2D outTex;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          ACES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

// From sRGB to the working space of the RRT (AP1), with the saturation of the RRT folded in
const mat3 ACES_INPUT = mat3 (0.59719, 0.07600, 0.02840,
                              0.35458, 0.90834, 0.13383,
                              0.04823, 0.01566, 0.83777);

// From the output of the ODT back to sRGB
const mat3 ACES_OUTPUT = mat3 ( 1.60475, -0.10208, -0.00327,
                               -0.53108,  1.10813, -0.07276,
                               -0.07367, -0.00605,  1.07602);

/**
 * @returns: the colour of the screen of a light, through the RRT and the ODT of ACES (sRGB, 100 nits), the rational fit
 * of Stephen Hill (BakingLab)
 */
vec3 aces (vec3 color) {
    vec3 v = ACES_INPUT * color;
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;

    return ACES_OUTPUT * (a / b);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          AGX          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */

// From sRGB to the inset space of AgX, its primaries pulled toward white so the brightest colours desaturate
const mat3 AGX_INSET = mat3 (0.842479062253094, 0.0423282422610123, 0.0423756549057051,
                             0.0784335999999992, 0.878468636469772, 0.0784336,
                             0.0792237451477643, 0.0791661274605434, 0.879142973793104);

const mat3 AGX_OUTSET = mat3 ( 1.19687900512017, -0.0528968517574562, -0.0529716355144438,
                              -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
                              -0.0990297440797205, -0.0989611768448433, 1.15107367264116);

// The stops around the middle grey (0.18) the curve covers
const float AGX_MIN_EV = -12.47393;
const float AGX_MAX_EV = 4.026069;

/**
 * @returns: the colour of the screen of a light, through AgX (Troy Sobotka): its stops mapped by a sigmoid, fitted by a
 * polynomial (Benjamin Wrensch), then made linear again by the 2.2 power of a display
 */
vec3 agx (vec3 color) {
    vec3 v = AGX_INSET * color;
    v = clamp (log2 (max (v, vec3 (1e-10))), AGX_MIN_EV, AGX_MAX_EV);
    v = (v - AGX_MIN_EV) / (AGX_MAX_EV - AGX_MIN_EV);

    vec3 v2 = v * v;
    vec3 v4 = v2 * v2;
    v = 15.5 * v4 * v2 - 40.14 * v4 * v + 31.96 * v4 - 6.868 * v2 * v + 0.4298 * v2 + 0.1191 * v - 0.00232;

    return pow (max (AGX_OUTSET * v, vec3 (0.0)), vec3 (2.2));
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          SRGB          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: a linear colour, from 0 to 1, encoded in sRGB (IEC 61966-2-1)
 */
vec3 linearToSrgb (vec3 c) {
    return mix (c * 12.92, 1.055 * pow (c, vec3 (1.0 / 2.4)) - 0.055, step (vec3 (0.0031308), c));
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

void main () {
    ivec2 texelCoord = ivec2 (gl_GlobalInvocationID.xy);
    ivec2 size = imageSize (outTex);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    vec3 color = texelFetch (radiance, texelCoord, 0).rgb * exp2 (camera.exposure);
    if (toneMap.operator == ACES) {
        color = aces (color);
    } else if (toneMap.operator == AGX) {
        color = agx (color);
    }

    imageStore (outTex, texelCoord, vec4 (linearToSrgb (clamp (color, 0.0, 1.0)), 1.0));
}
