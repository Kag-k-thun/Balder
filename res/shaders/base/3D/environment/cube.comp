#version 450 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The environment, an equirectangular image of the whole sphere, its texels as the .hdr file stores them: a mantissa
// for each of red, green and blue, then the exponent they share (RGBE), the first row looking up
layout (binding = 1) uniform usampler2D source;

// The faces of the first level of the cube, in the order of the layers of a cube (+X, -X, +Y, -Y, +Z, -Z)
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2DArray outCube;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          SOURCE          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

const float PI = 3.14159265359;

// The largest value of a half float, the light of the brightest texels (the sun) clipped to it rather than infinite
const float HALF_MAX = 65000.0;

/**
 * @returns: the unit direction through the center of a texel of a face of a cube, each face seen from inside the cube,
 * its rows going down (the cube maps of Vulkan)
 * @params:
 *    - texel: the texel, its face in z
 *    - size: the number of texels on a side of a face
 */
vec3 cubeDirection (ivec3 texel, int size) {
    vec2 st = (vec2 (texel.xy) + 0.5) / float (size) * 2.0 - 1.0;
    vec3 d;
    switch (texel.z) {
        case 0  : d = vec3 (1.0, -st.y, -st.x); break;
        case 1  : d = vec3 (-1.0, -st.y, st.x); break;
        case 2  : d = vec3 (st.x, 1.0, st.y); break;
        case 3  : d = vec3 (st.x, -1.0, -st.y); break;
        case 4  : d = vec3 (st.x, -st.y, 1.0); break;
        default : d = vec3 (-st.x, -st.y, -1.0); break;
    }

    return normalize (d);
}

/**
 * @returns: the light of a texel of the source, its mantissas scaled by their exponent, wrapped around the vertical axis
 * and clamped at the poles
 */
vec3 sourceTexel (ivec2 t, ivec2 size) {
    t.x = (t.x % size.x + size.x) % size.x;
    t.y = clamp (t.y, 0, size.y - 1);

    uvec4 rgbe = texelFetch (source, t, 0);
    if (rgbe.a == 0u) {
        return vec3 (0.0);
    }

    return vec3 (rgbe.rgb) * exp2 (float (rgbe.a) - 136.0);
}

/**
 * @returns: the light of the source in a direction, filtered between the four texels around it (an integer image has no
 * filtering of its own)
 * @info: the longitude grows from -X to +Z around the vertical axis, the latitude from the top (+Y) to the bottom
 */
vec3 sampleSource (vec3 dir) {
    ivec2 size = textureSize (source, 0);
    vec2 uv = vec2 (atan (dir.z, dir.x) / (2.0 * PI) + 0.5, acos (clamp (dir.y, -1.0, 1.0)) / PI);

    vec2 pos = uv * vec2 (size) - 0.5;
    ivec2 base = ivec2 (floor (pos));
    vec2 f = pos - vec2 (base);

    vec3 top = mix (sourceTexel (base, size), sourceTexel (base + ivec2 (1, 0), size), f.x);
    vec3 bottom = mix (sourceTexel (base + ivec2 (0, 1), size), sourceTexel (base + ivec2 (1, 1), size), f.x);
    return mix (top, bottom, f.y);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

void main () {
    ivec3 texel = ivec3 (gl_GlobalInvocationID);
    ivec3 size = imageSize (outCube);
    if (texel.x >= size.x || texel.y >= size.y || texel.z >= 6) {
        return;
    }

    vec3 light = sampleSource (cubeDirection (texel, size.x));
    imageStore (outCube, texel, vec4 (min (light, vec3 (HALF_MAX)), 1.0));
}
