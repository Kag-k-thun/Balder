#version 450 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The environment as a cube, and its levels
layout (binding = 1) uniform samplerCube environment;

// The faces of the irradiance, the light a white diffuse surface facing each direction reflects
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2DArray outCube;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          CONSTANTS          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

const float PI = 3.14159265359;

// The steps of the integration over the hemisphere around a normal, around it and from it to the horizon
const uint PHI_STEPS = 128;
const uint THETA_STEPS = 32;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          GEOMETRY          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the unit direction through the center of a texel of a face of a cube, each face seen from inside the cube,
 * its rows going down (the cube maps of Vulkan)
 * @params:
 *    - texel: the texel, its face in z
 *    - size: the number of texels on a side of a face
 */
vec3 cubeDirection (ivec3 texel, int size) {
    vec2 st = (vec2 (texel.xy) + 0.5) / float (size) * 2.0 - 1.0;
    vec3 d;
    switch (texel.z) {
        case 0  : d = vec3 (1.0, -st.y, -st.x); break;
        case 1  : d = vec3 (-1.0, -st.y, st.x); break;
        case 2  : d = vec3 (st.x, 1.0, st.y); break;
        case 3  : d = vec3 (st.x, -1.0, -st.y); break;
        case 4  : d = vec3 (st.x, -st.y, 1.0); break;
        default : d = vec3 (-st.x, -st.y, -1.0); break;
    }

    return normalize (d);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * The irradiance in the direction N, divided by PI: the light of the environment over the hemisphere around N weighed by
 * the cosine to N, integrated in steps of its spherical coordinates (the sine of the latitude being the area of a step),
 * so a white diffuse surface lit by an environment of a uniform light reflects that light
 * @info: the environment is read at the level whose texels are as large as a step, so the light between the steps is
 * not missed
 */
void main () {
    ivec3 texel = ivec3 (gl_GlobalInvocationID);
    ivec3 size = imageSize (outCube);
    if (texel.x >= size.x || texel.y >= size.y || texel.z >= 6) {
        return;
    }

    vec3 N = cubeDirection (texel, size.x);
    vec3 up = abs (N.y) < 0.999 ? vec3 (0.0, 1.0, 0.0) : vec3 (1.0, 0.0, 0.0);
    vec3 T = normalize (cross (up, N));
    vec3 B = cross (N, T);

    float dPhi = 2.0 * PI / float (PHI_STEPS);
    float dTheta = 0.5 * PI / float (THETA_STEPS);
    float lod = max (log2 (float (textureSize (environment, 0).x) / float (THETA_STEPS)), 0.0);

    vec3 sum = vec3 (0.0);
    for (uint p = 0 ; p < PHI_STEPS ; p++) {
        float phi = (float (p) + 0.5) * dPhi;
        vec3 around = cos (phi) * T + sin (phi) * B;

        for (uint t = 0 ; t < THETA_STEPS ; t++) {
            float theta = (float (t) + 0.5) * dTheta;
            vec3 dir = sin (theta) * around + cos (theta) * N;
            sum += textureLod (environment, dir, lod).rgb * cos (theta) * sin (theta);
        }
    }

    vec3 irradiance = PI * sum / float (PHI_STEPS * THETA_STEPS);
    imageStore (outCube, texel, vec4 (irradiance, 1.0));
}
