#version 450 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

// The faces of a level of the cube, written from the level before it
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2DArray outCube;

// The faces of the level before it, twice as large
layout (set = 0, binding = 1, rgba16f) uniform readonly image2DArray inCube;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Each texel of the level is the average of the 2x2 texels of the level before it it covers, so the light of the
 * environment is kept from a level to the next
 */
void main () {
    ivec3 texel = ivec3 (gl_GlobalInvocationID);
    ivec3 size = imageSize (outCube);
    if (texel.x >= size.x || texel.y >= size.y || texel.z >= 6) {
        return;
    }

    ivec2 last = imageSize (inCube).xy - 1;
    ivec2 base = texel.xy * 2;

    vec3 sum = vec3 (0.0);
    for (int i = 0 ; i < 4 ; i++) {
        ivec2 t = min (base + ivec2 (i & 1, i >> 1), last);
        sum += imageLoad (inCube, ivec3 (t, texel.z)).rgb;
    }

    imageStore (outCube, texel, vec4 (sum * 0.25, 1.0));
}
