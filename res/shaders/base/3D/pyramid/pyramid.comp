#version 450 core

// The reduction of a level of the depth pyramid into the next one, each texel written the largest depth of the 2x2
// texels it covers in the level read, clamped at its edges (see balder::scene::utils::pyramid::layout); dispatched once
// per level, the first one reading the depth of the deferred pass

layout (local_size_x = 8, local_size_y = 8) in;

layout (set = 0, binding = 0) uniform sampler2D depth;

// The levels of the pyramid, from the level 1, row by row
layout (std430, set = 0, binding = 1) buffer Pyramid {
    float texels [];
};

layout (push_constant) uniform Push {
    // The first texel of the level read and of the level written
    uint srcOffset;
    uint dstOffset;

    // The size of the level read
    uint srcWidth;
    uint srcHeight;

    // The size of the level written
    uint dstWidth;
    uint dstHeight;

    // 1 when the level read is the depth, 0 when it is a level of the pyramid
    uint fromDepth;
    uint pad;
} push;

float source (uint x, uint y) {
    uint cx = min (x, push.srcWidth - 1u);
    uint cy = min (y, push.srcHeight - 1u);
    if (push.fromDepth != 0u) return texelFetch (depth, ivec2 (cx, cy), 0).r;

    return texels [push.srcOffset + cy * push.srcWidth + cx];
}

void main () {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= push.dstWidth || p.y >= push.dstHeight) return;

    uint x = 2u * p.x;
    uint y = 2u * p.y;
    float d = max (max (source (x, y), source (x + 1u, y)), max (source (x, y + 1u), source (x + 1u, y + 1u)));

    texels [push.dstOffset + p.y * push.dstWidth + p.x] = d;
}
