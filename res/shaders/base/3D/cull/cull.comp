#version 450 core

// The cull pass of the draws of a batch of the 3D shaders (see InstanceBatch), culling them cluster by cluster, a
// cluster being a run of a fixed number of triangles of a level of detail of a mesh (see buildClusters):
//    - phase 0, one thread per candidate: the candidates whose object the camera sees (its world box in the frustum and
//      not smaller on screen than the threshold) are listed, and the size of the dispatch of their clusters counted
//    - phase 1, dispatched indirectly, one workgroup per candidate listed, its threads striding over its clusters: the
//      clusters the camera sees (their world box in the frustum, a front face possibly facing it) are written as one
//      command each, with the word of their instance, counted by the counter of the first draw indirect count call;
//      when the occluded clusters are culled, only those the last pass found visible are
//    - phase 2, the same dispatch once the clusters of phase 1 are drawn and their depth reduced into the depth pyramid:
//      the clusters the camera sees that are not hidden behind that depth are visible, kept for the next pass; those
//      phase 1 did not draw are written after the capacity of phase 1, counted by the counter of the second call
// The frustum test is the one of the culling on the CPU (Frustum::classify, ViewVolume::pixelSize), its reference

layout (local_size_x = 64) in;

layout (set = 1, binding = 0) uniform Camera {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    vec3 eyePos;
} camera;

// The levels of the depth pyramid of the frame, each texel the farthest depth of the texels it covers, from the level 1
// (see balder::scene::utils::pyramid::layout); bound when the occluded clusters are culled only
layout (std430, set = 1, binding = 1) readonly buffer Pyramid {
    float texels [];
} pyramid;

// The data of an object, in the slot given by the words of its instances (see the draws of IndexedMesh3D)
struct Object {
    mat4 model;
    float fade;
    uint material;

    // The center and the half size along each axis of the box enclosing the object in world space, the extent being
    // negative when the box is empty
    vec4 boxCenter;
    vec4 boxExtent;

    // The world the frame before drew the object with, read by the g-buffer
    mat4 previousModel;
};

layout (std430, set = 0, binding = 0) readonly buffer Objects {
    Object objects [];
};

// A candidate, a draw laid out: the word of its instance (the slot of its object above the two low bits), the range of
// its clusters (none when it draws nothing), and the first word of the visibility of its clusters
struct Candidate {
    uint word;
    uint firstCluster;
    uint clusterCount;
    uint visibility;
};

layout (std430, set = 0, binding = 1) readonly buffer Draws {
    Candidate draws [];
};

// A cluster of a geometry of the pool (see ClusterSlot)
struct Cluster {
    // The center and the half size of the box of the cluster, in the space of the positions of its mesh
    vec4 center;
    vec4 extent;

    // The axis of the cone of the normals of the cluster, and in w the sine of the widest angle between them, above 1
    // when its back faces are not culled
    vec4 cone;

    uint firstIndex;
    uint indexCount;
    int vertexOffset;
    uint pad;
};

layout (std430, set = 0, binding = 2) readonly buffer Clusters {
    Cluster clusters [];
};

// Cleared before the pass
layout (std430, set = 0, binding = 3) buffer Counters {
    // The commands written by phase 1, read by the first draw indirect count call
    uint drawCount;

    // The triangles drawn by the commands written by phase 1
    uint triangleCount;

    // The commands written by phase 2, read by the second draw indirect count call
    uint lateDrawCount;

    // The triangles drawn by the commands written by phase 2
    uint lateTriangleCount;

    // The candidates listed by phase 0
    uint listed;

    // The size of the indirect dispatch of phases 1 and 2, a workgroup per candidate listed
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;

    // The candidates listed by phase 0
    uint candidates [];
} counters;

// A VkDrawIndexedIndirectCommand
struct Command {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

// The commands of phase 1, then those of phase 2 from the index 'capacity'
layout (std430, set = 0, binding = 4) writeonly buffer Commands {
    Command commands [];
};

// Two words per command, from its first instance: the word of its instance, read by the vertex shaders at their instance
// index, then the slot of its cluster marked by CLUSTER_DRAW, read by the debug views of the g-buffer
layout (std430, set = 0, binding = 5) writeonly buffer Instances {
    uint instances [];
};

// The visibility of each cluster of each candidate at the last pass culling the occluded clusters, 0 when it was culled
layout (std430, set = 0, binding = 6) buffer Visibility {
    uint visible [];
};

layout (push_constant) uniform Push {
    // The number of candidates
    uint count;

    // 0 to list the candidates seen, 1 to cull their clusters, 2 to cull them against the depth pyramid
    uint phase;

    // The height of the view, in pixels
    float height;

    // The size on screen in pixels under which an object is culled, 0 to cull the objects outside the view only
    float minPixels;

    // The width of the view, in pixels
    float width;

    // The number of levels of the depth pyramid, 0 when the occluded clusters are not culled
    uint levels;

    // The number of clusters each phase culls at most, the commands of phase 2 following as many of phase 1
    uint capacity;

    uint pad;
} push;

// The largest number of workgroups of a dimension of a dispatch (maxComputeWorkGroupCount, at least that much)
const uint MAX_GROUPS = 65535u;

// The largest ratio between two scales of a world under which the cone of the normals of a cluster is turned with it
const float UNIFORM_SCALE = 1.001;

// The mark of the second word of the instance of a command drawing a cluster, never set in the word of an instance
const uint CLUSTER_DRAW = 0x80000000u;

/**
 * @returns: true iif a part of the box may be in the frustum of the camera
 * */
bool inFrustum (vec3 center, vec3 extent) {
    if (any (lessThan (extent, vec3 (0.0)))) return false;

    // the rows of the projection by the view, the planes of the frustum facing its inside (Gribb–Hartmann)
    mat4 rows = transpose (camera.viewProj);
    vec4 planes [6] = vec4 [6] (rows [3] + rows [0], rows [3] - rows [0],
                                rows [3] + rows [1], rows [3] - rows [1],
                                rows [3] + rows [2], rows [3] - rows [2]);

    for (int i = 0; i < 6; i++) {
        float len = length (planes [i].xyz);
        float d = (dot (planes [i].xyz, center) + planes [i].w) / len;
        float r = dot (abs (planes [i].xyz), extent) / len;
        if (d < -r) return false;
    }

    return true;
}

/**
 * @returns: true iif the box is smaller on screen than the threshold: the diameter of the box seen at the depth of its
 * point closest to the eye, the box reaching the plane of the eye being large
 * */
bool tooSmall (vec3 center, vec3 extent) {
    if (push.minPixels <= 0.0) return false;

    mat4 rows = transpose (camera.viewProj);
    float w = dot (rows [3].xyz, center) + rows [3].w - dot (abs (rows [3].xyz), extent);
    if (w <= 0.0) return false;

    float pixelScale = length (rows [1].xyz) * push.height / 2.0;
    return 2.0 * length (extent) * (pixelScale / w) < push.minPixels;
}

/**
 * @returns: true iif the eye sees only back faces of a cluster: the direction from the eye to the sphere of the cluster
 * stays within the cone of its normals widened by 90 degrees (the cone test of meshoptimizer)
 * @params:
 *    - center: the center of the sphere of the cluster, in world space
 *    - radius: the radius of the sphere
 *    - axis: the axis of the cone in world space
 *    - cutoff: the sine of the widest angle between the axis and a normal
 * */
bool backFacing (vec3 center, float radius, vec3 axis, float cutoff) {
    vec3 toCluster = center - camera.eyePos;
    return dot (toCluster, axis) >= cutoff * length (toCluster) + radius;
}

/**
 * @returns: the farthest depth of the texel (x, y) of the level 'level' of the depth pyramid, (x, y) being clamped to the
 * level
 * */
float farthest (uint level, uint x, uint y) {
    uint w = uint (push.width);
    uint h = uint (push.height);
    uint offset = 0u;
    for (uint k = 1u; k < level; k++) {
        w = max ((w + 1u) / 2u, 1u);
        h = max ((h + 1u) / 2u, 1u);
        offset += w * h;
    }

    w = max ((w + 1u) / 2u, 1u);
    h = max ((h + 1u) / 2u, 1u);
    return pyramid.texels [offset + min (y, h - 1u) * w + min (x, w - 1u)];
}

/**
 * @returns: true iif the box lies behind the depth of the pyramid: its closest depth is farther than the farthest depth
 * of the texels covering its rect on screen, at the level where they are 2x2 at most
 * @assume: the camera sees the box
 * */
bool occluded (vec3 center, vec3 extent) {
    vec2 lo = vec2 (1.0);
    vec2 hi = vec2 (-1.0);
    float closest = 1.0;
    for (int i = 0; i < 8; i++) {
        vec3 corner = center + extent * vec3 ((i & 1) == 0 ? -1.0 : 1.0,
                                              (i & 2) == 0 ? -1.0 : 1.0,
                                              (i & 4) == 0 ? -1.0 : 1.0);
        vec4 clip = camera.viewProj * vec4 (corner, 1.0);

        // a box reaching the plane of the eye is not tested
        if (clip.w <= 0.0) return false;

        vec3 ndc = clip.xyz / clip.w;
        lo = min (lo, ndc.xy);
        hi = max (hi, ndc.xy);
        closest = min (closest, ndc.z);
    }

    // a box reaching the near plane is not tested
    if (closest <= 0.0) return false;

    // the rect of the box in texels of the depth
    vec2 size = vec2 (push.width, push.height);
    uvec2 p0 = uvec2 (clamp ((lo * 0.5 + 0.5) * size, vec2 (0.0), size - 1.0));
    uvec2 p1 = uvec2 (clamp ((hi * 0.5 + 0.5) * size, vec2 (0.0), size - 1.0));

    // the level whose texels covering the rect are 2x2 at most (see layout::levelOf)
    uint extentTexels = max (p1.x - p0.x, p1.y - p0.y) + 1u;
    uint level = 1u;
    while ((1u << level) < extentTexels) level++;
    level = min (level, push.levels);

    uvec2 t0 = p0 >> level;
    uvec2 t1 = p1 >> level;
    float depth = max (max (farthest (level, t0.x, t0.y), farthest (level, t1.x, t0.y)),
                       max (farthest (level, t0.x, t1.y), farthest (level, t1.x, t1.y)));

    return closest > depth;
}

/**
 * Write the command drawing a cluster seen, the word of its instance and the slot of the cluster, after those written
 * before by the phase
 * */
void append (Cluster cluster, uint slot, uint word, bool late) {
    uint written = late ? atomicAdd (counters.lateDrawCount, 1u) : atomicAdd (counters.drawCount, 1u);
    if (late) {
        atomicAdd (counters.lateTriangleCount, cluster.indexCount / 3u);
    } else {
        atomicAdd (counters.triangleCount, cluster.indexCount / 3u);
    }

    uint index = late ? push.capacity + written : written;
    commands [index] = Command (cluster.indexCount, 1u, cluster.firstIndex, cluster.vertexOffset, 2u * index);
    instances [2u * index] = word;
    instances [2u * index + 1u] = slot | CLUSTER_DRAW;
}

/**
 * List a candidate whose object the camera sees, the dispatch of the clusters growing to cover it
 * */
void listObject (uint index) {
    Candidate candidate = draws [index];
    if (candidate.clusterCount == 0u) return;

    Object object = objects [candidate.word >> 2];
    vec3 center = object.boxCenter.xyz;
    vec3 extent = object.boxExtent.xyz;
    if (!inFrustum (center, extent) || tooSmall (center, extent)) return;

    uint slot = atomicAdd (counters.listed, 1u);
    counters.candidates [slot] = index;

    // a workgroup per candidate listed, in rows of MAX_GROUPS
    atomicMax (counters.dispatchX, min (slot + 1u, MAX_GROUPS));
    atomicMax (counters.dispatchY, slot / MAX_GROUPS + 1u);
    atomicMax (counters.dispatchZ, 1u);
}

/**
 * Cull the clusters of a candidate listed by phase 0, the threads of the workgroup striding over them
 * */
void cullClusters (uint index, bool late) {
    Candidate candidate = draws [index];
    mat4 model = objects [candidate.word >> 2].model;
    mat3 linear = mat3 (model);

    // the normals of the triangles turn with the cofactor of the world, which keeps their side under a mirror; the cone
    // keeps its angle under a uniform scale only
    mat3 cofactor = mat3 (cross (linear [1], linear [2]), cross (linear [2], linear [0]), cross (linear [0], linear [1]));
    vec3 scales = vec3 (length (linear [0]), length (linear [1]), length (linear [2]));
    bool cones = max (scales.x, max (scales.y, scales.z)) <= UNIFORM_SCALE * min (scales.x, min (scales.y, scales.z));

    for (uint i = gl_LocalInvocationID.x; i < candidate.clusterCount; i += gl_WorkGroupSize.x) {
        Cluster cluster = clusters [candidate.firstCluster + i];

        // the world box of the cluster
        vec3 center = (model * vec4 (cluster.center.xyz, 1.0)).xyz;
        vec3 extent = abs (linear [0]) * cluster.extent.x + abs (linear [1]) * cluster.extent.y + abs (linear [2]) * cluster.extent.z;

        bool seen = inFrustum (center, extent);
        if (seen && cones && cluster.cone.w <= 1.0) {
            seen = !backFacing (center, length (extent), normalize (cofactor * cluster.cone.xyz), cluster.cone.w);
        }

        uint v = candidate.visibility + i;
        if (!late) {
            // the clusters the last pass did not see are tested against the depth pyramid by phase 2
            if (push.levels != 0u && visible [v] == 0u) continue;
            if (seen) append (cluster, candidate.firstCluster + i, candidate.word, false);
        } else {
            // the test of phase 1, the cluster being the only one reading and writing its visibility
            bool early = seen && visible [v] != 0u;
            bool now = seen && !occluded (center, extent);

            visible [v] = now ? 1u : 0u;
            if (now && !early) append (cluster, candidate.firstCluster + i, candidate.word, true);
        }
    }
}

void main () {
    if (push.phase == 0u) {
        uint index = gl_GlobalInvocationID.x;
        if (index < push.count) listObject (index);
        return;
    }

    uint slot = gl_WorkGroupID.y * MAX_GROUPS + gl_WorkGroupID.x;
    if (slot >= counters.listed) return;

    cullClusters (counters.candidates [slot], push.phase == 2u);
}
