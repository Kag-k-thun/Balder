#version 450 core

layout (local_size_x = 32, local_size_y = 32) in;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          STRUCTS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

struct Material {
    vec3 diffuse;
    vec3 ambient;
    vec3 specular;
    vec3 emissive;
    vec3 transparent;

    int model;
    int anisotropy;
    
    float illum;
    float shininess;
    float opacity;
    float refraction;    
};

// A direction light, shining along its direction from infinitely far (DirectionLightContent)
struct DirectionLight {
    // The unit direction the light shines along, in world space
    vec3 direction;

    // The illuminance of a surface facing the light, scaling its colour
    float intensity;

    vec3 color;
    float padd;
};

// A point light, shining all around its position up to its range (PointLightContent)
struct PointLight {
    vec3 position;

    // The distance from the light at which its light fades out
    float range;

    vec3 color;

    // The intensity of the light, scaling its colour, the illuminance of a surface facing it at a distance d being
    // divided by d²
    float intensity;
};

// A spot light, shining from its position along its direction up to its range, in a cone (SpotLightContent)
struct SpotLight {
    vec3 position;
    float range;

    vec3 direction;
    float intensity;

    vec3 color;

    // The cosines of the angles between the axis of the cone and the edges of its full light and of its light
    float cosInner;
    float cosOuter;

    float padd1;
    float padd2;
    float padd3;
};

struct CameraContent {
    mat4 proj;
    mat4 view;
    mat4 viewProj;
    vec3 eyePos;  
};

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          BINDINGS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

layout (binding = 1) uniform sampler2D normals;
layout (binding = 2) uniform sampler2D albedo;
layout (binding = 3) uniform sampler2D depth;
layout (binding = 4) uniform usampler2D materialID;

// The cascades of the shadow map of the direction light casting shadows, side by side in a 2x2 atlas, the first one at
// the top left: a lookup gives the fraction of the four texels around a point whose depth is not closer to the light
// than the depth it is compared to
layout (binding = 5) uniform sampler2DShadow shadowMap;

// The number of cascades of the shadow map, the size of the array below
const uint CASCADES = 4;

// A cascade of the shadow map, seeing a slice of the view of the camera from the light, its block (256 bytes) being the
// camera the shadow pipelines read
struct Cascade {
    // From world space to the clip space of the cascade, its depth in [0, 1] growing away from the light
    mat4 proj;
    mat4 view;
    mat4 viewProj;

    // .x: the size of a texel of the cascade, in world units
    vec4 info;

    vec4 padding [3];
};

// The cascades of the shadow map, written at once with the cameras the shadow pipelines drew them with
layout (binding = 6) uniform Shadow {
    Cascade cascades [CASCADES];

    // The number of cascades, 0 when no light casts shadows
    uint count;

    // The index of the direction light casting the shadows
    uint light;

    // The offset of the point looked up along its normal, in texels of its cascade, so a surface does not shadow itself
    float normalOffset;

    // The bias of the depth compared to the shadow map, in the depth of the cascades
    float bias;
} shadow;

layout (binding = 7) uniform Camera {
    CameraContent camera;
};

layout(std430, binding = 8) readonly buffer Materials {
    Material materials[];
};

layout (std430, binding = 9) readonly buffer Directions {
    uint nbLights;
    DirectionLight lights[];
} directionLights;

layout (std430, binding = 10) readonly buffer Points {
    uint nbLights;
    PointLight lights[];
} pointLights;

layout (std430, binding = 11) readonly buffer Spots {
    uint nbLights;
    SpotLight lights[];
} spotLights;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          OUTPUT          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

layout (set = 0, binding = 0, rgba8) uniform image2D outTex;


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          NORMAL          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the unit direction a normal of the g-buffer was folded from, the lower half of the octahedron folded back
 * from the corners of the square
 */
vec3 octDecode (vec2 e) {
    vec3 n = vec3 (e, 1.0 - abs (e.x) - abs (e.y));
    float t = max (-n.z, 0.0);
    n.xy += vec2 (n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize (n);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          POSITION          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the position of the point seen at a texel, in world space, rebuilt from the depth the g-buffer holds there
 * @info: the projections of the cameras (perspective or orthographic) leave the x and y of the view out of the depth and
 * of w, so the depth of the view is solved first, then its x and y; the view of the camera is a rotation and a
 * translation, inverted without inverting the matrix
 * @params:
 *    - ndc: the center of the texel, in normalized device coordinates
 *    - d: the depth of the texel
 */
vec3 worldPosition (vec2 ndc, float d) {
    mat4 p = camera.proj;
    float z = (p [3][2] - d * p [3][3]) / (d * p [2][3] - p [2][2]);
    float w = p [2][3] * z + p [3][3];
    vec2 xy = (ndc * w - vec2 (p [2][0], p [2][1]) * z - vec2 (p [3][0], p [3][1])) / vec2 (p [0][0], p [1][1]);

    mat3 rotation = mat3 (camera.view);
    return transpose (rotation) * (vec3 (xy, z) - camera.view [3].xyz);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          METALLIC          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


vec3 shadeMetallic (vec3 N, vec3 V, vec3 L, vec3 albedo, float roughness) {
    // Termes de base
    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);

    // Fresnel de Schlick simplifié
    vec3 F0 = albedo; // pour un métal, F0 = couleur du métal
    float VoH = max(dot(V, normalize(V + L)), 0.0);
    vec3 F = F0 + (1.0 - F0) * pow(1.0 - VoH, 5.0);

    // Distribution GGX simplifiée
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, normalize(V + L)), 0.0);
    float denom = (NdotH * NdotH) * (a2 - 1.0) + 1.0;
    float D = a2 / (3.14159 * denom * denom);

    // Géométrie Smith simplifiée
    float k = (roughness + 1.0);
    k = (k * k) / 8.0;
    float Gv = NdotV / (NdotV * (1.0 - k) + k);
    float Gl = NdotL / (NdotL * (1.0 - k) + k);
    float G = Gv * Gl;

    // BRDF spéculaire
    vec3 spec = (D * F * G) / max(4.0 * NdotL * NdotV, 0.001);

    // Pas de diffuse pour un métal pur
    return spec * NdotL;
}


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          LIGHTS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the light a point reflects toward the eye, lit from a direction, its diffuse and its specular reflections
 * @params:
 *    - N: the unit normal of the surface at the point
 *    - V: the unit direction from the point to the eye
 *    - L: the unit direction from the point to the light
 *    - radiance: the light reaching the point, the colour of the light times its intensity and its attenuation
 *    - mat: the material of the surface
 *    - baseColor: the colour of the surface at the point
 */
vec3 shade (vec3 N, vec3 V, vec3 L, vec3 radiance, Material mat, vec3 baseColor) {
    vec3 diffuse = baseColor * mat.diffuse * max (dot (N, L), 0.0);
    vec3 specular = shadeMetallic (N, V, L, baseColor * mat.specular, mat.shininess);

    return (diffuse + specular) * radiance;
}

/**
 * @returns: the share of the intensity of a point or a spot light reaching a point at a distance, its inverse square
 * windowed to fade out smoothly to 0 at the range of the light
 * @info: the inverse square is 1 / (d² + 1), bounded close to the light (the falloff of Real Shading in Unreal Engine 4)
 * @params:
 *    - d: the distance from the light to the point
 *    - range: the range of the light
 */
float attenuation (float d, float range) {
    float r = d / range;
    float window = clamp (1.0 - r * r * r * r, 0.0, 1.0);

    return window * window / (d * d + 1.0);
}

/**
 * @returns: the share of the light of a spot light reaching a point in the direction of its cone, 1 inside its full
 * light, 0 outside its light, fading out smoothly between them
 * @params:
 *    - light: the spot light
 *    - L: the unit direction from the point to the light
 */
float cone (SpotLight light, vec3 L) {
    return smoothstep (light.cosOuter, light.cosInner, dot (-L, light.direction));
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          SHADOW          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the fraction of the light of the direction light casting shadows reaching a point, 1 out of the cascades
 * @info: the point is looked up in the first cascade holding it, the finest; the cascades are fitted at the ticks of
 * the scene, so they may hold the view of the camera of an earlier tick, a point out of the finest being found in a
 * larger one
 * @info: the point is moved along its normal by a few texels of its cascade, and its depth biased, so the surface it
 * lies on does not shadow itself (acne); the 3x3 lookups around it, each filtering four texels, soften the edges of the
 * shadows (percentage closer filtering)
 * @params:
 *    - world: the point, in world space
 *    - normal: the normal of the surface at the point
 */
float shadowFactor (vec3 world, vec3 normal) {
    vec3 n = normalize (normal);

    // a cascade covers a quarter of the atlas, the lookups of a point reading the texels around it, inside its tile
    float texel = 2.0 / float (textureSize (shadowMap, 0).x);
    float margin = texel * 1.5;

    for (uint c = 0 ; c < shadow.count ; c++) {
        vec3 p = world + n * shadow.cascades [c].info.x * shadow.normalOffset;
        vec4 clip = shadow.cascades [c].viewProj * vec4 (p, 1.0);
        vec2 uv = clip.xy * 0.5 + 0.5;
        if (any (lessThan (uv, vec2 (margin))) || any (greaterThan (uv, vec2 (1.0 - margin))) || clip.z > 1.0) {
            continue;
        }

        vec2 tile = vec2 (float (c & 1u), float (c >> 1u));
        float depth = clip.z - shadow.bias;

        float lit = 0.0;
        for (int x = -1 ; x <= 1 ; x++) {
            for (int y = -1 ; y <= 1 ; y++) {
                lit += texture (shadowMap, vec3 ((tile + uv + vec2 (x, y) * texel) * 0.5, depth));
            }
        }

        return lit / 9.0;
    }

    return 1.0;
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAIN          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

void main () {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outTex);

    if(texelCoord.x < size.x && texelCoord.y < size.y)
        {                
            vec3 color = vec3 (0);

            // the g-buffer has the size of the output, its texels read as they were written, never filtered; the depth
            // was written with the camera of this frame, the one bound here
            vec2 ndc = (vec2 (texelCoord) + 0.5) / vec2 (size) * 2.0 - 1.0;
            vec3 position = worldPosition (ndc, texelFetch (depth, texelCoord, 0).x);
            vec3 normal = octDecode (texelFetch (normals, texelCoord, 0).xy);
            vec3 baseColor = texelFetch (albedo, texelCoord, 0).xyz;
        
            uint matID = texelFetch (materialID, texelCoord, 0).x;
            Material mat = materials [matID];

            vec3 view = normalize (camera.eyePos - position);

            for (uint i = 0 ; i < directionLights.nbLights ; i++) {
                DirectionLight light = directionLights.lights [i];

                float lit = 1.0;
                if (shadow.count != 0 && i == shadow.light) {
                    lit = shadowFactor (position, normal);
                }

                color += shade (normal, view, -light.direction, light.color * light.intensity * lit, mat, baseColor);
            }

            for (uint i = 0 ; i < pointLights.nbLights ; i++) {
                PointLight light = pointLights.lights [i];

                vec3 toLight = light.position - position;
                float d = length (toLight);
                if (d >= light.range) {
                    continue;
                }

                vec3 L = toLight / max (d, 1e-4);
                color += shade (normal, view, L, light.color * light.intensity * attenuation (d, light.range), mat, baseColor);
            }

            for (uint i = 0 ; i < spotLights.nbLights ; i++) {
                SpotLight light = spotLights.lights [i];

                vec3 toLight = light.position - position;
                float d = length (toLight);
                if (d >= light.range) {
                    continue;
                }

                vec3 L = toLight / max (d, 1e-4);
                float share = attenuation (d, light.range) * cone (light, L);
                color += shade (normal, view, L, light.color * light.intensity * share, mat, baseColor);
            }

            imageStore (outTex, texelCoord, vec4 (color, 1.0));
        }    
}
