// The look of the dialogs of Balder, in a window of their own or in an overlay over the interface of the caller. The
// .gui files of the dialogs load it at the origin of the components: every sheet of the application wins over it, and
// its rules select the widgets of the dialogs only, of the classes dialog-…, under their root of the class dialog

$backdrop: #000000 / 60%;
$surface: #202328;
$field: #17191d;
$button: #2a2e34;
$edge: #4a5259;
$text: #eeeff2;
$muted: #9aa3ab;
$accent: #4c98fd;
$font: "Noto Sans", sans-serif;

// The backdrop of the overlays, greying out the interface under the dialog
Overlay {
    background-color: $backdrop;
}

LinearLayout.dialog {
    background-color: $surface;
    border: 1 $edge;
    radius: 8;
    shadow: 0 8 24 #00000099;
    padding: 18;
    min-width: 360;
    max-width: 640;
    text-color: $text;
    font-family: $font;
    font-size: 15;
}

.dialog Label.dialog-question {
    font-size: 18;
    text-wrap: wrap;
    text-xalign: center;
    margin-bottom: 18;
}

// the padding leaves room for the focus rings of the buttons
.dialog LinearLayout.dialog-buttons {
    background-color: transparent;
    direction: row;
    padding: 3;
}

.dialog Box.dialog-fill {
    background-color: transparent;
    border-color: transparent;
    flex: 1;
}

.dialog PushButton.dialog-accept, .dialog PushButton.dialog-cancel {
    background-color: $button;
    border: 1 $edge;
    radius: 6;
    padding: 6 18;
    margin-left: 10;
    min-width: 96;
}

.dialog PushButton.dialog-accept {
    background-color: #1f4f8f;
    border-color: $accent;
}

.dialog PushButton.dialog-accept:hover { background-color: #2a64b0; }
.dialog PushButton.dialog-cancel:hover { background-color: #3a3f46; }
.dialog PushButton.dialog-accept:focus, .dialog PushButton.dialog-cancel:focus { shadow: 0 0 0 2 $accent; }

// The rows of the file dialog and of the colour dialog: a caption or a tool, then an input
.dialog LinearLayout.dialog-row {
    background-color: transparent;
    direction: row;
    padding: 3;
    margin-bottom: 8;
}

.dialog Label.dialog-caption {
    text-color: $muted;
    text-xalign: left;
    width: 64;
}

.dialog PushButton.dialog-tool {
    background-color: $button;
    border: 1 $edge;
    radius: 6;
    padding: 4 14;
    margin-right: 8;
}

.dialog PushButton.dialog-tool:hover { background-color: #3a3f46; }
.dialog PushButton.dialog-tool:focus { shadow: 0 0 0 2 $accent; }

.dialog InputText.dialog-input {
    background-color: $field;
    border: 1 $edge;
    radius: 6;
    padding: 4 8;
    text-xalign: left;
    flex: 1;
}

.dialog InputText.dialog-input:focus { border-color: $accent; }

.dialog Label.dialog-error {
    text-color: #ff8a8a;
    text-xalign: left;
    font-size: 13;
    margin-bottom: 4;
}

.dialog CheckBox.dialog-check {
    background-color: transparent;
    text-xalign: left;
}

.dialog CheckBox.dialog-check::box {
    background-color: $field;
    border: 1 $edge;
    radius: 3;
    margin-right: 6;
}

.dialog CheckBox.dialog-check::mark {
    background-color: transparent;
    radius: 2;
    margin: 3;
}

.dialog CheckBox.dialog-check:checked::mark { background-color: $accent; }
.dialog CheckBox.dialog-check:focus::box { border-color: $accent; }

// The file dialog fills most of the window it is shown over
LinearLayout.dialog.dialog-file {
    width: 75%;
    height: 80%;
    max-width: none;
}

.dialog TableView.dialog-entries {
    background-color: $field;
    border: 1 $edge;
    radius: 6;
    padding: 2 12 12 2;
    margin: 3 3 8 3;
    flex: 1;
    min-height: 120;
}

.dialog TableView.dialog-entries:focus { border-color: $accent; }

.dialog TableView.dialog-entries::header {
    background-color: $surface;
    border-width: 0 0 1 0;
    border-color: $edge;
    text-color: $muted;
    font-weight: bold;
    font-size: 13;
    text-xalign: left;
    padding: 5 10;
}

.dialog TableView.dialog-entries::header:hover { text-color: $text; }
.dialog TableView.dialog-entries::header:ascending, .dialog TableView.dialog-entries::header:descending { text-color: $accent; }

.dialog TableView.dialog-entries::row {
    background-color: transparent;
    border: 1 transparent;
    radius: 4;
}

.dialog TableView.dialog-entries::row:hover { background-color: $button; }
.dialog TableView.dialog-entries::row:selected { background-color: #1f4f8f; }
.dialog TableView.dialog-entries:focus::row:current { border-color: $accent; }

.dialog TableView.dialog-entries::cell {
    background-color: transparent;
    border: 0 transparent;
    text-xalign: left;
    padding: 3 10;
}

.dialog TableView.dialog-entries::scrollbar {
    background-color: $edge;
    width: 8;
    height: 8;
    radius: 999;
}

.dialog TableView.dialog-entries::scrollbar:hover, .dialog TableView.dialog-entries::scrollbar:pressed {
    background-color: $accent;
}
