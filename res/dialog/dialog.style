// The look of the dialogs of Balder, in a window of their own or in an overlay over the interface of the caller. The
// .gui files of the dialogs load it at the origin of the components: every sheet of the application wins over it, and
// its rules select the widgets of the dialogs only, of the classes dialog-…, under their root of the class dialog

$backdrop: #000000 / 60%;
$surface: #202328;
$field: #17191d;
$button: #2a2e34;
$edge: #4a5259;
$text: #eeeff2;
$muted: #9aa3ab;
$accent: #4c98fd;
$font: "Noto Sans", sans-serif;

// The backdrop of the overlays, greying out the interface under the dialog
Overlay {
    background-color: $backdrop;
}

LinearLayout.dialog {
    background-color: $surface;
    border: 1 $edge;
    radius: 8;
    shadow: 0 8 24 #00000099;
    padding: 18;
    min-width: 360;
    max-width: 640;
    text-color: $text;
    font-family: $font;
    font-size: 15;
}

.dialog Label.dialog-question {
    font-size: 18;
    text-wrap: wrap;
    text-xalign: center;
    margin-bottom: 18;
}

// the padding leaves room for the focus rings of the buttons
.dialog LinearLayout.dialog-buttons {
    background-color: transparent;
    direction: row;
    padding: 3;
}

.dialog Box.dialog-fill {
    background-color: transparent;
    border-color: transparent;
    flex: 1;
}

.dialog PushButton.dialog-accept, .dialog PushButton.dialog-cancel {
    background-color: $button;
    border: 1 $edge;
    radius: 6;
    padding: 6 18;
    margin-left: 10;
    min-width: 96;
}

.dialog PushButton.dialog-accept {
    background-color: #1f4f8f;
    border-color: $accent;
}

.dialog PushButton.dialog-accept:hover { background-color: #2a64b0; }
.dialog PushButton.dialog-cancel:hover { background-color: #3a3f46; }
.dialog PushButton.dialog-accept:focus, .dialog PushButton.dialog-cancel:focus { shadow: 0 0 0 2 $accent; }
