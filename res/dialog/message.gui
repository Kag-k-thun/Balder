// The message dialog: a question, and the buttons answering it, the cancelling one hidden unless it is given a text

@style "dialog.style";

LinearLayout #DIALOG .dialog .dialog-message {
    Label #QUESTION .dialog-question "";
    LinearLayout .dialog-buttons {
        Box .dialog-fill;
        PushButton #CANCEL .dialog-cancel "Cancel" { on-click: cancel; }
        PushButton #NO .dialog-cancel "No" { on-click: no; }
        PushButton #YES .dialog-accept "Yes" { on-click: yes; }
    }
}
