// The file dialog: the path of the directory shown, its entries, the name chosen, and the buttons answering

@style "dialog.style";

LinearLayout #DIALOG .dialog .dialog-file {
    LinearLayout .dialog-row {
        PushButton #UP .dialog-tool "Up" { on-click: up; }
        InputText #PATH .dialog-input { max-length: 4096; on-validate: go; }
    }
    TableView #ENTRIES .dialog-entries { on-select: pick; on-activate: enter; }
    LinearLayout .dialog-row {
        Label .dialog-caption "Name";
        InputText #NAME .dialog-input { max-length: 4096; }
    }
    Label #ERROR .dialog-error "";
    LinearLayout .dialog-buttons {
        CheckBox #HIDDEN .dialog-check "Hidden files" { on-toggle: hidden; }
        Box .dialog-fill;
        PushButton #CANCEL .dialog-cancel "Cancel" { on-click: cancel; }
        PushButton #ACCEPT .dialog-accept "Open" { on-click: accept; }
    }
}
