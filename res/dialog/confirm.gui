// The confirm dialog: a question, the button cancelling the action and the one accepting it

@style "dialog.style";

LinearLayout #DIALOG .dialog .dialog-confirm {
    Label #QUESTION .dialog-question "";
    LinearLayout .dialog-buttons {
        Box .dialog-fill;
        PushButton #CANCEL .dialog-cancel "Cancel" { on-click: cancel; }
        PushButton #ACCEPT .dialog-accept "OK" { on-click: accept; }
    }
}
