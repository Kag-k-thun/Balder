// The message dialog: a question, and the buttons answering it

$surface: #202328;
$button: #22252a;
$edge: #4a5259;
$font: "Noto Sans", sans-serif;

FloatingLayout.root {
    background-color: #32383e;
}

LinearLayout.root, LinearLayout.inner {
    background-color: $surface;
}

LinearLayout.inner {
    direction: row;
    margin-left: 40%;
    margin-right: 10;
    height: 60;
}

Label.question {
    text-color: #eeeff2;
    font-family: $font;
    font-size: 22;
    text-xalign: center;
    margin-top: 10;
}

PushButton.yes, PushButton.no {
    background-color: $button;
    border: 2 $edge;
    margin: 10;
    width: 50%;
}

PushButton.yes::label, PushButton.no::label {
    font-family: $font;
    font-size: 20;
}

PushButton.yes::label       { text-color: #4c98fd; }
PushButton.yes:hover        { background-color: #cccccc; border-color: #ffffff; }
PushButton.yes:hover::label { text-color: #2fc49f; }

PushButton.no::label        { text-color: #f1bcbd; }
PushButton.no:hover         { background-color: #ff4d6d; border-color: #e1e5e9; }
PushButton.no:hover::label  { text-color: black; }
