// The colour dialog: a slider and a spin box per channel, the swatches of the colour chosen and of the one the dialog
// started from, the code of the colour, and the buttons answering

@style "dialog.style";

LinearLayout #DIALOG .dialog .dialog-color {
    LinearLayout .dialog-picker {
        LinearLayout .dialog-channels {
            LinearLayout .dialog-row {
                Label .dialog-caption "Red";
                Slider #RED .dialog-slider { max: 255; step: 1; on-change: red; }
                SpinBox #RED_VALUE .dialog-spin { max: 255; decimals: 0; on-change: red; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption "Green";
                Slider #GREEN .dialog-slider { max: 255; step: 1; on-change: green; }
                SpinBox #GREEN_VALUE .dialog-spin { max: 255; decimals: 0; on-change: green; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption "Blue";
                Slider #BLUE .dialog-slider { max: 255; step: 1; on-change: blue; }
                SpinBox #BLUE_VALUE .dialog-spin { max: 255; decimals: 0; on-change: blue; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption "Opacity";
                Slider #OPACITY .dialog-slider { max: 100; step: 1; on-change: opacity; }
                SpinBox #OPACITY_VALUE .dialog-spin { max: 100; decimals: 0; on-change: opacity; }
            }
            LinearLayout .dialog-row {
                Label .dialog-caption "Code";
                InputText #HEX .dialog-input { max-length: 32; on-validate: hex; }
            }
        }
        LinearLayout .dialog-swatches {
            Box #CHOSEN .dialog-swatch;
            Label .dialog-note "New";
            Box #INITIAL .dialog-swatch;
            Label .dialog-note "Current";
        }
    }
    LinearLayout .dialog-buttons {
        Box .dialog-fill;
        PushButton #CANCEL .dialog-cancel "Cancel" { on-click: cancel; }
        PushButton #ACCEPT .dialog-accept "OK" { on-click: accept; }
    }
}
