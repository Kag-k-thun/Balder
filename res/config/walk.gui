FloatingLayout #fl .walk {
    Scene3D #scene .view { resolution: 1280 720; post: taa(0.05, 1.25, 0.15, off), bloom(1.0, 0.5, 0.05), vignette(0.6, 0.35, 0.65), fxaa();
    }
    Label #help .help "Z Q S D: walk and strafe | Shift: run | Space: jump | Tab: next pack | right button: turn the camera | wheel: zoom" { capture-events: false; }
    Label #state .state "" { capture-events: false; }
}
