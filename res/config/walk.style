// The walk example: a character walking on an endless floor, the keys and the state of its animation over it

$mono: "DejaVu Sans Mono", monospace;

FloatingLayout.walk {
    background-color: black;
}

Scene3D.view {
    background-color: black;
    width: 100%;
    height: 100%;
}

Label.help {
    font-family: $mono;
    font-size: 16;
    color: #102a43;
    padding: 4;
    text-xalign: left;
    text-yalign: top;
    background-color: white;
}

Label.state {
    top: 32;
    font-family: $mono;
    font-size: 16;
    color: #102a43;
    padding: 4;
    text-xalign: left;
    text-yalign: top;
    background-color: white;
}
