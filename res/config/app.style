// The demo: a 3D scene, and the frame rate and the culling counters over it

$mono: "DejaVu Sans Mono", monospace;

FloatingLayout.bar {
    background-color: black;
    border: 1 #004b23;
}

Scene3D.img {
    background-color: black;
    width: 100%;
    height: 100%;
}

Box.truc {
    background-color: #800f2f;
    width: 100%;
    height: 100%;
}

Label.fps {
    font-family: $mono;
    font-size: 20;
    color: #005a0e;
    padding: 4;
    text-xalign: left;
    text-yalign: top;
    background-color: white;
}

FrameGraph.frames {
    top: 40;
    width: 260;
    height: 150;
    background-color: #101010;
    padding: 4;
}

Label.culling {
    top: 194;
    font-family: $mono;
    font-size: 14;
    color: #005a0e;
    padding: 4;
    text-xalign: left;
    text-yalign: top;
    background-color: white;
}

FrameGraph.frames::cpu, FrameGraph.frames::gpu, FrameGraph.frames::memory {
    font-family: $mono;
    font-size: 12;
    text-xalign: left;
    text-yalign: top;
}

FrameGraph.frames::cpu { text-color: #3fb950; }
FrameGraph.frames::gpu { text-color: #388bfd; }
FrameGraph.frames::memory { text-color: #d29922; }

PushButton.truc {
    width: 100;
    height: 100;
    background-color: #800f2f;
}

PushButton.truc:hover {
    background-color: #a4133c;
}

PushButton.truc:check {
    background-color: #006cad;
}

PushButton.truc::label {
    font-family: $mono;
    font-size: 20;
    color: #005a0e;
}
