// The demo: a 3D scene, and the frame rate over it

$mono: "DejaVu Sans Mono", monospace;

FloatingLayout.bar {
    background-color: black;
    border: 1 #004b23;
}

Scene3D.img {
    background-color: black;
}

Box.truc {
    background-color: #800f2f;
    width: 100%;
    height: 100%;
}

Label.fps {
    font-family: $mono;
    font-size: 20;
    color: #005a0e;
    width: max-content;
    height: max-content;
    padding: 4;
    text-xalign: left;
    text-yalign: top;
    background-color: white;
}

PushButton.truc {
    width: 100;
    height: 100;
    background-color: #800f2f;
}

PushButton.truc:hover {
    background-color: #a4133c;
}

PushButton.truc:check {
    background-color: #006cad;
}

PushButton.truc::label {
    font-family: $mono;
    font-size: 20;
    color: #005a0e;
}
