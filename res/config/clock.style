// The clock example: the scene of the clock, the keys over it

$mono: "DejaVu Sans Mono", monospace;

FloatingLayout.clock {
    background-color: black;
}

Scene3D.view {
    background-color: black;
    width: 100%;
    height: 100%;
}

Label.help {
    font-family: $mono;
    font-size: 16;
    color: #102a43;
    padding: 4;
    text-xalign: left;
    text-yalign: top;
    background-color: white;
}
