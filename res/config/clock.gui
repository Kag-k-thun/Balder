FloatingLayout #fl .clock {
    Scene3D #scene .view { resolution: 1280 720; post: taa(0.05, 1.25, 0.15, off), bloom(1.0, 0.5, 0.05), vignette(0.6, 0.35, 0.65), fxaa();
    }
    Label #help .help "Space: lift the anchor out / drop it back | right button: turn the camera | wheel: zoom | S, C, J: colliders, contacts, joints" { capture-events: false; }
}
