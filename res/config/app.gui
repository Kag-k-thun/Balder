FloatingLayout #fl .bar {
    Scene3D #scene .img { resolution: 1280 720; post: taa(0.05, 1.25, 0.15), bloom(1.0, 0.5, 0.05), vignette(0.6, 0.35, 0.65), lut("res:/lut/film.png"), fxaa(off), invert(off); }
    Label #fps .fps "0";
    FrameGraph #frames .frames { capture-events: false; }
    Label #culling .culling "";
}
