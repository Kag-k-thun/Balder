FloatingLayout #fl .bar {
    Scene3D #scene .img { resolution: 1280 720; post: taa(0.05, 1.25, 0.15, off), bloom(1.0, 0.5, 0.05), vignette(0.6, 0.35, 0.65), lut("res:/lut/film.png"), fxaa(off), invert(off);
        ScenePicker #picker;
    }
    Label #fps .fps "0" { capture-events: false; }
    FrameGraph #frames .frames { capture-events: false; }
    Label #culling .culling "" { capture-events: false; }
    Label #picking .picking "" { capture-events: false; }
}
