in main;

use balder::scene::{physics, physics::convex_decomposition};

use std::{algorithm::comparison, config, config::args, io, time};

/**
 * What the command line asks for: the model, and how it is split
 * */
@data
record Request {

    // The project path of the model
    let mut model: [c8] = "";

    // How the model is split
    let mut settings: DecompositionSettings = DecompositionSettings();
}

/**
 * @returns: the request of the command line, none when nothing must be decomposed
 * */
fn readArguments(args: [[c8]])-> (Request)? {
    let defaults = DecompositionSettings();
    let parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.position!{[c8]} ("model", comments-> "the model to decompose, a res:/… or a file path")
        :.option!{f64} ("concavity", default-> cast!f64(defaults.concavity), short-> "c", comments-> "the volume a hull may hold outside the model, over the volume of the model")
        :.option!{i64} ("hulls", default-> cast!i64(defaults.maxHulls), short-> "n", comments-> "the number of hulls at most")
        :.option!{i64} ("vertices", default-> cast!i64(defaults.maxVertices), short-> "v", comments-> "the number of vertices of a hull at most, four at least")
        :.option!{i64} ("resolution", default-> cast!i64(defaults.resolution), short-> "r", comments-> "the number of voxels along the longest side of the model");

    {
        let cfg = parser.parse(args);
        let mut request = Request();
        if let Ok(Str(value-> m)) = cfg["model"]? { request.model = m; }
        if let Ok(Float(value-> c)) = cfg["concavity"]? { request.settings.concavity = cast!f32(c); }
        if let Ok(Int(value-> n)) = cfg["hulls"]? { request.settings.maxHulls = cast!u32(comparison::max(n, 1i64)); }
        if let Ok(Int(value-> n)) = cfg["vertices"]? { request.settings.maxVertices = cast!u32(comparison::max(n, 4i64)); }
        if let Ok(Int(value-> n)) = cfg["resolution"]? { request.settings.resolution = cast!u32(comparison::max(n, 8i64)); }
        request?
    } catch {
        err: &std::config::args::CommandLineError => {
            eprintln(parser.explain(err, usage-> "decompose"));
            none
        }
    }
}

/**
 * Decompose a model into convex hulls and save them next to its file (see ConvexDecomposition::fileOf), the offline
 * step of a concave model of a dynamic body (see MeshAsset.decomposition), the export of a game running it too
 * @example:
 * ```
 * gyllir build decompose
 * ./decompose res:/models/teapot/teapot.obj --hulls 12 --concavity 0.02
 * ```
 * */
fn main(args: [[c8]]) {
    if let Ok(request) = readArguments(args) {
        {
            let start = Instant::now();
            let decomposition = ConvexDecomposition::ofModel(request.model, settings-> request.settings);

            let file = ConvexDecomposition::fileOf(request.model);
            decomposition.save(file);
            println(f"Wrote ${decomposition.hulls.len} hulls of ${decomposition.vertexCount} vertices in ${file}, decomposed in ${(Instant::now() - start).allMillis} ms");
        } catch {
            err => {
                eprintln(f"Failed to decompose ${request.model}: ${err}");
            }
        }
    }
}
