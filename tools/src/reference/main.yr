in main;

use balder::interface::loader;
use balder::interface::loader::registry;
use balder::interface::loader::registry::reference;

use std::fs::_;
use std::io;

/**
 * Write the reference of the widget types and of the style properties after the marker of doc/gui.md (run from tools/),
 * generated from the widget registry and the property table
 * */
fn main() {
    let path = "../doc/gui.md";
    {
        let doc = readFile(path);
        let dmut file = File::create(Path(path), write-> true);
        file:.write(splice(doc, reference(WidgetRegistry())));
        file:.close();
        println("Wrote the reference of ", path);
    } catch {
        err => {
            eprintln("Failed to write the reference of ", path, ": ", err);
        }
    }
}
