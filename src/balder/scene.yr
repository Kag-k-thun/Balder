in scene;

pub mod ::node;
pub mod ::utils;

use balder::utils;
use balder::core::{_, application::_};
use balder::core::driver::{cmd_alloc, graph};
use balder::core::shader::texture;
use balder::math::{bounds, vector};
use balder::scene::node::node3D::{camera, light};
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::{material, mesh};
use balder::scene::utils::_;
use balder::scene::utils::post::_;
use balder::scene::utils::post::tonemap::operator;

use ::std::time::dur;




/**
 * The names of the subpasses, the passes and the resources of a scene in the render graph of its window, suffixed by the
 * name of the scene
 * */
def DEFERRED     = "deferred";
def COMPOSE      = "compose";
def SHADOW       = "shadow";
def CULL         = "cull";
def GBUFFER      = "gbuffer";
def PYRAMID      = "pyramid";
def LATE_CULL    = "late_cull";
def LATE_GBUFFER = "late_gbuffer";
def OUTPUT       = "output";
def RADIANCE     = "radiance";
def ATLAS        = "shadow_atlas";
def DRAWS        = "draws";
def LATE_DRAWS   = "late_draws";
def CULL_STATE   = "cull_state";
def HZB          = "hzb";

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          SCENE          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * A scene manage objects in a 3D environment
 * It has a camera, lights, and a tree of nodes
 * It manages the composing pipeline
 * */
@final
pub class Scene {
    
    // The window to which the scene is attached
    let dmut _window : &Window;

    // The name of the scene
    let _name : [c8];

    // The width of the generated texture
    let mut _width : u32 = 0;

    // The height of the generated texture
    let mut _height : u32 = 0;

    // The slot emitter, used to trigger signals from scene events
    let dmut _box : &SlotEmitter = copy SlotEmitter ();

    // The association of shaders to loaded nodes
    let dmut _shaderToNode : ShaderNodeScene = ShaderNodeScene ();    

    // The node tree hierarchy of the node
    let dmut _tree : NodeTreeScene = NodeTreeScene ();

    // The deferred rendering textures and subpass
    let dmut _deferred : DeferredRenderScene = DeferredRenderScene ();

    // The compose rendering textures and subpasses
    let dmut _compose : ComposeRenderScene = ComposeRenderScene ();

    // The passes between the composition and the screen, reading the light the composition writes, the last one
    // writing the output of the scene
    let dmut _post : &PostChain = copy PostChain ();

    // The shadow map of the direction light casting shadows, and the subpass drawing it
    let dmut _shadow : CascadeShadowScene = CascadeShadowScene ();
    
    prot { // Aspect 

        let dmut _aspectChanged : &Signal!{u32, u32} = copy Signal!{u32, u32} ();
        
        let mut _aspectWidth : u32 = 0;
        
        let mut _aspectHeight : u32 = 0;
    }

    prot { // Shadows

        // The number of texels on a side of the shadow map, holding the four cascades of the light casting shadows
        let mut _shadowScale : u32 = 0;

        // The depth in the view of the camera up to which the shadows are drawn, the far plane of the camera when farther
        let mut _shadowDistance : f32 = 50.0f;
    }

    prot { // Lighting

        // The light reaching every point of the scene from all around, whatever its lights
        let mut _ambient : vec3 = makeVec3 (0.1f, 0.1f, 0.1f);
    }

    prot { // Levels of detail

        // The largest error of the levels of detail drawn, in pixels of the generated texture
        let mut _lodThreshold : f32 = 1.0f;
    }

    prot { // Culling

        // The size on screen under which an instance is culled, in pixels of the generated texture
        let mut _cullThreshold : f32 = 1.0f;
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a new scene (not configured)
     * */
    pub self (dmut window : &Window, name : [c8])
        with _window = alias window
        , _name = name        
    {}                

    __dtor (mut self) {
        self:.dispose ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Configure the scene: its passes are declared in the render graph of the window, with the images they draw at the
     * size of the generated texture
     * @info: the size of the shadow map and the distance of the shadows are those of the configuration of the window
     * (its [shadow] table), the distance changing afterwards through shadowDistance
     * */
    pub fn configure (mut self, width : u32, height : u32)
        throws BalderError
    {
        log::debug #("Scene", "Configure scene :", width, height);        
        {
            // the render graph is compiled at the next frame, once it is declared entirely
            self._window:.lockFrame ();
            self:.disposeGraph ();

            if height != 0 && width != 0 {
                self._width = width;
                self._height = height;
                let shadow = self._window.getShadowConfig ();
                self._shadowScale = shadow.scale;
                self._shadowDistance = shadow.distance;

                self._tree:.configure (alias self._window, alias self);
                self._deferred:.configure (self.named (DEFERRED), self._name, alias self._window, self._width, self._height);
                self._shadow:.configure (alias self._window);
                self._compose:.configure (self.named (COMPOSE),
                                          self.named (RADIANCE),
                                          alias self._window,
                                          self._width,
                                          self._height,
                                          self._deferred,
                                          self._shadow.ubo,
                                          self._ambient);

                let dmut dpass = alias self._deferred.subpass;
                self._shaderToNode:.configure (alias self._window, self._deferred.depth, alias dpass);
                dpass:.onPrepare ():.connect (&self:.onDeferredPrepare);

                self:.declarePasses ();

                // the chain reads the light the composition writes, its passes declared after it
                self._post:.configure (alias self._window,
                                       alias self._compose.subpass,
                                       PostSources (scene-> self._name,
                                                    submission-> self.named (COMPOSE),
                                                    radiance-> self.named (RADIANCE),
                                                    output-> self.named (OUTPUT),
                                                    depth-> self._deferred.depth,
                                                    normals-> self._deferred.normals),
                                       self._width,
                                       self._height);

                self:.enablePasses ();
                self:.setAspect (width, height);
            }
        } catch {
            err => {
                log::error #("Scene", "Configuration failed", err);
                throw err;
            }
        } exit {
            self._window:.unlockFrame ();
        }
    }

    /**
     * Declare the buffers and the passes of the scene in the render graph of the window, in the order a frame runs them:
     * the cull pass and the g-buffer drawing the instances it finds, the depth pyramid, the late cull pass and the
     * g-buffer drawing the occluded instances it finds again, then the composition (the shadow map is declared before it
     * when a light casts shadows); the post-process chain declares its passes after it, in the subpass of the composition
     * */
    fn declarePasses (mut self)
        throws BalderError
    {
        let dmut pipeline = self._window:.getVulkanPipeline ();
        for b in copy [DRAWS, LATE_DRAWS, CULL_STATE, HZB] {
            pipeline:.importBuffer (self.named (b));
        }

        let deferred = self.named (DEFERRED);
        let attachments = self.gbufferUses ();

        pipeline:.declarePass (GraphPass (name-> self.named (CULL),
                                          submission-> deferred,
                                          kind-> PassKind::COMPUTE,
                                          uses-> copy [ResourceUse (resource-> self.named (DRAWS), usage-> Usage::STORAGE_WRITE),
                                                       ResourceUse (resource-> self.named (CULL_STATE), usage-> Usage::STORAGE_READ_WRITE)],
                                          recording-> (&self:.recordCull)?));

        pipeline:.declarePass (GraphPass (name-> self.named (GBUFFER),
                                          submission-> deferred,
                                          uses-> copy [ResourceUse (resource-> self.named (DRAWS), usage-> Usage::INDIRECT),
                                                       ResourceUse (resource-> self.named (DRAWS), usage-> Usage::VERTEX_READ)] ~ attachments,
                                          recording-> (&self:.recordGbuffer)?));

        pipeline:.declarePass (GraphPass (name-> self.named (PYRAMID),
                                          submission-> deferred,
                                          kind-> PassKind::COMPUTE,
                                          uses-> copy [ResourceUse (resource-> self._deferred.depth, usage-> Usage::SAMPLED_COMPUTE),
                                                       ResourceUse (resource-> self.named (HZB), usage-> Usage::STORAGE_WRITE)],
                                          recording-> (&self:.recordPyramid)?));

        pipeline:.declarePass (GraphPass (name-> self.named (LATE_CULL),
                                          submission-> deferred,
                                          kind-> PassKind::COMPUTE,
                                          uses-> copy [ResourceUse (resource-> self.named (HZB), usage-> Usage::STORAGE_READ),
                                                       ResourceUse (resource-> self.named (CULL_STATE), usage-> Usage::STORAGE_READ_WRITE),
                                                       ResourceUse (resource-> self.named (LATE_DRAWS), usage-> Usage::STORAGE_WRITE)],
                                          recording-> (&self:.recordLateCull)?));

        pipeline:.declarePass (GraphPass (name-> self.named (LATE_GBUFFER),
                                          submission-> deferred,
                                          uses-> copy [ResourceUse (resource-> self.named (LATE_DRAWS), usage-> Usage::INDIRECT),
                                                       ResourceUse (resource-> self.named (LATE_DRAWS), usage-> Usage::VERTEX_READ)] ~ attachments,
                                          recording-> (&self:.recordLateGbuffer)?));

        let mut reads : [ResourceUse] = [];
        for a in self._deferred.attachments {
            reads = reads ~ [ResourceUse (resource-> a, usage-> Usage::SAMPLED_COMPUTE)];
        }

        pipeline:.declarePass (GraphPass (name-> self.named (COMPOSE),
                                          submission-> self.named (COMPOSE),
                                          kind-> PassKind::COMPUTE,
                                          uses-> reads ~ [ResourceUse (resource-> self.named (ATLAS), usage-> Usage::SAMPLED_COMPUTE, optional-> true),
                                                          ResourceUse (resource-> self.named (RADIANCE), usage-> Usage::STORAGE_WRITE)],
                                          recording-> (&self:.recordCompose)?));
    }

    /**
     * @returns: the uses of the g-buffer by the passes drawing it, in the order of the attachments of the deferred
     * */
    fn gbufferUses (self)-> [ResourceUse] {
        let mut result : [ResourceUse] = [];
        for a in self._deferred.attachments {
            let usage = if a == self._deferred.depth { Usage::DEPTH_ATTACHMENT } else { Usage::COLOR_ATTACHMENT };
            result = result ~ [ResourceUse (resource-> a, usage-> usage)];
        }

        result
    }

    /**
     * Enable the passes of the culling the scene does: the cull pass when the instances are culled on the GPU, the depth
     * pyramid and the late passes when the occluded instances are culled too
     * */
    fn enablePasses (mut self) {
        let (gpu, occlusion) = atomic self {
            (self._shaderToNode.cullsOnGpu (), self._shaderToNode.cullsOccluded ())
        };

        let dmut pipeline = self._window:.getVulkanPipeline ();
        pipeline:.enablePass (self.named (CULL), gpu);
        pipeline:.enablePass (self.named (PYRAMID), occlusion);
        pipeline:.enablePass (self.named (LATE_CULL), occlusion);
        pipeline:.enablePass (self.named (LATE_GBUFFER), occlusion);
    }

    /**
     * @returns: the name of a subpass, a pass or a resource of the scene in the render graph of its window
     * */
    fn named (self, base : [c8])-> [c8] {
        base ~ "_" ~ self._name
    }

    /**
     * Change the rendering aspect of the scene, without recomputing the rendering textures
     * */
    pub fn setAspect (mut self, width : u32, height : u32) {
        self._aspectHeight = height;
        self._aspectWidth = width;

        self._aspectChanged:.emit (width, height);
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the largest error of the levels of detail drawn, in pixels of the generated texture
     * */
    @field
    pub fn lodThreshold (self)-> f32 {
        self._lodThreshold
    }

    /**
     * Set the largest error of the levels of detail drawn, in pixels of the generated texture
     * */
    @field
    pub fn lodThreshold (mut self, threshold : f32) {
        self._lodThreshold = threshold;
    }

    /**
     * @returns: the size on screen under which an instance is culled, in pixels of the generated texture
     * */
    @field
    pub fn cullThreshold (self)-> f32 {
        self._cullThreshold
    }

    /**
     * Set the size on screen under which an instance is culled, in pixels of the generated texture, 0 to cull the
     * instances outside the view of the camera only
     * */
    @field
    pub fn cullThreshold (mut self, threshold : f32) {
        let gpu = atomic self {
            self._cullThreshold = threshold;
            self._shaderToNode.gpuCulling
        };

        // the cull passes are recorded with the threshold
        if gpu {
            self._window:.redrawPipeline ();
        }
    }

    /**
     * @returns: true iif the instances are culled on the GPU, by a compute pass writing the commands drawing them
     * */
    @field
    pub fn gpuCulling (self)-> bool {
        atomic self {
            self._shaderToNode.gpuCulling
        }
    }

    /**
     * Cull the instances on the GPU, by a compute pass writing the commands drawing them, or on the CPU, through a
     * hierarchy of their boxes (the default, the reference of the GPU)
     * @info: the instances stay culled on the CPU when the device lacks multi-draw or the drawIndirectCount feature of
     * Vulkan 1.2 (see gpuCulling); the GPU culling pays off with tens of thousands of instances
     * @assume: the scene is configured
     * */
    @field
    pub fn gpuCulling (mut self, culling : bool) {
        let changed = atomic self {
            self._shaderToNode:.setGpuCulling (culling)
        };

        if changed {
            self:.enablePasses ();
            self._window:.redrawPipeline ();
        }
    }

    /**
     * @returns: true iif the instances hidden behind others are culled, when the instances are culled on the GPU
     * */
    @field
    pub fn occlusionCulling (self)-> bool {
        atomic self {
            self._shaderToNode.occlusionCulling
        }
    }

    /**
     * Cull the instances hidden behind others too, when the instances are culled on the GPU (see gpuCulling), in two
     * phases: the instances the last frame saw are drawn first, their depth reduced into a hierarchical depth buffer (a
     * depth pyramid), then the other instances are tested against it, those found in front of it drawn after
     * @info: an instance is drawn by the first phase as long as the second one finds it visible, the second phase drawing
     * those it finds visible for the first time; the scene draws what the camera sees, whatever the last frame saw
     * */
    @field
    pub fn occlusionCulling (mut self, culling : bool) {
        let changed = atomic self {
            self._shaderToNode:.setOcclusionCulling (culling)
        };

        if changed {
            self:.enablePasses ();
            self._window:.redrawPipeline ();
        }
    }

    /**
     * @returns: the counters of the last culling of the instances by the camera
     * */
    @field
    pub fn cullStats (self)-> CullStats {
        atomic self {
            self._shaderToNode.cullStats
        }
    }

    /**
     * @returns: the counters of the draws of the instances, at the last build of their commands
     * */
    @field
    pub fn drawStats (self)-> DrawStats {
        atomic self {
            self._shaderToNode.drawStats
        }
    }

    /**
     * @returns: the depth in the view of the camera up to which the shadows are drawn
     * */
    @field
    pub fn shadowDistance (self)-> f32 {
        self._shadowDistance
    }

    /**
     * Set the depth in the view of the camera up to which the shadows are drawn, the far plane of the camera when
     * farther; the cascades of the shadow map share it, a shorter distance giving sharper shadows
     * */
    @field
    pub fn shadowDistance (mut self, distance : f32) {
        atomic self {
            self._shadowDistance = distance;
        }
    }

    /**
     * @returns: the light reaching every point of the scene from all around, whatever its lights
     * */
    @field
    pub fn ambient (self)-> vec3 {
        self._ambient
    }

    /**
     * Set the light reaching every point of the scene from all around, whatever its lights: added once to each pixel,
     * times the colour of its surface, it stands in for the indirect light
     * */
    @field
    pub fn ambient (mut self, color : vec3) {
        atomic self {
            self._ambient = color;
            self._compose:.setAmbient (color);
        }
    }

    /**
     * @returns: the operator mapping the light the camera sees into the colours of the screen
     * */
    @field
    pub fn toneMap (self)-> ToneMap {
        atomic self {
            self._post.tonemap.toneMap
        }
    }

    /**
     * Set the operator mapping the light the camera sees, exposed by the camera (see Camera::exposure), into the colours
     * of the screen; AgX by default, NONE clipping the light to 1
     * */
    @field
    pub fn toneMap (mut self, op : ToneMap) {
        atomic self {
            let dmut tonemap = alias self._post.tonemap;
            tonemap.toneMap = op;
        }
    }

    /**
     * @returns: the passes between the composition and the screen: the effects in HDR space, the tone mapping, then the
     * effects in display space, an effect added, removed, moved or enabled being declared again in the render graph
     * */
    pub fn getPostChain (mut self)-> dmut &PostChain {
        alias self._post
    }

    /**
     * @returns: true iif a direction light casts shadows
     * */
    @field
    pub fn hasShadows (self)-> bool {
        atomic self {
            self._shadow.isCasting
        }
    }

    /**
     * @returns: the root node of the scene
     * */
    pub fn getRootNode (mut self)-> dmut &Node {
        alias self._tree.rootNode      
    }

    /**
     * The size of the rendering textures
     * */
    @field
    pub fn width (self)-> u32 {
        self._width
    }

    /**
     * The size of the rendering textures
     * */
    @field
    pub fn height (self)-> u32 {
        self._height
    }

    /**
     * The size of the scene on screen
     * */
    @field
    pub fn aspectWidth (self)-> u32 {
        self._aspectWidth
    }

    /**
     * The size of the scene on screen
     * */
    @field
    pub fn aspectHeight (self)-> u32 {
        self._aspectHeight
    }

    /**
     * @returns: the signal emitted when the size of the scene changes on screen (does not change rendering texture sizes)
     * */
    pub fn aspectChanged (mut self)-> dmut &Signal!{u32, u32} {
        alias self._aspectChanged
    }

    /**
     * @returns: the camera of the scene if there is one camera set in the tree of nodes
     * */
    pub fn getCamera (mut self)-> dmut (&Camera)? {
        alias self._tree.camera
    }

    /**
     * @returns: the window on which the scene is rendered
     * */
    pub fn getWindow (mut self)-> dmut &Window {
        alias self._window
    }

    /**
     * @returns: the window on which the scene is rendered
     * */
    pub fn getWindow (self)-> &Window {
        self._window
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          TEXTURE RESULTS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the generated output texture of the scene, written by the last pass of its post-process chain, sampled in
     * sRGB
     * */
    pub fn getOutputTexture (mut self)-> dmut &RefCount!{&Texture} {
        alias self._post.output
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Slot called when the deferred is redrawn, before its passes are recorded: the draws laid out
     * */
    fn onDeferredPrepare (mut self) {
        let frame = self._deferred.subpass.getCurrentFrame ();
        atomic self {
            self._shaderToNode:.prepare (frame);
        }
    }

    /**
     * Record the cull pass of the instances culled on the GPU, writing the commands of the g-buffer
     * */
    fn recordCull (mut self) {
        self:.recordCullPhase (false);
    }

    /**
     * Record the cull pass of the instances the first one did not draw, against the depth pyramid
     * */
    fn recordLateCull (mut self) {
        self:.recordCullPhase (true);
    }

    /**
     * Record a phase of the cull pass
     * */
    fn recordCullPhase (mut self, late : bool) {
        if !self._tree.camera.hasValue { return; }

        let dmut subpass = alias self._deferred.subpass;
        let frame = subpass.getCurrentFrame ();
        atomic self {
            self._shaderToNode:.recordCull (frame, alias subpass, cast!f32 (self._width), cast!f32 (self._height), self._cullThreshold, late);
        }
    }

    /**
     * Record the draws of the instances in the g-buffer, those the cull pass found when the instances are culled on the
     * GPU
     * */
    fn recordGbuffer (mut self) {
        self:.recordDraws (false);
    }

    /**
     * Record the draws of the instances the late cull pass found
     * */
    fn recordLateGbuffer (mut self) {
        self:.recordDraws (true);
    }

    /**
     * Record the draws of a phase of the culling in the g-buffer
     * */
    fn recordDraws (mut self, late : bool) {
        log::debug #("Scene", "Drawing deferred pass scene");
        if !self._tree.camera.hasValue { return; }
        
        let dmut subpass = alias self._deferred.subpass;        
        let dmut cmd = copy IndexedDrawCommandAllocator (alias subpass);
        let frame = subpass.getCurrentFrame ();
        
        atomic self {
            self._shaderToNode:.drawGroups (frame, alias cmd, late);
        }
    }

    /**
     * Record the reduction of the depth the g-buffer drew into the depth pyramid
     * */
    fn recordPyramid (mut self) {
        let dmut subpass = alias self._deferred.subpass;
        let frame = subpass.getCurrentFrame ();
        let cmd = subpass.getDrawingCommandBuffer ();
        atomic self {
            self._shaderToNode:.recordPyramid (frame, cmd);
        }
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==============================          COMPOSE SHADER LOOP          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Record the composition of the g-buffer, lit and shadowed, into the light the post-process chain reads
     * */
    fn recordCompose (mut self) {        
        let dmut pass = alias self._compose.subpass;            
        
        let frame = pass.getCurrentFrame ();                                    
        let cmdV = pass.getDrawingCommandBuffer ();
        
        log::debug #("Scene", "Calling compose compute shader");
        
        let dmut cmd = copy ComputeDispatchCommandAllocator (alias pass);

        let sizes = self._compose.groupSizes;

        {
            cmd:.registerDispatch (groupX-> sizes [0], groupY-> sizes [1], groupZ-> sizes [2]);
            cmd:.finalizeRegister ();
            
            self._compose:.select (frame,
                                   self._shaderToNode,
                                   self._shadow,
                                   cmdV);
            
            cmd:.dispatchNext ();
        } catch {
            err => {
                log::error #("Scene", "Failed to call compose shader", err);                
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===========================          NODE ATTACHEMENT/REMOVING          ============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Attach a node in the rendering scene
     * */
    pub fn registerNode (mut self, dmut node : &Node) {
        atomic self {
            self._tree:.register (alias node);
        }
    }

    /**
     * Detach a node from the rendering scene
     * */
    pub fn removeNode (mut self, dmut node : &Node) {
        atomic self {
            self._tree:.remove (alias node);
        }
    }

    /**
     * Trigger when the camera is updated
     * */
    pub fn onCameraUpdate (mut self, dmut cam : &Camera) {
        atomic self {
            self._compose:.setCamera (alias cam);
            self._post:.setCamera (alias cam);
            self._shaderToNode:.setCamera (alias cam);
        }
    }
        
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SHADERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Place a visual instance in the draws of the scene, drawn with the shader of its material by the next recordings
     * @params:
     *    - material: the material of the instance, attached
     *    - node: the instance
     *    - mesh: the geometry of the instance, placed once for the instances drawing it with the same shader
     * @returns: the place of the instance in the draws, to retire after releaseDraws
     * */
    pub fn registerDraws (mut self, dmut material : &Material, dmut node : &VisualInstance3D, mesh : &MeshGeometry)-> dmut &SceneDraws
        throws BalderError
    {
        let dmut draws = atomic self {
            self._shaderToNode:.register (alias material, alias node, mesh)
        };

        self._window:.redrawPipeline ();
        alias draws
    }

    /**
     * Refit the box of a visual instance after it moved, before the next culling
     * */
    pub fn onInstanceMoved (mut self, dmut node : &VisualInstance3D) {
        atomic self {
            self._shaderToNode:.onMoved (alias node);
        }
    }

    /**
     * Remove a visual instance from the draws of the scene
     * */
    pub fn releaseDraws (mut self, material : &Material, node : &VisualInstance3D) {
        atomic self {
            self._shaderToNode:.release (material, node);
        }

        self._window:.redrawPipeline ();
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          MATERIALS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register a material to be used in the composition shader
     * */
    pub fn registerMaterialRef (mut self, mat : MaterialConfig)-> u32
        throws BalderError
    {
        self._shaderToNode.materials:.register (mat)
    }

    /**
     * Free a reference to a material
     * */
    pub fn freeMaterialRef (mut self, mat : u32) {
        self._shaderToNode.materials:.release (mat)        
    }    


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          LIGHTS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register a light in the composition shader
     * */
    pub fn registerLight (mut self, dmut light : &Light) {
        match light.type {
            LightType::DIRECTION => {
                self._shaderToNode.directionLights:.register (alias light);
                if light.castShadow {
                    self:.addShadowPass (alias light);
                }                    
                
            }
            LightType::POINT => {
                self._shaderToNode.pointLights:.register (alias light);
            }
            LightType::SPOT => {
                self._shaderToNode.spotLights:.register (alias light);
            }
            LightType::AREA => {} // area lights are not supported yet
        }
    }

    /**
     * Update the value of the light at index 'id'
     * */
    pub fn updateLight (mut self, dmut light : &Light) {
        match light.type {
            LightType::DIRECTION => {
                self._shaderToNode.directionLights:.update (alias light);
            }
            LightType::POINT => {
                self._shaderToNode.pointLights:.update (alias light);
            }
            LightType::SPOT => {
                self._shaderToNode.spotLights:.update (alias light);
            }
            LightType::AREA => {} // area lights are not supported yet
        }                
    }

    /**
     * Free a reference to a light
     * */
    pub fn freeLight (mut self, dmut light : &Light) {
        match light.type {
            LightType::DIRECTION => {
                self._shaderToNode.directionLights:.release (alias light);
                if light.castShadow {
                    self:.removeShadowPass (light);
                }                    
            }
            LightType::POINT => {
                self._shaderToNode.pointLights:.release (alias light);
            }
            LightType::SPOT => {
                self._shaderToNode.spotLights:.release (alias light);
            }
            LightType::AREA => {} // area lights are not supported yet
        }                                
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SHADOW          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Cast the shadows of a direction light, drawn in the cascades of a shadow map read by the composition
     * @info: one direction light casts shadows at a time, the others lighting the scene without casting any
     * @info: the pass of the shadow map is declared before the composition in the render graph, the composition reading
     * the atlas it writes
     * @assume: light is a direction light
     * */
    fn addShadowPass (mut self, dmut light : &Light) {
        if self._shadow.isCasting {
            log::warn #("Scene", "A direction light already casts shadows, the light", light.name, "casts none");
            return;
        }

        let sname = self.named (SHADOW);
        let atlas = self.named (ATLAS);
        {
            let dmut pass = self._shadow:.start (sname, atlas, alias light, self._shadowScale);
            pass:.onPrepare ():.connect (&self:.onShadowPrepare);

            atomic self {
                self._shaderToNode:.castShadows (alias pass, self._shadow.ubo, self._shadow.cameraOffsets ());
            }

            self._window:.getVulkanPipeline ():.declarePass (GraphPass (name-> sname,
                                                                        submission-> sname,
                                                                        uses-> copy [ResourceUse (resource-> atlas, usage-> Usage::DEPTH_ATTACHMENT)],
                                                                        recording-> (&self:.recordShadow)?),
                                                             before-> self.named (COMPOSE));
        } catch {
            err => {
                log::error #("Scene", "Failed to cast the shadows of the light", light.name, err);
                atomic self {
                    self._shaderToNode:.stopShadows ();
                }

                self._shadow:.stop ();
            }
        }

        self._window:.redrawPipeline ();
    }

    /**
     * Stop casting the shadows of a direction light, its shadow map removed from the render graph
     * @info: does nothing unless the light casts the shadows of the scene
     * */
    fn removeShadowPass (mut self, light : &Light) {
        if !self._shadow.isCastBy (light) { return; }

        atomic self {
            self._shaderToNode:.stopShadows ();
        }

        self._shadow:.stop ();
        self._window:.redrawPipeline ();
    }

    /**
     * Slot called when the shadow map is redrawn, before its render pass begins: the draws of the casters laid out
     * */
    fn onShadowPrepare (mut self) {
        if !self._tree.camera.hasValue { return; }

        let dmut subpass = alias self._shadow.subpass;
        let frame = subpass.getCurrentFrame ();
        atomic self {
            self._shaderToNode:.layoutShadows (frame);
        }
    }

    /**
     * Record the pass of the shadow map: the casters drawn in each cascade, in its tile of the atlas
     * */
    fn recordShadow (mut self) {
        if !self._tree.camera.hasValue { return; }

        let dmut subpass = alias self._shadow.subpass;
        let dmut cmd = copy IndexedDrawCommandAllocator (alias subpass);
        let frame = subpass.getCurrentFrame ();

        atomic self {
            for c in 0u32 .. CASCADES {
                self._shadow.selectCascade (cmd.getCommandBuffer (), c);
                self._shaderToNode:.drawShadows (frame, alias cmd, cast!usize (c));
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TICKS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Emit the update signal on inner nodes
     * */
    pub fn onTick (mut self, delta : Duration) {
        self._tree:.onTick (delta);
        self:.cull ();
        self:.sortDraws ();
        self:.selectLods (delta);
        self:.updateShadows ();
    }

    /**
     * Cull the instances the camera does not see and draw again those it sees, recording the commands again when the
     * device draws without multi-draw
     * */
    fn cull (mut self) {
        let changed = atomic self {
            if let Ok (cam) = self._tree.camera {
                self._shaderToNode:.cull (cam.viewProj, cast!f32 (self._height), self._cullThreshold)
            } else { false }
        };

        if changed {
            self._window:.redrawPipeline ();
        }
    }

    /**
     * Fit the cascades of the shadow map to the view of the camera, and cull the casters each of them sees when the
     * cascades or the instances changed, recording the commands again when the device draws without multi-draw
     * */
    fn updateShadows (mut self) {
        let changed = atomic self {
            if !self._shadow.isCasting {
                false
            } else if let Ok (cam) = self._tree.camera {
                let bounds = self._shaderToNode:.casterBounds ();
                let volumes = self._shadow:.update (cam, bounds, self._shadowDistance);
                if self._shadow:.cullAgain (self._shaderToNode.visibilityChanges ()) {
                    self._shaderToNode:.cullShadows (volumes, self._shadow.casterThreshold ())
                } else { false }
            } else { false }
        };

        if changed {
            self._window:.redrawPipeline ();
        }
    }

    /**
     * Sort the draws of the instances the camera sees front to back, the closest drawn first
     * @info: without multi-draw, the order changes when the commands are recorded again
     * */
    fn sortDraws (mut self) {
        atomic self {
            if let Ok (cam) = self._tree.camera {
                self._shaderToNode:.sort (cam.position);
            }
        }
    }

    /**
     * Select the levels of detail of the nodes from the camera, recording the commands again when one changes
     * */
    fn selectLods (mut self, delta : Duration) {
        let changed = atomic self {
            if let Ok (cam) = self._tree.camera {
                self._shaderToNode:.selectLods (cam, cast!f32 (self._height), self._lodThreshold, delta)
            } else { false }
        };

        if changed {
            self._window:.redrawPipeline ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Remove the passes and the resources of the scene from the render graph, the passes first, so the graph stays valid
     * if a frame compiles it in the middle
     * */
    fn disposeGraph (mut self) {
        self._post:.dispose ();
        self._compose:.dispose ();
        self._shadow:.dispose ();
        self._tree:.dispose ();
        self._shaderToNode:.dispose ();
        self._deferred:.dispose ();

        if self._width != 0u32 && self._height != 0u32 {
            let dmut pipeline = self._window:.getVulkanPipeline ();
            for b in copy [DRAWS, LATE_DRAWS, CULL_STATE, HZB] {
                pipeline:.removeResource (self.named (b));
            }
        }
    }

    impl Disposable {

        pub over dispose (mut self) {
            log::debug #("Scene", "dispose scene");
            self:.disposeGraph ();
        }

    }


}
