in render_settings;

use std::config;

/**
 * How the runtime of a game renders its scenes, the table [render] of project.toml
 * @info: the window itself is the table [window] BalderConfig reads
 * */
#[serializable (case-> "kebab-case")]
@data
pub record RenderSettings {

    // The resolution the Scene3D of the runtime renders at, before being scaled to the window
    pub let mut resolution: (u32, u32) = (1280u32, 720u32);
}
