/**
 * The programs the export of a game runs (gyllir, glslc, spirv-opt, tar), waited for, their output logged to a file
 * */
in process;

use balder::core::error;
use balder::game::logged_process;

use std::concurrency;

/**
 * Run a program and wait for it, its output and its errors appended to a log file
 * @params:
 *    - program: the program, found in the PATH
 *    - args: its arguments, given as they are (never read as shell syntax)
 *    - log: the file its output is appended to
 *    - cwd: the directory it runs in
 * @returns: its exit code, 127 when the program is not found
 * @throws:
 *    - &BalderError: if it cannot be started
 * */
pub fn runLogged(program: [c8], args: [[c8]], log: [c8], cwd: [c8] = ".")-> i32
    throws BalderError
{
    let dmut p = copy LoggedProcess(program, args, log, cwd-> cwd);
    p:.wait()
}

/**
 * @returns: true iif a program is found in the PATH
 * */
pub fn isInstalled(program: [c8])-> bool {
    {
        let dmut p = copy SubProcess("sh", copy ["-c", "command -v \"$1\" > /dev/null", "sh", program]);
        p:.start(redirect-> false);
        p:.wait() == 0
    } catch {
        _ => { false }
    }
}
