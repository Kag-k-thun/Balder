in export_settings;

use balder::scene::physics;

use std::config;

/**
 * How a game is exported, the table [export] of project.toml
 * */
#[serializable (case-> "kebab-case")]
@data
pub record ExportSettings {

    // The files or the folders the code of the game loads by their paths (res:/…), shipped as they are, the export
    // finding the other ones from the scenes
    pub let mut include: [[c8]] = [];

    // True iif the folder exported is also packed in an archive
    pub let mut archive: bool = false;

    // How the models of the dynamic bodies are split into convex hulls, when they have no hulls of their own
    pub let mut decomposition: DecompositionSettings = DecompositionSettings();
}
