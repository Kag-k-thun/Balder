in export_step;

/**
 * The steps of the export of a game, in their order (see GameExport)
 * */
pub enum ExportStep : u8
| CHECK         = 0u8 // the scenes read, their classes and their files found (see ResourceSet)
| DECOMPOSE     = 1u8 // the hulls of the dynamic bodies decomposed again when their model changed
| BUILD_LIBRARY = 2u8 // the library of the game built in release
| BUILD_RUNTIME = 3u8 // the runtime built in release, in the engine
| SHADERS       = 4u8 // the shaders compiled for release (see ShaderBuild)
| WRITE         = 5u8 // the files copied into the folder of the export
| ARCHIVE       = 6u8 // the folder packed in a .tar.gz, when the project asks for it
| DONE          = 7u8;
