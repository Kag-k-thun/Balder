in requests;

/**
 * Load a scene of the project by its name (the table [scenes] of project.toml), in place of the scene played, at the
 * next update of the program running the game (the runtime, or the play mode of the editor), never inside a tick
 * @info: a request made before the last one was taken replaces it
 * @example:
 * ===
 * pub over onTick(mut self, _: Duration) {
 *     if self.reachedTheDoor { changeScene("level2"); }
 * }
 * ===
 * */
pub fn changeScene(name: [c8]) {
    atomic {
        __SCENE_REQUEST__ = (name)?;
    }
}

/**
 * Quit the game at the next update of the program running it: the runtime closes, the play mode of the editor stops
 * */
pub fn quitGame() {
    atomic {
        __QUIT_REQUEST__ = true;
    }
}

/**
 * @returns: the name of the scene the game asked for since the last call (see changeScene), none when it asked for none
 * @info: called by the program running the game at each of its updates
 * */
pub fn takeSceneRequest()-> ([c8])? {
    atomic {
        let res = __SCENE_REQUEST__;
        __SCENE_REQUEST__ = none;
        res
    }
}

/**
 * @returns: true iif the game asked to quit since the last call (see quitGame)
 * @info: called by the program running the game at each of its updates
 * */
pub fn takeQuitRequest()-> bool {
    atomic {
        let res = __QUIT_REQUEST__;
        __QUIT_REQUEST__ = false;
        res
    }
}

/**
 * Drop the requests of the game not taken yet, when the program starts or stops playing it
 * */
pub fn clearGameRequests() {
    atomic {
        __SCENE_REQUEST__ = none;
        __QUIT_REQUEST__ = false;
    }
}

/**
 * The scene the game asked for and not taken yet, none when there is none
 * */
lazy mut __SCENE_REQUEST__: ([c8])? = none;

/**
 * True iif the game asked to quit and the request is not taken yet
 * */
lazy mut __QUIT_REQUEST__: bool = false;
