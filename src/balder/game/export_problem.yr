in export_problem;

/**
 * A problem the export of a game found: an error stops the export before it writes anything, a warning is told and
 * the export goes on
 * @example:
 * ```
 * ExportProblem(message-> "missing file res:/models/table.glb", scene-> "res:/scenes/main.scene", node-> "props/table")
 * ```
 * */
@data
pub record ExportProblem {

    // True for an error, false for a warning
    let mut error: bool = true;

    // What is wrong
    let mut message: [c8] = "";

    // The path of the scene file where it is (res:/…), empty when it is in no scene
    let mut scene: [c8] = "";

    // The path of the node where it is in its scene (a/b/c), empty when it is on no node
    let mut node: [c8] = "";
}
