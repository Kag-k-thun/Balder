in error;

use std::stream;

/**
 * Error thrown when an error occur in the balder engine
 */
pub class BalderError over Exception {

    // The error message explaining the error
    pub let msg: [c8];

    pub self (msg: [c8])
        with msg = msg
    {}

    impl Streamable {

        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write(self.__typeinfo__.name):.write(" ("s8);
            stream:.write(self.msg, ')');

            if (self.hasTrace()) {
                stream:.writeln(""):.write(":"s8):.write(self.getStackTrace());
            }
        }
    }
}
