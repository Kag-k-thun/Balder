in pipeline;

use balder::core::{_, driver::_};
use balder::utils::log;

use std::time::_;

use ::vulkan::core;


enum FrameDrawing
| REDRAW    = 1
| DRAWING   = 2
| SWAPPED   = 3
| AWAITED   = 4;

record PassContent {    
    pub let dmut pass : &VulkanSubpass;
    pub let mut sems : [mut [VkSemaphore]] = [];
    pub let dmut stages : [u32] = [];

    // True for the frame slots in which the pass alone has to be recorded again
    pub let dmut dirty : [bool];

    pub self (dmut pass : &VulkanSubpass, nbFrames : u32)
        with pass = alias pass
        , dirty = copy [false ; nbFrames]
    {}            
}


/**
 * A pass pipeline is a DAG of subpasses ending with the swapchain renderpass
 * The DAG of a pipeline has a particularity, nodes have only one output node, they can have mutliple entries but only one exit edge
 * */
@final
pub class VulkanPipeline {
    
    // The device to which the pipeline is attached
    let dmut _device : &VulkanDevice;
    
    prot { // pass redrawing
        
        // The frames that have been swapped already
        let dmut _updated : [FrameDrawing] = [];
    }

    prot { // deferred disposal

        // The redraw generations of the frame slots
        let dmut _generations : &SlotGenerations = copy SlotGenerations (0u32);
    }

    prot { // measures

        // The time the GPU spent on the passes of the last frame whose submission was awaited
        let mut _gpuTime : Duration = dur::micros (0u64);
    }

    prot { // pass graph

        // The list of subpasses (name => index in passgraph)
        let dmut _passes : [[c8] => &VulkanSubpass] = copy [];

        // The pass Directed Acyclic Graph
        let mut _DAG : [[c8] => mut [c8]] = copy [];        
        
        // The DAG of passes sorted by dependences
        let dmut _passGraph : [PassContent] = [];

        // The transfer subpass
        let dmut _transfer : &VulkanTransferPass;
        
        // The compose pass (out node of the pipeline DAG)
        let dmut _compose : &VulkanSubpass;        
    }

    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    pub self (dmut device : &VulkanDevice)
        with _device = alias device
        , _transfer = alias device:.getTransferPass ()
        , _compose = alias device:.getSwapchain ():.getRenderPass ()        
    {
        self:.resetToDefault ();
    }        

    __dtor (mut self) {
        self:.dispose ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SYNCHRONIZATION          =================================
     * ====================================================================================================
     * ====================================================================================================
     */        
    
    /**
     * Create the swap chain again if it is outdated, before the image of the next frame is acquired
     * */
    pub fn prepareFrame (mut self) {
        if self._device.needResize () {
            {
                self._device:.recreateSwapchain ();
                self:.forceRedraw ();
            } catch {
                err => {
                    log::error #("VulkanPipeline", "Failed to recreate swapchain", err);
                }
            }
        }
    }

    /**
     * Wait for the previous submission of the current frame to be finished, once its image is acquired
     * */
    pub fn waitPreviousFrame (mut self) {
        let frame = self._device.getCurrentFrameIndex ();        
        self._compose:.awaitRender (frame);

        // The slot only uses its current recording from now on
        let safe = atomic self {
            self:.measureGpuTime (frame);
            self._generations:.awaited (frame)
        };

        self._device:.collect (safe);
    }

    /**
     * Sum the time the passes of the previous submission of a frame slot took on the GPU, the submission being finished
     * @atomic
     * */
    prot fn measureGpuTime (mut self, frame : u32) {
        let mut total = dur::micros (0u64);
        if let Ok (t) = self._transfer:.getClock (frame):.time () {
            log::debug #("VulkanPipeline", "Stage (", frame, ") transfer took", t);
            total = total + t;
        }

        for dmut pass in alias self._passGraph {
            if let Ok (t) = pass.pass:.getClock (frame):.time () {
                log::debug #("VulkanPipeline", "Stage (", frame, ")", pass.pass.name, "took", t);
                total = total + t;
            }
        }

        self._gpuTime = total;
    }

    /**
     * Submit the current frame to the graphics and compute queues
     * */
    pub fn submitFrame (mut self) {
        let frame = self._device.getCurrentFrameIndex ();        
        if self._device:.takeRedrawRequest () {
            self:.forceRedraw ();
        }

        atomic self {                        
            if self._updated [frame] == FrameDrawing::REDRAW {                
                self._updated [frame] = FrameDrawing::DRAWING;

                // Read before recording, so an object retired while recording is never counted as unused by it
                self._generations:.recorded (frame, self._device.getGeneration ());
                                                        
                // Redraw all subpasses for the current frame
                for i in 0 .. self._passGraph.len {
                    self._passGraph [i].dirty [frame] = false;
                    self._passGraph [i].pass:.redraw (frame);
                }                
                            
                self._updated [frame] = FrameDrawing::SWAPPED;        
            } else {
                if self._updated [frame] == FrameDrawing::SWAPPED {
                    self._updated [frame] = FrameDrawing::AWAITED;
                }

                // The other passes keep their recording, and the generation it was stamped with
                for i in 0 .. self._passGraph.len if self._passGraph [i].dirty [frame] {
                    self._passGraph [i].dirty [frame] = false;
                    self._passGraph [i].pass:.redraw (frame);
                }
            }
            
            self:.submitNoDraw (frame);                        
        }

    }

    /**
     * Submit the frame to be drawn on screen without needing to redraw it
     * @atomic
     * */
    prot fn submitNoDraw (mut self, frame : u32) {
        self._transfer:.submit (frame);
        for dmut pass in alias self._passGraph {
            pass.pass:.submit (frame, pass.stages, pass.sems [frame]);
        }        
    }
    
    /**
     * Force the subpass to be redrawn, in a new generation
     * */
    pub fn forceRedraw (mut self) {        
        atomic self {            
            self._device:.advanceGeneration ();
            for i in 0 .. self._updated.len {
                self._updated [i] = FrameDrawing::REDRAW;
            }
        }

        self._device:.requestFrame ();
    }

    /**
     * Force the subpass 'pass' alone to be redrawn, the other subpasses keeping their recording
     * @warning: only for a change that the recordings of the other subpasses do not reference (an object they may
     * reference is retired, which redraws every subpass), the generation of the frame slots stays the one of their last
     * full redraw
     * */
    pub fn redrawPass (mut self, pass : &VulkanSubpass) {
        atomic self {
            for i in 0 .. self._passGraph.len if self._passGraph [i].pass is pass {
                for f in 0 .. self._passGraph [i].dirty.len {
                    self._passGraph [i].dirty [f] = true;
                }
            }
        }

        self._device:.requestFrame ();
    }

    /**
     * @returns: the time the GPU spent on the passes of the last frame whose submission was awaited, the frame being one
     * of the frames in flight before the one drawn
     * */
    pub fn getGpuTime (self)-> Duration {
        atomic self {
            self._gpuTime
        }
    }

    /**
     * @returns: true iif a frame slot, or a subpass in one, has to be recorded again
     * */
    pub fn hasPendingRedraw (self)-> bool {
        atomic self {
            let mut pending = false;
            for u in self._updated if u == FrameDrawing::REDRAW {
                pending = true;
            }

            for pass in self._passGraph {
                for d in pass.dirty if d {
                    pending = true;
                }
            }

            pending
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          DAG MANAGEMENT          =================================
     * ==================================================================== ================================
     * ====================================================================================================
     */

    /**
     * Add a subpass in the DAG
     * */
    pub fn registerSubPass (mut self, name : [c8], dmut pass : &VulkanSubpass)
        throws BalderError
    {        
        atomic self {            
            if name == "" {
                throw copy BalderError ("Empty pass name");
            }
            
            self._passes [name] = alias pass;
            self._DAG [name] = ""; // compose pass
        }
    }

    /**
     * Remove a subpass in the DAG
     * @warning: connect the passes having 'name' as output to the output of 'name'
     * */
    pub fn removeSubPass (mut self, name : [c8])
        throws BalderError
    {        
        atomic self {            
            self._passes:.remove (name);        

            // Connect the predecessor of 'name' to the output of 'name'        
            if let Ok (out) = self._DAG [name] {
                
                let mut result : [[c8] => mut [c8]] = copy [];
                for i, o in self._DAG if i != name {                
                    if o == name {
                        result [i] = out;
                    } else {
                        result [i] = o;
                    }
                }
                self._DAG = alias result;
                self:.constructGraph ();
            }                
        }
    }

    /**
     * Change the output pass of the pass 'name'
     * @throws: if a cycle is detected or the pass don't exist
     * */
    pub fn setPassOutput (mut self, name : [c8], output : [c8]) 
        throws BalderError
    {        
        atomic self {            
            if name == "" throw copy BalderError ("Empty pass name");
            if output == "" throw copy BalderError ("Empty pass name");
            
            if output !in self._passes throw copy BalderError ("No pass named " ~ output);
            if name !in self._passes throw copy BalderError ("No pass named " ~ name);
            
            self._DAG [name] = output;            
        
            self:.constructGraph (); 
        }
    }

    /**
     * Set the pass output as the swapchain final pass
     * @throws: if the pass doesn't exist
     * */
    pub fn setPassOutputToSwap (mut self, name : [c8])
        throws BalderError
    {        
        atomic self {            
            if name == "" throw copy BalderError ("Empty pass name");
            if name !in self._passes throw copy BalderError ("No pass named " ~ name);
            
            self._DAG [name] = "";
            self:.constructGraph ();        
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          CONSTRUCTION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reset the drawing pipeline to its default state (only the final compose pass)
     * */
    fn resetToDefault (mut self) {        
        atomic self {            
            let dmut content = PassContent (alias self._compose, self._device.getNbFrames ());                
            
            content.stages = copy [VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT];
            content.sems = copy [copy [self._transfer.getSemaphore (i)] for i in 0 .. self._device.getNbFrames ()];        
            
            self._passGraph = copy [content];    
            self._updated = copy [FrameDrawing::REDRAW ; self._device.getNbFrames ()];
            self._generations = copy SlotGenerations (self._device.getNbFrames ());
            self._passes [""] = alias self._compose;
        }
    }
    
    /**
     * Construct the graph of pass dependencies, and construct the semaphores lists
     * */
    fn constructGraph (mut self)
        throws BalderError
    {        
        let (sortedPass, deps) = self.constructSortedList ();
        let nbFrames = self._device:.getSwapchain ().nbFrames;
        let dmut result : [PassContent] = [];                
        
        for pname in sortedPass {
            let mut sems : [mut [VkSemaphore]] = copy [[] ; nbFrames];
            let dmut stages : [u32] = [];

            // List the semaphores of predecessor passes
            if let Ok (lst) = deps [pname] for previous in lst {
                if let Ok (pass : &DrawSubpass) = self._passes [previous] {
                    stages ~= [VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT];
                    for f in 0 .. nbFrames {                    
                        sems [f] ~= [pass.getSemaphore (f)];
                    }
                } else if let Ok (pass : &ComputeSubpass) = self._passes [previous] {
                    stages ~= [VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT];
                    for f in 0 .. nbFrames {
                        sems [f] ~= [pass.getSemaphore (f)];
                    }
                } else {
                    log::error #("VulkanPipeline", "Undefined subpass kind :", previous, " ", self._passes [previous]);
                    throw copy BalderError ("Failed to contrusct pass graph");
                }
            }            
            
            // Then it's an entry node, and it depends on transfer pass
            if stages.len == 0 {                                
                stages = copy [VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT];
                sems = copy [copy [self._transfer.getSemaphore (f)] for f in 0 .. self._device.getNbFrames ()];                
            }

            // Adding it on the result graph
            if let Ok (dmut p) = alias self._passes [pname] {
                let dmut content = PassContent (alias p, nbFrames);
                content.sems = alias sems;
                content.stages = alias stages;                
                
                result ~= [alias content];                
            } else {
                log::error #("VulkanPipeline", "malformed graph", self._passes, '(', pname, ')');
                panic;
            }             
        }

        self:.forceRedraw ();
        self._passGraph = alias result;        
    }

    /**
     * Sorted the passes by dependencies
     * */
    fn constructSortedList (self)-> ([[c8]], [[c8] => [[c8] => ()]])
        throws BalderError
    {
        let dmut reversed = self.reverseGraph (self._DAG);        
        let dmut deps = dcopy reversed;
                
        let mut result : [mut [c8]] = [];

        while reversed.len != 0 {
            let mut fnd : [c8] = "";
            let mut hasFnd = false;
            for i, lst in reversed {
                if lst.len == 0 {
                    result ~= [i];
                    hasFnd = true;
                    fnd = i;
                    break;
                }
            }
                
            if !hasFnd {
                log::error #("Pipeline", "failed", reversed);
                throw copy BalderError ("Failed to construct graph, cycle detected");
            }

            // Remove the node from dependencies
            reversed:.remove (fnd);            
            for _, dmut lst in alias reversed {                
                lst:.remove (fnd);            
            }                                
        }

        (result, deps)
    }

    /**
     * @returns: the reversed graph, where every node list its predecessors
     * */
    fn reverseGraph (self, graph : [[c8] => [c8]])-> dmut [[c8] => [[c8] => ()]] {
        let dmut result : [[c8] => [[c8] => ()]] = copy [];
        for i, out in graph {
            if let Ok (dmut lst) = alias result [out] {
                lst [i] = ();                 
            } else {
                result [out] = copy [i => ()];
            }

            if i !in result {
                result [i] = copy [];
            }
        }

        alias result
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    impl Disposable {
        pub over dispose (mut self) {            
            atomic self {                
                self._device:.waitIdle ();                                                
                for dmut pass in alias self._passGraph {
                    if pass.pass !is self._compose {
                        pass.pass:.dispose ();
                    }
                }                
                
                self._compose:.resetCommands ();
                self._compose:.resetDrawSignal ();

                self:.resetToDefault ();
                for i in 0 .. self._updated.len {
                    self._updated [i] = FrameDrawing::REDRAW;
                }                
            }

            // Nothing is recorded nor in flight anymore
            self._device:.drainRetired ();
        }
    }
}
