in scheduled_pass;

/**
 * A pass of a compiled render graph, recorded after the barriers it needs
 * */
@data
pub record ScheduledPass {

    // The name of the pass
    pub let name: [c8] = "";

    // What the pass records
    pub let kind: PassKind = PassKind::RASTER;

    // The barriers recorded before the pass
    pub let barriers: [GraphBarrier] = [];

    // The recording of the pass, none to emit the onDraw signal of its subpass
    pub let recording: (dg ()-> void)? = none;

}
