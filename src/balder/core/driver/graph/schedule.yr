in schedule;

/**
 * A compiled render graph: the subpasses of a frame in the order they are submitted, their passes in the order they are
 * recorded, and the semaphores between them
 * */
@data
pub record RenderSchedule {

    // The subpasses, in the order of their submission, the subpass of the screen last
    pub let submissions: [ScheduledSubmission] = [];

    // The dependencies between the subpasses, a semaphore per frame in flight each
    pub let edges: [GraphEdge] = [];

    // The resources the passes of a frame use, in the order they are first used
    pub let lifetimes: [ResourceLifetime] = [];

}
