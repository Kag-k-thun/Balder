in submission;

/**
 * A subpass of a compiled render graph, submitted once the subpasses it depends on signaled it
 * */
@data
pub record ScheduledSubmission {

    // The name of the subpass
    pub let name: [c8] = "";

    // Its passes, in the order they are recorded
    pub let passes: [ScheduledPass] = [];

    // The edges the subpass waits for, indices in the edges of the schedule
    pub let waits: [usize] = [];

    // The edges the subpass signals, indices in the edges of the schedule
    pub let signals: [usize] = [];

}
