in pass;

/**
 * A pass of a render graph: what it records, in which subpass, and the resources it uses
 * @info: the passes of a subpass are recorded in its command buffer, one after the other, the graph recording the
 * barriers between them; the subpasses are submitted in the order of their dependencies, waiting for each other through
 * semaphores
 * */
@data
pub record GraphPass {

    // The name of the pass
    pub let name: [c8] = "";

    // The name of the subpass recording the pass (see VulkanPipeline::registerSubPass)
    pub let submission: [c8] = "";

    // What the pass records
    pub let kind: PassKind = PassKind::RASTER;

    // The resources the pass uses, a resource used several ways listed once per usage
    pub let uses: [ResourceUse] = [];

    // The recording of the pass, called while its subpass is recorded, none to emit the onDraw signal of the subpass
    pub let recording: (dg ()-> void)? = none;

    // False while the pass is not recorded, the passes of a frame being those enabled
    pub let enabled: bool = true;

}
