in alias_span;

/**
 * A transient image to place in the memory of a render graph: the passes of a frame using it, and the memory it needs
 * */
@data
pub record AliasSpan {

    // The name of the image
    pub let name: [c8] = "";

    // The first pass using the image, its position in the passes of the frame
    pub let first: usize = 0us;

    // The last pass using the image, its position in the passes of the frame
    pub let last: usize = 0us;

    // The size of the memory of an image
    pub let size: usize = 0us;

    // The alignment of the memory of an image
    pub let alignment: usize = 1us;

    // The memory types an image can be bound into
    pub let typeBits: u32 = 0u32;

}
