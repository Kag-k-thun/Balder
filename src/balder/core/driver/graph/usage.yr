in usage;

use balder::core::driver::graph::access;

use ::vulkan::core;

/**
 * How a pass of a render graph uses a resource, the stages and the accesses its barriers wait for and make visible
 * @info: an attachment is left by the render pass of the subpass in the layout its readers sample it with (see
 * DrawSubpass), the graph transitioning the other images only
 * */
pub enum Usage
| COLOR_ATTACHMENT   = 0u8  // a color attachment of the render pass of a raster pass, written
| DEPTH_ATTACHMENT   = 1u8  // the depth attachment of the render pass of a raster pass, tested and written
| SAMPLED_FRAGMENT   = 2u8  // an image sampled by the fragment shaders of a raster pass
| SAMPLED_COMPUTE    = 3u8  // an image sampled by the compute shaders of a compute pass
| STORAGE_READ       = 4u8  // a storage image or buffer read by compute shaders
| STORAGE_WRITE      = 5u8  // a storage image or buffer written by compute shaders, overwriting what it held
| STORAGE_READ_WRITE = 6u8  // a storage image or buffer read and written by compute shaders
| INDIRECT           = 7u8  // a buffer of the commands, or of their number, read by indirect draws
| VERTEX_READ        = 8u8; // a storage buffer read by vertex shaders

/**
 * @returns: the stages, the accesses and the layout of a usage
 * */
pub fn describe(usage: Usage)-> UsageAccess {
    let colorRead = VkImageLayout::VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
    let depthRead = VkImageLayout::VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL;
    let general = VkImageLayout::VK_IMAGE_LAYOUT_GENERAL;
    let undefined = VkImageLayout::VK_IMAGE_LAYOUT_UNDEFINED;

    let compute = cast!u32(VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
    let shaderRead = cast!u32(VkAccessFlagBits::VK_ACCESS_SHADER_READ_BIT);
    let shaderWrite = cast!u32(VkAccessFlagBits::VK_ACCESS_SHADER_WRITE_BIT);

    match usage {
        Usage::COLOR_ATTACHMENT => {
            UsageAccess(name-> "color attachment",
                        stage-> VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
                        access-> VkAccessFlagBits::VK_ACCESS_COLOR_ATTACHMENT_READ_BIT
                                 | VkAccessFlagBits::VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
                        writes-> true,
                        attachment-> true,
                        colorLayout-> colorRead,
                        depthLayout-> depthRead)
        }
        Usage::DEPTH_ATTACHMENT => {
            UsageAccess(name-> "depth attachment",
                        stage-> VkPipelineStageFlagBits::VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT
                                | VkPipelineStageFlagBits::VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
                        access-> VkAccessFlagBits::VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT
                                 | VkAccessFlagBits::VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT,
                        writes-> true,
                        attachment-> true,
                        colorLayout-> colorRead,
                        depthLayout-> depthRead)
        }
        Usage::SAMPLED_FRAGMENT => {
            UsageAccess(name-> "sampled by fragments",
                        stage-> VkPipelineStageFlagBits::VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
                        access-> shaderRead,
                        reads-> true,
                        colorLayout-> colorRead,
                        depthLayout-> depthRead)
        }
        Usage::SAMPLED_COMPUTE => {
            UsageAccess(name-> "sampled by compute",
                        stage-> compute,
                        access-> shaderRead,
                        reads-> true,
                        colorLayout-> colorRead,
                        depthLayout-> depthRead)
        }
        Usage::STORAGE_READ => {
            UsageAccess(name-> "storage read",
                        stage-> compute,
                        access-> shaderRead,
                        reads-> true,
                        colorLayout-> general,
                        depthLayout-> general)
        }
        Usage::STORAGE_WRITE => {
            UsageAccess(name-> "storage write",
                        stage-> compute,
                        access-> shaderWrite,
                        writes-> true,
                        colorLayout-> general,
                        depthLayout-> general)
        }
        Usage::STORAGE_READ_WRITE => {
            UsageAccess(name-> "storage read write",
                        stage-> compute,
                        access-> shaderRead | shaderWrite,
                        reads-> true,
                        writes-> true,
                        colorLayout-> general,
                        depthLayout-> general)
        }
        Usage::INDIRECT => {
            UsageAccess(name-> "indirect commands",
                        stage-> VkPipelineStageFlagBits::VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT,
                        access-> VkAccessFlagBits::VK_ACCESS_INDIRECT_COMMAND_READ_BIT,
                        reads-> true,
                        colorLayout-> undefined,
                        depthLayout-> undefined)
        }
        Usage::VERTEX_READ => {
            UsageAccess(name-> "read by vertices",
                        stage-> VkPipelineStageFlagBits::VK_PIPELINE_STAGE_VERTEX_SHADER_BIT,
                        access-> shaderRead,
                        reads-> true,
                        colorLayout-> undefined,
                        depthLayout-> undefined)
        }
    }
}

/**
 * @returns: true iif a usage applies to images only
 * */
pub fn isImageOnly(usage: Usage)-> bool {
    usage == Usage::COLOR_ATTACHMENT
    || usage == Usage::DEPTH_ATTACHMENT
    || usage == Usage::SAMPLED_FRAGMENT
    || usage == Usage::SAMPLED_COMPUTE
}

/**
 * @returns: true iif a usage applies to buffers only
 * */
pub fn isBufferOnly(usage: Usage)-> bool {
    usage == Usage::INDIRECT || usage == Usage::VERTEX_READ
}

/**
 * @returns: true iif a usage belongs to a raster pass, false if it belongs to a compute pass
 * */
pub fn isRaster(usage: Usage)-> bool {
    usage == Usage::COLOR_ATTACHMENT
    || usage == Usage::DEPTH_ATTACHMENT
    || usage == Usage::SAMPLED_FRAGMENT
    || usage == Usage::INDIRECT
    || usage == Usage::VERTEX_READ
}
