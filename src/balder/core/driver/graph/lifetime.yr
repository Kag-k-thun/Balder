in lifetime;

use ::vulkan::core;

/**
 * The passes of a frame using a resource of a compiled render graph
 * */
@data
pub record ResourceLifetime {

    // The name of the resource
    pub let name: [c8] = "";

    // The first pass using the resource, its position in the passes of the frame
    pub let first: usize = 0us;

    // The last pass using the resource, its position in the passes of the frame
    pub let last: usize = 0us;

    // The layout an image is left in by the frame, the one a persistent image starts the next frame in
    pub let layout: VkImageLayout = VkImageLayout::VK_IMAGE_LAYOUT_UNDEFINED;

}
