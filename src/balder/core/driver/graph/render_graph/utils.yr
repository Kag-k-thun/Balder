in utils;

use balder::core::driver::graph::{access, usage};

use ::vulkan::core;

/**
 * @returns: the resources a pass uses, each once, in the order of their first use
 * */
pub fn resourcesOf(pass: GraphPass)-> [[c8]] {
    let mut result: [[c8]] = [];
    for u in pass.uses if !contains(result, u.resource) {
        result = result ~ [u.resource];
    }

    result
}

/**
 * @returns: the uses of a resource by a pass merged into one: their stages and accesses, reading or writing when one of
 * them does, the layouts of the first one of them
 * */
pub fn accessOf(pass: GraphPass, resource: [c8])-> UsageAccess {
    let mut found = false;
    let mut result = UsageAccess();
    for u in pass.uses if u.resource == resource {
        let a = describe(u.usage);
        if !found {
            found = true;
            result = a;
        } else {
            result = UsageAccess(name-> result.name ~ ", " ~ a.name,
                                 stage-> result.stage | a.stage,
                                 access-> result.access | a.access,
                                 reads-> result.reads || a.reads,
                                 writes-> result.writes || a.writes,
                                 attachment-> result.attachment || a.attachment,
                                 colorLayout-> result.colorLayout,
                                 depthLayout-> result.depthLayout);
        }
    }

    result
}

/**
 * @returns: the resource of the uses of a pass that two of them need in different layouts, none if there is none
 * */
pub fn layoutConflict(pass: GraphPass, depth: dg ([c8])-> bool)-> ([c8])? {
    for i, u in pass.uses {
        let a = describe(u.usage);
        for v in pass.uses[i + 1us .. $] if v.resource == u.resource {
            let b = describe(v.usage);
            let d = depth(u.resource);
            let la = if d { a.depthLayout } else { a.colorLayout };
            let lb = if d { b.depthLayout } else { b.colorLayout };
            if la != lb || a.attachment != b.attachment {
                return u.resource?;
            }
        }
    }

    none
}

/**
 * @returns: the write accesses of a mask of accesses, the reads of a source scope making nothing available
 * */
pub fn writesOf(access: u32)-> u32 {
    let writes = VkAccessFlagBits::VK_ACCESS_SHADER_WRITE_BIT
                 | VkAccessFlagBits::VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT
                 | VkAccessFlagBits::VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT
                 | VkAccessFlagBits::VK_ACCESS_TRANSFER_WRITE_BIT
                 | VkAccessFlagBits::VK_ACCESS_HOST_WRITE_BIT
                 | VkAccessFlagBits::VK_ACCESS_MEMORY_WRITE_BIT;

    access & writes
}

/**
 * @returns: true iif a list holds a value
 * */
pub fn contains {T} (lst: [T], value: T)-> bool {
    for v in lst if v == value {
        return true;
    }

    false
}

/**
 * @returns: resources sorted by name
 * */
pub fn sortByName(lst: [GraphResource])-> [GraphResource] {
    let mut result: [GraphResource] = [];
    for r in lst {
        let mut at = result.len;
        for j, o in result if at == result.len && r.name < o.name {
            at = j;
        }

        result = result[0us .. at] ~ [r] ~ result[at .. $];
    }

    result
}
