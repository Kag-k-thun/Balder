in edge;

/**
 * The index of the transfers of a frame, the source of the edges reaching the subpasses that depend on no other one
 * */
pub def TRANSFER = usize::max;

/**
 * A dependency between two subpasses of a render graph, a semaphore signaled by the first one and awaited by the second
 * one
 * */
@data
pub record GraphEdge {

    // The index of the subpass signaling the semaphore in the schedule, TRANSFER for the transfers of the frame
    pub let from: usize = 0us;

    // The index of the subpass awaiting the semaphore in the schedule
    pub let to: usize = 0us;

    // The stages of the subpass awaiting the semaphore that wait for it
    pub let stage: u32 = 0u32;

    // The resources the dependency is made of, none for an edge ordering the transfers or the end of the frame
    pub let resources: [[c8]] = [];

}
