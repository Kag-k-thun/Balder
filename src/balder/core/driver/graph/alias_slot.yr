in alias_slot;

/**
 * A memory shared by transient images that no pass of a frame uses at the same time
 * */
@data
pub record AliasSlot {

    // The images sharing the memory, in the order of their first use
    pub let members: [AliasSpan] = [];

    // The size of the memory, the largest of the images
    pub let size: usize = 0us;

    // The alignment of the memory, the largest of the images
    pub let alignment: usize = 1us;

    // The memory types every image can be bound into
    pub let typeBits: u32 = 0u32;

}
