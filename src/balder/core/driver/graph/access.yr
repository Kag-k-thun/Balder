in access;

use ::vulkan::core;

/**
 * The stages, the accesses and the layout of a usage of a resource by a pass of a render graph
 * */
@data
pub record UsageAccess {

    // The name of the usage, in the exported graph
    pub let name: [c8] = "";

    // The pipeline stages accessing the resource
    pub let stage: u32 = 0u32;

    // The accesses of those stages
    pub let access: u32 = 0u32;

    // True iif the usage reads what the resource held before the pass (an attachment is cleared or loaded by the
    // render pass of its subpass, it reads nothing for the graph)
    pub let reads: bool = false;

    // True iif the usage writes the resource
    pub let writes: bool = false;

    // True iif the resource is an attachment of the render pass of the pass, which transitions it
    pub let attachment: bool = false;

    // The layout of a color image during the usage, the one the render pass leaves an attachment in
    pub let colorLayout: VkImageLayout = VkImageLayout::VK_IMAGE_LAYOUT_UNDEFINED;

    // The layout of a depth image during the usage, the one the render pass leaves an attachment in
    pub let depthLayout: VkImageLayout = VkImageLayout::VK_IMAGE_LAYOUT_UNDEFINED;

}
