in resource;

use balder::core::driver::graph::image_desc;

/**
 * A resource of a render graph, named by the uses of its passes
 * @info: an imported resource is owned by the code declaring it, the graph only deriving its barriers; a transient image
 * is owned by the graph, which allocates it while a pass uses it, and lets the images whose uses do not overlap in a
 * frame share their memory; a persistent image is owned by the graph too, one image for every frame, a frame starting
 * where the frame before it left it
 * */
@data
pub record GraphResource {

    // The name of the resource
    pub let name: [c8] = "";

    // True iif the resource is an image, a buffer otherwise
    pub let image: bool = false;

    // True iif the resource is a depth image
    pub let depth: bool = false;

    // True iif the graph owns the image, its content lasting one frame
    pub let transient: bool = false;

    // True iif the graph owns the image, its content kept from a frame to the next
    pub let persistent: bool = false;

    // The description of an image the graph owns
    pub let desc: ImageDesc = ImageDesc();

}
