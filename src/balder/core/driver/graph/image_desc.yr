in image_desc;

use ::vulkan::core;

/**
 * The description of an image a render graph owns: a transient image, allocated for each frame in flight, or a
 * persistent one, the same image for every frame
 * */
@data
pub record ImageDesc {

    // The format of the image
    pub let format: VkFormat = VkFormat::VK_FORMAT_UNDEFINED;

    // The width of the image, in texels
    pub let width: u32 = 0u32;

    // The height of the image, in texels
    pub let height: u32 = 0u32;

    // True iif the image is a depth image, a color image otherwise
    pub let depth: bool = false;

    // True iif compute shaders write the image as a storage image
    pub let storage: bool = false;

    // True iif the image keeps its content from a frame to the next (a history): one image read and written by every
    // frame, never sharing its memory, its content undefined when it is created
    pub let persistent: bool = false;

}
