in barrier;

use ::vulkan::core;

/**
 * A barrier of a resource recorded before a pass of a render graph, from the accesses of the passes of the same subpass
 * before it, or a layout transition of an image
 * @info: the accesses of the passes of other subpasses are awaited through the semaphores of the submission, a barrier
 * transitioning an image waiting for the stages of its use, those the semaphores are awaited at
 * */
@data
pub record GraphBarrier {

    // The name of the resource
    pub let resource: [c8] = "";

    // True iif the resource is an image
    pub let image: bool = false;

    // True iif the image is a depth image
    pub let depth: bool = false;

    // The stages of the accesses waited for
    pub let srcStage: u32 = 0u32;

    // The accesses made available
    pub let srcAccess: u32 = 0u32;

    // The stages waiting
    pub let dstStage: u32 = 0u32;

    // The accesses the content is made visible to
    pub let dstAccess: u32 = 0u32;

    // The layout of the image before the barrier, undefined when its content is discarded
    pub let oldLayout: VkImageLayout = VkImageLayout::VK_IMAGE_LAYOUT_UNDEFINED;

    // The layout of the image after the barrier, the same as oldLayout when the image is not transitioned
    pub let newLayout: VkImageLayout = VkImageLayout::VK_IMAGE_LAYOUT_UNDEFINED;

}
