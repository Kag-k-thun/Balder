in resource_use;

/**
 * The use of a resource by a pass of a render graph
 * */
@data
pub record ResourceUse {

    // The name of the resource
    pub let resource: [c8] = "";

    // How the pass uses the resource
    pub let usage: Usage = Usage::SAMPLED_FRAGMENT;

    // True iif the use is dropped when no pass writes the resource before it in a frame, or when the resource is not
    // declared (the shadow map of a scene while no light casts shadows), the compilation failing otherwise
    pub let optional: bool = false;

}
