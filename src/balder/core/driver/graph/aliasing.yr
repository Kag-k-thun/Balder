in aliasing;

/**
 * Place transient images in slots of memory, the images of a slot used by no pass at the same time and accepting the
 * same memory types
 * @info: an image goes in the slot it grows the least, a new slot when none fits
 * @params:
 *    - spans: the images, in the order of their first use
 * @returns: the slots
 * */
pub fn planSlots(spans: [AliasSpan])-> [AliasSlot] {
    let mut slots: [AliasSlot] = [];
    for span in spans {
        let mut best = slots.len;
        let mut bestGrowth = usize::max;
        for i, slot in slots {
            if (slot.typeBits & span.typeBits) == 0u32 { continue; }

            let mut overlaps = false;
            for m in slot.members if !(m.last < span.first || span.last < m.first) {
                overlaps = true;
            }

            if overlaps { continue; }

            let growth = if span.size > slot.size { span.size - slot.size } else { 0us };
            if growth < bestGrowth {
                best = i;
                bestGrowth = growth;
            }
        }

        if best == slots.len {
            slots = slots ~ [AliasSlot(members-> copy [span], size-> span.size, alignment-> span.alignment, typeBits-> span.typeBits)];
        } else {
            let slot = slots[best];
            let merged = AliasSlot(members-> slot.members ~ [span],
                                   size-> if span.size > slot.size { span.size } else { slot.size },
                                   alignment-> if span.alignment > slot.alignment { span.alignment } else { slot.alignment },
                                   typeBits-> slot.typeBits & span.typeBits);
            slots = slots[0us .. best] ~ [merged] ~ slots[best + 1us .. $];
        }
    }

    slots
}
