in indexed;

use balder::core::driver::subpass;
use balder::core::shader::buffers::{batch, instance_batch};

use std::algorithm::comparison;

use ::vulkan::core;

/**
 * The indexed command allocator draws the runs of commands a recording laid out in draw batches
 */
@final
pub class IndexedDrawCommandAllocator over CommandAllocator {

    /**
     * Create an indexed command allocator drawing in the current recording of a subpass
     * @params:
     *    - pass: the subpass being recorded
     */
    pub self (dmut pass: &DrawSubpass)
        with super(alias pass)
    {}

    /**
     * ======================================================================================================
     * ======================================================================================================
     * ==========================================   DRAWING PHASE   =========================================
     * ======================================================================================================
     * ======================================================================================================
     */

    /**
     * Draw a run of the commands laid out in a batch by the recording of the current frame, with one draw indirect call
     * when the device has multi-draw (more when the run is longer than the device allows), one draw per command
     * otherwise
     * @info: without multi-draw the commands are read at the recording, a command modified in place is drawn once the
     * recording is done again
     * @assume: the buffers, the shader and the descriptor sets of the run are bound, the batch layout of the frame ended
     * @params:
     *    - batch: the batch holding the commands
     *    - first: the index of the first command of the run
     *    - count: the number of commands of the run
     */
    pub fn drawIndexed(mut self, batch: &DrawBatch, first: u32, count: u32) {
        self:.drawRun(batch, first, count);
    }

    /**
     * Draw a run of the instanced commands built in a batch for the current frame, as a run of a DrawBatch
     * @assume: the buffers, the shader and the descriptor sets of the run are bound, the batch layout of the frame ended
     * @params:
     *    - batch: the batch holding the commands
     *    - first: the index of the first command of the run
     *    - count: the number of commands of the run
     */
    pub fn drawIndexed(mut self, batch: &InstanceBatch, first: u32, count: u32) {
        self:.drawRun(batch, first, count);
    }

    /**
     * Draw the commands a phase of the cull pass of a batch wrote for the current frame, with one draw indirect count call
     * reading their number in the counters of the batch
     * @info: does nothing unless the batch was laid out for the current frame to be culled on the GPU
     * @assume: the buffers, the shader and the descriptor sets of the batch are bound, the commands of the phase were
     * written before the render pass began (see CullCommandAllocator)
     * @params:
     *    - batch: the batch culled on the GPU
     *    - late: false for the commands of the first phase, true for those of the second one (see InstanceBatch)
     */
    pub fn drawIndexedCount(mut self, batch: &InstanceBatch, late: bool) {
        let frame = self._pass.getCurrentFrame();
        let maxCount = min(batch.getCount(frame), self._device.getMaxDrawCount());
        if maxCount == 0u32 { return; }

        if let Ok(commands) = batch.getCulledCommandBuffer(frame) {
            if let Ok(counters) = batch.getCounterBuffer(frame) {
                vkCmdDrawIndexedIndirectCount(self.getCommandBuffer(),
                                              commands.getVulkanBuffer(),
                                              batch.getCulledCommandOffset(frame, late),
                                              counters.getVulkanBuffer(),
                                              batch.getCountOffset(late),
                                              maxCount,
                                              cast!u32(VkDrawIndexedIndirectCommand::size));
            }
        }
    }

    /**
     * Draw a run of the commands of a DrawBatch or of an InstanceBatch
     */
    fn drawRun {B} (mut self, batch: B, first: u32, count: u32) {
        let frame = self._pass.getCurrentFrame();
        let cmd   = self.getCommandBuffer();

        if self._device.isMultiDraw() {
            let buffer = batch.getVulkanBuffer(frame);
            if buffer == null { return; }

            let maxCount = self._device.getMaxDrawCount();
            let mut done = 0u32;
            while done < count {
                let nb = min(count - done, maxCount);
                vkCmdDrawIndexedIndirect(cmd,
                                         buffer,
                                         cast!u64(first + done) * cast!u64(VkDrawIndexedIndirectCommand::size),
                                         nb,
                                         cast!u32(VkDrawIndexedIndirectCommand::size));
                done += nb;
            }
        } else {
            for i in first .. first + count {
                let c = batch.getCommand(frame, i);
                if c.indexCount == 0u32 || c.instanceCount == 0u32 { continue; }

                vkCmdDrawIndexed(commandBuffer-> cmd,
                                 indexCount-> c.indexCount,
                                 instanceCount-> c.instanceCount,
                                 firstIndex-> c.firstIndex,
                                 vertexOffset-> c.vertexOffset,
                                 firstInstance-> c.firstInstance);
            }
        }
    }
}
