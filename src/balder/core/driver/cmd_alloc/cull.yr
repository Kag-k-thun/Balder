in cull;

use balder::core::config::shader::uniform;
use balder::core::driver::subpass;
use balder::core::shader;
use balder::core::shader::buffers::instance_batch;

use ::vulkan::core;

/**
 * The phase of the cull pass listing the candidates whose object the camera sees
 * */
def OBJECTS_PHASE = 0u32;

/**
 * The phase of the cull pass culling the clusters of the candidates listed, writing a command per cluster seen
 * */
def CLUSTERS_PHASE = 1u32;

/**
 * The phase of the cull pass testing the clusters of the candidates listed against the depth pyramid, once the first
 * commands are drawn, writing a command per cluster the first phase did not draw
 * */
def LATE_CLUSTERS_PHASE = 2u32;

/**
 * The push constant of the cull shader
 * */
@data
record CullPush {

    // The number of candidates
    pub let count: u32;

    // The phase of the pass
    pub let phase: u32;

    // The height of the view, in pixels
    pub let height: f32;

    // The size on screen in pixels under which an instance is culled
    pub let minPixels: f32;

    // The width of the view, in pixels
    pub let width: f32;

    // The number of levels of the depth pyramid, 0 when the occluded clusters are not culled
    pub let levels: u32;

    // The number of clusters each phase culls at most, the commands of the second phase following as many of the first
    pub let capacity: u32;

    pub let pad: u32;
}

/**
 * The cull command allocator records the cull passes of the batches culled on the GPU, outside of the render pass of a
 * draw subpass: the counters of the batches cleared, the objects of the candidates culled, the clusters of those seen
 * culled (a command written per cluster seen), then the counters copied for the CPU, each step of every batch separated
 * from the next one by a barrier
 * @info: the steps are recorded for every batch before the next one starts, so the batches share the barriers:
 *    - clear of each batch, afterClear
 *    - cullObjects of each batch, afterObjects
 *    - cullClusters of each batch
 *    - beforeReadBack, readBack of each batch, afterReadBack
 * @info: the draws read the commands and the instances written once the render graph made them visible, the cull pass
 * being a compute pass of the graph writing them
 * @info: when the occluded clusters are culled, the clusters are culled a second time (late), after the first commands
 * were drawn and their depth reduced into the depth pyramid, from the candidates the first phase listed; the counters
 * are read back after the second commands
 * @assume: recorded by a compute pass of a render graph, outside of the render pass of the subpass
 * */
@final
pub class CullCommandAllocator over CommandAllocator {

    /**
     * Create a cull command allocator recording in the current recording of a subpass
     * @params:
     *    - pass: the subpass being recorded
     * */
    pub self (dmut pass: &DrawSubpass)
        with super(alias pass)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STEPS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Clear the counters of the cull pass of a batch
     * @info: does nothing unless the batch was laid out for the current frame to be culled on the GPU
     * */
    pub fn clear(mut self, batch: &InstanceBatch) {
        let frame = self._pass.getCurrentFrame();
        if let Ok(counters) = batch.getCounterBuffer(frame) {
            vkCmdFillBuffer(self.getCommandBuffer(), counters.getVulkanBuffer(), 0u64, cast!u64(counters.getSize()), 0u32);
        }
    }

    /**
     * List the candidates of a batch whose object the camera sees, and the size of the dispatch of their clusters
     * @assume: the counters of the batch are cleared, the cull shader and the descriptor sets of the batch are bound
     * @params:
     *    - shader: the cull shader
     *    - batch: the batch, nothing being done unless it was laid out for the current frame to be culled on the GPU
     *    - width: the width of the view, in pixels
     *    - height: the height of the view, in pixels
     *    - minPixels: the size on screen in pixels under which an object is culled, 0 to cull those outside the view only
     * */
    pub fn cullObjects(mut self, dmut shader: &ComputeShader, batch: &InstanceBatch, width: f32, height: f32, minPixels: f32) {
        let frame = self._pass.getCurrentFrame();
        let count = batch.getCount(frame);
        if count == 0u32 || !batch.isCulled(frame) { return; }

        let groupSize = shader.getGroupSizes()[0];
        if groupSize == 0u32 { return; }

        let cmd = self.getCommandBuffer();
        shader:.setPush(cmd,
                        UniformNames::CULL,
                        CullPush(count, OBJECTS_PHASE, height, minPixels, width, 0u32, batch.getCulledCapacity(frame), 0u32));
        vkCmdDispatch(cmd, (count + groupSize - 1u32) / groupSize, 1u32, 1u32);
    }

    /**
     * Cull the clusters of the candidates of a batch listed by cullObjects, a workgroup per candidate, writing a command
     * drawing each cluster seen and the word of its instance
     * @assume: the objects of the batch are culled and their dispatch made visible (see afterObjects), the cull shader and
     * the descriptor sets of the batch are bound
     * @params:
     *    - shader: the cull shader
     *    - batch: the batch, nothing being done unless it was laid out for the current frame to be culled on the GPU
     *    - late: false for the first cull, drawing the clusters the last pass saw (all of them when the occluded clusters
     *            are not culled), true for the second one, testing the clusters against the depth pyramid
     *    - width: the width of the view, in pixels
     *    - height: the height of the view, in pixels
     *    - levels: the number of levels of the depth pyramid, 0 when the occluded clusters are not culled
     * */
    pub fn cullClusters(mut self, dmut shader: &ComputeShader, batch: &InstanceBatch, late: bool, width: f32, height: f32, levels: u32) {
        let frame = self._pass.getCurrentFrame();
        let count = batch.getCount(frame);
        if count == 0u32 || !batch.isCulled(frame) { return; }

        if let Ok(counters) = batch.getCounterBuffer(frame) {
            let cmd = self.getCommandBuffer();
            let phase = if late { LATE_CLUSTERS_PHASE } else { CLUSTERS_PHASE };
            shader:.setPush(cmd,
                            UniformNames::CULL,
                            CullPush(count, phase, height, 0.0f, width, levels, batch.getCulledCapacity(frame), 0u32));
            vkCmdDispatchIndirect(cmd, counters.getVulkanBuffer(), batch.getDispatchOffset());
        }
    }

    /**
     * Copy the header of the counters of a batch for the CPU, read once the submission of the frame is over
     * @assume: the commands of the batch are written
     * */
    pub fn readBack(mut self, batch: &InstanceBatch) {
        let frame = self._pass.getCurrentFrame();
        if let Ok(counters) = batch.getCounterBuffer(frame) {
            if let Ok(readback) = batch.getReadbackBuffer(frame) {
                let mut region = VkBufferCopy();
                region.size = cast!u64(batch.getCounterHeaderSize());

                vkCmdCopyBuffer(self.getCommandBuffer(), counters.getVulkanBuffer(), readback.getVulkanBuffer(), 1u32, &region);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BARRIERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Make the counters cleared visible to the cull of the objects, and the empty dispatch of their clusters to the
     * indirect dispatch when no object is seen
     * */
    pub fn afterClear(mut self) {
        self:.barrier(VkPipelineStageFlagBits::VK_PIPELINE_STAGE_TRANSFER_BIT,
                      VkAccessFlagBits::VK_ACCESS_TRANSFER_WRITE_BIT,
                      VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
                      | VkPipelineStageFlagBits::VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT,
                      VkAccessFlagBits::VK_ACCESS_SHADER_READ_BIT
                      | VkAccessFlagBits::VK_ACCESS_SHADER_WRITE_BIT
                      | VkAccessFlagBits::VK_ACCESS_INDIRECT_COMMAND_READ_BIT);
    }

    /**
     * Make the candidates listed visible to the cull of their clusters, and the size of its dispatch to the indirect
     * dispatch, of the first phase and of the late one
     * */
    pub fn afterObjects(mut self) {
        self:.barrier(VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
                      VkAccessFlagBits::VK_ACCESS_SHADER_WRITE_BIT,
                      VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
                      | VkPipelineStageFlagBits::VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT,
                      VkAccessFlagBits::VK_ACCESS_SHADER_READ_BIT
                      | VkAccessFlagBits::VK_ACCESS_SHADER_WRITE_BIT
                      | VkAccessFlagBits::VK_ACCESS_INDIRECT_COMMAND_READ_BIT);
    }

    /**
     * Make the counters written by the commands visible to their copy
     * */
    pub fn beforeReadBack(mut self) {
        self:.barrier(VkPipelineStageFlagBits::VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
                      VkAccessFlagBits::VK_ACCESS_SHADER_WRITE_BIT,
                      VkPipelineStageFlagBits::VK_PIPELINE_STAGE_TRANSFER_BIT,
                      VkAccessFlagBits::VK_ACCESS_TRANSFER_READ_BIT);
    }

    /**
     * Make the counters copied visible to the CPU, once the submission is over
     * */
    pub fn afterReadBack(mut self) {
        self:.barrier(VkPipelineStageFlagBits::VK_PIPELINE_STAGE_TRANSFER_BIT,
                      VkAccessFlagBits::VK_ACCESS_TRANSFER_WRITE_BIT,
                      VkPipelineStageFlagBits::VK_PIPELINE_STAGE_HOST_BIT,
                      VkAccessFlagBits::VK_ACCESS_HOST_READ_BIT);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Record a memory barrier between two stages
     * */
    fn barrier(mut self, srcStage: u32, srcAccess: u32, dstStage: u32, dstAccess: u32) {
        let mut b = VkMemoryBarrier();
        b.sType = VkStructureType::VK_STRUCTURE_TYPE_MEMORY_BARRIER;
        b.srcAccessMask = srcAccess;
        b.dstAccessMask = dstAccess;

        vkCmdPipelineBarrier(self.getCommandBuffer(), srcStage, dstStage, 0u32, 1u32, &b, 0u32, null, 0u32, null);
    }
}
