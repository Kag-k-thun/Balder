in step;


/**
 * A pass recorded in the command buffer of a subpass, after the barrier separating it from the accesses before it
 * (see VulkanPipeline, recording the passes of a render graph)
 * @info: a raster pass records in the render pass of a draw subpass, begun by the first raster pass and resumed after a
 * compute pass or a barrier, the attachments being loaded; a compute pass records outside of any render pass
 * */
pub record PassStep {

    // The name of the pass
    pub let name: [c8];

    // True iif the pass draws in the render pass of the subpass
    pub let raster: bool;

    // The stages of the accesses waited for by the barrier, 0 when the pass needs no barrier
    pub let srcStage: u32 = 0u32;

    // The stages waiting
    pub let dstStage: u32 = 0u32;

    // The accesses made available to the pass, the images transitioned excepted
    pub let srcAccess: u32 = 0u32;

    // The accesses of the pass they are made visible to
    pub let dstAccess: u32 = 0u32;

    // The images transitioned before the pass
    pub let dmut transitions: [ImageTransition] = [];

    // The recording of the pass, none to emit the onDraw signal of the subpass
    pub let recording: (dg ()-> void)? = none;

    /**
     * @params:
     *    - stages: the stages waited for and the stages waiting
     *    - accesses: the accesses made available and the accesses they are made visible to
     * */
    pub self (name: [c8],
              raster: bool,
              stages: (u32, u32),
              accesses: (u32, u32),
              dmut transitions: [ImageTransition],
              recording: (dg ()-> void)?)
        with name = name
        , raster = raster
        , srcStage = stages._0
        , dstStage = stages._1
        , srcAccess = accesses._0
        , dstAccess = accesses._1
        , transitions = alias transitions
        , recording = recording
    {}

}
