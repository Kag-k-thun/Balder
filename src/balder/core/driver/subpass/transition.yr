in transition;

use ::vulkan::core;

/**
 * The transition of the layout of an image, recorded before a pass of a subpass
 * */
pub record ImageTransition {

    // The image of each frame in flight
    pub let dmut images: [VkImage];

    // The aspect of the image
    pub let aspect: u32;

    // The accesses made available
    pub let srcAccess: u32;

    // The accesses the content is made visible to
    pub let dstAccess: u32;

    // The layout of the image before the transition, undefined when its content is discarded
    pub let oldLayout: VkImageLayout;

    // The layout of the image after the transition
    pub let newLayout: VkImageLayout;

    pub self (dmut images: [VkImage],
              aspect: u32,
              srcAccess: u32,
              dstAccess: u32,
              oldLayout: VkImageLayout,
              newLayout: VkImageLayout)
        with images = alias images
        , aspect = aspect
        , srcAccess = srcAccess
        , dstAccess = dstAccess
        , oldLayout = oldLayout
        , newLayout = newLayout
    {}

}
