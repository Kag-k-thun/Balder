/**
 * @authors: Emile Cadorel
 */
in window;

use balder::core::{_, application::_, driver::_, memory::_};
use balder::utils::log;

use std::{config::_, io, math, time::_};
use std::algorithm::comparison;

use ::core::concurrency::sync::{mutex, semaphore};

use ::sdl3::_;

use ::vulkan::core;

/**
 * The DPI at which a CSS pixel (1/96 of an inch) is a pixel, the one of a display at the scale 1
 */
pub def REFERENCE_DPI = 96.0f;

// Boolean set to false when a window is created
lazy dmut __FIRST_WINDOW__ = copy [true];

/**
 * Class managing a window and vulkan devices to enable 3D rendering
 */
pub class Window {

    prot { // context

        // the width of the window in pixels
        let mut _w: u32 = 0;

        // The height of the window in pixels
        let mut _h: u32 = 0;

        // The name (displayed on the window bar) of the window
        let mut _name: [c8] = "";

        // The application containing the window
        let dmut _app: &Application;

        // The sdl handler of the window
        let dmut _sdlWindow: *SDL_Window = null;

        // The surface for vulkan presenting
        let dmut _vkSurface: VkSurfaceKHR = null;

        // Vulkan instance
        let dmut _vkInstance: &VulkanInstance = copy VulkanInstance();

        // The device used for rendering
        let dmut _vkDevice: &VulkanDevice = copy VulkanDevice();

        // The resource manager to load resource from files
        let dmut _loader: (&ResourceManager)? = none;

        // The drawing pipeline of the window
        let dmut _pipeline: (&VulkanPipeline)? = none;

        // The configured DPI of the interface, 0 when it is the one of the display of the window
        let mut _dpi: f32 = 0.0f;
    }

    prot { // drawing

        // Mutex locked when starting/killing rendering thread
        let dmut _startStopMutex: &Mutex = copy Mutex();

        // The thread running the rendering loop
        let dmut _renderingTh: (future-> void)? = none;

        // Mutex locked while a frame is submitted, so what is committed with it is never submitted in part
        let dmut _frameMutex: &Mutex = copy Mutex();
    }

    prot { // thread
        // True if the window is rendering
        let mut _isRunning: bool = false;

        // The timer of frame duration
        let dmut _frameTimer: Timer = Timer();

        // The timer of a second, for nb frame per second computation
        let dmut _secondTimer: Timer = Timer();

        // Semaphore posted when a frame is requested
        let dmut _frameSemaphore: &Semaphore = copy Semaphore();

        // The minimal duration of a frame, by default 60 frames per second
        let mut _frameDuration: Duration = dur::millis(16u64) + dur::micros(666u64);

        // The number of continuous requests, frames are drawn at the frame rate while there is one, on request otherwise
        let mut _continuous: u32 = 0;

        // The number of frame in the current second
        let mut _nbFrame: u32 = 0;

        // The number of frame rendered during the last second
        let mut _lastNbFrame: u32 = 0;

        // The mailbox to receive signals
        let dmut _box: &SlotEmitter = copy SlotEmitter();
    }

    /**
     * ======================================================================================================
     * ======================================================================================================
     * =======================================   CTOR AND CONFIGURE  ========================================
     * ======================================================================================================
     * ======================================================================================================
     */

    /**
     * Create an empty window
     */
    pub self (dmut app: &Application)
        with _app = alias app
    {}

    /**
     * Configure the window to use vulkan for 3D rendering
     * @params:
     *    - config: the configuration of the window
     *    - resizable: true iif the window should be resizable
     * @throws:
     *    - &BalderError: if the configuration failed
     */
    pub fn configureVulkan(mut self, cfg: &BalderConfig)
        throws BalderError
    {
        atomic {
            if __FIRST_WINDOW__[0] {
                if !SDL_Init(SDL_INIT_VIDEO) {
                    throw copy BalderError("Failed to init SDL3 : " ~ sdlError());
                }

                __FIRST_WINDOW__[0] = false;
            }
        }

        self._dpi = cfg.window.dpi;

        // Created hidden at a provisional size, the configured one depending on the scale of the display the window
        // opens on. The back buffer has the pixels of the display, not its coordinates
        let flags = SDL_WINDOW_VULKAN | SDL_WINDOW_HIGH_PIXEL_DENSITY | SDL_WINDOW_HIDDEN;
        self._sdlWindow = SDL_CreateWindow(std::conv::toStringZ(self._name),
                                           640,
                                           480,
                                           if cfg.window.resizable { flags | SDL_WINDOW_RESIZABLE } else { flags });

        if (self._sdlWindow == null) {
            throw copy BalderError("Failed to create window : " ~ sdlError());
        }

        self:.resizeToConfiguration(cfg);

        self._vkInstance:.configure(alias self, cfg);

        if !SDL_Vulkan_CreateSurface(self._sdlWindow, self._vkInstance:.getHandle(), null, alias &self._vkSurface) {
            throw copy BalderError("Failed to create vulkan surface : " ~ sdlError());
        }

        self._vkDevice:.configure(alias self, cfg);
        self:.hide();

        if cfg.timer.fps <= 0 {
            log::error #("Window", "Fps must be a positive number");
            throw copy BalderError("Invalid fps configuration");
        }

        // The frame rate caps the frames drawn on request, a window that is not interactive draws them continuously
        self._frameDuration = dur::seconds(1) / cast!{u64} (cfg.timer.fps);
        self._continuous = if cfg.timer.interactive { 0u32 } else { 1u32 };

        // Draw empty screen, to configure default command buffers
        self:.configureRenderPipeline();
    }

    /**
     * Size the window as configured, at the scale of its display
     * @params:
     *    - cfg: the configuration of the window
     * @throws:
     *    - &BalderError: if the display of the window cannot be queried
     */
    fn resizeToConfiguration(mut self, cfg: &BalderConfig)
        throws BalderError
    {
        // Sizes relative to the screen are resolved against the usable bounds of the display of the window (task bar
        // and panels left out), which are in window coordinates
        let mut bounds = SDL_Rect();
        if !SDL_GetDisplayUsableBounds(SDL_GetDisplayForWindow(self._sdlWindow), alias &bounds) {
            throw copy BalderError("Failed to query the usable bounds of the display : " ~ sdlError());
        }

        // The sizes in pixels of the configuration are CSS pixels, scaled like the rest of the interface, then
        // brought back to window coordinates
        let coordinates = self.getScale() / self.getPixelDensity();
        let w = cfg.window.width.resolve(cast!u32(bounds.w), scale-> coordinates);
        let h = cfg.window.height.resolve(cast!u32(bounds.h), scale-> coordinates);

        // Centered on its display, where the compositor puts it under Wayland, which leaves no client the placement
        SDL_SetWindowSize(alias self._sdlWindow, cast!i32(w), cast!i32(h));
        SDL_SetWindowPosition(alias self._sdlWindow, cast!i32(SDL_WINDOWPOS_CENTERED), cast!i32(SDL_WINDOWPOS_CENTERED));
        SDL_SyncWindow(alias self._sdlWindow);

        let (pw, ph) = self.getDimension();
        self._w = pw;
        self._h = ph;

        log::debug #("Window", "Sized", pw, "x", ph, "pixels, density", self.getPixelDensity(), "scale", self.getScale());
    }

    /**
     * Connecting the basic input event slots for the window
     * */
    pub fn configureInputEvents(mut self) {
        let dmut input = self:.getInputManager();

        input:.windowResized():.connect(alias self._box, &self:.onResize);
        input:.windowExposed():.connect(alias self._app:.getRootSlotEmitter(), &self:.onExpose);
    }

    /**
     * Configure the rendering pipeline of the window
     * */
    fn configureRenderPipeline(mut self) {
        let dmut pipeline = copy VulkanPipeline(alias self._vkDevice);
        self._pipeline = (alias pipeline)?;
    }

    /**
     * ======================================================================================================
     * ======================================================================================================
     * ===============================================  SETTERS  ============================================
     * ======================================================================================================
     * ======================================================================================================
     */

    /**
     * Change the dimension of the window
     * @params:
     *    - w: the width of the window in pixels
     *    - h: the height of the window in pixels
     */
    pub fn setDimension(mut self, w: u32, h: u32) {
        self._w = w;
        self._h = h;
        if (self._sdlWindow != null) {
            let density = self.getPixelDensity();
            SDL_SetWindowSize(alias self._sdlWindow,
                              cast!i32(round(cast!f32(w) / density)),
                              cast!i32(round(cast!f32(h) / density)));
        }
    }

    /**
     * Change the name of the window
     * @params:
     *    - name: the name to put on the window title bar
     */
    pub fn setName(mut self, name: [c8]) {
        self._name = name;
        if (self._sdlWindow != null) {
            SDL_SetWindowTitle(alias self._sdlWindow, std::conv::toStringZ(self._name));
        }
    }

    /**
     * Slot called when the window is resized
     * */
    pub fn onResize(mut self, w: u32, h: u32) {
        self._vkDevice:.windowResize();

        self._w = w;
        self._h = h;
        self:.requestFrame();
    }

    /**
     * Slot called when the window is exposed
     * */
    pub fn onExpose(mut self) {
        self:.requestFrame();
    }

    /**
     * ======================================================================================================
     * ======================================================================================================
     * ===============================================  GETTERS  ============================================
     * ======================================================================================================
     * ======================================================================================================
     */

    /**
     * @returns:
     *   - .0: the width of the window in pixels
     *   - .1: the height of the window in pixels
     */
    pub fn getDimension(self)-> (u32, u32) {
        if self._sdlWindow != null {
            let mut w = 0, mut h = 0;
            SDL_GetWindowSizeInPixels(self._sdlWindow, alias &w, alias &h);
            return (cast!u32(w), cast!u32(h));
        }

        (cast!u32(self._w), cast!u32(self._h))
    }

    /**
     * @returns: the number of pixels in a window coordinate, those of the mouse events and of the window size the
     * desktop sees
     */
    pub fn getPixelDensity(self)-> f32 {
        if self._sdlWindow != null {
            let density = SDL_GetWindowPixelDensity(self._sdlWindow);
            if density > 0.0f { return density; }
        }

        1.0f
    }

    /**
     * @returns: the DPI of the interface, the configured one, or else the one the desktop displays the window at (the
     * reference DPI times the display scale of the window)
     */
    pub fn getDpi(self)-> f32 {
        if self._dpi > 0.0f {
            return self._dpi;
        }

        if self._sdlWindow != null {
            let scale = SDL_GetWindowDisplayScale(self._sdlWindow);
            if scale > 0.0f { return REFERENCE_DPI * scale; }
        }

        REFERENCE_DPI
    }

    /**
     * @returns: the number of pixels in a CSS pixel, the DPI of the interface over the reference one, rounded to a
     * quarter
     */
    pub fn getScale(self)-> f32 {
        max(0.25f, round(self.getDpi() * 4.0f / REFERENCE_DPI) / 4.0f)
    }

    /**
     * @returns: the name of the window
     */
    pub fn getName(self)-> [c8] {
        self._name
    }

    /**
     * @returns: the number of frame drawn last second
     * */
    pub fn getNbFramesLastSecond(self)-> u32 {
        self._lastNbFrame
    }

    /**
     * @returns: the handle of the sdl window
     */
    pub fn getSDLHandle(mut self)-> dmut *SDL_Window {
        alias self._sdlWindow
    }

    /**
     * @returns: the surface on which vulkan can render, to render on the window
     */
    pub fn getVulkanSurface(mut self)-> dmut VkSurfaceKHR {
        alias self._vkSurface
    }

    /**
     * @returns: The instance of vulkan used by the window
     */
    pub fn getVulkanInstance(mut self)-> dmut &VulkanInstance {
        alias self._vkInstance
    }

    /**
     * @returns: The device used by the window to render
     */
    pub fn getVulkanDevice(mut self)-> dmut &VulkanDevice {
        alias self._vkDevice
    }

    /**
     * @returns: the rendering pipeline of the window
     * */
    pub fn getVulkanPipeline(mut self)-> dmut &VulkanPipeline {
        if let Ok(dmut pipe) = alias self._pipeline {
            return alias pipe;
        }

        log::error #("Window", "Window configuration is uncomplete");
        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          RESOURCES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dispose an object that recorded commands may reference (buffers, descriptor sets, textures), once
     * every frame slot was recorded again without it
     * @info: requests that redraw itself, the caller has no need to redraw the pipeline for it
     * */
    pub fn retire {T impl Disposable} (mut self, dmut obj: T) {
        self._vkDevice:.retire(&obj:.dispose);
    }

    /**
     * Dispose an object that only the frames in flight use (staging buffers, command allocators), once
     * they are awaited
     * @warning: never for an object that recorded commands reference, use retire
     * */
    pub fn retireAfterFrame {T impl Disposable} (mut self, dmut obj: T) {
        self._vkDevice:.retireAfterFrame(&obj:.dispose);
    }

    /**
     * Load a resource from a file
     * @params:
     *    - path: the path of the file to load (project path are accepted)
     * */
    pub fn loadResource {T} (mut self, path: [c8])-> dmut &(RefCount!{__pragma!root_super(T)})
        throws BalderError
    {
        if let Ok(dmut ld) = alias self._loader {
            let dmut loader = ld:.get!{T} ();
            return loader:.load!{T} (path);
        } else {
            let dmut ld = copy ResourceManager(alias self);

            let dmut loader = ld:.get!{T} ();
            let dmut ret    = alias loader:.load!{T} (path);

            self._loader = (alias ld)?;

            alias ret
        }
    }

    /**
     * Insert a managed resource loaded from an external loader
     * @params:
     *    - path: the path of the file to load (project path are accepted)
     * */
    pub fn insertResource {T} (mut self, dmut rec: T)-> dmut &(RefCount!{__pragma!root_super(T)}) {
        if let Ok(dmut ld) = alias self._loader {
            let dmut loader = ld:.get!{T} ();
            return loader:.insert!{T} (alias rec);
        } else {
            let dmut ld = copy ResourceManager(alias self);

            let dmut loader = ld:.get!{T} ();
            let dmut ret    = alias loader:.insert!{T} (alias rec);

            self._loader = (alias ld)?;

            alias ret
        }
    }

    /**
     * Load a resource from a file
     * @params:
     *    - path: the path of the file to load (project path are accepted)
     * */
    pub fn loadResource {T, P...} (mut self, path: [c8], params: P)-> dmut &(RefCount!{__pragma!root_super(T)})
        throws BalderError
    {
        if let Ok(dmut ld) = alias self._loader {
            let dmut loader = ld:.get!{T} ();
            return loader:.load!{T} (path, expand params);
        } else {
            let dmut ld = copy ResourceManager(alias self);

            let dmut loader = ld:.get!{T} ();
            let dmut ret    = alias loader:.load!{T} (path, expand params);

            self._loader = (alias ld)?;

            alias ret
        }
    }

    /**
     * Load a resource from a file
     * @params:
     *    - path: the path of the file to load (project path are accepted)
     * */
    pub fn emptyResource {T} (mut self)-> dmut &(RefCount!{__pragma!root_super(T)}) {
        if let Ok(dmut ld) = alias self._loader {
            let dmut loader = ld:.get!{T} ();
            return loader:.empty();
        } else {
            let dmut ld = copy ResourceManager(alias self);

            let dmut loader = ld:.get!{T} ();
            let dmut ret    = loader:.empty();

            self._loader = (alias ld)?;

            alias ret
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==============================          APPLICATION GETTERS          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the input manager of the window
     * */
    pub fn getInputManager(mut self)-> dmut &WindowInputSignals {
        if self._sdlWindow != null {
            return self._app:.getInputManager():.getWindowSignals(SDL_GetWindowID(self._sdlWindow));
        }

        log::error #("Window", "malformed window");
        panic;
    }

    /**
     * @returns: the application to which the window is attached
     * */
    pub fn getApplication(mut self)-> dmut &Application {
        alias self._app
    }

    /**
     * @returns: the application to which the window is attached
     * */
    pub fn getApplication(self)-> &Application {
        self._app
    }

    /**
     * @returns: the slot emitter of the window. Signal emitted in that box are executed by the window thread
     * */
    pub fn getSlotEmitter(mut self)-> dmut &SlotEmitter {
        alias self._box
    }

    /**
     * ======================================================================================================
     * ======================================================================================================
     * =============================================   USAGE  ===============================================
     * ======================================================================================================
     * ======================================================================================================
     */

    /**
     * Show the window on the screen
     */
    pub fn show(mut self) {
        if (self._sdlWindow != null) {
            SDL_ShowWindow(alias self._sdlWindow);

            if !self._renderingTh.hasValue {
                self:.startRendering();
            }
        }
    }

    /**
     * Hide the window on the screen
     */
    pub fn hide(mut self) {
        if (self._sdlWindow != null) {
            SDL_HideWindow(alias self._sdlWindow);

            if self._renderingTh.hasValue {
                self:.killRendering();
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===========================          START/STOP DRAWING THREAD          ============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Launch the thread that draws on the window at a given framerate
     */
    fn startRendering(mut self) {
        {
            self._startStopMutex:.lock();
            if let Err() = self._renderingTh && !self._isRunning {
                self._isRunning = true;
                self._renderingTh = (spawn self:.renderingThread())?;
            }

            log::debug #("Window", "Thread launched");
        } exit {
            self._startStopMutex:.unlock();
        }
    }

    /**
     * Kill the rendering thread
     * */
    fn killRendering(mut self) {
        {
            self._startStopMutex:.lock();
            self._isRunning = false;
            self:.requestFrame();

            if let Ok(th) = self._renderingTh {
                th.value; // join thread
                self._renderingTh = none;
            }

            log::debug #("Window", "Thread killed");
        } exit {
            self._startStopMutex:.unlock();
        }
    }

    /**
     * ======================================================================================================
     * ======================================================================================================
     * ==========================================   RENDERING UTILS  ========================================
     * ======================================================================================================
     * ======================================================================================================
     */

    /**
     * Force the pipeline to recompute all drawing commands
     * */
    pub fn redrawPipeline(mut self) {
        if let Ok(dmut pipe) = alias self._pipeline {
            pipe:.forceRedraw();
        }
    }

    /**
     * Reset the drawing pipeline, removing every subpasses
     * */
    pub fn resetDrawingPipeline(mut self) {
        log::debug #("Window", "Reset drawing pipeline");

        let isStarted = self._isRunning;
        self:.killRendering();

        if let Ok(dmut pipe) = alias self._pipeline {
            pipe:.dispose();
        }

        if isStarted {
            self:.startRendering();
        }
    }

    /**
     * Content of the rendering thread, updating the window at a given framerate
     */
    fn renderingThread(mut self) {
        self._box:.clear();

        self._secondTimer:.reset();
        self._frameTimer:.reset();

        log::debug #("Window", "start rendering thread");

        while self._isRunning {
            {
                self._box:.emit();
                let image = self:.startFrame();

                if (image >= 0) {
                    self:.submitFrame();
                    self:.presentFrame(image);
                    self._nbFrame += 1u32;
                } else {
                    if let Ok(dmut pipe) = alias self._pipeline {
                        pipe:.forceRedraw();
                    }
                }

                self:.waitFrame();
            }
        }

        self:.waitIdle();
        log::debug #("Window", "Quit thread loop");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TIMER          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Prevent the frames from being submitted until unlockFrame, so the modifications made in between are submitted
     * together (the buffers they update, and the recordings they request)
     * @warning: never held while waiting for a frame, the frames would wait for it
     * */
    pub fn lockFrame(mut self) {
        self._frameMutex:.lock();
    }

    /**
     * Let the frames be submitted again, after lockFrame
     * */
    pub fn unlockFrame(mut self) {
        self._frameMutex:.unlock();
    }

    /**
     * Request a frame, drawn as soon as the frame rate allows it
     * @info: what changes the content of the GPU (transfers, dynamic buffers, recordings) requests it itself
     * */
    pub fn requestFrame(mut self) {
        self._frameSemaphore:.post();
    }

    /**
     * Draw the frames continuously at the frame rate, until the matching call to endContinuous
     * @info: for what changes the frames without changing the content of the GPU, or measures the frame rate
     * */
    pub fn beginContinuous(mut self) {
        atomic self {
            self._continuous += 1u32;
        }

        self:.requestFrame();
    }

    /**
     * End a continuous request started by beginContinuous, the frames are drawn on request once none is left
     * */
    pub fn endContinuous(mut self) {
        atomic self {
            if self._continuous == 0u32 {
                log::error #("Window", "No continuous request to end");
            } else {
                self._continuous -= 1u32;
            }
        }
    }

    /**
     * @returns: true iif the frames are drawn continuously at the frame rate (false if they are drawn on request)
     * */
    pub fn isContinuous(self)-> bool {
        self._continuous > 0u32
    }

    /**
     * Wait until the next frame should be drawn: at the frame rate while a continuous request holds or a frame slot
     * still has to be recorded again, when a frame is requested otherwise
     */
    fn waitFrame(mut self) {
        if !self._isRunning { return; }

        if self._continuous > 0u32 || self.hasPendingRedraw() {
            self:.waitFrameDuration();
        } else {
            self:.waitRequest();
        }

        // The requests made until now are drawn by the next frame
        while self._frameSemaphore.get() > 0 {
            self._frameSemaphore:.wait();
        }
    }

    /**
     * Wait for a frame request, then for the end of the frame duration
     */
    fn waitRequest(mut self) {
        loop {
            self:.countSecond();

            // Woken at the end of the second to roll the frame count over, a timeout of zero would wait forever
            let elapsed = self._secondTimer.timeSinceStart();
            let remaining = if elapsed < dur::seconds(1u64) { dur::seconds(1u64) - elapsed } else { dur::millis(1u64) };
            if self._frameSemaphore:.wait(timeout-> remaining) || !self._isRunning {
                break;
            }
        }

        self:.waitFrameDuration();
    }

    /**
     * Wait for the end of the duration of the current frame
     */
    fn waitFrameDuration(mut self) {
        self:.countSecond();

        let tick = self._frameTimer.timeSinceStart();
        if (self._frameDuration > tick) {
            let x = Instant::now();
            let r = self._frameDuration - tick - dur::micros(1u64);
            sleep(r);

            let z = (Instant::now() - x) - r;
            self._frameTimer:.reset(z);
        } else if tick < self._frameDuration + self._frameDuration {
            // Late by less than a frame, the next one catches up
            self._frameTimer:.reset(tick - self._frameDuration);
        } else {
            // Idle since the last frame, the next one starts a frame duration from now
            self._frameTimer:.reset();
        }
    }

    /**
     * Roll the frame count over when a second elapsed
     */
    fn countSecond(mut self) {
        if (self._secondTimer.timeSinceStart() >= dur::seconds(1u64)) {
            self._secondTimer:.reset();
            self._lastNbFrame = self._nbFrame;
            self._nbFrame = 0u32;
        }
    }

    /**
     * @returns: true iif a frame slot of the pipeline has to be recorded again
     */
    fn hasPendingRedraw(self)-> bool {
        if let Ok(pipe) = self._pipeline {
            return pipe.hasPendingRedraw();
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          RENDER PASS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Start a new vulkan rendering pass
     */
    fn startFrame(mut self)-> i32 {
        return if let Ok(dmut pipe) = alias self._pipeline {
            pipe:.waitPreviousFrame();
            let image = self._vkDevice:.acquireNextImage();

            image
        } else {
            -1
        };
    }

    /**
     * Submit the drawing queues
     * */
    fn submitFrame(mut self) {
        if let Ok(dmut pipe) = alias self._pipeline {
            {
                self._frameMutex:.lock();
                pipe:.submitFrame();
            } exit {
                self._frameMutex:.unlock();
            }
        }
    }

    /**
     * Present the pass that was rendered on the GPU
     */
    fn presentFrame(mut self, image: i32) {
        self._vkDevice:.presentScreen(cast!u32(image));
    }

    /**
     * Wait for all window subcommand to be idle
     */
    fn waitIdle(mut self) {
        self._vkDevice:.waitIdle();
    }

    /**
     * ======================================================================================================
     * ======================================================================================================
     * =============================================  DISPOSING  ============================================
     * ======================================================================================================
     * ======================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self:.killRendering();

            // Disposing the pipeline drains the retired objects, which release the references they hold
            if let Ok(dmut pipe) = alias self._pipeline {
                pipe:.dispose();
                self._pipeline = none;
            }

            // The references left are leaked, the resources are retired to the device, they go before it
            if let Ok(dmut ld) = alias self._loader {
                ld:.releaseAll();
                self._loader = none;
            }

            self._vkDevice:.disposeSwapchain();
            self:.disposeSurface();

            self._vkDevice:.dispose();
            self._vkInstance:.dispose();

            if (self._sdlWindow != null) {
                SDL_DestroyWindow(alias self._sdlWindow);
                self._sdlWindow = null;
            }
        }
    }

    /**
     * Dispose the surface of the window, so it can be recreated for example
     * @info: when window is resized, the surface must be recreated for example
     */
    fn disposeSurface(mut self) {
        if (self._vkSurface != null) {
            vkDestroySurfaceKHR(self._vkInstance:.getHandle(), self._vkSurface, null);
            self._vkSurface = null;
        }
    }

    /**
     * Call dispose
     */
    __dtor(mut self) {
        self:.dispose();
    }
}

/**
 * @returns: the message of the last error of SDL
 */
fn sdlError()-> [c8] {
    unsafe { std::conv::fromStringZ(SDL_GetError()) }
}
