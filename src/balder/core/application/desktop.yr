/**
 * @authors: Emile Cadorel
 */
in desktop;

use std::conv;

use ::sdl2::_;

/**
 * A connection to an X server, opaque
 */
record Display {}

extern (C) fn XOpenDisplay(name: *c8)-> dmut *Display;
extern (C) fn XResourceManagerString(display: *Display)-> *c8;
extern (C) fn XCloseDisplay(dmut display: *Display)-> i32;

/**
 * @returns: the DPI the desktop renders its applications at (the X resource Xft.dpi), 0 when SDL does not run on
 * X11 or the resource is not set
 * @info: under Wayland the compositor scales the window itself, so the resource of XWayland is not read
 */
pub fn readDesktopDpi()-> f32 {
    let driver = SDL_GetCurrentVideoDriver();
    if driver == null {
        return 0.0f;
    }

    let name = unsafe { fromStringZ(driver) };
    if name != "x11" {
        return 0.0f;
    }

    let dmut display = XOpenDisplay(null);
    if display == null {
        return 0.0f;
    }

    let resources = XResourceManagerString(display);
    let dpi = if resources != null { parseXftDpi(unsafe { fromStringZ(resources) }) } else { 0.0f };

    XCloseDisplay(alias display);
    dpi
}

/**
 * @params:
 *    - resources: the resource database of an X server, one `name:\tvalue` per line
 * @returns: the value of the resource Xft.dpi, 0 if it is missing or not a positive number
 */
pub fn parseXftDpi(resources: [c8])-> f32 {
    let key = "Xft.dpi:";

    let mut start = 0us;
    while start < resources.len {
        let mut end = start;
        while end < resources.len && resources[end] != '\n'c8 {
            end += 1us;
        }

        let line = resources[start .. end];
        if line.len >= key.len && line[0us .. key.len] == key {
            return parseDpi(line[key.len .. $]);
        }

        start = end + 1us;
    }

    0.0f
}

/**
 * @params:
 *    - value: a decimal number, surrounded by blanks
 * @returns: the number, 0 if it is not a positive decimal number
 */
fn parseDpi(value: [c8])-> f32 {
    let mut start = 0us, mut end = value.len;
    while start < end && isBlank(value[start]) {
        start += 1us;
    }

    while end > start && isBlank(value[end - 1us]) {
        end -= 1us;
    }

    {
        let dpi = value[start .. end].to!{f32} ();

        // Written so that NaN and infinity are rejected as well
        if dpi > 0.0f && dpi <= f32::max { dpi } else { 0.0f }
    } catch {
        _ => { 0.0f }
    }
}

/**
 * @returns: true if `c` is a space, a tabulation or a carriage return
 */
fn isBlank(c: c8)-> bool {
    c == ' 'c8 || c == '\t'c8 || c == '\r'c8
}
