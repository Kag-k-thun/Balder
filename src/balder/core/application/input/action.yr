in action;

use balder::core::application::input::binding;

/**
 * An input action of the game, a name the actors read (see ActionState) bound to keys, mouse buttons and gamepad
 * inputs, any of them acting it
 * */
@data
pub record InputAction {

    // The name the actors read the action by
    pub let mut name: [c8] = "";

    // The inputs acting it
    pub let mut bindings: [InputBinding] = [];

    // The strength under which a gamepad axis bound to it reads 0, from 0 to 1
    pub let mut deadZone: f32 = 0.2f;
}

/**
 * Replace the input actions of the program, those the scenes read
 * @info: called before the game ticks, or between Window::lockFrame and unlockFrame, the ticks reading them
 * */
pub fn setInputActions(actions: [InputAction]) {
    let dmut index: [[c8] => usize] = copy [];
    for i, a in actions {
        index[a.name] = i;
    }

    __ACTIONS__ = copy actions;
    __ACTION_INDEX__ = alias index;
}

/**
 * @returns: the input actions of the program
 * */
pub fn inputActions()-> [InputAction] {
    __ACTIONS__
}

/**
 * @returns: the input action of the program named, none when there is none
 * */
pub fn inputAction(name: [c8])-> (InputAction)? {
    if let Ok(i) = __ACTION_INDEX__[name] {
        return (__ACTIONS__[i])?;
    }

    none
}

/**
 * The input actions of the program
 * */
lazy dmut __ACTIONS__: [InputAction] = [];

/**
 * The index of the input actions of the program in __ACTIONS__, by their name
 * */
lazy dmut __ACTION_INDEX__: [[c8] => usize] = copy [];
