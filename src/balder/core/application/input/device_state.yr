in device_state;

use balder::core::application::input::binding;

/**
 * The number of SDL scancodes (SDL_SCANCODE_COUNT)
 * */
pub def NB_KEYS = 512us;

/**
 * The number of mouse buttons, indexed by their SDL_BUTTON_* (from 1)
 * */
pub def NB_MOUSE_BUTTONS = 8us;

/**
 * The number of gamepad buttons (SDL_GAMEPAD_BUTTON_COUNT)
 * */
pub def NB_PAD_BUTTONS = 26us;

/**
 * The number of halves of the gamepad axes, two for each of the SDL_GAMEPAD_AXIS_COUNT axes
 * */
pub def NB_PAD_HALVES = 12us;

/**
 * What the input devices did up to a moment: how many times each key, mouse button and gamepad button went down and
 * up, the gamepads holding each gamepad button, and the strength of each half of each gamepad axis
 * @info:
 * =====
 * The downs and the ups of an input alternate, so it is held while they differ, and it went down (or up) between two
 * states whose downs (or ups) differ: an input pressed and released between two states reads as pressed and released,
 * but not held. The gamepads are merged, a binding naming none (see InputDevices).
 * =====
 * */
pub record DeviceState {

    // How many times each key went down and up, by SDL_Scancode
    pub let dmut keyDowns: [u32 ; NB_KEYS] = [0u32 ; NB_KEYS];
    pub let dmut keyUps: [u32 ; NB_KEYS] = [0u32 ; NB_KEYS];

    // How many times each mouse button went down and up, by SDL_BUTTON_*
    pub let dmut buttonDowns: [u32 ; NB_MOUSE_BUTTONS] = [0u32 ; NB_MOUSE_BUTTONS];
    pub let dmut buttonUps: [u32 ; NB_MOUSE_BUTTONS] = [0u32 ; NB_MOUSE_BUTTONS];

    // How many times each gamepad button went down and up on any gamepad, by SDL_GamepadButton
    pub let dmut padDowns: [u32 ; NB_PAD_BUTTONS] = [0u32 ; NB_PAD_BUTTONS];
    pub let dmut padUps: [u32 ; NB_PAD_BUTTONS] = [0u32 ; NB_PAD_BUTTONS];

    // The gamepads holding each gamepad button
    pub let dmut padHolding: [u8 ; NB_PAD_BUTTONS] = [0u8 ; NB_PAD_BUTTONS];

    // The strength of each half of each gamepad axis, from 0 to 1, the furthest of the gamepads (see halfOf)
    pub let dmut axes: [f32 ; NB_PAD_HALVES] = [0.0f ; NB_PAD_HALVES];

    /**
     * Nothing ever pressed
     * */
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: how many times the key or the button of a binding went down, 0 for a gamepad axis
     * */
    pub fn downs(self, b: InputBinding)-> u32 {
        let i = cast!usize(b.code);
        match b.device {
            InputDevice::KEY        => { if i < NB_KEYS { return self.keyDowns[i]; } }
            InputDevice::MOUSE      => { if i < NB_MOUSE_BUTTONS { return self.buttonDowns[i]; } }
            InputDevice::PAD_BUTTON => { if i < NB_PAD_BUTTONS { return self.padDowns[i]; } }
            _                       => {}
        }

        0u32
    }

    /**
     * @returns: how many times the key or the button of a binding went up, 0 for a gamepad axis
     * */
    pub fn ups(self, b: InputBinding)-> u32 {
        let i = cast!usize(b.code);
        match b.device {
            InputDevice::KEY        => { if i < NB_KEYS { return self.keyUps[i]; } }
            InputDevice::MOUSE      => { if i < NB_MOUSE_BUTTONS { return self.buttonUps[i]; } }
            InputDevice::PAD_BUTTON => { if i < NB_PAD_BUTTONS { return self.padUps[i]; } }
            _                       => {}
        }

        0u32
    }

    /**
     * @returns: true iif the key or the button of a binding is held, false for a gamepad axis, its strength telling how
     * far it is pushed
     * */
    pub fn isHeld(self, b: InputBinding)-> bool {
        let i = cast!usize(b.code);
        match b.device {
            InputDevice::KEY        => { if i < NB_KEYS { return self.keyDowns[i] != self.keyUps[i]; } }
            InputDevice::MOUSE      => { if i < NB_MOUSE_BUTTONS { return self.buttonDowns[i] != self.buttonUps[i]; } }
            InputDevice::PAD_BUTTON => { if i < NB_PAD_BUTTONS { return self.padHolding[i] != 0u8; } }
            _                       => {}
        }

        false
    }

    /**
     * @returns: the strength of a binding, from 0 to 1: 1 for a key or a button held, the strength of the half for a
     * gamepad axis
     * */
    pub fn strength(self, b: InputBinding)-> f32 {
        if b.device == InputDevice::PAD_AXIS {
            let h = DeviceState::halfOf(b.code, b.positive);
            if h < NB_PAD_HALVES { return self.axes[h]; }
            return 0.0f;
        }

        if self.isHeld(b) { 1.0f } else { 0.0f }
    }

    /**
     * @returns: the state with every input released, its downs kept: nothing held, the axes at rest
     * */
    pub fn released(self)-> DeviceState {
        let dmut r = self;
        r.keyUps = r.keyDowns;
        r.buttonUps = r.buttonDowns;
        r.padUps = r.padDowns;
        r.padHolding = [0u8 ; NB_PAD_BUTTONS];
        r.axes = [0.0f ; NB_PAD_HALVES];

        r
    }

}

@companion
pub mod DeviceState {

    /**
     * @returns: the index of the half of a gamepad axis in DeviceState.axes
     * @params:
     *    - axis: the SDL_GamepadAxis
     *    - positive: the half, true for the positive values
     * */
    pub fn halfOf(axis: u32, positive: bool)-> usize {
        cast!usize(axis) * 2us + if positive { 0us } else { 1us }
    }

}
