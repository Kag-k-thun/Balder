in fixed_step;

use std::time;

/**
 * The steps of a fixed duration a simulation advances by, from ticks of any duration: the time a tick leaves over is
 * carried to the next one
 * @example:
 * ===
 * let mut steps = FixedStep(60u32);
 * for _ in 0u32 .. steps:.advance(delta) {
 *     world:.step(steps.seconds);
 * }
 * let alpha = steps.alpha; // how far the display is between the last two steps
 * ===
 * */
pub record FixedStep {

    // The duration of a step
    let _step: u64;

    // The most steps a tick runs, the time beyond them dropped
    let _maxSteps: u32;

    // The time not yet stepped (shorter than a step after each advance)
    let mut _pending: u64 = 0;

    pub self(rate: u32, maxSteps: u32 = 4u32)
        with _step = 1_000_000u64 / cast!u64(rate)
        , _maxSteps = maxSteps
    {}


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the duration of a step, in seconds
     * */
    @field
    pub fn seconds(self)-> f32 {
        cast!f32(self._step) / 1_000_000.0f
    }

    /**
     * @returns: how far the time not yet stepped reaches into the next step,
     * from 0 (included) to 1 (excluded), the factor interpolating the display
     * between the last two steps
     *
     * */
    @field
    pub fn alpha(self)-> f32 {
        cast!f32(self._pending) / cast!f32(self._step)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          ADVANCE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add the duration of a tick to the time not yet stepped
     *
     * @returns: the steps to run now, maxSteps at most; the time of the steps
     * beyond is dropped, so a stalled tick does not ask for more steps at the
     * next one
     *
     * */
    pub fn advance(mut self, delta: Duration)-> u32 {
        self._pending += cast!u64(delta.allMicros);
        let steps = self._pending / self._step;
        self._pending = self._pending % self._step;

        if steps > cast!u64(self._maxSteps) {
            return self._maxSteps;
        }

        cast!u32(steps)
    }
}
