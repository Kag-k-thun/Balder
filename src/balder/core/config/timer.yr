in timer;

use balder::core::error;

use std::{config, fs, stream};

pub record TimerConfig {

    let mut _ips: i32          = 30;
    let mut _fps: i32          = 60;
    let mut _physics: i32          = 60;
    let mut _catchUp: i32          = 4;

    let mut _interactive: bool = false;

    pub self (cfg: &Config)
        throws BalderError
    {
        if let Ok(i) = cfg.at("ips") {
            self._ips = i.to!{i32} ();
        }

        if let Ok(i) = cfg.at("fps") {
            self._fps = i.to!{i32} ();
        }

        if let Ok(i) = cfg.at("physics") {
            self._physics = i.to!{i32} ();
        }

        if let Ok(i) = cfg.at("catch-up") {
            self._catchUp = i.to!{i32} ();
        }

        if let Ok(b) = cfg.at("interactive") {
            self._interactive = b.to!{bool} ();
        }
    } catch {
        err => {
            throw copy BalderError("Failed to read timer configuration : " ~ std::conv::to!{[c8]} (err));
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn ips(self)-> i32 {
        self._ips
    }

    @field
    pub fn fps(self)-> i32 {
        self._fps
    }

    @field
    pub fn physics(self)-> i32 {
        self._physics
    }

    @field
    pub fn catchUp(self)-> i32 {
        self._catchUp
    }

    @field
    pub fn interactive(self)-> bool {
        self._interactive
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
}
