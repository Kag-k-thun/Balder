in shadow;

use balder::core::error;

use std::stream;
use std::config::data;

/**
 * The configuration of the shadow maps of the scenes, written in the [shadow] table:
 * ```
 * [shadow]
 * scale = 2048
 * distance = 50.0
 * atlas = 4096
 * lights = 8
 * ```
 * */
pub record ShadowConfig {

    // The number of texels on a side of the shadow map, holding the cascades of the light casting shadows in a 2x2 atlas
    let mut _scale: u32 = 2048u32;

    // The depth in the view of the camera up to which the shadows are drawn, the far plane of the camera when farther
    let mut _distance: f32 = 50.0f;

    // The number of texels on a side of the atlas holding the shadows of the point and spot lights
    let mut _atlas: u32 = 4096u32;

    // The number of point and spot lights shadowed at most by a frame, those the largest on screen
    let mut _lights: u32 = 8u32;

    /**
     * The default configuration
     * */
    pub self () {}

    pub self (cfg: &Config)
        throws BalderError
    {
        if let Ok(s) = cfg["scale"]? {
            self._scale = readScale(s);
        }

        if let Ok(d) = cfg["distance"]? {
            self._distance = readDistance(d);
        }

        if let Ok(a) = cfg["atlas"]? {
            self._atlas = readAtlas(a);
        }

        if let Ok(l) = cfg["lights"]? {
            self._lights = readLights(l);
        }
    } catch {
        b: &BalderError => {
            throw copy BalderError("Failed to read shadow configuration : " ~ b.msg);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of texels on a side of the shadow map, twice the number on a side of a cascade
     * */
    @field
    pub fn scale(self)-> u32 {
        self._scale
    }

    /**
     * @returns: the depth in the view of the camera up to which the shadows are drawn
     * */
    @field
    pub fn distance(self)-> f32 {
        self._distance
    }

    /**
     * @returns: the number of texels on a side of the atlas of the point and spot lights, a power of two
     * */
    @field
    pub fn atlas(self)-> u32 {
        self._atlas
    }

    /**
     * @returns: the number of point and spot lights shadowed at most by a frame
     * */
    @field
    pub fn lights(self)-> u32 {
        self._lights
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
}

/**
 * @returns: the number of texels on a side of the shadow map `cfg`, an even integer from 32 to 16384, so each cascade
 * has a whole number of texels and room for its margins
 * @throws:
 *    - &BalderError: if `cfg` is not such an integer
 */
fn readScale(cfg: &Config)-> u32
    throws BalderError
{
    if let Int(value-> scale) = cfg {
        if scale >= 32 && scale <= 16384 && scale % 2 == 0 {
            return cast!u32(scale);
        }
    }

    throw copy BalderError("Shadow scale must be an even number of texels from 32 to 16384");
}

/**
 * @returns: the number of texels on a side of the atlas of the point and spot lights `cfg`, a power of two from 256 to
 * 16384, so the tiles halving it have a whole number of texels
 * @throws:
 *    - &BalderError: if `cfg` is not such an integer
 */
fn readAtlas(cfg: &Config)-> u32
    throws BalderError
{
    if let Int(value-> atlas) = cfg {
        if atlas >= 256 && atlas <= 16384 && (atlas & (atlas - 1)) == 0 {
            return cast!u32(atlas);
        }
    }

    throw copy BalderError("Shadow atlas must be a power of two of texels from 256 to 16384");
}

/**
 * @returns: the number of point and spot lights shadowed at most `cfg`, an integer from 1 to 16 (see
 * LocalShadowScene::MAX_LIGHTS)
 * @throws:
 *    - &BalderError: if `cfg` is not such an integer
 */
fn readLights(cfg: &Config)-> u32
    throws BalderError
{
    if let Int(value-> lights) = cfg {
        if lights >= 1 && lights <= 16 {
            return cast!u32(lights);
        }
    }

    throw copy BalderError("Shadow lights must be a number of lights from 1 to 16");
}

/**
 * @returns: the distance `cfg`, a positive number
 * @throws:
 *    - &BalderError: if `cfg` is not a positive number
 */
fn readDistance(cfg: &Config)-> f32
    throws BalderError
{
    let distance = match cfg {
        Float(value-> f) => { f }
        Int(value-> i) => { cast!f64(i) }
        _ => {
            throw copy BalderError("Shadow distance must be a number");
        }
    };

    // Written so that NaN is rejected as well
    if !(distance > 0.0 && distance <= cast!f64(f32::max)) {
        throw copy BalderError("Shadow distance must be positive");
    }

    cast!f32(distance)
}
