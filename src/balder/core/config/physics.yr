in physics;

use balder::core::error;
use balder::math::vector;

use std::{config, stream};

/**
 * The configuration of the physics of the scenes, written in the [physics] table (the rate of the steps being in
 * [timer]):
 * ```
 * [physics]
 * gravity = [0.0, -9.81, 0.0]
 * substeps = 4
 * max-substeps = 16
 * max-sink = 0.005
 * iterations = 2
 * contact-hertz = 60.0
 * contact-damping = 10.0
 * joint-hertz = 60.0
 * joint-damping = 2.0
 * max-correction = 2.0
 * bounce-threshold = 1.0
 * sleep-linear = 0.05
 * sleep-angular = 0.05
 * sleep-time = 0.5
 * ```
 * */
pub record PhysicsConfig {

    // The acceleration of the bodies falling, in metres a second squared
    let mut _gravity: vec3 = makeVec3(0.0f, -9.81f, 0.0f);

    // The sub steps a step is solved in, a stack holding still better at a shorter step than with more passes
    let mut _substeps: u32 = 4u32;

    // The sub steps an island is solved in at most, given more than substeps when its lightest body carrying its
    // heaviest one would sink deeper than maxSink
    let mut _maxSubsteps: u32 = 16u32;

    // How deep a contact may sink under the load it carries before its island is given more sub steps, in metres
    let mut _maxSink: f32 = 0.005f;

    // The passes of the solver over the contacts at each sub step
    let mut _iterations: u32 = 2u32;

    // The frequency of the spring pushing a penetration out, in hertz, a quarter of the rate of the sub steps at most
    let mut _contactHertz: f32 = 60.0f;

    // The damping ratio of that spring, 1 for a critical damping, more for a contact that never bounces
    let mut _contactDamping: f32 = 10.0f;

    // The frequency of the spring pulling the error of a joint back, in hertz, a quarter of the rate of the sub steps at
    // most
    let mut _jointHertz: f32 = 60.0f;

    // The damping ratio of that spring
    let mut _jointDamping: f32 = 2.0f;

    // The speed the correction of a penetration pushes out by at most, in metres a second
    let mut _maxCorrection: f32 = 2.0f;

    // The speed two bodies must close by for a contact to bounce, in metres a second
    let mut _bounceThreshold: f32 = 1.0f;

    // The linear speed under which a body is still, in metres a second
    let mut _sleepLinear: f32 = 0.05f;

    // The angular speed under which a body is still, in radians a second
    let mut _sleepAngular: f32 = 0.05f;

    // The time an island stays still before it sleeps, in seconds
    let mut _sleepTime: f32 = 0.5f;

    /**
     * The default configuration
     * */
    pub self () {}

    pub self (cfg: &Config)
        throws BalderError
    {
        if let Ok(g) = cfg["gravity"]? {
            self._gravity = readGravity(g);
        }

        if let Ok(i) = cfg["substeps"]? {
            self._substeps = readCount(i, "substeps", 16);
        }

        if let Ok(i) = cfg["max-substeps"]? {
            self._maxSubsteps = readCount(i, "max-substeps", 64);
        }

        if let Ok(f) = cfg["max-sink"]? { self._maxSink = readNumber(f, "max-sink", 0.0f, f32::max); }

        if let Ok(i) = cfg["iterations"]? {
            self._iterations = readCount(i, "iterations", 256);
        }

        if let Ok(f) = cfg["contact-hertz"]? { self._contactHertz = readNumber(f, "contact-hertz", 1.0f, 1000.0f); }
        if let Ok(f) = cfg["contact-damping"]? { self._contactDamping = readNumber(f, "contact-damping", 0.0f, 100.0f); }
        if let Ok(f) = cfg["joint-hertz"]? { self._jointHertz = readNumber(f, "joint-hertz", 1.0f, 1000.0f); }
        if let Ok(f) = cfg["joint-damping"]? { self._jointDamping = readNumber(f, "joint-damping", 0.0f, 100.0f); }
        if let Ok(f) = cfg["max-correction"]? { self._maxCorrection = readNumber(f, "max-correction", 0.0f, f32::max); }
        if let Ok(f) = cfg["bounce-threshold"]? {
            self._bounceThreshold = readNumber(f, "bounce-threshold", 0.0f, f32::max);
        }

        if let Ok(f) = cfg["sleep-linear"]? { self._sleepLinear = readNumber(f, "sleep-linear", 0.0f, f32::max); }
        if let Ok(f) = cfg["sleep-angular"]? { self._sleepAngular = readNumber(f, "sleep-angular", 0.0f, f32::max); }
        if let Ok(f) = cfg["sleep-time"]? { self._sleepTime = readNumber(f, "sleep-time", 0.0f, f32::max); }
    } catch {
        b: &BalderError => {
            throw copy BalderError("Failed to read physics configuration : " ~ b.msg);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the acceleration of the bodies falling, in metres a second squared
     * */
    @field
    pub fn gravity(self)-> vec3 {
        self._gravity
    }

    /**
     * @returns: the sub steps a step is solved in
     * */
    @field
    pub fn substeps(self)-> u32 {
        self._substeps
    }

    /**
     * @returns: the sub steps an island is solved in at most
     * */
    @field
    pub fn maxSubsteps(self)-> u32 {
        self._maxSubsteps
    }

    /**
     * @returns: how deep a contact may sink under the load it carries before its island is given more sub steps, in
     * metres
     * */
    @field
    pub fn maxSink(self)-> f32 {
        self._maxSink
    }

    /**
     * @returns: the passes of the solver over the contacts at each sub step
     * */
    @field
    pub fn iterations(self)-> u32 {
        self._iterations
    }

    /**
     * @returns: the frequency of the spring pushing a penetration out, in hertz
     * */
    @field
    pub fn contactHertz(self)-> f32 {
        self._contactHertz
    }

    /**
     * @returns: the damping ratio of the spring pushing a penetration out
     * */
    @field
    pub fn contactDamping(self)-> f32 {
        self._contactDamping
    }

    /**
     * @returns: the frequency of the spring pulling the error of a joint back, in hertz
     * */
    @field
    pub fn jointHertz(self)-> f32 {
        self._jointHertz
    }

    /**
     * @returns: the damping ratio of the spring pulling the error of a joint back
     * */
    @field
    pub fn jointDamping(self)-> f32 {
        self._jointDamping
    }

    /**
     * @returns: the speed the correction of a penetration pushes out by at most, in metres a second
     * */
    @field
    pub fn maxCorrection(self)-> f32 {
        self._maxCorrection
    }

    /**
     * @returns: the speed two bodies must close by for a contact to bounce, in metres a second
     * */
    @field
    pub fn bounceThreshold(self)-> f32 {
        self._bounceThreshold
    }

    /**
     * @returns: the linear speed under which a body is still, in metres a second
     * */
    @field
    pub fn sleepLinear(self)-> f32 {
        self._sleepLinear
    }

    /**
     * @returns: the angular speed under which a body is still, in radians a second
     * */
    @field
    pub fn sleepAngular(self)-> f32 {
        self._sleepAngular
    }

    /**
     * @returns: the time an island stays still before it sleeps, in seconds
     * */
    @field
    pub fn sleepTime(self)-> f32 {
        self._sleepTime
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
}

/**
 * @returns: the gravity `cfg`, an array of three numbers
 * @throws:
 *    - &BalderError: if `cfg` is not such an array
 * */
fn readGravity(cfg: &Config)-> vec3
    throws BalderError
{
    let mut values: [f32] = [];
    if let arr: &Array = cfg {
        for v in arr[] {
            values ~= [readNumber(v, "gravity", -f32::max, f32::max)];
        }
    }

    if values.len != 3us {
        throw copy BalderError("Physics gravity must be an array of three numbers, x, y and z");
    }

    makeVec3(values[0], values[1], values[2])
}

/**
 * @returns: the count `cfg`, an integer from 1 to max
 * @throws:
 *    - &BalderError: if `cfg` is not such an integer
 * */
fn readCount(cfg: &Config, name: [c8], max: i64)-> u32
    throws BalderError
{
    if let Int(value-> i) = cfg {
        if i >= 1 && i <= max {
            return cast!u32(i);
        }
    }

    throw copy BalderError(f"Physics ${name} must be an integer from 1 to ${max}");
}

/**
 * @returns: the number `cfg`, within [min, max]
 * @throws:
 *    - &BalderError: if `cfg` is not a number, or out of the bounds
 * */
fn readNumber(cfg: &Config, name: [c8], min: f32, max: f32)-> f32
    throws BalderError
{
    let value = match cfg {
        Float(value-> f) => { f }
        Int(value-> i) => { cast!f64(i) }
        _ => {
            throw copy BalderError(f"Physics ${name} must be a number");
        }
    };

    // Written so that NaN is rejected as well
    if !(value >= cast!f64(min) && value <= cast!f64(max)) {
        throw copy BalderError(f"Physics ${name} must be from ${min} to ${max}");
    }

    cast!f32(value)
}
