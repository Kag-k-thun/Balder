in dispose;

/**
 * An object holding resources that are released by dispose, not by the collector
 * GPU objects follow these lifetime rules:
 *    - an object that recorded commands may reference (buffers, descriptor sets, textures) is never
 *      disposed directly, it is retired (Window.retire, VulkanDevice.retire): it is disposed once every
 *      frame slot was recorded again without it and its previous submission awaited, and the retire
 *      requests that redraw itself
 *    - an object that only submitted commands use (staging buffers, command allocators of a replaced
 *      recording) is retired after the frame (Window.retireAfterFrame, VulkanDevice.retireAfterFrame)
 *    - a resource loaded through the window is released by disposing its RefCount, which retires it
 *      with the last reference
 *    - __dtor never disposes: the collector runs at any time, while the GPU may still use the object or
 *      after the device is gone. In debug it reports the objects collected without being retired
 * */
pub trait Disposable {
    pub fn dispose(mut self);
}
