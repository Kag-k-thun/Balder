in instance_batch;

pub mod ::utils;
pub mod ::table;
pub mod ::grouping;

use balder::core::{dispose, error, memory::_};
use balder::core::driver::device;
use balder::core::shader::buffers::instance_draw;
use balder::core::shader::buffers::instance_batch::{grouping, table, utils};
use balder::utils::log;

use std::algorithm::comparison;

use ::etc::c::memory;

use ::vulkan::core;

/**
 * The smallest number of commands the buffers of a frame hold
 * */
def MIN_COMMANDS = 64us;

/**
 * The size of the word of an instance in bytes
 * */
def WORD_SIZE = 4us;

/**
 * The counters at the start of the counter buffer of a frame culled on the GPU: the number of commands written by the
 * first phase of the cull pass (read by its draw indirect count call, one command per cluster seen), the number of
 * triangles they draw, the same two counters for the second phase (see the occlusion below), then the number of
 * candidates whose object the camera sees and the size of the indirect dispatch of the clusters of those candidates
 * (x, y, z); the candidates listed follow
 * */
def COUNTER_HEADER = 8us;

/**
 * The index in the counters of the number of commands written by the second phase of the cull pass
 * */
def LATE_COUNTER = 2us;

/**
 * The index in the counters of the indirect dispatch of the clusters of the candidates seen
 * */
def DISPATCH_COUNTER = 5us;

/**
 * The number of counters copied for the CPU, the commands and the triangles of the two phases
 * */
def READBACK_COUNTERS = 4us;

/**
 * The draws of objects laid out by the recordings of a subpass, the draws of the same range of indices being drawn by
 * one instanced command, the closest instances first, drawn by draw indirect calls over runs of the commands
 * @info: the commands of a frame read the words of their instances (the slots of the objects...) in a storage buffer of
 * the frame, each command from its first instance; a recording lays out as many commands as draws, the commands not
 * needed drawing nothing
 * @info: each frame in flight has its own objects, laid out by its recording, and its own buffers of commands and of
 * words, built again at its submission when the draws of its objects changed; a frame never draws the objects laid out
 * by the recording of another, nor commands placing geometry the buffers it bound do not hold
 * @info: when culled on the GPU, the draws are culled cluster by cluster: the words built are the candidates of a cull
 * pass, one per draw laid out with the range of its clusters (see DrawGrouping::candidates), no command being built;
 * the pass lists the candidates whose object it sees, then tests each cluster of those, writing one command per cluster
 * seen and the word of its instance in buffers of the GPU, with their number in a counter buffer read by a draw indirect
 * count call, the CPU reading the counters back once the submission of the frame is over
 * @info: the clusters a frame culls are bounded by the bounds of the draws laid out (InstanceDraw::clusterBound), its
 * capacity, so the draws modified in place (a new level of detail...) fit in the buffers of its recording
 * @info: the cull pass runs in two phases when the clusters hidden behind others are culled (occlusion): the first one
 * draws the clusters seen by the last frame, whose depth gives a depth pyramid the second one tests the others against,
 * drawing those it finds; the commands of the second phase follow the capacity of the first one, and the visibility of
 * each cluster of each candidate is kept for the next frame (see getVisibilityBuffer)
 * */
@final
pub class InstanceBatch {

    pub let uid: usize;

    // The device the buffers are allocated on
    let dmut _device: &VulkanDevice;

    // True when the draws modified are drawn by the next submissions without recording them again (multi-draw)
    let _inPlace: bool;

    // True when the instances are culled on the GPU, the commands and the words built being the templates and the
    // candidates of a cull pass
    let mut _culled: bool = false;

    // True when the last recording of each frame laid out its objects to be culled on the GPU
    let mut _frameCulled: [mut bool] = [];

    // The draws of the objects, their distances to the camera, and the objects laid out by the last recording of each
    // frame with the number of their draws laid out, as many commands
    let dmut _table: &InstanceTable;

    // The grouping of the draws into commands, its buffers kept from a build to the next (the rendering thread only)
    let dmut _grouping: &DrawGrouping = copy DrawGrouping();

    // The commands of each frame
    let dmut _commands: [[VkDrawIndexedIndirectCommand]] = [];

    // The words of the instances of each frame
    let dmut _words: [[u32]] = [];

    // The number of commands drawing something, of instances and of triangles, at the last build of a frame
    let mut _drawn: (u32, u32, u32) = (0u32, 0u32, 0u32);

    // The buffer of indirect commands read by each frame
    let dmut _commandCopies: [(&Buffer)?] = [];

    // The storage buffer of the words read by each frame
    let dmut _wordCopies: [(&Buffer)?] = [];

    // The commands of each frame to write in its buffer at its submission
    let mut _dirtyCommands: FrameRanges;

    // The words of each frame to write in its buffer at its submission
    let mut _dirtyWords: FrameRanges;

    prv { // Culling on the GPU

        // The number of clusters the cull pass of each frame culls at most, the bounds of the draws it laid out
        let mut _capacities: [mut u32] = [];

        // The commands written by the cull pass of each frame, one per cluster it sees
        let dmut _culledCommands: [(&Buffer)?] = [];

        // The words of the instances seen by the cull pass of each frame, read by the shaders, each followed by the slot of
        // its cluster
        let dmut _culledWords: [(&Buffer)?] = [];

        // The counters of the cull pass of each frame (see COUNTER_HEADER)
        let dmut _counters: [(&Buffer)?] = [];

        // The header of the counters of each frame, copied for the CPU at the end of its cull pass
        let dmut _readbacks: [(&Buffer)?] = [];

        // The visibility of each cluster of each candidate of each frame at its last cull pass, written by the second
        // phase, read by the first one of the next pass of the frame
        let dmut _visibilities: [(&Buffer)?] = [];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create an empty batch, written at the submission of each frame until it is disposed
     * @params:
     *    - device: the device the buffers are allocated on
     * */
    pub self (dmut device: &VulkanDevice)
        with uid = device:.getMemoryAllocator():.nextBufferId()
        , _device = alias device
        , _inPlace = device.isMultiDraw()
        , _dirtyCommands = FrameRanges(device.getNbFrames())
        , _dirtyWords = FrameRanges(device.getNbFrames())
        , _table = copy InstanceTable(device.getNbFrames())
    {
        let nbFrames = device.getNbFrames();
        self._frameCulled = copy [false; nbFrames];
        self._capacities = copy [0u32; nbFrames];

        let dmut commands: [[VkDrawIndexedIndirectCommand]] = [];
        let dmut words: [[u32]]                            = [];
        let dmut commandCopies: [(&Buffer)?]               = [];
        let dmut wordCopies: [(&Buffer)?]                  = [];
        let dmut culledCommands: [(&Buffer)?]              = [];
        let dmut culledWords: [(&Buffer)?]                 = [];
        let dmut counters: [(&Buffer)?]                    = [];
        let dmut readbacks: [(&Buffer)?]                   = [];
        let dmut visibilities: [(&Buffer)?]                = [];
        for _ in 0u32 .. nbFrames {
            commands ~= [[]];
            words ~= [[]];
            commandCopies ~= [none];
            wordCopies ~= [none];
            culledCommands ~= [none];
            culledWords ~= [none];
            counters ~= [none];
            readbacks ~= [none];
            visibilities ~= [none];
        }

        self._commands = alias commands;
        self._words = alias words;
        self._commandCopies = alias commandCopies;
        self._wordCopies = alias wordCopies;
        self._culledCommands = alias culledCommands;
        self._culledWords = alias culledWords;
        self._counters = alias counters;
        self._readbacks = alias readbacks;
        self._visibilities = alias visibilities;

        device:.getMemoryAllocator():.registerInFlight(self.uid, &self:.flush);
    }

    // Disposing from the collector races with the GPU and with the device teardown, the object has to be retired
#if DEBUG
    __dtor(mut self) {
        if self._commands.len != 0us {
            log::warn #("Dispose", self.__typeinfo__.name, "collected without being retired");
        }
    }
#end

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          LAYOUT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Start the layout of the objects of a frame, those of its previous recording being dropped
     * @assume: the previous submission of the frame was awaited
     * */
    pub fn begin(mut self, frame: u32) {
        atomic self {
            self._table:.begin(frame);
        }
    }

    /**
     * Lay out the draws of an object with the ones laid out since begin
     * @params:
     *    - frame: the frame being recorded
     *    - owner: the uniq id of the object, to modify its draws, see update
     *    - draws: the draws of the object, the object keeping as many until its next layout
     * */
    pub fn add(mut self, frame: u32, owner: usize, draws: [InstanceDraw]) {
        atomic self {
            self._table:.add(frame, owner, draws);
        }
    }

    /**
     * End the layout of the objects of a frame, its commands (or its candidates, when culled on the GPU) being built and
     * its buffers enlarged to hold them
     * @returns: the number of draws laid out, the number of commands to draw when culled on the CPU, the number of
     * candidates otherwise
     * */
    pub fn end(mut self, frame: u32)-> u32
        throws BalderError
    {
        atomic self {
            self._frameCulled[frame] = self._culled;

            let count = cast!usize(self._table.getCount(frame));
            let nbWords = if self._culled { count * CANDIDATE_WORDS } else { count };
            if !self._culled && count > self._commands[frame].len {
                let extra = max(count - self._commands[frame].len, max(self._commands[frame].len, 16us));
                self._commands[frame] = self._commands[frame] ~ copy [VkDrawIndexedIndirectCommand(); extra];
            }

            if nbWords > self._words[frame].len {
                let extra = max(nbWords - self._words[frame].len, max(self._words[frame].len, 16us));
                self._words[frame] = self._words[frame] ~ copy [0u32; extra];
            }

            self:.reserve(frame, nbWords * WORD_SIZE, false);
            if self._culled {
                self._capacities[frame] = clusterCapacity(self._table:.collectLaid(frame));
                self:.reserveCulled(frame, count, cast!usize(self._capacities[frame]));
            } else {
                self:.reserve(frame, count * VkDrawIndexedIndirectCommand::size, true);
            }

            self:.build(frame);

            return self._table.getCount(frame);
        }
    }

    /**
     * Cull the instances on the GPU or on the CPU from the next layout of each frame, a frame keeping the way it was laid
     * out until then
     * @info: the recordings have to be done again, the buffers they bind and the calls drawing the commands changing
     * @params:
     *    - culled: true for a cull pass to write the commands from the templates and the candidates built
     * */
    pub fn setCulled(mut self, culled: bool) {
        atomic self {
            self._culled = culled;
        }
    }

    /**
     * Modify the draws of an object, drawn by the next submission of the frames laying it out, a frame being requested
     * @info: without multi-draw, the modification is drawn once the recordings are done again
     * @params:
     *    - owner: the uniq id the object was laid out with
     *    - draws: the draws of the object, as many as laid out
     * */
    pub fn update(mut self, owner: usize, draws: [InstanceDraw]) {
        atomic self {
            if !self._table:.update(owner, draws) { return; }
        }

        self._device:.requestFrame();
    }

    /**
     * Set the distance of an object to the camera, its instances being drawn before those of the farther objects
     * @info: without multi-draw, the order is changed once the recordings are done again
     * */
    pub fn setDistance(mut self, owner: usize, distance: f32) {
        atomic self {
            self._table:.setDistance(owner, distance);
        }
    }

    /**
     * Set the distances of objects to the camera at once, see setDistance
     * @params:
     *    - owners: the uniq ids of the objects
     *    - distances: the distance of each of them, in the same order
     * */
    pub fn setDistances(mut self, owners: [usize], distances: [f32]) {
        atomic self {
            for i in 0us .. owners.len {
                self._table:.setDistance(owners[i], distances[i]);
            }
        }
    }

    /**
     * Remove an object, the next submissions of the frames laying it out drawing it no more
     * @info: without multi-draw, the object is drawn until the recordings are done again
     * */
    pub fn remove(mut self, owner: usize) {
        atomic self {
            self._table:.remove(owner);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the command 'index' of the frame 'frame'
     * */
    pub fn getCommand(self, frame: u32, index: u32)-> VkDrawIndexedIndirectCommand {
        atomic self {
            self._commands[frame][index]
        }
    }

    /**
     * @returns: the number of commands laid out by the last recording of the frame 'frame'
     * */
    pub fn getCount(self, frame: u32)-> u32 {
        atomic self {
            self._table.getCount(frame)
        }
    }

    /**
     * @returns: true iif the last recording of the frame 'frame' laid out its objects to be culled on the GPU
     * */
    pub fn isCulled(self, frame: u32)-> bool {
        atomic self {
            self._frameCulled[frame]
        }
    }

    /**
     * @returns: the number of commands drawing something, the number of instances and the number of triangles they draw,
     * at the last build of a frame, or at the last cull pass read back when culled on the GPU (a command per cluster)
     * */
    pub fn getDrawn(self)-> (u32, u32, u32) {
        atomic self {
            self._drawn
        }
    }

    /**
     * @returns: the buffer of indirect commands read by the frame 'frame', null if nothing was laid out or when culled on
     * the GPU
     * */
    pub fn getVulkanBuffer(self, frame: u32)-> VkBuffer {
        atomic self {
            if let Ok(c) = self._commandCopies[frame] {
                return c.getVulkanBuffer();
            }

            return null;
        }
    }

    /**
     * @returns: the storage buffer of the words of the instances read by the shaders drawing the frame 'frame', written by
     * the cull pass when culled on the GPU, none if nothing was laid out
     * */
    pub fn getWordBuffer(self, frame: u32)-> (&Buffer)? {
        atomic self {
            if self._frameCulled[frame] {
                return self._culledWords[frame];
            }

            self._wordCopies[frame]
        }
    }

    /**
     * @returns: the candidates of the cull pass of the frame 'frame', the words built (see DrawGrouping::candidates), none
     * if nothing was laid out
     * */
    pub fn getCandidateBuffer(self, frame: u32)-> (&Buffer)? {
        atomic self {
            self._wordCopies[frame]
        }
    }

    /**
     * @returns: the commands written by the cull pass of the frame 'frame', none unless culled on the GPU
     * */
    pub fn getCulledCommandBuffer(self, frame: u32)-> (&Buffer)? {
        atomic self {
            if !self._frameCulled[frame] { return none; }
            self._culledCommands[frame]
        }
    }

    /**
     * @returns: the counters of the cull pass of the frame 'frame', the number of commands it wrote first, none unless
     * culled on the GPU
     * */
    pub fn getCounterBuffer(self, frame: u32)-> (&Buffer)? {
        atomic self {
            if !self._frameCulled[frame] { return none; }
            self._counters[frame]
        }
    }

    /**
     * @returns: the buffer the header of the counters of the frame 'frame' is copied in for the CPU, none unless culled on
     * the GPU
     * */
    pub fn getReadbackBuffer(self, frame: u32)-> (&Buffer)? {
        atomic self {
            if !self._frameCulled[frame] { return none; }
            self._readbacks[frame]
        }
    }

    /**
     * @returns: the visibility of the clusters of the candidates of the cull pass of the frame 'frame', one word each,
     * none unless culled on the GPU
     * @info: the content is undefined until a cull pass of the frame culling the occluded clusters wrote it, and when
     * the candidates of the frame are laid out again; it only decides which clusters the first phase draws, the second
     * phase drawing the others it finds
     * */
    pub fn getVisibilityBuffer(self, frame: u32)-> (&Buffer)? {
        atomic self {
            if !self._frameCulled[frame] { return none; }
            self._visibilities[frame]
        }
    }

    /**
     * @returns: the number of clusters the cull pass of the frame 'frame' culls at most, the most commands each of its
     * phases writes
     * */
    pub fn getCulledCapacity(self, frame: u32)-> u32 {
        atomic self {
            self._capacities[frame]
        }
    }

    /**
     * @returns: the offset in bytes of the first command of a phase of the cull pass of the frame 'frame', in the buffer
     * of the commands it writes
     * @params:
     *    - late: false for the first phase, true for the second one
     * */
    pub fn getCulledCommandOffset(self, frame: u32, late: bool)-> u64 {
        if !late { return 0u64; }
        cast!u64(self.getCulledCapacity(frame)) * cast!u64(VkDrawIndexedIndirectCommand::size)
    }

    /**
     * @returns: the offset in bytes of the number of commands written by a phase of the cull pass, in the counters
     * @params:
     *    - late: false for the first phase, true for the second one
     * */
    pub fn getCountOffset(self, late: bool)-> u64 {
        if !late { return 0u64; }
        cast!u64(LATE_COUNTER * WORD_SIZE)
    }

    /**
     * @returns: the offset in bytes of the indirect dispatch of the clusters of the candidates seen, in the counters
     * */
    pub fn getDispatchOffset(self)-> u64 {
        cast!u64(DISPATCH_COUNTER * WORD_SIZE)
    }

    /**
     * @returns: the size in bytes of the counters copied for the CPU, at the start of the counters
     * */
    pub fn getCounterHeaderSize(self)-> usize {
        READBACK_COUNTERS * WORD_SIZE
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          FLUSH          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Build the commands of a frame again when the draws of its objects changed, and write the commands and the words
     * modified since the last write of its buffers
     * @assume: the previous submission of the frame was awaited
     * */
    pub fn flush(mut self, frame: u32) {
        // the draws of a stale frame are grouped outside the lock, the objects being modified meanwhile for the next build
        let stale = atomic self {
            if frame >= cast!u32(self._commandCopies.len) { return; }
            if self._frameCulled[frame] {
                self:.readBack(frame);
            }

            if self._table.isStale(frame) && self._inPlace {
                self._table:.built(frame);
                if self._frameCulled[frame] {
                    // the candidates need no grouping
                    self:.writeCandidates(frame);
                    none
                } else {
                    (self._table:.collect(frame))?
                }
            } else {
                none
            }
        };

        let grouped = if let Ok(draws) = stale { (self._grouping:.group(draws))? } else { none };

        atomic self {
            // disposed meanwhile
            if frame >= cast!u32(self._commandCopies.len) { return; }
            if let Ok((commands, words)) = grouped {
                self:.writeBuilt(frame, commands, words);
            }

            if let Ok((start, end)) = self._dirtyCommands:.take(frame) {
                if let Ok(dmut target) = alias self._commandCopies[frame] {
                    let source = cast!{*void} (self._commands[frame].ptr);
                    let size   = self._commands[frame].len * VkDrawIndexedIndirectCommand::size;
                    self:.write(alias target, source, size, start, end);
                }
            }

            if let Ok((start, end)) = self._dirtyWords:.take(frame) {
                if let Ok(dmut target) = alias self._wordCopies[frame] {
                    let source = cast!{*void} (self._words[frame].ptr);
                    let size   = self._words[frame].len * WORD_SIZE;
                    self:.write(alias target, source, size, start, end);
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Build the commands and the words of a frame from the draws of its objects, or its candidates when culled on the GPU
     * @atomic
     * */
    fn build(mut self, frame: u32) {
        self._table:.built(frame);
        if self._frameCulled[frame] {
            self:.writeCandidates(frame);
            return;
        }

        let (commands, words) = self._grouping:.group(self._table:.collect(frame));
        self:.writeBuilt(frame, commands, words);
    }

    /**
     * Write the commands and the words built for a frame culled on the CPU, the commands past them drawing nothing
     * @atomic
     * */
    fn writeBuilt(mut self, frame: u32, commands: [VkDrawIndexedIndirectCommand], words: [u32]) {
        let count = self._table.getCount(frame);
        for i in 0u32 .. count {
            let c = if cast!usize(i) < commands.len { commands[i] } else { VkDrawIndexedIndirectCommand() };
            self:.writeCommand(frame, i, c);
        }

        for i in 0u32 .. count {
            let w = if cast!usize(i) < words.len { words[i] } else { 0u32 };
            self:.writeWord(frame, i, w);
        }

        let mut triangles = 0u32;
        for c in commands {
            triangles += c.indexCount / 3u32 * c.instanceCount;
        }

        self._drawn = (cast!u32(commands.len), cast!u32(words.len), triangles);
    }

    /**
     * Write the candidates of the cull pass of a frame culled on the GPU, from the draws it laid out, the counters of
     * the cull pass giving the commands and the triangles drawn
     * @atomic
     * */
    fn writeCandidates(mut self, frame: u32) {
        let count = cast!usize(self._table.getCount(frame));
        for i, w in self._grouping:.candidates(self._table:.collectLaid(frame), count) {
            self:.writeWord(frame, cast!u32(i), w);
        }
    }

    /**
     * Read the counters of the last cull pass of a frame, the commands and the triangles it drew, a command per cluster
     * @atomic
     * @assume: the previous submission of the frame was awaited
     * */
    fn readBack(mut self, frame: u32) {
        if let Ok(dmut readback) = alias self._readbacks[frame] {
            let dmut header: [u32] = copy [0u32; READBACK_COUNTERS];

            let ptr = readback:.map();
            if ptr != null {
                memcpy(cast!{*void} (header.ptr), ptr, READBACK_COUNTERS * WORD_SIZE);
            }

            let commands = header[0] + header[LATE_COUNTER];
            self._drawn = (commands, commands, header[1] + header[LATE_COUNTER + 1us]);
        }
    }

    /**
     * Enlarge the buffers the cull pass of a frame writes to hold 'count' candidates and the commands and the instances
     * of 'capacity' clusters for each of its two phases, two words per instance
     * @atomic
     * */
    fn reserveCulled(mut self, frame: u32, count: usize, capacity: usize)
        throws BalderError
    {
        let local = cast!u32(VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
        let commandUsage = cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT
                                    | VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
        let wordUsage = cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
        let counterUsage = cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT
                                    | VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
                                    | VkBufferUsageFlagBits::VK_BUFFER_USAGE_TRANSFER_SRC_BIT
                                    | VkBufferUsageFlagBits::VK_BUFFER_USAGE_TRANSFER_DST_BIT);

        self._culledCommands[frame] = self:.enlarge(alias self._culledCommands[frame],
                                                    2us * capacity * VkDrawIndexedIndirectCommand::size,
                                                    commandUsage,
                                                    local);
        // two words per command, the word of its instance and the slot of its cluster
        self._culledWords[frame] = self:.enlarge(alias self._culledWords[frame], 4us * capacity * WORD_SIZE, wordUsage, local);
        self._counters[frame] = self:.enlarge(alias self._counters[frame],
                                              (COUNTER_HEADER + count) * WORD_SIZE,
                                              counterUsage,
                                              local);
        self._visibilities[frame] = self:.enlarge(alias self._visibilities[frame], capacity * WORD_SIZE, wordUsage, local);

        if !self._readbacks[frame].hasValue {
            let dmut readback = self._device
                :.getMemoryAllocator()
                :.allocBuffer(READBACK_COUNTERS * WORD_SIZE,
                              cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_TRANSFER_DST_BIT),
                              cast!u32(VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT
                                       | VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_HOST_COHERENT_BIT));

            // read before the first cull pass of the frame copies its counters
            let zeros: [u32] = copy [0u32; READBACK_COUNTERS];
            self:.write(alias readback, cast!{*void} (zeros.ptr), READBACK_COUNTERS * WORD_SIZE, 0us, READBACK_COUNTERS * WORD_SIZE);
            self._readbacks[frame] = (alias readback)?;
        }
    }

    /**
     * @returns: a buffer of 'size' bytes at least, 'current' when it is large enough, a buffer twice as large otherwise,
     * 'current' being retired once the frame is over
     * @atomic
     * @params:
     *    - current: the buffer in use, none if there is none
     *    - usage: the usage of a new buffer
     *    - memory: the memory properties of a new buffer
     * */
    fn enlarge(mut self, dmut current: (&Buffer)?, size: usize, usage: u32, memory: u32)-> dmut (&Buffer)?
        throws BalderError
    {
        if let Ok(c) = current {
            if size <= c.getSize() { return alias current; }
        }

        let dmut larger = self._device
            :.getMemoryAllocator()
            :.allocBuffer(max(size * 2us, MIN_COMMANDS * VkDrawIndexedIndirectCommand::size), usage, memory);

        // only the replaced recording of the frame, whose submission was awaited, read the buffer
        if let Ok(dmut old) = alias current {
            self._device:.retireAfterFrame(&old:.dispose);
        }

        (alias larger)?
    }

    /**
     * Enlarge the buffer of commands or of words of a frame to hold 'size' bytes, written whole at its submission
     * @atomic
     * @params:
     *    - commands: true for the buffer of commands, false for the buffer of words
     * */
    fn reserve(mut self, frame: u32, size: usize, commands: bool)
        throws BalderError
    {
        let current = if commands { self._commandCopies[frame] } else { self._wordCopies[frame] };
        let capacity = if let Ok(c) = current { c.getSize() } else { 0us };
        if size <= capacity && capacity != 0us { return; }

        let elem: usize = if commands { cast!usize(VkDrawIndexedIndirectCommand::size) } else { WORD_SIZE };
        // the commands are the templates the cull pass reads when culled on the GPU
        let usage = if commands {
            VkBufferUsageFlagBits::VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT
            | VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
        } else {
            VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
        };

        let dmut larger = self._device
            :.getMemoryAllocator()
            :.allocBuffer(max(size * 2us, MIN_COMMANDS * elem),
                          cast!u32(usage),
                          cast!u32(VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT
                                   | VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_HOST_COHERENT_BIT));

        // only the replaced recording of the frame, whose submission was awaited, read the buffer
        if commands {
            if let Ok(dmut old) = alias self._commandCopies[frame] {
                self._device:.retireAfterFrame(&old:.dispose);
            }

            self._commandCopies[frame] = (alias larger)?;
            self._dirtyCommands:.markFrame(frame, 0us, larger.getSize());
        } else {
            if let Ok(dmut old) = alias self._wordCopies[frame] {
                self._device:.retireAfterFrame(&old:.dispose);
            }

            self._wordCopies[frame] = (alias larger)?;
            self._dirtyWords:.markFrame(frame, 0us, larger.getSize());
        }
    }

    /**
     * Write a command of a frame, marked for the next write of its buffer if it changed
     * @atomic
     * */
    fn writeCommand(mut self, frame: u32, index: u32, command: VkDrawIndexedIndirectCommand) {
        let old = self._commands[frame][index];
        if old.indexCount == command.indexCount
            && old.instanceCount == command.instanceCount
            && old.firstIndex == command.firstIndex
            && old.vertexOffset == command.vertexOffset
            && old.firstInstance == command.firstInstance {
            return;
        }

        self._commands[frame][index] = command;

        let start = cast!usize(index) * VkDrawIndexedIndirectCommand::size;
        self._dirtyCommands:.markFrame(frame, start, start + VkDrawIndexedIndirectCommand::size);
    }

    /**
     * Write the word of an instance of a frame, marked for the next write of its buffer if it changed
     * @atomic
     * */
    fn writeWord(mut self, frame: u32, index: u32, word: u32) {
        if self._words[frame][index] == word { return; }

        self._words[frame][index] = word;

        let start = cast!usize(index) * WORD_SIZE;
        self._dirtyWords:.markFrame(frame, start, start + WORD_SIZE);
    }

    /**
     * Write the bytes [start, end) of a local array in a buffer
     * @atomic
     * @params:
     *    - target: the buffer
     *    - source: the local array
     *    - size: the size of the local array in bytes
     * */
    fn write(mut self, dmut target: &Buffer, source: *void, size: usize, start: usize, end: usize) {
        let last = min(end, min(target.getSize(), size));
        if last <= start { return; }

        let dmut ptr = target:.map();
        if ptr != null {
            memcpy(ptr + start, source + start, last - start);
        } else {
            log::error #("InstanceBatch", "failed to map a buffer of the batch");
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            atomic self {
                if self._commands.len == 0us { return; }

                for dmut c in alias self._commandCopies {
                    if let Ok(dmut b) = alias c {
                        b:.dispose();
                    }
                }

                for dmut c in alias self._wordCopies {
                    if let Ok(dmut b) = alias c {
                        b:.dispose();
                    }
                }

                disposeAll(alias self._culledCommands);
                disposeAll(alias self._culledWords);
                disposeAll(alias self._counters);
                disposeAll(alias self._readbacks);
                disposeAll(alias self._visibilities);

                self._commandCopies = [];
                self._wordCopies = [];
                self._culledCommands = [];
                self._culledWords = [];
                self._counters = [];
                self._readbacks = [];
                self._visibilities = [];
                self._commands = [];
                self._words = [];
            }

            self._device:.getMemoryAllocator():.forgetInFlight(self.uid);
        }
    }
}
