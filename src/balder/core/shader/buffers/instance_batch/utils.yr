in utils;

use balder::core::memory::buffer;
use balder::core::shader::buffers::instance_draw;

use std::algorithm::sorting;

use ::vulkan::core;

/**
 * The command of a candidate of a cull pass drawing nothing, a candidate past the draws laid out
 * */
pub def NO_COMMAND = 0xffffffffu32;

/**
 * Group the draws of the same range of indices into instanced commands, the closest instances drawn first
 * @params:
 *    - draws: the draws, each with the distance of its object to the camera; the draws of no index are dropped
 * @returns:
 *    - .0: the commands, one per range, ordered by their closest instance
 *    - .1: the words of the instances, those of a command following each other from its first instance, closest first
 * */
pub fn groupInstances(draws: [(f32, InstanceDraw)])-> ([VkDrawIndexedIndirectCommand], [u32]) {
    let mut nb = 0us;
    for d in draws {
        let (_, draw) = d;
        if draw.indexCount != 0u32 { nb += 1us; }
    }

    let dmut entries = copy [(0.0f, InstanceDraw()); nb];
    let mut current = 0us;
    for d in draws {
        let (_, draw) = d;
        if draw.indexCount != 0u32 {
            entries[current] = d;
            current += 1us;
        }
    }

    // the draws of a range side by side, closest first
    sort(alias entries, |a, b| {
        let (da, x) = a;
        let (db, y) = b;
        if x.firstIndex != y.firstIndex { return x.firstIndex < y.firstIndex; }
        if x.vertexOffset != y.vertexOffset { return x.vertexOffset < y.vertexOffset; }
        if x.indexCount != y.indexCount { return x.indexCount < y.indexCount; }
        if da != db { return da < db; }
        x.word < y.word
    });

    // the ranges: the distance of their closest instance, their first entry and their number of entries
    let mut nbGroups = 0us;
    for i, e in entries {
        let (_, draw) = e;
        if i == 0us || !sameRange((entries[i - 1us])._1, draw) { nbGroups += 1us; }
    }

    let dmut ranges = copy [(0.0f, 0us, 0us); nbGroups];
    let mut g = 0us;
    for i, e in entries {
        let (distance, draw) = e;
        if i == 0us || !sameRange((entries[i - 1us])._1, draw) {
            ranges[g] = (distance, i, 1us);
            g += 1us;
        } else {
            let (d, first, n) = ranges[g - 1us];
            ranges[g - 1us] = (d, first, n + 1us);
        }
    }

    sort(alias ranges, |a, b| {
        if a._0 != b._0 { return a._0 < b._0; }
        a._1 < b._1
    });

    let mut commands: [mut VkDrawIndexedIndirectCommand] = copy [VkDrawIndexedIndirectCommand(); nbGroups];
    let mut words: [mut u32] = copy [0u32; nb];
    let mut first = 0u32;
    for k, r in ranges {
        let (_, range) = entries[r._1];
        commands[k].indexCount = range.indexCount;
        commands[k].instanceCount = cast!u32(r._2);
        commands[k].firstIndex = range.firstIndex;
        commands[k].vertexOffset = range.vertexOffset;
        commands[k].firstInstance = first;

        for i in 0us .. r._2 {
            let (_, draw) = entries[r._1 + i];
            words[cast!usize(first) + i] = draw.word;
        }

        first += cast!u32(r._2);
    }

    (commands, words)
}

/**
 * Pair the words of the instances of grouped commands with the index of their command, the candidates of a cull pass
 * that draws again the instances it sees, in the command of their range
 * @params:
 *    - commands: the commands, as groupInstances returns them
 *    - words: the words of their instances, as groupInstances returns them
 *    - count: the number of candidates, as many as the draws laid out, those past the words drawing nothing
 * @returns: 2 * count words, the word of each candidate followed by the index of its command (NO_COMMAND when it draws
 * nothing), the candidates of a command following each other from its first instance
 * */
pub fn cullCandidates(commands: [VkDrawIndexedIndirectCommand], words: [u32], count: usize)-> [u32] {
    let mut candidates: [mut u32] = copy [0u32; 2us * count];
    for i in 0us .. count {
        candidates[2us * i + 1us] = NO_COMMAND;
    }

    for k, c in commands {
        for i in c.firstInstance .. c.firstInstance + c.instanceCount {
            let index = cast!usize(i);
            if index >= count || index >= words.len { break; }

            candidates[2us * index] = words[index];
            candidates[2us * index + 1us] = cast!u32(k);
        }
    }

    candidates
}

/**
 * Dispose the buffers of the frames of a batch, those allocated
 * */
pub fn disposeAll(dmut buffers: [(&Buffer)?]) {
    for dmut c in alias buffers {
        if let Ok(dmut b) = alias c {
            b:.dispose();
        }
    }
}

/**
 * @returns: true iif two draws draw the same range of indices
 * */
fn sameRange(a: InstanceDraw, b: InstanceDraw)-> bool {
    a.firstIndex == b.firstIndex && a.vertexOffset == b.vertexOffset && a.indexCount == b.indexCount
}
