in utils;

use balder::core::memory::buffer;
use balder::core::shader::buffers::instance_draw;

/**
 * The number of words of a candidate of the cull pass: the word of its instance, its first cluster, its number of
 * clusters, and the first word of the visibility of its clusters
 * */
pub def CANDIDATE_WORDS = 4us;

/**
 * Dispose the buffers of the frames of a batch, those allocated
 * */
pub fn disposeAll(dmut buffers: [(&Buffer)?]) {
    for dmut c in alias buffers {
        if let Ok(dmut b) = alias c {
            b:.dispose();
        }
    }
}

/**
 * @returns: the number of clusters the cull pass reserves for draws laid out, the bound of each draw
 * */
pub fn clusterCapacity(draws: [InstanceDraw])-> u32 {
    let mut capacity = 0u32;
    for d in draws {
        capacity += d.clusterBound;
    }

    capacity
}
