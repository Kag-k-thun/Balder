in instance_draw;

/**
 * A draw of an object laid out in a draw batch: a range of the indices of a geometry pool, drawn once with a word the
 * shaders read at its instance (the slot of the object, the role of the draw...)
 * @info: the draws of a batch drawing the same range are drawn by one instanced command, see DrawBatch
 * @info: when culled on the GPU, the range is split into clusters of triangles, each culled and drawn on its own
 * */
@data
pub record InstanceDraw {

    // The number of indices drawn, the draw drawing nothing when 0
    pub let mut indexCount: u32 = 0u32;

    // The first index drawn
    pub let mut firstIndex: u32 = 0u32;

    // The value added to the indices before reading the vertices
    pub let mut vertexOffset: i32 = 0;

    // The word read by the shaders at the instance of the draw
    pub let mut word: u32 = 0u32;

    // The first cluster of the range in the clusters of the pool, when the draw is culled on the GPU cluster by cluster
    pub let mut firstCluster: u32 = 0u32;

    // The number of clusters of the range, the draw drawing nothing when culled on the GPU with 0
    pub let mut clusterCount: u32 = 0u32;

    // The most clusters the draws of the object have until it is laid out again (the clusters of its largest level),
    // whatever this one draws, the cull pass reserving as many for it
    pub let mut clusterBound: u32 = 0u32;

}
