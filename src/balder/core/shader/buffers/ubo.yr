in ubo;

use balder::core::{dispose, driver::_, error, memory::_};
use balder::utils::log;

use std::{io, stream};

use ::vulkan::_;

/**
 * Ancestor of all uniform buffers
 * @info: the buffer has a copy per frame in flight, see InFlightBuffer, so the passes of a frame read the values written
 * before its submission, and never those written for a later frame
 */
@final
pub class UniformBufferObject {

    // The buffers containing the uniform values, one per frame in flight
    let dmut _uniformBuffers: (&InFlightBuffer)? = none;

    /**
     * Create an empty ubo
     */
    pub self (dmut device: &VulkanDevice, size: usize)
        throws BalderError
    {
        let dmut buffer = device
            :.getMemoryAllocator()
            :.allocInFlightBuffer(size, cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT));

        self._uniformBuffers = (alias buffer)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the vulkan handle of the copy read by the frame 'frame'
     * */
    pub fn getVulkanBuffer(self, frame: u32)-> VkBuffer {
        if let Ok(d) = self._uniformBuffers {
            return d.getVulkanBuffer(frame);
        }

        panic;
    }

    pub fn getSize(self)-> usize {
        if let Ok(d) = self._uniformBuffers {
            return d.getSize();
        }

        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          UPDATING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Update the data of the uniform buffer, written in the copy of each frame at its next submission
     * */
    pub fn setData {U} (mut self, offset: usize, data: U) {
        if let Ok(dmut d) = alias self._uniformBuffers {
            d:.setData!{U} (offset, data);
        }
    }

    /**
     * Update the data of the uniform buffer, written in the copy of each frame at its next submission
     * */
    pub fn setData {T of [U], U} (mut self, offset: usize, data: T) {
        if let Ok(dmut d) = alias self._uniformBuffers {
            d:.setData!{T} (offset, data);
        }
    }

    /**
     * @returns: data from the uniform buffer
     * */
    pub fn getData {U} (self, offset: usize)-> U {
        if let Ok(d) = self._uniformBuffers {
            return d.getData!{U} (offset);
        }

        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable {
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write("UBO (");
            if let Ok(o) = self._uniformBuffers {
                stream:.write(o.uid, "|", o.getSize());
            }
            stream:.write(")");
        }
    }

    impl Disposable {
        pub over dispose(mut self) {
            if let Ok(dmut uni) = alias self._uniformBuffers {
                uni:.dispose();
                self._uniformBuffers = none;
            }
        }
    }

    // Disposing from the collector races with the GPU and with the device teardown, the object has to be retired
#if DEBUG
    __dtor(mut self) {
        if self._uniformBuffers.hasValue {
            log::warn #("Dispose", self.__typeinfo__.name, "collected without being retired");
        }
    }
#end
}
