in ibo;

use balder::core::{dispose, error};
use balder::core::driver::device;
use balder::core::memory::buffer;

use vulkan::core;

#if DEBUG
use balder::utils::log;
#end


/**
 * Ancestor of all ibos
 */
@abstract
pub class IndexBufferObject {

    // The buffer containing the index of the points
    let dmut _buf: (&Buffer)?;

    // The number of points in the mesh
    let mut _nbPoints: u32;

    /**
     * @params:
     *    - buf: the buffer containing the points
     *    - nbPoints: the number of points in the buffer
     */
    prot self ()
        with _buf = none
        , _nbPoints = 0u32
    {}

    /**
     * Use the index buffer for the next draw
     */
    pub fn select(self, cmd: VkCommandBuffer);

    /**
     * @returns: the buffer containing the points of the ibo
     */
    pub fn getBuffer(mut self)-> dmut (&Buffer)? {
        alias self._buf
    }

    /**
     * @returns: the number of points in the ibo
     */
    pub fn getNbPoints(self)-> u32 {
        self._nbPoints
    }

    impl Disposable {
        pub over dispose(mut self) {
            if let Ok(dmut buf) = alias self._buf {
                buf:.dispose();
                self._buf = none;
            }

            self._nbPoints = 0u32;
        }
    }

    // Disposing from the collector races with the GPU and with the device teardown, the object has to be retired
#if DEBUG
    __dtor(mut self) {
        if self._buf.hasValue {
            log::warn #("Dispose", self.__typeinfo__.name, "collected without being retired");
        }
    }
#end
}

/**
 * @templates:
 *    - U: an unsigned int type
 */
pub class if (template!{U} {T of u16} || template!{U} {T of u32}) IndexBufferObject {U} over ibo::IndexBufferObject {
    pub self () {}

    /**
     * @params:
     *    - device: the device used to allocate the buffer
     *    - datas: the datas to put in the buffer
     */
    pub self (dmut device: &VulkanDevice, datas: [U])
        throws BalderError
    {
        self:.update(alias device, datas);
    }

    pub fn update(mut self, dmut device: &VulkanDevice, datas: [U])
        throws BalderError
    {
        self._nbPoints = cast!u32(datas.len);
        let dmut ibuffer = device
            :.getMemoryAllocator()
            :.allocBuffer(datas.len * U::size,
                          cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_TRANSFER_DST_BIT
                                   | VkBufferUsageFlagBits::VK_BUFFER_USAGE_INDEX_BUFFER_BIT),
                          cast!u32(VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT));

        ibuffer:.update(datas);
        self._buf = (alias ibuffer)?;
    }

    /**
     * Use the index buffer for the next draw
     */
    pub over select(self, cmd: VkCommandBuffer) {
        if let Ok(buf) = self._buf {
            cte if (template!{U} {T of u16}) {
                vkCmdBindIndexBuffer(cmd, buf.getVulkanBuffer(), 0u64, VkIndexType::VK_INDEX_TYPE_UINT16);
            } else {
                vkCmdBindIndexBuffer(cmd, buf.getVulkanBuffer(), 0u64, VkIndexType::VK_INDEX_TYPE_UINT32);
            }
        }
    }
}
