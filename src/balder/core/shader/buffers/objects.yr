in objects;

use balder::core::{dispose, error, memory::_};
use balder::core::driver::device;

use ::vulkan::core;

/**
 * The data of the objects drawn by a pipeline (their world, their material...), one slot of 'stride' bytes per object in
 * a storage buffer, the shaders reading the slot of a draw at its instance index
 * @info: the buffer has a copy per frame in flight, see InFlightBuffer; when the slots are full the buffer is enlarged,
 * and the recordings binding it are done again
 * */
@final
pub class ObjectStorage {

    // The buffer of the slots
    let dmut _buffer: &InFlightBuffer;

    // The slots in use
    let dmut _slots: &SegmentList;

    // The size of a slot in bytes
    let _stride: usize;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - device: the device the buffer is allocated on
     *    - stride: the size of a slot in bytes, the stride of the array of the shaders (std430)
     *    - capacity: the number of slots allocated first
     * */
    pub self (dmut device: &VulkanDevice, stride: usize, capacity: usize = 64us)
        with _buffer = device
                  :.getMemoryAllocator()
                  :.allocInFlightBuffer(stride * capacity,
                                        cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT))
        , _slots = copy SegmentList(capacity)
        , _stride = stride
        throws BalderError
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the buffer holding the slots, to bind as the storage buffer of the shaders
     * */
    pub fn getBuffer(self)-> &InFlightBuffer {
        self._buffer
    }

    /**
     * @returns: the size of a slot in bytes
     * */
    pub fn getStride(self)-> usize {
        self._stride
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLOTS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reserve the slot of an object, enlarging the buffer when every slot is in use
     * @returns: the index of the slot
     * */
    pub fn alloc(mut self)-> u32
        throws BalderError
    {
        atomic self {
            if let Ok(slot) = self._slots:.alloc(1us, 1us) { return cast!u32(slot); }

            let capacity = self._slots.getSize() * 2us;
            self._buffer:.grow(capacity * self._stride);
            self._slots:.grow(capacity);

            if let Ok(slot) = self._slots:.alloc(1us, 1us) { return cast!u32(slot); }
        }

        throw copy BalderError("Failed to reserve an object slot");
    }

    /**
     * Give back the slot of an object
     * @info: a recording in flight drawing the object reads the data of the next object given the slot
     * */
    pub fn free(mut self, slot: u32) {
        atomic self {
            self._slots:.free(cast!usize(slot), 1us);
        }
    }

    /**
     * Write a value in the slot of an object
     * @params:
     *    - slot: the slot of the object
     *    - offset: the offset of the value in the slot, in bytes
     *    - value: the value to write
     * */
    pub fn setData {U} (mut self, slot: u32, offset: usize, value: U) {
        self._buffer:.setData!{U} (cast!usize(slot) * self._stride + offset, value);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._buffer:.dispose();
        }
    }
}
