in objects;

use balder::core::{dispose, error, memory::_};
use balder::core::driver::device;

use std::algorithm::comparison;

use ::vulkan::core;

/**
 * The data of the objects drawn by a pipeline (their world, their material...), one slot of 'stride' bytes per object in
 * a storage buffer, or a run of slots (the clusters of a geometry...), the shaders reading the slot of a draw at its
 * instance index
 * @info: the buffer has a copy per frame in flight, see InFlightBuffer; when the slots are full the buffer is enlarged,
 * and the recordings binding it are done again
 * */
@final
pub class ObjectStorage {

    // The buffer of the slots
    let dmut _buffer: &InFlightBuffer;

    // The slots in use
    let dmut _slots: &SegmentList;

    // The size of a slot in bytes
    let _stride: usize;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - device: the device the buffer is allocated on
     *    - stride: the size of a slot in bytes, the stride of the array of the shaders (std430)
     *    - capacity: the number of slots allocated first
     * */
    pub self (dmut device: &VulkanDevice, stride: usize, capacity: usize = 64us)
        with _buffer = device
                  :.getMemoryAllocator()
                  :.allocInFlightBuffer(stride * capacity,
                                        cast!u32(VkBufferUsageFlagBits::VK_BUFFER_USAGE_STORAGE_BUFFER_BIT))
        , _slots = copy SegmentList(capacity)
        , _stride = stride
        throws BalderError
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the buffer holding the slots, to bind as the storage buffer of the shaders
     * */
    pub fn getBuffer(self)-> &InFlightBuffer {
        self._buffer
    }

    /**
     * @returns: the size of a slot in bytes
     * */
    pub fn getStride(self)-> usize {
        self._stride
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLOTS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reserve the slots of an object, side by side, enlarging the buffer when no run of free slots is long enough
     * @params:
     *    - count: the number of slots (the clusters of a geometry...)
     * @returns: the index of the first slot
     * */
    pub fn alloc(mut self, count: usize = 1us)-> u32
        throws BalderError
    {
        atomic self {
            if let Ok(slot) = self._slots:.alloc(count, 1us) { return cast!u32(slot); }

            let capacity = max(self._slots.getSize() * 2us, self._slots.getReservedEnd() + count);
            self._buffer:.grow(capacity * self._stride);
            self._slots:.grow(capacity);

            if let Ok(slot) = self._slots:.alloc(count, 1us) { return cast!u32(slot); }
        }

        throw copy BalderError("Failed to reserve an object slot");
    }

    /**
     * Give back the slots of an object
     * @info: a recording in flight drawing the object reads the data of the next object given the slots
     * @params:
     *    - slot: the first slot
     *    - count: the number of slots, as many as reserved
     * */
    pub fn free(mut self, slot: u32, count: usize = 1us) {
        atomic self {
            self._slots:.free(cast!usize(slot), count);
        }
    }

    /**
     * Write a value in the slot of an object
     * @params:
     *    - slot: the slot of the object
     *    - offset: the offset of the value in the slot, in bytes
     *    - value: the value to write
     * */
    pub fn setData {U} (mut self, slot: u32, offset: usize, value: U) {
        self._buffer:.setData!{U} (cast!usize(slot) * self._stride + offset, value);
    }

    /**
     * Write a value in each of a run of slots, at the same offset in each, in one write of the buffer
     * @params:
     *    - first: the first slot of the run
     *    - offset: the offset of the values in a slot, in bytes
     *    - values: the value of each slot, from the first one
     * */
    pub fn setRun {T of [U], U} (mut self, first: u32, offset: usize, values: T) {
        self._buffer:.setStrided(cast!usize(first) * self._stride + offset, self._stride, values);
    }

    /**
     * Write the same value in each of a run of slots, at the same offset in each, in one write of the buffer
     * @params:
     *    - first: the first slot of the run
     *    - count: the number of slots of the run
     *    - offset: the offset of the value in a slot, in bytes
     *    - value: the value written in each slot
     * */
    pub fn fillRun {U} (mut self, first: u32, count: usize, offset: usize, value: U) {
        self._buffer:.fillStrided(cast!usize(first) * self._stride + offset, self._stride, count, value);
    }

    /**
     * Write a value in each of a run of slots from a function called while a frame is submitted, without requesting a
     * frame (see InFlightBuffer::setFrameStrided)
     * */
    pub fn setFrameRun {T of [U], U} (mut self, first: u32, offset: usize, values: T) {
        self._buffer:.setFrameStrided(cast!usize(first) * self._stride + offset, self._stride, values);
    }

    /**
     * Write a value in the slot of an object from a function called while a frame is submitted, without requesting a
     * frame (see InFlightBuffer::setFrameData)
     * */
    pub fn setFrameData {U} (mut self, slot: u32, offset: usize, value: U) {
        self._buffer:.setFrameData!{U} (cast!usize(slot) * self._stride + offset, value);
    }

    /**
     * @returns: a value of the slot of an object, as last written
     * @params:
     *    - slot: the slot of the object
     *    - offset: the offset of the value in the slot, in bytes
     * */
    pub fn getData {U} (self, slot: u32, offset: usize)-> U {
        self._buffer.getData!{U} (cast!usize(slot) * self._stride + offset)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._buffer:.dispose();
        }
    }
}
