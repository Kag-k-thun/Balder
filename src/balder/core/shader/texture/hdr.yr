in hdr;

mod ::utils;

use balder::core::error;

use std::math;

/**
 * An image in the Radiance HDR format (.hdr), the format of the environments: unbounded linear light, each texel stored
 * in four bytes, a mantissa for each of red, green and blue sharing an exponent (RGBE)
 * @info: the scanlines are read flat or run-length encoded channel by channel (the encoding of every recent writer), top
 * to bottom (the -Y H +X W orientation); the header has to declare the 32-bit_rle_rgbe format when it declares one
 * */
pub record HdrImage {

    // The size of the image, in texels
    pub let width: u32;
    pub let height: u32;

    // The texels, four bytes each (the mantissas of red, green and blue, then their exponent), row by row from the top
    pub let texels: [u8];

    /**
     * Decode an image from the content of a .hdr file
     * @throws: if the content is not a Radiance HDR image of RGBE texels, or is truncated
     * */
    pub self (bytes: [u8])
        with self(utils::decode(bytes))
        throws BalderError
    {}

    /**
     * An image of texels already decoded
     * @params:
     *    - width, height: the size of the image, in texels
     *    - texels: the RGBE texels, width × height × 4 bytes, row by row from the top
     * */
    pub self (width: u32, height: u32, texels: [u8])
        with width = width
        , height = height
        , texels = texels
    {}

    /**
     * An image of texels decoded by utils::decode
     * */
    self (decoded: (u32, u32, [u8]))
        with width = decoded._0
        , height = decoded._1
        , texels = decoded._2
    {}

    /**
     * Decode an image from a .hdr file
     * @params:
     *    - file: the project path to the file
     * @throws: if the file cannot be read, or is not a Radiance HDR image of RGBE texels
     * */
    pub self fromFile(file: [c8])
        with self(utils::readFile(file))
        throws BalderError
    {}

    /**
     * @returns: the light of a texel, its mantissas scaled by their exponent, 0 when the exponent is 0
     * @params:
     *    - x, y: the texel, from the top left corner
     * */
    pub fn radiance(self, x: u32, y: u32)-> [f32; 3] {
        let i = cast!usize((y * self.width + x) * 4u32);
        let e = self.texels[i + 3us];
        if e == 0u8 { return [0.0f, 0.0f, 0.0f]; }

        let scale = math::exp2(cast!f32(cast!u32(e)) - 136.0f);
        [cast!f32(cast!u32(self.texels[i])) * scale, cast!f32(cast!u32(self.texels[i + 1us])) * scale, cast!f32(cast!u32(self.texels[i + 2us])) * scale]
    }
}
