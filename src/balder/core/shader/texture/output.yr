in output;

use balder::core::_;
use balder::core::driver::device;
use balder::core::memory::{image2D, segment};
use balder::utils::log;

use ::vulkan::core;

@final
pub class IOutputTexture over Texture {

    // The format of the color buffer
    let mut _format: VkFormat;

    // The vulkan image of the texture
    let dmut _images: [&Image2D] = [];

    // The image views to bind the output textures
    let dmut _imageViews: [VkImageView] = [];

    // The format the images are sampled in, when it differs from the format they are written in
    let _sampledFormat: (VkFormat)?;

    // The image views sampling the images in that format, none when they are sampled in the format they are written in
    let dmut _sampledViews: [VkImageView] = [];

    let _depth: bool;

    // The images created without memory, until they are bound (see unbound)
    let dmut _unbound: [VkImage] = [];

    /**
     * Create a color texture of a given dimension
     * @params:
     *    - sampledFormat: the format the images are sampled in, when it differs from 'format', the format they are
     *                     written in: a compute shader writes the bytes of an sRGB image through a unorm view (a storage
     *                     image cannot be sRGB), the sampling decoding them through an sRGB view
     * @info: the images sampled in another format are created with a mutable format, their sampled views restricted to
     * sampling (a usage of the views of Vulkan 1.1)
     * */
    pub self (dmut device: &VulkanDevice,
              format: VkFormat,
              width: u32,
              height: u32,
              forSubpass: bool = true,
              forStorage: bool = false,
              depth: bool = false,
              nbImages: u32? = none,
              numSamples: VkSampleCountFlagBits = VkSampleCountFlagBits::VK_SAMPLE_COUNT_1_BIT,
              sampledFormat: VkFormat? = none)
        with super(alias device, width, height)
        , _format = format
        , _sampledFormat = sampledFormat
        , _depth = depth
        throws BalderError
    {
        self:.configure(numSamples, depth, forSubpass, forStorage, nbImages);
    }

    /**
     * Create a texture whose images are bound afterwards into memory shared with other images (see bind), the images
     * of the textures of a render graph not used at the same time sharing it
     * */
    pub self unbound(dmut device: &VulkanDevice,
                     format: VkFormat,
                     width: u32,
                     height: u32,
                     forSubpass: bool = true,
                     forStorage: bool = false,
                     depth: bool = false)
        with super(alias device, width, height)
        , _format = format
        , _sampledFormat = none
        , _depth = depth
        throws BalderError
    {
        let usage = usageOf(depth, forSubpass, forStorage);
        let nbImage = cast!u32(self._device:.getSwapchain().nbFrames);
        self._unbound = copy [self._device:.getMemoryAllocator():.createImage2D(width, height, format, VkImageTiling::VK_IMAGE_TILING_OPTIMAL, usage) for _ in 0 .. nbImage];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Configure the color image
     * */
    fn configure(mut self,
                 numSamples: VkSampleCountFlagBits,
                 depth: bool,
                 forSubpass: bool,
                 forStorage: bool,
                 nbImages: u32?)
        throws BalderError
    {
        self:.createImage(numSamples, depth, forSubpass, forStorage, nbImages);
        self:.createImageViews(depth);
    }

    /**
     * Allocate the texture image memory space
     * */
    fn createImage(mut self,
                   numSamples: VkSampleCountFlagBits,
                   depth: bool,
                   forSubpass: bool,
                   forStorage: bool,
                   nbImages: u32?)
        throws BalderError
    {
        let usage = usageOf(depth, forSubpass, forStorage);
        let nbImage = if let Ok(i) = nbImages { i } else { cast!u32(self._device:.getSwapchain().nbFrames) };
        let flags = if self._sampledFormat.hasValue { cast!u32(VkImageCreateFlagBits::VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) } else { 0u32 };

        self._images = copy [self._device:.getMemoryAllocator():.allocImage2D(self._width, self._height, self._format, VkImageTiling::VK_IMAGE_TILING_OPTIMAL, usage, numSamples-> numSamples, VkMemoryPropertyFlagBits::VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, flags-> flags) for _ in 0 .. nbImage];
    }

    /**
     * Create the image view to attach the texture to a rendering pass, and those sampling it in another format
     * */
    fn createImageViews(mut self, depth: bool)
        throws BalderError
    {
        self._imageViews = copy [null; self._images.len];
        for i, img in self._images {
            self._imageViews[i] = alias self.createView(img, img.getFormat(), depth, null);
        }

        if let Ok(sampled) = self._sampledFormat {
            // the format of the image may not be sampled in another format with the usages of the image (storage...)
            let mut usage = VkImageViewUsageCreateInfo();
            usage.sType = VkStructureType::VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO;
            usage.usage = cast!u32(VkImageUsageFlagBits::VK_IMAGE_USAGE_SAMPLED_BIT);

            self._sampledViews = copy [null; self._images.len];
            for i, img in self._images {
                self._sampledViews[i] = alias self.createView(img, sampled, depth, cast!{*void} (&usage));
            }
        }
    }

    /**
     * @returns: a view of an image of the texture
     * @params:
     *    - format: the format the view reads the image in
     *    - next: the structures extending the creation of the view
     * */
    fn createView(self, img: &Image2D, format: VkFormat, depth: bool, next: *void)-> dmut VkImageView
        throws BalderError
    {
        let mut info = VkImageViewCreateInfo();
        info.sType = VkStructureType::VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
        info.pNext = next;
        info.image = img.getVulkanImage();
        info.viewType = VkImageViewType::VK_IMAGE_VIEW_TYPE_2D;
        info.format = format;

        info.subresourceRange.aspectMask = if depth {
            VkImageAspectFlagBits::VK_IMAGE_ASPECT_DEPTH_BIT
        } else {
            VkImageAspectFlagBits::VK_IMAGE_ASPECT_COLOR_BIT
        };
        info.subresourceRange.levelCount = 1;
        info.subresourceRange.layerCount = 1;

        info.components.r = VkComponentSwizzle::VK_COMPONENT_SWIZZLE_R;
        info.components.g = VkComponentSwizzle::VK_COMPONENT_SWIZZLE_G;
        info.components.b = VkComponentSwizzle::VK_COMPONENT_SWIZZLE_B;
        info.components.a = VkComponentSwizzle::VK_COMPONENT_SWIZZLE_A;

        let dmut view: VkImageView = null;
        if vkCreateImageView(self._device.getDeviceHandle(), &info, null, alias &view) != VkResult::VK_SUCCESS {
            throw copy BalderError("Failed to create image view");
        }

        alias view
    }

    /**
     * Bind the images of a texture created unbound into memory reserved for them, one reservation per image
     * @params:
     *    - memory: the memory of each image, reserved with the requirements of the texture at least
     * */
    pub fn bind(mut self, memory: [MemoryAllocation])
        throws BalderError
    {
        if memory.len != self._unbound.len {
            throw copy BalderError("Binding the images of a texture into a wrong number of allocations");
        }

        let dmut images: [&Image2D] = [];
        for i, dmut img in alias self._unbound {
            images ~= [self._device:.getMemoryAllocator():.bindImage2D(self._width, self._height, self._format, alias img, memory[i])];
        }

        self._images = alias images;
        self._unbound = [];
        self:.createImageViews(self._depth);
    }

    /**
     * @returns: the memory requirements of an image of a texture created unbound
     * */
    pub fn getRequirements(self)-> VkMemoryRequirements {
        let dmut memReq = VkMemoryRequirements();
        if self._unbound.len != 0 {
            vkGetImageMemoryRequirements(self._device.getDeviceHandle(), self._unbound[0], alias &memReq);
        }

        memReq
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub over format(self)-> VkFormat {
        self._format
    }

    /**
     * @returns: the list of image views of the ouput texture
     * */
    pub fn getImageViews(self)-> [VkImageView] {
        self._imageViews
    }

    /**
     * @returns: the image views sampling the output texture, in the format it is sampled in (see sampledFormat)
     * */
    pub fn getSampledViews(self)-> [VkImageView] {
        if self._sampledViews.len != 0us {
            return self._sampledViews;
        }

        self._imageViews
    }

    /**
     * @returns: the images of the texture
     * */
    pub fn getImages(self)-> [&Image2D] {
        self._images
    }

    /**
     * @returns: the images of the texture
     * */
    pub fn getImages(mut self)-> dmut [&Image2D] {
        alias self._images
    }

    /**
     * @returns: true iif the output texture is a depth texture
     * */
    pub fn isDepth(self)-> bool {
        self._depth
    }

    /**
     * @panic
     * */
    pub over getImageView(self)-> VkImageView {
        log::error #("OutputTexture", "Output textures have multiple image views");

        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            for i in 0 .. self._images.len {
                if self._imageViews[i] != null {
                    vkDestroyImageView(self._device.getDeviceHandle(), self._imageViews[i], null);
                }

                if i < self._sampledViews.len && self._sampledViews[i] != null {
                    vkDestroyImageView(self._device.getDeviceHandle(), self._sampledViews[i], null);
                }

                log::debug #("OutputTexture", "Disposing texture");
                self._images[i]:.dispose();
            }

            for dmut img in alias self._unbound {
                self._device:.getMemoryAllocator():.destroyImage(alias img);
            }

            self._images = [];
            self._imageViews = [];
            self._sampledViews = [];
            self._unbound = [];
            self._width = 0;
            self._height = 0;
        }
    }
}

/**
 * @returns: the usage of the images of an output texture
 * @params:
 *    - depth: true for a depth attachment, false for a color attachment
 *    - forSubpass: true when the images are sampled
 *    - forStorage: true when compute shaders write them as storage images
 * */
fn usageOf(depth: bool, forSubpass: bool, forStorage: bool)-> u32 {
    let mut usage: u32 = if depth {
        VkImageUsageFlagBits::VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT
    } else {
        VkImageUsageFlagBits::VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT
    };

    if forSubpass {
        usage = usage | VkImageUsageFlagBits::VK_IMAGE_USAGE_SAMPLED_BIT;
    }

    if forStorage {
        usage = usage | VkImageUsageFlagBits::VK_IMAGE_USAGE_STORAGE_BIT;
    }

    usage
}
