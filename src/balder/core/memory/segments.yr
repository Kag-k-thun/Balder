in segments;

use balder::utils;

use std::stream;

pub record FreeSegment {
    pub let mut start: usize;
    pub let mut end: usize;

    pub self (start: usize, end: usize)
        with start = start
        , end = end
    {}
}

/**
 * Best-fit allocator of the intervals of a one dimensional range [0, size)
 * */
@final
pub class SegmentList {

    // The size of the range
    let mut _size: usize;

    // The free segments, sorted and never adjacent, the first _len of the buffer, kept as it grows so a reservation or a
    // free allocates nothing
    let dmut _buffer: [FreeSegment];
    let mut _len: usize = 1us;

    pub self (size: usize)
        with _size = size
        , _buffer = copy [FreeSegment(0, size); 4us]
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the size of the range
     * */
    pub fn getSize(self)-> usize {
        self._size
    }

    /**
     * @returns: true if the range is completely free
     */
    pub fn isEmpty(self)-> bool {
        if (self._len != 1) return false;
        return (self._buffer[0].start == 0 && self._buffer[0].end == self._size);
    }

    /**
     * @returns: the free segments of the range
     * */
    pub fn getFreeSegments(self)-> [FreeSegment] {
        self._buffer[0us .. self._len]
    }

    /**
     * @returns: the end of the last reservation, 0 when nothing is reserved
     * */
    pub fn getReservedEnd(self)-> usize {
        if self._len != 0 && self._buffer[self._len - 1us].end == self._size {
            return self._buffer[self._len - 1us].start;
        }

        self._size
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SEARCHING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the free segment that fits a reservation of size 'size' aligned on 'align' with the least waste
     * @returns:
     *    - .0: true if a segment was found
     *    - .1: the aligned offset of the reservation
     *    - .2: the index of the free segment to pass to reserve
     * */
    pub fn findFreeSegment(self, size: usize, align: usize)-> (bool, usize, usize) {
        let mut best = (false, 0us, i64::max, 0us);
        for i, seg in self._buffer[0us .. self._len] {
            let segAlign = if seg.start % align != 0 {
                align - (seg.start % align)
            } else { 0 };

            let alignedStart = seg.start + segAlign;
            let dist         = (cast!i64(seg.end) - cast!i64(alignedStart)) - cast!i64(size);

            if (dist >= 0 && dist < best.2) {
                best = (true, alignedStart, dist, i);
            }
        }

        (best.0, best.1, best.3)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          RESERVATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reserve a segment of the range
     * @params:
     *    - index: the index of the free segment to reserve
     *    - offset: the offset of the reservation
     *    - size: the size of the reservation
     * @assume: the segment is free
     */
    pub fn reserve(mut self, index: usize, offset: usize, size: usize) {
        let seg = self._buffer[index];

        // full reservation
        if seg.start == offset && seg.end == offset + size {
            self:.removeAt(index);
            return;
        }

        // left reservation
        if seg.start == offset {
            self._buffer[index].start += size;
            return;
        }

        // Right reservation
        if seg.end == offset + size {
            self._buffer[index].end -= size;
            return;
        }

        // Middle reservation
        self._buffer[index].end = offset;
        self:.insertAt(index + 1us, FreeSegment(offset + size, seg.end));
    }

    /**
     * Find and reserve a segment of size 'size' aligned on 'align'
     * @returns: the offset of the reservation, none if no free segment fits
     * */
    pub fn alloc(mut self, size: usize, align: usize)-> usize? {
        let (succ, offset, index) = self.findFreeSegment(size, align);
        if !succ { return none; }

        self:.reserve(index, offset, size);
        offset?
    }

    /**
     * Extend the range to 'size', the extension being free
     * @params:
     *    - size: the new size of the range, nothing is done if it is not larger than the current one
     * */
    pub fn grow(mut self, size: usize) {
        if size <= self._size { return; }

        let old = self._size;
        self._size = size;
        self:.free(old, size - old);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          FREEING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Free a segment
     * @params:
     *    - offset: the start of the segment
     *    - size: the size of the segment to free
     * @assume the segment was reserved
     */
    pub fn free(mut self, offset: usize, size: usize) {
        if self._len == 0 {
            self:.insertAt(0us, FreeSegment(offset, offset + size));
            return;
        }

        let mut index = 0us;
        // searching where to insert the free segment
        for seg in self._buffer[0us .. self._len] {
            if seg.start <= offset && seg.end >= offset + size {
                log::warn #("SegmentList", "segment already free : ", offset, size);
                return;
            }

            if offset + size <= seg.start { break; }
            index += 1;
        }

        // Free at the beginning
        if index == 0 {
            if self._buffer[0].start == offset + size { // collide first free
                self._buffer[0].start = offset;
            } else {
                self:.insertAt(0us, FreeSegment(offset, offset + size));
            }

            return;
        }

        // Free at the end
        if index == self._len {
            if self._buffer[self._len - 1us].end == offset { // collide last free
                self._buffer[self._len - 1us].end += size;
            } else {
                self:.insertAt(self._len, FreeSegment(offset, offset + size));
            }

            return;
        }

        // Middle insertion
        // 1. collide with left and right
        if self._buffer[index - 1].end == offset && self._buffer[index].start == offset + size {
            self._buffer[index - 1].end = self._buffer[index].end;
            self:.removeAt(index);

            return;
        }

        // 2. Collide with left
        if self._buffer[index - 1].end == offset {
            self._buffer[index - 1].end += size;
            return;
        }

        // 3. Collide with right
        if self._buffer[index].start == offset + size {
            self._buffer[index].start = offset;
            return;
        }

        // 4. new fragment
        self:.insertAt(index, FreeSegment(offset, offset + size));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a free segment at a place, the segments after it moved one place right, the buffer doubled when full
     * */
    fn insertAt(mut self, index: usize, seg: FreeSegment) {
        if self._len == self._buffer.len {
            let dmut larger = copy [FreeSegment(0us, 0us); 2us * self._buffer.len + 4us];
            for i in 0us .. self._len {
                larger[i] = self._buffer[i];
            }

            self._buffer = alias larger;
        }

        let mut i = self._len;
        while i > index {
            self._buffer[i] = self._buffer[i - 1us];
            i -= 1us;
        }

        self._buffer[index] = seg;
        self._len += 1us;
    }

    /**
     * Remove the free segment at a place, the segments after it moved one place left
     * */
    fn removeAt(mut self, index: usize) {
        for i in index .. self._len - 1us {
            self._buffer[i] = self._buffer[i + 1us];
        }

        self._len -= 1us;
    }

    impl Streamable;
}
