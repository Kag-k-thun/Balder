in interface;

pub mod ::loader;
pub mod ::widget;
pub mod ::font;
pub mod ::cursor;
pub mod ::style;
pub mod ::dialog;

pub mod ::drawer;
pub mod ::shape;


use balder::utils;
use balder::core::{_, application::_};
use balder::interface::_;
use balder::interface::loader::registry;
use balder::interface::loader::registry::behavior;
use balder::interface::style::conditions;
use balder::interface::widget::{focus, layout};
use balder::math::vector;
use balder::scene::utils::post::registry;

use std::math;
use std::fs::path;
use std::time::dur;

use ::sdl3::{keycode, mouse};


// The passes of a layout at most, a pass laying the widgets out again when the space available to a widget changed the
// result of a condition its style reads
def MAX_LAYOUT_PASSES = 4us;

@final
pub class WidgetManager {

    // The root widget
    let dmut _content : (&Widget)? = none;

    // The window to which the manager is attached
    let dmut _window : &Window;

    // The drawer of 2D shapes
    let dmut _drawer : &ShapeDrawer;

    // The font manager used to render text to the screen
    let dmut _fontManager : &FontManager;

    // The manager of the mouse cursor
    let dmut _cursorManager : &CursorManager;

    // The style manager
    let dmut _styleManager : &StyleManager;

    // The widget types the .gui files can use
    let dmut _registry : &WidgetRegistry = copy WidgetRegistry ();

    // The style sheets of the components already loaded, by their path
    let mut _componentStyles : [[c8]] = [];

    // The kinds of post effects the 3D scenes of the .gui files can name
    let dmut _postRegistry : &PostRegistry = copy PostRegistry ();

    // The variables of the window and of the application the conditions of the style sheets read
    let dmut _variables : &StyleVariables = copy StyleVariables ();

    // The slot emitter used to receive signals
    let dmut _box : &SlotEmitter = copy SlotEmitter ();

    // The slots the `on-…` attributes of the .gui files name
    let mut _behavior : &Behavior = copy Behavior ();

    // The emitter running the slots of the `on-…` attributes, none to run them with the signals of the manager
    let dmut _slotBox : (&SlotEmitter)? = none;

    // The size in pixels of the last resize of the window, not laid out yet
    let mut _resized : (u32, u32)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE INFOS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot { // focuses

        // True if  click of mouse button is active ([left, right, middle])
        let dmut _clicked : [bool ; 3] = [false ; 3];

        // The position of the mouse relative to window size (range [0, 1])
        let mut _mousePosition : vec2 = vec2 ();

        // The widget receiving text inputs
        let dmut _focus : (&Widget)? = none;

        // The widget the Tab key moves the focus on from when no widget has it, the last one focused or clicked
        let dmut _anchor : (&Widget)? = none;

        // The widget being clicked
        let dmut _clickedW : [(&Widget)? ; 3] = [none ; 3];

        // True if the content was hovered in the last event
        let mut _wasHover : bool = false;

    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a widget manager containing nothing
     * */
    pub self (dmut win : &Window)
        with _window = alias win
        , _fontManager = copy FontManager ()
        , _drawer = copy ShapeDrawer (alias win)
        , _cursorManager = copy CursorManager ()
        , _styleManager = copy StyleManager ()
    {
        let dmut input = self._window:.getInputManager ();
        input:.mouse (MouseInfo (SDL_BUTTON_LEFT, KeyEvent::ALL)):.connect (alias self._box, &self:.onMouseLeftClick);
        input:.mouse (MouseInfo (SDL_BUTTON_RIGHT, KeyEvent::ALL)):.connect (alias self._box, &self:.onMouseRightClick);
        input:.mouse (MouseInfo (SDL_BUTTON_MIDDLE, KeyEvent::ALL)):.connect (alias self._box, &self:.onMouseMiddleClick);

        input:.doubleClick ():.connect (alias self._box, &self:.onMouseDoubleClick);
        input:.mouseMotion ():.connect (alias self._box, &self:.onMouseMotion);
        input:.mouseWheel ():.connect (alias self._box, &self:.onMouseWheel);
        input:.mouseFocus ():.connect (alias self._box, &self:.onMouseFocus);
        input:.keyPressed ():.connect (alias self._box, &self:.onKeyPressed);
        input:.windowResized ():.connect (alias self._box, &self:.onWindowResize);
        input:.windowScaleChanged ():.connect (alias self._box, &self:.onWindowScaleChange);

        {
            self._drawer:.configure ();
        } catch {
            err => {
                log::error #("WidgetManager", "Failed to configure shape drawer", err);
            }
        }

        self:.updateWindowVariables ();
    }

    __dtor (mut self) {
        self:.dispose ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load a .gui file, its components and those of the files it imports being unfolded, its widgets checked against
     * the widget types then created, the signals of their `on-…` attributes connected to the slots of the behavior
     * (setBehavior), and the style sheets of the components (@style) loaded the first time a file names them, under
     * the sheets of the application
     * @params:
     *    - path: the path of the file, qualified (res:/) or not
     *    - set: true to make the widgets the content of the manager, disposing the current one
     * @returns: the root widget
     * @throws: when a file cannot be read, its widgets cannot be created, an `on-…` attribute names no slot or a slot
     * whose parameters do not take its arguments then the payload of the signal, or the sheet of a component cannot be
     * decoded, naming the file, the line and the column
     * */
    pub fn loadGUIFile (mut self, path : [c8], set : bool = true)-> dmut &Widget
        throws BalderError
    {
        let doc = readGuiFile (path);
        let tree = self._registry:.unfold (doc, path);
        let dmut w = self._registry.instantiate (alias self, tree, self._behavior, alias self:.slotBox ());
        {
            self:.loadComponentStyles ();
        } catch {
            e : &BalderError => {
                w:.dispose ();
                throw e;
            }
        }

        if set {
            self:.setContent (alias w);
        }

        alias w
    }

    /**
     * Load a .style file and the sheets it imports, registering the fonts of their @font-face blocks, the styles of the
     * widgets already loaded being computed again
     * @params:
     *    - path: the path of the file, qualified (res:/) or not
     * @throws: when a file cannot be read, or a sheet cannot be decoded, naming the file, the line and the column; no
     * sheet is added then
     * */
    pub fn loadStyleFile (mut self, path : [c8])
        throws BalderError
    {
        let dmut loader = SheetLoader (self._registry);
        let sheets = loader:.load (path);
        for sheet in sheets {
            sheet.registerFonts (alias self._fontManager:.getRegistry ());
            self._styleManager:.addSheet (sheet);
        }

        if let Ok (dmut root) = alias self._content {
            root:.reloadStyle (deep-> true);
        }
    }

    /**
     * Load the components of a .gui file and of the files it imports, for instantiate, a file holding only components
     * being a library of widgets, and the style sheets of the components (@style) the first time a file names them
     * @params:
     *    - path: the path of the file, qualified (res:/) or not
     * @throws: when a file cannot be read or loaded, or the sheet of a component cannot be decoded
     * */
    pub fn loadComponents (mut self, path : [c8])
        throws BalderError
    {
        let doc = readGuiFile (path);
        self._registry:.load (doc, path);
        self:.loadComponentStyles ();
    }

    /**
     * Create an instance of a component of the .gui files loaded, after the children of a widget, as if it were
     * written there: `gui:.instantiate ("FieldRow", "Phone", parent-> "BODY/MAIN/TABS/FORM", id-> "PHONE")`
     * @params:
     *    - component: the name of the component
     *    - value: the text of the default value, set to the first parameter of the component
     *    - parent: the find path of the widget receiving the instance, "" for the root
     *    - id: the id of the instance, "" for an anonymous one
     *    - attributes: the block of the instance, in the syntax of the .gui files: "max-length: 20; tab: \"Phone\";"
     * @returns: the root widget of the instance
     * @throws: when there is no widget at parent, when it takes no more children, when another widget is reachable by
     * the path of the instance, and when the instance is refused
     * */
    pub fn instantiate (mut self, component : [c8], value : [c8], parent : [c8] = "", id : [c8] = "", attributes : [c8] = "")-> dmut &Widget
        throws BalderError
    {
        self:.insertInstance (component, " " ~ WidgetManager::quoted (value), parent, id, attributes)
    }

    /**
     * Create an instance of a component of the .gui files loaded, without default value, after the children of a
     * widget, as if it were written there
     * @params:
     *    - component: the name of the component
     *    - parent: the find path of the widget receiving the instance, "" for the root
     *    - id: the id of the instance, "" for an anonymous one
     *    - attributes: the block of the instance, in the syntax of the .gui files
     * @returns: the root widget of the instance
     * @throws: when there is no widget at parent, when it takes no more children, when another widget is reachable by
     * the path of the instance, and when the instance is refused
     * */
    pub fn instantiate (mut self, component : [c8], parent : [c8] = "", id : [c8] = "", attributes : [c8] = "")-> dmut &Widget
        throws BalderError
    {
        self:.insertInstance (component, "", parent, id, attributes)
    }

    /**
     * Create an instance of a component after the children of a widget
     * @params:
     *    - value: the default value of the instance in the syntax of the .gui files, after a space, "" for none
     * */
    fn insertInstance (mut self, component : [c8], value : [c8], parent : [c8], id : [c8], attributes : [c8])-> dmut &Widget
        throws BalderError
    {
        let dmut container = if parent == "" {
            if let Ok (dmut c) = alias self._content { alias c } else { throw copy BalderError ("no content to instantiate '" ~ component ~ "' in"); }
        } else {
            if let Ok (dmut c) = alias self:.find (parent) { alias c } else { throw copy BalderError ("no widget at '" ~ parent ~ "'"); }
        };

        if id != "" {
            let path = if parent == "" { id } else { parent ~ "/" ~ id };
            if self:.find (path).hasValue {
                throw copy BalderError ("a widget is already reachable by the path '" ~ path ~ "'");
            }
        }

        let selector = if id != "" { " #" ~ id } else { "" };
        let source = component ~ selector ~ value ~ " { " ~ attributes ~ " }";
        let tree = self._registry:.unfoldInstance (source, "instance of '" ~ component ~ "'");

        let mut index = 0us;
        if let dmut l : &Layout = alias container {
            index = l:.getChildren ().len;
        }

        let dmut w = self._registry.insert (alias self, alias container, tree, index, self._behavior, alias self:.slotBox ());
        if container.isAttached () && !w.isAttached () {
            w:.onAttach ((container)?);
        }

        self:.updateWidgets ();
        alias w
    }

    /**
     * @returns: the emitter running the slots of the `on-…` attributes
     * */
    fn slotBox (mut self)-> dmut &SlotEmitter {
        if let Ok (dmut b) = alias self._slotBox {
            return alias b;
        }

        alias self._box
    }

    /**
     * Load the style sheets of the components the .gui files name with @style that are not loaded yet, at the origin of
     * the components, under the sheets of the application whatever their specificity
     * @throws: when a sheet cannot be read or decoded; the sheets loaded before it stay
     * */
    fn loadComponentStyles (mut self)
        throws BalderError
    {
        let mut added = false;
        for path in self._registry.getLibrary ().getStyles () {
            let mut loaded = false;
            for l in self._componentStyles {
                if l == path { loaded = true; break; }
            }

            if !loaded {
                let dmut loader = SheetLoader (self._registry);
                let sheets = loader:.load (path);
                for sheet in sheets {
                    sheet.registerFonts (alias self._fontManager:.getRegistry ());
                    self._styleManager:.addSheet (sheet, origin-> SheetOrigin::COMPONENT);
                }

                self._componentStyles ~= [path];
                added = true;
            }
        }

        if added {
            if let Ok (dmut root) = alias self._content {
                root:.reloadStyle (deep-> true);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Change the root widget of the interface
     * @warning: dispose the old one if any
     * */
    pub fn setContent (mut self, dmut root : &Widget) {
        if let Ok (dmut w) = alias self._content {
            w:.dispose ();
        }

        root:.onAttach (none);
        self._content = (alias root)?;
        self:.updateWidgets ();
    }

    /**
     * Publish a variable of the application, read by the conditions of the style sheets as app.name, the widgets whose
     * rules read it being styled again
     * @params:
     *    - name: the name of the variable, without the app. prefix
     *    - value: a string, compared to the keywords and the strings
     * */
    pub fn setVariable (mut self, name : [c8], value : [c8]) {
        self:.publish (name, VariableValue (value));
    }

    /**
     * Publish a variable of the application, read by the conditions of the style sheets as app.name
     * @params:
     *    - name: the name of the variable, without the app. prefix
     *    - value: a number, compared to the numbers and the lengths in px
     * */
    pub fn setVariable (mut self, name : [c8], value : f64) {
        self:.publish (name, VariableValue (value));
    }

    /**
     * Publish a variable of the application, read by the conditions of the style sheets as app.name
     * @params:
     *    - name: the name of the variable, without the app. prefix
     *    - value: a boolean, tested alone (app.compact) or compared to true and false
     * */
    pub fn setVariable (mut self, name : [c8], value : bool) {
        self:.publish (name, VariableValue (value));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the window on which widgets are drawn
     * */
    pub fn getWindow (mut self)-> dmut &Window {
        alias self._window
    }

    /**
     * @returns: the manager of the font to render text
     * */
    pub fn getFontManager (mut self)-> dmut &FontManager {
        alias self._fontManager
    }

    /**
     * @returns: the shape drawer
     * */
    pub fn getShapeDrawer (mut self)-> dmut &ShapeDrawer {
        alias self._drawer
    }

    /**
     * @returns: the manager of the cursor to change its icons
     * */
    pub fn getCursorManager (mut self)-> dmut &CursorManager {
        alias self._cursorManager
    }

    /**
     * @returns: the manager of input events to connect/disconnect to user inputs
     * */
    pub fn getInputManager (mut self)-> dmut &WindowInputSignals {
        alias self._window:.getInputManager ()
    }

    /**
     * Set the slots the `on-…` attributes of the .gui files loaded from now on name, and the emitter running them
     * @params:
     *    - behavior: the slots, registered under their names, and the behaviors grouping others
     *    - box: the emitter running the slots, in the thread of the activity
     * */
    pub fn setBehavior (mut self, behavior : &Behavior, dmut box : &SlotEmitter) {
        self._behavior = behavior;
        self._slotBox = (alias box)?;
    }

    /**
     * @returns: the registry of the widget types, to register the types of the application
     * */
    pub fn getRegistry (mut self)-> dmut &WidgetRegistry {
        alias self._registry
    }

    /**
     * @returns: the registry of the kinds of post effects the 3D scenes of the .gui files name, to register the effects of
     * the application before loading them
     * */
    pub fn getPostRegistry (mut self)-> dmut &PostRegistry {
        alias self._postRegistry
    }

    /**
     * @returns: the registry of the kinds of post effects the 3D scenes of the .gui files name
     * */
    pub fn getPostRegistry (self)-> &PostRegistry {
        self._postRegistry
    }

    /**
     * @returns: the style manager to apply style to widgets
     * */
    pub fn getStyleManager (mut self)-> dmut &StyleManager {
        alias self._styleManager
    }

    /**
     * @returns: the variables of the window and of the application the conditions of the style sheets read
     * */
    pub fn getStyleVariables (self)-> &StyleVariables {
        self._variables
    }

    /**
     * @returns: the size of the window in layout pixels, the unit of the lengths of the style
     * */
    pub fn getLayoutSize (self)-> vec2 {
        let dim = self._drawer.getDimension ();
        makeVec2 (cast!f32 (dim.x), cast!f32 (dim.y))
    }

    /**
     * Find a widget with a path name
     * */
    pub fn find (mut self, name : [c8])-> dmut (&Widget)? {
        if let Ok (dmut c) = alias self._content {
            return c:.lookup (Path (name).parts ());
        }

        none
    }

    /**
     * @returns: the root widget
     * */
    pub fn getContent (mut self)-> dmut (&Widget)? {
        alias self._content
    }

    /**
     * @returns: the position of the mouse in the window, in CSS pixels
     * */
    pub fn getMousePosition (self)-> vec2 {
        let mut x = 0.0f, mut y = 0.0f;
        SDL_GetMouseState (alias &x, alias &y);

        let density = self._window.getPixelDensity ();
        self._drawer.toLayout (cast!i32 (floor (x * density)), cast!i32 (floor (y * density)))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          TICK          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Slot emitted at each UI frame update from the activity
     * */
    pub fn onTick (mut self, delta : Duration) {
        self._box:.emit ();

        // A frame waiting for the widgets to be laid out at its size, the one of the window it was checked against
        if let Ok (size) = self._window.getLayoutRequest () {
            self._resized = size?;
        }

        let laidOut = self:.layoutResized ();

        if let Ok (dmut w) = alias self._content {
            w:.onTick (delta);
        }

        // The modifications of the tick are drawn together, from the next frame
        self._drawer:.commit ();
        if let Ok ((w, h)) = laidOut {
            self._window:.laidOut (w, h);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Lay the widgets out at the size of the window, again while the space available to a widget whose conditions read
     * it changes its style in a way that affects the layout
     * @info: a condition measures an ancestor whose size its result cannot change, so the passes end; they are bounded
     * all the same
     * */
    pub fn updateWidgets (mut self) {
        if let Ok (dmut root) = alias self._content {
            let size = self.getLayoutSize ();
            let readsAvailable = self._styleManager.isRead (AvailableVariable::WIDTH)
                || self._styleManager.isRead (AvailableVariable::HEIGHT);

            for _ in 0us .. MAX_LAYOUT_PASSES {
                root:.setSize (makeVec2 (0.0f, 0.0f), size, 0);
                root:.setScissors (makeVec2 (0.0f, 0.0f), size);
                if !readsAvailable || !root:.restyleConditions ([]) {
                    break;
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            let dmut input = self._window:.getInputManager ();
            input:.mouse (MouseInfo (SDL_BUTTON_LEFT, KeyEvent::ALL)):.disconnect (&self:.onMouseLeftClick);
            input:.mouse (MouseInfo (SDL_BUTTON_RIGHT, KeyEvent::ALL)):.disconnect (&self:.onMouseRightClick);
            input:.mouse (MouseInfo (SDL_BUTTON_MIDDLE, KeyEvent::ALL)):.disconnect (&self:.onMouseMiddleClick);

            input:.doubleClick ():.disconnect (&self:.onMouseDoubleClick);
            input:.mouseMotion ():.disconnect (&self:.onMouseMotion);
            input:.mouseWheel ():.disconnect (&self:.onMouseWheel);
            input:.mouseFocus ():.disconnect (&self:.onMouseFocus);
            input:.keyPressed ():.disconnect (&self:.onKeyPressed);
            input:.windowResized ():.disconnect (&self:.onWindowResize);
            input:.windowScaleChanged ():.disconnect (&self:.onWindowScaleChange);

            if let Ok (dmut w) = alias self._content {
                w:.dispose ();
                self._content = none;
            }

            self._fontManager:.dispose ();
            self._drawer:.dispose ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          WINDOW SLOT          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Record the size of the window, laid out once the signals of the tick are emitted
     * @info: a window being resized emits many sizes in a tick, only the last one is laid out
     * */
    fn onWindowResize (mut self, w : u32, h : u32) {
        self._resized = (w, h)?;
    }

    /**
     * Lay the widgets out at the last size of the window, if it was resized since the last tick
     * @returns: the size in pixels the widgets were laid out at, none if they were not
     * */
    fn layoutResized (mut self)-> (u32, u32)? {
        if let Ok ((w, h)) = self._resized {
            self._resized = none;
            self._drawer:.onWindowResize (w, h);

            let changed = self:.updateWindowVariables ();
            if let Ok (dmut root) = alias self._content && changed.len != 0us {
                root:.restyleConditions (changed);
            }

            self:.updateWidgets ();
            self._drawer:.redraw ();
            return (w, h)?;
        }

        none
    }

    /**
     * Set the variables of the window from its size in layout pixels and its scale
     * @returns: the names of the variables whose value changed
     * */
    fn updateWindowVariables (mut self)-> [[c8]] {
        let size = self.getLayoutSize ();
        let mut changed : [[c8]] = [];
        changed = self:.setWindowVariable (WindowVariable::WIDTH, size.x, changed);
        changed = self:.setWindowVariable (WindowVariable::HEIGHT, size.y, changed);
        changed = self:.setWindowVariable (WindowVariable::SCALE, self._window.getScale (), changed);
        changed = self:.setWindowVariable (WindowVariable::DENSITY, self._window.getPixelDensity (), changed);
        changed = self:.setWindowVariable (WindowVariable::DPI, self._window.getDpi (), changed);

        changed
    }

    /**
     * Set a variable of the window
     * @params:
     *    - changed: the names of the variables whose value changed so far
     * @returns: changed, with the name of the variable if its value changed
     * */
    fn setWindowVariable (mut self, name : [c8], value : f32, changed : [[c8]])-> [[c8]] {
        if self._variables:.set (name, VariableValue (cast!f64 (value))) {
            return changed ~ [name];
        }

        changed
    }

    /**
     * Set a variable of the application, the widgets whose conditions read it being styled again, and laid out again
     * if their layout changed
     * */
    fn publish (mut self, name : [c8], value : VariableValue) {
        let full = APP_PREFIX ~ name;
        if !self._variables:.set (full, value) || !self._styleManager.isRead (full) {
            return;
        }

        if let Ok (dmut root) = alias self._content {
            if root:.restyleConditions (copy [full]) {
                self:.updateWidgets ();
            }
        }
    }

    /**
     * Lay the widgets out again at the new scale of the window, their CSS pixels covering another number of pixels
     * */
    fn onWindowScaleChange (mut self) {
        let (w, h) = self._window.getDimension ();
        self:.onWindowResize (w, h);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE SLOTS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Slot activated when the mouse move on the screen
     */
    fn onMouseMotion (mut self, x : i32, y : i32) {
        let pos = self._drawer.toLayout (x, y);
        if self._clicked [0] || self._clicked [1] || self._clicked [2] {
            self:.onMouseSliding (x, y);
            return;
        }

        let dim = self._window.getDimension ();
        self._mousePosition = makeVec2 (cast!f32 (x) / cast!f32 (dim._0), cast!f32 (y) / cast!f32 (dim._1));

        if let Ok (dmut w) = alias self._content {
            let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
            let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

            if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                w:.onHover (relPos);
                self._wasHover = true;
            } else if self._wasHover {
                w:.onLoseHoverFocus ();
                self._wasHover = false;
            }
        }
    }

    /**
     * Slot activated when the mouse enters or leaves the window
     * */
    fn onMouseFocus (mut self, gain : bool) {
        if !gain {
            if let Ok (dmut r) = alias self._content && self._wasHover {
                r:.onLoseHoverFocus ();
                self._wasHover = false;
            }
        }
    }

    /**
     * Sliding event when the mouse is clicked and moved at the same time
     * */
    fn onMouseSliding (mut self, x : i32, y : i32) {
        let pos = self._drawer.toLayout (x, y);
        let dim = self._window.getDimension ();
        let cursorPos = makeVec2 (cast!f32 (x) / cast!f32 (dim._0), cast!f32 (y) / cast!f32 (dim._1));
        let speed = cursorPos - self._mousePosition;
        self._mousePosition = cursorPos;

        if let Ok (dmut w) = alias self._focus {
            let wsize = w.getAbsoluteSize (), wpos = w.getAbsolutePosition ();
            let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

            if self._clicked [0] {
                w:.onSliding (relPos, speed, SDL_BUTTON_LEFT);
            }

            else if self._clicked [1] {
                w:.onSliding (relPos, speed, SDL_BUTTON_RIGHT);
            }

            else {
                w:.onSliding (relPos, speed, SDL_BUTTON_MIDDLE);
            }
        }
    }

    /**
     * Slot activated when the mouse wheel is moved
     */
    fn onMouseWheel (mut self, x : i32, y : i32, amountX : i32, amountY : i32) {
        let pos = self._drawer.toLayout (x, y);
        let dim = self._window.getDimension ();
        self._mousePosition = makeVec2 (cast!f32 (x) / cast!f32 (dim._0), cast!f32 (y) / cast!f32 (dim._1));

        if self._clicked [0] || self._clicked [1] || self._clicked [2] { // sliding, so no wheel
            return;
        }

        // Event is not propagated if there is a sliding widget
        if let Ok (dmut w) = alias self._focus && w.captureWheelOnFocus () {
            let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
            let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

            if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                w:.onScroll (relPos, amountX, amountY);
            }
        }

        if let Ok (dmut w) = alias self._content {
            let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
            let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

            if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                w:.onScroll (relPos, amountX, amountY);
            }
        }
    }

    /**
     * Slot activated when the left button of the mouse is clicked
     */
    fn onMouseLeftClick (mut self, x : i32, y : i32, info : MouseInfo) {
        let pos = self._drawer.toLayout (x, y);
        if self._clicked [1] || self._clicked [2] {
            return;
        }

        let dim = self._window.getDimension ();
        self._mousePosition = makeVec2 (cast!f32 (x) / cast!f32 (dim._0), cast!f32 (y) / cast!f32 (dim._1));

        if let Ok (dmut w) = alias self._content {
            if info.type == KeyEvent::DOWN {
                let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
                let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

                if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                    if let Ok (dmut f) = alias w:.onClick (relPos, SDL_BUTTON_LEFT) {
                        self._clickedW [0] = (alias f)?;
                        self._anchor = (alias f)?;
                        if f.isFocusableLeftClick () {
                            self:.setFocus ((alias f)?);
                        } else {
                            self:.setFocus (none);
                        }
                    } else {
                        self._clickedW [0] = none;
                        self:.setFocus (none);
                    }
                }
            }

            if info.type == KeyEvent::RELEASE {
                if let Ok (dmut f) = alias self._focus {
                    f:.onSlidingEnd (SDL_BUTTON_LEFT);

                    if f.loseFocusOnReleaseLeft () {
                        self:.setFocus (none);
                    }
                }

                if let Ok (dmut c) = alias self._clickedW [0] {
                    c:.onClickEnd (SDL_BUTTON_LEFT);
                    c:.emitClicked (SDL_BUTTON_LEFT);
                    self._clickedW [0] = none;
                }
            }
        }

        self._clicked [0] = (info.type == KeyEvent::DOWN);
    }

    /**
     * Method called by the onMouseLeftClick if two clicks happend in less than __DOUBLE_CLICK_SENSIBILITY__
     */
    fn onMouseDoubleClick (mut self, x : i32, y : i32) {
        let pos = self._drawer.toLayout (x, y);
        if let Ok (dmut w) = alias self._content {
            let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
            let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

            if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                w:.onDoubleClick (relPos);
            }
        }

        self._clicked [0] = true;
    }

    /**
     * Slot activated when the right button of the mouse is clicked
     */
    fn onMouseRightClick (mut self, x : i32, y : i32, info : MouseInfo) {
        let pos = self._drawer.toLayout (x, y);
        if self._clicked [0] || self._clicked [2] {
            return;
        }

        let dim = self._window.getDimension ();
        self._mousePosition = makeVec2 (cast!f32 (x) / cast!f32 (dim._0), cast!f32 (y) / cast!f32 (dim._1));

        if let Ok (dmut w) = alias self._content {
            if info.type == KeyEvent::DOWN {
                let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
                let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

                if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                    if let Ok (dmut f) = alias w:.onClick (relPos, SDL_BUTTON_RIGHT) {
                        self._clickedW [1] = (alias f)?;
                        self._anchor = (alias f)?;
                        if f.isFocusableRightClick () {
                            self:.setFocus ((alias f)?);
                        } else {
                            self:.setFocus (none);
                        }
                    } else {
                        self._clickedW [1] = none;
                        self:.setFocus (none);
                    }
                }
            }

            else if info.type == KeyEvent::RELEASE {
                if let Ok (dmut f) = alias self._focus {
                    f:.onSlidingEnd (SDL_BUTTON_RIGHT);

                    if f.loseFocusOnReleaseRight () {
                        self:.setFocus (none);
                    }
                }

                if let Ok (dmut c) = alias self._clickedW [1] {
                    c:.onClickEnd (SDL_BUTTON_RIGHT);
                    c:.emitClicked (SDL_BUTTON_RIGHT);
                    self._clickedW [1] = none;
                }
            }
        }

        self._clicked [1] = (info.type == KeyEvent::DOWN);
    }

    /**
     * Slot activated when the middle button of the mouse is clicked
     */
    fn onMouseMiddleClick (mut self, x : i32, y : i32, info : MouseInfo) {
        let pos = self._drawer.toLayout (x, y);
        if self._clicked [0] || self._clicked [1] {
            return;
        }

        let dim = self._window.getDimension ();
        self._mousePosition = makeVec2 (cast!f32 (x) / cast!f32 (dim._0), cast!f32 (y) / cast!f32 (dim._1));

        if let Ok (dmut w) = alias self._content {
            if info.type == KeyEvent::DOWN {
                let wpos = w.getAbsolutePosition (), wsize = w.getAbsoluteSize ();
                let relPos = makeVec2 ((pos.x - wpos.x) / wsize.x, (pos.y - wpos.y) / wsize.y);

                if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                    if let Ok (dmut f) = alias w:.onClick (relPos, SDL_BUTTON_MIDDLE) {
                        self._clickedW [2] = (alias f)?;
                        self._anchor = (alias f)?;

                        if f.isFocusableMiddleClick () {
                            self:.setFocus ((alias f)?);
                        } else {
                            self:.setFocus (none);
                        }
                    }
                } else {
                    self._clickedW [2] = none;
                    self:.setFocus (none);
                }
            }

            else if info.type == KeyEvent::RELEASE {
                if let Ok (dmut f) = alias self._focus {
                    f:.onSlidingEnd (SDL_BUTTON_MIDDLE);

                    if f.loseFocusOnReleaseMiddle () {
                        self:.setFocus (none);
                    }
                }

                if let Ok (dmut c) = alias self._clickedW [2] {
                    c:.onClickEnd (SDL_BUTTON_MIDDLE);
                    c:.emitClicked (SDL_BUTTON_MIDDLE);
                    self._clickedW [2] = none;
                }
            }
        }

        self._clicked [2] = (info.type == KeyEvent::DOWN);
    }

    /**
     * Change the widget having the focus
     * @info: a widget disposed while it had the focus is not told it loses it, its disposal having done what it does then
     * */
    pub fn setFocus (mut self, dmut w : (&Widget)?) {
        match (w, self._focus) {
            (Ok (new), Ok (old)) if new is old => { // do nothing if setting the same focus
                return;
            }
        }

        if let Ok (dmut old) = alias self._focus && old.isAttached () {
            old:.setFocus (false);
            old:.emitUnfocused ();
            old:.onLoseFocus ();
        }

        if let Ok (dmut new) = alias w {
            new:.setFocus (true);
            new:.emitFocused ();
            new:.onGainFocus ();
            self._anchor = (alias new)?;
        }

        self._focus = alias w;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          KEYBOARD SLOTS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Slot activated when a key is pressed or repeated: the widget having the focus uses it first, then Tab and Shift-Tab
     * move the focus, as Up and Down do in an open menu, and Escape closes the menu opened last
     * */
    fn onKeyPressed (mut self, key : SDL_Keycode, mods : SDL_Keymod) {
        if let Ok (dmut f) = alias self._focus && f.isAttached () {
            if f:.onKeyPressed (key, mods) { return; }
        }

        if key == SDLK_TAB && (mods & (SDL_KMOD_CTRL | SDL_KMOD_ALT | SDL_KMOD_GUI)) == 0u16 {
            self:.moveFocus (backward-> (mods & SDL_KMOD_SHIFT) != 0u16);
        } else if key == SDLK_ESCAPE {
            self:.dismissFocusTrap ();
        } else if (key == SDLK_UP || key == SDLK_DOWN) && self:.isFocusTrapped () {
            self:.moveFocus (backward-> key == SDLK_UP);
        }
    }

    /**
     * @returns: true iif a layout keeps the focus in one of its children, a menu being open
     * */
    fn isFocusTrapped (mut self)-> bool {
        if let Ok (dmut root) = alias self._content {
            return WidgetManager::findTrappingLayout (alias root).hasValue;
        }

        false
    }

    /**
     * Release the focus a layout keeps in one of its children, closing the menu opened last, the focus going back to the
     * widget that opened it
     * */
    fn dismissFocusTrap (mut self) {
        if let Ok (dmut root) = alias self._content {
            if let Ok (dmut l) = alias WidgetManager::findTrappingLayout (alias root) {
                let dmut back = alias l:.dismissFocusTrap ();
                if let Ok (dmut w) = alias back && w.isAttached () {
                    if w.isFocusableByKeyboard () {
                        self:.setFocus ((alias w)?);
                    }
                }
            }
        }
    }

    /**
     * Move the focus to the next widget in the order of the Tab key, after the widget having the focus, or the last one
     * focused or clicked, among the widgets of the menu opened last when one is open
     * @params:
     *    - backward: true to move it to the previous widget
     * */
    pub fn moveFocus (mut self, backward : bool) {
        let dmut scope = if let Ok (dmut s) = alias self:.getFocusScope () { alias s } else { return; };

        let anchor = self.getFocusAnchor ();
        let dmut widgets = self:.getFocusCandidates (alias scope, anchor);

        let mut indices : [i32] = [];
        let mut current : (usize)? = none;
        for i, w in widgets {
            if let Ok (a) = anchor && a is w { current = (i)?; }
            let stop = w.isTabStop () && !WidgetManager::isBehindCheckedOfGroup (w, widgets);
            indices ~= [if stop { w.getTabIndex () } else { -1 }];
        }

        if let Ok (next) = nextTabStop (indices, current, backward-> backward) {
            self:.setFocus ((alias widgets [next])?);
        }
    }

    /**
     * @returns: the widget the Tab key moves the focus on from: the one having the focus, or the last one focused or
     * clicked, none when it is no longer attached
     * */
    fn getFocusAnchor (self)-> (&Widget)? {
        if let Ok (f) = self._focus && f.isAttached () { return (f)?; }
        if let Ok (a) = self._anchor && a.isAttached () { return (a)?; }

        none
    }

    /**
     * @returns: the widget the Tab key moves the focus within: the menu opened last, the root widget when no menu is open
     * */
    fn getFocusScope (mut self)-> dmut (&Widget)? {
        if let Ok (dmut root) = alias self._content {
            if let Ok (dmut l) = alias WidgetManager::findTrappingLayout (alias root) {
                if let Ok (dmut trap) = alias l:.getFocusTrap () {
                    return (alias trap)?;
                }
            }

            return (alias root)?;
        }

        none
    }

    /**
     * @returns: the widgets drawn among a widget and its descendants that the Tab key focuses, and the anchor it moves
     * the focus on from, in the order of the tree
     * @params:
     *    - w: the widget
     *    - anchor: the widget the Tab key moves the focus on from
     * */
    fn getFocusCandidates (mut self, dmut w : &Widget, anchor : (&Widget)?)-> dmut [&Widget] {
        let dmut res : [&Widget] = [];
        if !w.isDrawn () { return alias res; }

        let isAnchor = if let Ok (a) = anchor { a is w } else { false };
        if isAnchor || w.isTabStop () {
            res ~= [alias w];
        }

        if let dmut l : &Layout = alias w {
            for dmut c in alias l:.getChildren () {
                res ~= self:.getFocusCandidates (alias c, anchor);
            }
        }

        alias res
    }

}

/**
 * The helpers of the manager
 * */
pub mod WidgetManager {

    /**
     * @returns: true iif a widget is in a keyboard group (a group of radio buttons) another widget of which is checked,
     * the Tab key focusing only the checked one
     * @params:
     *    - w: the widget
     *    - widgets: the widgets the Tab key moves the focus over
     * */
    pub fn isBehindCheckedOfGroup (w : &Widget, widgets : [&Widget])-> bool {
        let group = w.getKeyboardGroup ();
        if group == "" || w.hasState ("checked") { return false; }

        for o in widgets {
            if o !is w && o.getKeyboardGroup () == group && o.hasState ("checked") { return true; }
        }

        false
    }

    /**
     * @returns: the layout drawn among a widget and its descendants that keeps the focus in one of its children (a menu
     * layout with a menu open), the innermost one when that child holds another, none when no layout does
     * */
    pub fn findTrappingLayout (dmut w : &Widget)-> dmut (&Layout)? {
        if !w.isDrawn () { return none; }

        if let dmut l : &Layout = alias w {
            if let Ok (dmut trap) = alias l:.getFocusTrap () {
                if let Ok (dmut inner) = alias WidgetManager::findTrappingLayout (alias trap) {
                    return (alias inner)?;
                }

                return (alias l)?;
            }

            for dmut c in alias l:.getChildren () {
                if let Ok (dmut t) = alias WidgetManager::findTrappingLayout (alias c) {
                    return (alias t)?;
                }
            }
        }

        none
    }

    /**
     * @returns: a text as a string of the .gui files, between double quotes, its quotes, backslashes, line breaks and
     * tabulations escaped
     * */
    pub fn quoted (text : [c8])-> [c8] {
        let mut result = "\"";
        for c in text {
            result = result ~ match c {
                '"'  => { "\\\"" }
                '\\' => { "\\\\" }
                '\n' => { "\\n" }
                '\t' => { "\\t" }
                _    => { copy [c] }
            };
        }

        result ~ "\""
    }
}
