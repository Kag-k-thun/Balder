/**
 * The grammar of the .gui and the .style files: their tokens, the values written on the right of `name: …;` that they
 * share (doc/gui-v2.md, §5), and the reader of each file
 * */
in parser;

mod ::token;
mod ::scanner;
mod ::value;
mod ::reader;
mod ::constants;
mod ::size;
mod ::color;
mod ::slot;
mod ::sides;
mod ::document;
mod ::gui;

pub def Token : token::Token;
pub def TokenKind : token::TokenKind;
pub def Scanner : scanner::Scanner;

pub def Value : value::Value;
pub def Number : value::Number;
pub def Name : value::Name;
pub def Hash : value::Hash;
pub def Text : value::Text;
pub def Constant : value::Constant;
pub def Call : value::Call;
pub def Shade : value::Shade;
pub def Alpha : value::Alpha;
pub def Tuple : value::Tuple;
pub def List : value::List;

pub def Declaration : reader::Declaration;
pub def ValueReader : reader::ValueReader;

pub def Constants : constants::Constants;

pub def Unit : size::Unit;
pub def Sizing : size::Sizing;
pub def Length : size::Length;
pub def Size : size::Size;
pub def Color : color::Color;
pub def SlotRef : slot::SlotRef;
pub def Sides : sides::Sides;

pub def Include : document::Include;
pub def Param : document::Param;
pub def Component : document::Component;
pub def Document : document::Document;
pub def Member : document::Member;
pub def Node : document::Node;
pub def SlotMark : document::SlotMark;
pub def GuiReader : gui::GuiReader;
