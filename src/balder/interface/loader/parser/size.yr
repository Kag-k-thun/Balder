in size;

use std::syntax::errors;

/**
 * The unit of a length
 * */
pub enum Unit
| PX      = 0u8  // logical pixels, a bare number being in px
| PERCENT = 1u8  // a part of the parent's content box on the same axis
| FR      = 2u8; // a share of the free space of a grid, for a track only

/**
 * The way a size is resolved
 * */
pub enum Sizing
| LENGTH      = 0u8  // the length of the size
| AUTO        = 1u8  // resolved by the parent: the size of the content along its axis, stretched across it
| MIN_CONTENT = 2u8  // the smallest size the content fits in, its lines wrapped at every opportunity
| MAX_CONTENT = 3u8; // the size of the content, its lines never wrapped

/**
 * The keywords of a size
 * */
enum Keywords
| AUTO        = ("auto", Sizing::AUTO)
| MIN_CONTENT = ("min-content", Sizing::MIN_CONTENT)
| MAX_CONTENT = ("max-content", Sizing::MAX_CONTENT);

/**
 * A length, a number optionally in px or in %: 12, 12px, 40%
 * */
pub record Length {

    // The number of units
    pub let amount: f32;

    // The unit of the amount
    pub let unit: Unit;

    pub self (amount: f32, unit: Unit = Unit::PX)
        with amount = amount
        , unit = unit
    {}

    /**
     * Decode a length
     * @params:
     *    - fr: true to accept a share of the free space in fr (1fr)
     * @throws: when the value is not a number in px or % (or fr)
     * */
    pub self (v: &Value, fr: bool = false)
        with amount = Length::amountOf(v, fr)
        , unit = Length::unitOf(v)
        throws SyntaxError
    {}

    /**
     * @returns: the length in pixels, a percentage being a part of the parent, and nothing when the parent is
     * indefinite (negative)
     * @params:
     *    - parent: the size of the parent's content box on the same axis, in pixels
     * */
    pub fn resolve(self, parent: f32)-> f32 {
        if self.unit != Unit::PERCENT { return self.amount; }
        if parent < 0.0f { return 0.0f; }

        self.amount * parent / 100.0f
    }

    pub fn opEquals(self, other: Length)-> bool {
        self.amount == other.amount && self.unit == other.unit
    }
}

/**
 * A size: a length, or a keyword resolved from the content (auto, min-content, max-content)
 * */
pub record Size {

    // The way the size is resolved
    pub let sizing: Sizing;

    // The length of the size, for the LENGTH sizing
    pub let length: Length;

    pub self (sizing: Sizing, length: Length = Length(0.0f))
        with sizing = sizing
        , length = length
    {}

    /**
     * Decode a size, or a track of a grid
     * @params:
     *    - track: true to decode a track, a size or a share of the free space in fr (1fr 2fr 120)
     * @throws: when the value is neither a length nor a keyword of a size
     * */
    pub self (v: &Value, track: bool = false)
        with sizing = Size::sizingOf(v, if track { "a track" } else { "a size" })
        , length = Size::lengthOf(v, track)
        throws SyntaxError
    {}

    /**
     * @returns: the length of the size in pixels, a percentage being a part of the parent, none for a keyword, which
     * the widget resolves from its content or its parent, and for a percentage of an indefinite parent (negative)
     * @params:
     *    - parent: the size of the parent's content box on the same axis, in pixels
     * */
    pub fn resolve(self, parent: f32)-> (f32)? {
        if self.sizing != Sizing::LENGTH { return none; }
        if self.length.unit == Unit::PERCENT && parent < 0.0f { return none; }

        (self.length.resolve(parent))?
    }

    /**
     * @returns: true iif the size is auto, resolved by the parent
     * */
    pub fn isAuto(self)-> bool {
        self.sizing == Sizing::AUTO
    }

    /**
     * @returns: true iif the size is a length, in px or in %
     * */
    pub fn isLength(self)-> bool {
        self.sizing == Sizing::LENGTH
    }

    pub fn opEquals(self, other: Size)-> bool {
        self.sizing == other.sizing && self.length == other.length
    }
}

/**
 * The decoding of the lengths
 * */
mod Length {

    /**
     * @params:
     *    - fr: true if a share in fr is accepted
     * @returns: the amount of a length
     * */
    pub fn amountOf(v: &Value, fr: bool)-> f32
        throws SyntaxError
    {
        if let Number(amount-> a, unit-> u) = v {
            if u != "fr" || fr {
                return cast!f32(a);
            }
        }

        throw v.expected(if fr { "a length or a share in fr" } else { "a length" });
    }

    /**
     * @returns: the unit of a length, whose amount was decoded
     * */
    pub fn unitOf(v: &Value)-> Unit {
        if let Number(unit-> u) = v {
            match u {
                "%"  => { return Unit::PERCENT; }
                "fr" => { return Unit::FR; }
                _    => {}
            }
        }

        Unit::PX
    }
}

/**
 * The decoding of the sizes
 * */
mod Size {

    /**
     * @params:
     *    - what: the kind decoded, for the error
     * @returns: the sizing of a keyword, LENGTH for a number
     * */
    pub fn sizingOf(v: &Value, what: [c8])-> Sizing
        throws SyntaxError
    {
        match v {
            _: &Number => { return Sizing::LENGTH; }
            Name(name-> n) => {
                cte for k in Keywords::__members__ {
                    if n == k._0 { return k._1; }
                }
            }
            _ => {}
        }

        throw v.expected(what);
    }

    /**
     * @params:
     *    - track: true if a share in fr is accepted
     * @returns: the length of a size, whose sizing was decoded
     * */
    pub fn lengthOf(v: &Value, track: bool)-> Length
        throws SyntaxError
    {
        if let _: &Number = v {
            return Length(v, fr-> track);
        }

        Length(0.0f)
    }
}
