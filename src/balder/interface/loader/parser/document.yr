in document;

/**
 * A file named by a directive of a .gui file: `@import "panel.gui";`, `@style "panel.style";`
 * */
@data
pub record Include {

    // The path of the file, as written
    pub let path: [c8];

    // The line of the directive, from 1
    pub let line: usize;

    // The column of the directive, from 1
    pub let col: usize;
}

/**
 * A parameter of a component: `$label`, or `$max-length: 64` with its default value
 * */
@data
pub record Param {

    // The name of the parameter, without the '$'
    pub let name: [c8];

    // The value given when an instance does not set the parameter, none when the instance has to
    pub let value: (&Value)?;

    // The line of the parameter, from 1
    pub let line: usize;

    // The column of the parameter, from 1
    pub let col: usize;
}

/**
 * A group of widgets declared once and used as a widget type: `@component FieldRow ($label) { LinearLayout { … } }`
 * */
@data
pub record Component {

    // The name the instances use as their type
    pub let name: [c8];

    // The parameters, the first one being the default attribute of an instance
    pub let params: [Param];

    // The only node of the component, the instance being that node
    pub let root: Node;

    // The line of the directive, from 1
    pub let line: usize;

    // The column of the directive, from 1
    pub let col: usize;
}

/**
 * The content of a .gui file, as read: the files it brings in, its components, and the tree of its widgets
 * */
@data
pub record Document {

    // The .gui files whose components are brought in (@import)
    pub let imports: [Include];

    // The style sheets giving the components their default look (@style)
    pub let styles: [Include];

    // The components declared by the file
    pub let components: [Component];

    // The root of the widget tree, none in a file holding only components
    pub let root: (Node)?;
}

/**
 * What the block of a node holds besides its attributes: a child node, or the slot of a component
 * */
pub union Member
| Node
| SlotMark;

/**
 * A widget of a .gui file, or an instance of a component: `PushButton #YES .yes "Yes" { on-click: quit; }`
 * @info:
 * =====
 * Its values are kept as read: the parameters of a component ($label) are substituted when an instance is expanded,
 * and each attribute is checked against the kind its widget registers when the node is instantiated.
 * ====
 * */
pub record Node {

    // The type of the widget, or the name of a component
    pub let typeName: [c8];

    // The id after the '#', "" for an anonymous widget
    pub let id: [c8];

    // The classes after the '.', in the order of the file
    pub let classes: [[c8]];

    // The default value, set to the default attribute of the type
    pub let value: (&Value)?;

    // The `name: values;` of the block, in the order of the file
    pub let attributes: [Declaration];

    // The nodes and the slots of the block, in the order of the file
    pub let children: [Member];

    // The line and the column of the type, from 1
    pub let loc: (usize, usize);

    pub self;

    /**
     * @returns: the line of the type, from 1
     * */
    @field
    pub fn line(self)-> usize {
        self.loc._0
    }

    /**
     * @returns: the column of the type, from 1
     * */
    @field
    pub fn col(self)-> usize {
        self.loc._1
    }
}

/**
 * The place where a component puts the children of its instances: `@slot;`, or `@slot tools;` for the children that
 * say `slot: tools;`
 * */
pub record SlotMark {

    // The name of the slot, "" for the one receiving the children that name no slot
    pub let name: [c8];

    // The line and the column of the directive, from 1
    pub let loc: (usize, usize);

    pub self;

    /**
     * @returns: the line of the directive, from 1
     * */
    @field
    pub fn line(self)-> usize {
        self.loc._0
    }

    /**
     * @returns: the column of the directive, from 1
     * */
    @field
    pub fn col(self)-> usize {
        self.loc._1
    }
}
