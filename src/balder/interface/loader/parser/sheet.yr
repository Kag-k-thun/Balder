in sheet;

/**
 * A `@font-face { … }` block, registering a font file in a family
 * */
@data
pub record FontFace {

    // The declarations of the block (font-family, src, font-weight, font-style), their constants substituted
    pub let declarations: [Declaration];

    // The line of the directive, from 1
    pub let line: usize;

    // The column of the directive, from 1
    pub let col: usize;
}

/**
 * The declarations of a rule that apply while a condition holds: `@when (width < 500) { direction: column; }`
 * */
@data
pub record When {

    // The condition
    pub let condition: &Condition;

    // The declarations applied while it holds, their constants substituted
    pub let declarations: [Declaration];

    // The line of the directive, from 1
    pub let line: usize;

    // The column of the directive, from 1
    pub let col: usize;
}

/**
 * A rule of a style sheet: `PushButton.yes, PushButton.no { margin: 10; @when (…) { … } }`
 * */
@data
pub record Rule {

    // The selectors sharing the block
    pub let selectors: [Selector];

    // The declarations of the block, their constants substituted, in the order of the file
    pub let declarations: [Declaration];

    // The @when blocks of the rule, coming after its own declarations in the cascade
    pub let whens: [When];

    // The condition of the top level @when holding the rule, none when the rule always applies
    pub let condition: (&Condition)?;

    // The line of the first selector, from 1
    pub let line: usize;

    // The column of the first selector, from 1
    pub let col: usize;
}

/**
 * The content of a .style file, as read
 * */
@data
pub record Sheet {

    // The sheets whose rules and constants come before this one's (@import)
    pub let imports: [Include];

    // The @font-face blocks
    pub let fontFaces: [FontFace];

    // The rules, in the order of the file, those of a top level @when carrying its condition
    pub let rules: [Rule];
}
