in token;

/**
 * The kind of a token of the .gui and .style files
 * */
pub enum TokenKind
| IDENT     = 0u8  // a name: letters, digits, '-' and '_', not starting with a digit (min-content, PushButton)
| NUMBER    = 1u8  // an integer or a decimal with a leading digit, and the unit glued to it (12, 0.5, 12px, 40%, 1fr)
| HASH      = 2u8  // a name after '#', an id or a hexadecimal colour (#ROOT, #388bfd)
| STRING    = 3u8  // a text between double quotes, its escapes resolved
| CONSTANT  = 4u8  // a name after '$' ($accent)
| DIRECTIVE = 5u8  // a name after '@' (@import, @when)
| DELIM     = 6u8  // a punctuation: { } ( ) ; , : :: . > < >= <= == != ! / *
| EOF       = 7u8; // the end of the content

/**
 * A token read from a .gui or a .style file
 * */
@data
pub record Token {

    // The kind of the token
    pub let kind: TokenKind = TokenKind::EOF;

    // The text of the token, without its sigil (#, $, @) or its quotes, and without the unit of a number
    pub let text: [c8] = "";

    // The unit glued to a number ("" when there is none)
    pub let unit: [c8] = "";

    // The line of the first character of the token, from 1
    pub let line: usize = 0us;

    // The column of the first character of the token, from 1
    pub let col: usize = 0us;

    // The offset of the first byte of the token in the content
    pub let start: usize = 0us;

    // The offset after the last byte of the token in the content
    pub let end: usize = 0us;

    // True iif a space, a line break or a comment separates the token from the previous one
    pub let spaced: bool = false;
}
