in sides;

use std::syntax::errors;

/**
 * The four sides of a box shorthand (margin, padding), in the CSS order: one value for all sides, two for vertical then
 * horizontal, three for top, horizontal and bottom, four clockwise from the top
 * */
pub record Sides {

    pub let top: &Value;

    pub let right: &Value;

    pub let bottom: &Value;

    pub let left: &Value;

    /**
     * Split a shorthand, the value of each side being decoded by the property
     * @throws: when it is not 1 to 4 values separated by spaces
     * */
    pub self (v: &Value)
        with top = Sides::side(v, 0us)
        , right = Sides::side(v, 1us)
        , bottom = Sides::side(v, 2us)
        , left = Sides::side(v, 3us)
        throws SyntaxError
    {}
}

/**
 * The splitting of the shorthands
 * */
mod Sides {

    /**
     * @params:
     *    - side: the side, clockwise from the top (0)
     * @returns: the value of the side
     * */
    pub fn side(v: &Value, side: usize)-> &Value
        throws SyntaxError
    {
        let items = v.toTuple();
        match items.len {
            1us => { return items[0]; }
            2us => { return items[side % 2us]; }
            3us => { return items[if side == 3us { 1us } else { side }]; }
            4us => { return items[side]; }
            _   => {}
        }

        throw v.expected("1 to 4 values");
    }
}
