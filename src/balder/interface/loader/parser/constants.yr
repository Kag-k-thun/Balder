in constants;

use balder::interface::loader::parser::value;

use std::syntax::errors;

/**
 * The named values substituted for the `$name` written in other values: the constants of a style sheet, or the
 * parameters of a component
 * @info:
 * =====
 * A value is resolved when it is defined, so a constant may use the ones defined before it, and never itself. A
 * substituted tuple is spliced into the tuple around it, as if its values were written there: with `$pad: 6 14;`,
 * `padding: $pad;` is `padding: 6 14;` and `margin: 0 $pad;` is `margin: 0 6 14;`; lists are spliced the same way.
 * ====
 * */
@final
pub class Constants {

    // The values and their names, already resolved, in the order of their definitions
    let mut _values: [([c8], &Value)] = [];

    pub self () {}

    /**
     * Define a constant, or redefine it
     * @params:
     *    - name: its name, without the '$'
     *    - value: its value, resolved against the constants defined so far
     * */
    pub fn define(mut self, name: [c8], value: &Value)
        throws SyntaxError
    {
        self._values = self._values ~ [(name, self.resolve(value))];
    }

    /**
     * @returns: true iif a constant is defined under name
     * */
    pub fn contains(self, name: [c8])-> bool {
        self.find(name).hasValue
    }

    /**
     * @returns: the value with every constant it uses substituted
     * @throws: when it uses a constant that is not defined
     * */
    pub fn resolve(self, value: &Value)-> &Value
        throws SyntaxError
    {
        match value {
            c: &Constant => {
                if let Ok(v) = self.find(c.name) {
                    return v;
                }

                throw copy SyntaxError("unknown constant '" ~ c.getSource() ~ "'", c.getLine(), c.getColumn());
            }
            t: &Tuple => {
                let mut items: [&Value] = [];
                for item in t.items {
                    items = items ~ self.resolve(item).toTuple();
                }

                return copy Tuple(items, t.getSource(), t.getLine(), t.getColumn());
            }
            l: &List => {
                let mut items: [&Value] = [];
                for item in l.items {
                    items = items ~ self.resolve(item).toList();
                }

                return copy List(items, l.getSource(), l.getLine(), l.getColumn());
            }
            a: &Alpha => {
                return copy Alpha(self.resolve(a.base), self.resolve(a.alpha), a.getSource(), a.getLine(), a.getColumn());
            }
            c: &Call => {
                let mut args: [&Value] = [];
                for arg in c.args {
                    args = args ~ [self.resolve(arg)];
                }

                return copy Call(c.name, args, c.getSource(), c.getLine(), c.getColumn());
            }
            _ => {}
        }

        value
    }

    /**
     * @returns: the value of the last definition of a constant, none if it is not defined
     * */
    fn find(self, name: [c8])-> (&Value)? {
        for i in 0us .. self._values.len {
            let (n, v) = self._values[self._values.len - 1us - i];
            if n == name { return (v)?; }
        }

        none
    }
}
