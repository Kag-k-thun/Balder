in slot;

use std::syntax::errors;

/**
 * The value of an `on-…` attribute: the name of a slot registered by the code, optionally with the arguments bound to it
 * (describe ("…")), or none to leave the signal unconnected
 * */
pub record SlotRef {

    // The name of the slot, a path of names (form::submit), "" for none
    pub let name: [c8];

    // The values bound to the slot, passed before the payload of the signal
    pub let args: [&Value];

    /**
     * Decode a slot reference
     * @throws: when the value is neither a name, a name with arguments, nor none
     * */
    pub self (v: &Value)
        with name = SlotRef::nameOf(v)
        , args = SlotRef::argsOf(v)
        throws SyntaxError
    {}

    /**
     * @returns: true iif the reference is none, the signal being left unconnected
     * */
    pub fn isNone(self)-> bool {
        self.name.len == 0us
    }
}

/**
 * The decoding of the slot references
 * */
mod SlotRef {

    /**
     * @returns: the name of the slot, "" for none
     * */
    pub fn nameOf(v: &Value)-> [c8]
        throws SyntaxError
    {
        match v {
            Name(name-> n) => {
                return if n == "none" { "" } else { n };
            }
            Call(name-> n) => {
                if n != "none" { return n; }
            }
            _ => {}
        }

        throw v.expected("a slot");
    }

    /**
     * @returns: the bound arguments of a slot whose name was decoded
     * */
    pub fn argsOf(v: &Value)-> [&Value] {
        if let Call(args-> a) = v {
            return a;
        }

        []
    }
}
