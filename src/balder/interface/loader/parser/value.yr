in value;

use std::syntax::errors;

/**
 * A value written on the right of `name: …;`, as read, before it is checked against the kind its property expects
 * @info:
 * =====
 * The accessors of the scalar kinds (toNumber, toText, toName, toKeyword…) throw, naming what was expected and what was
 * found; the node of the right kind overrides the one it answers. The compound kinds (lengths, sizes, colours, slots)
 * are records built from a value.
 * ====
 * */
pub class Value {

    // The text of the value in its file
    let _source: [c8];

    // The line of the first token of the value, from 1
    let _line: usize;

    // The column of the first token of the value, from 1
    let _col: usize;

    prot self (source: [c8], line: usize, col: usize)
        with _source = source
        , _line = line
        , _col = col
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the text of the value in its file
     * */
    pub fn getSource(self)-> [c8] {
        self._source
    }

    /**
     * @returns: the line of the value, from 1
     * */
    pub fn getLine(self)-> usize {
        self._line
    }

    /**
     * @returns: the column of the value, from 1
     * */
    pub fn getColumn(self)-> usize {
        self._col
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          KINDS          =======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the value of a number without unit
     * */
    pub fn toNumber(self)-> f64
        throws SyntaxError
    {
        throw self.expected("a number");
    }

    /**
     * @returns: the value of an integer without unit
     * */
    pub fn toInteger(self)-> i64
        throws SyntaxError
    {
        throw self.expected("an integer");
    }

    /**
     * @returns: the content of a string
     * */
    pub fn toText(self)-> [c8]
        throws SyntaxError
    {
        throw self.expected("a string");
    }

    /**
     * @returns: the identifier of a name, or a path of names (form::submit)
     * */
    pub fn toName(self)-> [c8]
        throws SyntaxError
    {
        throw self.expected("a name");
    }

    /**
     * @params:
     *    - set: the keywords the property accepts
     * @returns: the keyword, one of set
     * */
    pub fn toKeyword(self, set: [[c8]])-> [c8]
        throws SyntaxError
    {
        let name = {
            self.toName()
        } catch {
            _: &SyntaxError => { throw self.expected(Value::oneOf(set)); }
        };

        for word in set {
            if word == name { return name; }
        }

        throw self.expected(Value::oneOf(set));
    }

    /**
     * @returns: the boolean of the keyword true or false
     * */
    pub fn toBool(self)-> bool
        throws SyntaxError
    {
        self.toKeyword(copy ["true", "false"]) == "true"
    }

    /**
     * @returns: the values of a tuple, separated by spaces, or this value alone
     * */
    pub fn toTuple(self)-> [&Value] {
        copy [self]
    }

    /**
     * @returns: the values of a list, separated by commas, or this value alone
     * */
    pub fn toList(self)-> [&Value] {
        copy [self]
    }

    /**
     * @params:
     *    - what: the kind of value that was expected, with its article ("a colour")
     * @returns: the error of a value that is not of the expected kind, located at the value
     * */
    pub fn expected(self, what: [c8])-> &SyntaxError {
        copy SyntaxError(std::format::format("expected {}, found '{}'", what, self._source), self._line, self._col)
    }
}

/**
 * A number, an integer or a decimal, with its unit ("" when there is none): 12, 0.5, 12px, 40%, 1fr
 * */
@final
pub class Number over Value {

    let _amount: f64;

    let _unit: [c8];

    let _integer: bool;

    /**
     * @params:
     *    - amount: the value of the number
     *    - unit: its unit, "" "px" "%" or "fr"
     *    - integer: true iif it was written without a decimal part
     * */
    pub self (amount: f64, unit: [c8], integer: bool, source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _amount = amount
        , _unit = unit
        , _integer = integer
    {}

    @field
    pub fn amount(self)-> f64 {
        self._amount
    }

    @field
    pub fn unit(self)-> [c8] {
        self._unit
    }

    pub over toNumber(self)-> f64
        throws SyntaxError
    {
        if self._unit != "" {
            throw self.expected("a number");
        }

        self._amount
    }

    pub over toInteger(self)-> i64
        throws SyntaxError
    {
        if self._unit != "" || !self._integer {
            throw self.expected("an integer");
        }

        cast!i64(self._amount)
    }
}

/**
 * An identifier (auto, row, quit), or a path of identifiers glued by '::' (form::submit)
 * */
@final
pub class Name over Value {

    let _name: [c8];

    pub self (name: [c8], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _name = name
    {}

    @field
    pub fn name(self)-> [c8] {
        self._name
    }

    pub over toName(self)-> [c8] {
        self._name
    }
}

/**
 * A name after a '#', a hexadecimal colour in a value: #388bfd
 * */
@final
pub class Hash over Value {

    let _text: [c8];

    pub self (text: [c8], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _text = text
    {}

    @field
    pub fn text(self)-> [c8] {
        self._text
    }
}

/**
 * A string between double quotes, its escapes resolved: "Noto Sans"
 * */
@final
pub class Text over Value {

    let _text: [c8];

    pub self (text: [c8], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _text = text
    {}

    @field
    pub fn text(self)-> [c8] {
        self._text
    }

    pub over toText(self)-> [c8] {
        self._text
    }
}

/**
 * A constant or a component parameter, substituted before the value is used: $accent
 * */
@final
pub class Constant over Value {

    let _name: [c8];

    pub self (name: [c8], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _name = name
    {}

    @field
    pub fn name(self)-> [c8] {
        self._name
    }
}

/**
 * A name followed by values in parentheses: a slot with bound arguments, describe ("…"), or a function, clamp(…)
 * */
@final
pub class Call over Value {

    let _name: [c8];

    let _args: [&Value];

    /**
     * @params:
     *    - args: the values between the parentheses, separated by commas
     * */
    pub self (name: [c8], args: [&Value], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _name = name
        , _args = args
    {}

    @field
    pub fn name(self)-> [c8] {
        self._name
    }

    @field
    pub fn args(self)-> [&Value] {
        self._args
    }
}

/**
 * A shade of a palette, the name of the palette glued to its level by a '!': grey!10
 * */
@final
pub class Shade over Value {

    let _palette: [c8];

    let _level: &Value;

    /**
     * @params:
     *    - palette: the name of the palette
     *    - level: the number after the '!', from 0 to 100
     * */
    pub self (palette: [c8], level: &Value, source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _palette = palette
        , _level = level
    {}

    @field
    pub fn palette(self)-> [c8] {
        self._palette
    }

    @field
    pub fn level(self)-> &Value {
        self._level
    }
}

/**
 * A colour followed by its opacity after a '/': #388bfd / 40%
 * */
@final
pub class Alpha over Value {

    let _base: &Value;

    let _alpha: &Value;

    pub self (base: &Value, alpha: &Value, source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _base = base
        , _alpha = alpha
    {}

    @field
    pub fn base(self)-> &Value {
        self._base
    }

    @field
    pub fn alpha(self)-> &Value {
        self._alpha
    }
}

/**
 * Values separated by spaces: 6 14, 2 $edge
 * */
@final
pub class Tuple over Value {

    let _items: [&Value];

    pub self (items: [&Value], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _items = items
    {}

    @field
    pub fn items(self)-> [&Value] {
        self._items
    }

    pub over toTuple(self)-> [&Value] {
        self._items
    }
}

/**
 * Values separated by commas: "DejaVu Sans Mono", monospace
 * */
@final
pub class List over Value {

    let _items: [&Value];

    pub self (items: [&Value], source: [c8], line: usize, col: usize)
        with super(source, line, col)
        , _items = items
    {}

    @field
    pub fn items(self)-> [&Value] {
        self._items
    }

    pub over toList(self)-> [&Value] {
        self._items
    }
}

/**
 * The helpers of the values
 * */
mod Value {

    /**
     * @returns: the description of a set of keywords, for an error
     * */
    pub fn oneOf(set: [[c8]])-> [c8] {
        let mut result = "one of ";
        for i, word in set {
            if i != 0us { result = result ~ ", "; }
            result = result ~ word;
        }

        result
    }
}
