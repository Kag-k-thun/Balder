/**
 * The widget types a .gui file can use, and the creation of the widgets of a document read from it (doc/gui-v2.md, §3
 * and §7)
 * */
in registry;

pub mod ::schema;
pub mod ::error;
pub mod ::reference;
mod ::checker;

use balder::interface::style;
use balder::interface::loader::parser;
use balder::interface::loader::registry::{checker, error, schema};
use balder::interface::widget;
use balder::interface::widget::{box, button::_, graph, layout::_, text::_};

use std::syntax::errors;

/**
 * The registry of the widget types, mapping the name of a type to its schema
 * @info:
 * =====
 * Each widget type describes itself next to its class, in its own module; the registry starts with the types of
 * Balder, and an application registers its own. The parsers know no widget type: the tree of nodes of a .gui file is
 * checked against the schemas, then instantiated.
 * ====
 * */
@final
pub class WidgetRegistry {

    // The schemas of the widget types, by name
    let mut _schemas: [[c8] => mut &WidgetSchema] = copy [];

    /**
     * Create a registry knowing the widget types of Balder
     * */
    pub self () {
        self:.register(Box::schema());
        self:.register(Label::schema());
        self:.register(InputText::schema());
        self:.register(PushButton::schema());
        self:.register(MenuButton::schema());
        self:.register(LinearLayout::schema());
        self:.register(GridLayout::schema());
        self:.register(FloatingLayout::schema());
        self:.register(Splitter::schema());
        self:.register(TabLayout::schema());
        self:.register(MenuLayout::schema());
        self:.register(Scene3DLayout::schema());
        self:.register(FrameGraph::schema());
    }

    /**
     * Register a widget type, replacing the type registered under the same name
     * */
    pub fn register(mut self, schema: &WidgetSchema) {
        self._schemas[schema.typeName] = schema;
    }

    /**
     * @returns: the schema of the type named typeName, none if no type is registered under that name
     * */
    pub fn get(self, typeName: [c8])-> (&WidgetSchema)? {
        if let Ok(s) = self._schemas[typeName] {
            return (s)?;
        }

        none
    }

    /**
     * @returns: the schemas a compound selector naming the type typeName can select, every one when typeName is ""
     * */
    pub fn selectable(self, typeName: [c8])-> [&WidgetSchema] {
        if typeName != "" {
            if let Ok(s) = self._schemas[typeName] {
                return copy [s];
            }

            return [];
        }

        let mut result: [&WidgetSchema] = [];
        for _, s in self._schemas {
            result = result ~ [s];
        }

        result
    }

    /**
     * @returns: the style property named name registered by the type typeName, or by any type when typeName is "", none
     * if no such type registers it
     * */
    pub fn property(self, typeName: [c8], name: [c8])-> (&Property)? {
        if typeName != "" {
            if let Ok(s) = self._schemas[typeName] {
                return s.property(name);
            }

            return none;
        }

        for _, s in self._schemas {
            if let Ok(p) = s.property(name) {
                return (p)?;
            }
        }

        none
    }

    /**
     * Check the widget tree of a document against the schemas of the widget types
     * @params:
     *    - file: the path of the file the document was read from, for the errors
     * @throws: at the first node, attribute or value refused, naming the file, the line and the column, and at the
     * first @import, @style or @component, which the registry cannot expand yet
     * */
    pub fn check(self, doc: Document, file: [c8])
        throws LoadError
    {
        let root = WidgetRegistry::rootOf(doc, file);
        WidgetRegistry::refuseDirectives(doc, file);

        let dmut nodes = Checker(self._schemas, file);
        nodes:.check(root);
    }

    /**
     * Create the widgets of a document, checked first
     * @params:
     *    - manager: the manager of the widgets
     *    - file: the path of the file the document was read from, for the errors
     * @returns: the root widget
     * @throws: when the document is refused by the check
     * */
    pub fn instantiate(self, dmut manager: &WidgetManager, doc: Document, file: [c8])-> dmut &Widget
        throws LoadError
    {
        self.check(doc, file);
        self.build(alias manager, WidgetRegistry::rootOf(doc, file), file)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BUILDING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the widget of a checked node, and its children
     * */
    fn build(self, dmut manager: &WidgetManager, node: Node, file: [c8])-> dmut &Widget
        throws LoadError
    {
        let schema = if let Ok(s) = self._schemas[node.typeName] {
            s
        } else {
            throw copy LoadError(file, "unknown widget type '" ~ node.typeName ~ "'", node.line, node.col);
        };

        let dmut widget = schema.create(alias manager, node.id);
        {
            widget:.setClasses(node.classes);
            if let Ok(v) = node.value {
                if let Ok(attr) = schema.attribute(schema.defaultAttribute) {
                    attr.apply(alias widget, v);
                }
            }

            for a in node.attributes {
                if let Ok(attr) = schema.attribute(a.name) {
                    attr.apply(alias widget, a.value);
                }
            }

            let mut index = 0us;
            for c in node.children {
                match c {
                    child: Node => {
                        if let Ok(inserter) = schema.children {
                            let dmut w = self.build(alias manager, child, file);
                            inserter.insert(alias widget, alias w, index);
                            self.applySlots(schema, alias widget, w, child);
                            index += 1us;
                        }
                    }
                    _ => {}
                }
            }
        } catch {
            e: &SyntaxError => {
                widget:.dispose();
                throw copy LoadError(file, "attribute of '" ~ node.typeName ~ "': " ~ e.msg, e.line, e.col);
            }
            e: &LoadError => {
                widget:.dispose();
                throw e;
            }
        }

        alias widget
    }

    /**
     * Set the attributes a widget gives its child, those of the child not being its own
     * @params:
     *    - schema: the schema of the parent
     *    - node: the node of the child
     * */
    fn applySlots(self, schema: &WidgetSchema, dmut parent: &Widget, child: &Widget, node: Node)
        throws SyntaxError
    {
        let own = self.get(node.typeName);
        for a in node.attributes {
            let isOwn = if let Ok(s) = own { s.attribute(a.name).hasValue } else { false };
            if !isOwn {
                if let Ok(slot) = schema.slot(a.name) {
                    slot.apply(alias parent, child, a.value);
                }
            }
        }
    }
}

/**
 * The helpers of the registry
 * */
mod WidgetRegistry {

    /**
     * @returns: the root node of a document
     * @throws: when the document has none
     * */
    pub fn rootOf(doc: Document, file: [c8])-> Node
        throws LoadError
    {
        if let Ok(root) = doc.root {
            return root;
        }

        throw copy LoadError(file, "no widget in the file", 1us, 1us);
    }

    /**
     * Refuse the directives of a document, whose components the registry cannot expand yet
     * @throws: at the first @import, @style or @component
     * */
    pub fn refuseDirectives(doc: Document, file: [c8])
        throws LoadError
    {
        if doc.imports.len != 0us {
            throw copy LoadError(file, "'@import' is not supported yet", doc.imports[0].line, doc.imports[0].col);
        }

        if doc.styles.len != 0us {
            throw copy LoadError(file, "'@style' is not supported yet", doc.styles[0].line, doc.styles[0].col);
        }

        if doc.components.len != 0us {
            throw copy LoadError(file, "'@component' is not supported yet", doc.components[0].line, doc.components[0].col);
        }
    }
}
