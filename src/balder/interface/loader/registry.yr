/**
 * The widget types a .gui file can use, and the creation of the widgets of a document read from it (doc/gui-v2.md, §3
 * and §7)
 * */
in registry;

pub mod ::connection;
pub mod ::handler;
pub mod ::behavior;
pub mod ::schema;
pub mod ::error;
pub mod ::reference;
pub mod ::binding;
pub mod ::setting;
pub mod ::widget_node;
pub mod ::definition;
pub mod ::library;
mod ::bound;
mod ::expander;
mod ::checker;
mod ::builder;

use balder::core::application::signal;
use balder::interface::style;
use balder::interface::loader::parser;
use balder::interface::loader::registry::{behavior, builder, checker, error, expander, library, schema, widget_node};
use balder::interface::widget;
use balder::interface::widget::{box, button::_, graph, image, layout::_, range::_, separator, text::_};

use std::syntax::errors;

/**
 * The registry of the widget types, mapping the name of a type to its schema
 * @info:
 * =====
 * Each widget type describes itself next to its class, in its own module; the registry starts with the types of
 * Balder, and an application registers its own. The parsers know no widget type: the tree of nodes of a .gui file is
 * unfolded, its instances of components replaced by the roots of the components, then checked against the schemas,
 * then instantiated.
 * ====
 * */
@final
pub class WidgetRegistry {

    // The schemas of the widget types, by name
    let mut _schemas: [[c8] => mut &WidgetSchema] = copy [];

    // The components of the .gui files loaded
    let dmut _library: &Library = copy Library();

    /**
     * Create a registry knowing the widget types of Balder
     * */
    pub self () {
        self:.register(Box::schema());
        self:.register(Label::schema());
        self:.register(InputText::schema());
        self:.register(SpinBox::schema());
        self:.register(PushButton::schema());
        self:.register(MenuButton::schema());
        self:.register(CheckBox::schema());
        self:.register(RadioButton::schema());
        self:.register(Slider::schema());
        self:.register(ProgressBar::schema());
        self:.register(Separator::schema());
        self:.register(Image::schema());
        self:.register(LinearLayout::schema());
        self:.register(GridLayout::schema());
        self:.register(FloatingLayout::schema());
        self:.register(Splitter::schema());
        self:.register(TabLayout::schema());
        self:.register(MenuLayout::schema());
        self:.register(Scene3DLayout::schema());
        self:.register(FrameGraph::schema());
    }

    /**
     * Register a widget type, replacing the type registered under the same name
     * */
    pub fn register(mut self, schema: &WidgetSchema) {
        self._schemas[schema.typeName] = schema;
    }

    /**
     * @returns: the schema of the type named typeName, none if no type is registered under that name
     * */
    pub fn get(self, typeName: [c8])-> (&WidgetSchema)? {
        if let Ok(s) = self._schemas[typeName] {
            return (s)?;
        }

        none
    }

    /**
     * @returns: the schema of the type named typeName, or of the root of the component named typeName among those of
     * the .gui files loaded, none if there is neither
     * */
    pub fn typeOf(self, typeName: [c8])-> (&WidgetSchema)? {
        if let Ok(s) = self._schemas[typeName] {
            return (s)?;
        }

        self.rootTypeOf(typeName, [])
    }

    /**
     * @returns: the schemas a compound selector naming the type typeName can select, every one when typeName is "", a
     * component selecting the type of its root
     * */
    pub fn selectable(self, typeName: [c8])-> [&WidgetSchema] {
        if typeName != "" {
            if let Ok(s) = self.typeOf(typeName) {
                return copy [s];
            }

            return [];
        }

        let mut result: [&WidgetSchema] = [];
        for _, s in self._schemas {
            result = result ~ [s];
        }

        result
    }

    /**
     * @returns: the style property named name registered by the type typeName, or by the type of the root of the
     * component typeName, or by any type when typeName is "", none if no such type registers it
     * */
    pub fn property(self, typeName: [c8], name: [c8])-> (&Property)? {
        if typeName != "" {
            if let Ok(s) = self.typeOf(typeName) {
                return s.property(name);
            }

            return none;
        }

        for _, s in self._schemas {
            if let Ok(p) = s.property(name) {
                return (p)?;
            }
        }

        none
    }

    /**
     * Add the components of a document and of the files it imports to those the registry knows
     * @params:
     *    - file: the path of the file the document was read from, its imports being relative to it
     * @throws: when an imported file cannot be read, is not a .gui file, or imports itself, and when two components of
     * the same name reach the file
     * */
    pub fn load(mut self, doc: Document, file: [c8])
        throws LoadError
    {
        self._library:.load(doc, file);
    }

    /**
     * @returns: the components of the .gui files loaded, and the style sheets giving them their default look
     * */
    pub fn getLibrary(self)-> &Library {
        self._library
    }

    /**
     * Unfold the components of a document into the tree of its widgets (doc/gui-v2.md, §8), its components and those of
     * the files it imports being loaded first
     * @params:
     *    - file: the path of the file the document was read from, for the errors
     * @returns: the tree of the widgets
     * @throws: when the document has no widget, when its components cannot be loaded, and at the first instance
     * refused, naming the file, the line and the column
     * */
    pub fn unfold(mut self, doc: Document, file: [c8])-> WidgetNode
        throws LoadError
    {
        let root = WidgetRegistry::rootOf(doc, file);
        self:.load(doc, file);

        let dmut expander = Expander(self._schemas, self._library);
        expander:.unfold(root, file)
    }

    /**
     * Unfold an instance of a component of the .gui files loaded, written by code
     * @params:
     *    - source: the node of the instance, in the syntax of the .gui files: `FieldRow #PHONE "Phone" { max-length: 20; }`
     *    - file: the name of the source in the errors
     * @returns: the tree of the widgets of the instance
     * @throws: when the source is not a node, or not an instance of a component of the files loaded, and when the
     * instance is refused
     * */
    pub fn unfoldInstance(mut self, source: [c8], file: [c8])-> WidgetNode
        throws LoadError
    {
        let doc = {
            let dmut reader = GuiReader(source);
            reader:.read()
        } catch {
            e: &SyntaxError => { throw copy LoadError(file, e.msg, e.line, e.col); }
        };

        let root = WidgetRegistry::rootOf(doc, file);
        if let Ok(found) = self._library.find(root.typeName) {
            self._library:.share(file, found.file);
        } else {
            throw copy LoadError(file, "unknown component '" ~ root.typeName ~ "'", root.line, root.col);
        }

        let dmut expander = Expander(self._schemas, self._library);
        expander:.unfold(root, file)
    }

    /**
     * Check a tree of widgets against the schemas of the widget types, and its `on-…` attributes against the slots of a
     * behavior
     * @params:
     *    - parent: the schema of the widget the root is inserted in, none for the root of the interface
     *    - behavior: the slots the `on-…` attributes name, none to check only the syntax of their values
     * @throws: at the first widget, attribute or value refused, naming the file, the line and the column
     * */
    pub fn check(self, tree: WidgetNode, parent: (&WidgetSchema)? = none, behavior: (&Behavior)? = none)
        throws LoadError
    {
        let dmut nodes = Checker(self._schemas, behavior-> behavior);
        nodes:.check(tree, parent-> parent);
    }

    /**
     * Check the widget tree of a document against the schemas of the widget types, its components unfolded
     * @params:
     *    - file: the path of the file the document was read from, for the errors
     *    - behavior: the slots the `on-…` attributes name, none to check only the syntax of their values
     * @throws: at the first instance, widget, attribute or value refused, naming the file, the line and the column
     * */
    pub fn check(mut self, doc: Document, file: [c8], behavior: (&Behavior)? = none)
        throws LoadError
    {
        self.check(self:.unfold(doc, file), behavior-> behavior);
    }

    /**
     * Create the widgets of a document, its components unfolded and its tree checked first
     * @params:
     *    - manager: the manager of the widgets
     *    - file: the path of the file the document was read from, for the errors
     *    - behavior: the slots the `on-…` attributes name
     *    - box: the emitter running the slots, in the thread of the activity
     * @returns: the root widget
     * @throws: when the document is refused by the unfolding or the check
     * */
    pub fn instantiate(mut self, dmut manager: &WidgetManager, doc: Document, file: [c8], behavior: &Behavior, dmut box: &SlotEmitter)-> dmut &Widget
        throws LoadError
    {
        self.instantiate(alias manager, self:.unfold(doc, file), behavior, alias box)
    }

    /**
     * Create the widgets of a tree, checked first, and connect their signals to the slots their `on-…` attributes name
     * @params:
     *    - manager: the manager of the widgets
     *    - behavior: the slots the `on-…` attributes name
     *    - box: the emitter running the slots, in the thread of the activity
     * @returns: the root widget
     * @throws: when the tree is refused by the check
     * */
    pub fn instantiate(self, dmut manager: &WidgetManager, tree: WidgetNode, behavior: &Behavior, dmut box: &SlotEmitter)-> dmut &Widget
        throws LoadError
    {
        self.check(tree, behavior-> (behavior)?);

        let dmut widgets = Builder(self._schemas, behavior, alias box);
        widgets:.build(alias manager, tree)
    }

    /**
     * Create the widgets of a tree, checked first under a widget, and insert them after its children
     * @params:
     *    - manager: the manager of the widgets
     *    - parent: the widget receiving the root of the tree
     *    - index: the position of the root among the children of the parent, its role
     *    - behavior: the slots the `on-…` attributes name
     *    - box: the emitter running the slots, in the thread of the activity
     * @returns: the root widget
     * @throws: when the parent takes no more children, or the tree is refused by the check
     * */
    pub fn insert(self, dmut manager: &WidgetManager, dmut parent: &Widget, tree: WidgetNode, index: usize, behavior: &Behavior, dmut box: &SlotEmitter)-> dmut &Widget
        throws LoadError
    {
        let schema = if let Ok(s) = self._schemas[parent.typeName] {
            s
        } else {
            throw copy LoadError(tree.file, "unknown widget type '" ~ parent.typeName ~ "'", tree.line, tree.col);
        };

        let max = if let Ok(c) = schema.children { c.max } else { 0us };
        if index >= max {
            throw copy LoadError(tree.file, "'" ~ parent.typeName ~ "' takes no more children", tree.line, tree.col);
        }

        self.check(tree, parent-> (schema)?, behavior-> (behavior)?);

        let dmut widgets = Builder(self._schemas, behavior, alias box);
        let dmut w = widgets:.build(alias manager, tree);
        {
            widgets.insert(schema, alias parent, alias w, tree, index);
        } catch {
            e: &SyntaxError => {
                w:.dispose();
                throw copy LoadError(tree.file, "attribute of '" ~ tree.typeName ~ "': " ~ e.msg, e.line, e.col);
            }
        }

        alias w
    }

    /**
     * @returns: the schema of the type of the root of the component named name, followed through the components whose
     * roots are instances, none when there is no such component or type, or when the roots make a cycle
     * @params:
     *    - seen: the components followed so far
     * */
    fn rootTypeOf(self, name: [c8], seen: [[c8]])-> (&WidgetSchema)? {
        for n in seen {
            if n == name { return none; }
        }

        if let Ok(d) = self._library.find(name) {
            let root = d.component.root.typeName;
            if let Ok(s) = self._schemas[root] {
                return (s)?;
            }

            return self.rootTypeOf(root, seen ~ [name]);
        }

        none
    }
}

/**
 * The helpers of the registry
 * */
mod WidgetRegistry {

    /**
     * @returns: the root node of a document
     * @throws: when the document has none
     * */
    pub fn rootOf(doc: Document, file: [c8])-> Node
        throws LoadError
    {
        if let Ok(root) = doc.root {
            return root;
        }

        throw copy LoadError(file, "no widget in the file", 1us, 1us);
    }
}
