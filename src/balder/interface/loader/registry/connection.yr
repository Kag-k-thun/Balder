in connection;

/**
 * A slot bound to the arguments an `on-…` attribute gives it, waiting for the payload of the signal it is connected to
 * (doc/gui-v2.md, §9)
 * @info:
 * =====
 * The connection of a signal of payload P is a `Connection!{P}`: a signal casts the connection to the type of its own
 * payload to connect it, the cast failing when the slot does not take that payload last.
 * ====
 * */
@abstract
pub class Connection {
    prot self () {}
}

/**
 * A connection to the signals without payload
 * */
@final
pub class Connection {P of ()} over Connection {

    let _fire: dg ()-> void;

    /**
     * @params:
     *    - fire: the call of the slot with its bound arguments
     * */
    pub self (fire: dg ()-> void)
        with _fire = fire
    {}

    /**
     * Call the slot with its bound arguments
     * */
    pub fn fire(self) {
        self._fire();
    }
}

/**
 * A connection to the signals of payload P
 * */
@final
pub class Connection {P} over Connection {

    let _fire: dg (P)-> void;

    /**
     * @params:
     *    - fire: the call of the slot with its bound arguments, then the payload
     * */
    pub self (fire: dg (P)-> void)
        with _fire = fire
    {}

    /**
     * Call the slot with its bound arguments, then the payload of the signal
     * */
    pub fn fire(self, payload: P) {
        self._fire(payload);
    }
}
