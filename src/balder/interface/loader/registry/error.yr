in error;

use balder::core::error;

/**
 * Error thrown when the widgets of a .gui file cannot be created, located in the file
 * */
pub class LoadError over BalderError {

    // The path of the file
    pub let file: [c8];

    // The line of the error, from 1
    pub let line: usize;

    // The column of the error, from 1
    pub let col: usize;

    // What is wrong, without the location
    pub let reason: [c8];

    pub self (file: [c8], reason: [c8], line: usize, col: usize)
        with super(std::format::format("{}:{}:{}: {}", file, line, col, reason))
        , file = file
        , line = line
        , col = col
        , reason = reason
    {}
}
