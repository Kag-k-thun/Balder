in builder;

use balder::core::application::signal;
use balder::interface::widget;
use balder::interface::loader::parser;
use balder::interface::loader::registry::{behavior, connection, error, schema, widget_node};

use std::syntax::errors;

/**
 * Builder of the widgets of a checked tree, the widgets an instance put in the slots of its component being found under
 * the widget of the instance, and the signals of the `on-…` attributes connected to the slots they name
 * */
pub record Builder {

    // The schemas of the widget types, by name
    let _schemas: [[c8] => &WidgetSchema];

    // The slots the `on-…` attributes name
    let _behavior: &Behavior;

    // The emitter running the slots, in the thread of the activity
    let dmut _box: &SlotEmitter;

    // The widgets of the instances built so far, by the number of the instance
    let dmut _instances: [usize => &Widget] = copy [];

    /**
     * @params:
     *    - schemas: the schemas of the widget types, by name
     *    - behavior: the slots the `on-…` attributes name
     *    - box: the emitter running the slots
     * */
    pub self (schemas: [[c8] => &WidgetSchema], behavior: &Behavior, dmut box: &SlotEmitter)
        with _schemas = schemas
        , _behavior = behavior
        , _box = alias box
    {}

    /**
     * Create the widget of a checked node, and its children
     * @params:
     *    - manager: the manager of the widgets
     * @returns: the widget
     * @throws: when a value cannot be set, the widgets created being disposed
     * */
    pub fn build(mut self, dmut manager: &WidgetManager, node: WidgetNode)-> dmut &Widget
        throws LoadError
    {
        let schema = if let Ok(s) = self._schemas[node.typeName] {
            s
        } else {
            throw copy LoadError(node.file, "unknown widget type '" ~ node.typeName ~ "'", node.line, node.col);
        };

        let dmut widget = schema.create(alias manager, node.id);
        {
            widget:.setClasses(node.classes);
            widget:.setComponents(node.components);
            if let Ok(v) = node.value {
                if let Ok(attr) = schema.attribute(schema.defaultAttribute) {
                    attr.apply(alias widget, v.value);
                }
            }

            for a in node.attributes {
                if !a.forParent {
                    if let Ok(attr) = schema.attribute(a.name) {
                        attr.apply(alias widget, a.value);
                    } else if let Ok(signal) = schema.signal(a.name) {
                        self:.connect(alias widget, signal, a.value);
                    }
                }
            }

            for i in node.instances {
                self._instances[i] = alias widget;
            }

            if node.owner != 0us {
                if let Ok(dmut instance) = alias self._instances[node.owner] {
                    instance:.addSlotted(alias widget);
                }
            }

            let mut index = 0us;
            for child in node.children {
                if let Ok(_) = schema.children {
                    let dmut w = self:.build(alias manager, child);
                    self.insert(schema, alias widget, alias w, child, index);
                    index += 1us;
                }
            }
        } catch {
            e: &SyntaxError => {
                widget:.dispose();
                throw copy LoadError(node.file, "attribute of '" ~ node.typeName ~ "': " ~ e.msg, e.line, e.col);
            }
            e: &LoadError => {
                widget:.dispose();
                throw e;
            }
        }

        alias widget
    }

    /**
     * Connect a signal of a widget to the slot an `on-…` attribute names, checked first, none leaving it unconnected
     * @params:
     *    - v: the value of the attribute
     * */
    fn connect(mut self, dmut widget: &Widget, signal: &SignalAttribute, v: &Value)
        throws SyntaxError
    {
        let target = SlotRef(v);
        if target.isNone() { return; }

        if let Ok(handler) = self._behavior.find(target.name) {
            signal.connect(alias widget, alias self._box, handler.bind(target.args));
        }
    }

    /**
     * Insert a widget among the children of another, setting the attributes the parent gives it, those of the child
     * not being its own
     * @params:
     *    - schema: the schema of the parent
     *    - node: the node of the child
     *    - index: the position of the child among the children of the parent, its role
     * */
    pub fn insert(self, schema: &WidgetSchema, dmut parent: &Widget, dmut child: &Widget, node: WidgetNode, index: usize)
        throws SyntaxError
    {
        if let Ok(inserter) = schema.children {
            inserter.insert(alias parent, alias child, index);
        }

        let own = self._schemas[node.typeName];
        for a in node.attributes {
            let isOwn = if let Ok(s) = own { !a.forParent && s.attribute(a.name).hasValue } else { false };
            if !isOwn {
                if let Ok(slot) = schema.slot(a.name) {
                    slot.apply(alias parent, child, a.value);
                }
            }
        }
    }
}
