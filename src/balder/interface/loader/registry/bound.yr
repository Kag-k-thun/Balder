in bound;

use balder::interface::loader::parser;
use balder::interface::loader::registry::schema;

use std::syntax::errors;

/**
 * A slot of parameters T bound to its first arguments, already checked against their types
 * @info:
 * =====
 * The parameters of the slot are built as a tuple, the bound arguments decoded one at a time in front of the payload of
 * the signal, then expanded into the call. The arguments are decoded at each call rather than kept, their types being
 * those of the parameters.
 * ====
 * */
@final
pub class Bound {T...} {

    // The slot
    let _slot: dg (T)-> void;

    // The arguments bound to its first parameters
    let _args: [&Value];

    pub self (slot: dg (T)-> void, args: [&Value])
        with _slot = slot
        , _args = args
    {}

    /**
     * Call the slot with its bound arguments, all its parameters being bound
     * @info: never connected when the last parameter is given only by the payload of a signal (decodable)
     * */
    pub fn fireParameters(self) {
        cte if (decodable!{__pragma!field_type((T,), (T,)::arity - 1)}) {
            {
                self.call(gather!{(T,), (T,)::arity, 0us} (self._args, (), ()));
            } catch {
                _: &SyntaxError => {}
            }
        }
    }

    /**
     * Call the slot with its bound arguments, then the payload of a signal as its last parameter
     * */
    pub fn fireParametersWithPayload(self, payload: __pragma!field_type((T,), (T,)::arity - 1)) {
        cte if ((T,)::arity == 1) {
            self._slot(payload);
        } else {
            {
                self.call(gather!{(T,), (T,)::arity - 1us, 0us} (self._args, (), (payload,)));
            } catch {
                _: &SyntaxError => {}
            }
        }
    }

    /**
     * Call the slot with the tuple of its parameters
     * */
    fn call(self, params: (T,)) {
        cte if ((T,)::arity == 1) {
            self._slot(params.0);
        } else {
            self._slot(expand params);
        }
    }
}

/**
 * @returns: the tuple TT of the parameters of a slot, made of the parameters decoded so far then the last ones, given
 * @params:
 *    - args: the bound arguments
 *    - acc: the first parameters, decoded from the bound arguments
 *    - tail: the last parameters, the payload of a signal
 * */
fn if (I == E) gather {TT, E : usize, I : usize, Acc, Tail} (args: [&Value], acc: Acc, tail: Tail)-> TT {
    args;
    (expand acc, expand tail)
}

/**
 * @returns: the tuple TT of the parameters of a slot, its parameters I to E decoded from the bound arguments, after the
 * parameters decoded so far and before the last ones, given
 * @params:
 *    - args: the bound arguments, already checked against the types of their parameters
 *    - acc: the parameters before I
 *    - tail: the parameters after E, the payload of a signal
 * @throws: when a bound argument does not decode to the type of its parameter, which the check of the binding rules out
 * */
fn if (I < E) gather {TT, E : usize, I : usize, Acc, Tail} (args: [&Value], acc: Acc, tail: Tail)-> TT
    throws SyntaxError
{
    gather!{TT, E, I + 1us} (args, (expand acc, decode!{__pragma!field_type(TT, I)} (args[I])), tail)
}
