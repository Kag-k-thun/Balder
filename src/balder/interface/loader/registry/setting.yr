in setting;

use balder::interface::loader::parser;
use balder::interface::loader::registry::binding;

/**
 * An attribute of a widget of an expanded tree, `max-length: 64;`, the parameters of its components substituted, with
 * where the errors about it are reported
 * */
@data
pub record Setting {

    // The name of the attribute, "" for the default value after the selector of a node
    pub let name: [c8];

    // Its value, the parameters of the components substituted
    pub let value: &Value;

    // The type of the widget or the component the attribute is written on, named in the errors
    pub let typeName: [c8];

    // The file the attribute is written in
    pub let file: [c8];

    // The line of its name, or of its value for a default value, from 1
    pub let line: usize;

    // The column of its name, or of its value for a default value, from 1
    pub let col: usize;

    // True for an attribute of an instance that is none of the parameters of its component, given by its parent
    pub let forParent: bool = false;

    // The parameter whose value the attribute uses, an error about its value being reported where that value was given
    pub let binding: (Binding)? = none;
}
