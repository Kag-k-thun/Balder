in binding;

/**
 * Where the value of a parameter of a component was given: by an attribute or the default value of an instance, or by
 * the default of the parameter in the declaration of the component
 * */
@data
pub record Binding {

    // The name of the component
    pub let component: [c8];

    // The name of the parameter, without the '$'
    pub let param: [c8];

    // The file the value is written in
    pub let file: [c8];

    // The line of the value, from 1
    pub let line: usize;

    // The column of the value, from 1
    pub let col: usize;
}
