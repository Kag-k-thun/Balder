/**
 * The reference of the widget types and of the style properties, generated from the registry and the property table:
 * the part of doc/gui.md after its marker, written by `gyllir run reference` in tools/
 * */
in reference;

use balder::interface::style;
use balder::interface::loader::registry::schema;

/**
 * The line of doc/gui.md after which the reference is generated
 * */
pub def MARKER = "<!-- Generated by `gyllir run reference` from the widget registry and the property table: do not edit below. -->";

/**
 * @returns: the reference of the widget types of a registry and of the common style properties, in markdown
 * */
pub fn reference(registry: &WidgetRegistry)-> [c8] {
    widgetTypes(registry) ~ "\n" ~ properties(PropertyTable())
}

/**
 * @returns: what follows the marker line in the content of a document, none if it has no marker
 * */
pub fn generatedPart(doc: [c8])-> ([c8])? {
    if let Ok(end) = markerEnd(doc) {
        return (doc[end .. $])?;
    }

    none
}

/**
 * @returns: the content of a document up to its marker line, then the marker, then the generated part, the marker
 * being added at the end when the document has none
 * */
pub fn splice(doc: [c8], generated: [c8])-> [c8] {
    if let Ok(end) = markerEnd(doc) {
        return doc[0us .. end] ~ generated;
    }

    doc ~ "\n" ~ MARKER ~ "\n\n" ~ generated
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          WIDGET TYPES          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the section of the widget types, in the order of their names
 * */
fn widgetTypes(registry: &WidgetRegistry)-> [c8] {
    let mut result = "## Widget types\n\n"
        ~ "The attributes of a type are set in the block of a node, `max-length: 64;`, its default attribute by the value "
        ~ "after the selector, `Label \"Name\";`. The attributes of the children are set on a child by its parent's "
        ~ "type, `tab: \"Form\";`. The properties are style properties the type reads beyond the common ones.\n";

    for s in sorted(registry.selectable("")) {
        result = result ~ "\n" ~ widgetType(s);
    }

    result
}

/**
 * @returns: the entry of a widget type
 * */
fn widgetType(s: &WidgetSchema)-> [c8] {
    let mut attributes: [[c8]] = [];
    for a in s.attributes {
        attributes = attributes ~ ["`" ~ a.name ~ "`: " ~ a.kind()];
    }

    let mut slots: [[c8]] = [];
    for a in s.slots {
        slots = slots ~ ["`" ~ a.name ~ "`: " ~ a.kind() ~ (if a.required { ", required" } else { "" })];
    }

    let mut parts: [[c8]] = [];
    for p in s.parts {
        let states = s.statesOf(p);
        parts = parts ~ ["`" ~ p ~ "`" ~ (if states.len == 0us { "" } else { " (states " ~ quoted(states) ~ ")" })];
    }

    let mut props: [[c8]] = [];
    for p in s.properties {
        props = props ~ ["`" ~ p.name ~ "`: " ~ p.kind];
    }

    "### `" ~ s.typeName ~ "`\n\n"
        ~ "- **Attributes:** " ~ joined(attributes, "; ") ~ "\n"
        ~ "- **Default attribute:** " ~ (if s.defaultAttribute == "" { "none" } else { "`" ~ s.defaultAttribute ~ "`" }) ~ "\n"
        ~ "- **Children:** " ~ children(s) ~ "\n"
        ~ "- **Attributes of the children:** " ~ joined(slots, "; ") ~ "\n"
        ~ "- **States:** " ~ (if s.states.len == 0us { "none" } else { quoted(s.states) }) ~ "\n"
        ~ "- **Parts:** " ~ joined(parts, ", ") ~ "\n"
        ~ "- **Properties:** " ~ joined(props, "; ") ~ "\n"
}

/**
 * @returns: the children a widget type accepts
 * */
fn children(s: &WidgetSchema)-> [c8] {
    let c = if let Ok(c) = s.children { c } else { return "none"; };
    if c.roles.len == 0us {
        return if c.min == 0us { "any number" } else { std::format::format("at least {}", c.min) };
    }

    let mut roles = "";
    for i, r in c.roles {
        roles = (if i == 0us { "" } else { roles ~ " then " }) ~ "its " ~ r;
    }

    if c.min == 0us {
        return roles ~ ", optional";
    }

    if c.min < c.roles.len {
        return roles ~ std::format::format(", the first {} required", c.min);
    }

    roles
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          PROPERTIES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the section of the common style properties, in the order of the table
 * */
fn properties(table: &PropertyTable)-> [c8] {
    let mut result = "## Style properties\n\n"
        ~ "Every widget reads these properties. An inherited property passes from a widget to its children and its parts. "
        ~ "A property affecting the layout lays the interface out again when it changes, and a rule testing a state "
        ~ "cannot set it. A shorthand sets its longhands, which cascade separately.\n\n"
        ~ "| Property | Value | Inherited | Layout |\n"
        ~ "|---|---|---|---|\n";

    for p in table.all() {
        let mut value = p.kind;
        if let s: &Shorthand = p {
            let mut names: [[c8]] = [];
            for l in s.longhands {
                names = names ~ ["`" ~ l.name ~ "`"];
            }

            value = value ~ ", setting " ~ joined(names, ", ");
        }

        result = result ~ "| `" ~ p.name ~ "` | " ~ value ~ " | " ~ (if p.inherited { "yes" } else { "" })
            ~ " | " ~ (if p.affectsLayout { "yes" } else { "" }) ~ " |\n";
    }

    result
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TEXTS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the offset after the line of the marker and its newline in a document, none if it has no marker
 * */
fn markerEnd(doc: [c8])-> (usize)? {
    if doc.len < MARKER.len { return none; }
    for i in 0us .. doc.len - MARKER.len + 1us {
        if doc[i .. i + MARKER.len] == MARKER && (i == 0us || doc[i - 1us] == '\n') {
            let mut end = i + MARKER.len;
            while end < doc.len && doc[end] == '\n' {
                end += 1us;
            }

            return (end)?;
        }
    }

    none
}

/**
 * @returns: the names quoted as code and separated by commas
 * */
fn quoted(names: [[c8]])-> [c8] {
    let mut result: [[c8]] = [];
    for n in names {
        result = result ~ ["`" ~ n ~ "`"];
    }

    joined(result, ", ")
}

/**
 * @returns: the items separated by sep, "none" when there is none
 * */
fn joined(items: [[c8]], sep: [c8])-> [c8] {
    if items.len == 0us { return "none"; }

    let mut result = "";
    for i, item in items {
        result = (if i == 0us { "" } else { result ~ sep }) ~ item;
    }

    result
}

/**
 * @returns: the schemas, in the order of the bytes of their names
 * */
fn sorted(schemas: [&WidgetSchema])-> [&WidgetSchema] {
    let mut result: [&WidgetSchema] = [];
    for s in schemas {
        let mut i = 0us;
        while i < result.len && !before(s.typeName, result[i].typeName) {
            i += 1us;
        }

        result = result[0us .. i] ~ [s] ~ result[i .. $];
    }

    result
}

/**
 * @returns: true iif a comes before b in the order of their bytes
 * */
fn before(a: [c8], b: [c8])-> bool {
    for i in 0us .. a.len {
        if i >= b.len { return false; }
        if a[i] != b[i] { return a[i] < b[i]; }
    }

    a.len < b.len
}
