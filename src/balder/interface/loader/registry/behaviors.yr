in behaviors;

use balder::core::application::signal;
use balder::interface::loader::registry::handler;
use balder::scene::actors::utils;

/**
 * The behavior classes, registering the slots of their methods tagged #[slot] on a behavior of the class, by the name
 * of the class
 * */
lazy dmut __BEHAVIOR_CLASSES__: [[c8] => dg (dmut &Behavior)-> void] = copy [];

/**
 * Declare a class over Behavior a behavior class, registered at the start of the program: its methods tagged #[slot],
 * private ones included, are its slots, with or without parameters, registered on a behavior of the class once it is
 * built (see Behavior::registerTaggedSlots)
 * @info:
 * =====
 * A slot is named by its tag, or by its method in kebab case (`onClear` is `on-clear`):
 * ```
 * #[behavior]
 * class FormBehavior over Behavior {
 *     pub self () {}
 *
 *     #[slot (name-> "submit")]
 *     fn onSubmit (mut self, button: u8) { … }
 * }
 * ```
 * A class over a behavior class has the slots of the other one, then its own, a slot of its own replacing the one of
 * the same name.
 * ====
 * */
pub tag behavior {

    pub self {class C} () {
        registerBehaviorClass(C::typeinfo.inner[0].name, |dmut b| {
            b;
            if let dmut c: C = alias b {
                c;
                cte for j in 0us .. __pragma!method_infos(C).len {
                    cte if (__pragma!method_has_tag(C, __pragma!method_infos(C)[j].name, slot)) {
                        c:.slot(memberName(__pragma!method_tag(C, __pragma!method_infos(C)[j].name, slot).name, __pragma!method_infos(C)[j].name),
                                &__pragma!method(alias c, __pragma!method_infos(C)[j].name));
                    }
                }
            }
        });
    }

}

/**
 * The slots the code registers under names for the `on-…` attributes of the .gui files, and the behaviors grouping
 * other slots under a name (doc/gui-v2.md, §9)
 * @info:
 * =====
 * A name is a path of segments separated by `::`: `form::submit` is the slot `submit` of the behavior `form`. An
 * activity holds the root behavior; an application describes a group of slots by a behavior class, its methods tagged
 * #[slot] (see the tag behavior), and mounts it under a name:
 * ```
 * #[behavior]
 * class FormBehavior over Behavior {
 *     pub self () {}
 *
 *     #[slot (name-> "submit")]
 *     fn onSubmit (mut self, button: u8) { … }
 * }
 *
 * // in the activity, for `on-click: form::submit;`
 * self:.behavior ("form", copy FormBehavior ());
 * ```
 * The slots registered dynamically, or under a path, are registered by `slot`, in the constructor or later.
 * ====
 * */
pub class Behavior {

    // The slots of the behavior, by name
    let mut _slots: [[c8] => mut &SlotHandler] = copy [];

    // The behaviors grouped under the behavior, by name
    let dmut _behaviors: [[c8] => &Behavior] = copy [];

    // True once the slots of the methods tagged #[slot] are registered
    let mut _tagged: bool = false;

    /**
     * Create a behavior without slots
     * */
    pub self () {}

    /**
     * Register a slot without parameter, replacing the slot registered under the same path
     * @params:
     *    - path: the name of the slot, after the behaviors it is in (form::clear), those missing being created
     *    - slot: the function called by the signals connected to it
     * */
    pub fn slot(mut self, path: [c8], slot: dg ()-> void) {
        self:.register(path, copy SlotHandler!{()} (slot));
    }

    /**
     * Register a slot, replacing the slot registered under the same path
     * @params:
     *    - path: the name of the slot, after the behaviors it is in (form::submit), those missing being created
     *    - slot: the function called by the signals connected to it, with the arguments bound by the .gui file then
     *            the payload of the signal
     * */
    pub fn slot {T...} (mut self, path: [c8], slot: dg (T)-> void) {
        self:.register(path, copy SlotHandler!{T} (slot));
    }

    /**
     * Mount a behavior under a path, replacing the behavior mounted there and the slots it held, the slots of its
     * methods tagged #[slot] registered (registerTaggedSlots)
     * @params:
     *    - path: the name of the behavior, after the behaviors it is in, those missing being created
     * */
    pub fn behavior(mut self, path: [c8], dmut behavior: &Behavior) {
        behavior:.registerTaggedSlots();

        let segments = Behavior::split(path);
        let dmut parent = self:.parentOf(segments);
        parent._behaviors[segments[segments.len - 1us]] = alias behavior;
    }

    /**
     * Register the slots of the methods tagged #[slot] of the behavior classes the behavior is of, those of the classes
     * it is over first, a slot of a class replacing the one of the same name its parent class or the constructor
     * registered; done once, when the behavior is mounted (behavior) or a dialog opened, the behavior being built
     * @info: a constructor cannot do it, the behavior not being of its class yet while the constructor of Behavior runs
     * */
    pub fn registerTaggedSlots(mut self) {
        if self._tagged { return; }
        self._tagged = true;

        // the classes of the behavior, from its own up to Behavior
        let mut classes: [[c8]] = [];
        let mut info = self.__typeinfo__;
        loop {
            classes = classes ~ [info.name];
            if info.inner.len == 0us { break; }
            info = info.inner[0];
        }

        for j in 0us .. classes.len {
            if let Ok(register) = __BEHAVIOR_CLASSES__[classes[classes.len - 1us - j]] {
                register(alias self);
            }
        }
    }

    /**
     * @returns: the slot of a path, none when no slot is registered under it
     * */
    pub fn find(self, path: [c8])-> (&SlotHandler)? {
        let segments = Behavior::split(path);
        let mut current: &Behavior = self;
        for i in 0us .. segments.len - 1us {
            if let Ok(b) = current._behaviors[segments[i]] {
                current = b;
            } else {
                return none;
            }
        }

        if let Ok(s) = current._slots[segments[segments.len - 1us]] {
            return (s)?;
        }

        none
    }

    /**
     * Register a slot under a path
     * */
    fn register(mut self, path: [c8], handler: &SlotHandler) {
        let segments = Behavior::split(path);
        let dmut parent = self:.parentOf(segments);
        parent._slots[segments[segments.len - 1us]] = handler;
    }

    /**
     * @returns: the behavior holding the last segment of a path, the behaviors missing on the way being created
     * */
    fn parentOf(mut self, segments: [[c8]])-> dmut &Behavior {
        let dmut current = alias self;
        for i in 0us .. segments.len - 1us {
            if let Ok(dmut b) = alias current._behaviors[segments[i]] {
                current = alias b;
            } else {
                let dmut b = copy Behavior();
                current._behaviors[segments[i]] = alias b;
                current = alias b;
            }
        }

        alias current
    }
}

/**
 * The helpers of the behaviors
 * */
mod Behavior {

    /**
     * @returns: the segments of a path, separated by `::`
     * */
    pub fn split(path: [c8])-> [[c8]] {
        let mut result: [[c8]] = [];
        let mut start = 0us;
        let mut i = 0us;
        while i + 1us < path.len {
            if path[i] == ':' && path[i + 1us] == ':' {
                result ~= [path[start .. i]];
                i += 2us;
                start = i;
            } else {
                i += 1us;
            }
        }

        result ~ [path[start .. path.len]]
    }
}

/**
 * Register a behavior class, which the tag #[behavior] does at the start of the program, replacing the class
 * registered under the same name
 * @params:
 *    - name: the name of the class, as its type info gives it
 *    - register: registers the slots of the methods of the class tagged #[slot] on a behavior, when it is of the class
 * */
pub fn registerBehaviorClass(name: [c8], register: dg (dmut &Behavior)-> void) {
    __BEHAVIOR_CLASSES__[name] = register;
}
