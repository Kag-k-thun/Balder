in schema;

use balder::interface::{_, style, widget};
use balder::interface::loader::parser;

use std::traits;
use std::syntax::errors;

/**
 * An attribute a widget type takes in a .gui file, `max-length: 64;`, checked against its kind and set on the widget
 * */
@abstract
pub class Attribute {

    // The name of the attribute
    pub let name: [c8];

    prot self (name: [c8])
        with name = name
    {}

    /**
     * @returns: the kind of the values of the attribute, for the reference of the .gui files ("a string")
     * */
    pub fn kind(self)-> [c8];

    /**
     * Check that a value is of the kind of the attribute
     * @throws: at the value, when it is not
     * */
    pub fn check(self, v: &Value)
        throws SyntaxError;

    /**
     * Set the attribute of a widget
     * @params:
     *    - widget: the widget, of the type that registered the attribute
     *    - v: the value of the attribute, of its kind
     * */
    pub fn apply(self, dmut widget: &Widget, v: &Value)
        throws SyntaxError;
}

/**
 * An attribute whose value decodes to a T (decode), set on a widget W by a setter: `Setter!{&InputText, usize}`
 * */
@final
pub class Setter {W, T} over Attribute {

    let _set: dg (dmut W, T)-> void;

    /**
     * @params:
     *    - set: the setter, called with the widget and the decoded value
     * */
    pub self (name: [c8], set: dg (dmut W, T)-> void)
        with super(name)
        , _set = set
    {}

    pub over kind(self)-> [c8] {
        describe!{T} ()
    }

    pub over check(self, v: &Value)
        throws SyntaxError
    {
        decode!{T} (v);
    }

    pub over apply(self, dmut widget: &Widget, v: &Value)
        throws SyntaxError
    {
        let value = decode!{T} (v);
        if let dmut w: W = alias widget {
            self._set(alias w, value);
        }
    }
}

/**
 * An attribute a container gives its children, `tab: "Form";` under a TabLayout, set on the container for that child
 * */
@abstract
pub class SlotAttribute {

    // The name of the attribute
    pub let name: [c8];

    // True iif every child has to set it
    pub let required: bool;

    prot self (name: [c8], required: bool)
        with name = name
        , required = required
    {}

    /**
     * @returns: the kind of the values of the attribute, for the reference of the .gui files ("a string")
     * */
    pub fn kind(self)-> [c8];

    /**
     * Check that a value is of the kind of the attribute
     * @throws: at the value, when it is not
     * */
    pub fn check(self, v: &Value)
        throws SyntaxError;

    /**
     * Set the attribute of a child on its container
     * @params:
     *    - parent: the container, of the type that registered the attribute
     *    - child: the child, already inserted in the container
     *    - v: the value of the attribute, of its kind
     * */
    pub fn apply(self, dmut parent: &Widget, child: &Widget, v: &Value)
        throws SyntaxError;
}

/**
 * A slot attribute whose value decodes to a T (decode), set on a container W for one of its children
 * */
@final
pub class SlotSetter {W, T} over SlotAttribute {

    let _set: dg (dmut W, &Widget, T)-> void;

    /**
     * @params:
     *    - set: the setter, called with the container, the child and the decoded value
     *    - required: true iif every child has to set the attribute
     * */
    pub self (name: [c8], set: dg (dmut W, &Widget, T)-> void, required: bool = false)
        with super(name, required)
        , _set = set
    {}

    pub over kind(self)-> [c8] {
        describe!{T} ()
    }

    pub over check(self, v: &Value)
        throws SyntaxError
    {
        decode!{T} (v);
    }

    pub over apply(self, dmut parent: &Widget, child: &Widget, v: &Value)
        throws SyntaxError
    {
        let value = decode!{T} (v);
        if let dmut p: W = alias parent {
            self._set(alias p, child, value);
        }
    }
}

/**
 * The children a widget type accepts in a .gui file: any number, or a sequence of roles (its bar then its content)
 * */
@abstract
pub class Children {

    // The number of children the type needs
    pub let min: usize;

    // The number of children the type accepts
    pub let max: usize;

    // The role of each child, in order, empty for children that all have the same role
    pub let roles: [[c8]];

    /**
     * @params:
     *    - min: the number of children the type needs
     *    - roles: the role of each child, empty to accept any number of children
     * */
    prot self (min: usize, roles: [[c8]])
        with min = min
        , max = maxChildren(roles)
        , roles = roles
    {}

    /**
     * Insert a child in a widget
     * @params:
     *    - parent: the widget, of the type that registered the children
     *    - child: the child
     *    - index: the position of the child among the children of the node, its role
     * */
    pub fn insert(self, dmut parent: &Widget, dmut child: &Widget, index: usize);
}

/**
 * The children of a widget W, inserted by a function: `Inserter!{&LinearLayout}(|dmut l, dmut c, i| => …)`
 * */
@final
pub class Inserter {W} over Children {

    let _insert: dg (dmut W, dmut &Widget, usize)-> void;

    /**
     * @params:
     *    - insert: called with the widget, the child and its position among the children
     *    - min: the number of children the type needs
     *    - roles: the role of each child, empty to accept any number of children
     * */
    pub self (insert: dg (dmut W, dmut &Widget, usize)-> void, min: usize = 0us, roles: [[c8]] = [])
        with super(min, roles)
        , _insert = insert
    {}

    pub over insert(self, dmut parent: &Widget, dmut child: &Widget, index: usize) {
        if let dmut p: W = alias parent {
            self._insert(alias p, alias child, index);
        }
    }
}

/**
 * The description of a widget type in a .gui file: how to create it, its attributes, its default attribute, the
 * children it accepts, the attributes it gives its children, and its states, parts and properties for the style sheets
 * */
@final
pub class WidgetSchema {

    // The name of the type, written in the .gui files and selected in the style sheets
    pub let typeName: [c8];

    // The attributes of the type
    pub let attributes: [&Attribute];

    // The attribute set by the value after the selector of a node, "" when the type has none
    pub let defaultAttribute: [c8];

    // The children the type accepts, none when it takes none
    pub let children: (&Children)?;

    // The attributes the type gives its children
    pub let slots: [&SlotAttribute];

    // The states a style sheet selects the type in (:hover), by default those every widget can be in
    pub let states: [[c8]];

    // The parts of the type a style sheet selects (::label)
    pub let parts: [[c8]];

    // The states of the parts that have their own, by part (::tab:selected)
    pub let partStates: [[c8] => [[c8]]];

    // The style properties the type reads beyond the common ones
    pub let properties: [&Property];

    // The constructor of the widgets of the type, from their manager and their id
    let _create: dg (dmut &WidgetManager, [c8])-> dmut &Widget;

    /**
     * @params:
     *    - typeName: the name of the type
     *    - create: the constructor of the widgets of the type, from their manager and their id
     * */
    pub self (typeName: [c8],
              create: dg (dmut &WidgetManager, [c8])-> dmut &Widget,
              attributes: [&Attribute] = [],
              defaultAttribute: [c8] = "",
              children: (&Children)? = none,
              slots: [&SlotAttribute] = [],
              states: [[c8]] = copy ["hover", "focus", "check"],
              parts: [[c8]] = [],
              partStates: [[c8] => [[c8]]] = copy [],
              properties: [&Property] = [])
        with typeName = typeName
        , _create = create
        , attributes = attributes
        , defaultAttribute = defaultAttribute
        , children = children
        , slots = slots
        , states = states
        , parts = parts
        , partStates = partStates
        , properties = properties
    {}

    /**
     * @returns: a new widget of the type
     * */
    pub fn create(self, dmut manager: &WidgetManager, id: [c8])-> dmut &Widget {
        self._create(alias manager, id)
    }

    /**
     * @returns: the attribute of the type named name, none if it has none
     * */
    pub fn attribute(self, name: [c8])-> (&Attribute)? {
        for a in self.attributes {
            if a.name == name { return (a)?; }
        }

        none
    }

    /**
     * @returns: the attribute the type gives its children named name, none if it gives none
     * */
    pub fn slot(self, name: [c8])-> (&SlotAttribute)? {
        for s in self.slots {
            if s.name == name { return (s)?; }
        }

        none
    }

    /**
     * @returns: the states of a part of the type, empty for a part that has none of its own
     * */
    pub fn statesOf(self, part: [c8])-> [[c8]] {
        if let Ok(states) = self.partStates[part] {
            return states;
        }

        []
    }

    /**
     * @returns: the style property of the type named name, none if the type does not register it
     * */
    pub fn property(self, name: [c8])-> (&Property)? {
        for p in self.properties {
            if p.name == name { return (p)?; }
        }

        none
    }
}

/**
 * @returns: the content of a string
 * */
pub fn decode {T of [c8]} (v: &Value)-> [c8]
    throws SyntaxError
{
    v.toText()
}

/**
 * @returns: the boolean of the keyword true or false
 * */
pub fn decode {T of bool} (v: &Value)-> bool
    throws SyntaxError
{
    v.toBool()
}

/**
 * @returns: a positive integer, small enough for T
 * */
pub fn if isUnsigned!{T} decode {T} (v: &Value)-> T
    throws SyntaxError
{
    let i = v.toInteger();
    if i < 0i64 || cast!u64(i) > cast!u64(T::max) {
        throw v.expected(std::format::format("an integer from 0 to {}", T::max));
    }

    cast!T(i)
}

/**
 * @returns: the two positive integers of a tuple, `1280 720`
 * */
pub fn decode {T of (u32, u32)} (v: &Value)-> (u32, u32)
    throws SyntaxError
{
    let items = v.toTuple();
    if items.len != 2us {
        throw v.expected("two integers");
    }

    (decode!{u32} (items[0]), decode!{u32} (items[1]))
}

/**
 * @returns: the kind of the strings, for the reference
 * */
pub fn describe {T of [c8]} ()-> [c8] {
    "a string"
}

/**
 * @returns: the kind of the booleans, for the reference
 * */
pub fn describe {T of bool} ()-> [c8] {
    "true or false"
}

/**
 * @returns: the kind of the positive integers, for the reference
 * */
pub fn if isUnsigned!{T} describe {T} ()-> [c8] {
    "an integer of 0 or more"
}

/**
 * @returns: the kind of the pairs of positive integers, for the reference
 * */
pub fn describe {T of (u32, u32)} ()-> [c8] {
    "two integers of 0 or more"
}

/**
 * @returns: the number of children accepted by a type whose children have roles, any number when they have none
 * */
fn maxChildren(roles: [[c8]])-> usize {
    if roles.len == 0us { usize::max } else { roles.len }
}
