in definition;

use balder::interface::loader::parser;

/**
 * A component as a library holds it: its declaration and the file declaring it, the names its nodes use being looked
 * up in the scope of that file
 * */
@data
pub record Definition {

    // The declaration of the component
    pub let component: Component;

    // The path of the file declaring it
    pub let file: [c8];
}
