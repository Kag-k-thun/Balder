in widget_node;

use balder::interface::loader::registry::setting;

/**
 * A widget of the tree of a .gui file, its components expanded: the node of a widget type, or the root of an instance,
 * carrying the id and the classes of the instance (doc/gui-v2.md, §8)
 * @info:
 * =====
 * The instances are numbered in their tree. The root of an instance lists its number (several when the root of a
 * component is itself an instance), and a widget an instance put in a slot of its component names the instance as its
 * owner: it is found under the instance, whatever the container of the slot.
 * ====
 * */
@data
pub record WidgetNode {

    // The widget type
    pub let typeName: [c8];

    // The id of the widget, "" for an anonymous one
    pub let id: [c8] = "";

    // The classes of the widget, those of the root of a component then those of its instance
    pub let classes: [[c8]] = [];

    // The components whose instance the widget is, the innermost first
    pub let components: [[c8]] = [];

    // The default value, set to the default attribute of the type
    pub let value: (Setting)? = none;

    // The attributes of the widget, and those its parent gives it
    pub let attributes: [Setting] = [];

    // The children of the widget, the slots of a component filled
    pub let children: [WidgetNode] = [];

    // The numbers of the instances the widget is the root of
    pub let instances: [usize] = [];

    // The number of the instance that put the widget in a slot of its component, 0 when none did
    pub let owner: usize = 0us;

    // The file the widget is written in, the file of the instance for the root of a component
    pub let file: [c8] = "";

    // The line of the widget, from 1
    pub let line: usize = 0us;

    // The column of the widget, from 1
    pub let col: usize = 0us;
}
