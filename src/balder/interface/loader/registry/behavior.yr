in behavior;

use balder::interface::loader::registry::handler;

/**
 * The slots the code registers under names for the `on-…` attributes of the .gui files, and the behaviors grouping
 * other slots under a name (doc/gui-v2.md, §9)
 * @info:
 * =====
 * A name is a path of segments separated by `::`: `form::submit` is the slot `submit` of the behavior `form`. An
 * activity holds the root behavior; an application describes a group of slots by a class over Behavior, registering its
 * handlers in its constructor, and mounts it under a name:
 * ```
 * class FormBehavior over Behavior {
 *     pub self () {
 *         self:.slot ("submit", &self:.onSubmit);
 *     }
 *
 *     fn onSubmit (mut self, button: u8) { … }
 * }
 *
 * // in the activity, for `on-click: form::submit;`
 * self:.behavior ("form", copy FormBehavior ());
 * ```
 * ====
 * */
pub class Behavior {

    // The slots of the behavior, by name
    let mut _slots: [[c8] => mut &SlotHandler] = copy [];

    // The behaviors grouped under the behavior, by name
    let dmut _behaviors: [[c8] => &Behavior] = copy [];

    /**
     * Create a behavior without slots
     * */
    pub self () {}

    /**
     * Register a slot without parameter, replacing the slot registered under the same path
     * @params:
     *    - path: the name of the slot, after the behaviors it is in (form::clear), those missing being created
     *    - slot: the function called by the signals connected to it
     * */
    pub fn slot(mut self, path: [c8], slot: dg ()-> void) {
        self:.register(path, copy SlotHandler!{()} (slot));
    }

    /**
     * Register a slot, replacing the slot registered under the same path
     * @params:
     *    - path: the name of the slot, after the behaviors it is in (form::submit), those missing being created
     *    - slot: the function called by the signals connected to it, with the arguments bound by the .gui file then
     *            the payload of the signal
     * */
    pub fn slot {T...} (mut self, path: [c8], slot: dg (T)-> void) {
        self:.register(path, copy SlotHandler!{T} (slot));
    }

    /**
     * Mount a behavior under a path, replacing the behavior mounted there and the slots it held
     * @params:
     *    - path: the name of the behavior, after the behaviors it is in, those missing being created
     * */
    pub fn behavior(mut self, path: [c8], dmut behavior: &Behavior) {
        let segments = Behavior::split(path);
        let dmut parent = self:.parentOf(segments);
        parent._behaviors[segments[segments.len - 1us]] = alias behavior;
    }

    /**
     * @returns: the slot of a path, none when no slot is registered under it
     * */
    pub fn find(self, path: [c8])-> (&SlotHandler)? {
        let segments = Behavior::split(path);
        let mut current: &Behavior = self;
        for i in 0us .. segments.len - 1us {
            if let Ok(b) = current._behaviors[segments[i]] {
                current = b;
            } else {
                return none;
            }
        }

        if let Ok(s) = current._slots[segments[segments.len - 1us]] {
            return (s)?;
        }

        none
    }

    /**
     * Register a slot under a path
     * */
    fn register(mut self, path: [c8], handler: &SlotHandler) {
        let segments = Behavior::split(path);
        let dmut parent = self:.parentOf(segments);
        parent._slots[segments[segments.len - 1us]] = handler;
    }

    /**
     * @returns: the behavior holding the last segment of a path, the behaviors missing on the way being created
     * */
    fn parentOf(mut self, segments: [[c8]])-> dmut &Behavior {
        let dmut current = alias self;
        for i in 0us .. segments.len - 1us {
            if let Ok(dmut b) = alias current._behaviors[segments[i]] {
                current = alias b;
            } else {
                let dmut b = copy Behavior();
                current._behaviors[segments[i]] = alias b;
                current = alias b;
            }
        }

        alias current
    }
}

/**
 * The helpers of the behaviors
 * */
mod Behavior {

    /**
     * @returns: the segments of a path, separated by `::`
     * */
    pub fn split(path: [c8])-> [[c8]] {
        let mut result: [[c8]] = [];
        let mut start = 0us;
        let mut i = 0us;
        while i + 1us < path.len {
            if path[i] == ':' && path[i + 1us] == ':' {
                result ~= [path[start .. i]];
                i += 2us;
                start = i;
            } else {
                i += 1us;
            }
        }

        result ~ [path[start .. path.len]]
    }
}
