in checker;

use balder::interface::loader::registry::{error, schema, setting, widget_node};

use std::syntax::errors;

/**
 * Checker of a tree of widgets, its components expanded, against the schemas of the widget types, before any widget is
 * created
 * @info:
 * =====
 * A widget is refused when its type is unknown, when it sets an attribute that neither its type nor its parent gives
 * it, when a value is not of the kind of its attribute, when it lacks an attribute its parent requires, when its type
 * does not accept its children, and when its id makes it reachable by the same find path as another widget. The
 * anonymous widgets add no segment to the paths, and the widgets an instance put in the slots of its component are
 * reached under the instance. An error about a value given to a parameter of a component is reported where the value
 * was given.
 * ====
 * */
pub record Checker {

    // The schemas of the widget types, by name
    let _schemas: [[c8] => &WidgetSchema];

    // The location of the named widgets, by their find path
    let mut _paths: [[c8] => mut ([c8], usize, usize)] = copy [];

    // The find paths of the children of the instances, by the number of the instance
    let mut _inner: [usize => mut [[c8]]] = copy [];

    /**
     * @params:
     *    - schemas: the schemas of the widget types, by name
     * */
    pub self (schemas: [[c8] => &WidgetSchema])
        with _schemas = schemas
    {}

    /**
     * Check a tree of widgets
     * @params:
     *    - parent: the schema of the widget the root is inserted in, none for the root of the interface
     * @throws: at the first widget, attribute or value refused
     * */
    pub fn check(mut self, root: WidgetNode, parent: (&WidgetSchema)? = none)
        throws LoadError
    {
        self:.checkNode(root, parent, []);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          NODES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check a widget and its children
     * @params:
     *    - parent: the schema of the parent of the widget, none for the root
     *    - path: the find path of the parent of the widget
     * */
    fn checkNode(mut self, node: WidgetNode, parent: (&WidgetSchema)?, path: [[c8]])
        throws LoadError
    {
        let schema = if let Ok(s) = self._schemas[node.typeName] {
            s
        } else {
            throw copy LoadError(node.file, "unknown widget type '" ~ node.typeName ~ "'", node.line, node.col);
        };

        self.checkDefaultValue(node, schema);
        self.checkAttributes(node, schema, parent);

        let base = if node.owner != 0us {
            if let Ok(p) = self._inner[node.owner] { p } else { path }
        } else {
            path
        };

        let inner = self:.checkPath(node, base);
        for i in node.instances {
            self._inner[i] = inner;
        }

        self.checkChildren(node, schema);
        for c in node.children {
            self:.checkNode(c, (schema)?, inner);
        }
    }

    /**
     * Check the number of children of a widget against the children its type accepts
     * */
    fn checkChildren(self, node: WidgetNode, schema: &WidgetSchema)
        throws LoadError
    {
        let (min, max, roles) = if let Ok(c) = schema.children {
            (c.min, c.max, c.roles)
        } else {
            (0us, 0us, [])
        };

        let what = "'" ~ node.typeName ~ "' takes ";
        let children = node.children;
        if children.len > max {
            let excess = children[max];
            let accepted = if max == 0us {
                "no children"
            } else if roles.len != 0us {
                "only " ~ Checker::describe(roles)
            } else {
                "at most " ~ Checker::amount(max)
            };

            throw copy LoadError(excess.file, what ~ accepted, excess.line, excess.col);
        }

        if children.len < min {
            let needed = if roles.len != 0us {
                Checker::describe(roles)
            } else {
                "at least " ~ Checker::amount(min)
            };

            throw copy LoadError(node.file, std::format::format("{}{}, found {}", what, needed, children.len), node.line, node.col);
        }
    }

    /**
     * Register the find path of a named widget
     * @params:
     *    - path: the find path the widget is reached under
     * @returns: the find path of the children of the widget
     * @throws: when another widget is reachable by the same path
     * */
    fn checkPath(mut self, node: WidgetNode, path: [[c8]])-> [[c8]]
        throws LoadError
    {
        if node.id == "" {
            return path;
        }

        let inner = path ~ [node.id];
        let mut key = "";
        for i, segment in inner {
            key = if i == 0us { segment } else { key ~ "/" ~ segment };
        }

        if let Ok((file, line, col)) = self._paths[key] {
            let elsewhere = if file != node.file { " of '" ~ file ~ "'" } else { "" };
            let reason = std::format::format("'#{}' is reachable by the path '{}' of the widget at line {}, column {}{}",
                                             node.id, key, line, col, elsewhere);
            throw copy LoadError(node.file, reason, node.line, node.col);
        }

        self._paths[key] = (node.file, node.line, node.col);
        inner
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          ATTRIBUTES          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check the value after the selector of a widget against the default attribute of its type
     * */
    fn checkDefaultValue(self, node: WidgetNode, schema: &WidgetSchema)
        throws LoadError
    {
        let v = if let Ok(v) = node.value { v } else { return; };
        let attr = if let Ok(a) = schema.attribute(schema.defaultAttribute) {
            a
        } else {
            throw copy LoadError(v.file, "'" ~ v.typeName ~ "' takes no default value", v.line, v.col);
        };

        for a in node.attributes {
            if a.name == attr.name && !a.forParent {
                let reason = "attribute '" ~ a.name ~ "' of '" ~ a.typeName ~ "' set twice, by the default value and in the block";
                throw copy LoadError(a.file, reason, a.line, a.col);
            }
        }

        {
            attr.check(v.value);
        } catch {
            e: &SyntaxError => {
                throw Checker::valueError(v, "attribute '" ~ attr.name ~ "' of '" ~ v.typeName ~ "'", e);
            }
        }
    }

    /**
     * Check the attributes of a widget, against those of its type, then those its parent gives its children, an
     * attribute of an instance that is not a parameter of its component being one its parent gives it
     * @params:
     *    - parent: the schema of the parent of the widget, none for the root
     * */
    fn checkAttributes(self, node: WidgetNode, schema: &WidgetSchema, parent: (&WidgetSchema)?)
        throws LoadError
    {
        let under = if let Ok(p) = parent { " under '" ~ p.typeName ~ "'" } else { "" };
        for a in node.attributes {
            let what = "attribute '" ~ a.name ~ "' of '" ~ a.typeName ~ "'";
            let attr: (&Attribute)? = if a.forParent { none } else { schema.attribute(a.name) };
            let slot = Checker::slotOf(parent, a.name);
            if !attr.hasValue && !slot.hasValue {
                throw copy LoadError(a.file, "unknown " ~ what ~ under, a.line, a.col);
            }

            {
                if let Ok(at) = attr {
                    at.check(a.value);
                } else if let Ok(s) = slot {
                    s.check(a.value);
                }
            } catch {
                e: &SyntaxError => {
                    throw Checker::valueError(a, what ~ under, e);
                }
            }
        }

        if let Ok(p) = parent {
            for s in p.slots {
                if s.required && !Checker::sets(node, s.name) {
                    throw copy LoadError(node.file, "a child of '" ~ p.typeName ~ "' needs the attribute '" ~ s.name ~ "'",
                                         node.line, node.col);
                }
            }
        }
    }
}

/**
 * The helpers of the checker
 * */
mod Checker {

    /**
     * @returns: the attribute named name that a parent gives its children, none if it gives none
     * */
    pub fn slotOf(parent: (&WidgetSchema)?, name: [c8])-> (&SlotAttribute)? {
        if let Ok(p) = parent {
            return p.slot(name);
        }

        none
    }

    /**
     * @returns: the error of a value of an attribute that is not of its kind: where the value of the parameter it uses
     * was given, or at the value
     * @params:
     *    - what: the attribute, for the error
     *    - e: the error of the value
     * */
    pub fn valueError(a: Setting, what: [c8], e: &SyntaxError)-> &LoadError {
        if let Ok(b) = a.binding {
            let reason = "parameter '$" ~ b.param ~ "' of '" ~ b.component ~ "' for the " ~ what ~ ": " ~ e.msg;
            return copy LoadError(b.file, reason, b.line, b.col);
        }

        copy LoadError(a.file, what ~ ": " ~ e.msg, e.line, e.col)
    }

    /**
     * @returns: true iif a widget sets the attribute name
     * */
    pub fn sets(node: WidgetNode, name: [c8])-> bool {
        for a in node.attributes {
            if a.name == name { return true; }
        }

        false
    }

    /**
     * @returns: the description of a number of children, for an error: "1 child", "2 children"
     * */
    pub fn amount(n: usize)-> [c8] {
        if n == 1us { "1 child" } else { std::format::format("{} children", n) }
    }

    /**
     * @returns: the description of a sequence of roles, for an error: "its bar then its content"
     * */
    pub fn describe(roles: [[c8]])-> [c8] {
        let mut result = "";
        for i, role in roles {
            if i != 0us { result = result ~ " then "; }
            result = result ~ "its " ~ role;
        }

        result
    }
}
