in handler;

use balder::interface::loader::parser;
use balder::interface::loader::registry::{bound, connection, schema};

use std::syntax::errors;

use ::core::types::info;

/**
 * A slot the code registers under a name for the `on-…` attributes of the .gui files, with the types of its parameters
 * (doc/gui-v2.md, §9)
 * @info:
 * =====
 * An `on-…` attribute gives the slot its bound arguments, constants of the value grammar, then the signal gives it its
 * payload: a slot of a signal of payload P takes the bound arguments then a P, a slot of a signal without payload takes
 * only the bound arguments. The types of the parameters are recorded to check that at load.
 * ====
 * */
@abstract
pub class SlotHandler {

    // The types of the parameters of the slot
    pub let params: [TypeInfo];

    prot self (params: [TypeInfo])
        with params = params
    {}

    /**
     * Bind the slot to the arguments of an `on-…` attribute
     * @params:
     *    - args: the bound arguments, as many as the parameters for a signal without payload, one fewer otherwise
     * @returns: a `Connection!{()}` when the arguments are as many as the parameters, a `Connection!{P}` of the type P
     * of the last parameter otherwise
     * @throws: at the first argument that does not decode to the type of its parameter
     * */
    pub fn bind(self, args: [&Value])-> &Connection
        throws SyntaxError;

    /**
     * @returns: the types of the parameters, for the errors: `([c8], u8)`
     * */
    pub fn signature(self)-> [c8] {
        handler::signature(self.params)
    }
}

/**
 * A slot without parameter
 * */
@final
pub class SlotHandler {T of ()} over SlotHandler {

    let _slot: dg ()-> void;

    pub self (slot: dg ()-> void)
        with super([])
        , _slot = slot
    {}

    pub over bind(self, args: [&Value])-> &Connection {
        args;
        copy Connection!{()} (self._slot)
    }
}

/**
 * A slot of parameters T, those before the last being values of the .gui files (decode), the last being one too or the
 * payload of a signal of any type
 * */
@final
pub class SlotHandler {T...} over SlotHandler {

    let _slot: dg (T)-> void;

    pub self (slot: dg (T)-> void)
        with super(typesOf!{(T,)} ())
        , _slot = slot
    {}

    pub over bind(self, args: [&Value])-> &Connection
        throws SyntaxError
    {
        cte for i in 0 .. (T,)::arity {
            if i < args.len {
                check!{__pragma!field_type((T,), i)} (args[i]);
            }
        }

        let bound = copy Bound!{T} (self._slot, args);
        cte if (decodable!{__pragma!field_type((T,), (T,)::arity - 1)}) {
            if args.len == (T,)::arity {
                return copy Connection!{()} (&bound.fireParameters);
            }
        }

        copy Connection!{__pragma!field_type((T,), (T,)::arity - 1)} (&bound.fireParametersWithPayload)
    }
}

/**
 * @returns: a list of types between parentheses, for the errors: `([c8], u8)`
 * */
pub fn signature(types: [TypeInfo])-> [c8] {
    let mut result = "(";
    for i, t in types {
        result = (if i == 0us { result } else { result ~ ", " }) ~ t.name;
    }

    result ~ ")"
}

/**
 * Check that a bound argument decodes to the type of its parameter
 * @throws: at the argument, when it does not
 * */
fn if decodable!{X} check {X} (v: &Value)
    throws SyntaxError
{
    decode!{X} (v);
}

/**
 * Refuse a bound argument for a parameter that no value of the .gui files decodes to, given only by the payload of a
 * signal
 * @throws: at the argument, always
 * */
fn if !decodable!{X} check {X} (v: &Value)
    throws SyntaxError
{
    throw copy SyntaxError("'" ~ v.getSource() ~ "' cannot be bound to a parameter of type " ~ X::typeid ~ ", given only by the payload of a signal",
                           v.getLine(), v.getColumn());
}

/**
 * @returns: the types of the fields of a tuple type
 * */
fn typesOf {TT} ()-> [TypeInfo] {
    let mut result: [TypeInfo] = [];
    cte for i in 0 .. TT::arity {
        result ~= [(__pragma!field_type(TT, i))::typeinfo];
    }

    result
}
