in family;

use std::char;

/**
 * The slant of a face
 * */
pub enum FontStyle
| NORMAL  = 0u8
| ITALIC  = 1u8
| OBLIQUE = 2u8;

/**
 * The weight of a regular face, on the CSS scale from 100 (thin) to 900 (black)
 * */
pub def FONT_WEIGHT_NORMAL = 400u32;

/**
 * The weight of a bold face
 * */
pub def FONT_WEIGHT_BOLD = 700u32;

/**
 * The width of a normal face, on the OS/2 scale from 1 (ultra condensed) to 9 (ultra expanded)
 * */
pub def FONT_WIDTH_NORMAL = 5u32;

/**
 * A face of a font file, and the family it belongs to
 * */
@data
pub record FaceInfo {

    // The name of the family, as written by the font file or the registration
    pub let family: [c8];

    // The path to the font file, that may use the custom path qualifiers (res:/)
    pub let path: [c8];

    // The index of the face in the font file, a collection (.ttc) holding several faces
    pub let index: i64;

    // The weight of the face, from 100 to 900
    pub let weight: u32;

    // The slant of the face
    pub let style: FontStyle;

    // The width of the face, from 1 to 9
    pub let width: u32;
}

/**
 * The face a font request resolves to, and the styles it lacks that have to be synthesized
 * */
@data
pub record FaceMatch {

    // The face to draw with
    pub let face: FaceInfo;

    // True if a bold weight was requested from a face that is not bold
    pub let syntheticBold: bool;

    // True if an italic or oblique style was requested from an upright face
    pub let syntheticOblique: bool;
}

/**
 * The weight from which a face is bold, a lighter face being emboldened when a bold one is requested
 * */
def BOLD_THRESHOLD = 600u32;

/**
 * The words of a style name that suggest a weight, a compound word (extralight) coming before the word it contains (light)
 * */
enum WeightWords
| THIN        = ("thin", 100u32)
| HAIRLINE    = ("hairline", 100u32)
| EXTRALIGHT  = ("extralight", 200u32)
| EXTRA_LIGHT = ("extra light", 200u32)
| ULTRALIGHT  = ("ultralight", 200u32)
| ULTRA_LIGHT = ("ultra light", 200u32)
| SEMIBOLD    = ("semibold", 600u32)
| SEMI_BOLD   = ("semi bold", 600u32)
| DEMIBOLD    = ("demibold", 600u32)
| DEMI_BOLD   = ("demi bold", 600u32)
| EXTRABOLD   = ("extrabold", 800u32)
| EXTRA_BOLD  = ("extra bold", 800u32)
| ULTRABOLD   = ("ultrabold", 800u32)
| ULTRA_BOLD  = ("ultra bold", 800u32)
| BLACK       = ("black", 900u32)
| HEAVY       = ("heavy", 900u32)
| LIGHT       = ("light", 300u32)
| MEDIUM      = ("medium", 500u32)
| BOLD        = ("bold", 700u32);

/**
 * Find the face of a family that is the closest to a requested weight and style, following the font matching of CSS
 * (https://www.w3.org/TR/css-fonts-4/#font-style-matching):
 *    - the faces of normal width are preferred
 *    - then the faces of the requested style, an italic falling back to an oblique then to an upright face, an oblique
 *      to an italic then to an upright face, and an upright face to an oblique then to an italic
 *    - then the faces of the closest weight, a weight between 400 and 500 trying the heavier weights up to 500 first,
 *      then the lighter ones, a weight under 400 trying the lighter weights first, and a weight over 500 the heavier ones
 * @params:
 *    - faces: the faces of the family
 *    - weight: the requested weight
 *    - style: the requested style
 * @returns: the closest face, none if the family has no face
 * */
pub fn matchFace(faces: [FaceInfo], weight: u32, style: FontStyle)-> FaceMatch? {
    if faces.len == 0us { return none; }
    synthesize(closest(faces, weight, style), weight, style)?
}

/**
 * Find the faces of a family a grapheme is looked for in: the closest face to a requested weight and style, then the
 * regular face of the family if it is another one, synthesizing the requested weight and style
 * The faces of a family seldom have the same coverage, an oblique face lacking the scripts that have no slanted design
 * @returns: the faces, none if the family has no face
 * */
pub fn matchFaces(faces: [FaceInfo], weight: u32, style: FontStyle)-> [FaceMatch] {
    if faces.len == 0us { return []; }

    let best = closest(faces, weight, style);
    let regular = closest(faces, FONT_WEIGHT_NORMAL, FontStyle::NORMAL);
    if regular.path == best.path && regular.index == best.index {
        return copy [synthesize(best, weight, style)];
    }

    copy [synthesize(best, weight, style), synthesize(regular, weight, style)]
}

/**
 * @returns: the weight a style name suggests ("Bold", "SemiBold Italic", "Light"...), 400 if it names none
 * */
pub fn weightOfStyleName(name: [c8])-> u32 {
    let n = familyKey(name);
    cte for w in WeightWords::__members__ {
        if contains(n, w._0) { return w._1; }
    }

    FONT_WEIGHT_NORMAL
}

/**
 * @returns: true if a style name names an oblique face ("Oblique", "Bold Oblique"...)
 * */
pub fn isObliqueStyleName(name: [c8])-> bool {
    contains(familyKey(name), "oblique")
}

/**
 * @returns: the key a family is registered under, the families being matched without case
 * */
pub fn familyKey(name: [c8])-> [c8] {
    copy [toLower(c) for c in name]
}

/**
 * @returns: the face of a non empty family the closest to a weight and a style
 * */
fn closest(faces: [FaceInfo], weight: u32, style: FontStyle)-> FaceInfo {
    let mut best = faces[0];
    for f in faces[1us .. $] {
        if isCloser(f, best, weight, style) {
            best = f;
        }
    }

    best
}

/**
 * @returns: the match of a face, synthesizing the weight and the style it lacks
 * */
fn synthesize(face: FaceInfo, weight: u32, style: FontStyle)-> FaceMatch {
    FaceMatch(face,
              weight >= BOLD_THRESHOLD && face.weight < BOLD_THRESHOLD,
              style != FontStyle::NORMAL && face.style == FontStyle::NORMAL)
}

/**
 * @returns: true if 'a' is closer than 'b' to the requested weight and style
 * */
fn isCloser(a: FaceInfo, b: FaceInfo, weight: u32, style: FontStyle)-> bool {
    let wa = widthDistance(a.width), wb = widthDistance(b.width);
    if wa != wb { return wa < wb; }

    let sa = styleRank(style, a.style), sb = styleRank(style, b.style);
    if sa != sb { return sa < sb; }

    let (ga, da) = weightRank(weight, a.weight);
    let (gb, db) = weightRank(weight, b.weight);
    if ga != gb { return ga < gb; }

    da < db
}

/**
 * @returns: the distance of a width to the normal width
 * */
fn widthDistance(width: u32)-> u32 {
    if width > FONT_WIDTH_NORMAL { width - FONT_WIDTH_NORMAL } else { FONT_WIDTH_NORMAL - width }
}

/**
 * @returns: the rank of the style of a face for a requested style, the lowest being the preferred one
 * */
fn styleRank(requested: FontStyle, actual: FontStyle)-> u32 {
    if requested == actual { return 0u32; }
    match requested {
        FontStyle::ITALIC  => { if actual == FontStyle::OBLIQUE { 1u32 } else { 2u32 } }
        FontStyle::OBLIQUE => { if actual == FontStyle::ITALIC { 1u32 } else { 2u32 } }
        _                  => { if actual == FontStyle::OBLIQUE { 1u32 } else { 2u32 } }
    }
}

/**
 * @returns:
 *    - .0: the group of the weight of a face for a requested weight, the lowest being the preferred one
 *    - .1: the distance of the weight to the requested one inside its group
 * */
fn weightRank(requested: u32, actual: u32)-> (u32, u32) {
    let dist = if actual > requested { actual - requested } else { requested - actual };
    if requested >= 400u32 && requested <= 500u32 {
        if actual >= requested && actual <= 500u32 { return (0u32, dist); }
        if actual < requested { return (1u32, dist); }
        return (2u32, dist);
    }

    if requested < 400u32 {
        return if actual <= requested { (0u32, dist) } else { (1u32, dist) };
    }

    if actual >= requested { (0u32, dist) } else { (1u32, dist) }
}

/**
 * @returns: true if 'word' appears in 'text'
 * */
fn contains(text: [c8], word: [c8])-> bool {
    if word.len > text.len { return false; }
    for i in 0us .. text.len - word.len + 1us {
        if text[i .. i + word.len] == word { return true; }
    }

    false
}
