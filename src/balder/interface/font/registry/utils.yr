/**
 * The reading of the faces of the font files and of the font directories
 * */
in utils;

use balder::core::error;
use balder::interface::font::{face, family};
use balder::utils::log;

use std::char;
use std::fs::{iteration, path, sys};

/**
 * The extensions of the font files read from a directory
 * */
def FONT_EXTENSIONS = ["ttf", "otf", "ttc", "otc"];

/**
 * Read the faces of a font file
 * @params:
 *    - path: the path to the font file, that may use the custom path qualifiers (res:/)
 * @returns: the faces of the file, a collection holding several
 * */
pub fn describeFile(path: [c8])-> [FaceInfo]
    throws BalderError
{
    let full = balder::utils::path::projectPath(path);

    let dmut first = copy FontFace::open(full);
    let mut res = copy [first:.describe(path, 0i64)];
    let nb = first.getNbFaces();
    first:.dispose();

    for i in 1i64 .. nb {
        let dmut f = copy FontFace::open(full, index-> i);
        res ~= [f:.describe(path, i)];
        f:.dispose();
    }

    res
}

/**
 * Read the faces of the font files of a directory and of its sub directories, skipping the files that cannot be read
 * @params:
 *    - dir: the directory, that may use the custom path qualifiers (res:/)
 * @returns: the faces, none if the directory does not exist
 * */
pub fn readDirectory(dir: [c8])-> [FaceInfo] {
    let root = balder::utils::path::projectPath(dir);
    if !isDir(root) { return []; }

    let mut res: [FaceInfo] = [];
    {
        for entry in walkDir(root) {
            if entry.kind == FsEntryKind::DIR || !isFontFile(entry.path) || !isFile(entry.path) { continue; }

            let file = if dir == root.toStr() { entry.path.toStr() } else { dir ~ "/" ~ entry.path.removePrefix(root).toStr() };
            {
                res ~= describeFile(file);
            } catch {
                err => {
                    log::debug #("FontRegistry", "Skipping font file ", file, " : ", err);
                }
            }
        }
    } catch {
        err => {
            log::debug #("FontRegistry", "Failed to read font directory ", dir, " : ", err);
        }
    }

    res
}

/**
 * @returns: true if the extension of a path is the one of a font file
 * */
fn isFontFile(path: Path)-> bool {
    let ext = copy [toLower(c) for c in path.extension()];
    for e in FONT_EXTENSIONS {
        if ext == e { return true; }
    }

    false
}
