/**
 * The splitting of a line into the runs of its faces, and the placement of its carets
 * */
in utils;

use balder::core::error;
use balder::interface::font::grapheme;

use std::algorithm::comparison;

use ::harfbuzz::{buffer, common};

/**
 * Split a text into runs of consecutive graphemes drawn with the same face of a chain
 * @params:
 *    - chain: the faces the graphemes are drawn with
 *    - text: the text to split, in UTF-16 code units
 *    - stops: the grapheme boundaries of the text
 * @returns: the code unit each run starts at, the one it ends before, and the index of its face, in logical order
 * */
pub fn splitByFace(dmut chain: &FontChain, text: [c16], stops: [usize])-> [(usize, usize, u32)]
    throws BalderError
{
    let dmut runs: [(usize, usize, u32)] = [];
    for j in 1us .. stops.len {
        let start = stops[j - 1us], end = stops[j];

        let dmut codePoints: [c32] = [];
        let mut i                  = start;
        while i < end {
            let (cp, size) = codePointAt(text, i);
            codePoints ~= [cast!c32(cp)];
            i += size;
        }

        let f = chain:.findFace(codePoints);
        if runs.len != 0us && runs[$ - 1us]._2 == f {
            runs[$ - 1us] = (runs[$ - 1us]._0, end, f);
        } else {
            runs ~= [(start, end, f)];
        }
    }

    runs
}

/**
 * @returns: the direction of a line, guessed from its first strong character
 * */
pub fn guessDirection(text: [c16])-> hb_direction_t {
    let dmut buf = hb_buffer_create();
    {
        hb_buffer_add_utf16(alias buf, text.ptr, cast!i32(text.len), 0u32, cast!i32(text.len));
        hb_buffer_guess_segment_properties(alias buf);
        hb_buffer_get_direction(buf)
    } exit {
        hb_buffer_destroy(alias buf);
    }
}

/**
 * Place a caret before every code unit of a shaped text, on the edges of the clusters, a cluster holding several
 * graphemes (a ligature) being split evenly between them
 * @params:
 *    - glyphs: the shaped glyphs, in visual order
 *    - pens: the pen position of each glyph, without its offset
 *    - len: the number of code units of the text
 *    - stops: the grapheme boundaries of the text
 *    - backward: true if the text is shaped right to left, its first code unit being on the right
 * @returns: the position of the caret before each code unit, and after the last one
 * */
pub fn placeCarets(glyphs: [ShapedGlyph], pens: [f32], len: usize, stops: [usize], backward: bool)-> [f32] {
    // the edges of the clusters, by the code unit they start at
    let dmut lefts: [f32]    = [];
    let dmut rights: [f32]   = [];
    let dmut isStart: [bool] = [];
    let dmut isStop: [bool]  = [];
    for _ in 0us .. len {
        lefts ~= [f32::max];
        rights ~= [-f32::max];
        isStart ~= [false];
        isStop ~= [false];
    }

    for s in stops {
        if s < len { isStop[s] = true; }
    }

    for i, g in glyphs {
        let c = cast!usize(g.cluster);
        if c < len {
            isStart[c] = true;
            lefts[c] = min(lefts[c], pens[i]);
            rights[c] = max(rights[c], pens[i] + g.advance);
        }
    }

    let dmut carets: [f32] = [];
    let mut last           = 0.0f;
    let mut i              = 0us;
    while i < len {
        // the code units before the first cluster are given to it
        let mut cs = i;
        while cs < len && !isStart[cs] { cs += 1us; }
        if cs == len {
            carets ~= [last];
            i += 1us;
            continue;
        }

        let mut ce = cs + 1us;
        while ce < len && !isStart[ce] { ce += 1us; }

        let lead  = if backward { rights[cs] } else { lefts[cs] };
        let trail = if backward { lefts[cs] } else { rights[cs] };

        let mut parts = 1us;
        for j in cs + 1us .. ce {
            if isStop[j] { parts += 1us; }
        }

        let mut k = 0us;
        for j in i .. ce {
            if j > cs && isStop[j] { k += 1us; }
            carets ~= [lead + (trail - lead) * cast!f32(cast!u32(k)) / cast!f32(cast!u32(parts))];
        }

        last = trail;
        i = ce;
    }

    carets ~= [last];
    carets
}
