/**
 * The runs of a shaped line, their carets and their selection
 * */
in run;

use balder::interface::font::face;

use std::math;
use std::algorithm::comparison;

/**
 * A single line of text shaped with the faces of a chain at a pixel size
 * */
@data
pub record ShapedRun {

    // The glyphs of the run, in visual order
    pub let glyphs: [ShapedGlyph];

    // The advance of the whole run, in pixels
    pub let width: f32;

    // The vertical metrics of the primary face of the chain at the pixel size of the run
    pub let metrics: LineMetrics;

    // The height of the em square the run is shaped at
    pub let pixelSize: u32;

    // The position of a caret put before each code unit of the text, and after the last one, in pixels
    pub let carets: [f32];

    // The code units a caret can stand before, the grapheme boundaries, followed by the length of the text
    pub let stops: [usize];

    /**
     * @returns: the height of the line, from the top of the ascender to the bottom of the descender
     * */
    pub fn getHeight(self)-> f32 {
        self.metrics.ascender - self.metrics.descender
    }

    /**
     * @returns: the position of a caret put before the code unit 'index', after the text if 'index' is past its end
     * */
    pub fn caretAt(self, index: usize)-> f32 {
        self.carets[min(index, self.carets.len - 1us)]
    }

    /**
     * Measure a part of the text, without shaping it on its own
     * @params:
     *    - start: the grapheme boundary the part starts at
     *    - end: the grapheme boundary the part ends before
     * @returns: the distance between the carets of the two boundaries, in pixels, whatever the direction of the run
     * */
    pub fn measure(self, start: usize, end: usize)-> f32 {
        abs(self.caretAt(end) - self.caretAt(start))
    }

    /**
     * Find where a click put a caret
     * @params:
     *    - x: the position of the click, from the start of the run, in pixels
     * @returns: the grapheme boundary of the caret, the closest edge of the grapheme under 'x', or the closest boundary
     * when 'x' is outside the text
     * */
    pub fn hitTest(self, x: f32)-> usize {
        for j in 1us .. self.stops.len {
            let lead  = self.carets[self.stops[j - 1us]];
            let trail = self.carets[self.stops[j]];
            if x >= min(lead, trail) && x <= max(lead, trail) {
                return if abs(x - lead) <= abs(x - trail) { self.stops[j - 1us] } else { self.stops[j] };
            }
        }

        let mut best = 0us;
        let mut dist = f32::max;
        for s in self.stops {
            let d = abs(x - self.carets[s]);
            if d < dist {
                dist = d;
                best = s;
            }
        }

        best
    }

    /**
     * Compute the horizontal spans covered by the graphemes of a part of the text
     * @params:
     *    - start: the code unit the part starts at
     *    - end: the code unit the part ends before
     * @returns: the spans, from the start of the run in pixels, merged and sorted from left to right
     * */
    pub fn selectionSpans(self, start: usize, end: usize)-> [(f32, f32)] {
        let lo = min(start, end);
        let hi = max(start, end);

        let dmut spans: [(f32, f32)] = [];
        for j in 1us .. self.stops.len {
            if self.stops[j - 1us] >= lo && self.stops[j] <= hi {
                let lead  = self.carets[self.stops[j - 1us]];
                let trail = self.carets[self.stops[j]];
                spans ~= [(min(lead, trail), max(lead, trail))];
            }
        }

        mergeSpans(spans)
    }
}
