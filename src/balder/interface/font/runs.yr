/**
 * The cache of the shaped runs, so a text shaped again with the same font costs a lookup
 * */
in runs;

use balder::interface::font::shaper;

/**
 * Identity of a shaped run
 * */
@data
pub record RunKey {

    // The uniq id of the chain the run is shaped with
    pub let chain: u32;

    // The shaped text, in UTF-8
    pub let text: [c8];

    // The height of the em square in pixels
    pub let pixelSize: u32;

    // The OpenType features the run is shaped with
    pub let features: [[c8]];

    pub fn opEquals(self, o: RunKey)-> bool {
        self.chain == o.chain && self.pixelSize == o.pixelSize && self.text == o.text && self.features == o.features
    }

    impl Hashable;
}

/**
 * The runs shaped last, kept in two generations
 * A run is looked for in the current generation, then in the previous one, from where it is brought back to the current
 * one; the previous generation is dropped once the current one is full, so a run unused for a whole generation is
 * forgotten
 * */
@final
pub class RunCache {

    // The number of runs a generation holds
    let _capacity: usize;

    // The runs used since the start of the current generation
    let dmut _current: [RunKey => ShapedRun] = copy [];

    // The runs used during the previous generation only
    let dmut _previous: [RunKey => ShapedRun] = copy [];

    /**
     * @params:
     *    - capacity: the number of runs a generation holds, the cache holding at most twice as many
     * */
    pub self (capacity: usize = 512us)
        with _capacity = capacity
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of runs in the cache
     * */
    pub fn len(self)-> usize {
        self._current.len + self._previous.len
    }

    /**
     * @returns: true if the run 'key' is in the cache
     * */
    pub fn contains(self, key: RunKey)-> bool {
        key in self._current || key in self._previous
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find a run, and keep it for the current generation
     * @returns: the run, none if it is not in the cache
     * */
    pub fn find(mut self, key: RunKey)-> ShapedRun? {
        if let Ok(run) = self._current[key] {
            return run?;
        }

        if let Ok(run) = self._previous[key] {
            self._previous:.remove(key);
            self:.insert(key, run);
            return run?;
        }

        none
    }

    /**
     * Insert a run in the current generation, starting a new generation if it is full
     * @params:
     *    - key: the identity of the run, assumed not in the cache
     *    - run: the shaped run
     * */
    pub fn insert(mut self, key: RunKey, run: ShapedRun) {
        if self._current.len >= self._capacity {
            self._previous = alias self._current;
            self._current = copy [];
        }

        self._current[key] = run;
    }

    /**
     * Forget every run
     * */
    pub fn clear(mut self) {
        self._current = copy [];
        self._previous = copy [];
    }
}
