/**
 * The splitting of a line into the items HarfBuzz shapes at once, each of one face and one script
 * */
in itemizer;

use balder::core::error;
use balder::interface::font::grapheme;

use ::harfbuzz::{common, unicode};

/**
 * A part of a line shaped at once, its graphemes being drawn with one face and written in one script
 * */
@data
pub record TextItem {

    // The byte the item starts at
    pub let start: usize;

    // The byte the item ends before
    pub let end: usize;

    // The index of the face of the item in the chain
    pub let face: u32;

    // The script of the item, the common one when no grapheme of the line has a script of its own
    pub let script: hb_script_t;
}

/**
 * Split a line into items of consecutive graphemes drawn with the same face of a chain and written in the same script
 * @params:
 *    - chain: the faces the graphemes are drawn with
 *    - text: the line to split, in UTF-8
 *    - stops: the grapheme boundaries of the line
 * @returns: the items, in logical order
 * */
pub fn itemize(dmut chain: &FontChain, text: [c8], stops: [usize])-> [TextItem]
    throws BalderError
{
    let scripts = resolveScripts(text, stops);

    let dmut items: [TextItem] = [];
    for j in 1us .. stops.len {
        let start = stops[j - 1us], end = stops[j];

        let dmut codePoints: [c32] = [];
        let mut i                  = start;
        while i < end {
            let (cp, size) = codePointAt(text, i);
            codePoints ~= [cast!c32(cp)];
            i += size;
        }

        let face   = chain:.findFace(codePoints);
        let script = scripts[j - 1us];
        if items.len != 0us && items[$ - 1us].face == face && items[$ - 1us].script == script {
            items[$ - 1us] = TextItem(items[$ - 1us].start, end, face, script);
        } else {
            items ~= [TextItem(start, end, face, script)];
        }
    }

    items
}

/**
 * Give a script to each grapheme of a line (UAX #24), a grapheme of no script of its own (a space, a digit, a
 * punctuation, a mark without a base) taking the script of the grapheme before it, or of the first grapheme after it
 * that has one at the start of the line
 * @params:
 *    - text: the line, in UTF-8
 *    - stops: the grapheme boundaries of the line
 * @returns: the script of each grapheme, the common one for every grapheme of a line without any script
 * */
pub fn resolveScripts(text: [c8], stops: [usize])-> [hb_script_t] {
    let dmut res: [hb_script_t] = [];
    let mut last = hb_script_t::HB_SCRIPT_COMMON;
    let mut seen = false;
    for j in 1us .. stops.len {
        let script = hb_unicode_script(hb_unicode_funcs_get_default(), codePointAt(text, stops[j - 1us])._0);
        if script != hb_script_t::HB_SCRIPT_COMMON && script != hb_script_t::HB_SCRIPT_INHERITED && script != hb_script_t::HB_SCRIPT_UNKNOWN {
            if !seen {
                for k in 0us .. res.len {
                    res[k] = script;
                }

                seen = true;
            }

            last = script;
        }

        res ~= [last];
    }

    res
}
