in shaper;

mod ::glyph;
mod ::run;
mod ::utils;

use balder::core::error;
use balder::interface::font::{chain, face, grapheme, itemizer};

use std::{algorithm::_, math};

use ::harfbuzz::{buffer, common, fixed, glyphs, shape};

pub def ShapedGlyph : glyph::ShapedGlyph;
pub def ShapedRun : run::ShapedRun;

// The gap under which two spans of a selection are merged, in pixels
def SPAN_JOIN = 0.01f;

/**
 * Merge the spans that overlap or touch, the spans of the runs of a line becoming the rectangles of its selection
 * @params:
 *    - spans: the spans to merge, in any order
 * @returns: the merged spans, sorted from left to right
 * */
pub fn mergeSpans(spans: [(f32, f32)])-> [(f32, f32)] {
    let sorted = sort(copy spans, |a, b| => a._0 < b._0);

    let dmut res: [(f32, f32)] = [];
    for s in sorted {
        if res.len != 0us && s._0 <= res[$ - 1us]._1 + SPAN_JOIN {
            res[$ - 1us] = (res[$ - 1us]._0, max(res[$ - 1us]._1, s._1));
        } else {
            res ~= [s];
        }
    }

    res
}

/**
 * Shape a single line of text with HarfBuzz and a single face
 * @params:
 *    - face: the face the glyphs are taken from
 *    - text: the text to shape, in UTF-8
 *    - pixelSize: the height of the em square in pixels
 * @returns: the glyphs of the line, with their positions, every glyph being of the face 0
 * */
pub fn shapeLine(dmut face: &FontFace, text: [c8], pixelSize: u32)-> ShapedRun
    throws BalderError
{
    let dmut faces = copy [alias face];
    let dmut chain = copy FontChain::fromFaces(alias faces);
    shapeLine(alias chain, text, pixelSize)
}

/**
 * Shape a single line of text with HarfBuzz, each grapheme being drawn with the first face of the chain that has glyphs
 * for it
 * The line is split into items of one face and one script, each item being shaped in its script with the rest of the
 * line as context, the items being laid out in the direction of the line (guessed from its first strong character, a
 * line mixing directions being laid out in that single direction)
 * @params:
 *    - chain: the faces the glyphs are taken from
 *    - text: the text to shape, in UTF-8
 *    - pixelSize: the height of the em square in pixels
 * @returns: the glyphs of the line, with their positions, the line taking the metrics of the primary face
 * */
pub fn shapeLine(dmut chain: &FontChain, text: [c8], pixelSize: u32)-> ShapedRun
    throws BalderError
{
    let metrics = chain:.getPrimary():.getLineMetrics(pixelSize);
    if text.len == 0us {
        return ShapedRun([], 0.0f, metrics, pixelSize, copy [0.0f], copy [0us]);
    }

    let stops = boundaries(text);
    let items = itemize(alias chain, text, stops);
    let direction = utils::guessDirection(text);
    let backward = HB_DIRECTION_IS_BACKWARD(direction);

    let dmut result: [ShapedGlyph] = [];
    let dmut pens: [f32] = [];
    let mut pen = 0.0f;
    for k in 0us .. items.len {
        let item = items[if backward { items.len - 1us - k } else { k }];
        let faceIndex = item.face;
        let dmut font = chain:.getFace(faceIndex):.getHarfbuzzFont(pixelSize);
        let dmut buf = hb_buffer_create();

        let (infos, positions) = {
            hb_buffer_add_utf8(alias buf, text.ptr, cast!i32(text.len), cast!u32(item.start), cast!i32(item.end - item.start));
            hb_buffer_set_direction(alias buf, direction);
            hb_buffer_set_script(alias buf, item.script);
            hb_buffer_guess_segment_properties(alias buf);
            hb_shape(alias font, alias buf, null, 0u32);

            (getGlyphInfos(alias buf), getGlyphPositions(alias buf))
        } exit {
            hb_buffer_destroy(alias buf);
        };

        for i, info in infos {
            let p = positions[i];
            let advance = fromF26Dot6(p.x_advance);
            result ~= [ShapedGlyph(info.codepoint,
                                   faceIndex,
                                   info.cluster,
                                   pen + fromF26Dot6(p.x_offset),
                                   fromF26Dot6(p.y_offset),
                                   advance)];
            pens ~= [pen];
            pen += advance;
        }
    }

    ShapedRun(result, pen, metrics, pixelSize, utils::placeCarets(result, pens, text.len, stops, backward), stops)
}

/**
 * Split a pen position into the whole pixel and the subpixel offset a glyph is rasterised at
 * @params:
 *    - pen: the pen position in device pixels
 * @returns:
 *    - .0: the whole pixel the glyph is placed on
 *    - .1: the offset of the pen inside that pixel, in 1/SUBPIXEL_LEVELS of a pixel
 * */
pub fn quantizePen(pen: f32)-> (f32, u8) {
    let levels = cast!f32(cast!u32(SUBPIXEL_LEVELS));
    let mut whole = floor(pen);
    let mut sub = cast!u32(floor((pen - whole) * levels + 0.5f));
    if sub >= cast!u32(SUBPIXEL_LEVELS) {
        whole += 1.0f;
        sub = 0u32;
    }

    (whole, cast!u8(sub))
}
