in manager;

use balder::core::_;
use balder::interface::font::{chain, family, layout, registry, runs, shaper};

use std::algorithm::comparison;

/**
 * Font manager resolving the families requested by the styles into chains of faces, and shaping text with them, the
 * runs shaped last being kept so an unchanged text is not shaped again
 * */
@final
pub class FontManager {

    // The registry of the faces
    let dmut _registry: &FontRegistry;

    // The directories registered on first use
    let _fontDirs: [[c8]];

    // True once the font directories are registered
    let mut _dirsRead: bool = false;

    // The chains created so far, by families, weight and style
    let dmut _chains: [([[c8]], u32, FontStyle) => &FontChain] = copy [];

    // The version of the registry the chains were created at
    let mut _chainsVersion: u64 = 0;

    // The runs shaped last, by chain, text, pixel size and features
    let dmut _runs: &RunCache = copy RunCache();

    /**
     * Create a manager reading its fonts on first use
     * @params:
     *    - fontDirs: the directories whose fonts are registered, before any system font
     *    - systemDirs: the directories the system fonts are read from, when a family is not registered
     * */
    pub self (fontDirs: [[c8]] = copy [FontRegistry::RES_FONT_DIR], systemDirs: [[c8]] = FontRegistry::systemFontDirs())
        with _registry = copy FontRegistry(systemDirs-> systemDirs)
        , _fontDirs = fontDirs
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the registry of the faces, to register fonts or change the fallbacks
     * */
    pub fn getRegistry(mut self)-> dmut &FontRegistry {
        if !self._dirsRead {
            self._dirsRead = true;
            for d in self._fontDirs {
                self._registry:.registerDirectory(d);
            }
        }

        alias self._registry
    }

    /**
     * @returns: the height of the em square in device pixels of a font of size 'fontSize' drawn at 'pixelRatio'
     * */
    pub fn getPixelSize(self, fontSize: u32, pixelRatio: f32 = 1.0f)-> u32 {
        max(1u32, cast!u32(cast!f32(fontSize) * pixelRatio + 0.5f))
    }

    /**
     * Get the chain of faces of a list of families, shared by the texts requesting the same families, weight and style
     * @params:
     *    - families: the requested families, by order of preference (generic families such as sans-serif included)
     *    - weight: the requested weight, from 100 to 900
     *    - style: the requested style
     * @returns: the chain, resolving its faces on demand
     * */
    pub fn getChain(mut self, families: [[c8]], weight: u32 = FONT_WEIGHT_NORMAL, style: FontStyle = FontStyle::NORMAL)-> dmut &FontChain {
        let dmut registry = self:.getRegistry();
        if registry.getVersion() != self._chainsVersion {
            self._chains = copy [];
            self._chainsVersion = registry.getVersion();
        }

        let key = (families, weight, style);
        if let Ok(dmut c) = alias self._chains[key] {
            return alias c;
        }

        let dmut c = copy FontChain(alias registry, families, weight-> weight, style-> style);
        self._chains[key] = alias c;

        alias c
    }

    /**
     * Shape a single line of text, or take it from the runs shaped last
     * @params:
     *    - text: the text to shape, in UTF-8
     *    - chain: the faces the glyphs are taken from
     *    - fontSize: the size of the font
     *    - pixelRatio: the number of device pixels in a window unit, the glyphs being positioned in device pixels
     *    - features: the OpenType features to turn on or off ("kern=0", "-liga", "smcp")
     * @returns: the shaped run, in device pixels
     * */
    pub fn shape(mut self, text: [c8], dmut chain: &FontChain, fontSize: u32, pixelRatio: f32 = 1.0f, features: [[c8]] = [])-> ShapedRun
        throws BalderError
    {
        self:.shapeCached(text, alias chain, self.getPixelSize(fontSize, pixelRatio-> pixelRatio), features)
    }

    /**
     * Lay a text out in lines, broken at its line breaks and wrapped to a width, each line being shaped on its own, or
     * taken from the runs shaped last
     * @params:
     *    - text: the text to lay out, in UTF-8
     *    - chain: the faces the glyphs are taken from
     *    - fontSize: the size of the font
     *    - pixelRatio: the number of device pixels in a window unit, the glyphs being positioned in device pixels
     *    - maxWidth: the width the lines are wrapped to, in device pixels, f32::max to break them at the line breaks only
     *    - align: the part of its free space put on the left of a line, 0 aligning the lines to the left, 0.5 centering
     *             them, 1 aligning them to the right
     *    - features: the OpenType features to turn on or off ("kern=0", "-liga", "smcp")
     * @returns: the laid out text, in device pixels
     * */
    pub fn layout(mut self, text: [c8], dmut chain: &FontChain, fontSize: u32, pixelRatio: f32 = 1.0f, maxWidth: f32 = f32::max, align: f32 = 0.0f, features: [[c8]] = [])-> TextLayout
        throws BalderError
    {
        let pixelSize = self.getPixelSize(fontSize, pixelRatio-> pixelRatio);

        let dmut lines: [(ShapedRun, usize, usize)] = [];
        for p in splitParagraphs(text) {
            let (start, end, breaks) = p;
            let paragraph = text[start .. end];
            let run = self:.shapeCached(paragraph, alias chain, pixelSize, features);

            let ranges = wrapLine(paragraph, run, breaks, maxWidth);
            if ranges.len == 1us && ranges[0]._1 == paragraph.len {
                lines ~= [(run, start, end)];
            } else {
                for r in ranges {
                    let line = self:.shapeCached(text[start + r._0 .. start + r._1], alias chain, pixelSize, features);
                    lines ~= [(line, start + r._0, start + r._1)];
                }
            }
        }

        stackLines(lines, align)
    }

    /**
     * Measure the narrowest width a text can be wrapped to without cutting a word, the width of its widest word
     * @params:
     *    - text: the text to measure, in UTF-8
     *    - chain: the faces the glyphs are taken from
     *    - fontSize: the size of the font
     *    - pixelRatio: the number of device pixels in a window unit, the glyphs being positioned in device pixels
     *    - features: the OpenType features to turn on or off ("kern=0", "-liga", "smcp")
     * @returns: the width, in device pixels
     * */
    pub fn measureMinContent(mut self, text: [c8], dmut chain: &FontChain, fontSize: u32, pixelRatio: f32 = 1.0f, features: [[c8]] = [])-> f32
        throws BalderError
    {
        let pixelSize = self.getPixelSize(fontSize, pixelRatio-> pixelRatio);

        let mut width = 0.0f;
        for p in splitParagraphs(text) {
            let (start, end, breaks) = p;
            let paragraph = text[start .. end];
            let run = self:.shapeCached(paragraph, alias chain, pixelSize, features);

            width = max(width, minContentWidth(paragraph, run, breaks));
        }

        width
    }

    /**
     * Load (or reuse) the regular face of a font file, outside of any family
     * @params:
     *    - path: the path to the font file
     * @returns: the opened face
     * */
    pub fn loadFace(mut self, path: [c8])-> dmut &FontFace
        throws BalderError
    {
        self._registry:.openFile(path)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Shape a single line of text at a pixel size, or take it from the runs shaped last
     * */
    fn shapeCached(mut self, text: [c8], dmut chain: &FontChain, pixelSize: u32, features: [[c8]])-> ShapedRun
        throws BalderError
    {
        let key = RunKey(chain.getUniqId(), text, pixelSize, features);
        if let Ok(run) = self._runs:.find(key) {
            return run;
        }

        let run = shapeLine(alias chain, text, pixelSize, features-> features);
        self._runs:.insert(key, run);

        run
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._chains = copy [];
            self._runs:.clear();
            self._registry:.dispose();
        }
    }
}
