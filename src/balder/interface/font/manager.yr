in manager;

use balder::core::_;
use balder::interface::font::{face, shaper};

use std::algorithm::comparison;

/**
 * Font manager opening the faces of the font files, and shaping text with them
 * */
@final
pub class FontManager {

    // The faces opened so far, by font path
    let dmut _faces: [[c8] => &FontFace] = copy [];

    /**
     * Create a manager opening faces on first use
     * */
    pub self () {}

    __dtor(mut self) {
        self:.dispose();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the height of the em square in device pixels of a font of size 'fontSize' drawn at 'pixelRatio'
     * */
    pub fn getPixelSize(self, fontSize: u32, pixelRatio: f32 = 1.0f)-> u32 {
        max(1u32, cast!u32(cast!f32(fontSize) * pixelRatio + 0.5f))
    }

    /**
     * Shape a single line of text
     * @params:
     *    - text: the text to shape
     *    - fontPath: the path to the font file
     *    - fontSize: the size of the font
     *    - pixelRatio: the number of device pixels in a window unit, the glyphs being positioned in device pixels
     * @returns: the shaped run, in device pixels
     * */
    pub fn shape(mut self, text: [c16], fontPath: [c8], fontSize: u32, pixelRatio: f32 = 1.0f)-> ShapedRun
        throws BalderError
    {
        let dmut face = self:.loadFace(fontPath);
        shapeLine(alias face, text, self.getPixelSize(fontSize, pixelRatio-> pixelRatio))
    }

    /**
     * Load (or reuse) the face of a font file
     * @params:
     *    - path: the path to the font file
     * @returns: the opened face
     * */
    pub fn loadFace(mut self, path: [c8])-> dmut &FontFace
        throws BalderError
    {
        if let Ok(dmut f) = alias self._faces[path] {
            return alias f;
        }

        let dmut face = copy FontFace::open(balder::utils::path::projectPath(path));
        self._faces[path] = alias face;

        return alias face;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            for _, dmut f in alias self._faces {
                f:.dispose();
            }

            self._faces = copy [];
        }
    }
}
