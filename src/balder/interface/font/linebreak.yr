/**
 * The places a line of text can be broken at, a subset of the line breaking algorithm of UAX #14
 * Lines break after a line break character, after spaces and hyphens, and around ideographs, never inside a grapheme,
 * before a closing punctuation, after an opening one, or around a non breaking character
 * */
in linebreak;

use balder::interface::font::grapheme;

/**
 * The line breaking class of a grapheme, from its first code point, the subset of the Line_Break property of UAX #14
 * the rules below need
 * */
enum Class: u8
| AL = 0   // letters, and every grapheme of no other class, never broken from one another
| BK = 1   // line breaks (LF, CR, CR LF, NEL, VT, FF, LS, PS), the line must break after them
| SP = 2   // the space, a line breaks after a run of them
| ZW = 3   // zero width space, a line can break after it
| GL = 4   // non breaking characters (no break space, word joiner), a line never breaks around them
| CL = 5   // closing punctuations, exclamations and separators, a line never breaks before them
| OP = 6   // opening punctuations, a line never breaks after them
| HY = 7   // the hyphen minus, a line breaks after it unless a digit follows
| BA = 8   // tabs, dashes and the spaces other than the space, a line breaks after them
| ID = 9   // ideographs, kanas, Hangul syllables and emojis, a line breaks before and after them
| NU = 10; // digits

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ================================          OPPORTUNITIES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Find where a text can be broken into lines
 * @params:
 *    - text: the text, in UTF-8
 * @returns: each byte a line can start at, and true if the line before it must end there (it ends with a line break),
 * in increasing order, the start and the end of the text excluded
 * */
pub fn breakOpportunities(text: [c8])-> [(usize, bool)] {
    let stops = boundaries(text);

    let dmut res: [(usize, bool)] = [];
    if stops.len < 3us {
        return res;
    }

    let mut before = classOf(codePointAt(text, stops[0])._0);
    for j in 1us .. stops.len - 1us {
        let after = classOf(codePointAt(text, stops[j])._0);
        if before == Class::BK {
            res ~= [(stops[j], true)];
        } else if breaksBetween(before, after) {
            res ~= [(stops[j], false)];
        }

        before = after;
    }

    res
}

/**
 * Find the end of the visible part of a line, the white spaces and the line break hanging after it being left out
 * @params:
 *    - text: the text, in UTF-8
 *    - start: the byte the line starts at
 *    - end: the byte the line ends before
 * @returns: the byte the visible part of the line ends before, 'start' if the line is only white spaces
 * */
pub fn hangingEnd(text: [c8], start: usize, end: usize)-> usize {
    let mut i = end;
    while i > start {
        // the code point before 'i' starts at the last byte that is not a continuation byte
        let mut p = i - 1us;
        while p > start && (cast!u8(text[p]) & 0xC0u8) == 0x80u8 {
            p -= 1us;
        }

        if !isHanging(codePointAt(text, p)._0) {
            break;
        }

        i = p;
    }

    i
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          PROPERTIES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Tell if a line can break between two graphemes, the first one not being a line break
 * @params:
 *    - before: the class of the grapheme before the boundary
 *    - after: the class of the grapheme after the boundary
 * @returns: true if a line can start at the boundary
 * */
fn breaksBetween(before: Class, after: Class)-> bool {
    if after == Class::BK || after == Class::SP || after == Class::ZW { return false; }
    if before == Class::ZW { return true; }
    if before == Class::GL || after == Class::GL { return false; }
    if after == Class::CL { return false; }
    if before == Class::OP { return false; }
    if before == Class::SP { return true; }
    if after == Class::HY || after == Class::BA { return false; }
    if before == Class::HY { return after != Class::NU; }
    if before == Class::BA { return true; }

    before == Class::ID || after == Class::ID
}

/**
 * @returns: the line breaking class of the code point 'cp'
 * */
fn classOf(cp: u32)-> Class {
    if (cp >= 0x0Au32 && cp <= 0x0Du32) || cp == 0x85u32 || cp == 0x2028u32 || cp == 0x2029u32 { return Class::BK; }
    if cp == 0x20u32 { return Class::SP; }
    if cp == 0x200Bu32 { return Class::ZW; }

    if cp == 0xA0u32 || cp == 0x2007u32 || cp == 0x2011u32 || cp == 0x202Fu32 || cp == 0x2060u32 || cp == 0xFEFFu32 {
        return Class::GL;
    }

    if cp >= 0x30u32 && cp <= 0x39u32 { return Class::NU; }
    if cp == 0x2Du32 { return Class::HY; }

    if cp == 0x09u32 || (cp >= 0x2010u32 && cp <= 0x2014u32 && cp != 0x2011u32) || isWideSpace(cp) {
        return Class::BA;
    }

    match cp {
        0x29u32 | 0x5Du32 | 0x7Du32 | 0x21u32 | 0x3Fu32 | 0x2Cu32 | 0x2Eu32 | 0x3Au32 | 0x3Bu32 | 0x2Fu32 => { return Class::CL; }
        0x3001u32 | 0x3002u32 | 0x3009u32 | 0x300Bu32 | 0x300Du32 | 0x300Fu32 | 0x3011u32 | 0x3015u32 => { return Class::CL; }
        0xFF01u32 | 0xFF09u32 | 0xFF0Cu32 | 0xFF0Eu32 | 0xFF1Au32 | 0xFF1Bu32 | 0xFF1Fu32 | 0xFF3Du32 | 0xFF5Du32 => { return Class::CL; }
        0x28u32 | 0x5Bu32 | 0x7Bu32 => { return Class::OP; }
        0x3008u32 | 0x300Au32 | 0x300Cu32 | 0x300Eu32 | 0x3010u32 | 0x3014u32 | 0xFF08u32 | 0xFF3Bu32 | 0xFF5Bu32 => { return Class::OP; }
        _ => {}
    }

    if isIdeographic(cp) { return Class::ID; }

    Class::AL
}

/**
 * @returns: true if the code point 'cp' is a white space or a line break, hanging after the end of a line
 * */
fn isHanging(cp: u32)-> bool {
    (cp >= 0x09u32 && cp <= 0x0Du32) || cp == 0x20u32 || cp == 0x85u32 || cp == 0x2028u32 || cp == 0x2029u32 || isWideSpace(cp)
}

/**
 * @returns: true if the code point 'cp' is a breakable space other than the space (an em space, the ideographic space)
 * */
fn isWideSpace(cp: u32)-> bool {
    cp == 0x1680u32 || (cp >= 0x2000u32 && cp <= 0x200Au32 && cp != 0x2007u32) || cp == 0x205Fu32 || cp == 0x3000u32
}

/**
 * @returns: true if the code point 'cp' is an ideograph, a kana, a Hangul syllable or an emoji
 * */
fn isIdeographic(cp: u32)-> bool {
    (cp >= 0x2E80u32 && cp <= 0x2FFFu32)
        || (cp >= 0x3040u32 && cp <= 0x30FFu32)
        || (cp >= 0x3400u32 && cp <= 0x4DBFu32)
        || (cp >= 0x4E00u32 && cp <= 0x9FFFu32)
        || (cp >= 0xAC00u32 && cp <= 0xD7A3u32)
        || (cp >= 0xF900u32 && cp <= 0xFAFFu32)
        || (cp >= 0x1F000u32 && cp <= 0x1FAFFu32)
        || (cp >= 0x20000u32 && cp <= 0x3FFFDu32)
}
