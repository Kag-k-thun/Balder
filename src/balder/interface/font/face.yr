in face;

use balder::core::_;
use balder::interface::font::family;

use std::conv;
use std::fs::path;

use ::freetype::{fixed, freetype, ftimage, ftsynth, fttypes, tttables};

use ::harfbuzz::{common, font, ft};

/**
 * Number of horizontal positions a glyph is rasterised at inside a pixel
 * */
pub def SUBPIXEL_LEVELS = 4u8;

/**
 * The thickening of a synthetic bold glyph, in em
 * */
pub def SYNTHETIC_BOLD = 1.0f / 24.0f;

/**
 * The horizontal shift of a synthetic oblique glyph per unit of height, the 12 degrees slant of FreeType
 * */
pub def SYNTHETIC_SLANT = 0.2126f;

lazy dmut __FACE_UID__ = copy [0u32];
fn uniqFaceId()-> u32 {
  __FACE_UID__[0] += 1u32;
  __FACE_UID__[0]
}

/**
 * Coverage of a rasterised glyph, one byte per pixel, rows tightly packed
 * */
@data
pub record GlyphBitmap {

    pub let width: u32;
    pub let height: u32;

    // Offset from the pen position to the left of the bitmap
    pub let left: i32;

    // Offset from the baseline up to the top of the bitmap
    pub let top: i32;

    pub let pixels: [u8];
}

/**
 * Vertical metrics of a face at a pixel size, in pixels
 * */
@data
pub record LineMetrics {

    // Distance from the baseline up to the top of the line
    pub let ascender: f32;

    // Distance from the baseline down to the bottom of the line, negative below the baseline
    pub let descender: f32;

    // Distance between the baselines of two consecutive lines
    pub let height: f32;
}

/**
 * A font file opened with FreeType, rasterising glyphs at any pixel size
 * */
@final
pub class FontFace {

    // The freetype library owning the face
    let dmut _library: FT_Library = null;

    // The freetype face
    let dmut _face: FT_Face = null;

    // The uniq id of the face
    let _uid: u32;

    // The path of the font file
    let _path: Path;

    // The pixel size the face is currently set at
    let mut _pixelSize: u32 = 0;

    // The harfbuzz font shaping with the face, created on first use
    let dmut _hbFont: *hb_font_t = null;

    // True if the glyphs are emboldened, the face lacking the requested weight
    let _syntheticBold: bool;

    // True if the glyphs are slanted, the face lacking the requested style
    let _syntheticOblique: bool;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Open a face of a font file
     * @params:
     *    - path: the path to the font file
     *    - index: the index of the face in the file
     *    - syntheticBold: true to embolden the glyphs
     *    - syntheticOblique: true to slant the glyphs
     * */
    pub self open(path: Path, index: i64 = 0, syntheticBold: bool = false, syntheticOblique: bool = false)
        with _path = path
        , _uid = { uniqFaceId() }
        , _syntheticBold = syntheticBold
        , _syntheticOblique = syntheticOblique
        throws BalderError
    {
        if FT_Init_FreeType(alias &self._library) != 0 {
            throw copy BalderError("Failed to initialize FreeType");
        }

        if FT_New_Face(alias self._library, path.toStr().toStringZ(), index, alias &self._face) != 0 {
            self:.dispose();
            throw copy BalderError("Failed to open font face : " ~ path.toStr());
        }
    }

    __dtor(mut self) {
        self:.dispose();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the uniq id of the face, never shared by two faces of the program
     * */
    pub fn getUniqId(self)-> u32 {
        self._uid
    }

    @field
    pub fn path(self)-> Path {
        self._path
    }

    /**
     * @returns: true if the glyphs of the face are emboldened
     * */
    pub fn isSyntheticBold(self)-> bool {
        self._syntheticBold
    }

    /**
     * @returns: true if the glyphs of the face are slanted
     * */
    pub fn isSyntheticOblique(self)-> bool {
        self._syntheticOblique
    }

    /**
     * @returns: the glyph index of the code point 'c', 0 if the face has no glyph for it
     * */
    pub fn getGlyphIndex(mut self, c: c32)-> u32 {
        if self._face == null { return 0u32; }
        FT_Get_Char_Index(alias self._face, cast!u64(cast!u32(c)))
    }

    /**
     * @returns: true if the face has a glyph for the code point 'c'
     * */
    pub fn hasGlyph(mut self, c: c32)-> bool {
        self:.getGlyphIndex(c) != 0u32
    }

    /**
     * @returns: the number of faces in the font file of the face
     * */
    pub fn getNbFaces(self)-> i64 {
        if self._face == null { return 0i64; }
        unsafe { (*self._face).num_faces }
    }

    /**
     * Read the family, weight, style and width of the face from the font file
     * @params:
     *    - path: the path the face is registered with
     *    - index: the index of the face in its font file
     * @returns: the description of the face
     * */
    pub fn describe(mut self, path: [c8], index: i64)-> FaceInfo
        throws BalderError
    {
        if self._face == null {
            throw copy BalderError("Describing a disposed face");
        }

        let rec = unsafe { *self._face };
        let family = if rec.family_name != null { unsafe { fromStringZ(rec.family_name) } } else { self._path.file() };
        let styleName = if rec.style_name != null { unsafe { fromStringZ(rec.style_name) } } else { "" };

        let mut weight = weightOfStyleName(styleName);
        if (rec.style_flags & FT_STYLE_FLAG_BOLD) != 0i64 && weight < FONT_WEIGHT_BOLD {
            weight = FONT_WEIGHT_BOLD;
        }

        let mut oblique = isObliqueStyleName(styleName);
        let mut width = FONT_WIDTH_NORMAL;

        let os2 = FT_Get_Sfnt_Table(alias self._face, FT_Sfnt_Tag::FT_SFNT_OS2);
        if os2 != null {
            let table = unsafe { *cast!(*TT_OS2) (os2) };
            let w = cast!u32(table.usWeightClass);
            if w >= 1u32 && w < 10u32 { // some fonts use the old scale from 1 to 9
                weight = w * 100u32;
            } else if w >= 1u32 && w <= 1000u32 {
                weight = w;
            }

            let wd = cast!u32(table.usWidthClass);
            if wd >= 1u32 && wd <= 9u32 { width = wd; }

            if (table.fsSelection & TT_FS_SELECTION_OBLIQUE) != 0u16 { oblique = true; }
        }

        let style = if oblique {
            FontStyle::OBLIQUE
        } else if (rec.style_flags & FT_STYLE_FLAG_ITALIC) != 0i64 {
            FontStyle::ITALIC
        } else {
            FontStyle::NORMAL
        };

        FaceInfo(family, path, index, weight, style, width)
    }

    /**
     * @returns: the vertical metrics of the face at 'pixelSize'
     * */
    pub fn getLineMetrics(mut self, pixelSize: u32)-> LineMetrics
        throws BalderError
    {
        self:.setPixelSize(pixelSize);

        let metrics = unsafe { (*(*self._face).size).metrics };
        LineMetrics(cast!f32(metrics.ascender) / 64.0f,
                    cast!f32(metrics.descender) / 64.0f,
                    cast!f32(metrics.height) / 64.0f)
    }

    /**
     * @returns: the harfbuzz font of the face set at 'pixelSize', positions being in 26.6 fixed point
     * @warning: valid until the next change of pixel size, or the disposal of the face
     * */
    pub fn getHarfbuzzFont(mut self, pixelSize: u32)-> dmut *hb_font_t
        throws BalderError
    {
        self:.setPixelSize(pixelSize);
        if self._hbFont == null {
            self._hbFont = hb_ft_font_create(self._face);

            // the advances grow by the thickening, the outlines being emboldened to the right and the top
            if self._syntheticBold {
                hb_font_set_synthetic_bold(alias self._hbFont, SYNTHETIC_BOLD, SYNTHETIC_BOLD, 0);
            }

            if self._syntheticOblique {
                hb_font_set_synthetic_slant(alias self._hbFont, SYNTHETIC_SLANT);
            }
        }

        alias self._hbFont
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the height of the em square in pixels, used by the next rasterisations and shapings
     * */
    pub fn setPixelSize(mut self, pixelSize: u32)
        throws BalderError
    {
        if self._face == null {
            throw copy BalderError("Setting the pixel size of a disposed face");
        }

        if self._pixelSize != pixelSize {
            if FT_Set_Pixel_Sizes(alias self._face, 0u32, pixelSize) != 0 {
                throw copy BalderError(std::format::format("Failed to set pixel size {} of face {}", pixelSize, self._path));
            }

            self._pixelSize = pixelSize;
            if self._hbFont != null {
                hb_ft_font_changed(alias self._hbFont);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          RASTERISING          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Rasterise a glyph of the face, emboldened and slanted if the face synthesizes these styles
     * @params:
     *    - glyph: the index of the glyph in the face
     *    - pixelSize: the height of the em square in pixels
     *    - subpixel: the horizontal offset of the pen in 1/SUBPIXEL_LEVELS of a pixel
     * */
    pub fn rasterize(mut self, glyph: u32, pixelSize: u32, subpixel: u8)-> GlyphBitmap
        throws BalderError
    {
        if self._face == null {
            throw copy BalderError("Rasterising a glyph of a disposed face");
        }

        self:.setPixelSize(pixelSize);

        let dmut delta = FT_Vector();
        delta.x = (cast!i64(subpixel % SUBPIXEL_LEVELS) * 64i64) / cast!i64(SUBPIXEL_LEVELS);
        FT_Set_Transform(alias self._face, null, alias &delta);

        // an embedded bitmap can neither be emboldened nor slanted, the outline is used instead
        let synthetic = self._syntheticBold || self._syntheticOblique;
        let flags = if synthetic { FT_LOAD_NO_BITMAP | FT_LOAD_TARGET_NORMAL } else { FT_LOAD_TARGET_NORMAL };
        if FT_Load_Glyph(alias self._face, glyph, flags) != 0 {
            throw copy BalderError(std::format::format("Failed to rasterise glyph {} of face {}", glyph, self._path));
        }

        let dmut slot = unsafe { alias (*self._face).glyph };

        // the left and bottom borders stay in place, the glyph growing to the right and to the top
        if self._syntheticBold {
            FT_GlyphSlot_AdjustWeight(alias slot, toFixed(SYNTHETIC_BOLD), toFixed(SYNTHETIC_BOLD));
        }

        // the outline is sheared around the baseline
        if self._syntheticOblique {
            FT_GlyphSlot_Slant(alias slot, toFixed(SYNTHETIC_SLANT), 0i64);
        }

        let format = unsafe { (*slot).format };
        if format == FT_Glyph_Format::FT_GLYPH_FORMAT_OUTLINE {
            if FT_Render_Glyph(alias slot, FT_Render_Mode::FT_RENDER_MODE_NORMAL) != 0 {
                throw copy BalderError(std::format::format("Failed to rasterise glyph {} of face {}", glyph, self._path));
            }
        }

        let bitmap = unsafe { (*slot).bitmap };
        let left = unsafe { (*slot).bitmap_left };
        let top = unsafe { (*slot).bitmap_top };

        GlyphBitmap(bitmap.width, bitmap.rows, left, top, self.readBitmap(bitmap))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the coverage of a gray or mono bitmap, one byte per pixel
     * */
    fn readBitmap(self, bitmap: FT_Bitmap)-> [u8] {
        let dmut pixels = copy [0u8; bitmap.width * bitmap.rows];
        let mono = bitmap.pixel_mode == cast!u8(FT_Pixel_Mode::FT_PIXEL_MODE_MONO);

        // a negative pitch stores the rows bottom up
        let absPitch = if bitmap.pitch < 0 { -bitmap.pitch } else { bitmap.pitch };
        let pitch = cast!usize(absPitch);
        for row in 0u32 .. bitmap.rows {
            let memRow = if bitmap.pitch < 0 { bitmap.rows - 1u32 - row } else { row };
            let line = bitmap.buffer + (cast!usize(memRow) * pitch);
            for col in 0u32 .. bitmap.width {
                pixels[row * bitmap.width + col] = if mono {
                    let byte = unsafe { *(line + cast!usize(col / 8u32)) };
                    if (byte >> cast!u8(7u32 - (col % 8u32))) & 1u8 != 0u8 { 255u8 } else { 0u8 }
                } else {
                    unsafe { *(line + cast!usize(col)) }
                };
            }
        }

        pixels
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            if self._hbFont != null {
                hb_font_destroy(alias self._hbFont);
                self._hbFont = null;
            }

            if self._face != null {
                FT_Done_Face(alias self._face);
                self._face = null;
            }

            if self._library != null {
                FT_Done_FreeType(alias self._library);
                self._library = null;
            }
        }
    }
}
