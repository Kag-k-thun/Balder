in timer;

use std::time;

/**
 * The timer showing a tooltip once the cursor rested on its widget for a delay, counted by the ticks of the interface
 * @info:
 * =====
 * The cursor entering a widget that has a tooltip starts the timer, leaving it stops it, and a press of a button, the
 * wheel or a key cancels it. Once a tooltip is hidden by the cursor leaving its widget, the tooltip of the next widget
 * the cursor enters within the grace is shown at once, so that the cursor moving along a toolbar reads its buttons
 * one after the other; a cancelled timer waits for the delay again. The ticks only count: an idle interface stays idle
 * while the timer waits.
 * ====
 * */
pub record TooltipTimer {

    // How long the cursor rests on a widget before its tooltip is shown
    pub let mut delay : Duration;

    // How long after a tooltip is hidden the tooltip of another widget is shown at once
    pub let mut grace : Duration;

    // True while the cursor rests on a widget whose tooltip is not shown yet
    let mut _waiting : bool = false;

    // True while the tooltip is shown
    let mut _shown : bool = false;

    // The time the cursor rested on the widget so far
    let mut _elapsed : Duration = micros (0u64);

    // The time since the last tooltip was hidden, none once the grace is over or when the timer was cancelled
    let mut _sinceHidden : (Duration)? = none;

    /**
     * @params:
     *    - delay: how long the cursor rests on a widget before its tooltip is shown
     *    - grace: how long after a tooltip is hidden the tooltip of another widget is shown at once
     * */
    pub self (delay : Duration, grace : Duration)
        with delay = delay
        , grace = grace
    {}

    /**
     * Start waiting for the delay, the cursor entering a widget that has a tooltip; the tooltip is shown at the next
     * tick within the grace of the last one hidden
     * */
    pub fn start (mut self) {
        self:.stop ();
        self._waiting = true;
        self._elapsed = micros (0u64);
    }

    /**
     * Stop waiting, the cursor leaving the widget, the grace starting when its tooltip was shown
     * */
    pub fn stop (mut self) {
        if self._shown {
            self._sinceHidden = (micros (0u64))?;
        }

        self._waiting = false;
        self._shown = false;
    }

    /**
     * Stop waiting without grace, a press of a button, the wheel or a key telling the user acts on the widget
     * */
    pub fn cancel (mut self) {
        self._waiting = false;
        self._shown = false;
        self._sinceHidden = none;
    }

    /**
     * Count the time of a tick
     * @params:
     *    - delta: the time since the last tick
     * @returns: true iif the tooltip is to be shown now, the cursor having rested on its widget for the delay, or for
     * a tick within the grace
     * */
    pub fn tick (mut self, delta : Duration)-> bool {
        let mut show = false;
        if self._waiting {
            self._elapsed = self._elapsed + delta;
            if self._sinceHidden.hasValue || self._elapsed >= self.delay {
                self._waiting = false;
                self._shown = true;
                self._sinceHidden = none;
                show = true;
            }
        }

        if let Ok (since) = self._sinceHidden {
            let total = since + delta;
            self._sinceHidden = if total > self.grace { none } else { (total)? };
        }

        show
    }

    /**
     * @returns: true iif the cursor rests on a widget whose tooltip is not shown yet
     * */
    pub fn isWaiting (self)-> bool {
        self._waiting
    }

    /**
     * @returns: true iif the tooltip is shown
     * */
    pub fn isShown (self)-> bool {
        self._shown
    }
}

/**
 * The durations of the timers of the tooltips
 * */
pub mod TooltipTimer {

    /**
     * @returns: how long after a tooltip is hidden the tooltip of another widget is shown at once, half a second
     * */
    pub fn defaultGrace ()-> Duration {
        millis (500u64)
    }
}
