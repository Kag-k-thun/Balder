in tip;

use balder::core::dispose;
use balder::interface::loader::registry::schema;
use balder::interface::style::{kinds, property};
use balder::interface::widget::text::label;
use balder::math::vector;

use std::time;

use ::std::algorithm::comparison;

/**
 * A tooltip tells what a widget does: its text, the part `::label`, and the shortcut doing the same, the part
 * `::shortcut` on the right of the text, shown when one is set
 * @info:
 * =====
 * The manager shows the tooltip of the widget the cursor rests on in a layer of its own, over the content and the
 * overlays (see TooltipLayer); a Tooltip written in a .gui file is laid out by its parent, as any widget. The rules
 * selecting `Tooltip` give its look, its width bounded by its max-width, its text wrapped when its style says so; the
 * shortcut is never wrapped, and is set apart from the text by its margin. The property `delay` of the rules is how
 * long the cursor rests on a widget before the manager shows its tooltip.
 * ====
 * */
pub class Tooltip over Widget {

    // The text of the tooltip
    let dmut _label : &Label;

    // The shortcut, on the right of the text
    let dmut _shortcut : &Label;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager : &WidgetManager, id : [c8])
        with super (alias manager, id, "Tooltip")
        , _label = copy Label (alias manager, "")
        , _shortcut = copy Label (alias manager, "")
    {
        self._label:.setOwnerPart ("label");
        self._shortcut:.setOwnerPart ("shortcut");
        self._shortcut:.forceNoWrap (true);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the text and the shortcut of the tooltip, laid out again only when they changed
     * @params:
     *    - text: the text of the tooltip
     *    - shortcut: the shortcut shown on the right of the text, "" for none
     * */
    pub fn setText (mut self, text : [c8], shortcut : [c8] = "") {
        if self._label.getText () == text && self._shortcut.getText () == shortcut { return; }

        self._label:.setText (text);
        self._shortcut:.setText (shortcut);
        if shortcut == "" {
            self._shortcut:.hide ();
        } else if self.isDrawn () {
            self._shortcut:.show ();
        }

        self:.relayout ();
    }

    /**
     * @returns: the text of the tooltip
     * */
    pub fn getText (self)-> [c8] {
        self._label.getText ()
    }

    /**
     * @returns: the shortcut shown on the right of the text, "" for none
     * */
    pub fn getShortcut (self)-> [c8] {
        self._shortcut.getText ()
    }

    /**
     * @returns: how long the cursor rests on a widget before its tooltip is shown, the delay of the style, half a
     * second when it sets none
     * */
    pub fn getDelay (self)-> Duration {
        if let Ok (d) = self.getStyle ().getCustom!{Duration} ("delay") {
            return d;
        }

        Tooltip::defaultDelay ()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STYLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot over onApplyStyle (mut self) {
        self._label:.setStyle (self.getStyle ().getSubStyle ("label"));
        self._shortcut:.setStyle (self.getStyle ().getSubStyle ("shortcut"));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The text on the left, the shortcut against the right side at the width of its content
     * */
    over onUpdateSize (mut self) {
        let shortcut = self:.measureShortcut ();
        let labelSize = makeVec2 (max (0.0f, self._absoluteSize.x - shortcut), self._absoluteSize.y);
        self._label:.setSize (self._absolutePosition, labelSize, self._depth + 1, self._absoluteSize);

        if shortcut > 0.0f {
            let at = makeVec2 (self._absolutePosition.x + labelSize.x, self._absolutePosition.y);
            self._shortcut:.setSize (at, makeVec2 (shortcut, self._absoluteSize.y), self._depth + 1, self._absoluteSize);
        }

        self:.onUpdateScissors ();
    }

    over onUpdateScissors (mut self) {
        let (sciPos, sciSize) = self.getScissors (self._absolutePosition, self._absoluteSize);
        self._label:.setScissors (sciPos, sciSize);
        self._shortcut:.setScissors (sciPos, sciSize);
    }

    /**
     * @returns: the depth of the texts, drawn over the background of the tooltip
     * */
    pub over getMaxDepth (self)-> u32 {
        max (self._label.getMaxDepth (), self._shortcut.getMaxDepth ())
    }

    /**
     * The content of a tooltip is its text followed by its shortcut, which is never wrapped
     * */
    prot over measureContentWidths (mut self)-> (f32, f32) {
        let shortcut = self:.measureShortcut ();
        let (minWidth, maxWidth) = self._label:.measureIntrinsicWidths ();
        (minWidth + shortcut, maxWidth + shortcut)
    }

    prot over measureContentHeights (mut self, width : f32)-> (f32, f32) {
        let shortcut = self:.measureShortcut ();
        let labelSpace = makeVec2 (max (0.0f, width - shortcut), INDEFINITE_SIZE);
        let labelWidth = self._label:.measureWidth (labelSpace, stretch-> true);
        let (minHeight, maxHeight) = self._label:.measureIntrinsicHeights (labelWidth);
        if shortcut == 0.0f { return (minHeight, maxHeight); }

        let container = makeVec2 (shortcut, INDEFINITE_SIZE);
        let shortcutWidth = self._shortcut:.measureWidth (container, stretch-> true);
        let (minShortcut, maxShortcut) = self._shortcut:.measureIntrinsicHeights (shortcutWidth);
        (max (minHeight, minShortcut), max (maxHeight, maxShortcut))
    }

    /**
     * @returns: the width of the margin box of the shortcut, its text on one line, 0 without shortcut
     * */
    fn measureShortcut (mut self)-> f32 {
        if self._shortcut.getText () == "" { return 0.0f; }

        let (_, width) = self._shortcut:.measureIntrinsicWidths ();
        width
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach (mut self, parent : (&Widget)?) {
        self.__super__:.onAttach (parent);
        self._label:.onAttach ((self)?);
        self._shortcut:.onAttach ((self)?);
    }

    over onHide (mut self) {
        self._label:.hide ();
        self._shortcut:.hide ();
    }

    over onShow (mut self) {
        self._label:.show ();
        if self._shortcut.getText () != "" {
            self._shortcut:.show ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self._label:.dispose ();
            self._shortcut:.dispose ();
            self.__super__:.dispose ();
        }
    }
}

/**
 * The tooltips in a .gui file and in the style sheets
 * */
pub mod Tooltip {

    /**
     * @returns: the schema of the tooltips, their text being their default attribute
     * */
    pub fn schema ()-> &WidgetSchema {
        copy WidgetSchema ("Tooltip",
                           |dmut m, id|-> dmut &Widget => copy Tooltip (alias m, id),
                           attributes-> copy [copy Setter!{&Tooltip, [c8]} ("text", |dmut t, s| => { t:.setText (s, shortcut-> t.getShortcut ()); }),
                                              copy Setter!{&Tooltip, [c8]} ("shortcut", |dmut t, s| => { t:.setText (t.getText (), shortcut-> s); })],
                           defaultAttribute-> "text",
                           parts-> copy ["label", "shortcut"],
                           properties-> copy [Tooltip::delay ()])
    }

    /**
     * @returns: the property of how long the cursor rests on a widget before its tooltip is shown (delay: 500ms)
     * */
    pub fn delay ()-> &WidgetProperty!{Duration} {
        copy WidgetProperty!{Duration} ("delay", Kind::DURATION, &?kinds::duration)
    }

    /**
     * @returns: the delay of the tooltips whose style sets none, half a second
     * */
    pub fn defaultDelay ()-> Duration {
        millis (500u64)
    }
}
