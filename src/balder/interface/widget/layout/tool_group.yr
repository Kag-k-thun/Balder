in tool_group;

use balder::interface::loader::registry::schema;
use balder::interface::widget::button::icon;
use balder::interface::widget::layout::linear;

/**
 * A tool group is a segmented row of icon buttons joined by a seam: its gap (1
 * pixel) shows its background between them, its first and last buttons in the
 * states `:first` and `:last`, so that the sheets round its outer corners only
 *
 * @info: the checkable buttons of a group are exclusive by their `group`, as
 * the modes of the gizmo or the snapping steps are
 *
 * */
pub class ToolGroup over LinearLayout {

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "ToolGroup")
    {}

    /**
     * Insert a button in the group, the ends of the group marked again
     * */
    pub over insertChild(mut self, dmut ch: &Widget, level: u32 = 0) {
        self.__super__:.insertChild(alias ch, level-> level);
        self:.markEnds();
    }

    /**
     * Put the first and the last icon buttons of the group in the states :first
     * and :last, the others in neither
     *
     * */
    fn markEnds(mut self) {
        let dmut children = alias self:.getChildren();
        let n = children.len;
        for i, dmut c in alias children {
            if let dmut b: &IconButton = alias c {
                let (first, last) = ToolGroup::endsOf(i, n);
                b:.setSegment(first-> first, last-> last);
            }
        }
    }
}


/**
 * The tool groups in a .gui file
 * */
pub mod ToolGroup {

    /**
     * @returns: the schema of the tool groups, taking any number of buttons
     *
     * */
    #[widgetSchema]
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("ToolGroup",
            |dmut m, id|-> dmut &Widget => copy ToolGroup(alias m, id),
                          children-> (copy Inserter!{&ToolGroup}(|dmut g, dmut c, i| => {
                              g:.insertChild(alias c, level-> cast!u32(i));
                          }))?,
                          properties-> copy [Layout::direction(), LinearLayout::gap()])
    }

    /**
     * @returns: whether the child at an index is the first, and the last, of n
     * children
     *
     * */
    pub fn endsOf(index: usize, n: usize)-> (bool, bool) {
        (index == 0us, index + 1us == n)
    }
}
