in tab;

use balder::utils;
use balder::core::dispose;
use balder::interface::_;
use balder::interface::loader::registry::schema;
use balder::interface::widget::text::label;
use balder::math::vector;

use std::{io, math};

use ::sdl3::{events, mouse};

use ::std::algorithm::comparison;

record Tab {

    // The bacground shape of the tabs
    pub let dmut shape: (&Shape)?  = none;
    pub let dmut border: (&Shape)? = none;

    pub let dmut label: (&Label)? = none;

    pub let mut head: [c8];

    // The content to display when tab is selected
    pub let dmut widget: &Widget;

    // Position of the tab content
    pub let dmut relPos: vec2;
    pub let dmut relSize: vec2;

    pub self (dmut widget: &Widget, head: [c8], relPos: vec2 = vec2(), relSize: vec2 = vec2())
        with widget = alias widget
        , head = head
        , relPos = relPos
        , relSize = relSize
    {}
}

pub class TabLayout over Layout {

    prot { // Tabs and layout

        // The list of tabs
        let dmut _tabs: [Tab] = [];

        // The selected layout
        let dmut _layout: (Tab)? = none;

        // The selected tab index
        let dmut _selectedIndex: usize = 0;

        // The relative size of a tab header
        let mut _tabRelSize: vec2 = vec2();

        // The relative distance from the start of a tab header to the start of the next one, a gap between them
        let mut _tabRelStep: f32 = 0.0f;

        // The relative size of a tab header
        let mut _tabInnerRelSize: vec2 = vec2();

        // The size of the border
        let mut _borderRelSize: vec2 = vec2();
    }

    prot { // mouse events

        // True if the selected layout is the last widget being hovered
        let dmut _lastHoverLayout: bool = false;

        // The index of the tab being hovered (>= self._tabs.len if none)
        let dmut _hoverIndex: usize = usize::max;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "TabLayout")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the layout, the content of every tab and the labels of the headers
     * */
    pub over getChildren(mut self)-> dmut [&Widget] {
        let dmut res: [&Widget] = [];
        for dmut t in alias self._tabs {
            res ~= [alias t.widget];
            if let Ok(dmut lbl) = alias t.label {
                res ~= [alias lbl];
            }
        }

        alias res
    }

    /**
     * The contents of all the tabs are attached, those of the tabs not selected being hidden
     * */
    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self:.hideUnselected();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT CHILDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a new tab in the layout
     * @params:
     *    - head: the name displayed as a label in the header tab
     *    - ch: the widget displayed when tab is selected
     * */
    pub fn insertTab(mut self, head: [c8], dmut ch: &Widget) {
        self._tabs ~= [Tab(alias ch, head, relPos-> makeVec2(0.0f, 0.0f), relSize-> makeVec2(0.0f, 0.0f))];
        if !self._layout.hasValue {
            self._layout = (alias self._tabs[0])?;
            self._selectedIndex = (self._tabs.len - 1);
        }

        if self._attached {
            ch:.onAttach((self)?);
            if self._selectedIndex != self._tabs.len - 1 {
                ch:.hide();
            }
        }

        self:.insertHeader(head, self._selectedIndex == (self._tabs.len - 1));
        self._manager:.updateWidgets();
    }

    /**
     * Change the title of the tab of a child
     * @params:
     *    - ch: the widget displayed when the tab is selected
     *    - head: the name displayed as a label in the header tab
     * */
    pub fn setTabTitle(mut self, ch: &Widget, head: [c8]) {
        for j in 0us .. self._tabs.len {
            if self._tabs[j].widget is ch {
                self._tabs[j].head = head;
                if let Ok(dmut lbl) = alias self._tabs[j].label {
                    lbl:.setText(head);
                }
            }
        }

        self._manager:.updateWidgets();
    }

    fn insertHeader(mut self, head: [c8], selected: bool) {
        let dmut newLbl = copy Label(alias self._manager, "");
        newLbl:.setOwnerPart("tab");
        newLbl:.setText(head);

        self._tabs[$ - 1].label = (alias newLbl)?;

        let dmut shDr = self._manager:.getShapeDrawer();
        {
            let dmut shape = shDr:.registerColorQuad();
            let tabStyle = self:.getTabStyle(selected, false);
            shape:.setColor(tabStyle.getColor(WidgetShapeKind::BACKGROUND));

            let dmut border = shDr:.registerColorQuad();
            border:.setColor(tabStyle.getColor(WidgetShapeKind::BORDER));

            self._tabs[$ - 1].shape = (alias shape)?;
            self._tabs[$ - 1].border = (alias border)?;
        } catch {
            err => {
                log::error #("TabLayout", "Failed to construct shapes : ", err);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        let minSize   = self._absoluteSize.y / cast!f32(cast!u32(self._tabs.len));
        let tabWidth  = std::algorithm::comparison::min(minSize, 100.0f);
        let tabHeight = 40.0f;

        let wpos  = makeVec2(self._absolutePosition.x, self._absolutePosition.y + tabHeight);
        let wsize = makeVec2(self._absoluteSize.x, self._absoluteSize.y - tabHeight);

        if !self._layout.hasValue && self._tabs.len != 0 {
            self._layout = (alias self._tabs[0])?;
        }

        if let Ok(dmut w) = alias self._layout {
            let (relPos, relSize) = self:.placeChild(alias w.widget, wpos, wsize, self._depth + 3);
            w.relPos = relPos;
            w.relSize = relSize;

            self._layout = (alias w)?;
        }

        // the headers, the gaps between them and the border on each of their sides are whole device pixels, so that
        // every header, gap and side is drawn as wide as the others
        let ratio  = self._manager:.getShapeDrawer().getPixelRatio();
        let width  = cast!f32(self._currentStyle.getSubStyle("tab").borderWidth._1);
        let border = if width > 0.0f { std::algorithm::comparison::max(1.0f, round(width * ratio)) / ratio } else { 0.0f };
        let gap    = std::algorithm::comparison::max(1.0f, round(ratio)) / ratio;
        let tab    = makeVec2(round(tabWidth * ratio) / ratio, round(tabHeight * ratio) / ratio);

        self._tabRelSize = tab / self._absoluteSize;
        self._tabRelStep = (tab.x + gap) / self._absoluteSize.x;
        self._tabInnerRelSize = makeVec2(tab.x - 2.0f * border, tab.y - 2.0f * border) / self._absoluteSize;
        self._borderRelSize = makeVec2(border, border) / self._absoluteSize;

        self:.onUpdateScissors()
    }

    /**
     * The content of a tab fills the layout under the headers, whatever its style
     * */
    prot over fixesSizeOf(self, _: &Widget, row: bool)-> bool {
        self.isSizeFixed(row)
    }

    over onUpdateScissors(mut self) {
        if let Ok(dmut w) = alias self._layout {
            self:.clipChild(alias w.widget, w.relPos, w.relSize);
        }
    }

    over onHide(mut self) {
        self.__super__:.onHide();
        for dmut t in alias self._tabs {
            if let Ok(dmut s) = alias t.shape {
                s:.hide();
            }
        }
    }

    /**
     * Show the headers and the content of the selected tab only
     * */
    over onShow(mut self) {
        for dmut t in alias self._tabs {
            if let Ok(dmut s) = alias t.shape {
                s:.show();
            }

            if let Ok(dmut lbl) = alias t.label {
                lbl:.show();
            }
        }

        if let Ok(dmut w) = alias self._layout {
            w.widget:.show();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over getMaxDepth(self)-> u32 {
        let mut max = self._depth;
        if let Ok(w) = self._layout {
            let i = w.widget.getMaxDepth();
            if max < i { max = i; }
        }

        max + 3
    }

    pub over find(mut self, names: [[c8]])-> dmut (&Widget)? {
        for dmut w in alias self._tabs {
            if let Ok(dmut found) = alias w.widget:.resolve(names) {
                return (alias found)?;
            }
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover(mut self, pos: vec2)-> dmut (&Widget)? {
        if let Ok(index) = self.mouseOnTab(pos) {
            self._hoverIndex = index;
            self:.onApplyStyle();

            if self._lastHoverLayout {
                if let Ok(dmut w) = alias self._layout {
                    w.widget:.onLoseHoverFocus();
                }

                self._lastHoverLayout = false;
            }

            return (alias self)?;
        } else if let Ok((dmut w, relPos)) = alias self:.mouseOnLayout(pos) {
            self._lastHoverLayout = true;

            if self._hoverIndex != self._tabs.len {
                self._hoverIndex = self._tabs.len;
                self:.onApplyStyle();
            }

            return w:.onHover(relPos);
        }

        self:.onLoseHoverFocus();

        none
    }

    pub over onLoseHoverFocus(mut self) {
        if self._lastHoverLayout {
            if let Ok(dmut w) = alias self._layout {
                w.widget:.onLoseHoverFocus();
            }

            self._lastHoverLayout = false;
        }

        if self._hoverIndex != self._tabs.len {
            self._hoverIndex = self._tabs.len;
            self:.onApplyStyle();
        }
    }

    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if let Ok(index) = self.mouseOnTab(pos) {
            self:.selectTab(index);

            return (alias self)?;
        } else if let Ok((dmut w, relPos)) = alias self:.mouseOnLayout(pos) {
            return w:.onClick(relPos, button);
        }

        none
    }

    pub over onDoubleClick(mut self, pos: vec2)-> dmut (&Widget)? {
        if let Ok(_) = self.mouseOnTab(pos) {
            return self:.onClick(pos, SDL_BUTTON_LEFT);
        } else if let Ok((dmut w, relPos)) = alias self:.mouseOnLayout(pos) {
            return w:.onDoubleClick(relPos);
        }

        none
    }

    pub over onScroll(mut self, pos: vec2, amountX: i32, amountY: i32)-> bool {
        if let Ok((dmut w, relPos)) = alias self:.mouseOnLayout(pos) {
            return w:.onScroll(relPos, amountX, amountY);
        }

        false
    }

    /**
     * Select a tab, the content of the tab left being hidden (and kept as it is) and the one of the tab selected shown
     * */
    fn selectTab(mut self, index: usize) {
        if let Ok(dmut l) = alias self._layout {
            l.widget:.onLoseHoverFocus();
            l.widget:.hide();
        }

        let r = if index != self._tabs.len {
            index
        } else { 0 };

        self._layout = (alias self._tabs[r])?;
        self._selectedIndex = r;
        self._lastHoverLayout = false;
        self._tabs[r].widget:.show();

        self._manager:.updateWidgets();
    }

    /**
     * Hide the contents of the tabs not selected
     * */
    fn hideUnselected(mut self) {
        for i, dmut t in alias self._tabs {
            if i != self._selectedIndex {
                t.widget:.hide();
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STYLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onApplyStyle(mut self) {
        let defaultTab     = self:.getTabStyle(false, false);
        let hoverTab       = self:.getTabStyle(false, true);
        let selectTab      = self:.getTabStyle(true, false);
        let selectHoverTab = self:.getTabStyle(true, true);

        // each header starts on a device pixel, the following ones a whole number of device pixels further
        let ratio = self._manager:.getShapeDrawer().getPixelRatio();
        let mut relPos = vec2();
        for i, dmut t in alias self._tabs {
            let start = relPos * self._absoluteSize + self._absolutePosition;
            let spos  = makeVec2(round(start.x * ratio) / ratio, round(start.y * ratio) / ratio);
            let ssize = self._tabRelSize * self._absoluteSize;
            let bsize = self._tabInnerRelSize * self._absoluteSize;
            let bpos  = spos + (self._borderRelSize * self._absoluteSize);

            let (sciPos, sciEnd) = self.getScissors(spos, ssize);

            if let Ok(dmut sh) = alias t.shape {
                let (bsciPos, bsciEnd) = self.getScissors(bpos, bsize);

                sh:.setPosition(bpos);
                sh:.setSize(bsize);
                sh:.setScissors(bsciPos, bsciEnd);

                if i == self._selectedIndex && i == self._hoverIndex {
                    sh:.setColor(selectHoverTab.getColor(WidgetShapeKind::BACKGROUND));
                } else if i == self._selectedIndex {
                    sh:.setColor(selectTab.getColor(WidgetShapeKind::BACKGROUND));
                } else if i == self._hoverIndex {
                    sh:.setColor(hoverTab.getColor(WidgetShapeKind::BACKGROUND));
                } else {
                    sh:.setColor(defaultTab.getColor(WidgetShapeKind::BACKGROUND));
                }

                sh:.setLevel(self._depth + 1);
            }

            if let Ok(dmut sh) = alias t.border {
                sh:.setPosition(spos);
                sh:.setSize(ssize);
                sh:.setScissors(sciPos, sciEnd);

                if i == self._selectedIndex && i == self._hoverIndex {
                    sh:.setColor(selectHoverTab.getColor(WidgetShapeKind::BORDER));
                } else if i == self._selectedIndex {
                    sh:.setColor(selectTab.getColor(WidgetShapeKind::BORDER));
                } else if i == self._hoverIndex {
                    sh:.setColor(hoverTab.getColor(WidgetShapeKind::BORDER));
                } else {
                    sh:.setColor(defaultTab.getColor(WidgetShapeKind::BORDER));
                }

                sh:.setLevel(self._depth);
            }

            if let Ok(dmut lbl) = alias t.label {
                lbl:.setSize(spos, ssize, self._depth + 2);
                lbl:.setScissors(sciPos, sciEnd);

                if i == self._selectedIndex && i == self._hoverIndex {
                    lbl:.setStyle(selectHoverTab);
                } else if i == self._selectedIndex {
                    lbl:.setStyle(selectTab);
                } else if i == self._hoverIndex {
                    lbl:.setStyle(hoverTab);
                } else {
                    lbl:.setStyle(defaultTab);
                }
            }

            relPos.x += self._tabRelStep;
        }

        if let Ok(dmut w) = alias self._layout {
            w.widget:.onApplyStyle();
        }
    }

    /**
     * @returns: the style of a tab in its states, the style of the part ::tab of the layout, :selected and :hover
     * */
    fn getTabStyle(mut self, selected: bool, hover: bool)-> &Style {
        if !selected && !hover {
            return self._currentStyle.getSubStyle("tab");
        }

        let mut states: [[c8]] = [];
        if selected { states ~= ["selected"]; }
        if hover { states ~= ["hover"]; }

        let path = self.getStylePath();
        self._manager:.getStyleManager().computePart(path, self._currentStyle, "tab", states-> states)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._attached = false;

            for dmut i in alias self._tabs {
                i.widget:.dispose();
                if let Ok(dmut l) = alias i.label {
                    l:.dispose();
                    i.label = none;
                }

                if let Ok(dmut sh) = alias i.shape {
                    sh:.dispose();
                    i.shape = none;
                }

                if let Ok(dmut sh) = alias i.border {
                    sh:.dispose();
                    i.border = none;
                }
            }

            self._layout = none;
            self._super_:.dispose();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn mouseOnTab(self, pos: vec2)-> usize? {
        let mut relPos = vec2();
        if let Ok(inPaddingPos) = self.isInPadding(pos) {
            for i in 0 .. self._tabs.len {
                let a = relPos;
                let b = self._tabRelSize + a;

                if let Ok(_) = self.isInSquare(inPaddingPos, a, b) {
                    return (i)?;
                }

                relPos.x += self._tabRelStep;
            }
        }

        none
    }

    fn mouseOnLayout(mut self, pos: vec2)-> dmut (&Widget, vec2)? {
        if let Ok(inPaddingPos) = self.isInPadding(pos) {
            if let Ok(dmut w) = alias self._layout {
                if let Ok(relPos) = self.isInSquare(inPaddingPos, w.relPos, w.relPos + w.relSize) {
                    if let Ok(_) = w.widget.isInBorder(relPos) {
                        return (alias w.widget, relPos)?;
                    }
                }
            }
        }

        none
    }
}

/**
 * The tab layouts in a .gui file
 * */
pub mod TabLayout {

    /**
     * @returns: the schema of the tab layouts, each child being a tab that names its title with tab: "…"
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("TabLayout",
                          |dmut m, id|-> dmut &Widget => copy TabLayout(alias m, id),
                          children-> (copy Inserter!{&TabLayout}(|dmut t, dmut c, _| => { t:.insertTab("", alias c); },
                                                                  min-> 1us))?,
                          slots-> copy [copy SlotSetter!{&TabLayout, [c8]}("tab", |dmut t, c, h| => { t:.setTabTitle(c, h); },
                                                                            required-> true)],
                          parts-> copy ["tab"],
                          partStates-> copy ["tab" => copy ["hover", "selected"]])
    }
}
