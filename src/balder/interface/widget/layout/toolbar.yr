in toolbar;

use balder::interface::loader::registry::schema;
use balder::interface::widget::layout::linear;

/**
 * A toolbar is a row of tools: icon buttons, menu buttons, separators and
 * segmented groups (ToolGroup), set apart by its gap
 *
 * @info: a linear layout of its own type, so that the sheets select `ToolBar`;
 * it lays its tools out in the direction of its style, a column for the rails
 * of the docks
 *
 * */
pub class ToolBar over LinearLayout {

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "ToolBar")
    {}
}


/**
 * The toolbars in a .gui file
 * */
pub mod ToolBar {

    /**
     * @returns: the schema of the toolbars, taking any number of tools
     * */
    #[widgetSchema]
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("ToolBar",
            |dmut m, id|-> dmut &Widget => copy ToolBar(alias m, id),
                          children-> (copy Inserter!{&ToolBar}(|dmut t, dmut c, i| => {
                              t:.insertChild(alias c, level-> cast!u32(i));
                          }))?,
                          properties-> copy [Layout::direction(), LinearLayout::gap()])
    }
}
