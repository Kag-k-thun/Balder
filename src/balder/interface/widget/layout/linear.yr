in linear;

use balder::utils;
use balder::core::dispose;
use balder::interface::_;
use balder::interface::loader;
use balder::interface::loader::registry::schema;
use balder::interface::style::{kinds, property};
use balder::interface::widget::alignement;
use balder::interface::widget::layout::flex;
use balder::math::vector;

use std::io;

use ::sdl3::mouse;

use ::std::algorithm::comparison;

// The thickness of the scrollbar when the style sets none, in pixels
def DEFAULT_SCROLLBAR_SIZE = 10u32;

// The speed of the wheel when the style sets none
def DEFAULT_SCROLL_SPEED = 2.0f;

record Child {
    pub let dmut widget: &Widget;
    pub let dmut relPos: vec2;
    pub let dmut relSize: vec2;
    pub let dmut level: u32;

    pub self (dmut widget: &Widget, relPos: vec2, relSize: vec2, level: u32)
        with widget = alias widget
        , relPos = relPos
        , relSize = relSize
        , level = level
    {}
}

/**
 * A layout of children side by side along the direction of its style, sized by their flex bases and factors
 * @info:
 * =====
 * The style reads `direction` (row or column), `overflow` (hidden or scroll) and `scroll-speed`. A layout that overflows
 * by scrolling keeps the bases of its children instead of shrinking them, and scrolls over them with the wheel or by
 * dragging its scrollbar, styled as its part `::scrollbar`.
 * ====
 * */
pub class LinearLayout over Layout {

    // The columns of the layout
    let dmut _childs: [Child] = [];

    // The current shifting (wheel)
    let mut _shift: f32 = 0.0f;

    // The relative size of the widget (may be greater than 1 if containes too much widgets to fit on screen°)
    let mut _relFullSize: f32 = 0.0f;

    prot { // scrolling, when the style overflows by scrolling

        // The shape displaying the scrollbar, registered when the layout first scrolls
        let dmut _scrollbarShape: (&Shape)? = none;

        // The part of the content the layout shows along its axis, 1 when it does not overflow
        let mut _scrollLen: f32 = 1.0f;

        // The part of the content scrolled over along the axis, from 0 to 1 - _scrollLen
        let mut _scrollShift: f32 = 0.0f;

        // The position and the size of the scrollbar relative to the inner box
        let mut _relScrollBarPos: vec2 = vec2();
        let mut _relScrollBarSize: vec2 = vec2();

        // The position of the cursor in the inner box, minus the scrolled part, when the scrollbar was grabbed
        let mut _slideStart: vec2 = vec2();

        // True iif the scrollbar is grabbed, the layout having the focus while it is dragged
        let mut _grabbed: bool = false;

        // True iif the cursor is over the scrollbar
        let mut _overBar: bool = false;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, WidgetKeys::LINEAR_LAYOUT)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the drawing size of the inner widgets, sized along the axis of the layout from their flex bases, growth and
     * shrink factors, and across it from their style (stretched to the layout when unset)
     */
    over onUpdateSize(mut self) {
        if self._childs.len == 0 {
            self._relFullSize = 0.0f;
            self:.updateScroll();
            return;
        }

        let (mainSize, crossSize) = if self.isRow() {
            (self._absoluteSize.x, self._absoluteSize.y)
        } else {
            (self._absoluteSize.y, self._absoluteSize.x)
        };

        let (mains, crosses) = self:.measureChildren(mainSize, crossSize);

        let mut current = 0.0f;
        for col in 0 .. self._childs.len {
            let relMain = mains[col] / mainSize;
            let (wpos, wsize) = if self.isRow() {
                (makeVec2(current + self._shift, 0.0f) * self._absoluteSize + self._absolutePosition,
                 makeVec2(mains[col], crosses[col]))
            } else {
                (makeVec2(0.0f, current + self._shift) * self._absoluteSize + self._absolutePosition,
                 makeVec2(crosses[col], mains[col]))
            };

            current += relMain;
            self._relFullSize = current;

            let (relPos, relSize) = self:.placeChild(alias self._childs[col].widget, wpos, wsize, self._depth + 1);
            self._childs[col].relPos = relPos;
            self._childs[col].relSize = relSize;
        }

        self:.updateScroll();
    }

    over onUpdateScissors(mut self) {
        for dmut i in alias self._childs {
            self:.clipChild(alias i.widget, i.relPos, i.relSize);
        }

        if let Ok(dmut s) = alias self._scrollbarShape {
            let (sciPos, sciSize) = self.getScissors(self._absolutePosition, self._absoluteSize);
            s:.setScissors(sciPos, sciSize);
        }
    }

    over onHide(mut self) {
        self.__super__:.onHide();
        if let Ok(dmut s) = alias self._scrollbarShape {
            s:.hide();
        }
    }

    over onShow(mut self) {
        self.__super__:.onShow();
        if let Ok(dmut s) = alias self._scrollbarShape && self.isOverflowing() {
            s:.show();
        }
    }

    prot over onApplyStyle(mut self) {
        if let Ok(dmut s) = alias self._scrollbarShape {
            s:.setColor(self.getStyle().getSubStyle("scrollbar").getColor(WidgetShapeKind::BACKGROUND));
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT CHILDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a child in the layout
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild(mut self, dmut ch: &Widget, level: u32 = 0) {
        self._childs ~= [Child(alias ch, makeVec2(0.0f, 0.0f), makeVec2(0.0f, 0.0f), level)];
        std::algorithm::sorting::sort(alias self._childs, |x, y| => { x.level < y.level });

        self._manager:.updateWidgets();
    }

    /**
     * @returns: the number of childs in the layout
     * */
    pub fn getNbChilds(self)-> u32 {
        cast!u32(self._childs.len)
    }

    /**
     * @returns: the size of a given child in the layout
     * @params:
     *   - index: the index of the child
     * */
    pub fn getChild(self, index: u32)-> &Widget {
        self._childs[index].widget
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SET/GET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Make the layout scroll up/down
     * */
    pub fn setShift(mut self, scroll: f32) {
        let oldShift = self._shift;

        for col in 0 .. self._childs.len {
            let mut wpos = self._childs[col].relPos; // * self._absoluteSize + self._absolutePosition;
            let wsize = self._childs[col].relSize * self._absoluteSize;

            if self.isRow() {
                wpos = makeVec2(wpos.x - oldShift + scroll, wpos.y);
            } else {
                wpos = makeVec2(wpos.x, wpos.y - oldShift + scroll);
            }

            self._childs[col].relPos = wpos;
            self._childs[col].widget:.setSize(wpos * self._absoluteSize + self._absolutePosition,
                                              wsize,
                                              self._depth + 1);
        }

        self._shift = scroll;
        self:.onUpdateScissors();
    }

    /**
     * The current shifting of the layout
     * */
    @field
    pub fn shift(self)-> f32 {
        self._shift
    }

    /**
     * @returns: true iif the children are laid out side by side, its style direction being a row, on top of each other
     * otherwise
     * */
    pub fn isRow(self)-> bool {
        Layout::directionOf(self.getStyle()) == Direction::ROW
    }

    /**
     * @returns: true iif the children keep their bases instead of shrinking when they overflow, the layout scrolling over
     * them, its style overflow being scroll
     * */
    pub fn isScrolled(self)-> bool {
        if let Ok(o) = self.getStyle().getCustom!{Overflow}("overflow") {
            return o == Overflow::SCROLL;
        }

        false
    }

    /**
     * @returns: true iif the layout scrolls over children that do not fit in it
     * */
    pub fn isOverflowing(self)-> bool {
        self.isScrolled() && self._scrollLen < 1.0f
    }

    pub over getMaxDepth(self)-> u32 {
        // the scrollbar is drawn over the children
        if self.isOverflowing() { self.getChildrenDepth() + 1 } else { self.getChildrenDepth() }
    }

    /**
     * @returns: the full length of the layout relative to the window, (i.e. width if vertical, height otherwise)
     * @info: this can be greater than 1, depending on the size of inner elements
     * */
    pub fn getFullLength(self)-> f32 {
        self._relFullSize
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the layout, in the order they are laid out
     * */
    pub over getChildren(mut self)-> dmut [&Widget] {
        return copy [alias c.widget for dmut c in alias self._childs];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover(mut self, pos: vec2)-> dmut (&Widget)? {
        if self.isOnScrollbar(pos) {
            if let Ok(dmut w) = alias self._lastHover {
                w:.onLoseHoverFocus();
                self._lastHover = none;
            }

            self._overBar = true;
            self:.setHover(true);
            self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_POINTER);
            return (alias self)?;
        }

        self:.leaveScrollbar();
        self.__super__:.onHover(pos)
    }

    pub over onLoseHoverFocus(mut self) {
        self:.leaveScrollbar();
        self.__super__:.onLoseHoverFocus();
    }

    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if self.isOnScrollbar(pos) {
            if button == SDL_BUTTON_LEFT {
                self._grabbed = true;
                self._slideStart = self.toInner(pos) - self._scrollShift;
            }

            return (alias self)?;
        }

        self._grabbed = false;
        self.__super__:.onClick(pos, button)
    }

    pub over onDoubleClick(mut self, pos: vec2)-> dmut (&Widget)? {
        if self.isOnScrollbar(pos) {
            return (alias self)?;
        }

        self.__super__:.onDoubleClick(pos)
    }

    /**
     * Drag the scrollbar grabbed by a click
     * */
    pub over onSliding(mut self, pos: vec2, _speed_: vec2, _: u8) {
        if self._grabbed && self.isOverflowing() {
            let amount = self.toInner(pos) - self._slideStart;
            self:.scrollTo(if self.isRow() { amount.x } else { amount.y });
        }
    }

    pub over onSlidingEnd(mut self, _: u8) {
        self._grabbed = false;
    }

    pub over onScroll(mut self, pos: vec2, amountX: i32, amountY: i32)-> bool {
        if self.__super__:.onScroll(pos, amountX, amountY) {
            return true;
        }

        if !self.isOverflowing() {
            return false;
        }

        self:.scrollTo(self._scrollShift - (cast!f32(amountY) / 100.0f) * self.getScrollSpeed());
        self:.onHover(pos);
        true
    }

    pub over isFocusableLeftClick(self)-> bool {
        self._grabbed
    }

    pub over loseFocusOnReleaseLeft(self)-> bool {
        true
    }

    pub over onGainFocus(mut self) {
        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_POINTER);
    }

    pub over onLoseFocus(mut self) {
        self._grabbed = false;
        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_DEFAULT);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            if let Ok(s) = self._scrollbarShape {
                self._manager:.getShapeDrawer():.removeShape(s.uid);
                self._scrollbarShape = none;
            }

            self.__super__:.dispose();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SCROLLING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Keep the scrolled part within the content once laid out, and place the scrollbar, shown only when the layout
     * scrolls over children that do not fit in it
     * */
    fn updateScroll(mut self) {
        if !self.isScrolled() || self._relFullSize <= 1.0f {
            self._scrollLen = 1.0f;
            self._scrollShift = 0.0f;
            if self._shift != 0.0f {
                self:.setShift(0.0f);
            }

            if let Ok(dmut s) = alias self._scrollbarShape {
                s:.hide();
            }

            return;
        }

        self._scrollLen = 1.0f / self._relFullSize;
        self:.scrollTo(-self._shift / self._relFullSize);
    }

    /**
     * Scroll the content, its part scrolled over kept within it, and place the scrollbar
     * @params:
     *    - shift: the part of the content to scroll over, from 0 to 1
     * */
    fn scrollTo(mut self, shift: f32) {
        self._scrollShift = clamp(shift, 0.0f, 1.0f - self._scrollLen);
        self:.setShift(-(self._scrollShift * self._relFullSize));

        let sub = self.getStyle().getSubStyle("scrollbar");
        if self.isRow() {
            let h = if sub.hasHeight() { sub.getHeight() } else { WidgetSize(pix-> DEFAULT_SCROLLBAR_SIZE) };
            self._relScrollBarSize = makeVec2(self._scrollLen, self.clampSize(h, self._absoluteSize.y));
            self._relScrollBarPos = makeVec2(self._scrollShift, 1.0f - self._relScrollBarSize.y);
        } else {
            let w = if sub.hasWidth() { sub.getWidth() } else { WidgetSize(pix-> DEFAULT_SCROLLBAR_SIZE) };
            self._relScrollBarSize = makeVec2(self.clampSize(w, self._absoluteSize.x), self._scrollLen);
            self._relScrollBarPos = makeVec2(1.0f - self._relScrollBarSize.x, self._scrollShift);
        }

        if !self._scrollbarShape.hasValue {
            self:.registerScrollbar();
        }

        if let Ok(dmut s) = alias self._scrollbarShape {
            s:.setPosition(self._relScrollBarPos * self._absoluteSize + self._absolutePosition);
            s:.setSize(self._relScrollBarSize * self._absoluteSize);
            s:.setLevel(self.getChildrenDepth() + 1);
            if !self._hidden { s:.show(); }
        }
    }

    /**
     * Register the shape of the scrollbar
     * */
    fn registerScrollbar(mut self) {
        let dmut shDr = self._manager:.getShapeDrawer();
        {
            let color = self.getStyle().getSubStyle("scrollbar").getColor(WidgetShapeKind::BACKGROUND);
            let dmut shape = shDr:.registerColorQuad(color-> color);
            let (sciPos, sciSize) = self.getScissors(self._absolutePosition, self._absoluteSize);
            shape:.setScissors(sciPos, sciSize);
            self._scrollbarShape = (alias shape)?;
        } catch {
            err => {
                log::error #("LinearLayout", "Failed to construct the scrollbar : ", err);
            }
        }
    }

    /**
     * Give the cursor back when it leaves the scrollbar
     * */
    fn leaveScrollbar(mut self) {
        if self._overBar {
            self._overBar = false;
            self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_DEFAULT);
        }
    }

    /**
     * @returns: true iif the cursor is over the scrollbar of a layout that overflows
     * @params:
     *    - pos: the position of the cursor relative to the layout
     * */
    fn isOnScrollbar(self, pos: vec2)-> bool {
        if !self.isOverflowing() { return false; }
        if let Ok(_) = self.isInPadding(pos) {
            return self.isInSquare(self.toInner(pos), self._relScrollBarPos, self._relScrollBarPos + self._relScrollBarSize).hasValue;
        }

        false
    }

    /**
     * @returns: a position relative to the layout, relative to its inner box
     * */
    fn toInner(self, pos: vec2)-> vec2 {
        let a = (self._absolutePosition - self._absoluteFullPosition) / self._absoluteFullSize;
        let b = self._absoluteSize / self._absoluteFullSize;

        (pos - a) / b
    }

    /**
     * @returns: the speed of the wheel, set by the style scroll-speed
     * */
    fn getScrollSpeed(self)-> f32 {
        if let Ok(speed) = self.getStyle().getCustom!{f32}("scroll-speed") {
            return speed;
        }

        DEFAULT_SCROLL_SPEED
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of a layout is its children, side by side along its axis, the widest (or highest) across it
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        let mut minWidth = 0.0f, mut maxWidth = 0.0f;
        for dmut c in alias self._childs {
            let (minW, maxW) = c.widget:.measureIntrinsicWidths();
            if self.isRow() {
                minWidth += minW;
                maxWidth += maxW;
            } else {
                minWidth = max(minWidth, minW);
                maxWidth = max(maxWidth, maxW);
            }
        }

        (minWidth, maxWidth)
    }

    prot over measureContentHeight(mut self, width: f32)-> f32 {
        if self._childs.len == 0 { return 0.0f; }

        let mut height = 0.0f;
        if self.isRow() {
            let (mains, _) = self:.measureChildren(width, 0.0f);
            for i, dmut c in alias self._childs {
                height = max(height, c.widget:.measureIntrinsicHeight(mains[i]));
            }
        } else {
            for dmut c in alias self._childs {
                let w = if c.widget.getStyle().hasWidth() { c.widget:.measureWidth(width) } else { width };
                height += c.widget:.measureIntrinsicHeight(w);
            }
        }

        height
    }

    /**
     * Measure the sizes of the children along the axis of the layout and across it
     * @params:
     *    - mainSize: the size of the layout along its axis, in pixels
     *    - crossSize: the size of the layout across its axis, in pixels
     * @returns: the size of each child along the axis, its basis grown or shrunk to the layout, and across it
     * */
    fn measureChildren(mut self, mainSize: f32, crossSize: f32)-> ([f32], [f32]) {
        let n                      = self._childs.len;
        let dmut items: [FlexItem] = copy [FlexItem(); n];
        let dmut crosses: [f32]    = copy [crossSize; n];

        for i in 0us .. n {
            let dmut w = alias self._childs[i].widget;
            let style  = w.getStyle();

            // the width of a child of a column is known before its height, which may depend on it
            if !self.isRow() && style.hasWidth() {
                crosses[i] = w:.measureWidth(crossSize);
            }

            let (size, basis, minContent) = if self.isRow() {
                let size = style.getWidth();
                let basis = if style.hasFlexBasis() {
                    w:.resolveWidth(style.flexBasis.1, mainSize)
                } else {
                    w:.measureWidth(mainSize)
                };
                let minContent = if size.isContent() { w:.measureIntrinsicWidths()._0 } else { 0.0f };
                (size, basis, minContent)
            } else {
                let size = style.getHeight();
                let basis = if style.hasFlexBasis() {
                    w:.resolveHeight(style.flexBasis.1, crosses[i], mainSize)
                } else {
                    w:.measureHeight(crosses[i], mainSize)
                };

                let minContent = if size.isContent() { w:.measureIntrinsicHeight(crosses[i]) } else { 0.0f };
                (size, basis, minContent)
            };

            items[i] = FlexItem(basis-> basis,
                                grow-> style.flexGrow.1,
                                shrink-> if self.isScrolled() { 0.0f } else { style.flexShrink.1 },
                                min-> max(cast!f32(size.minPix), minContent),
                                max-> cast!f32(size.maxPix));
        }

        let mains = resolveFlexibleLengths(items, mainSize);

        // the height of a child of a row is known once its width is
        if self.isRow() {
            for i in 0us .. n {
                let dmut w = alias self._childs[i].widget;
                if w.getStyle().hasHeight() {
                    crosses[i] = w:.measureHeight(mains[i], crossSize);
                }
            }
        }

        (mains, crosses)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the depth of the deepest child, the layout's own when it has none
     * */
    fn getChildrenDepth(self)-> u32 {
        let mut max = self._depth;
        for i in self._childs {
            let chD = i.widget.getMaxDepth();
            if chD > max { max = chD; }
        }

        max
    }

    /**
     * @returns:
     *  - .0 : the widget on which the mouse is positionned
     *  - .1 : the position of the mouse relative to the widget
     */
    prot over mouseToWidget(mut self, pos: vec2, ref mut canBeSelf: bool)-> dmut (&Widget, vec2)? {
        canBeSelf = true;

        let inPaddingPos = self.toInner(pos);

        for i in 0 .. self._childs.len {
            let a = self._childs[i].relPos;
            let b = a + self._childs[i].relSize;

            if let Ok(relPos) = self.isInSquare(inPaddingPos, a, b) {
                canBeSelf = false;
                if let Ok(_) = self._childs[i].widget.isInBorder(relPos) {
                    return (alias self._childs[i].widget, relPos)?;
                }
            }
        }

        none
    }
}

/**
 * The linear layouts in a .gui file, laid out in the direction of their style
 * */
pub mod LinearLayout {

    /**
     * @returns: the schema of the linear layouts, taking any number of children
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema(WidgetKeys::LINEAR_LAYOUT,
                          |dmut m, id|-> dmut &Widget => copy LinearLayout(alias m, id),
                          children-> (copy Inserter!{&LinearLayout}(|dmut l, dmut c, i| => {
                              l:.insertChild(alias c, level-> cast!u32(i));
                          }))?,
                          parts-> copy ["scrollbar"],
                          properties-> copy [Layout::direction(), LinearLayout::overflow(), LinearLayout::scrollSpeed()])
    }

    /**
     * @returns: the property of what a linear layout does with the children that do not fit in it, hidden or scroll
     * */
    pub fn overflow()-> &WidgetProperty!{Overflow} {
        copy WidgetProperty!{Overflow}("overflow", &?kinds::overflow, affectsLayout-> true)
    }

    /**
     * @returns: the property of the speed of the wheel scrolling a linear layout
     * */
    pub fn scrollSpeed()-> &WidgetProperty!{f32} {
        copy WidgetProperty!{f32}("scroll-speed", &?factor)
    }
}
