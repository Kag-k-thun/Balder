in linear;

use balder::interface::loader;
use balder::interface::loader::registry::schema;
use balder::interface::widget::alignement;
use balder::interface::widget::layout::flex;
use balder::math::vector;

use std::io;

use ::std::algorithm::comparison;

record Child {
    pub let dmut widget: &Widget;
    pub let dmut relPos: vec2;
    pub let dmut relSize: vec2;
    pub let dmut level: u32;

    pub self (dmut widget: &Widget, relPos: vec2, relSize: vec2, level: u32)
        with widget = alias widget
        , relPos = relPos
        , relSize = relSize
        , level = level
    {}
}

pub class LinearLayout over Layout {

    // The columns of the layout
    let dmut _childs: [Child] = [];

    // The current shifting (wheel)
    let mut _shift: f32 = 0.0f;

    // The relative size of the widget (may be greater than 1 if containes too much widgets to fit on screen°)
    let mut _relFullSize: f32 = 0.0f;

    // True if the children keep their bases instead of shrinking, the layout being scrolled over them
    let mut _scrolled: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, WidgetKeys::LINEAR_LAYOUT)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the drawing size of the inner widgets, sized along the axis of the layout from their flex bases, growth and
     * shrink factors, and across it from their style (stretched to the layout when unset)
     */
    over onUpdateSize(mut self) {
        if self._childs.len == 0 {
            return;
        }

        let (mainSize, crossSize) = if self.isRow() {
            (self._absoluteSize.x, self._absoluteSize.y)
        } else {
            (self._absoluteSize.y, self._absoluteSize.x)
        };

        let (mains, crosses) = self:.measureChildren(mainSize, crossSize);

        let mut current = 0.0f;
        for col in 0 .. self._childs.len {
            let relMain = mains[col] / mainSize;
            let (wpos, wsize) = if self.isRow() {
                (makeVec2(current + self._shift, 0.0f) * self._absoluteSize + self._absolutePosition,
                 makeVec2(mains[col], crosses[col]))
            } else {
                (makeVec2(0.0f, current + self._shift) * self._absoluteSize + self._absolutePosition,
                 makeVec2(crosses[col], mains[col]))
            };

            current += relMain;
            self._relFullSize = current;

            let (relPos, relSize) = self:.placeChild(alias self._childs[col].widget, wpos, wsize, self._depth + 1);
            self._childs[col].relPos = relPos;
            self._childs[col].relSize = relSize;
        }
    }

    over onUpdateScissors(mut self) {
        for dmut i in alias self._childs {
            self:.clipChild(alias i.widget, i.relPos, i.relSize);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT CHILDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a child in the layout
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild(mut self, dmut ch: &Widget, level: u32 = 0) {
        self._childs ~= [Child(alias ch, makeVec2(0.0f, 0.0f), makeVec2(0.0f, 0.0f), level)];
        std::algorithm::sorting::sort(alias self._childs, |x, y| => { x.level < y.level });

        self._manager:.updateWidgets();
    }

    /**
     * @returns: the number of childs in the layout
     * */
    pub fn getNbChilds(self)-> u32 {
        cast!u32(self._childs.len)
    }

    /**
     * @returns: the size of a given child in the layout
     * @params:
     *   - index: the index of the child
     * */
    pub fn getChild(self, index: u32)-> &Widget {
        self._childs[index].widget
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SET/GET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Make the layout scroll up/down
     * */
    pub fn setShift(mut self, scroll: f32) {
        let oldShift = self._shift;

        for col in 0 .. self._childs.len {
            let mut wpos = self._childs[col].relPos; // * self._absoluteSize + self._absolutePosition;
            let wsize = self._childs[col].relSize * self._absoluteSize;

            if self.isRow() {
                wpos = makeVec2(wpos.x - oldShift + scroll, wpos.y);
            } else {
                wpos = makeVec2(wpos.x, wpos.y - oldShift + scroll);
            }

            self._childs[col].relPos = wpos;
            self._childs[col].widget:.setSize(wpos * self._absoluteSize + self._absolutePosition,
                                              wsize,
                                              self._depth + 1);
        }

        self._shift = scroll;
        self:.onUpdateScissors();
    }

    /**
     * Keep the bases of the children instead of shrinking them when they overflow, the layout being scrolled over them
     * */
    pub fn setScrolled(mut self, scrolled: bool) {
        self._scrolled = scrolled;
    }

    /**
     * The current shifting of the layout
     * */
    @field
    pub fn shift(self)-> f32 {
        self._shift
    }

    /**
     * @returns: true iif the children are laid out side by side, its style direction being a row, on top of each other
     * otherwise
     * */
    pub fn isRow(self)-> bool {
        Layout::directionOf(self.getStyle()) == Direction::ROW
    }

    pub over getMaxDepth(self)-> u32 {
        let mut max = self._depth;
        for i in self._childs {
            let chD = i.widget.getMaxDepth();
            if chD > max { max = chD; }
        }

        max
    }

    /**
     * @returns: the full length of the layout relative to the window, (i.e. width if vertical, height otherwise)
     * @info: this can be greater than 1, depending on the size of inner elements
     * */
    pub fn getFullLength(self)-> f32 {
        self._relFullSize
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the layout, in the order they are laid out
     * */
    pub over getChildren(mut self)-> dmut [&Widget] {
        return copy [alias c.widget for dmut c in alias self._childs];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of a layout is its children, side by side along its axis, the widest (or highest) across it
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        let mut minWidth = 0.0f, mut maxWidth = 0.0f;
        for dmut c in alias self._childs {
            let (minW, maxW) = c.widget:.measureIntrinsicWidths();
            if self.isRow() {
                minWidth += minW;
                maxWidth += maxW;
            } else {
                minWidth = max(minWidth, minW);
                maxWidth = max(maxWidth, maxW);
            }
        }

        (minWidth, maxWidth)
    }

    prot over measureContentHeight(mut self, width: f32)-> f32 {
        if self._childs.len == 0 { return 0.0f; }

        let mut height = 0.0f;
        if self.isRow() {
            let (mains, _) = self:.measureChildren(width, 0.0f);
            for i, dmut c in alias self._childs {
                height = max(height, c.widget:.measureIntrinsicHeight(mains[i]));
            }
        } else {
            for dmut c in alias self._childs {
                let w = if c.widget.getStyle().hasWidth() { c.widget:.measureWidth(width) } else { width };
                height += c.widget:.measureIntrinsicHeight(w);
            }
        }

        height
    }

    /**
     * Measure the sizes of the children along the axis of the layout and across it
     * @params:
     *    - mainSize: the size of the layout along its axis, in pixels
     *    - crossSize: the size of the layout across its axis, in pixels
     * @returns: the size of each child along the axis, its basis grown or shrunk to the layout, and across it
     * */
    fn measureChildren(mut self, mainSize: f32, crossSize: f32)-> ([f32], [f32]) {
        let n                      = self._childs.len;
        let dmut items: [FlexItem] = copy [FlexItem(); n];
        let dmut crosses: [f32]    = copy [crossSize; n];

        for i in 0us .. n {
            let dmut w = alias self._childs[i].widget;
            let style  = w.getStyle();

            // the width of a child of a column is known before its height, which may depend on it
            if !self.isRow() && style.hasWidth() {
                crosses[i] = w:.measureWidth(crossSize);
            }

            let (size, basis, minContent) = if self.isRow() {
                let size = style.getWidth();
                let basis = if style.hasFlexBasis() {
                    w:.resolveWidth(style.flexBasis.1, mainSize)
                } else {
                    w:.measureWidth(mainSize)
                };
                let minContent = if size.isContent() { w:.measureIntrinsicWidths()._0 } else { 0.0f };
                (size, basis, minContent)
            } else {
                let size = style.getHeight();
                let basis = if style.hasFlexBasis() {
                    w:.resolveHeight(style.flexBasis.1, crosses[i], mainSize)
                } else {
                    w:.measureHeight(crosses[i], mainSize)
                };

                let minContent = if size.isContent() { w:.measureIntrinsicHeight(crosses[i]) } else { 0.0f };
                (size, basis, minContent)
            };

            items[i] = FlexItem(basis-> basis,
                                grow-> style.flexGrow.1,
                                shrink-> if self._scrolled { 0.0f } else { style.flexShrink.1 },
                                min-> max(cast!f32(size.minPix), minContent),
                                max-> cast!f32(size.maxPix));
        }

        let mains = resolveFlexibleLengths(items, mainSize);

        // the height of a child of a row is known once its width is
        if self.isRow() {
            for i in 0us .. n {
                let dmut w = alias self._childs[i].widget;
                if w.getStyle().hasHeight() {
                    crosses[i] = w:.measureHeight(mains[i], crossSize);
                }
            }
        }

        (mains, crosses)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns:
     *  - .0 : the widget on which the mouse is positionned
     *  - .1 : the position of the mouse relative to the widget
     */
    prot over mouseToWidget(mut self, pos: vec2, ref mut canBeSelf: bool)-> dmut (&Widget, vec2)? {
        canBeSelf = true;

        let inPaddingPos = {
            let a = (self._absolutePosition - self._absoluteFullPosition) / self._absoluteFullSize;
            let b = (self._absoluteSize / self._absoluteFullSize);

            (pos - a) / b
        };

        for i in 0 .. self._childs.len {
            let a = self._childs[i].relPos;
            let b = a + self._childs[i].relSize;

            if let Ok(relPos) = self.isInSquare(inPaddingPos, a, b) {
                canBeSelf = false;
                if let Ok(_) = self._childs[i].widget.isInBorder(relPos) {
                    return (alias self._childs[i].widget, relPos)?;
                }
            }
        }

        none
    }
}

/**
 * The linear layouts in a .gui file, laid out in the direction of their style
 * */
pub mod LinearLayout {

    /**
     * @returns: the schema of the linear layouts, taking any number of children
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema(WidgetKeys::LINEAR_LAYOUT,
                          |dmut m, id|-> dmut &Widget => copy LinearLayout(alias m, id),
                          children-> (copy Inserter!{&LinearLayout}(|dmut l, dmut c, i| => {
                              l:.insertChild(alias c, level-> cast!u32(i));
                          }))?,
                          properties-> copy [Layout::direction()])
    }
}
