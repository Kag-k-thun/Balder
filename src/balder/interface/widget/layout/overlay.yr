in overlay;

use balder::core::dispose;
use balder::core::application::signal;
use balder::interface::loader::registry::schema;
use balder::math::vector;

use ::std::algorithm::comparison;

/**
 * An overlay is a backdrop filling its space, drawn with its background, its child centred over it at the size of its
 * content, fitted in it
 * @info:
 * =====
 * A widget manager opens an overlay over its content to show a dialog in the window of the caller (openOverlay): the
 * overlays are laid out over the content, the top one taking the mouse, the ticks and the Tab key, and the content
 * receives nothing while one is open. A click on the backdrop around the child goes to no widget. Escape, when the
 * focused widget does not use it and no menu is open, dismisses the top overlay: it emits on-dismiss, the owner of
 * the overlay closing it or not.
 * ====
 * */
pub class Overlay over Layout {

    // The child centred over the backdrop
    let dmut _child: (&Widget)? = none;

    // The position and the size of the margin box of the child, relative to the content box of the overlay
    let mut _childPos: vec2  = vec2();
    let mut _childSize: vec2 = vec2();

    prot { // signals
        let dmut _dismissed: (&Signal!{()})? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "Overlay")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the child centred over the backdrop, disposing the one it replaces
     * */
    pub fn setChild(mut self, dmut ch: &Widget) {
        if let Ok(dmut c) = alias self._child {
            c:.dispose();
        }

        self._child = (alias ch)?;
        if self._attached {
            ch:.onAttach((self)?);
        }

        self._manager:.updateWidgets();
    }

    /**
     * @returns: the child centred over the backdrop, none until it is set
     * */
    pub fn getChild(mut self)-> dmut (&Widget)? {
        alias self._child
    }

    pub over getChildren(mut self)-> dmut [&Widget] {
        let dmut res: [&Widget] = [];
        if let Ok(dmut c) = alias self._child {
            res ~= [alias c];
        }

        alias res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The child is sized to its content, fitted in the content box of the overlay, and centred in it
     * */
    over onUpdateSize(mut self) {
        let container = self._absoluteSize;
        if let Ok(dmut c) = alias self._child {
            let margins = c.getMarginSize(container);
            let width   = c:.measureWidth(container, stretch-> false);
            let height  = min(c:.measureHeight(width, container, stretch-> false), max(0.0f, container.y - margins.y));
            let wsize   = makeVec2(width, height) + margins;

            let at = makeVec2(max(0.0f, (container.x - wsize.x) / 2.0f), max(0.0f, (container.y - wsize.y) / 2.0f));
            let (relPos, relSize) = self:.placeChild(alias c, at + self._absolutePosition, wsize, self._depth + 1);
            self._childPos = relPos;
            self._childSize = relSize;
        }
    }

    over onUpdateScissors(mut self) {
        if let Ok(dmut c) = alias self._child {
            self:.clipChild(alias c, self._childPos, self._childSize);
        }
    }

    pub over getMaxDepth(self)-> u32 {
        if let Ok(c) = self._child {
            return max(self._depth, c.getMaxDepth());
        }

        self._depth
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dismiss the overlay, emitting on-dismiss, as Escape does on the top overlay of a manager
     * */
    pub fn dismiss(mut self) {
        if let Ok(dmut s) = alias self._dismissed {
            s:.emit();
        }
    }

    /**
     * @returns: the signal emitted when the overlay is dismissed
     * */
    pub fn dismissed(mut self)-> dmut &Signal!{()} {
        if let Ok(dmut s) = alias self._dismissed {
            return alias s;
        }

        let dmut s = copy Signal!{()} ();
        self._dismissed = (alias s)?;

        alias s
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self.__super__:.dispose();
            self._child = none;

            if let Ok(dmut s) = alias self._dismissed {
                s:.clear();
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the child when the cursor is over it; the overlay itself takes the cursor anywhere else in it
     */
    prot over mouseToWidget(mut self, pos: vec2, ref mut canBeSelf: bool)-> dmut (&Widget, vec2)? {
        canBeSelf = true;
        if let Ok(inPaddingPos) = self.isInPadding(pos) {
            if let Ok(dmut c) = alias self._child {
                if let Ok(relPos) = self.isInSquare(inPaddingPos, self._childPos, self._childPos + self._childSize) {
                    if let Ok(_) = c.isInBorder(relPos) {
                        return (alias c, relPos)?;
                    }
                }
            }
        }

        none
    }
}

/**
 * The overlays in a .gui file
 * */
pub mod Overlay {

    /**
     * @returns: the schema of the overlays, taking one child, centred over them
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("Overlay",
                          |dmut m, id|-> dmut &Widget => copy Overlay(alias m, id),
                          children-> (copy Inserter!{&Overlay}(|dmut o, dmut c, _| => {
                              o:.setChild(alias c);
                          }, min-> 1us, roles-> copy ["content"]))?,
                          signals-> copy [copy Emitter!{&Overlay, ()}("on-dismiss", |dmut o|-> dmut &Signal!{()} => alias o:.dismissed())])
    }
}
