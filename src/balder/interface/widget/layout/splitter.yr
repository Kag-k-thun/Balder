in splitter;

use balder::utils;
use balder::core::dispose;
use balder::core::application::refcount;
use balder::core::shader::texture;
use balder::interface::_;
use balder::interface::loader::parser;
use balder::interface::loader::registry::schema;
use balder::interface::widget::{alignement, sizing};
use balder::interface::widget::layout::flex;
use balder::math::vector;

use std::algorithm::comparison;

use ::sdl3::mouse;

// The thickness of a grip (and of the box catching the cursor around it) when the style sets none, in pixels
def DEFAULT_GRIP_SIZE = 4.0f;

/**
 * A pane of a splitter
 * */
record Pane {

    // The content of the pane
    pub let dmut widget: &Widget;

    // The position of the pane relative to the inner box of the splitter
    pub let mut relPos: vec2 = vec2();

    // The size of the pane relative to the inner box of the splitter
    pub let mut relSize: vec2 = vec2();

    // The part of the space shared by the panes this one takes, negative until the splitter is first laid out
    pub let mut ratio: f32 = -1.0f;

    pub self (dmut widget: &Widget)
        with widget = alias widget
    {}
}

/**
 * The grip between two panes of a splitter, dragged to resize them
 * */
record Grip {

    // The shape displaying the grip
    pub let dmut shape: (&Shape)? = none;

    // The shape displaying the background image of the grip
    pub let dmut image: (&Shape)? = none;

    // The position of the displayed grip relative to the inner box of the splitter
    pub let mut relPos: vec2 = vec2();

    // The position of the box catching the cursor (larger than the displayed grip) relative to the inner box
    pub let mut relBoxPos: vec2 = vec2();

    pub self () {}
}

/**
 * A layout of panes side by side, separated by grips the user drags to share the space between two panes
 * The size of a pane along the axis of the splitter is taken from its style when the splitter is first laid out, the
 * panes whose size is auto sharing the rest, and its min and max bounds always hold, an auto min being its min-content.
 * Across the axis, the panes are stretched to the splitter. A pane out of the layout (display: none) takes no space, nor
 * does the grip after it, the grip before it separating the panes around it.
 * */
pub class Splitter over Layout {

    // The panes, from left to right (or from top to bottom)
    let dmut _panes: [Pane] = [];

    // The grips, the grip 'i' being between the panes 'i' and 'i + 1'
    let dmut _grips: [Grip] = [];

    // True if the ratios of the panes were shared with the panes side by side, on top of each other otherwise
    let mut _ratiosHorizontal: bool = false;

    prot { // grip sizes

        // The size of a displayed grip relative to the inner box
        let mut _relGripSize: vec2 = vec2();

        // The size of the box catching the cursor around a grip relative to the inner box
        let mut _relGripBoxSize: vec2 = vec2();
    }

    prot { // grip background image

        // The background image of the grips
        let mut _currentGripImage: [c8] = "";

        // The texture of the grips
        let dmut _gripTexture: &RefCount!{&Texture};
    }

    prot { // dragging

        // The grip being dragged
        let mut _dragged: usize = 0us;

        // The position of the mouse when the dragging started, in pixels
        let mut _slideStart: vec2 = vec2();

        // The sizes of the panes along the axis when the dragging started, in pixels
        let mut _dragStart: [f32] = [];
    }

    prot { // hover

        // The grip under the cursor, drawn in the style of its part in the state hover, usize::max when there is none
        let mut _hoveredGrip: usize = usize::max;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "Splitter")
        , _gripTexture = manager:.getWindow():.emptyResource!{&Texture2D} ()
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a pane after the last one, a grip separating it from the one before
     * @warning: the widget is disposed when the splitter is disposed
     * */
    pub fn insertPane(mut self, dmut widget: &Widget) {
        if self._panes.len != 0us {
            self._grips ~= [Grip()];
            if self._attached {
                self:.registerGrip(self._grips.len - 1us);
            }
        }

        self._panes ~= [Pane(alias widget)];
        for dmut p in alias self._panes {
            p.ratio = -1.0f;
        }

        if self._attached {
            widget:.onAttach((self)?);
        }

        self._manager:.updateWidgets();
    }

    /**
     * @returns: the panes of the splitter, in order
     * */
    pub over getChildren(mut self)-> dmut [&Widget] {
        return copy [alias p.widget for dmut p in alias self._panes];
    }

    /**
     * @returns: true iif the panes are side by side, its style direction being a row, on top of each other otherwise
     * */
    pub fn isHorizontal(self)-> bool {
        Layout::directionOf(self.getStyle()) == Direction::ROW
    }

    pub over getMaxDepth(self)-> u32 {
        let mut max = self._depth;
        for p in self._panes {
            let chD = p.widget.getMaxDepth();
            if chD > max { max = chD; }
        }

        max + 2 // grip color + grip image
    }

    /**
     * Across its axis, a pane fills the splitter; along it, the pane takes its part of the splitter, its size depending
     * on its content only when one of its bounds does, an auto min being its min-content
     * */
    prot over fixesSizeOf(self, child: &Widget, row: bool)-> bool {
        if row != self.isHorizontal() { return self.isSizeFixed(row); }

        let style = child.getStyle();
        let (lower, upper) = if row { (style.minWidth._1, style.maxWidth._1) } else { (style.minHeight._1, style.maxHeight._1) };
        lower.sizing == Sizing::LENGTH && !needsContent(upper) && self.isSizeFixed(row)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);

        for i in 0us .. self._grips.len {
            self:.registerGrip(i);
        }
    }

    over onHide(mut self) {
        self.__super__:.onHide();
        for dmut g in alias self._grips {
            if let Ok(dmut s) = alias g.shape { s:.hide(); }
            if let Ok(dmut s) = alias g.image { s:.hide(); }
        }
    }

    over onShow(mut self) {
        self.__super__:.onShow();
        for i, dmut g in alias self._grips {
            if self.isGripShown(i) {
                if let Ok(dmut s) = alias g.shape { s:.show(); }
                if let Ok(dmut s) = alias g.image { s:.show(); }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Share the space left by the grips between the panes, from their ratios kept in the bounds of their sizes
     * */
    over onUpdateSize(mut self) {
        if self._panes.len == 0us { return; }

        let mainSize = self.getMain(self._absoluteSize);
        let gripSize = self.getGripSize("grip", mainSize);
        let boxSize = max(gripSize, self.getGripSize("bbox", mainSize));
        let space = max(0.0f, mainSize - gripSize * cast!f32(cast!u32(self.countShownGrips())));

        self._relGripSize = self.toVec(gripSize, self.getCross(self._absoluteSize)) / self._absoluteSize;
        self._relGripBoxSize = self.toVec(boxSize, self.getCross(self._absoluteSize)) / self._absoluteSize;

        // the space is shared again when the direction of the style changed
        if self._panes[0].ratio < 0.0f || self._ratiosHorizontal != self.isHorizontal() {
            self._ratiosHorizontal = self.isHorizontal();
            self:.initRatios(space);
        }

        let n = self._panes.len;
        let dmut items: [FlexItem] = copy [FlexItem() ; n];
        for i in 0us .. n {
            let (lower, upper) = self:.getPaneBounds(i);
            items[i] = FlexItem(basis-> self._panes[i].ratio * space,
                                grow-> 1.0f,
                                shrink-> 1.0f,
                                min-> lower,
                                max-> upper);
        }

        let sizes = resolveFlexibleLengths(items, space);

        let mut current = 0.0f;
        for i in 0us .. n {
            let pos = self.toVec(current, 0.0f) + self._absolutePosition;
            let size = self.toVec(sizes[i], self.getCross(self._absoluteSize));
            let (relPos, relSize) = self:.placeChild(alias self._panes[i].widget, pos, size, self._depth + 1);

            self._panes[i].relPos = relPos;
            self._panes[i].relSize = relSize;
            current += sizes[i];

            if i < self._grips.len {
                self._grips[i].relPos = self.toVec(current, 0.0f) / self._absoluteSize;
                self._grips[i].relBoxPos = self.toVec(current - (boxSize - gripSize) / 2.0f, 0.0f) / self._absoluteSize;
                if self.isGripShown(i) {
                    current += gripSize;
                }
            }
        }
    }

    over onUpdateScissors(mut self) {
        for dmut p in alias self._panes {
            self:.clipChild(alias p.widget, p.relPos, p.relSize);
        }

        for dmut g in alias self._grips {
            let (sciPos, sciSize) = self.getScissors(g.relPos * self._absoluteSize + self._absolutePosition,
                                                     self._relGripSize * self._absoluteSize);
            if let Ok(dmut s) = alias g.shape { s:.setScissors(sciPos, sciSize); }
            if let Ok(dmut s) = alias g.image { s:.setScissors(sciPos, sciSize); }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of a splitter is its panes and its grips, side by side along its axis
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        let mut minWidth = 0.0f, mut maxWidth = 0.0f;
        for dmut p in alias self._panes {
            let (minW, maxW) = p.widget:.measureIntrinsicWidths();
            if self.isHorizontal() {
                minWidth += minW;
                maxWidth += maxW;
            } else {
                minWidth = max(minWidth, minW);
                maxWidth = max(maxWidth, maxW);
            }
        }

        if self.isHorizontal() {
            let grips = self.getGripSize("grip", 0.0f) * cast!f32(cast!u32(self.countShownGrips()));
            (minWidth + grips, maxWidth + grips)
        } else {
            (minWidth, maxWidth)
        }
    }

    prot over measureContentHeight(mut self, width: f32)-> f32 {
        let n = cast!f32(cast!u32(self._panes.len));
        let mut height = 0.0f;
        let pane = makeVec2(if self.isHorizontal() { width / n } else { width }, INDEFINITE_SIZE);
        for dmut p in alias self._panes {
            let w = p.widget:.measureWidth(pane, stretch-> true);
            if self.isHorizontal() {
                height = max(height, p.widget:.measureIntrinsicHeight(w));
            } else {
                height += p.widget:.measureIntrinsicHeight(w);
            }
        }

        if self.isHorizontal() {
            height
        } else {
            height + self.getGripSize("grip", 0.0f) * cast!f32(cast!u32(self.countShownGrips()))
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover(mut self, pos: vec2)-> dmut (&Widget)? {
        if let Ok(grip) = self.mouseOnGrip(pos) {
            if let Ok(dmut w) = alias self._lastHover {
                w:.onLoseHoverFocus();
                self._lastHover = none;
            }

            self:.setHoveredGrip(grip);
            self:.setHover(true);
            self:.setResizeCursor();

            return (alias self)?;
        }

        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_DEFAULT);
        self:.setHoveredGrip(usize::max);
        self:.setHover(false);

        self.__super__:.onHover(pos)
    }

    pub over onLoseHoverFocus(mut self) {
        self.__super__:.onLoseHoverFocus();
        self:.setHoveredGrip(usize::max);
        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_DEFAULT);
    }

    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if let Ok(grip) = self.mouseOnGrip(pos) {
            self._dragged = grip;
            self._slideStart = self._manager.getMousePosition();
            self._dragStart = copy [self.getMain(p.relSize * self._absoluteSize) for p in self._panes];

            return (alias self)?;
        }

        self.__super__:.onClick(pos, button)
    }

    pub over onDoubleClick(mut self, pos: vec2)-> dmut (&Widget)? {
        if let Ok(_) = self.mouseOnGrip(pos) {
            return self:.onClick(pos, SDL_BUTTON_LEFT);
        }

        self.__super__:.onDoubleClick(pos)
    }

    /**
     * Move the dragged grip with the mouse, the two panes it separates sharing their space, each in its bounds, the
     * panes out of the layout between them being skipped
     * */
    pub over onSliding(mut self, _pos_: vec2, _speed_: vec2, _: u8) {
        let k = self._dragged;
        let next = self.nextShownPane(k);
        if next >= self._panes.len || self._dragStart.len != self._panes.len { return; }

        let delta = self.getMain(self._manager.getMousePosition() - self._slideStart);
        let before = self:.getPaneBounds(k);
        let after = self:.getPaneBounds(next);

        let total = self._dragStart[k] + self._dragStart[next];
        let low = max(before._0, total - after._1);
        let high = min(before._1, total - after._0);
        let first = max(low, min(high, self._dragStart[k] + delta));

        let dmut sizes: [f32] = copy self._dragStart;
        sizes[k] = first;
        sizes[next] = total - first;

        let mut space = 0.0f;
        for s in sizes { space += s; }

        if space > 0.0f {
            for i in 0us .. self._panes.len {
                self._panes[i].ratio = sizes[i] / space;
            }
        }

        self._manager:.updateWidgets();
    }

    pub over onGainFocus(mut self) {
        self:.setResizeCursor();
    }

    pub over onLoseFocus(mut self) {
        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_DEFAULT);
        self:.onLoseHoverFocus();
    }

    pub over isFocusableLeftClick(self)-> bool {
        true
    }

    pub over loseFocusOnReleaseLeft(self)-> bool {
        true
    }

    /**
     * The cursor is over none of the splitter but its panes and its grips
     * */
    prot over mouseToWidget(mut self, pos: vec2, ref mut canBeSelf: bool)-> dmut (&Widget, vec2)? {
        canBeSelf = false;
        if let Ok(inPaddingPos) = self.isInPadding(pos) {
            for i in 0us .. self._panes.len {
                let a = self._panes[i].relPos;
                if let Ok(relPos) = self.isInSquare(inPaddingPos, a, a + self._panes[i].relSize) {
                    if let Ok(_) = self._panes[i].widget.isInBorder(relPos) {
                        return (alias self._panes[i].widget, relPos)?;
                    }
                }
            }
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STYLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onApplyStyle(mut self) {
        let gripStyle = self.getStyle().getSubStyle("grip");
        let hoverStyle = if self._hoveredGrip < self._grips.len { self:.getGripHoverStyle() } else { gripStyle };
        self:.loadGripTexture(gripStyle);

        let depth = self.getMaxDepth();
        for i, dmut g in alias self._grips {
            let style = if i == self._hoveredGrip { hoverStyle } else { gripStyle };
            let pos = g.relPos * self._absoluteSize + self._absolutePosition;
            let size = self._relGripSize * self._absoluteSize;

            let shown = self.isDrawn() && self.isGripShown(i);
            if let Ok(dmut s) = alias g.shape {
                s:.setPosition(pos);
                s:.setSize(size);
                s:.setColor(style.getColor(WidgetShapeKind::BACKGROUND));
                s:.setLevel(depth - 1u32);
                if shown { s:.show(); } else { s:.hide(); }
            }

            if let Ok(dmut s) = alias g.image {
                let (imagePos, imageSize) = self.computeGripTextureSize(gripStyle, pos, size);
                s:.setPosition(imagePos);
                s:.setSize(imageSize);
                s:.setColor(style.getColor(WidgetShapeKind::IMAGE));
                s:.setLevel(depth);
                if shown { s:.show(); } else { s:.hide(); }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._attached = false;

            let dmut shDr = self._manager:.getShapeDrawer();
            for dmut g in alias self._grips {
                if let Ok(dmut s) = alias g.shape {
                    shDr:.removeShape(s.uid);
                    g.shape = none;
                }

                if let Ok(dmut s) = alias g.image {
                    shDr:.removeShape(s.uid);
                    g.image = none;
                }
            }

            self._gripTexture:.dispose();
            self._currentGripImage = "";

            self.__super__:.dispose();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Share the space between the panes when the splitter is first laid out, a pane whose style sets its size along the
     * axis taking it, the others sharing the rest
     * @params:
     *    - space: the space left by the grips, in pixels
     * */
    fn initRatios(mut self, space: f32) {
        let n = self._panes.len;
        let dmut sizes: [f32] = copy [-1.0f ; n];

        let container = self._absoluteSize;
        let mut fixed = 0.0f;
        let mut free = 0us;
        for i in 0us .. n {
            let dmut w = alias self._panes[i].widget;
            let style = w.getStyle();
            let margins = self.getMain(w.getMarginSize(container));
            let size = if self.isHorizontal() {
                w:.resolveWidth(style.width._1, container)
            } else {
                w:.resolveHeight(style.height._1, w:.measureWidth(container, stretch-> true), container)
            };

            if let Ok(s) = size {
                sizes[i] = s + margins;
                fixed += sizes[i];
            } else {
                free += 1us;
            }
        }

        let share = if free != 0us { max(0.0f, space - fixed) / cast!f32(cast!u32(free)) } else { 0.0f };
        let mut total = 0.0f;
        for i in 0us .. n {
            if sizes[i] < 0.0f { sizes[i] = share; }
            total += sizes[i];
        }

        for i in 0us .. n {
            self._panes[i].ratio = if total > 0.0f { sizes[i] / total } else { 1.0f / cast!f32(cast!u32(n)) };
        }
    }

    /**
     * Register the shapes of a grip
     * */
    fn registerGrip(mut self, i: usize) {
        let dmut shDr = self._manager:.getShapeDrawer();
        {
            let dmut shape = shDr:.registerColorQuad();
            self._grips[i].shape = (alias shape)?;

            if !self._gripTexture.isEmpty() {
                let dmut image = shDr:.registerTextureQuad(texture-> self._gripTexture:.clone());
                self._grips[i].image = (alias image)?;
            }
        } catch {
            err => {
                log::error #("Splitter", "Failed to construct shapes : ", err);
            }
        }
    }

    /**
     * Change the grip under the cursor, the grip dragged keeping it until the drag ends as the cursor hovers nothing
     * while a button is held
     * @params:
     *    - grip: the index of the grip, usize::max for none
     * */
    fn setHoveredGrip(mut self, grip: usize) {
        if self._hoveredGrip == grip { return; }
        self._hoveredGrip = grip;
        self:.onApplyStyle();
    }

    /**
     * @returns: the style of a grip under the cursor, the style of the part ::grip of the splitter in the state :hover
     * */
    fn getGripHoverStyle(mut self)-> &Style {
        let path = self.getStylePath();
        self._manager:.getStyleManager().computePart(path, self._currentStyle, "grip", states-> copy ["hover"])
    }

    /**
     * Load the background image of the grips, when the style changes it
     * */
    fn loadGripTexture(mut self, gripStyle: &Style) {
        if self._currentGripImage == gripStyle.backgroundImage._1 { return; }
        self._currentGripImage = gripStyle.backgroundImage._1;

        let dmut shDr = self._manager:.getShapeDrawer();
        for dmut g in alias self._grips {
            if let Ok(dmut s) = alias g.image {
                shDr:.removeShape(s.uid);
                g.image = none;
            }
        }

        self._gripTexture:.dispose();
        if self._currentGripImage == "" { return; }

        {
            self._gripTexture = self._manager:.getWindow():.loadResource!{&Texture2D} (self._currentGripImage);
            if !self._gripTexture.isEmpty() {
                for dmut g in alias self._grips {
                    let dmut image = shDr:.registerTextureQuad(texture-> self._gripTexture:.clone());
                    g.image = (alias image)?;
                }
            }
        } catch {
            err => {
                log::error #("Splitter", "Failed to load the grip image : ", err);
            }
        }
    }

    /**
     * @returns: the position and size of the background image of a grip, its ratio kept when the style asks for it
     * */
    fn computeGripTextureSize(self, gripStyle: &Style, absPos: vec2, absSize: vec2)-> (vec2, vec2) {
        if !gripStyle.backgroundImageKeepRatio._1 {
            return (absPos, absSize);
        }

        let test = if gripStyle.backgroundImageFill._1 { absSize.x < absSize.y } else { absSize.x > absSize.y };
        if test {
            (makeVec2(absPos.x + (absSize.x - absSize.y) / 2.0f, absPos.y), makeVec2(absSize.y, absSize.y))
        } else {
            (makeVec2(absPos.x, absPos.y + (absSize.y - absSize.x) / 2.0f), makeVec2(absSize.x, absSize.x))
        }
    }

    /**
     * @returns: the index of the grip under the cursor, if any
     * @params:
     *    - pos: the position of the cursor relative to the splitter
     * */
    fn mouseOnGrip(self, pos: vec2)-> (usize)? {
        if let Ok(relPos) = self.isInPadding(pos) {
            for i in 0us .. self._grips.len {
                let a = self._grips[i].relBoxPos;
                if !self.isGripShown(i) { continue; }
                if let Ok(_) = self.isInSquare(relPos, a, a + self._relGripBoxSize) {
                    return (i)?;
                }
            }
        }

        none
    }

    /**
     * @returns: true iif the grip after a pane is shown: the pane is in the layout, and so is a pane after it
     * */
    fn isGripShown(self, i: usize)-> bool {
        self._panes[i].widget.getStyle().isDisplayed() && self.nextShownPane(i) < self._panes.len
    }

    /**
     * @returns: the index of the first pane in the layout after a pane, the number of panes if there is none
     * */
    fn nextShownPane(self, i: usize)-> usize {
        for j in i + 1us .. self._panes.len {
            if self._panes[j].widget.getStyle().isDisplayed() { return j; }
        }

        self._panes.len
    }

    /**
     * @returns: the number of grips shown
     * */
    fn countShownGrips(self)-> usize {
        let mut n = 0us;
        for i in 0us .. self._grips.len {
            if self.isGripShown(i) { n += 1us; }
        }

        n
    }

    /**
     * @returns: the thickness of a grip (or of the box catching the cursor around it) from a sub style, in pixels
     * */
    fn getGripSize(self, sub: [c8], mainSize: f32)-> f32 {
        let style = self.getStyle().getSubStyle(sub);
        let size = if self.isHorizontal() { style.width._1 } else { style.height._1 };
        if let Ok(px) = size.resolve(mainSize) {
            return px;
        }

        DEFAULT_GRIP_SIZE
    }

    /**
     * @returns: the smallest and the largest sizes of the margin box of a pane along the axis of the splitter, from its
     * bounds, an auto lower bound being its min-content
     * @params:
     *    - i: the index of the pane
     * */
    fn getPaneBounds(mut self, i: usize)-> (f32, f32) {
        let container = self._absoluteSize;
        let dmut w = alias self._panes[i].widget;
        let margins = self.getMain(w.getMarginSize(container));

        let width = if self.isHorizontal() { 0.0f } else { w:.measureWidth(container, stretch-> true) };
        let item = w:.measureFlexItem(self.isHorizontal(), container, width-> width);

        (item.min + margins, if item.max < f32::max { item.max + margins } else { item.max })
    }

    /**
     * @returns: the component of a vector along the axis of the splitter
     * */
    fn getMain(self, v: vec2)-> f32 {
        if self.isHorizontal() { v.x } else { v.y }
    }

    /**
     * @returns: the component of a vector across the axis of the splitter
     * */
    fn getCross(self, v: vec2)-> f32 {
        if self.isHorizontal() { v.y } else { v.x }
    }

    /**
     * @returns: a vector from its components along and across the axis of the splitter
     * */
    fn toVec(self, main: f32, cross: f32)-> vec2 {
        if self.isHorizontal() { makeVec2(main, cross) } else { makeVec2(cross, main) }
    }

    /**
     * Set the cursor resizing along the axis of the splitter
     * */
    fn setResizeCursor(mut self) {
        if self.isHorizontal() {
            self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_EW_RESIZE);
        } else {
            self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_NS_RESIZE);
        }
    }
}

/**
 * The splitters in a .gui file
 * */
pub mod Splitter {

    /**
     * @returns: the schema of the splitters, each child being a pane
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("Splitter",
                          |dmut m, id|-> dmut &Widget => copy Splitter(alias m, id),
                          children-> (copy Inserter!{&Splitter}(|dmut s, dmut c, _| => { s:.insertPane(alias c); }))?,
                          parts-> copy ["grip", "bbox"],
                          partStates-> copy ["grip" => copy ["hover"]],
                          properties-> copy [Layout::direction()])
    }
}
