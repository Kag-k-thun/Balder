in d3scene;

use balder::{scene, utils};
use balder::core::dispose;
use balder::interface::loader;
use balder::interface::loader::registry::schema;
use balder::math::vector;

use ::std::time::dur;

/**
 * A widget containing and displaying a 3D scene
 * */
pub class Scene3DLayout over Widget {

    // The scene to render
    let dmut _scene: (&Scene)? = none;

    // The width of the scene
    let mut _w: u32 = 0;

    // The height of the scene
    let mut _h: u32 = 0;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - width: the width the scene is rendered at, before being scaled to the widget
     *    - height: the height the scene is rendered at, before being scaled to the widget
     * */
    pub self (dmut manager: &WidgetManager, id: [c8], width: u32 = 0, height: u32 = 0)
        with super(alias manager, id, WidgetKeys::SCENE_3D)
        , _w = width
        , _h = height
    {
        self._hasBackground = false;
        self._hasBorder = false;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Change the resolution the scene is rendered at, before being scaled to the widget
     * @info: the scene is configured at this resolution when the widget is attached
     * */
    pub fn setResolution(mut self, width: u32, height: u32) {
        self._w = width;
        self._h = height;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);

        let dmut scene = copy Scene(self._manager:.getWindow(), self.id);
        {
            scene:.configure(self._w, self._h);
            self._scene = (alias scene)?;

            self:.registerTextureShape(WidgetShapeKind::IMAGE, alias scene:.getOutputTexture():.clone());
            self:.registerColorShape(WidgetShapeKind::BACKGROUND);
        } catch {
            err => {
                log::error #("Scene3DLayout", "Failed to create scene", err);
                scene:.dispose();
            }
        }
    }

    over computeBackgroundImageSize(self)-> (vec2, vec2) {
        let test = self._absolutePostBorderSize.x < self._absolutePostBorderSize.y;
        let (pos, size) = if test {
            let xsize = self._absolutePostBorderSize.y;
            let xpos  = self._absolutePostBorderPosition.x + (self._absolutePostBorderSize.x - xsize) / 2.0f;

            (makeVec2(xpos, self._absolutePostBorderPosition.y), makeVec2(xsize, self._absolutePostBorderSize.y))
        } else {
            let ysize = self._absolutePostBorderSize.x;
            let ypos  = self._absolutePostBorderPosition.y + (self._absolutePostBorderSize.y - ysize) / 2.0f;

            (makeVec2(self._absolutePostBorderPosition.x, ypos), makeVec2(self._absolutePostBorderSize.x, ysize))
        };

        (pos, size)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        if let Ok(dmut scene) = alias self._scene {
            scene:.setAspect(cast!u32(self._absoluteSize.x), cast!u32(self._absoluteSize.y));
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          TICK EVENTS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Event emitted by the application at each UI frameo
     * */
    pub over onTick(mut self, delta: Duration) {
        if let Ok(dmut scene) = alias self._scene {
            scene:.onTick(delta);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the scene displayed by the widget
     * */
    pub fn getScene(mut self)-> dmut (&Scene)? {
        alias self._scene
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self.__super__:.dispose();

            if let Ok(dmut sc) = alias self._scene {
                sc:.dispose();
                self._scene = none;
            }
        }
    }
}

/**
 * The 3D scenes in a .gui file
 * */
pub mod Scene3DLayout {

    /**
     * @returns: the schema of the 3D scenes, rendered at their resolution: 1280 720 before being scaled to the widget
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema(WidgetKeys::SCENE_3D,
                          |dmut m, id|-> dmut &Widget => copy Scene3DLayout(alias m, id),
                          attributes-> copy [copy Setter!{&Scene3DLayout, (u32, u32)}("resolution", |dmut s, r| => {
                              s:.setResolution(r._0, r._1);
                          })])
    }
}
