/**
 * The sizing of the items of a line along its main axis, from their flex bases, growth and shrink factors (CSS Flexible
 * Box Layout, §9.7 "Resolving Flexible Lengths")
 * */
in flex;

use std::algorithm::comparison;

/**
 * An item of a flex line, sized along the main axis of the line
 * */
@data
pub record FlexItem {

    // The size of the item before it grows or shrinks, in pixels
    pub let basis: f32 = 0.0f;

    // The part of the free space of the line the item takes, 0 to keep its basis
    pub let grow: f32 = 0.0f;

    // The part of the overflow of the line the item gives back, weighted by its basis, 0 to keep its basis
    pub let shrink: f32 = 1.0f;

    // The smallest size of the item, in pixels
    pub let min: f32 = 0.0f;

    // The largest size of the item, in pixels
    pub let max: f32 = f32::max;
}

/**
 * Resolve the sizes of the items of a line, the free space of the line being shared by their growth factors, or its
 * overflow by their shrink factors weighted by their bases; an item clamped to its bounds is frozen there and what it
 * could not take is shared again among the others
 * @params:
 *    - items: the items of the line
 *    - available: the size of the line, in pixels
 * @returns: the size of each item, in pixels
 * */
pub fn resolveFlexibleLengths(items: [FlexItem], available: f32)-> [f32] {
    let n = items.len;
    let dmut sizes: [f32] = copy [0.0f ; n];
    let dmut frozen: [bool] = copy [false ; n];

    let mut hypothetical = 0.0f;
    for i in 0us .. n {
        sizes[i] = clampItem(items[i], items[i].basis);
        hypothetical += sizes[i];
    }

    let growing = hypothetical < available;

    // the items that cannot flex keep their hypothetical size
    let mut initialFree = available;
    for i in 0us .. n {
        let it = items[i];
        let factor = if growing { it.grow } else { it.shrink };
        if factor <= 0.0f || (growing && it.basis > sizes[i]) || (!growing && it.basis < sizes[i]) {
            frozen[i] = true;
            initialFree -= sizes[i];
        } else {
            initialFree -= it.basis;
        }
    }

    let dmut unclamped: [f32] = copy [0.0f ; n];
    loop {
        let mut remaining = available;
        let mut factors = 0.0f;
        let mut scaled = 0.0f;
        let mut flexible = false;
        for i in 0us .. n {
            if frozen[i] {
                remaining -= sizes[i];
            } else {
                flexible = true;
                remaining -= items[i].basis;
                factors += if growing { items[i].grow } else { items[i].shrink };
                scaled += items[i].shrink * items[i].basis;
            }
        }

        if !flexible { break; }

        // factors summing to less than 1 take only that part of the free space
        if factors < 1.0f && abs(initialFree * factors) < abs(remaining) {
            remaining = initialFree * factors;
        }

        let mut violation = 0.0f;
        for i in 0us .. n {
            if !frozen[i] {
                let it = items[i];
                let size = if growing {
                    it.basis + remaining * it.grow / factors
                } else if scaled > 0.0f {
                    it.basis + remaining * (it.shrink * it.basis) / scaled
                } else {
                    it.basis
                };

                unclamped[i] = size;
                sizes[i] = clampItem(it, size);
                violation += sizes[i] - size;
            }
        }

        // the items clamped the way the line overflowed are frozen, all of them when the clamps cancel out
        for i in 0us .. n {
            if !frozen[i] {
                if violation == 0.0f {
                    frozen[i] = true;
                } else if violation > 0.0f && sizes[i] > unclamped[i] {
                    frozen[i] = true;
                } else if violation < 0.0f && sizes[i] < unclamped[i] {
                    frozen[i] = true;
                }
            }
        }
    }

    sizes
}

/**
 * @returns: a size clamped to the bounds of an item, its minimum winning over its maximum
 * */
fn clampItem(item: FlexItem, size: f32)-> f32 {
    max(min(size, item.max), item.min)
}

/**
 * @returns: the absolute value of 'x'
 * */
fn abs(x: f32)-> f32 {
    if x < 0.0f { -x } else { x }
}
