in grid;


use balder::utils;
use balder::interface::loader;
use balder::math::vector;

use std::algorithm::comparison;

/**
 * A grid lays its children out in cells of equal size
 * @info:
 * =====
 * A child is either put in a cell, or placed in the next free cell, row by row, after the cells the other children
 * take. As in a CSS grid, the grid has the columns and the rows it is given, and grows to the cells of its children.
 * ====
 * */
pub class GridLayout over Layout {

    // The widgets in the grid, in the order of their insertion
    let dmut _childs : [GridChild] = [];

    // The number of columns the grid has at least
    let _cols : u32;

    // The number of rows the grid has at least
    let _rows : u32;

    // The number of columns of the grid, its children placed
    let mut _gridCols : u32 = 1;

    // The number of rows of the grid, its children placed
    let mut _gridRows : u32 = 1;

    // Relative sizes computed on updateSize
    let mut _relCellSize : vec2 = vec2 ();

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - columns: the number of columns the grid has at least
     *    - rows: the number of rows the grid has at least
     * */
    pub self (dmut manager : &WidgetManager, id : [c8], columns : u32 = 0, rows : u32 = 0)
        with super (alias manager, id, WidgetKeys::GRID_LAYOUT)
        , _cols = columns
        , _rows = rows
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the drawing size of the inner widgets
     */
    over onUpdateSize (mut self) {
        self:.placeChildren ();
        if self._childs.len == 0 { return; }

        let nbCells = makeVec2 (cast!f32 (self._gridCols), cast!f32 (self._gridRows));
        let absCellSize = self._absoluteSize / nbCells;
        self._relCellSize = absCellSize / self._absoluteSize;

        if absCellSize.x <= 0.0f || absCellSize.y <= 0.0f {
            log::warn #("GridLayout", "Borders and margins are too big to display widgets");
            self:.hide ();

            return;
        }

        for j in 0us .. self._childs.len {
            let at = self._childs [j].at;
            let absCellPos = makeVec2 (cast!f32 (at._0), cast!f32 (at._1)) * absCellSize + self._absolutePosition;
            let (relPos, relSize) = self:.placeChild (alias self._childs [j].widget, absCellPos, absCellSize, self._depth + 1);

            self._childs [j].relPos = relPos;
            self._childs [j].relSize = relSize;
        }
    }

    over onUpdateScissors (mut self) {
        for dmut i in alias self._childs {
            self:.clipChild (alias i.widget, i.relPos, i.relSize);
        }
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over getMaxDepth (self)-> u32 {
        let mut max = self._depth;
        for i in self._childs {
            let chD = i.widget.getMaxDepth ();
            if chD > max { max = chD; }
        }

        max
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT CHILDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a child in the next free cell of the layout, row by row
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild (mut self, dmut ch : &Widget) {
        self._childs ~= [GridChild (alias ch)];
        self._manager:.updateWidgets ();
    }

    /**
     * Insert a child in a cell of the layout, replacing the child put in that cell
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild (mut self, col : u32, row : u32, dmut ch : &Widget) {
        self:.removeChild (col, row);
        self._childs ~= [GridChild (alias ch, cell-> ((col, row))?)];
        self._manager:.updateWidgets ();
    }

    /**
     * Put a child of the layout in a cell
     * */
    pub fn setCell (mut self, ch : &Widget, col : u32, row : u32) {
        for j in 0us .. self._childs.len {
            if self._childs [j].widget is ch {
                self._childs [j].cell = ((col, row))?;
            }
        }

        self._manager:.updateWidgets ();
    }

    /**
     * Remove the children put in a cell of the layout
     * @warning: the children are disposed
     * */
    pub fn removeChild (mut self, col : u32, row : u32) {
        let dmut keep : [GridChild] = [];
        for dmut i in alias self._childs {
            if let Ok (c) = i.cell && c == (col, row) {
                i.widget:.dispose ();
            } else {
                keep ~= [alias i];
            }
        }

        self._childs = alias keep;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of a grid is its cells, all as large as the largest content of a child
     * */
    prot over measureContentWidths (mut self)-> (f32, f32) {
        self:.placeChildren ();

        let mut minWidth = 0.0f, mut maxWidth = 0.0f;
        for dmut i in alias self._childs {
            let (minW, maxW) = i.widget:.measureIntrinsicWidths ();
            minWidth = max (minWidth, minW);
            maxWidth = max (maxWidth, maxW);
        }

        let cols = cast!f32 (self._gridCols);
        (minWidth * cols, maxWidth * cols)
    }

    prot over measureContentHeight (mut self, width : f32)-> f32 {
        self:.placeChildren ();

        let cellWidth = width / cast!f32 (self._gridCols);
        let mut height = 0.0f;
        for dmut i in alias self._childs {
            height = max (height, i.widget:.measureIntrinsicHeight (cellWidth));
        }

        height * cast!f32 (self._gridRows)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the grid, in the order of their insertion
     * */
    pub over getChildren (mut self)-> dmut [&Widget] {
        return copy [alias i.widget for dmut i in alias self._childs];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Place every child in its cell, the grid growing to the cells of its children
     * */
    fn placeChildren (mut self) {
        let cells = copy [i.cell for i in self._childs];
        let (placed, cols, rows) = GridLayout::place (cells, self._cols, self._rows);

        for j in 0us .. self._childs.len {
            self._childs [j].at = placed [j];
        }

        self._gridCols = cols;
        self._gridRows = rows;
    }

    /**
     * @returns:
     *  - .1 : the widget on which the mouse is positionned
     *  - .2 : the position of the mouse relative to the widget
     */
    prot over mouseToWidget (mut self, pos : vec2, ref mut canBeSelf : bool)-> dmut (&Widget, vec2)? {
        canBeSelf = false;

        if let Ok (inPaddingPos) = self.isInPadding (pos) {
            canBeSelf = true;

            if self._childs.len == 0 { return none; }

            let cellX = cast!u32 (inPaddingPos.x * cast!f32 (self._gridCols));
            let cellY = cast!u32 (inPaddingPos.y * cast!f32 (self._gridRows));

            if cellY >= self._gridRows || cellX >= self._gridCols { return none; }

            let cellPosition = makeVec2 ((self._relCellSize.x) * cast!f32 (cellX),
                                         (self._relCellSize.y) * cast!f32 (cellY));

            let relPos = (inPaddingPos - cellPosition) / self._relCellSize;
            if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                // the last child of a cell is drawn over the others
                for j in 0us .. self._childs.len {
                    let dmut c = alias self._childs [self._childs.len - 1us - j];
                    if c.at == (cellX, cellY) {
                        canBeSelf = false;
                        if let Ok (_) = c.widget.isInBorder (relPos) {
                            return (alias c.widget, relPos)?;
                        }

                        return none;
                    }
                }
            }
        }

        none
    }
}

/**
 * A child of a grid layout and its cell
 * */
record GridChild {

    pub let dmut widget : &Widget;

    // The cell the child was put in, none to place it in the next free cell
    pub let mut cell : ((u32, u32))?;

    // The cell the child is placed in
    pub let mut at : (u32, u32) = (0u32, 0u32);

    // The position and the size of the child relative to the grid
    pub let mut relPos : vec2 = vec2 ();
    pub let mut relSize : vec2 = vec2 ();

    pub self (dmut widget : &Widget, cell : ((u32, u32))? = none)
        with widget = alias widget
        , cell = cell
    {}
}

/**
 * The placement of the children of a grid
 * */
pub mod GridLayout {

    /**
     * Place the children of a grid: each one with a cell in it, the others in the next free cell, row by row, after
     * the cells taken before them
     * @params:
     *    - cells: the cell of each child, none to place it in the next free cell
     *    - columns: the number of columns the grid has at least
     *    - rows: the number of rows the grid has at least
     * @returns:
     *    - .0: the cell of each child
     *    - .1: the number of columns of the grid, grown to the columns of the cells
     *    - .2: the number of rows of the grid, grown to the rows of the cells
     * */
    pub fn place (cells : [((u32, u32))?], columns : u32, rows : u32)-> ([(u32, u32)], u32, u32) {
        let mut cols = max (columns, 1u32);
        let mut taken : [(u32, u32)] = [];
        for c in cells {
            if let Ok (cell) = c {
                cols = max (cols, cell._0 + 1u32);
                taken ~= [cell];
            }
        }

        let mut placed : [(u32, u32)] = [];
        let mut next = 0u32;
        let mut nbRows = max (rows, 1u32);
        for c in cells {
            let cell = if let Ok (cell) = c {
                cell
            } else {
                while isTaken (taken, (next % cols, next / cols)) { next += 1u32; }

                let free = (next % cols, next / cols);
                taken ~= [free];
                next += 1u32;
                free
            };

            nbRows = max (nbRows, cell._1 + 1u32);
            placed ~= [cell];
        }

        (placed, cols, nbRows)
    }

    /**
     * @returns: true iif cell is among the taken cells
     * */
    fn isTaken (taken : [(u32, u32)], cell : (u32, u32))-> bool {
        for t in taken {
            if t == cell { return true; }
        }

        false
    }
}
