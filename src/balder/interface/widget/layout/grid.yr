in grid;


use balder::utils;
use balder::interface::loader::registry::schema;
use balder::interface::style::{kinds, property};
use balder::interface::widget::alignement;
use balder::math::vector;

use std::algorithm::comparison;

/**
 * A grid lays its children out in cells, its columns and its rows sized by the tracks of its style
 * @info:
 * =====
 * A child is either put in a cell, or placed in the next free cell, row by row, after the cells the other children
 * take. As in a CSS grid, the grid has the columns and the rows its style gives (`columns: 1fr 2fr 120;`), and grows to
 * the cells of its children, a track it is not given taking 1fr: a grid given no track has cells of equal size.
 *
 * The tracks are sized as CSS sizes them: the lengths and the content sizes first, the auto tracks then growing from
 * their min-content to their max-content in the free space, and the shares in fr taking what is left. A share may be
 * smaller than the content of its cells (CSS's minmax(0, 1fr)).
 * ====
 * */
pub class GridLayout over Layout {

    // The widgets in the grid, in the order of their insertion
    let dmut _childs : [GridChild] = [];

    // The number of columns of the grid, its children placed
    let mut _gridCols : u32 = 1;

    // The number of rows of the grid, its children placed
    let mut _gridRows : u32 = 1;

    // The position and the size of each column, from the left of the inner box, in pixels
    let mut _colOffsets : [f32] = [];
    let mut _colSizes : [f32] = [];

    // The position and the size of each row, from the top of the inner box, in pixels
    let mut _rowOffsets : [f32] = [];
    let mut _rowSizes : [f32] = [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager : &WidgetManager, id : [c8])
        with super (alias manager, id, "GridLayout")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the drawing size of the inner widgets, each one stretched to its cell, the columns sized in the width of
     * the grid, then the rows in its height, the content of a cell measured at the width of its column
     */
    over onUpdateSize (mut self) {
        self:.placeChildren ();
        if self._childs.len == 0 { return; }

        if self._absoluteSize.x <= 0.0f || self._absoluteSize.y <= 0.0f {
            log::warn #("GridLayout", "Borders and margins are too big to display widgets");
            self:.hide ();

            return;
        }

        let columns = self.getTracks ("columns"), rows = self.getTracks ("rows");
        self._colSizes = GridLayout::resolveTracks (columns, self._gridCols, self._absoluteSize.x, self:.measureColumns (columns));
        self._rowSizes = GridLayout::resolveTracks (rows, self._gridRows, self._absoluteSize.y, self:.measureRows (rows, self._colSizes));
        self._colOffsets = GridLayout::offsets (self._colSizes);
        self._rowOffsets = GridLayout::offsets (self._rowSizes);

        for j in 0us .. self._childs.len {
            let at = self._childs [j].at;
            let cellPos = makeVec2 (self._colOffsets [at._0], self._rowOffsets [at._1]) + self._absolutePosition;
            let cellSize = makeVec2 (self._colSizes [at._0], self._rowSizes [at._1]);
            let (relPos, relSize) = self:.placeChild (alias self._childs [j].widget, cellPos, cellSize, self._depth + 1);

            self._childs [j].relPos = relPos;
            self._childs [j].relSize = relSize;
        }
    }

    over onUpdateScissors (mut self) {
        for dmut i in alias self._childs {
            self:.clipChild (alias i.widget, i.relPos, i.relSize);
        }
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over getMaxDepth (self)-> u32 {
        let mut max = self._depth;
        for i in self._childs {
            let chD = i.widget.getMaxDepth ();
            if chD > max { max = chD; }
        }

        max
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT CHILDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a child in the next free cell of the layout, row by row
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild (mut self, dmut ch : &Widget) {
        self._childs ~= [GridChild (alias ch)];
        self._manager:.updateWidgets ();
    }

    /**
     * Insert a child in a cell of the layout, replacing the child put in that cell
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild (mut self, col : u32, row : u32, dmut ch : &Widget) {
        self:.removeChild (col, row);
        self._childs ~= [GridChild (alias ch, cell-> ((col, row))?)];
        self._manager:.updateWidgets ();
    }

    /**
     * Put a child of the layout in a cell
     * */
    pub fn setCell (mut self, ch : &Widget, col : u32, row : u32) {
        for j in 0us .. self._childs.len {
            if self._childs [j].widget is ch {
                self._childs [j].cell = ((col, row))?;
            }
        }

        self._manager:.updateWidgets ();
    }

    /**
     * Remove the children put in a cell of the layout
     * @warning: the children are disposed
     * */
    pub fn removeChild (mut self, col : u32, row : u32) {
        let dmut keep : [GridChild] = [];
        for dmut i in alias self._childs {
            if let Ok (c) = i.cell && c == (col, row) {
                i.widget:.dispose ();
            } else {
                keep ~= [alias i];
            }
        }

        self._childs = alias keep;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of a grid is its tracks, each one as large as its track says, from the contents of its cells
     * */
    prot over measureContentWidths (mut self)-> (f32, f32) {
        self:.placeChildren ();

        let columns = self.getTracks ("columns");
        let contents = self:.measureColumns (columns, all-> true);
        (GridLayout::measureTracks (columns, self._gridCols, contents, minimum-> true),
         GridLayout::measureTracks (columns, self._gridCols, contents, minimum-> false))
    }

    prot over measureContentHeight (mut self, width : f32)-> f32 {
        self:.placeChildren ();

        let columns = self.getTracks ("columns"), rows = self.getTracks ("rows");
        let colSizes = GridLayout::resolveTracks (columns, self._gridCols, width, self:.measureColumns (columns));
        GridLayout::measureTracks (rows, self._gridRows, self:.measureRows (rows, colSizes, all-> true), minimum-> false)
    }

    /**
     * @returns: the min-content and max-content widths of the content of each column, the largest of its cells, measured
     * only when a track is sized by its content
     * @params:
     *    - columns: the tracks of the columns
     *    - all: true to measure them whatever the tracks
     * */
    fn measureColumns (mut self, columns : [Track], all : bool = false)-> [(f32, f32)] {
        let dmut result : [(f32, f32)] = copy [(0.0f, 0.0f) ; cast!usize (self._gridCols)];
        if !all && !GridLayout::needsContent (columns) { return result; }

        for dmut i in alias self._childs {
            let (minW, maxW) = i.widget:.measureIntrinsicWidths ();
            let c = cast!usize (i.at._0);
            result [c] = (max (result [c]._0, minW), max (result [c]._1, maxW));
        }

        result
    }

    /**
     * @returns: the height of the content of each row, the largest of its cells, each measured at the width of its
     * column, measured only when a track is sized by its content
     * @params:
     *    - rows: the tracks of the rows
     *    - colSizes: the widths of the columns
     *    - all: true to measure them whatever the tracks
     * */
    fn measureRows (mut self, rows : [Track], colSizes : [f32], all : bool = false)-> [(f32, f32)] {
        let dmut result : [(f32, f32)] = copy [(0.0f, 0.0f) ; cast!usize (self._gridRows)];
        if !all && !GridLayout::needsContent (rows) { return result; }

        for dmut i in alias self._childs {
            let h = i.widget:.measureIntrinsicHeight (colSizes [i.at._0]);
            let r = cast!usize (i.at._1);
            result [r] = (max (result [r]._0, h), max (result [r]._1, h));
        }

        result
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the grid, in the order of their insertion
     * */
    pub over getChildren (mut self)-> dmut [&Widget] {
        return copy [alias i.widget for dmut i in alias self._childs];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the tracks the style gives the columns or the rows, none when it gives none
     * @params:
     *    - name: the property, columns or rows
     * */
    fn getTracks (self, name : [c8])-> [Track] {
        if let Ok (tracks) = self.getStyle ().getCustom!{[Track]} (name) {
            return tracks;
        }

        []
    }

    /**
     * Place every child in its cell, the grid growing to the cells of its children
     * */
    fn placeChildren (mut self) {
        let cells = copy [i.cell for i in self._childs];
        let columns = self.getTracks ("columns").len, rows = self.getTracks ("rows").len;
        let (placed, nbCols, nbRows) = GridLayout::place (cells, cast!u32 (columns), cast!u32 (rows));

        for j in 0us .. self._childs.len {
            self._childs [j].at = placed [j];
        }

        self._gridCols = nbCols;
        self._gridRows = nbRows;
    }

    /**
     * @returns:
     *  - .1 : the widget on which the mouse is positionned
     *  - .2 : the position of the mouse relative to the widget
     */
    prot over mouseToWidget (mut self, pos : vec2, ref mut canBeSelf : bool)-> dmut (&Widget, vec2)? {
        canBeSelf = false;

        if let Ok (inPaddingPos) = self.isInPadding (pos) {
            canBeSelf = true;

            if self._childs.len == 0 { return none; }

            let px = inPaddingPos * self._absoluteSize;
            let (cellX, cellY) = if let Ok (x) = GridLayout::trackAt (self._colOffsets, self._colSizes, px.x) {
                if let Ok (y) = GridLayout::trackAt (self._rowOffsets, self._rowSizes, px.y) {
                    (x, y)
                } else { return none; }
            } else { return none; };

            let relPos = (px - makeVec2 (self._colOffsets [cellX], self._rowOffsets [cellY]))
                / makeVec2 (self._colSizes [cellX], self._rowSizes [cellY]);
            if relPos.x >= 0.0f && relPos.x <= 1.0f && relPos.y >= 0.0f && relPos.y <= 1.0f {
                // the last child of a cell is drawn over the others
                for j in 0us .. self._childs.len {
                    let dmut c = alias self._childs [self._childs.len - 1us - j];
                    if c.at == (cast!u32 (cellX), cast!u32 (cellY)) {
                        canBeSelf = false;
                        if let Ok (_) = c.widget.isInBorder (relPos) {
                            return (alias c.widget, relPos)?;
                        }

                        return none;
                    }
                }
            }
        }

        none
    }
}

/**
 * A child of a grid layout and its cell
 * */
record GridChild {

    pub let dmut widget : &Widget;

    // The cell the child was put in, none to place it in the next free cell
    pub let mut cell : ((u32, u32))?;

    // The cell the child is placed in
    pub let mut at : (u32, u32) = (0u32, 0u32);

    // The position and the size of the child relative to the grid
    pub let mut relPos : vec2 = vec2 ();
    pub let mut relSize : vec2 = vec2 ();

    pub self (dmut widget : &Widget, cell : ((u32, u32))? = none)
        with widget = alias widget
        , cell = cell
    {}
}

/**
 * The placement of the children of a grid, and the grids in a .gui file
 * */
pub mod GridLayout {

    /**
     * @returns: the schema of the grid layouts, each child being put in a cell with cell: column row, or placed in the
     * next free cell, their tracks being read from their style
     * */
    pub fn schema ()-> &WidgetSchema {
        copy WidgetSchema ("GridLayout",
                           |dmut m, id|-> dmut &Widget => copy GridLayout (alias m, id),
                           children-> (copy Inserter!{&GridLayout} (|dmut g, dmut c, _| => { g:.insertChild (alias c); }))?,
                           slots-> copy [copy SlotSetter!{&GridLayout, (u32, u32)} ("cell", |dmut g, c, cell| => {
                               g:.setCell (c, cell._0, cell._1);
                           })],
                           properties-> copy [GridLayout::columns (), GridLayout::rows ()])
    }

    /**
     * @returns: the property of the tracks of the columns of a grid (columns: 1fr 2fr 120)
     * */
    pub fn columns ()-> &WidgetProperty!{[Track]} {
        copy WidgetProperty!{[Track]} ("columns", &?tracks, affectsLayout-> true)
    }

    /**
     * @returns: the property of the tracks of the rows of a grid (rows: auto 1fr)
     * */
    pub fn rows ()-> &WidgetProperty!{[Track]} {
        copy WidgetProperty!{[Track]} ("rows", &?tracks, affectsLayout-> true)
    }

    /**
     * Size the tracks of a grid along an axis, as CSS does: the lengths, the percentages and the content sizes first,
     * then the auto tracks grown from their min-content to their max-content sharing the free space equally, then the
     * shares in fr taking what is left, the auto tracks stretched to it when there is no share
     * @params:
     *    - tracks: the tracks the style gives, a track past them taking 1fr
     *    - count: the number of tracks of the grid, its children placed
     *    - space: the size of the inner box of the grid along the axis, in pixels
     *    - contents: the min-content and max-content sizes of the content of each track, the largest of its cells
     * @returns: the size of each track, in pixels
     * */
    pub fn resolveTracks (tracks : [Track], count : u32, space : f32, contents : [(f32, f32)])-> [f32] {
        let n = cast!usize (count);
        let dmut sizes : [f32] = copy [0.0f ; n];
        let dmut limits : [f32] = copy [0.0f ; n];
        let dmut shares : [f32] = copy [0.0f ; n];
        let dmut auto : [bool] = copy [false ; n];

        let mut free = space;
        for i in 0us .. n {
            let t = GridLayout::trackOf (tracks, i);
            let (minC, maxC) = contents [i];
            match t.kind {
                TrackKind::PIXELS      => { sizes [i] = t.amount; }
                TrackKind::PERCENT     => { sizes [i] = t.amount / 100.0f * space; }
                TrackKind::MIN_CONTENT => { sizes [i] = minC; }
                TrackKind::MAX_CONTENT => { sizes [i] = maxC; }
                TrackKind::AUTO        => {
                    sizes [i] = minC;
                    limits [i] = max (minC, maxC);
                    auto [i] = true;
                }
                _ => { shares [i] = t.amount; }
            }

            free -= sizes [i];
        }

        // the auto tracks grow to their max-content, sharing the free space equally, a track stopping at its limit
        for _ in 0us .. n {
            let mut growing = 0u32;
            for i in 0us .. n {
                if auto [i] && sizes [i] < limits [i] { growing += 1u32; }
            }

            if growing == 0u32 || free <= 0.0f { break; }

            let share = free / cast!f32 (growing);
            for i in 0us .. n {
                if auto [i] && sizes [i] < limits [i] {
                    let add = min (share, limits [i] - sizes [i]);
                    sizes [i] += add;
                    free -= add;
                }
            }
        }

        let mut sum = 0.0f, mut autos = 0u32;
        for i in 0us .. n {
            sum += shares [i];
            if auto [i] { autos += 1u32; }
        }

        if free <= 0.0f { return sizes; }

        if sum > 0.0f {
            // a sum of shares under 1 takes only that part of the free space
            let unit = free / max (sum, 1.0f);
            for i in 0us .. n {
                sizes [i] += unit * shares [i];
            }
        } else if autos != 0u32 {
            let stretch = free / cast!f32 (autos);
            for i in 0us .. n {
                if auto [i] { sizes [i] += stretch; }
            }
        }

        sizes
    }

    /**
     * @returns: the size of the tracks of a grid along an axis when the grid is sized to its content, a share in fr
     * being as large as the largest content per fr of the shares
     * @params:
     *    - tracks: the tracks the style gives, a track past them taking 1fr
     *    - count: the number of tracks of the grid, its children placed
     *    - contents: the min-content and max-content sizes of the content of each track
     *    - minimum: true for the min-content size of the grid, false for its max-content size
     * */
    pub fn measureTracks (tracks : [Track], count : u32, contents : [(f32, f32)], minimum : bool)-> f32 {
        let n = cast!usize (count);
        let mut total = 0.0f, mut fraction = 0.0f, mut shares = 0.0f;
        for i in 0us .. n {
            let t = GridLayout::trackOf (tracks, i);
            let content = if minimum { contents [i]._0 } else { contents [i]._1 };
            match t.kind {
                TrackKind::PIXELS      => { total += t.amount; }
                TrackKind::MIN_CONTENT => { total += contents [i]._0; }
                TrackKind::MAX_CONTENT => { total += contents [i]._1; }
                TrackKind::SHARE       => {
                    fraction = max (fraction, content / max (t.amount, 1.0f));
                    shares += t.amount;
                }
                _ => { total += content; } // auto, and a percentage of a size that depends on the content
            }
        }

        total + fraction * shares
    }

    /**
     * @returns: the position of each track from the start of the grid, the tracks being side by side
     * */
    pub fn offsets (sizes : [f32])-> [f32] {
        let dmut result : [f32] = copy [0.0f ; sizes.len];
        let mut current = 0.0f;
        for i in 0us .. sizes.len {
            result [i] = current;
            current += sizes [i];
        }

        result
    }

    /**
     * @returns: the index of the track a position falls in, none when it is past the last one
     * @params:
     *    - offsets: the positions of the tracks
     *    - sizes: the sizes of the tracks
     *    - pos: the position, from the start of the grid
     * */
    pub fn trackAt (offsets : [f32], sizes : [f32], pos : f32)-> (usize)? {
        for i in 0us .. offsets.len {
            if pos >= offsets [i] && pos <= offsets [i] + sizes [i] { return (i)?; }
        }

        none
    }

    /**
     * @returns: true iif one of the tracks is sized by the content of its cells
     * */
    pub fn needsContent (tracks : [Track])-> bool {
        for t in tracks {
            if t.kind == TrackKind::AUTO || t.kind == TrackKind::MIN_CONTENT || t.kind == TrackKind::MAX_CONTENT {
                return true;
            }
        }

        false
    }

    /**
     * @returns: the i-th track, 1fr past the tracks given
     * */
    fn trackOf (tracks : [Track], i : usize)-> Track {
        if i < tracks.len { tracks [i] } else { Track (TrackKind::SHARE, 1.0f) }
    }

    /**
     * Place the children of a grid: each one with a cell in it, the others in the next free cell, row by row, after
     * the cells taken before them
     * @params:
     *    - cells: the cell of each child, none to place it in the next free cell
     *    - columns: the number of columns the grid has at least, the tracks its style gives
     *    - rows: the number of rows the grid has at least, the tracks its style gives
     * @returns:
     *    - .0: the cell of each child
     *    - .1: the number of columns of the grid, grown to the columns of the cells
     *    - .2: the number of rows of the grid, grown to the rows of the cells
     * */
    pub fn place (cells : [((u32, u32))?], columns : u32, rows : u32)-> ([(u32, u32)], u32, u32) {
        let mut cols = max (columns, 1u32);
        let mut taken : [(u32, u32)] = [];
        for c in cells {
            if let Ok (cell) = c {
                cols = max (cols, cell._0 + 1u32);
                taken ~= [cell];
            }
        }

        let mut placed : [(u32, u32)] = [];
        let mut next = 0u32;
        let mut nbRows = max (rows, 1u32);
        for c in cells {
            let cell = if let Ok (cell) = c {
                cell
            } else {
                while isTaken (taken, (next % cols, next / cols)) { next += 1u32; }

                let free = (next % cols, next / cols);
                taken ~= [free];
                next += 1u32;
                free
            };

            nbRows = max (nbRows, cell._1 + 1u32);
            placed ~= [cell];
        }

        (placed, cols, nbRows)
    }

    /**
     * @returns: true iif cell is among the taken cells
     * */
    fn isTaken (taken : [(u32, u32)], cell : (u32, u32))-> bool {
        for t in taken {
            if t == cell { return true; }
        }

        false
    }
}
