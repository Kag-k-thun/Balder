in overlay;

use balder::math::vector;
use balder::scene;
use balder::scene::node::node3D::visual;

/**
 * A widget covering a Scene3D, set as its overlay, reaching its scene and mapping the cursor to the image of the scene
 * @info: an overlay draws no background nor border by default, the scene being seen through it
 * */
@abstract
pub class SceneOverlay over Widget {

    // The 3D scene the widget covers, once set as its overlay
    let dmut _scene3D: (&Scene3DLayout)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot self (dmut manager: &WidgetManager, id: [c8], typeName: [c8])
        with super(alias manager, id, typeName)
    {
        self._hasBackground = false;
        self._hasBorder = false;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SCENE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Bind the overlay to the 3D scene it covers, done by the Scene3D it is set on (see Scene3DLayout.setOverlay)
     * */
    pub fn setScene3D(mut self, dmut scene3D: &Scene3DLayout) {
        self._scene3D = (alias scene3D)?;
    }

    /**
     * @returns: the scene the overlay covers, none before it is set on a Scene3D or before the scene is created
     * */
    pub fn getScene(mut self)-> dmut (&Scene)? {
        if let Ok(dmut s) = alias self._scene3D {
            return alias s:.getScene();
        }

        none
    }

    /**
     * @params:
     *    - pos: the position of the cursor relative to the overlay, between 0 and 1
     * @returns: the position under the cursor in the image of the scene, in pixels of the resolution the scene is
     * rendered at from its top left corner, none when the cursor is off the image or there is no scene
     * */
    pub fn renderPixel(self, pos: vec2)-> (vec2)? {
        if let Ok(s) = self._scene3D {
            return s.renderPixel(self._absoluteFullPosition + pos * self._absoluteFullSize);
        }

        none
    }

    /**
     * @params:
     *    - pos: the position of the cursor relative to the overlay, between 0 and 1
     * @returns: the visual instance the camera of the scene sees first under the cursor, none when it sees none there
     * */
    pub fn pickUnder(mut self, pos: vec2)-> dmut (&VisualInstance3D)? {
        if let Ok(pixel) = self.renderPixel(pos) {
            if let Ok(dmut scene) = alias self:.getScene() {
                return scene:.pick(pixel);
            }
        }

        none
    }

}
