in picker;

use balder::core::application::signal;
use balder::interface::loader::registry::schema;
use balder::interface::widget::layout::d3scene::overlay;
use balder::math::vector;
use balder::scene::editable;
use balder::scene::node::node3D;
use balder::scene::node::node3D::visual;

use ::sdl3::{keyboard, mouse};

/**
 * The overlay of a Scene3D picking the instances under the cursor: a click of the left button emits picked, a move of
 * the cursor emits hovered, and a selectable picker selects the instance clicked in the selection of the scene
 * @info: the instances are told apart by their world boxes (see Scene.pick); the instance under the cursor is looked
 * for only when a signal asks for it or the picker is selectable
 * */
pub class ScenePicker over SceneOverlay {

    // The signal emitted when the left button clicks the image of the scene, with the instance under the cursor
    let dmut _picked: (&Signal!{(&VisualInstance3D)?})? = none;

    // The signal emitted when the instance under the cursor changes, with the new one
    let dmut _hovered: (&Signal!{(&VisualInstance3D)?})? = none;

    // The uniq id of the instance under the cursor at the last emission of _hovered, none when there was none
    let mut _hoveredUid: (usize)? = none;

    // True iif a click selects the instance under the cursor in the selection of the scene
    let mut _selectable: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "ScenePicker")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Make a left click select the instance under the cursor in the selection of the scene (see Selection.click), or
     * leave the selection to the code
     * @info: the scene selects only when it is an EditableScene (editable: true)
     * */
    pub fn setSelectable(mut self, selectable: bool) {
        self._selectable = selectable;
    }

    /**
     * @returns: true iif a left click selects the instance under the cursor in the selection of the scene
     * */
    pub fn isSelectable(self)-> bool {
        self._selectable
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The instance under the cursor is looked for only when the hovered signal was asked for
     * */
    pub over onHover(mut self, pos: vec2)-> dmut (&Widget)? {
        if self._hovered.hasValue {
            let hit = self:.pickUnder(pos);
            self:.emitHovered(hit);
        }

        self.__super__:.onHover(pos)
    }

    pub over onLoseHoverFocus(mut self) {
        self:.emitHovered(none);
        self.__super__:.onLoseHoverFocus();
    }

    /**
     * A click of the left button picks the instance under the cursor, and selects it when the picker is selectable
     * */
    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if button == SDL_BUTTON_LEFT && (self._picked.hasValue || self._selectable) {
            let dmut hit = self:.pickUnder(pos);
            if let Ok(dmut s) = alias self._picked {
                s:.emit(hit);
            }

            if self._selectable {
                self:.selectUnder(alias hit);
            }
        }

        self.__super__:.onClick(pos, button)
    }

    /**
     * Select the instance under the cursor in the selection of the scene, as a click does with the modifiers held
     * @params:
     *    - hit: the instance under the cursor, none when the click is on none
     * */
    fn selectUnder(mut self, dmut hit: (&VisualInstance3D)?) {
        if let Ok(dmut scene: &EditableScene) = alias self:.getScene() {
            let dmut node: (&Node3D)? = if let Ok(dmut h) = alias hit { (alias h)? } else { none };
            let dmut selection = alias scene.selection;
            selection:.click(alias node, SDL_GetModState());
        }
    }

    /**
     * Emit the hovered signal when the instance under the cursor is not the one it was last emitted with
     * */
    fn emitHovered(mut self, hit: (&VisualInstance3D)?) {
        let uid = if let Ok(n) = hit { (n.uid)? } else { none };
        if uid == self._hoveredUid { return; }

        self._hoveredUid = uid;
        if let Ok(dmut s) = alias self._hovered {
            s:.emit(hit);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the left button clicks the image of the scene, with the visual instance the
     * camera sees first under the cursor, told apart by its world box, none when it sees none there
     * */
    pub fn picked(mut self)-> dmut &Signal!{(&VisualInstance3D)?} {
        if let Ok(dmut s) = alias self._picked {
            return alias s;
        }

        let dmut s = copy Signal!{(&VisualInstance3D)?} ();
        self._picked = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted when the visual instance the camera sees first under the cursor changes, with the new
     * one, none when the cursor leaves the instances or the picker
     * @info: the instance under the cursor is looked for at each move of the cursor once this signal is asked for
     * */
    pub fn hovered(mut self)-> dmut &Signal!{(&VisualInstance3D)?} {
        if let Ok(dmut s) = alias self._hovered {
            return alias s;
        }

        let dmut s = copy Signal!{(&VisualInstance3D)?} ();
        self._hovered = (alias s)?;

        alias s
    }

}

/**
 * The scene pickers in a .gui file
 * */
pub mod ScenePicker {

    /**
     * @returns: the schema of the scene pickers, the overlay of a Scene3D, a left click selecting the instance under the
     * cursor when selectable: true
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("ScenePicker",
                          |dmut m, id|-> dmut &Widget => copy ScenePicker(alias m, id),
                          attributes-> copy [copy Setter!{&ScenePicker, bool}("selectable", |dmut p, b| => {
                                                 p:.setSelectable(b);
                                             })])
    }
}
