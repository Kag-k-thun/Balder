in floating;

use balder::interface::loader::parser;
use balder::interface::loader::registry::schema;
use balder::math::vector;

use std::io;

use ::std::algorithm::comparison;

record Child {
    pub let dmut widget: &Widget;
    pub let mut propagate: bool;
    pub let mut level: u32;

    pub let mut pos: vec2  = vec2();
    pub let mut size: vec2 = vec2();

    pub self (dmut widget: &Widget, level: u32, propagate: bool)
        with widget = alias widget
        , propagate = propagate
        , level = level
    {}
}

/**
 * A layout of children drawn over each other, placed by the left, top, right and bottom of their style from the sides
 * of the content box of the layout, at the top left corner when they set none
 * @info:
 * =====
 * An auto width is the width of the content, fitted in the layout, or the space between the left and the right when
 * both are set; an auto height is the height of the content, or the space between the top and the bottom when both are
 * set. A child set at the right (or the bottom) only is placed against that side.
 * ====
 * */
pub class FloatingLayout over Layout {

    // The columns of the layout
    let dmut _childs: [Child] = [];

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "FloatingLayout")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the drawing size of the inner widgets
     * Floating layout are computed in last by the widget manager, and can be attached to another widget to be relative from it
     */
    over onUpdateSize(mut self) {
        let mut currentMaxDepth = self._depth;
        let container = self._absoluteSize;

        for col in 0 .. self._childs.len {
            let dmut w = alias self._childs[col].widget;
            let style = w.getStyle();
            let margins = w.getMarginSize(container);

            let (spaceX, startX, endX) = FloatingLayout::offsets(style.left, style.right, container.x);
            let (spaceY, startY, endY) = FloatingLayout::offsets(style.top, style.bottom, container.y);

            let width  = w:.measureWidth(container, spaceX, stretch-> startX.hasValue && endX.hasValue);
            let height = w:.measureHeight(width, container, spaceY, stretch-> startY.hasValue && endY.hasValue);
            let wsize  = makeVec2(width, height) + margins;

            let at = makeVec2(FloatingLayout::position(startX, endX, wsize.x, container.x),
                              FloatingLayout::position(startY, endY, wsize.y, container.y));

            let (relPos, relSize) = self:.placeChild(alias w, at + self._absolutePosition, wsize, currentMaxDepth + 1);

            self._childs[col].pos = relPos;
            self._childs[col].size = relSize;
            currentMaxDepth = self._childs[col].widget.getMaxDepth();
        }
    }

    over onUpdateScissors(mut self) {
        for dmut i in alias self._childs {
            self:.clipChild(alias i.widget, i.pos, i.size);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT CHILDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a child in the layout, placed by the left and the top of its style
     * @warning: child is disposed when layout is disposed
     * */
    pub fn insertChild(mut self, dmut ch: &Widget, withEvents: bool = true, level: u32 = 0) {
        self._childs ~= [Child(alias ch, propagate-> withEvents, level-> level)];
        std::algorithm::sorting::sort(alias self._childs, |x, y| => { x.level < y.level });

        self._manager:.updateWidgets();
    }

    /**
     * Set whether a child of the layout receives the events of the mouse, or lets them through to the children below
     * */
    pub fn setCaptureEvents(mut self, ch: &Widget, capture: bool) {
        for j in 0us .. self._childs.len {
            if self._childs[j].widget is ch {
                self._childs[j].propagate = capture;
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over getMaxDepth(self)-> u32 {
        let mut max = self._depth;
        for i in self._childs {
            let chD = i.widget.getMaxDepth();
            if chD > max { max = chD; }
        }

        max
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the layout, from the bottom one to the top one
     * */
    pub over getChildren(mut self)-> dmut [&Widget] {
        return copy [alias c.widget for dmut c in alias self._childs];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns:
     *  - .1 : the widget on which the mouse is positionned
     *  - .2 : the position of the mouse relative to the widget
     */
    prot over mouseToWidget(mut self, pos: vec2, ref mut canBeSelf: bool)-> dmut (&Widget, vec2)? {
        canBeSelf = false;
        if let Ok(inPaddingPos) = self.isInPadding(pos) {
            canBeSelf = true;

            for i in self._childs.len .. 0 {
                if self._childs[i - 1].propagate {
                    let a = self._childs[i - 1].pos;
                    let b = a + self._childs[i - 1].size;

                    if let Ok(relPos) = self.isInSquare(inPaddingPos, a, b) {
                        canBeSelf = false;
                        if let Ok(_) = self._childs[i - 1].widget.isInBorder(relPos) {
                            return (alias self._childs[i - 1].widget, relPos)?;
                        }
                    }
                }
            }
        }

        none
    }
}

/**
 * The floating layouts in a .gui file, and the placement of their children
 * */
pub mod FloatingLayout {

    /**
     * @returns: the space between two opposite positions of a child, and the offsets from the sides that are set
     * @params:
     *    - start: the left or the top of the child, if set
     *    - end: the right or the bottom of the child, if set
     *    - container: the size of the content box of the layout along the axis
     * */
    pub fn offsets(start: (bool, Length), end: (bool, Length), container: f32)-> (f32, (f32)?, (f32)?) {
        let s = if start._0 { ((start._1).resolve(container))? } else { none };
        let e = if end._0 { ((end._1).resolve(container))? } else { none };
        (container - (s ?? 0.0f) - (e ?? 0.0f), s, e)
    }

    /**
     * @returns: the position of the margin box of a child from the start of the layout: its start offset, or against
     * the end when only its end offset is set, at the start when neither is
     * @params:
     *    - start: the offset from the start side, if set
     *    - end: the offset from the end side, if set
     *    - size: the size of the margin box of the child
     *    - container: the size of the content box of the layout along the axis
     * */
    pub fn position(start: (f32)?, end: (f32)?, size: f32, container: f32)-> f32 {
        if let Ok(s) = start { return s; }
        if let Ok(e) = end { return container - e - size; }
        0.0f
    }

    /**
     * @returns: the schema of the floating layouts, their children being drawn in order, each one capturing the events
     * unless it says capture-events: false
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("FloatingLayout",
                          |dmut m, id|-> dmut &Widget => copy FloatingLayout(alias m, id),
                          children-> (copy Inserter!{&FloatingLayout}(|dmut f, dmut c, i| => {
                              f:.insertChild(alias c, level-> cast!u32(i));
                          }))?,
                          slots-> copy [copy SlotSetter!{&FloatingLayout, bool}("capture-events", |dmut f, c, b| => {
                              f:.setCaptureEvents(c, b);
                          })])
    }
}
