in layout;

pub mod ::linear;
pub mod ::floating;
pub mod ::grid;
pub mod ::scrollbar;
pub mod ::sizegrip;
pub mod ::tab;
pub mod ::menu;
pub mod ::d3scene;

use balder::core::dispose;
use balder::interface::widget::layout::menu;
use balder::math::vector;

use std::fs::path;
use std::time::dur;

/**
 * Ancestor class of the widgets laying other widgets out
 * A layout attaches, shows, hides, ticks, finds and disposes the children it lists in getChildren, places them with
 * placeChild and dispatches the mouse events to the child its mouseToWidget finds under the cursor
 * */
@abstract
pub class Layout over Widget {

    prot { // mouse events

        // The child the cursor was over the last, told when the cursor leaves it
        let dmut _lastHover : (&Widget)? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager : &WidgetManager, name : [c8], widgetKind : [c8])
        with super (alias manager,
                    name,
                    widgetKind)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHILDREN          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the children of the layout, those it attaches, shows, hides, ticks, finds and disposes
     * */
    pub fn getChildren (mut self)-> dmut [&Widget] {
        let dmut empty : [&Widget] = [];
        alias empty
    }

    pub over onAttach (mut self, parentPath : Path) {
        self.__super__:.onAttach (parentPath);

        let dmut children = self:.getChildren ();
        for dmut c in alias children {
            c:.onAttach (self._path);
        }
    }

    pub over setMenuContext (mut self, dmut menu : &MenuLayout) {
        self._menuContext = (alias menu)?;

        let dmut children = self:.getChildren ();
        for dmut c in alias children {
            c:.setMenuContext (alias menu);
        }
    }

    over onHide (mut self) {
        let dmut children = self:.getChildren ();
        for dmut c in alias children {
            c:.hide ();
        }
    }

    over onShow (mut self) {
        let dmut children = self:.getChildren ();
        for dmut c in alias children {
            c:.show ();
        }
    }

    /**
     * Propagate the tick events to the children
     * */
    pub over onTick (mut self, delta : Duration) {
        let dmut children = self:.getChildren ();
        for dmut c in alias children {
            c:.onTick (delta);
        }
    }

    pub over find (mut self, names : [[c8]])-> dmut (&Widget)? {
        if names.len == 0 { return none; }

        let dmut children = self:.getChildren ();
        for dmut c in alias children {
            if c.name == names [0] {
                if names.len == 1 { return (alias c)?; }
                else return c:.find (names [1 .. $]);
            }
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          PLACEMENT          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Place a child, cutting what it draws to the part of it inside the scissors of the layout
     * @params:
     *    - child: the child to place
     *    - pos: the absolute position of the child, in pixels
     *    - size: the absolute size of the child, in pixels
     *    - depth: the depth of the child
     * @returns: the position and the size of the child relative to the inner box of the layout
     * */
    @{final}
    prot fn placeChild (mut self, dmut child : &Widget, pos : vec2, size : vec2, depth : u32)-> (vec2, vec2) {
        child:.setSize (pos, size, depth);
        let (sciPos, sciSize) = self.getScissors (pos, size);
        child:.setScissors (sciPos, sciSize);

        ((pos - self._absolutePosition) / self._absoluteSize, size / self._absoluteSize)
    }

    /**
     * Cut what a child draws to the part of it inside the scissors of the layout
     * @params:
     *    - child: the child to cut
     *    - relPos: the position of the child relative to the inner box of the layout
     *    - relSize: the size of the child relative to the inner box of the layout
     * */
    @{final}
    prot fn clipChild (mut self, dmut child : &Widget, relPos : vec2, relSize : vec2) {
        let (sciPos, sciSize) = self.getScissors (relPos * self._absoluteSize + self._absolutePosition,
                                                  relSize * self._absoluteSize);
        child:.setScissors (sciPos, sciSize);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Propagate the signal to the child under the cursor
     * @params:
     *   - pos: the relative position of the cursor within the layout
     */
    pub over onHover (mut self, pos : vec2)-> dmut (&Widget)? {
        let mut canBeSelf = true;
        if let Ok ((dmut c, v)) = alias self:.mouseToWidget (pos, ref canBeSelf) {
            if let Ok (dmut w) = alias self._lastHover && c !is w {
                w:.onLoseHoverFocus ();
            }

            self._lastHover = (alias c)?;
            return c:.onHover (v);
        }

        if let Ok (dmut w) = alias self._lastHover {
            w:.onLoseHoverFocus ();
            self._lastHover = none;
        }

        if canBeSelf {
            self:.setHover (true);
            (alias self)?
        } else {
            none
        }
    }

    pub over onLoseHoverFocus (mut self) {
        if let Ok (dmut c) = alias self._lastHover {
            c:.onLoseHoverFocus ();
            self._lastHover = none;
        }

        self:.setHover (false);
    }

    /**
     * Propagate the signal to the child under the cursor
     */
    pub over onClick (mut self, pos : vec2, button : u8)-> dmut (&Widget)? {
        let mut canBeSelf = true;
        if let Ok ((dmut c, v)) = alias self:.mouseToWidget (pos, ref canBeSelf) {
            return c:.onClick (v, button);
        }

        if canBeSelf {
            (alias self)?
        } else {
            none
        }
    }

    /**
     * Propagate the signal to the child under the cursor
     */
    pub over onDoubleClick (mut self, pos : vec2)-> dmut (&Widget)? {
        let mut canBeSelf = true;
        if let Ok ((dmut c, v)) = alias self:.mouseToWidget (pos, ref canBeSelf) {
            return c:.onDoubleClick (v);
        }

        if canBeSelf {
            (alias self)?
        } else {
            none
        }
    }

    /**
     * Propagate the scrolling signal to the child under the cursor
     * */
    pub over onScroll (mut self, pos : vec2, amountX : i32, amountY : i32)-> bool {
        let mut ignore = true;
        let res = if let Ok ((dmut c, v)) = alias self:.mouseToWidget (pos, ref ignore) {
            c:.onScroll (v, amountX, amountY)
        } else { false };

        self:.onHover (pos);
        res
    }

    /**
     * @params:
     *  - pos: the position of the cursor relative to the layout
     *  - canBeSelf: set to false when the cursor is over none of the layout and its children
     * @returns:
     *  - .0 : the child under the cursor
     *  - .1 : the position of the cursor relative to the child
     */
    prot fn mouseToWidget (mut self, _ : vec2, ref mut canBeSelf : bool)-> dmut (&Widget, vec2)? {
        canBeSelf = true;
        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        pub over dispose (mut self) {
            self._attached = false;
            self._lastHover = none;

            let dmut children = self:.getChildren ();
            for dmut c in alias children {
                c:.dispose ();
            }

            self.__super__:.dispose ();
        }
    }

}
