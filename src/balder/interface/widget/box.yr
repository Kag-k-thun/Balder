in box;


use balder::interface::loader::registry::schema;
use balder::math::vector;

pub class Box over Widget {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager : &WidgetManager, id : [c8])
        with super (alias manager, id, "Box")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENT          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover (mut self, _ : vec2)-> dmut (&Widget)? {
        self:.setHover (true);
        (alias self)?
    }

    pub over onLoseHoverFocus (mut self) {
        self:.setHover (false);
    }

    pub over onClick (mut self, _ : vec2, _ : u8)-> dmut (&Widget)? {
        self:.setChecked (true);
        (alias self)?
    }

    pub over onClickEnd (mut self, _ : u8)-> dmut (&Widget)? {
        self:.setChecked (false);
        (alias self)?
    }

}

/**
 * The boxes in a .gui file
 * */
pub mod Box {

    /**
     * @returns: the schema of the boxes, taking no attribute and no children
     * */
    pub fn schema ()-> &WidgetSchema {
        copy WidgetSchema ("Box", |dmut m, id|-> dmut &Widget => copy Box (alias m, id))
    }
}
