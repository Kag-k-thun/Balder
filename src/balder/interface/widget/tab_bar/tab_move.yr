in tab_move;

/**
 * A tab of a tab bar dragged to another place among the tabs (see TabBar::moved)
 * @info: the tab at `from` before the move is at `to` after it, the tabs between the two shifting by one
 * */
@data
pub record TabMove {

    // The place of the tab before the move
    pub let from: usize = 0us;

    // The place of the tab after the move
    pub let to: usize = 0us;
}
