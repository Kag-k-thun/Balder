in texts;

use balder::interface::widget::list::model;

/**
 * A list model holding the texts of its items
 * */
@final
pub class TextListModel over ListModel {

    // The text of each item, in order
    let mut _items: [[c8]];

    /**
     * @params:
     *    - items: the text of each item, in order
     * */
    pub self (items: [[c8]] = [])
        with _items = items
    {}

    pub over len(self)-> usize {
        self._items.len
    }

    pub over text(self, index: usize)-> [c8] {
        self._items[index]
    }

    /**
     * Replace the items, the views showing the model reading it again
     * @params:
     *    - items: the text of each item, in order
     * */
    pub fn setItems(mut self, items: [[c8]]) {
        self._items = items;
        self.changed();
    }

    /**
     * @returns: the text of each item, in order
     * */
    pub fn getItems(self)-> [[c8]] {
        self._items
    }
}
