in model;

/**
 * The items a list view shows, read on demand: the view asks the number of items, and the text of the rows it shows only
 * @info:
 * =====
 * A model of the application derives from it to give items it computes or holds elsewhere, a million rows costing no
 * more than the dozen shown. A model whose items change calls `changed`, every view showing it reading it again.
 * ====
 * */
@abstract
pub class ListModel {

    // The views showing the model, told when its items change
    let mut _watchers: [dg ()-> void] = [];

    prot self () {}

    /**
     * @returns: the number of items
     * */
    pub fn len(self)-> usize;

    /**
     * @returns: the text of an item
     * @params:
     *    - index: the index of the item, below the number of items
     * */
    pub fn text(self, index: usize)-> [c8];

    /**
     * Tell the views showing the model to read it again, after its items changed
     * */
    pub fn changed(self) {
        for w in self._watchers {
            w();
        }
    }

    /**
     * Tell a view starting to show the model when its items change
     * @params:
     *    - watcher: called when the items change
     * */
    pub fn watch(mut self, watcher: dg ()-> void) {
        self._watchers ~= [watcher];
    }

    /**
     * Stop telling a view that no longer shows the model
     * @params:
     *    - watcher: the delegate given to watch
     * */
    pub fn unwatch(mut self, watcher: dg ()-> void) {
        let mut rest: [dg ()-> void] = [];
        for w in self._watchers {
            if w != watcher { rest ~= [w]; }
        }

        self._watchers = rest;
    }
}
