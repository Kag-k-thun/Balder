in rows_view;

use balder::core::dispose;
use balder::interface::style;
use balder::interface::widget::scrollbar;
use balder::interface::widget::list::{rows, selection};
use balder::math::vector;

use ::sdl3::{keyboard, keycode, mouse};

use ::std::algorithm::comparison;

// The number of rows a notch of the wheel scrolls by
def WHEEL_ROWS = 3.0;

/**
 * A view of rows of the same height, read on demand and recycled as it scrolls, a single row, or several, being selected
 * by the user
 * @info:
 * =====
 * The base of the list, the tree and the table views: it scrolls over its rows, shows the scrollbar, selects the rows
 * by the clicks and the keys (ListSelection), and styles the rows in their states. Only the rows shown exist, the item i
 * being drawn by the row i modulo their number; a view deriving from it creates its rows (`createRow`), gives them their
 * item (`fillRow`), measures their height (`measureRowHeight`), and emits its signals with its own items.
 *
 * The rows are the part `::row`, in the states `:hover` under the cursor, `:selected` for the selected rows and
 * `:current` for the row the keys move from. A view higher than its rows scrolls over them with the wheel or the part
 * `::scrollbar`, in the states `:hover` under the cursor and `:pressed` while it is dragged, drawn in the right padding,
 * the rows narrowing to leave it the room the padding does not. Rows wider than the view (`getContentWidth`) scroll
 * horizontally with Shift and the wheel, or a second `::scrollbar` drawn in the bottom padding. A view keeps the top of
 * its inner box for a header (`_headerHeight`), the rows scrolling below it. Its size is not measured from its rows: a
 * view is given a size by its style or by the layout stretching it.
 * ====
 * */
@abstract
pub class RowsView over Widget {

    prot { // the selection

        // The selected rows and the current row
        let dmut _selection: &ListSelection = copy ListSelection();
    }

    prot { // the rows

        // The scrollbar, shown when the rows are higher than the view
        let dmut _scrollbar: &Scrollbar;

        // The horizontal scrollbar, shown when the rows are wider than the view
        let dmut _hbar: &Scrollbar;

        // The part of the inner box above the rows, the header a view draws there, in pixels
        let mut _headerHeight: f32 = 0.0f;

        // The size of the part of the inner box the rows are shown in, below the header and beside the scrollbars
        let mut _rowsWidth: f32 = 0.0f;
        let mut _rowsHeight: f32 = 0.0f;

        // The rows drawn, the item i being drawn by the row i modulo their number, so that a row keeps its item while the
        // view scrolls past it
        let dmut _rows: [&Widget] = [];

        // The height of the margin box of a row, in pixels
        let mut _rowHeight: f32 = 0.0f;

        // The first item shown and the number of items shown
        let mut _first: usize = 0us;
        let mut _shown: usize = 0us;

        // The part of the rows scrolled over, in pixels
        let mut _offset: f64 = 0.0;

        // The part of the rows scrolled over horizontally, in pixels
        let mut _offsetX: f32 = 0.0f;

        // The item under the cursor, none when the cursor is over no row
        let mut _hover: (usize)? = none;
    }

    prot { // the styles of the parts of the rows

        // The style of a part of the rows in a combination of states, by the part followed by the states, computed when a
        // row first needs it
        let mut _partStyles: [[c8] => mut &Style] = copy [];

        // The style of the view the styles of the parts were computed with
        let mut _partStylesOf: (&Style)? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot self (dmut manager: &WidgetManager, id: [c8], typeName: [c8])
        with super(alias manager, id, typeName)
        , _scrollbar = copy Scrollbar(alias manager)
        , _hbar = copy Scrollbar(alias manager)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          ROWS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of rows
     * */
    pub fn getRowCount(self)-> usize;

    /**
     * @returns: a new row, drawing an item when the view gives it one
     * */
    prot fn createRow(mut self)-> dmut &Widget;

    /**
     * Give a row the item it draws, before it is placed
     * @params:
     *    - row: a row created by createRow
     *    - item: the item, below the number of rows
     * */
    prot fn fillRow(mut self, dmut row: &Widget, item: usize);

    /**
     * @returns: the height of the margin box of a row, laid out in a width
     * @params:
     *    - width: the width of the rows
     * */
    prot fn measureRowHeight(mut self, width: f32)-> f32;

    /**
     * @returns: the width of the rows, those wider than the view scrolling horizontally, 0 for rows as wide as the view
     * */
    prot fn getContentWidth(self)-> f32 {
        0.0f
    }

    /**
     * Emit the signal of the view telling the selected rows, after the user changed them
     * */
    prot fn emitSelected(mut self);

    /**
     * Emit the signal of the view telling the row activated
     * @params:
     *    - row: the row activated
     * */
    prot fn emitActivated(mut self, row: usize);

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SELECTION          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Allow the user to select several rows, or a single one, a single view keeping one of the selected rows
     * */
    pub fn setMultiple(mut self, multiple: bool) {
        if self._selection:.setMultiple(multiple) {
            self:.restyleRows();
        }
    }

    /**
     * @returns: true iif the user can select several rows
     * */
    pub fn isMultiple(self)-> bool {
        self._selection.isMultiple()
    }

    /**
     * Unselect every row, without emitting on-select
     * */
    pub fn clearSelection(mut self) {
        if self._selection:.clear() {
            self:.restyleRows();
        }
    }

    /**
     * Scroll the least so that a row is shown whole
     * @params:
     *    - row: the row, below the number of rows
     * */
    pub fn scrollToRow(mut self, row: usize) {
        if row >= self.getRowCount() { return; }

        self._offset = offsetShowing(row, self._rowHeight, self._offset, self._rowsHeight);
        self:.placeRows();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        self._rowHeight = self:.measureRowHeight(self._absoluteSize.x);
        self:.placeRows();
    }

    over onUpdateScissors(mut self) {
        let (sciPos, sciSize) = self.getRowsScissors();
        for dmut r in alias self._rows {
            r:.setScissors(sciPos, sciSize);
        }

        let (barPos, barSize) = self.getScissors(self._absolutePostBorderPosition, self._absolutePostBorderSize);
        self._scrollbar:.setScissors(barPos, barSize);
        self._hbar:.setScissors(barPos, barSize);
    }

    prot over onApplyStyle(mut self) {
        self:.restyleRows();
        self._scrollbar:.restyle(self);
        self._hbar:.restyle(self);
    }

    pub over getMaxDepth(self)-> u32 {
        // the scrollbars are drawn over the rows
        if self._scrollbar.isOverflowing() || self._hbar.isOverflowing() { self.getRowsDepth() + 1 } else { self.getRowsDepth() }
    }

    /**
     * The rows are not measured, only their height: a view fits in any size, and is as high as its rows at most
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        (0.0f, 0.0f)
    }

    prot over measureContentHeights(mut self, width: f32)-> (f32, f32) {
        let total = cast!f32(cast!u64(self.getRowCount())) * self:.measureRowHeight(width);
        (0.0f, total)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover(mut self, pos: vec2)-> dmut (&Widget)? {
        let inner = self.toInner(pos);
        if self._scrollbar.isUnder(inner) {
            self._hbar:.leave(self);
            self._scrollbar:.hover(self);
            self:.setHoverRow(none);
        } else if self._hbar.isUnder(inner) {
            self._scrollbar:.leave(self);
            self._hbar:.hover(self);
            self:.setHoverRow(none);
        } else {
            self._scrollbar:.leave(self);
            self._hbar:.leave(self);
            self:.setHoverRow(self.rowUnder(pos));
        }

        self:.setHover(true);
        (alias self)?
    }

    pub over onLoseHoverFocus(mut self) {
        self._scrollbar:.leave(self);
        self._hbar:.leave(self);
        self:.setHoverRow(none);
        self:.setHover(false);
    }

    /**
     * The left button grabs a scrollbar, or selects the row under it as the modifiers held say, unless the view uses the
     * click on that row (clickRow)
     * */
    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if button != SDL_BUTTON_LEFT { return (alias self)?; }

        let inner = self.toInner(pos);
        if self._scrollbar.isUnder(inner) {
            self._scrollbar:.grab(self, inner);
        } else if self._hbar.isUnder(inner) {
            self._hbar:.grab(self, inner);
        } else if let Ok(row) = self.rowUnder(pos) {
            if !self:.clickRow(row, self.toPixels(pos)) {
                let changed = self._selection:.click(row, SDL_GetModState());
                self:.showCurrent();
                if changed { self:.emitSelected(); }
            }
        }

        (alias self)?
    }

    /**
     * A double click activates the row under the cursor, the click before it having made it the current row
     * */
    pub over onDoubleClick(mut self, pos: vec2)-> dmut (&Widget)? {
        if let Ok(row) = self.rowUnder(pos) {
            self:.emitActivated(row);
        }

        (alias self)?
    }

    pub over onSliding(mut self, pos: vec2, _: vec2, _: u8) {
        if self._scrollbar.isGrabbed() && self._scrollbar.isOverflowing() {
            let total = cast!f64(cast!u64(self.getRowCount())) * cast!f64(self._rowHeight);
            self._offset = cast!f64(self._scrollbar.dragTo(self.toInner(pos), false)) * total;
            self:.placeRows();
        } else if self._hbar.isGrabbed() && self._hbar.isOverflowing() {
            self._offsetX = self._hbar.dragTo(self.toInner(pos), true) * self.getContentWidth();
            self:.placeRows();
        }
    }

    pub over onSlidingEnd(mut self, _: u8) {
        self._scrollbar:.release(self);
        self._hbar:.release(self);
    }

    /**
     * The wheel scrolls the rows by three rows a notch, horizontally with Shift held or along the horizontal axis of the
     * wheel, a view whose rows fit leaving it to its layout
     * */
    pub over onScroll(mut self, pos: vec2, amountX: i32, amountY: i32)-> bool {
        let shift = (SDL_GetModState() & SDL_KMOD_SHIFT) != 0u16;
        let (dx, dy) = if shift && amountX == 0 { (-amountY, 0) } else { (amountX, amountY) };
        let step = WHEEL_ROWS * cast!f64(self._rowHeight);

        let mut scrolled = false;
        if dy != 0 && self._scrollbar.isOverflowing() {
            self._offset -= cast!f64(dy) * step;
            scrolled = true;
        }

        if dx != 0 && self._hbar.isOverflowing() {
            self._offsetX += cast!f32(cast!f64(dx) * step);
            scrolled = true;
        }

        if !scrolled { return false; }

        self:.placeRows();
        self:.onHover(pos);
        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          FOCUS EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over isFocusableLeftClick(self)-> bool {
        true
    }

    pub over isFocusableByKeyboard(self)-> bool {
        true
    }

    /**
     * The rows are restyled as the view gains the focus, a sheet styling them in the state focus of the view
     * */
    pub over onGainFocus(mut self) {
        self:.restyleRows();
    }

    pub over onLoseFocus(mut self) {
        self._scrollbar:.release(self);
        self._hbar:.release(self);
        self:.restyleRows();
    }

    /**
     * The arrows, Page Up, Page Down, Home and End move the current row, scrolled to, and select as the modifiers held
     * say, as Space and Ctrl-A do; Enter activates the current row
     * */
    pub over onKeyPressed(mut self, key: SDL_Keycode, mods: SDL_Keymod)-> bool {
        if key == SDLK_RETURN || key == SDLK_KP_ENTER {
            return self:.activateCurrent(mods);
        }

        let page = fullRows(self._rowHeight, self._rowsHeight);
        if let Ok(changed) = self._selection:.pressKey(key, mods, page) {
            self:.showCurrent();
            if changed { self:.emitSelected(); }
            return true;
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self._hover = none;
        for dmut r in alias self._rows {
            r:.onAttach((self)?);
        }
    }

    over onHide(mut self) {
        for dmut r in alias self._rows {
            r:.hide();
        }

        self._scrollbar:.hide();
        self._hbar:.hide();
    }

    over onShow(mut self) {
        for i in self._first .. self._first + self._shown {
            self:.getRow(i):.show();
        }

        self._scrollbar:.show(self);
        self._hbar:.show(self);
    }

    impl Disposable {
        pub over dispose(mut self) {
            for dmut r in alias self._rows {
                r:.dispose();
            }

            self._rows = [];
            self._scrollbar:.dispose();
            self._hbar:.dispose();
            self.__super__:.dispose();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          PROTECTED          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read the rows again, after their number or their items changed: the rows past their number are unselected, and
     * the rows shown take their items again
     * */
    prot fn reloadRows(mut self) {
        self._selection:.setCount(self.getRowCount());
        if self._attached {
            self:.relayout();
        }
    }

    /**
     * Scroll to the current row, and restyle the rows
     * */
    prot fn showCurrent(mut self) {
        if let Ok(c) = self._selection.getCurrent() {
            self._offset = offsetShowing(c, self._rowHeight, self._offset, self._rowsHeight);
        }

        if self._attached {
            self:.placeRows();
        }
    }

    /**
     * Give each row shown the styles of its parts in its states
     * */
    prot fn restyleRows(mut self) {
        for i in self._first .. self._first + self._shown {
            if i < self.getRowCount() {
                self:.styleRow(alias self:.getRow(i), i);
            }
        }
    }

    /**
     * Give a row the style of the part ::row in the states of its item, a view styling the parts of its rows as well
     * @params:
     *    - row: the row
     *    - item: the item it draws
     * */
    prot fn styleRow(mut self, dmut row: &Widget, item: usize) {
        row:.setStyle(self:.getPartStyle("row", item));
    }

    /**
     * Use a click on a row before it selects the row, a view handling a click on a part of its rows
     * @params:
     *    - row: the row clicked
     *    - pos: the position of the cursor, in pixels from the top left corner of the inner box of the view
     * @returns: true iif the view used the click, the row not being selected
     * */
    prot fn clickRow(mut self, _: usize, _: vec2)-> bool {
        false
    }

    /**
     * @returns: the style of a part of the rows for an item, in its states: hover under the cursor, selected, and current
     * for the row the keys move from, followed by the states the view adds
     * @params:
     *    - part: the part, ::row or a part of a row
     *    - item: the item of the row
     *    - extra: the states of the part the view adds, after those of the row
     * */
    prot fn getPartStyle(mut self, part: [c8], item: usize, extra: [[c8]] = [])-> &Style {
        if let Ok(s) = self._partStylesOf && s !is self._currentStyle {
            self._partStyles = copy [];
        }

        self._partStylesOf = (self._currentStyle)?;

        let mut states: [[c8]] = [];
        if let Ok(h) = self._hover && h == item { states ~= ["hover"]; }
        if self._selection.isSelected(item) { states ~= ["selected"]; }
        if let Ok(c) = self._selection.getCurrent() && c == item { states ~= ["current"]; }
        states ~= extra;

        let mut key = part;
        for s in states { key = key ~ ":" ~ s; }
        if let Ok(s) = self._partStyles[key] {
            return s;
        }

        let style = if states.len == 0us {
            self._currentStyle.getSubStyle(part)
        } else {
            self._manager:.getStyleManager().computePart(self.getStylePath(), self._currentStyle, part, states-> states)
        };

        self._partStyles[key] = style;
        style
    }

    /**
     * @returns: the row drawing an item
     * */
    prot fn getRow(mut self, item: usize)-> dmut &Widget {
        alias self._rows[item % self._rows.len]
    }

    /**
     * @returns: the item under a position, none over no row or over the scrollbar
     * @params:
     *    - pos: the position of the cursor, relative to the margin box of the view
     * */
    prot fn rowUnder(self, pos: vec2)-> (usize)? {
        let inner = self.toPixels(pos);
        let y = inner.y - self._headerHeight;
        if inner.x < 0.0f || y < 0.0f || inner.x >= self._rowsWidth || y >= self._rowsHeight || self._rowHeight <= 0.0f {
            return none;
        }

        let item = cast!usize(cast!u64((cast!f64(y) + self._offset) / cast!f64(self._rowHeight)));
        if item < self.getRowCount() { (item)? } else { none }
    }

    /**
     * @returns: the scissors of the rows, the part of the inner box below the header
     * */
    prot fn getRowsScissors(self)-> (vec2, vec2) {
        let header = makeVec2(0.0f, min(self._headerHeight, self._absoluteSize.y));
        self.getScissors(self._absolutePosition + header, self._absoluteSize - header)
    }

    /**
     * @returns: a position relative to the margin box of the view, in pixels from the top left corner of its inner box
     * */
    prot fn toPixels(self, pos: vec2)-> vec2 {
        self._absoluteFullPosition + pos * self._absoluteFullSize - self._absolutePosition
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Scroll over the part of the rows kept within them, show the scrollbars when they are higher or wider than the part
     * of the view below the header, and give the items shown their rows, on top of each other, as wide as the view less
     * the vertical scrollbar or as wide as the content, the rows not used being hidden
     * */
    fn placeRows(mut self) {
        let count = self.getRowCount();
        let size = self._absoluteSize;
        let content = self.getContentWidth();
        let total = cast!f64(cast!u64(count)) * cast!f64(self._rowHeight);

        // the horizontal scrollbar takes the bottom of the inner box when the rows are wider than the view less the
        // vertical scrollbar they would show, then the vertical scrollbar its right side when they are higher than what
        // is left
        let tall = total > cast!f64(size.y - self._headerHeight);
        let guess = if tall { self._scrollbar.getThickness(self, false) } else { 0.0f };
        let wide = content > size.x - guess;
        let hbar = if wide { min(self._hbar.getOverlap(self, true), size.y) } else { 0.0f };
        let view = max(0.0f, size.y - self._headerHeight - hbar);

        self._offset = clampOffset(count, self._rowHeight, self._offset, view);
        if total <= cast!f64(view) || view <= 0.0f {
            self._scrollbar:.fit();
        } else {
            self._scrollbar:.setLength(cast!f32(cast!f64(view) / total));
            self._scrollbar:.scrollTo(cast!f32(self._offset / total));
        }

        let overflow = self._scrollbar.isOverflowing();
        let bar = if overflow { min(self._scrollbar.getOverlap(self, false), size.x) } else { 0.0f };
        let width = size.x - bar;
        if wide && width > 0.0f {
            self._offsetX = clamp(self._offsetX, 0.0f, max(0.0f, content - width));
            self._hbar:.setLength(width / content);
            self._hbar:.scrollTo(self._offsetX / content);
        } else {
            self._offsetX = 0.0f;
            self._hbar:.fit();
        }

        self._rowsWidth = width;
        self._rowsHeight = view;

        let (first, shown) = visibleRows(count, self._rowHeight, self._offset, view);
        self:.ensureRows(shown);
        self._first = first;
        self._shown = shown;

        let (sciPos, sciSize) = self.getRowsScissors();
        let dmut used = copy [false; self._rows.len];
        for i in first .. first + shown {
            used[i % self._rows.len] = true;

            let top = cast!f64(cast!u64(i)) * cast!f64(self._rowHeight) - self._offset;
            let pos = self._absolutePosition + makeVec2(-self._offsetX, self._headerHeight + cast!f32(top));

            let dmut row = self:.getRow(i);
            self:.styleRow(alias row, i);
            self:.fillRow(alias row, i);
            row:.setSize(pos, makeVec2(max(width, content), self._rowHeight), self._depth + 1, size);
            row:.setScissors(sciPos, sciSize);
            if self.isDrawn() { row:.show(); }
        }

        for j, dmut r in alias self._rows {
            if !used[j] { r:.hide(); }
        }

        let (barPos, barSize) = self.getScissors(self._absolutePostBorderPosition, self._absolutePostBorderSize);
        if overflow {
            self._scrollbar:.place(self, false, barPos, barSize, self.getRowsDepth() + 1);
        }

        if self._hbar.isOverflowing() {
            self._hbar:.place(self, true, barPos, barSize, self.getRowsDepth() + 1);
        }
    }

    /**
     * Create the rows missing for a number of items to be shown, their number never decreasing so that the items keep
     * their rows
     * */
    fn ensureRows(mut self, shown: usize) {
        while self._rows.len < shown {
            let dmut row = self:.createRow();
            if self._attached {
                row:.onAttach((self)?);
            }

            self._rows ~= [alias row];
        }
    }

    /**
     * Put an item under the cursor, restyling the rows when it changes
     * */
    fn setHoverRow(mut self, item: (usize)?) {
        if item == self._hover { return; }

        self._hover = item;
        self:.restyleRows();
    }

    /**
     * Emit the signal of activation with the current row, Enter being pressed without Ctrl, Alt or Command
     * @returns: true iif there is a current row to activate
     * */
    fn activateCurrent(mut self, mods: SDL_Keymod)-> bool {
        if (mods & (SDL_KMOD_CTRL | SDL_KMOD_ALT | SDL_KMOD_GUI)) != 0u16 { return false; }

        if let Ok(c) = self._selection.getCurrent() {
            self:.emitActivated(c);
            return true;
        }

        false
    }

    /**
     * @returns: the depth of the deepest row, the view's own when it has none
     * */
    fn getRowsDepth(self)-> u32 {
        let mut depth = self._depth;
        for r in self._rows {
            depth = max(depth, r.getMaxDepth());
        }

        depth
    }

    /**
     * @returns: a position relative to the view, relative to its inner box
     * */
    fn toInner(self, pos: vec2)-> vec2 {
        let a = (self._absolutePosition - self._absoluteFullPosition) / self._absoluteFullSize;
        let b = self._absoluteSize / self._absoluteFullSize;

        (pos - a) / b
    }
}
