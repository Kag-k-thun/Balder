/**
 * The rows of a list of rows of the same height that a view shows, scrolled over a part of them
 * @info:
 * =====
 * The rows are laid out on top of each other from 0, the row i covering [i * height, (i + 1) * height). The view shows
 * the part [offset, offset + view) of them, offset being the part scrolled over, in pixels. The offsets are f64, so that
 * a million rows are still placed to the pixel.
 * ====
 * */
in rows;

use ::std::algorithm::comparison;

/**
 * @returns: the first row a view shows and the number of rows it shows, those it shows a part of included
 * @params:
 *    - count: the number of rows
 *    - height: the height of a row, in pixels
 *    - offset: the part of the rows scrolled over, in pixels
 *    - view: the height of the view, in pixels
 * */
pub fn visibleRows(count: usize, height: f32, offset: f64, view: f32)-> (usize, usize) {
    if count == 0us || height <= 0.0f || view <= 0.0f { return (0us, 0us); }

    let h = cast!f64(height);
    let top = max(0.0, offset);
    let first = min(rowAt(top, h), count - 1us);

    // the last row is the one holding the last pixel shown
    let last = min(rowAt(top + cast!f64(view) - 0.001, h), count - 1us);
    (first, last - first + 1us)
}

/**
 * @returns: the number of rows a view shows whole, at least 1, the number of rows Page Up and Page Down move by
 * @params:
 *    - height: the height of a row, in pixels
 *    - view: the height of the view, in pixels
 * */
pub fn fullRows(height: f32, view: f32)-> usize {
    if height <= 0.0f || view <= height { return 1us; }

    rowAt(cast!f64(view), cast!f64(height))
}

/**
 * @returns: the part of the rows to scroll over for a row to be shown whole, the least scroll from an offset, the row
 * shown at the top when it is higher than the view
 * @params:
 *    - row: the row to show
 *    - height: the height of a row, in pixels
 *    - offset: the part of the rows scrolled over, in pixels
 *    - view: the height of the view, in pixels
 * */
pub fn offsetShowing(row: usize, height: f32, offset: f64, view: f32)-> f64 {
    let top = cast!f64(cast!u64(row)) * cast!f64(height);
    let bottom = top + cast!f64(height);
    if top < offset || bottom - top > cast!f64(view) {
        top
    } else if bottom > offset + cast!f64(view) {
        bottom - cast!f64(view)
    } else {
        offset
    }
}

/**
 * @returns: the part of the rows to scroll over kept within them, from 0 to their height less the view, 0 when they fit
 * in the view
 * @params:
 *    - count: the number of rows
 *    - height: the height of a row, in pixels
 *    - offset: the part of the rows to scroll over, in pixels
 *    - view: the height of the view, in pixels
 * */
pub fn clampOffset(count: usize, height: f32, offset: f64, view: f32)-> f64 {
    let total = cast!f64(cast!u64(count)) * cast!f64(height);
    clamp(offset, 0.0, max(0.0, total - cast!f64(view)))
}

/**
 * @returns: the row holding a position, the rows being of a height
 * */
fn rowAt(position: f64, height: f64)-> usize {
    cast!usize(cast!u64(position / height))
}
