in label;

use balder::utils;
use balder::core::dispose;
use balder::interface::loader;
use balder::interface::font::{chain, family};
use balder::interface::widget::alignement;
use balder::math::vector;

use std::io;
use std::algorithm::comparison;
use std::fs::path;

pub class Label over Widget {

    // The text displayed by the label, in UTF-8
    let mut _text: [c8];

    prot { // Display configuration

        let mut _forceAlign: bool = false;

        let mut _relTextSize: vec2 = vec2();

        let mut _relTextPos: vec2 = vec2();

        let mut _relFontSize: u32 = 0u32;

        // The families, weight and style the text was shaped with
        let mut _relFont: ([[c8]], u32, FontStyle) = ([], 0u32, FontStyle::NORMAL);

        // The pixel ratio the text was shaped at
        let mut _relRatio: f32 = 0.0f;
    }

    prot {

        // True if the text is shaped and drawn by the text shape
        let mut _shaped: bool = false;

        // The size of the shaped text in window units
        let mut _textSize: vec2 = vec2();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, name: [c8])
        with super(alias manager, name, WidgetKeys::LABEL)
        , _text = ""
    {
        self._hasBackground = false;
        self._hasBorder = false;
    }

    over onApplyStyle(mut self) {
        let ratio = self._manager:.getShapeDrawer().getPixelRatio();
        if self._relFont != self.getFont() || self._relFontSize != self.getFontSize() || self._relRatio != ratio {
            if self._attached && self._text != "" {
                self:.setText(self._text, force-> true);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parentPath: Path) {
        self.__super__:.onAttach(parentPath);
        self:.setText(self._text, force-> true);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZES          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        if self._shaped {
            let relSize = self._textSize / self._absoluteSize;

            let xalign = if self._forceAlign { XAlign::NONE } else { self.getStyle().xalign._1 };
            let yalign = if self._forceAlign { YAlign::CENTER } else { self.getStyle().yalign._1 };

            let mut x = if xalign == XAlign::LEFT || xalign == XAlign::NONE {
                0.0f
            } else if xalign == XAlign::RIGHT {
                1.0f - relSize.x
            } else { 0.5f - (relSize.x / 2.0f) };

            let mut y = if yalign == YAlign::TOP {
                0.0f
            } else if yalign == YAlign::BOTTOM {
                1.0f - relSize.y
            } else { 0.5f - (relSize.y / 2.0f) };

            if xalign == XAlign::NONE {
                x = max(0.0f, x);
            }

            y = max(0.0f, y);

            self._relTextPos = makeVec2(x, y);
            self._relTextSize = relSize;
        } else {
            self:.hide();
            self._relTextSize = vec2();
            self._relTextPos = vec2();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the text of the label
     * */
    pub fn setText(mut self, text: [c8], force: bool = false) {
        if !force && self._text == text { // nothing to do
            return;
        }

        self._text = text;

        if self._attached {
            self._relFont = self.getFont();
            self._relFontSize = self.getFontSize();
            self._relRatio = self._manager:.getShapeDrawer().getPixelRatio();

            self._shaped = false;
            if text.len != 0us {
                let ratio = self._relRatio;
                {
                    let dmut chain = self:.getFontChain();
                    let run = self._manager:.getFontManager():.shape(text, alias chain, self.getFontSize(), pixelRatio-> ratio);

                    self:.registerTextShape(WidgetShapeKind::TEXT, alias chain, run);
                    self._textSize = makeVec2(run.width / ratio, run.getHeight() / ratio);
                    self._shaped = true;
                } catch {
                    err => {
                        log::error #("Label", "failed to set text : ", err);
                    }
                }
            }

            if !self._shaped {
                self:.removeShape(WidgetShapeKind::TEXT);
            }

            self:.show();
            self:.computeSize();
        }
    }

    /**
     * Change the vertical alignement of the label
     * */
    pub fn forceAlign(mut self, force: bool) {
        self._forceAlign = force;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the font used by the label, its families, weight and style
     * */
    pub fn getFont(self)-> ([[c8]], u32, FontStyle) {
        let style = self.getStyle();
        (style.fontFamily._1, style.fontWeight._1, style.fontStyle._1)
    }

    /**
     * @returns: the chain of faces the text of the label is drawn with
     * */
    pub fn getFontChain(mut self)-> dmut &FontChain {
        let (families, weight, style) = self.getFont();
        self._manager:.getFontManager():.getChain(families, weight-> weight, style-> style)
    }

    /**
     * @returns: the size of the font
     * */
    pub fn getFontSize(self)-> u32 {
        self.getStyle().fontSize._1
    }

    /**
     * @returns: the size of the displayed text in pixels
     * */
    pub fn getTextSize(self)-> vec2 {
        self._relTextSize * self._absoluteSize
    }

    /**
     * @returns: the position of the displayed text in pixels
     * */
    pub fn getTextPos(self)-> vec2 {
        self._absolutePosition + (self._relTextPos * self._absoluteSize)
    }

    /**
     * @returns: the position and size of the shapes
     * */
    prot over getShapePositionAndSize(self, kind: WidgetShapeKind)-> (vec2, vec2) {
        match kind {
            WidgetShapeKind::TEXT => {
                let ret = (self._absolutePosition + (self._relTextPos * self._absoluteSize),
                           self._relTextSize * self._absoluteSize);

                ret
            }
            _ => {
                self.__super__.getShapePositionAndSize(kind)
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._attached = false;
            self._shaped = false;

            self._super_:.dispose();
        }
    }
}
