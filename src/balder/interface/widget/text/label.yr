in label;

use balder::utils;
use balder::core::dispose;
use balder::interface::loader;
use balder::interface::font::{chain, family, layout};
use balder::interface::widget::alignement;
use balder::math::vector;

use std::algorithm::comparison;
use std::fs::path;

pub class Label over Widget {

    // The text displayed by the label, in UTF-8
    let mut _text: [c8];

    prot { // Display configuration

        let mut _forceAlign: bool = false;

        // True if the lines are never wrapped, whatever the text-wrap of the style
        let mut _forceNoWrap: bool = false;

        let mut _relTextSize: vec2 = vec2();

        let mut _relTextPos: vec2 = vec2();

        let mut _relFontSize: u32 = 0u32;

        // The families, weight and style the text was shaped with
        let mut _relFont: ([[c8]], u32, FontStyle) = ([], 0u32, FontStyle::NORMAL);

        // The pixel ratio the text was shaped at
        let mut _relRatio: f32 = 0.0f;

        // The part of their free space put on the left of the lines they were laid out with
        let mut _relAlign: f32 = 0.0f;

        // The width the lines were wrapped to in window units, 0 if they were not wrapped
        let mut _relWrap: f32 = 0.0f;
    }

    prot {

        // True if the text is shaped and drawn by the text shape
        let mut _shaped: bool = false;

        // The size of the laid out text in window units, the width of its widest line and the height of its lines
        let mut _textSize: vec2 = vec2();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, name: [c8])
        with super(alias manager, name, WidgetKeys::LABEL)
        , _text = ""
    {
        self._hasBackground = false;
        self._hasBorder = false;
    }

    over onApplyStyle(mut self) {
        let ratio = self._manager:.getShapeDrawer().getPixelRatio();
        if self._relFont != self.getFont() || self._relFontSize != self.getFontSize() || self._relRatio != ratio || self._relAlign != self.getLineAlign() || self._relWrap != self.getWrapWidth() {
            if self._attached && self._text != "" {
                self:.setText(self._text, force-> true);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parentPath: Path) {
        self.__super__:.onAttach(parentPath);
        self:.setText(self._text, force-> true);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAW SIZES          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        // the lines are laid out again when the width they are wrapped to changes
        if self._attached && self._text.len != 0us && (self._relAlign != self.getLineAlign() || self._relWrap != self.getWrapWidth()) {
            self:.layoutText();
        }

        if self._shaped {
            let relSize = self._textSize / self._absoluteSize;

            let xalign = if self._forceAlign { XAlign::NONE } else { self.getStyle().xalign._1 };
            let yalign = if self._forceAlign { YAlign::CENTER } else { self.getStyle().yalign._1 };

            let mut x = if xalign == XAlign::LEFT || xalign == XAlign::NONE {
                0.0f
            } else if xalign == XAlign::RIGHT {
                1.0f - relSize.x
            } else { 0.5f - (relSize.x / 2.0f) };

            let mut y = if yalign == YAlign::TOP {
                0.0f
            } else if yalign == YAlign::BOTTOM {
                1.0f - relSize.y
            } else { 0.5f - (relSize.y / 2.0f) };

            if xalign == XAlign::NONE {
                x = max(0.0f, x);
            }

            y = max(0.0f, y);

            self._relTextPos = makeVec2(x, y);
            self._relTextSize = relSize;
        } else {
            self._relTextSize = vec2();
            self._relTextPos = vec2();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the text of the label
     * */
    pub fn setText(mut self, text: [c8], force: bool = false) {
        if !force && self._text == text { // nothing to do
            return;
        }

        self._text = text;

        if self._attached {
            self:.layoutText();
            self:.relayout();
        }
    }

    /**
     * Change the vertical alignement of the label
     * */
    pub fn forceAlign(mut self, force: bool) {
        self._forceAlign = force;
    }

    /**
     * Keep the lines of the label unwrapped, whatever the text-wrap of its style
     * */
    pub fn forceNoWrap(mut self, force: bool) {
        self._forceNoWrap = force;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the font used by the label, its families, weight and style
     * */
    pub fn getFont(self)-> ([[c8]], u32, FontStyle) {
        let style = self.getStyle();
        (style.fontFamily._1, style.fontWeight._1, style.fontStyle._1)
    }

    /**
     * @returns: the chain of faces the text of the label is drawn with
     * */
    pub fn getFontChain(mut self)-> dmut &FontChain {
        let (families, weight, style) = self.getFont();
        self._manager:.getFontManager():.getChain(families, weight-> weight, style-> style)
    }

    /**
     * @returns: the part of their free space put on the left of the lines of the text, from its horizontal alignment
     * */
    pub fn getLineAlign(self)-> f32 {
        let xalign = if self._forceAlign { XAlign::NONE } else { self.getStyle().xalign._1 };
        if xalign == XAlign::RIGHT {
            1.0f
        } else if xalign == XAlign::CENTER {
            0.5f
        } else { 0.0f }
    }

    /**
     * @returns: the width the lines of the text are wrapped to in window units, the width of the label when its style
     * sets text-wrap to wrap, 0 if the lines are not wrapped
     * */
    pub fn getWrapWidth(self)-> f32 {
        if !self.isWrapped() {
            return 0.0f;
        }

        self._absoluteSize.x
    }

    /**
     * @returns: true iif the lines of the text are wrapped to the width of the label, its style setting text-wrap to wrap
     * */
    pub fn isWrapped(self)-> bool {
        !self._forceNoWrap && self.getStyle().textWrap._1
    }

    /**
     * @returns: the size of the font
     * */
    pub fn getFontSize(self)-> u32 {
        self.getStyle().fontSize._1
    }

    /**
     * @returns: the size of the displayed text in pixels
     * */
    pub fn getTextSize(self)-> vec2 {
        self._relTextSize * self._absoluteSize
    }

    /**
     * @returns: the position of the displayed text in pixels
     * */
    pub fn getTextPos(self)-> vec2 {
        self._absolutePosition + (self._relTextPos * self._absoluteSize)
    }

    /**
     * @returns: the position and size of the shapes
     * */
    prot over getShapePositionAndSize(self, kind: WidgetShapeKind)-> (vec2, vec2) {
        match kind {
            WidgetShapeKind::TEXT => {
                let ret = (self._absolutePosition + (self._relTextPos * self._absoluteSize),
                           self._relTextSize * self._absoluteSize);

                ret
            }
            _ => {
                self.__super__.getShapePositionAndSize(kind)
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of a label is its text, as narrow as its widest word when its lines are wrapped, as wide as its
     * widest line otherwise
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        if self._text.len == 0us { return (0.0f, 0.0f); }

        let ratio = self._manager:.getShapeDrawer().getPixelRatio();
        {
            let dmut chain = self:.getFontChain();
            let dmut fonts = self._manager:.getFontManager();
            let maxWidth = fonts:.layout(self._text, alias chain, self.getFontSize(), pixelRatio-> ratio).width / ratio;
            let minWidth = if self.isWrapped() {
                fonts:.measureMinContent(self._text, alias chain, self.getFontSize(), pixelRatio-> ratio) / ratio
            } else { maxWidth };

            (minWidth, maxWidth)
        } catch {
            err => {
                log::error #("Label", "failed to measure the text : ", err);
                (0.0f, 0.0f)
            }
        }
    }

    /**
     * The height of the lines of the text, wrapped to 'width' when the style sets text-wrap to wrap
     * */
    prot over measureContentHeight(mut self, width: f32)-> f32 {
        if self._text.len == 0us { return 0.0f; }

        let ratio = self._manager:.getShapeDrawer().getPixelRatio();
        let maxWidth = if self.isWrapped() { width * ratio } else { f32::max };
        {
            let dmut chain = self:.getFontChain();
            self._manager
                :.getFontManager()
                :.layout(self._text, alias chain, self.getFontSize(), pixelRatio-> ratio, maxWidth-> maxWidth)
                .height / ratio
        } catch {
            err => {
                log::error #("Label", "failed to measure the text : ", err);
                0.0f
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Lay the text out in lines with the font of the label, broken at its line breaks and wrapped to the width of the
     * label when its style sets text-wrap to wrap, and register the shape drawing it
     * */
    fn layoutText(mut self) {
        self._relFont = self.getFont();
        self._relFontSize = self.getFontSize();
        self._relRatio = self._manager:.getShapeDrawer().getPixelRatio();
        self._relAlign = self.getLineAlign();
        self._relWrap = self.getWrapWidth();

        self._shaped = false;
        if self._text.len != 0us {
            let ratio = self._relRatio;
            let maxWidth = if self._relWrap > 0.0f { self._relWrap * ratio } else { f32::max };
            {
                let dmut chain = self:.getFontChain();
                let text = self._manager
                    :.getFontManager()
                    :.layout(self._text, alias chain, self.getFontSize(), pixelRatio-> ratio, maxWidth-> maxWidth, align-> self._relAlign);

                self:.registerTextShape(WidgetShapeKind::TEXT, alias chain, text);
                self._textSize = makeVec2(text.width / ratio, text.height / ratio);
                self._shaped = true;
            } catch {
                err => {
                    log::error #("Label", "failed to lay the text out : ", err);
                }
            }
        }

        if !self._shaped {
            self:.removeShape(WidgetShapeKind::TEXT);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._attached = false;
            self._shaped = false;

            self._super_:.dispose();
        }
    }
}
