in rail_tool;

use balder::interface::widget::dock_rail::rail_section;

/**
 * A tool of a dock rail: the icon button showing a panel of the dock
 *
 * */
@data
pub record RailTool {

    // The id of the tool, the id of its button in the rail
    pub let id: [c8] = "";

    // What the tool shows, told by the tooltip of its button
    pub let name: [c8] = "";

    // The SVG file of its icon
    pub let icon: [c8] = "";

    // The part of the rail it is in
    pub let section: RailSection = RailSection::TOP;

    // True for a tool at the foot of the rail, in the bottom section, never dragged
    pub let foot: bool = false;
}
