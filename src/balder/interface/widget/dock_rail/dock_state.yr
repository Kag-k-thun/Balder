in dock_state;

use balder::interface::widget::dock_rail::rail_section;

/**
 * What a dock shows: the tool pressed in its top slot and in its bottom slot,
 * "" for none, and whether the whole dock is folded
 *
 * @info: an open dock shows the panel of the tool pressed in each slot: two
 * panels share it, split by its grip, one fills it, none leaves its room to the
 * viewport, as a fold does; a folded dock keeps the tools pressed, shown again
 * when it opens
 *
 * */
@data
pub record DockState {

    // The tool pressed in the top slot, "" for none
    pub let top: [c8] = "";

    // The tool pressed in the bottom slot, "" for none
    pub let bottom: [c8] = "";

    // True while the whole dock is folded
    pub let folded: bool = false;
}


/**
 * The clicks on the tools of a dock
 *
 * */
@companion
pub mod DockState {

    /**
     * @returns: the state after a click on a tool of a section: a tool of a
     * folded dock opens it, pressed in its slot; the tool shown folds its slot;
     * another tool takes the slot
     *
     * */
    pub fn click(state: DockState, tool: [c8], section: RailSection)-> DockState {
        if !state.folded && DockState::pressed(state, section) == tool {
            return DockState::press(state, section, "");
        }

        DockState::open(DockState::press(state, section, tool))
    }

    /**
     * @returns: the state with a tool pressed in the slot of a section, "" for none
     * */
    pub fn press(state: DockState, section: RailSection, tool: [c8])-> DockState {
        if section == RailSection::TOP {
            DockState(top-> tool, bottom-> state.bottom, folded-> state.folded)
        } else {
            DockState(top-> state.top, bottom-> tool, folded-> state.folded)
        }
    }

    /**
     * @returns: the state without a tool, gone to another slot: the slot it was
     * pressed in left without one
     *
     * */
    pub fn release(state: DockState, tool: [c8])-> DockState {
        DockState(top-> if state.top == tool { "" } else { state.top },
                  bottom-> if state.bottom == tool { "" } else { state.bottom },
                  folded-> state.folded)
    }

    /**
     * @returns: the state folded, the viewport taking the room of the dock
     *
     * */
    pub fn fold(state: DockState)-> DockState {
        DockState(top-> state.top,
                  bottom-> state.bottom,
                  folded-> true)
    }

    /**
     * @returns: the state open again
     * */
    pub fn open(state: DockState)-> DockState {
        DockState(top-> state.top,
                  bottom-> state.bottom,
                  folded-> false)
    }

    /**
     * @returns: the tool pressed in the slot of a section, folded or not, ""
     * for none
     *
     * */
    pub fn pressed(state: DockState, section: RailSection)-> [c8] {
        if section == RailSection::TOP {
            state.top
        } else {
            state.bottom
        }
    }

    /**
     * @returns: the tool whose panel the slot of a section shows, "" when it
     * shows none (no tool, or the dock folded)
     *
     * */
    pub fn shown(state: DockState, section: RailSection)-> [c8] {
        if state.folded {
            ""
        } else {
            DockState::pressed(state, section)
        }
    }

    /**
     * @returns: true iif the dock takes room beside the viewport: open, a tool
     * pressed in one of its slots
     *
     * */
    pub fn isOpen(state: DockState)-> bool {
        !state.folded && (state.top != "" || state.bottom != "")
    }

    /**
     * @returns: the tools shown, the top one first, their buttons checked in
     * the rail
     *
     * */
    pub fn checked(state: DockState)-> [[c8]] {
        let mut ids: [[c8]] = [];
        for section in [RailSection::TOP, RailSection::BOTTOM] {
            let s = DockState::shown(state, section);
            if s != "" {
                ids ~= [s];
            }
        }

        ids
    }
}
