in rail_signals;

use balder::core::application::signal;
use balder::interface::widget::dock_rail::rail_drop;

/**
 * The signals of a dock rail, shared by the rail and its buttons, which emit
 * them
 *
 * */
@final
pub class RailSignals {

    // Emitted with the id of the tool clicked, or activated by Enter of Space
    pub let dmut activated: &Signal!{[c8]} = copy Signal!{[c8]} () ;

    // Emitted at each move of the cursor dragging a tool
    pub let dmut dragged: &Signal!{RailDrop} = copy Signal!{RailDrop} ();

    // Emitted where a tool dragged is released
    pub let dmut dropped: &Signal!{RailDrop} = copy Signal!{RailDrop} ();

    pub self () {}
}
