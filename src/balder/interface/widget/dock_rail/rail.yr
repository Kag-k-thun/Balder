in rail;

use balder::core::application::signal;
use balder::interface::loader::registry::schema;
use balder::interface::widget::{box, dock_rail::_, separator};
use balder::interface::widget::layout;
use balder::interface::widget::layout::linear;
use balder::math::vector;

use std::algorithm::comparison;


// The classes of the button marking the place of a tool dragged: the place is
// before it, or after it (the last tool of its section)
//
def DROP_BEFORE = "drop-before";
def DROP_AFTER = "drop-after";



/**
 * A dock rail is the column of the tools of a dock, on the outer edge of the
 * window: an icon button per tool, the tools above its separator showing their
 * panels in the top of the dock, those below it in its bottom, the tools of its
 * foot at its end
 *
 * @info:
 * =====
 *
 * The rail is given its tools (setTools) and the ones shown (setChecked), its
 * buttons built again from them. It moves nothing itself: a click on a tool
 * emits `activated` with its id, a drag `dragged` at each move and `dropped`
 * where it is released (see RailButton); the owner of the rails moves the tool,
 * asking each rail for the place under the cursor (placeAt) and marking it
 * while the tool is dragged (showDrop). A linear layout of its own type: the
 * sheets select `DockRail`, its buttons `DockRail IconButton`, its separator
 * `DockRail Separator` and the room before its foot `DockRail Box`.
 *
 * ====
 * */
pub class DockRail over LinearLayout {

    // The tools of the rail in their order: the top, the bottom, the foot
    let mut _tools: [RailTool] = [];

    // The ids of the tools show, their buttons checked
    let mut _checked: [[c8]] = [];

    // The signals of the rail, emitted by its button
    let dmut _signals: &RailSignals = copy RailSignals();

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "DockRail")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TOOLS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Replace the tools of the rail, its buttons built again: the top, the
     * separator, the bottom, the room left, the foot
     *
     * */
    pub fn setTools(mut self, tools: [RailTool]) {
        self._tools = DockRail::ordered(tools);
        self:.rebuild();
    }

    /**
     * @returns: the tools of the rail in their order, the top, the bottom, the
     * foot
     *
     */
    pub fn getTools(self)-> [RailTool] {
        self._tools
    }

    /**
     * Check the buttons of the tools shown, the others unchecked
     *
     * */
    pub fn setChecked(mut self, ids: [[c8]]) {
        self._checked = ids;
        for dmut c in alias self:.getChildren() {
            if let dmut b: &RailButton = alias c {
                b:.setChecked(DockRail::holds(ids, b.id));
            }
        }
    }

    /**
     * @returns: the place under the cursor for a tool dropped there, none when
     * the cursor is out of the rail
     *
     * @params:
     *    - at: the cursor, in layout pixels
     * */
    pub fn placeAt(self, at: vec2)-> (RailPlace)? {
        let pos = self.getAbsolutePosition();
        let size = self.getAbsoluteSize();
        if (at.x < pos.x || at.x > pos.x + size.x) || (at.y < pos.y || at.y > pos.y + size.y) {
            return none;
        }

        let (tops, bottoms, separator) = self.middles();
        (DockRail::placeOf(tops, bottoms, separator, at.y))?
    }

    /**
     * Mark the place a tool dragged would go to, none to mark nothing: the
     * button at the place is in the class drop-before, the last button of the
     * section in drop-after when the place is after it
     *
     * */
    pub fn showDrop(mut self, place: (RailPlace)?) {
        for dmut c in alias self:.getChildren() {
            if let dmut b: &RailButton = alias c {
                let (before, after) = if let Ok(p) = place {
                    DockRail::dropMarks(DockRail::sectionIds(self._tools, p.section), b.id, p.index)
                } else {
                    (false, false)
                };

                b:.setClasses(rail_button::RailButton::withClass(b.getClasses(), DROP_BEFORE, before));
                b:.setClasses(rail_button::RailButton::withClass(b.getClasses(), DROP_AFTER, after));
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted with the id of a tool clicked, or activated
     * by Enter or Space
     *
     * */
    pub fn activated(mut self)-> dmut &Signal!{[c8]} {
        alias self._signals.activated
    }

    /**
     * @returns: the signal emitted at each move of the cursor dragging a tool
     *
     * */
    pub fn dragged(mut self)-> dmut &Signal!{RailDrop} {
        alias self._signals.dragged
    }

    /**
     * @returns: the signal emitted where a tool dragged is released
     *
     * */
    pub fn dropped(mut self)-> dmut &Signal!{RailDrop} {
        alias self._signals.dropped
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Build the children of the rail from its tools: a button per tool, the
     * separator after the top, a spring before the foot
     *
     * */
    fn rebuild(mut self) {
        self:.removeChilds();

        let top = DockRail::sectionIds(self._tools, RailSection::TOP).len;
        for i, t in self._tools {
            if i == top {
                let dmut rule = copy Separator(alias self._manager, "");
                self:.append(alias rule);
            }

            if t.foot && (i == 0us || !self._tools[i - 1].foot) {
                let dmut spring = copy Box(alias self._manager, "");
                self:.append(alias spring);
            }

            let dmut b = copy RailButton(alias self._manager, t.id, alias self._signals);
            b:.setIcon(t.icon);
            b:.setName(t.name);
            b:.setDraggable(!t.foot);
            b:.setChecked(DockRail::holds(self._checked, t.id));
            self:.append(alias b);
        }

        if top == self._tools.len {
            let dmut rule = copy Separator(alias self._manager, "");
            self:.append(alias rule);
        }

    }

    /**
     * Insert a widget after the children of the rail, attached when the rail is
     *
     * */
    fn append(mut self, dmut w: &Widget) {
        self:.insertChild(alias w, level-> self.getNbChilds());
        if self._attached {
            w:.onAttach((self)?);
        }
    }

    /**
     * @returns: the heights of the middles of the buttons of the top and of the
     * bottom (the foot apart), and of the separator, in layout pixels; the
     * children are the top, the separator, then the bottom (see rebuild)
     *
     * */
    fn middles(self)-> ([f32], [f32], f32) {
        let top = DockRail::sectionIds(self._tools, RailSection::TOP).len;
        let bottom = DockRail::sectionIds(self._tools, RailSection::BOTTOM).len;

        let mut tops: [f32] = [];
        let mut separator: f32 = 0.0f;
        let mut bottoms: [f32] = [];
        for i in 0 .. min(top + 1 + bottom, cast!usize(self.getNbChilds())) {
            let c = self.getChild(cast!u32(i));
            let middle = c.getAbsolutePosition().y + c.getAbsoluteSize().y / 2.0f;
            if i < top {
                tops ~= [middle];
            } else if i == top {
                separator = middle;
            } else {
                bottoms ~= [middle];
            }
        }

        (tops, bottoms, separator)
    }
}

@companion
pub mod DockRail {

    /**
     * @returns: the schema of the rails, their tools given by code
     *
     * */
    #[widgetSchema]
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("DockRail",
                          (|dmut m, id|-> dmut &Widget => {
                              copy DockRail(alias m, id)
                          }),
                          properties-> copy [Layout::direction(), LinearLayout::gap()])
    }

    /**
     * @returns: the tools in the order of a rail, the top, then the bottom,
     * then the foot, each in the order given
     *
     * */
    pub fn ordered(tools: [RailTool])-> [RailTool] {
        let mut top: [RailTool] = [];
        let mut bottom: [RailTool] = [];
        let mut foot: [RailTool] = [];
        for t in tools {
            if t.foot {
                foot ~= [t];
            } else if t.section == RailSection::TOP {
                top ~= [t];
            } else {
                bottom ~= [t];
            }
        }

        top ~ bottom ~ foot
    }

    /**
     * @returns: the ids of the tools of a section in their order, the foot
     * apart
     *
     * */
    pub fn sectionIds(tools: [RailTool], section: RailSection)-> [[c8]] {
        let mut ids: [[c8]] = [];
        for t in DockRail::ordered(tools) if !t.foot && t.section == section {
            ids ~= [t.id];
        }

        ids
    }



    /**
     * @returns: the place a tool dropped at a height goes to: the section on
     * the side of the separator the cursor is, before the first tool of the
     * section whose middle is below the cursor
     *
     * @params:
     *    - tops, bottoms: the middles of the tools of the top and of the bottom (the foot apart), from the top
     *    - separator: the middle of the separator
     *    - y: the height of the cursor
     * */
    pub fn placeOf(tops: [f32], bottoms: [f32], separator: f32, y: f32)-> RailPlace {
        let (section, middles) = if y < separator {
            (RailSection::TOP, tops)
        } else {
            (RailSection::BOTTOM, bottoms)
        };

        let mut index = 0us;
        for m in middles if m < y {
            index += 1;
        }

        RailPlace(section-> section, index-> index)
    }

    /**
     * @returns: whether the button of a tool marks a place, before it, and
     * after it
     *
     * @params:
     *    - ids: the tools of the section of the place, in order
     *    - id: the tool of the button
     *    - index: the place in the section
     * */
    pub fn dropMarks(ids: [[c8]], id: [c8], index: usize)-> (bool, bool) {
        let before = (index < ids.len && ids[index] == id);
        let after = ((index == ids.len) && (index != 0us) && (ids[index - 1] == id));
        (before, after)
    }

    /**
     * @returns: the tools of a rail without one of them, a tool moved to the
     * other rail
     *
     * */
    pub fn withoutTool(tools: [RailTool], id: [c8])-> [RailTool] {
        let mut kept: [RailTool] = [];
        for t in tools if t.id != id {
            kept ~= [t];
        }
        kept
    }

    /**
     * @returns: the tools of a rail with a tool put at a place, taken out of
     * the place it had when it was in the rail
     *
     * @params:
     *    - tools: the tools of the rail, the tool among them when it comes from this rail
     *    - tool: the tool, its section becoming the one of the place
     *    - place: the place, counted among the tools of its section with the
     *             tool itself (placeAt sees it there)
     * */
    pub fn withToolAt(tools: [RailTool], tool: RailTool, place: RailPlace)-> [RailTool] {
        let mut at = place.index;
        for i, id in DockRail::sectionIds(tools, place.section) if i < place.index && id == tool.id {
            at -= 1;
        }

        let mut top: [RailTool] = [];
        let mut bottom: [RailTool] = [];
        let mut foot: [RailTool] = [];
        for t in DockRail::ordered(tools) if t.id != tool.id {
            if t.foot {
                foot ~= [t];
            } else if t.section == RailSection::TOP {
                top ~= [t];
            } else {
                bottom ~= [t];
            }
        }

        let placed = RailTool(id-> tool.id, name-> tool.name, icon-> tool.icon, section-> place.section);
        if place.section == RailSection::TOP {
            top = DockRail::insertedAt(top, placed, at);
        } else {
            bottom = DockRail::insertedAt(bottom, placed, at);
        }

        top ~ bottom ~ foot
    }

    /**
     * @returns: the tools with one inserted at an index, after the last one
     * past their end
     *
     * */
    pub fn insertedAt(tools: [RailTool], tool: RailTool, index: usize)-> [RailTool] {
        let at = min(index, tools.len);
        tools[0us .. at] ~ [tool] ~ tools[at .. tools.len]
    }

    /**
     * @returns: true iif an id is among ids
     * */
    pub fn holds(ids: [[c8]], id: [c8])-> bool {
        for i in ids if i == id { return true; }
        false
    }
}
