in rail_drop;

use balder::math::vector;

/**
 * A tool of a dock rail dragged, where the cursor is
 *
 * */
@data
pub record RailDrop {

    // The id of the tool dragged
    pub let tool: [c8] = "";

    // The cursor, in the layout pixels from the top left corner of the window
    pub let at: vec2 = vec2();
}
