in rail_place;

use balder::interface::widget::dock_rail::rail_section;

/**
 * A place of a dock rail a tool dragged goes to
 *
 * */
@data
pub record RailPlace {

    // The section of the place
    pub let section: RailSection = RailSection::TOP;

    // The place among the tools of the section, the foot apart, 0 before the first one
    pub let index: usize = 0us;
}
