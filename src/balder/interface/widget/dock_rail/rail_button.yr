in rail_button;

use balder::interface::widget::button::icon;
use balder::interface::widget::dock_rail::{rail_drop, rail_signals};
use balder::math::vector;

use ::sdl3::mouse;

// The distance the cursor goes from where it pressed a tool before the tool is
// dragged, in pixels
//
def DRAG_DISTANCE = 4.0f;

// The class of the button of the tool dragged
def DRAGGED = "dragged";


/**
 * The button of a tool of a dock rail: an icon button whose click, or Enter and
 * Space, activates the tool, and which the left button drags to another place,
 * in its rail or in another one
 *
 * @info: the button takes the focus of the left button, so that the manager
 * sends it the moves of the cursor while the button is held; past DRAG_DISTANCE
 * the press is a drag: the button is in the class `dragged`, each move emits
 * `dragged` and the release `dropped` instead of the activation. It keeps the
 * type of an icon button, the sheets selecting it as `DockRail IconButton`.
 *
 * */
pub class RailButton over IconButton {

    // The signals of the rail of the button
    let dmut _signals: &RailSignals;

    // False for a tool that stays where it is (the foot of a rail)
    let mut _draggable: bool = true;

    // Where the left button pressed the button, in layout pixel, and true once the press is a drag
    let mut _pressedAt: vec2 = vec2();
    let mut _dragging: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self(dmut manager: &WidgetManager, id: [c8], dmut signal: &RailSignals)
        with super(alias manager, id)
        , _signals = alias signal
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Let the left button drag the button, or keep it in place
     *
     * */
    pub fn setDraggable(mut self, draggable: bool) {
        self._draggable = draggable;
    }

    pub over isFocusableLeftClick(self)-> bool {
        true
    }

    pub over loseFocusOnReleaseLeft(self)-> bool {
        true
    }

    pub over onClick(mut self, pos: vec2, button: u8)-> dmut(&Widget)? {
        self._pressedAt = self._manager.getMousePosition();
        self._dragging = false;
        self.__super__:.onClick(pos, button)
    }

    /**
     * The left button held drags the tool once the cursor went far enough, each
     * move told by `dragged`
     *
     * */
    pub over onSliding(mut self, _pos_: vec2, _speed_: vec2, button: u8) {
        if !self._draggable || button != SDL_BUTTON_LEFT {
            return;
        }

        let at = self._manager.getMousePosition();
        if !self._dragging {
            if !RailButton::isDrag(self._pressedAt, at) {
                return;
            }
            self._dragging = true;
            self:.setClasses(RailButton::withClass(self.getClasses(), DRAGGED, true));
        }

        self._signals.dragged:.emit(RailDrop(tool-> self.id, at-> at));
    }

    /**
     * The release of the left button activates the tool, or drops it where the
     * cursor is after a drag
     *
     * */
    pub over onClickEnd(mut self, button: u8)-> dmut(&Widget)? {
        self.__super__:.onClickEnd(button);
        if button != SDL_BUTTON_LEFT {
            return (alias self)?;
        }

        if self._dragging {
            self._dragging = false;
            self:.setClasses(RailButton::withClass(self.getClasses(), DRAGGED, false));
            self._signals.dropped:.emit(RailDrop(tool-> self.id, at-> self._manager.getMousePosition()));
        } else {
            self._signals.activated:.emit(self.id);
        }

        (alias self)?
    }

    /**
     * Enter and Space activate the tool as a click does
     *
     */
    prot over activate(mut self) {
        self._signals.activated:.emit(self.id);
    }
}


@companion
pub mod RailButton {

    /**
     * @returns: true iff the cursor went far enough from where it pressed for
     * the press to be a drag
     *
     * */
    pub fn isDrag(from: vec2, to: vec2)-> bool {
        (to - from).length() >= DRAG_DISTANCE
    }

    /**
     * @returns: the classes with a class in it once, or without it
     *
     * */
    pub fn withClass(classes: [[c8]], name: [c8], set: bool)-> [[c8]] {
        let mut result: [[c8]] = [];
        for c in classes if c != name {
            result ~= [c];
        }

        if set {
            result ~= [name];
        }

        result
    }
}
