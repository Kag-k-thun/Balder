/**
 * The sizing of a widget along one axis, as CSS sizes a box (doc/gui-v2.md, §2): a size is the size of the border box,
 * the margins sitting outside it, a percentage is a part of the content box of the parent, and an auto size is resolved
 * by the parent, stretched to it or fitted to the content
 * @info:
 * =====
 * Every size here is in pixels along the axis. The frame is the space the borders and the paddings take in the border
 * box, and the content is the min-content and max-content sizes of the content box (the same height twice, a height
 * not depending on wrapping). A container of a negative size is indefinite: the parent measures its own content, and
 * a percentage of it stands for auto.
 * ====
 * */
in sizing;

use balder::interface::loader::parser;
use balder::interface::widget::layout::flex;

use std::algorithm::comparison;

/**
 * @returns: true iif resolving a size needs the content of the box, the size being min-content or max-content
 * */
pub fn needsContent(size: Size)-> bool {
    size.sizing == Sizing::MIN_CONTENT || size.sizing == Sizing::MAX_CONTENT
}

/**
 * @returns: the border box a size resolves to: a length, never smaller than the frame, or the content and the frame for
 * min-content and max-content; none for auto, resolved by the parent, and for a percentage of an indefinite container
 * @params:
 *    - size: the size to resolve, a width, a height, a bound or a flex basis
 *    - container: the size of the content box of the parent, negative when it is indefinite
 *    - frame: the space the borders and the paddings take
 *    - content: the min-content and the max-content of the content box, read for min-content and max-content only
 * */
pub fn resolveBox(size: Size, container: f32, frame: f32, content: (f32, f32))-> (f32)? {
    match size.sizing {
        Sizing::MIN_CONTENT => { return (content._0 + frame)?; }
        Sizing::MAX_CONTENT => { return (content._1 + frame)?; }
        _ => {}
    }

    if let Ok(length) = size.resolve(container) {
        return (max(length, frame))?;
    }

    none
}

/**
 * @returns: the border box of an auto size, filling the space less the margins when it is stretched, or fitting the
 * content in it: as large as the max-content, shrinking down to the min-content
 * @params:
 *    - space: the space the margin box is given, negative when it is indefinite (the max-content then)
 *    - margins: the space the margins take
 *    - frame: the space the borders and the paddings take
 *    - content: the min-content and the max-content of the content box
 *    - stretch: true to fill the space, false to fit the content in it
 * */
pub fn autoBox(space: f32, margins: f32, frame: f32, content: (f32, f32), stretch: bool)-> f32 {
    if space < 0.0f {
        return content._1 + frame;
    }

    let available = max(0.0f, space - margins);
    if stretch {
        return max(available, frame);
    }

    max(content._0, min(content._1, available - frame)) + frame
}

/**
 * @returns: the lower and the upper bounds of the border box, from the min and max sizes: an auto lower bound is
 * 'automatic' (never smaller than the frame), an auto upper bound (none) is no bound
 * @params:
 *    - lower: the min-width or the min-height
 *    - upper: the max-width or the max-height
 *    - container: the size of the content box of the parent, negative when it is indefinite
 *    - frame: the space the borders and the paddings take
 *    - content: the min-content and the max-content of the content box, read for min-content and max-content only
 *    - automatic: the border box an auto lower bound stands for
 * */
pub fn boundsOf(lower: Size, upper: Size, container: f32, frame: f32, content: (f32, f32),
                automatic: f32 = 0.0f)-> (f32, f32)
{
    let low = if let Ok(l) = resolveBox(lower, container, frame, content) { l } else { max(automatic, frame) };
    let high = if let Ok(h) = resolveBox(upper, container, frame, content) { h } else { f32::max };
    (low, high)
}

/**
 * @returns: a border box clamped to its bounds, the lower bound winning over the upper one
 * */
pub fn clampBox(size: f32, bounds: (f32, f32))-> f32 {
    max(min(size, bounds._1), bounds._0)
}

/**
 * @returns: the automatic lower bound of an item of a flex line, its min-content, capped by its size when it is a
 * length or a content keyword, so that a size is never forced to grow
 * @params:
 *    - size: the border box the size of the item resolves to, none when it is auto
 *    - minContent: the min-content of the border box
 * */
pub fn automaticMin(size: (f32)?, minContent: f32)-> f32 {
    if let Ok(s) = size {
        return min(s, minContent);
    }

    minContent
}

/**
 * @returns: the item of a flex line sizing the border box of a widget along the axis of the line: its basis is its
 * flex basis, its size when the basis is auto, or its max-content when both are auto, and it shrinks down to its lower
 * bound, its min-content when it is auto
 * @params:
 *    - size: the width or the height along the axis
 *    - basis: the flex basis
 *    - lower: the min-width or the min-height
 *    - upper: the max-width or the max-height
 *    - container: the size of the content box of the line, negative when it is indefinite
 *    - frame: the space the borders and the paddings take
 *    - content: the min-content and the max-content of the content box
 *    - grow: the growth factor
 *    - shrink: the shrink factor
 * */
pub fn flexItemOf(size: Size, basis: Size, lower: Size, upper: Size, container: f32, frame: f32, content: (f32, f32),
                  grow: f32, shrink: f32)-> FlexItem
{
    let resolved = resolveBox(size, container, frame, content);
    let b = if let Ok(b) = resolveBox(basis, container, frame, content) {
        b
    } else if let Ok(s) = resolved { s } else { content._1 + frame };

    let automatic = automaticMin(resolved, content._0 + frame);
    let bounds = boundsOf(lower, upper, container, frame, content, automatic-> automatic);
    FlexItem(basis-> b, grow-> grow, shrink-> shrink, min-> bounds._0, max-> bounds._1)
}
