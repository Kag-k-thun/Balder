in button;

pub mod ::push;
pub mod ::menu;
pub mod ::toggle;
pub mod ::check;
pub mod ::radio;
pub mod ::dropdown;

use balder::core::dispose;
use balder::interface::widget::text::label;
use balder::math::vector;

use ::sdl3::{keycode, mouse};

use ::std::algorithm::comparison;

/**
 * Ancestor class of all button elements
 * @info: the text of a button is its part `::label`; its shortcut, the keys doing what it does (`shortcut: "Ctrl+S";`),
 * is the part `::shortcut` at the end of its content box, as wide as its text and its margins (a `margin-left` keeping
 * it apart from the label), the label taking the rest, so that the shortcuts of the items of a menu line up on its
 * right edge; a button without a shortcut gives it no room
 * */
@abstract
pub class Button over Widget {

    let dmut _label : &Label;

    // The keys doing what the button does, written after its text, "" for none
    let dmut _shortcut : &Label;

    pub self (dmut manager : &WidgetManager, id : [c8], kind : [c8])
        with super (alias manager, id, kind)
        , _label  = copy Label (alias manager, "")
        , _shortcut = copy Label (alias manager, "")
    {
        self._label:.setOwnerPart ("label");
        self._shortcut:.setOwnerPart ("shortcut");
        self._shortcut:.forceNoWrap (true);
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the text of the button, laid out again only when it changed
     * */
    pub fn setText (mut self, text : [c8]) {
        if self._label.getText () == text { return; }

        self._label:.setText (text);
        self:.relayout ();
    }

    /**
     * Set the shortcut of the button, the keys doing what it does, written at the end of its content box, "" for none
     * */
    pub fn setShortcut (mut self, shortcut : [c8]) {
        if self._shortcut.getText () == shortcut { return; }

        self._shortcut:.setText (shortcut);
        self:.relayout ();
    }

    /**
     * @returns: the shortcut of the button, "" for none
     * */
    pub fn getShortcut (self)-> [c8] {
        self._shortcut.getText ()
    }

    prot over onApplyStyle (mut self) {
        if let Ok (inner) = self.getStyle ().subItems ["label"] {
            self._label:.setStyle (inner);
        }

        if let Ok (inner) = self.getStyle ().subItems ["shortcut"] {
            self._shortcut:.setStyle (inner);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The label at the start of the content box, the shortcut at its end
     * */
    over onUpdateSize (mut self) {
        let labelWidth = Button::labelWidth (self._absoluteSize.x, self:.measureShortcut ());
        self._label:.setSize (self._absolutePosition, makeVec2 (labelWidth, self._absoluteSize.y), self._depth + 1);
        self._shortcut:.setSize (self._absolutePosition + makeVec2 (labelWidth, 0.0f),
                                 makeVec2 (self._absoluteSize.x - labelWidth, self._absoluteSize.y), self._depth + 1);
        self:.onUpdateScissors ();
    }

    over onUpdateScissors (mut self) {
        let x = max (self._absolutePosition.x, self._scissorPos.x);
        let endx = min (self._absolutePosition.x + self._absoluteSize.x,
                        self._scissorPos.x + self._scissorSize.x);

        let y = max (self._absolutePosition.y, self._scissorPos.y);
        let endy = min (self._absolutePosition.y + self._absoluteSize.y, self._scissorPos.y + self._scissorSize.y);

        self._label:.setScissors (makeVec2 (x, y),
                                  makeVec2 (endx - x, endy - y));
        self._shortcut:.setScissors (makeVec2 (x, y),
                                     makeVec2 (endx - x, endy - y));
    }

    /**
     * @returns: the depth of the label and the shortcut, drawn over the button, so that what is drawn over the button
     * covers its text
     * */
    pub over getMaxDepth (self)-> u32 {
        max (self._depth, max (self._label.getMaxDepth (), self._shortcut.getMaxDepth ()))
    }

    /**
     * The content of a button is its label, followed by its shortcut
     * */
    prot over measureContentWidths (mut self)-> (f32, f32) {
        let shortcut = self:.measureShortcut ();
        let (minWidth, maxWidth) = self._label:.measureIntrinsicWidths ();
        (minWidth + shortcut, maxWidth + shortcut)
    }

    prot over measureContentHeights (mut self, width : f32)-> (f32, f32) {
        let shortcut = self:.measureShortcut ();
        let space = Button::labelWidth (width, shortcut);
        let labelWidth = self._label:.measureWidth (makeVec2 (space, INDEFINITE_SIZE), stretch-> true);
        let (minHeight, maxHeight) = self._label:.measureIntrinsicHeights (labelWidth);
        if shortcut == 0.0f { return (minHeight, maxHeight); }

        let (_, shortcutHeight) = self._shortcut:.measureIntrinsicHeights (shortcut);
        (max (minHeight, shortcutHeight), max (maxHeight, shortcutHeight))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach (mut self, parent : (&Widget)?) {
        self.__super__:.onAttach (parent);
        self._label:.onAttach ((self)?);
        self._shortcut:.onAttach ((self)?);
    }

    over onHide (mut self) {
        self._label:.hide ();
        self._shortcut:.hide ();
    }

    over onShow (mut self) {
        self._label:.show ();
        self._shortcut:.show ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENT          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover (mut self, _ : vec2)-> dmut (&Widget)? {
        self:.setHover (true);
        (alias self)?
    }

    pub over onLoseHoverFocus (mut self) {
        self:.setHover (false);
    }

    pub over onClick (mut self, _ : vec2, _ : u8)-> dmut (&Widget)? {
        self:.setPressed (true);
        (alias self)?
    }

    pub over onClickEnd (mut self, _ : u8)-> dmut (&Widget)? {
        self:.setPressed (false);
        (alias self)?
    }

    /**
     * A button of an open menu is an item of the menu: its click closes the menus
     * */
    pub over closesMenuOnClick (self)-> bool {
        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          KEYBOARD EVENTS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over isFocusableByKeyboard (self)-> bool {
        true
    }

    /**
     * Enter and Space press the button, without Ctrl, Alt or the GUI key
     * */
    pub over onKeyPressed (mut self, key : SDL_Keycode, mods : SDL_Keymod)-> bool {
        if (mods & (SDL_KMOD_CTRL | SDL_KMOD_ALT | SDL_KMOD_GUI)) != 0u16 { return false; }
        if key == SDLK_RETURN || key == SDLK_KP_ENTER || key == SDLK_SPACE {
            self:.activate ();
            return true;
        }

        false
    }

    /**
     * Do what a click of the left button released on the button does, when Enter or Space is pressed while it has the
     * focus: emit its click signal with the left button
     * */
    prot fn activate (mut self) {
        self:.emitClicked (SDL_BUTTON_LEFT);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self._attached = false;

            self._label:.dispose ();
            self._shortcut:.dispose ();
            self.__super__:.dispose ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the width of the margin box of the shortcut, 0 for a button without one
     * */
    fn measureShortcut (mut self)-> f32 {
        if self._shortcut.getText () == "" { return 0.0f; }
        self._shortcut:.measureIntrinsicWidths ()._1
    }

}

/**
 * The sharing of the content box of a button between its label and its shortcut
 * */
pub mod Button {

    /**
     * @returns: the width of the label of a button, the content box less its shortcut, the shortcut taking the rest
     * @params:
     *    - width: the width of the content box, in pixels
     *    - shortcut: the width of the margin box of the shortcut, 0 for none
     * */
    pub fn labelWidth (width : f32, shortcut : f32)-> f32 {
        max (0.0f, width - shortcut)
    }
}
