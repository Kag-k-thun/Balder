/**
 * The order the Tab key moves the focus in, as a browser orders its elements by their tabindex: the widgets of a
 * positive tab index first, by increasing index, then those of the index 0, the default one, in the order of the tree
 * @info:
 * =====
 * A widget of a negative tab index is never focused by the Tab key, but it can still have the focus, given by a click or
 * by the code: the Tab key then moves on from where it stands in the tree, as if its index were 0.
 * ====
 * */
in focus;

/**
 * @returns: the positions in indices of the widgets the Tab key focuses, in the order it focuses them
 * @params:
 *    - indices: the tab index of each widget, in the order of the tree
 * */
pub fn tabOrder(indices: [i32])-> [usize] {
    let mut order: [usize] = [];
    let mut last = 0;
    loop {
        // the smallest positive index above the last one taken
        let mut next = 0, mut found = false;
        for i in indices if i > last && (!found || i < next) {
            next = i;
            found = true;
        }

        if !found { break; }
        for p, i in indices if i == next {
            order ~= [p];
        }

        last = next;
    }

    for p, i in indices if i == 0 {
        order ~= [p];
    }

    order
}

/**
 * @returns: the position in indices of the widget the Tab key focuses after the focused one, the first one when no
 * widget has the focus, wrapping around after the last one; none when the Tab key focuses no widget
 * @params:
 *    - indices: the tab index of each widget, in the order of the tree, the focused one among them whatever its index
 *    - current: the position of the focused widget in indices, none when no widget has the focus
 *    - backward: true to focus the widget before the focused one (Shift-Tab), the last one when no widget has the focus
 * */
pub fn nextTabStop(indices: [i32], current: (usize)?, backward: bool)-> (usize)? {
    let order = tabOrder(indices);
    if order.len == 0us { return none; }

    if let Ok(c) = current && c < indices.len {
        // the number of widgets the Tab key focuses before the focused one, standing among those of the index 0 when
        // the Tab key does not focus it
        let mut before = 0us, mut isStop = false;
        if indices[c] >= 0 {
            for o in order {
                if o == c { isStop = true; break; }
                before += 1us;
            }
        } else {
            for o in order if indices[o] > 0 || o < c {
                before += 1us;
            }
        }

        let at = if backward {
            (before + order.len - 1us) % order.len
        } else if isStop {
            (before + 1us) % order.len
        } else {
            before % order.len
        };

        return (order[at])?;
    }

    if backward { (order[order.len - 1us])? } else { (order[0us])? }
}
