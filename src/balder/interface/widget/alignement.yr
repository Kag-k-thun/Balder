in alignement;


/**
 * Alignement along the X axis
 */
pub enum XAlign
| LEFT   = 0u8
| RIGHT  = 1u8
| CENTER = 2u8
| NONE   = 3u8;

/**
 * Alignement along the Y axis
 */
pub enum YAlign
| TOP    = 0u8
| BOTTOM = 1u8
| CENTER = 2u8;

/**
 * The axis a linear layout or a splitter lays its children out along
 * */
pub enum Direction
| ROW    = 0u8  // side by side, from left to right
| COLUMN = 1u8; // on top of each other, from top to bottom

/**
 * What a linear layout does with the children that do not fit in it
 * */
pub enum Overflow
| HIDDEN = 0u8  // the children shrink to fit, what still overflows being cut
| SCROLL = 1u8; // the children keep their sizes, the layout scrolling over them with a scrollbar

/**
 * Whether a widget takes part in the layout and in the drawing
 * */
pub enum Display
| NORMAL = 0u8  // laid out and drawn
| NONE   = 1u8; // out of the layout and out of the drawing, with its descendants

/**
 * The way a track (a column or a row) of a grid is sized
 * */
pub enum TrackKind
| PIXELS      = 0u8  // a length in pixels
| PERCENT     = 1u8  // a part of the content box of the grid
| SHARE       = 2u8  // a share of the space the other tracks leave, in fr
| AUTO        = 3u8  // the size of its cells' content, between their min-content and their max-content
| MIN_CONTENT = 4u8  // the largest min-content of its cells
| MAX_CONTENT = 5u8; // the largest max-content of its cells

/**
 * A track of a grid: `120`, `40%`, `1fr`, `auto`, `min-content` or `max-content`
 * */
pub record Track {

    // The way the track is sized
    pub let kind: TrackKind;

    // The pixels, the percentage or the share of the track, for those kinds
    pub let amount: f32;

    pub self (kind: TrackKind, amount: f32)
        with kind = kind
        , amount = amount
    {}

    pub fn opEquals(self, other: Track)-> bool {
        self.kind == other.kind && self.amount == other.amount
    }
}
