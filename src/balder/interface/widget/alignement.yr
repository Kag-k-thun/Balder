in alignement;

use balder::core::error;

use std::{config, config::_, conv};
use std::algorithm::comparison;

/**
 * Alignement along the X axis
 */
pub enum XAlign
| LEFT   = 0u8
| RIGHT  = 1u8
| CENTER = 2u8
| NONE   = 3u8;

/**
 * Alignement along the Y axis
 */
pub enum YAlign
| TOP    = 0u8
| BOTTOM = 1u8
| CENTER = 2u8;

/**
 * The axis a linear layout or a splitter lays its children out along
 * */
pub enum Direction
| ROW    = 0u8  // side by side, from left to right
| COLUMN = 1u8; // on top of each other, from top to bottom

/**
 * What a linear layout does with the children that do not fit in it
 * */
pub enum Overflow
| HIDDEN = 0u8  // the children shrink to fit, what still overflows being cut
| SCROLL = 1u8; // the children keep their sizes, the layout scrolling over them with a scrollbar

/**
 * The way a track (a column or a row) of a grid is sized
 * */
pub enum TrackKind
| PIXELS      = 0u8  // a length in pixels
| PERCENT     = 1u8  // a part of the content box of the grid
| SHARE       = 2u8  // a share of the space the other tracks leave, in fr
| AUTO        = 3u8  // the size of its cells' content, between their min-content and their max-content
| MIN_CONTENT = 4u8  // the largest min-content of its cells
| MAX_CONTENT = 5u8; // the largest max-content of its cells

/**
 * A track of a grid: `120`, `40%`, `1fr`, `auto`, `min-content` or `max-content`
 * */
pub record Track {

    // The way the track is sized
    pub let kind: TrackKind;

    // The pixels, the percentage or the share of the track, for those kinds
    pub let amount: f32;

    pub self (kind: TrackKind, amount: f32)
        with kind = kind
        , amount = amount
    {}

    pub fn opEquals(self, other: Track)-> bool {
        self.kind == other.kind && self.amount == other.amount
    }
}

/**
 * The way a size is computed
 */
pub enum SizeKind
| RELATIVE    = 0u8  // a part of the size of the parent
| AUTO        = 1u8  // the size of the content, fitted in the size of the parent
| MIN_CONTENT = 2u8  // the smallest size the content fits in, its lines wrapped at every opportunity
| MAX_CONTENT = 3u8; // the size of the content, its lines never wrapped

/**
 * A size is composed of a kind, a relative part (for the RELATIVE kind) and its bounds in pixels
 */
pub record WidgetSize {
    // The way the size is computed
    pub let mut kind: SizeKind = SizeKind::RELATIVE;

    // the relative size of the widget (between 0 and 1)
    pub let mut relative: f32 = 0.0f;

    // The minimum size in pixels
    pub let mut minPix: u32 = 0u32;

    // The maximum size in pixels
    pub let mut maxPix: u32 = u32::max;

    pub self (relative: f32 = 0.0f, minPix: u32 = 0, maxPix: u32 = cast!u32(i32::max - 1), kind: SizeKind = SizeKind::RELATIVE)
        with kind = kind
        , relative = relative
        , minPix = minPix
        , maxPix = maxPix
    {}

    pub self (pix: u32)
        with relative = 1.0f
        , minPix = pix
        , maxPix = pix
    {}

    pub self (cfg: &Config)
        with relative = 1.0f
        , minPix = 0
        , maxPix = u32::max
        throws BalderError
    {
        if let Int(value-> s) = cfg {
            self.minPix = cast!u32(s);
            self.maxPix = cast!u32(s);
        } else {
            {
                if let Ok(pix) = cfg["min"]? {
                    self.minPix = pix.to!{u32} ();
                }

                if let Ok(pix) = cfg["max"]? {
                    self.maxPix = pix.to!{u32} ();
                }

                if let Ok(pix) = cfg["relative"]? {
                    self.relative = pix.to!{f32} ();
                }
            } catch {
                _ => throw copy BalderError("Failed to load size : " ~ std::conv::to!{[c8]} (cfg));
            }
        }
    }

    /**
     * @returns: the size in pixels, a part of the size of the parent, or the size of the content fitted in it, clamped
     * to the bounds
     * @params:
     *    - parent: the size of the parent along the axis, in pixels
     *    - minContent: the smallest size the content fits in, in pixels
     *    - maxContent: the size of the content, its lines never wrapped, in pixels
     * */
    pub fn resolve(self, parent: f32, minContent: f32 = 0.0f, maxContent: f32 = 0.0f)-> f32 {
        let size = match self.kind {
            SizeKind::AUTO        => { max(minContent, min(maxContent, parent)) }
            SizeKind::MIN_CONTENT => { minContent }
            SizeKind::MAX_CONTENT => { maxContent }
            _                     => { max(0.0f, self.relative) * parent }
        };

        self.clamp(size)
    }

    /**
     * @returns: the smallest and the largest sizes a widget of this size asks to a parent sized to its content, a part of
     * the parent counting as the size of the content, clamped to the bounds
     * @params:
     *    - minContent: the smallest size the content fits in, in pixels
     *    - maxContent: the size of the content, its lines never wrapped, in pixels
     * */
    pub fn contribute(self, minContent: f32, maxContent: f32)-> (f32, f32) {
        match self.kind {
            SizeKind::MIN_CONTENT => { (self.clamp(minContent), self.clamp(minContent)) }
            SizeKind::MAX_CONTENT => { (self.clamp(maxContent), self.clamp(maxContent)) }
            _                     => { (self.clamp(minContent), self.clamp(maxContent)) }
        }
    }

    /**
     * @returns: a size in pixels clamped to the bounds
     * */
    pub fn clamp(self, size: f32)-> f32 {
        min(max(size, cast!f32(self.minPix)), cast!f32(self.maxPix))
    }

    /**
     * @returns: true iif the size is computed from the content of the widget
     * */
    pub fn isContent(self)-> bool {
        self.kind != SizeKind::RELATIVE
    }

    pub fn opEquals(self, other: WidgetSize)-> bool {
        if self.kind != other.kind { return false; }
        if self.relative != other.relative { return false; }
        if self.minPix != other.minPix { return false; }
        if self.maxPix != other.maxPix { return false; }

        true
    }

    pub fn opBinary {"+"} (self, other: WidgetSize)-> WidgetSize {
        WidgetSize(relative-> self.relative + other.relative,
                   minPix-> self.minPix + other.minPix,
                   maxPix-> self.maxPix + other.maxPix,
                   kind-> self.kind)
    }
}
