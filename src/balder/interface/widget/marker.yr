in marker;

use balder::interface::style;
use balder::interface::widget::text::label;

// The glyph of a marker collapsed, and of one expanded
def COLLAPSED_GLYPH = "▸";
def EXPANDED_GLYPH = "▾";

/**
 * The marker of what the user expands and collapses, a node of a tree view or a collapsible: a label on a single line
 * drawing the background and the border of the part ::marker, its glyph ▸ while it is collapsed and ▾ while it is
 * expanded, unless its style has an image (a chevron), which is drawn in place of the glyph
 * */
pub class FoldMarker over Label {

    // True iif what the marker folds is expanded
    let mut _expanded: bool = false;

    // The style of the part ::marker the marker was given last
    let mut _markerStyle: &Style = copy Style();

    /**
     * @params:
     *    - expanded: true iif what the marker folds starts expanded
     * */
    pub self (dmut manager: &WidgetManager, expanded: bool)
        with super(alias manager, "")
        , _expanded = expanded
    {
        self._hasBackground = true;
        self._hasBorder = true;
        self:.setOwnerPart("marker");
        self:.forceNoWrap(true);
        self:.setText(FoldMarker::text(expanded, self._markerStyle));
    }

    /**
     * Show the marker of what is expanded, or of what is collapsed
     * */
    pub fn setExpanded(mut self, expanded: bool) {
        self._expanded = expanded;
        self:.setText(FoldMarker::text(expanded, self._markerStyle));
    }

    /**
     * Give the marker the style of the part ::marker, its glyph left out when the style has an image
     * */
    pub fn setMarkerStyle(mut self, style: &Style) {
        self._markerStyle = style;
        self:.setStyle(style);
        self:.setText(FoldMarker::text(self._expanded, style));
    }
}

/**
 * The text of the markers
 * */
pub mod FoldMarker {

    /**
     * @returns: the text of a marker, its glyph, or none when its style has an image drawn in place of it
     * @params:
     *    - expanded: true iif what the marker folds is expanded
     *    - style: the style of the marker
     * */
    pub fn text(expanded: bool, style: &Style)-> [c8] {
        if style.backgroundImage._1 != "" { return ""; }
        if expanded { EXPANDED_GLYPH } else { COLLAPSED_GLYPH }
    }
}
