in slider;

use balder::core::dispose;
use balder::core::application::signal;
use balder::interface::loader::registry::schema;
use balder::interface::widget::{alignement, box, layout};
use balder::interface::widget::range::utils;
use balder::math::vector;

use ::sdl3::mouse;

use ::std::algorithm::comparison;

// The size of the thumb of a slider whose style sets none, in pixels
def DEFAULT_THUMB_SIZE = 16.0f;

// The thickness of the track of a slider whose style sets none, in pixels
def DEFAULT_TRACK_THICKNESS = 4.0f;

// The length of the track of a slider sized to its content, in pixels
def DEFAULT_TRACK_LENGTH = 160.0f;

/**
 * A slider is a thumb the user drags along a track, or moves with the wheel, to choose a value in a range
 * @info:
 * =====
 * The track, the part of the track under the value and the thumb are the parts `::track`, `::fill` and `::thumb`. The
 * track runs along the content box, centred across it and as thick as its style says (4 pixels by default), and the
 * thumb is sized by its width and height (16 pixels by default), its centre travelling from half a thumb after the
 * start of the track to half a thumb before its end. The style property `direction` lays the slider along a row (the
 * default, the lowest value on the left) or a column (the lowest value at the bottom).
 * ====
 * */
pub class Slider over Widget {

    // The bounds of the value, and its step
    let mut _range: ValueRange = ValueRange();

    // The value as it was set, snapped to the range when it is read
    let mut _value: f32 = 0.0f;

    // True iif the thumb is dragged
    let mut _grabbed: bool = false;

    prot { // parts
        let dmut _track: &Box;
        let dmut _fill: &Box;
        let dmut _thumb: &Box;

        // The size of the margin box of the thumb, in pixels
        let mut _thumbSize: vec2 = vec2();
    }

    prot { // signals
        let dmut _changed: (&Signal!{f32})? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "Slider")
        , _track = copy Box(alias manager, "")
        , _fill = copy Box(alias manager, "")
        , _thumb = copy Box(alias manager, "")
    {
        self._track:.setOwnerPart("track");
        self._fill:.setOwnerPart("fill");
        self._thumb:.setOwnerPart("thumb");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          VALUE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the bounds of the value and its step, the value being snapped to them
     * */
    pub fn setRange(mut self, range: ValueRange) {
        self._range = range;
        self:.placeParts();
    }

    /**
     * Set the value, snapped to the range, without emitting the signal of the slider
     * */
    pub fn setValue(mut self, value: f32) {
        self._value = value;
        self:.placeParts();
    }

    /**
     * @returns: the bounds of the value and its step
     * */
    pub fn getRange(self)-> ValueRange {
        self._range
    }

    /**
     * @returns: the value, snapped to the range
     * */
    pub fn getValue(self)-> f32 {
        self._range.snap(self._value)
    }

    /**
     * @returns: true iif the slider lies along a row, set by the style direction, false along a column
     * */
    pub fn isRow(self)-> bool {
        if let Ok(d) = self.getStyle().getCustom!{Direction}("direction") {
            return d == Direction::ROW;
        }

        true
    }

    /**
     * Set the value the user chose, emitting the signal of the slider when it changed
     * */
    fn setValueByUser(mut self, value: f32) {
        let old = self.getValue();
        self._value = self._range.snap(value);
        if self._value != old {
            self:.placeParts();
            if let Ok(dmut s) = alias self._changed {
                s:.emit(self._value);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STYLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot over onApplyStyle(mut self) {
        self._track:.setStyle(self.getStyle().getSubStyle("track"));
        self._fill:.setStyle(self.getStyle().getSubStyle("fill"));
        self._thumb:.setStyle(self.getStyle().getSubStyle("thumb"));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        self:.placeParts();
    }

    over onUpdateScissors(mut self) {
        let (sciPos, sciSize) = self.getScissors(self._absolutePostBorderPosition, self._absolutePostBorderSize);
        self._track:.setScissors(sciPos, sciSize);
        self._fill:.setScissors(sciPos, sciSize);
        self._thumb:.setScissors(sciPos, sciSize);
    }

    pub over getMaxDepth(self)-> u32 {
        self._thumb.getMaxDepth()
    }

    /**
     * The content of a slider is its thumb across, and a track of 160 pixels along
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        let (thumb, track) = self:.measureParts(makeVec2(INDEFINITE_SIZE, INDEFINITE_SIZE));
        if self.isRow() {
            (thumb.x, max(thumb.x, DEFAULT_TRACK_LENGTH))
        } else {
            let width = max(thumb.x, track.x);
            (width, width)
        }
    }

    prot over measureContentHeights(mut self, _: f32)-> (f32, f32) {
        let (thumb, track) = self:.measureParts(makeVec2(INDEFINITE_SIZE, INDEFINITE_SIZE));
        if self.isRow() {
            let height = max(thumb.y, track.y);
            (height, height)
        } else {
            (thumb.y, max(thumb.y, DEFAULT_TRACK_LENGTH))
        }
    }

    /**
     * Place the track across the middle of the content box, the thumb at the value, and the fill from the start of
     * the track to the centre of the thumb
     * */
    fn placeParts(mut self) {
        if !self._attached { return; }

        let row = self.isRow();
        let (thumb, track) = self:.measureParts(self._absoluteSize);
        self._thumbSize = thumb;

        let length = along(row, self._absoluteSize);
        let breadth = across(row, self._absoluteSize);
        let fraction = self._range.fractionOf(self._value);

        // along a column the lowest value is at the bottom
        let travel = max(0.0f, length - along(row, thumb));
        let thumbStart = if row { fraction * travel } else { (1.0f - fraction) * travel };
        let centre = thumbStart + along(row, thumb) / 2.0f;

        let trackPos = self._absolutePosition + axes(row, 0.0f, (breadth - across(row, track)) / 2.0f);
        let trackSize = axes(row, length, across(row, track));
        self._track:.setSize(trackPos, trackSize, self._depth + 1, self._absoluteSize);

        let (fillStart, fillLength) = if row { (0.0f, centre) } else { (centre, length - centre) };
        self._fill:.setSize(trackPos + axes(row, fillStart, 0.0f), axes(row, fillLength, across(row, track)),
                            self._track.getMaxDepth(), self._absoluteSize);

        let thumbPos = self._absolutePosition + axes(row, thumbStart, (breadth - across(row, thumb)) / 2.0f);
        self._thumb:.setSize(thumbPos, thumb, self._fill.getMaxDepth(), self._absoluteSize);

        self:.onUpdateScissors();
    }

    /**
     * @returns: the sizes of the margin boxes of the thumb and of the track, sized by their style, the track being as
     * long as the content box
     * @params:
     *    - container: the content box of the slider, a component being INDEFINITE_SIZE when it is unknown
     * */
    fn measureParts(mut self, container: vec2)-> (vec2, vec2) {
        let row = self.isRow();
        let thumb = self._thumb:.measurePartSize(container, makeVec2(DEFAULT_THUMB_SIZE, DEFAULT_THUMB_SIZE));
        let track = self._track:.measurePartSize(container, axes(row, along(row, container), DEFAULT_TRACK_THICKNESS));

        (thumb, track)
    }

    /**
     * @returns: the value under a position of the cursor, the centre of the thumb following it
     * @params:
     *    - pos: the position of the cursor, relative to the margin box of the slider
     * */
    fn valueUnder(self, pos: vec2)-> f32 {
        let row = self.isRow();
        let cursor = self._absoluteFullPosition + pos * self._absoluteFullSize - self._absolutePosition;
        let travel = along(row, self._absoluteSize) - along(row, self._thumbSize);
        if travel <= 0.0f { return self.getValue(); }

        let fraction = (along(row, cursor) - along(row, self._thumbSize) / 2.0f) / travel;
        self._range.valueAt(if row { fraction } else { 1.0f - fraction })
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self._track:.onAttach((self)?);
        self._fill:.onAttach((self)?);
        self._thumb:.onAttach((self)?);
    }

    over onHide(mut self) {
        self._track:.hide();
        self._fill:.hide();
        self._thumb:.hide();
    }

    over onShow(mut self) {
        self._track:.show();
        self._fill:.show();
        self._thumb:.show();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover(mut self, _: vec2)-> dmut (&Widget)? {
        self:.setHover(true);
        (alias self)?
    }

    pub over onLoseHoverFocus(mut self) {
        self:.setHover(false);
    }

    /**
     * A click of the left button moves the thumb under the cursor and grabs it
     * */
    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if button == SDL_BUTTON_LEFT {
            self._grabbed = true;
            self:.setPressed(true);
            self:.setValueByUser(self.valueUnder(pos));
        }

        (alias self)?
    }

    pub over onSliding(mut self, pos: vec2, _: vec2, _: u8) {
        if self._grabbed {
            self:.setValueByUser(self.valueUnder(pos));
        }
    }

    pub over onSlidingEnd(mut self, _: u8) {
        self._grabbed = false;
        self:.setPressed(false);
    }

    /**
     * The wheel moves the value by a step
     * */
    pub over onScroll(mut self, _: vec2, _: i32, amountY: i32)-> bool {
        if amountY == 0 { return false; }

        self:.setValueByUser(self._range.moveBy(self.getValue(), if amountY > 0 { 1 } else { -1 }));
        true
    }

    pub over isFocusableLeftClick(self)-> bool {
        true
    }

    pub over loseFocusOnReleaseLeft(self)-> bool {
        true
    }

    pub over onLoseFocus(mut self) {
        self._grabbed = false;
        self:.setPressed(false);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the user changes the value, with the new value
     * */
    pub fn changed(mut self)-> dmut &Signal!{f32} {
        if let Ok(dmut s) = alias self._changed {
            return alias s;
        }

        let dmut s = copy Signal!{f32} ();
        self._changed = (alias s)?;

        alias s
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._track:.dispose();
            self._fill:.dispose();
            self._thumb:.dispose();
            self.__super__:.dispose();
        }
    }
}

/**
 * The sliders in a .gui file
 * */
pub mod Slider {

    /**
     * @returns: the schema of the sliders, their value being their default attribute
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("Slider",
                          |dmut m, id|-> dmut &Widget => copy Slider(alias m, id),
                          attributes-> copy [copy Setter!{&Slider, f32}("value", |dmut s, v| => { s:.setValue(v); }),
                                             copy Setter!{&Slider, f32}("min", |dmut s, v| => {
                                                 s:.setRange(ValueRange(lower-> v, upper-> s.getRange().upper, step-> s.getRange().step));
                                             }),
                                             copy Setter!{&Slider, f32}("max", |dmut s, v| => {
                                                 s:.setRange(ValueRange(lower-> s.getRange().lower, upper-> v, step-> s.getRange().step));
                                             }),
                                             copy Setter!{&Slider, f32}("step", |dmut s, v| => {
                                                 s:.setRange(ValueRange(lower-> s.getRange().lower, upper-> s.getRange().upper, step-> v));
                                             })],
                          defaultAttribute-> "value",
                          signals-> copy [copy Emitter!{&Slider, f32}("on-change", |dmut s|-> dmut &Signal!{f32} => alias s:.changed())],
                          parts-> copy ["track", "fill", "thumb"],
                          properties-> copy [Layout::direction()])
    }
}
