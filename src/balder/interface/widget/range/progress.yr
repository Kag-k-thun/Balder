in progress;

use balder::core::dispose;
use balder::interface::loader::registry::schema;
use balder::interface::widget::{alignement, box, layout};
use balder::interface::widget::range::utils;

// The thickness of a progress bar sized to its content, in pixels
def DEFAULT_THICKNESS = 8.0f;

// The length of a progress bar sized to its content, in pixels
def DEFAULT_LENGTH = 160.0f;

/**
 * A progress bar shows how far a value is in its range, filling its content box up to it
 * @info: the filled part is the part `::fill`, from the start of the content box along the direction of the style, a
 * row by default (filled from the left), or a column (filled from the bottom); the bar itself is the background
 * */
pub class ProgressBar over Widget {

    // The bounds of the value
    let mut _range: ValueRange = ValueRange();

    // The value as it was set, snapped to the range when it is read
    let mut _value: f32 = 0.0f;

    // The part filled up to the value
    let dmut _fill: &Box;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "ProgressBar")
        , _fill = copy Box(alias manager, "")
    {
        self._fill:.setOwnerPart("fill");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          VALUE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the bounds of the value, the value being snapped to them
     * */
    pub fn setRange(mut self, range: ValueRange) {
        self._range = range;
        self:.placeFill();
    }

    /**
     * Set the value, snapped to the range
     * */
    pub fn setValue(mut self, value: f32) {
        self._value = value;
        self:.placeFill();
    }

    /**
     * @returns: the bounds of the value
     * */
    pub fn getRange(self)-> ValueRange {
        self._range
    }

    /**
     * @returns: the value, snapped to the range
     * */
    pub fn getValue(self)-> f32 {
        self._range.snap(self._value)
    }

    /**
     * @returns: true iif the bar is filled along a row, set by the style direction, false along a column
     * */
    pub fn isRow(self)-> bool {
        if let Ok(d) = self.getStyle().getCustom!{Direction}("direction") {
            return d == Direction::ROW;
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot over onApplyStyle(mut self) {
        self._fill:.setStyle(self.getStyle().getSubStyle("fill"));
    }

    over onUpdateSize(mut self) {
        self:.placeFill();
    }

    over onUpdateScissors(mut self) {
        let (sciPos, sciSize) = self.getScissors(self._absolutePosition, self._absoluteSize);
        self._fill:.setScissors(sciPos, sciSize);
    }

    pub over getMaxDepth(self)-> u32 {
        self._fill.getMaxDepth()
    }

    /**
     * The content of a progress bar is 160 pixels along its direction, and 8 across
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        if self.isRow() { (0.0f, DEFAULT_LENGTH) } else { (DEFAULT_THICKNESS, DEFAULT_THICKNESS) }
    }

    prot over measureContentHeights(mut self, _: f32)-> (f32, f32) {
        if self.isRow() { (DEFAULT_THICKNESS, DEFAULT_THICKNESS) } else { (0.0f, DEFAULT_LENGTH) }
    }

    /**
     * Fill the content box along the direction up to the value, from the left of a row or the bottom of a column
     * */
    fn placeFill(mut self) {
        if !self._attached { return; }

        let row = self.isRow();
        let length = along(row, self._absoluteSize) * self._range.fractionOf(self._value);
        let start = if row { 0.0f } else { along(row, self._absoluteSize) - length };

        self._fill:.setSize(self._absolutePosition + axes(row, start, 0.0f),
                            axes(row, length, across(row, self._absoluteSize)),
                            self._depth + 1,
                            self._absoluteSize);

        self:.onUpdateScissors();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self._fill:.onAttach((self)?);
    }

    over onHide(mut self) {
        self._fill:.hide();
    }

    over onShow(mut self) {
        self._fill:.show();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._fill:.dispose();
            self.__super__:.dispose();
        }
    }
}

/**
 * The progress bars in a .gui file
 * */
pub mod ProgressBar {

    /**
     * @returns: the schema of the progress bars, their value being their default attribute
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("ProgressBar",
                          |dmut m, id|-> dmut &Widget => copy ProgressBar(alias m, id),
                          attributes-> copy [copy Setter!{&ProgressBar, f32}("value", |dmut p, v| => { p:.setValue(v); }),
                                             copy Setter!{&ProgressBar, f32}("min", |dmut p, v| => {
                                                 p:.setRange(ValueRange(lower-> v, upper-> p.getRange().upper));
                                             }),
                                             copy Setter!{&ProgressBar, f32}("max", |dmut p, v| => {
                                                 p:.setRange(ValueRange(lower-> p.getRange().lower, upper-> v));
                                             })],
                          defaultAttribute-> "value",
                          parts-> copy ["fill"],
                          properties-> copy [Layout::direction()])
    }
}
