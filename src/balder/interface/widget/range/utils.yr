/**
 * The axes of the widgets laid out along a row or a column, a slider and a progress bar
 * */
in utils;

use balder::math::vector;

/**
 * @returns: the component of a size along the axis of a widget
 * @params:
 *    - row: true for a widget laid out along a row, false along a column
 * */
pub fn along(row: bool, v: vec2)-> f32 {
    if row { v.x } else { v.y }
}

/**
 * @returns: the component of a size across the axis of a widget
 * @params:
 *    - row: true for a widget laid out along a row, false along a column
 * */
pub fn across(row: bool, v: vec2)-> f32 {
    if row { v.y } else { v.x }
}

/**
 * @returns: the vector of a component along the axis of a widget and of a component across it
 * @params:
 *    - row: true for a widget laid out along a row, false along a column
 * */
pub fn axes(row: bool, alongAxis: f32, acrossAxis: f32)-> vec2 {
    if row { makeVec2(alongAxis, acrossAxis) } else { makeVec2(acrossAxis, alongAxis) }
}
