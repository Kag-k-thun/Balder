in files;

use balder::interface::dialog::file::utils;
use balder::interface::widget::tree::{file_node, model};

use std::fs;

mod ::nodes;

/**
 * The files of a directory and of the directories under it, as a tree view shows them: the directories first, then the
 * files, each by name as people read them, the entries whose name starts with a dot left out
 * @info:
 * =====
 * The model reads the whole tree at once (reload), then shows the part of it its filters keep: the files of some kinds
 * only (setKinds, by their extensions, every file by default), and those whose name holds a text (setFilter, whatever
 * the case of its letters), a directory being kept while one of its entries is, or while its own name holds the text,
 * every directory being kept without a text. One file is marked (setMarked, the file opened...), its row taking the state
 * :marked. The icon of an entry is the one its function gives (setIconOf), none by default.
 *
 * A node is named by its path in the tree shown (see TreeModel), which changes as the files and the filters do: the
 * application keeps the absolute paths of the files (fileAt) and finds their nodes again (nodeOf).
 * ====
 * */
@final
pub class FileTreeModel over TreeModel {

    // The absolute path of the directory shown, empty for none
    let mut _root: [c8] = "";

    // Every entry under the directory, read by reload, and the entries the filters keep
    let mut _all: [&FileNode] = [];
    let mut _shown: [&FileNode] = [];

    // The extensions of the files kept, without their dot, every file for none
    let mut _kinds: [[c8]] = [];

    // The text the names of the entries kept hold, every entry for an empty text
    let mut _filter: [c8] = "";

    // The absolute path of the file marked, empty for none
    let mut _marked: [c8] = "";

    // The icon of an entry, none for no icon
    let mut _iconOf: (dg (&FileNode)-> [c8])? = none;

    pub self () {}

    /**
     * Show the files of a directory, read at once
     * @params:
     *    - root: the absolute path of the directory
     * */
    pub fn setRoot(mut self, root: [c8]) {
        self._root = root;
        self:.reload();
    }

    /**
     * @returns: the absolute path of the directory shown, empty for none
     * */
    pub fn getRoot(self)-> [c8] {
        self._root
    }

    /**
     * Read the files of the directory again, after they changed, the views showing the model reading it again
     * */
    pub fn reload(mut self) {
        self._all = if self._root.len == 0us { [] } else { readFileTree(self._root) };
        self:.applyFilters();
    }

    /**
     * Keep the files of some kinds only, the views reading the model again
     * @params:
     *    - extensions: the extensions of the files kept, without their dot ("png"), every file for none
     * */
    pub fn setKinds(mut self, extensions: [[c8]]) {
        self._kinds = extensions;
        self:.applyFilters();
    }

    /**
     * Keep the entries whose name holds a text, whatever the case of its letters, and the directories holding one, the
     * views reading the model again
     * @params:
     *    - text: the text, every entry being kept for an empty text
     * */
    pub fn setFilter(mut self, text: [c8]) {
        self._filter = text;
        self:.applyFilters();
    }

    /**
     * @returns: the text the names of the entries shown hold, empty for none
     * */
    pub fn getFilter(self)-> [c8] {
        self._filter
    }

    /**
     * Mark a file, its row taking the state :marked, the views reading the model again when it changes
     * @params:
     *    - path: the absolute path of the file, empty for none
     * */
    pub fn setMarked(mut self, path: [c8]) {
        if self._marked == path { return; }

        self._marked = path;
        self.changed();
    }

    /**
     * Give the entries the icons a function tells
     * @params:
     *    - iconOf: the image of the icon of an entry, "" for none
     * */
    pub fn setIconOf(mut self, iconOf: dg (&FileNode)-> [c8]) {
        self._iconOf = (iconOf)?;
        self.changed();
    }

    /**
     * @returns: the entry of a node, none when the path names no node shown
     * */
    pub fn fileAt(self, node: [usize])-> (&FileNode)? {
        let mut entries = self._shown;
        let mut found: (&FileNode)? = none;
        for i in node {
            if i >= entries.len { return none; }
            found = (entries[i])?;
            entries = entries[i].children;
        }

        found
    }

    /**
     * @returns: the node of an entry shown, none when no entry shown has that path
     * @params:
     *    - path: the absolute path of the entry
     * */
    pub fn nodeOf(self, path: [c8])-> ([usize])? {
        nodes::findPath(self._shown, path, [])
    }

    /**
     * @returns: the nodes of the directories shown, each before the directories under it
     * */
    pub fn directories(self)-> [[usize]] {
        nodes::directoriesOf(self._shown, [])
    }

    pub over len(self, node: [usize])-> usize {
        if node.len == 0us { return self._shown.len; }
        if let Ok(f) = self.fileAt(node) { f.children.len } else { 0us }
    }

    pub over text(self, node: [usize])-> [c8] {
        if let Ok(f) = self.fileAt(node) { f.name } else { "" }
    }

    pub over icon(self, node: [usize])-> [c8] {
        if let Ok(f) = self.fileAt(node) {
            if let Ok(i) = self._iconOf { return i(f); }
        }

        ""
    }

    pub over marked(self, node: [usize])-> bool {
        if self._marked.len == 0us { return false; }
        if let Ok(f) = self.fileAt(node) { f.path == self._marked } else { false }
    }

    /**
     * Keep the entries the kinds and the text keep, the views reading the model again
     * */
    fn applyFilters(mut self) {
        self._shown = filterFileTree(self._all, self._kinds, self._filter);
        self.changed();
    }
}

/**
 * @returns: the entries of a directory and of the directories under it, the directories first then the files, each by
 * name as people read them, those whose name starts with a dot left out; none when it cannot be read
 * @params:
 *    - directory: the absolute path of the directory
 * */
pub fn readFileTree(directory: [c8])-> [&FileNode] {
    let mut entries: [&FileNode] = [];
    for e in listDirectory(directory, [], hidden-> false, directoriesOnly-> false) {
        let path = Path(directory).push(e.name).toStr();
        if e.isDirectory {
            entries ~= [copy FileNode(e.name, path, isDirectory-> true, children-> readFileTree(path))];
        } else {
            entries ~= [copy FileNode(e.name, path, size-> e.size)];
        }
    }

    entries
}

/**
 * @returns: the entries a FileTreeModel shows: the files of some kinds whose name holds a text, the directories holding
 * one of them, or whose own name holds the text (their files of those kinds kept), every directory without a text
 * @params:
 *    - entries: the entries of a directory, in order
 *    - kinds: the extensions of the files kept, without their dot, every file for none
 *    - text: the text the names hold, whatever the case of its letters, every name for an empty text
 * */
pub fn filterFileTree(entries: [&FileNode], kinds: [[c8]], text: [c8])-> [&FileNode] {
    let lowered = nodes::lowerCase(text);
    let mut kept: [&FileNode] = [];
    for n in entries {
        let named = lowered.len == 0us || nodes::holds(nodes::lowerCase(n.name), lowered);
        if n.isDirectory {
            let children = filterFileTree(n.children, kinds, if named { "" } else { text });
            if named || children.len != 0us {
                kept ~= [copy FileNode(n.name, n.path, isDirectory-> true, children-> children)];
            }
        } else if named && matchesFilters(n.name, kinds) {
            kept ~= [n];
        }
    }

    kept
}
