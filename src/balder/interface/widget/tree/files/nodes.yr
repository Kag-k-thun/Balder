in nodes;

use balder::interface::widget::tree::file_node;

/**
 * @returns: the path of the node of an entry among some entries and the entries under them, none when none has that
 * path
 * @params:
 *    - nodes: the entries, the children of the node at
 *    - path: the absolute path of the entry
 *    - at: the path of the node the entries are the children of
 * */
pub fn findPath(nodes: [&FileNode], path: [c8], at: [usize])-> ([usize])? {
    for i, n in nodes {
        if n.path == path { return (at ~ [i])?; }
        if n.isDirectory && path.len > n.path.len && path[0us .. n.path.len] == n.path && path[n.path.len] == '/' {
            return findPath(n.children, path, at ~ [i]);
        }
    }

    none
}

/**
 * @returns: the paths of the nodes of the directories among some entries, each before the directories under it
 * @params:
 *    - at: the path of the node the entries are the children of
 * */
pub fn directoriesOf(nodes: [&FileNode], at: [usize])-> [[usize]] {
    let mut result: [[usize]] = [];
    for i, n in nodes if n.isDirectory {
        result ~= [at ~ [i]];
        result ~= directoriesOf(n.children, at ~ [i]);
    }

    result
}

/**
 * @returns: true iif a text holds another one
 * */
pub fn holds(text: [c8], part: [c8])-> bool {
    if part.len > text.len { return false; }
    for i in 0us .. text.len - part.len + 1us {
        if text[i .. i + part.len] == part { return true; }
    }

    false
}

/**
 * @returns: a text whose ASCII capitals are lowered
 * */
pub fn lowerCase(text: [c8])-> [c8] {
    copy [if c >= 'A'c8 && c <= 'Z'c8 { cast!c8(cast!u8(c) + 32u8) } else { c } for c in text]
}
