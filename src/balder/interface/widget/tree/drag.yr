in drag;

use balder::math::vector;

use ::sdl3::keycode;

/**
 * Rows of a tree view dragged out of it, to be dropped on another widget: the nodes dragged, where the cursor is and
 * whether it was released (see TreeView::setDragOut)
 * @info: emitted at each move of the cursor dragging the rows, then once released or cancelled, the receivers marking
 * the place under the cursor while it is out of the tree, and taking the nodes when they are released out of it
 * */
@data
pub record TreeDrag {

    // The paths of the nodes dragged, in the order of their rows, those under another node dragged left out
    pub let nodes: [[usize]] = [];

    // The cursor, in the layout pixels from the top left corner of the window
    pub let at: vec2 = vec2();

    // True iif the cursor is out of the tree view
    pub let outside: bool = false;

    // True iif the drag ended, released or cancelled (a cancelled drag is never outside)
    pub let released: bool = false;

    // The modifiers held (SDL_KMOD_*)
    pub let mods: SDL_Keymod = 0u16;
}
