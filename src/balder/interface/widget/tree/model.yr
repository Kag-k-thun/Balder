in model;

use balder::interface::widget::list::view_model;

/**
 * The nodes a tree view shows, read on demand: the view asks the number of children of the nodes it shows, and the text
 * of the rows it shows only
 * @info:
 * =====
 * A node is named by its path, the index of each of its ancestors among the children of the one before, then its own:
 * `[]` is the root, never shown, whose children are the first level of the tree, `[2, 0]` the first child of the third
 * of them. A model of the application derives from it to give nodes it computes or holds elsewhere, the children of a
 * node being read when it is expanded only. A model whose nodes change calls `changed`, every view showing it reading it
 * again.
 * ====
 * */
@abstract
pub class TreeModel over ViewModel {

    prot self ()
        with super()
    {}

    /**
     * @returns: the number of children of a node, 0 for a leaf
     * @params:
     *    - node: the path of the node, [] for the root
     * */
    pub fn len(self, node: [usize])-> usize;

    /**
     * @returns: the text of a node
     * @params:
     *    - node: the path of the node, not the root
     * */
    pub fn text(self, node: [usize])-> [c8];
}
