in expansion;

/**
 * A node of a tree expanded, its children being shown under it
 * */
class ExpandedNode {

    // The number of children of the node
    pub let mut count: usize;

    // The index of each child expanded, in increasing order, and its expanded node
    pub let mut indices: [usize] = [];
    pub let dmut nodes: [&ExpandedNode] = [];

    // The number of rows under the node: its children, and the rows under those expanded
    pub let mut size: usize;

    /**
     * @params:
     *    - count: the number of children of the node
     * */
    pub self (count: usize)
        with count = count
        , size = count
    {}

    /**
     * @returns: the position among the children expanded of a child, or of the first one after it, and true iif it is
     * expanded
     * */
    pub fn find(self, child: usize)-> (usize, bool) {
        for k, i in self.indices {
            if i >= child { return (k, i == child); }
        }

        (self.indices.len, false)
    }

    /**
     * @returns: the rows under the children expanded before a position among them
     * */
    pub fn sizeBefore(self, k: usize)-> usize {
        let mut size = 0us;
        for j in 0us .. k {
            size += self.nodes[j].size;
        }

        size
    }

    /**
     * Compute the number of rows under the node again, from its children and those expanded
     * */
    pub fn resize(mut self) {
        self.size = self.count + self.sizeBefore(self.nodes.len);
    }
}

/**
 * The nodes of a tree a view expanded, and the rows they show
 * @info:
 * =====
 * The root is always expanded, and never shown: its children are the first rows. Below a node expanded come its
 * children, each followed by the rows under it when it is expanded too. A node is named by its path, the index of each
 * of its ancestors among the children of the one before, then its own, `[]` being the root.
 *
 * Only the nodes expanded are kept, with the number of their children and of the rows under them, so that a row is
 * found from its index, and the index of a node from its path, by going down the nodes expanded only: a first level of
 * a million nodes, a few of them expanded, costs no more than those few. Collapsing a node forgets the nodes expanded
 * under it.
 * ====
 * */
pub class TreeExpansion {

    // The root, always expanded
    let dmut _root: &ExpandedNode;

    /**
     * @params:
     *    - count: the number of children of the root
     * */
    pub self (count: usize = 0us)
        with _root = copy ExpandedNode(count)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of rows shown, the nodes whose ancestors are all expanded
     * */
    pub fn getRowCount(self)-> usize {
        self._root.size
    }

    /**
     * @returns: the path of the node a row shows
     * @params:
     *    - row: the row, below the number of rows
     * */
    pub fn pathOf(self, row: usize)-> [usize] {
        let mut path: [usize] = [];
        let mut node = self._root;
        let mut r = row;
        loop {
            // the row is a child of the node, after the rows under the children expanded before it, or under one of them
            let mut before = 0us;
            let mut under: (&ExpandedNode)? = none;
            for k, i in node.indices {
                let at = i + before;
                if r < at { break; }
                if r == at {
                    return path ~ [i];
                }

                let sub = node.nodes[k];
                if r <= at + sub.size {
                    path ~= [i];
                    r = r - at - 1us;
                    under = (sub)?;
                    break;
                }

                before += sub.size;
            }

            if let Ok(sub) = under {
                node = sub;
            } else {
                return path ~ [r - before];
            }
        }

        path
    }

    /**
     * @returns: the row showing a node, none for the root, a node past the children of its parent, or a node whose
     * ancestors are not all expanded
     * @params:
     *    - node: the path of the node
     * */
    pub fn rowOf(self, node: [usize])-> (usize)? {
        if node.len == 0us { return none; }

        let mut current = self._root;
        let mut row = 0us;
        for depth, i in node {
            if i >= current.count { return none; }

            let (k, expanded) = current.find(i);
            row += i + current.sizeBefore(k);
            if depth + 1us == node.len { return (row)?; }
            if !expanded { return none; }

            // the rows under the node start after it
            row += 1us;
            current = current.nodes[k];
        }

        none
    }

    /**
     * @returns: true iif a node is expanded, the root always being
     * @params:
     *    - node: the path of the node
     * */
    pub fn isExpanded(self, node: [usize])-> bool {
        let mut current = self._root;
        for i in node {
            let (k, expanded) = current.find(i);
            if !expanded { return false; }
            current = current.nodes[k];
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          EXPANDING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Expand a node whose parent is expanded, its children being shown under it
     * @params:
     *    - node: the path of the node, not the root
     *    - count: the number of children of the node
     * @returns: the first row of its children and their number, none when the node is not shown, is already expanded or
     * has no children
     * */
    pub fn expandNode(mut self, node: [usize], count: usize)-> (usize, usize)? {
        if count == 0us || node.len == 0us { return none; }

        let row = if let Ok(r) = self.rowOf(node) { r } else { return none; };
        let parent = node[0us .. node.len - 1us];
        let child = node[node.len - 1us];
        let dmut p = if let Ok(dmut p) = alias self:.findNode(parent) { alias p } else { return none; };

        let (k, expanded) = p.find(child);
        if expanded { return none; }

        p.indices = p.indices[0us .. k] ~ [child] ~ p.indices[k .. p.indices.len];
        p.nodes = p.nodes[0us .. k] ~ [copy ExpandedNode(count)] ~ p.nodes[k .. p.nodes.len];
        self:.resizeAlong(parent);

        (row + 1us, count)?
    }

    /**
     * Collapse a node expanded, its children and the rows under them being hidden, the nodes expanded under it being
     * forgotten
     * @params:
     *    - node: the path of the node, not the root
     * @returns: the first row of its children and the number of rows hidden, none when the node is not shown or is not
     * expanded
     * */
    pub fn collapseNode(mut self, node: [usize])-> (usize, usize)? {
        if node.len == 0us { return none; }

        let row = if let Ok(r) = self.rowOf(node) { r } else { return none; };
        let parent = node[0us .. node.len - 1us];
        let child = node[node.len - 1us];
        let dmut p = if let Ok(dmut p) = alias self:.findNode(parent) { alias p } else { return none; };

        let (k, expanded) = p.find(child);
        if !expanded { return none; }

        let hidden = p.nodes[k].size;
        p.indices = p.indices[0us .. k] ~ p.indices[k + 1us .. p.indices.len];
        p.nodes = p.nodes[0us .. k] ~ p.nodes[k + 1us .. p.nodes.len];
        self:.resizeAlong(parent);

        (row + 1us, hidden)?
    }

    /**
     * Collapse every node, the root having a number of children
     * @params:
     *    - count: the number of children of the root
     * */
    pub fn reset(mut self, count: usize) {
        self._root = copy ExpandedNode(count);
    }

    /**
     * Read the number of children of the nodes expanded again, after the nodes of the tree changed: a node expanded
     * past the children of its parent, or left without children, is collapsed
     * @params:
     *    - counts: the number of children of a node, from its path
     * */
    pub fn update(mut self, counts: dg ([usize])-> usize) {
        updateNode(alias self._root, [], counts);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the node expanded of a path, none when it is not expanded or one of its ancestors is not
     * */
    fn findNode(mut self, node: [usize])-> dmut (&ExpandedNode)? {
        let dmut current = alias self._root;
        for i in node {
            let (k, expanded) = current.find(i);
            if !expanded { return none; }
            current = alias current.nodes[k];
        }

        (alias current)?
    }

    /**
     * Compute the number of rows under the nodes of a path again, from the deepest to the root
     * */
    fn resizeAlong(mut self, node: [usize]) {
        let mut depth = node.len + 1us;
        while depth > 0us {
            depth -= 1us;
            if let Ok(dmut n) = alias self:.findNode(node[0us .. depth]) {
                n:.resize();
            }
        }
    }
}

/**
 * Read the number of children of a node expanded and of the nodes expanded under it again, collapsing those past its
 * children or without children
 * */
fn updateNode(dmut node: &ExpandedNode, path: [usize], counts: dg ([usize])-> usize) {
    node.count = counts(path);

    let mut indices: [usize] = [];
    let dmut nodes: [&ExpandedNode] = [];
    for k, i in node.indices {
        if i < node.count {
            let dmut sub = alias node.nodes[k];
            updateNode(alias sub, path ~ [i], counts);
            if sub.count != 0us {
                indices ~= [i];
                nodes ~= [alias sub];
            }
        }
    }

    node.indices = indices;
    node.nodes = alias nodes;
    node:.resize();
}
