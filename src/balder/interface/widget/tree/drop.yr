in drop;

use ::sdl3::keycode;

/**
 * A drop of rows of a tree view: the nodes dragged, and the place the user dropped them at, under a node and among its
 * children, the model deciding what the drop does (see TreeView::dropped)
 * @info: the paths are those of the nodes before the drop, the nodes dragged counted among the children of the parent
 * */
@data
pub record TreeDrop {

    // The paths of the nodes dragged, in the order of their rows, those under another node dragged left out (they follow
    // it)
    pub let nodes: [[usize]] = [];

    // The path of the node they go under, [] for the root
    pub let parent: [usize] = [];

    // The place they go to among the children of the parent: before the child at that place, after the last one for the
    // number of children
    pub let index: usize = 0us;

    // True iif they were dropped on the row of the parent, to go under it after its children, false when dropped between
    // two rows
    pub let onto: bool = false;

    // The modifiers held when they were dropped (SDL_KMOD_*)
    pub let mods: SDL_Keymod = 0u16;
}
