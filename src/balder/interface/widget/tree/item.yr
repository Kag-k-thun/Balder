in item;

/**
 * A node of a TextTreeModel: a text, its children and its icon
 * */
@final
pub class TreeItem {

    // The text of the node
    pub let text: [c8];

    // The children of the node, in order
    pub let children: [&TreeItem];

    // The image of the icon of the node, "" for none
    pub let icon: [c8];

    /**
     * @params:
     *    - text: the text of the node
     *    - children: the children of the node, in order, none for a leaf
     *    - icon: the image of the icon of the node, "" for none
     * */
    pub self (text: [c8], children: [&TreeItem] = [], icon: [c8] = "")
        with text = text
        , children = children
        , icon = icon
    {}
}
