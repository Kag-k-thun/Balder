in item;

/**
 * A node of a TextTreeModel: a text and its children
 * */
@final
pub class TreeItem {

    // The text of the node
    pub let text: [c8];

    // The children of the node, in order
    pub let children: [&TreeItem];

    /**
     * @params:
     *    - text: the text of the node
     *    - children: the children of the node, in order, none for a leaf
     * */
    pub self (text: [c8], children: [&TreeItem] = [])
        with text = text
        , children = children
    {}
}
