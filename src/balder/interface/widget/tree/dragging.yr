/**
 * The drops of the rows of a tree view dragged by the user: the place under the cursor, the nodes dragged, and the
 * scroll of the rows at their edges (see TreeView::setDraggable)
 * */
in dragging;

use balder::interface::widget::tree::drop;

use ::std::algorithm::comparison;

// The share of the height of a row, at its top and at its bottom, that drops between rows, the middle dropping on it
pub def DROP_EDGE = 0.25f;

// The speed of the scroll while the cursor is at the edges of the rows, in rows a second, twice that for a cursor
// past the edges
pub def SCROLL_ROWS = 12.0;

/**
 * @returns: the drop on a row: before its node in its top quarter, after it in its bottom quarter (before the first
 * child of a node expanded), and under it after its children in between
 * @params:
 *    - row: the path of the node of the row
 *    - part: the position of the cursor in the height of the row, from 0 at its top to 1 at its bottom
 *    - children: the number of children of the node
 *    - expanded: true iif the node is expanded, its children shown under it
 * */
pub fn dropOnRow(row: [usize], part: f32, children: usize, expanded: bool)-> TreeDrop {
    let parent = row[0us .. row.len - 1us];
    let place = row[row.len - 1us];
    if part < DROP_EDGE {
        return TreeDrop(parent-> parent, index-> place);
    }

    if part >= 1.0f - DROP_EDGE {
        if expanded && children != 0us {
            return TreeDrop(parent-> row, index-> 0us);
        }

        return TreeDrop(parent-> parent, index-> place + 1us);
    }

    TreeDrop(parent-> row, index-> children, onto-> true)
}

/**
 * @returns: the drop below the rows, after the last node of the first level
 * @params:
 *    - count: the number of nodes of the first level
 * */
pub fn dropBelowRows(count: usize)-> TreeDrop {
    TreeDrop(parent-> [], index-> count)
}

/**
 * @returns: true iif a drop puts nodes under one of them, its parent being a node dragged or a node under one
 * */
pub fn isUnderDragged(place: TreeDrop)-> bool {
    for n in place.nodes {
        if n.len <= place.parent.len && place.parent[0us .. n.len] == n { return true; }
    }

    false
}

/**
 * @returns: the nodes dragged out of the selected ones, those under another one selected left out
 * @params:
 *    - selected: the paths of the nodes selected, in the order of their rows
 * */
pub fn draggedOf(selected: [[usize]])-> [[usize]] {
    let mut kept: [[usize]] = [];
    for s in selected {
        let mut under = false;
        for o in selected {
            if o.len < s.len && s[0us .. o.len] == o { under = true; }
        }

        if !under { kept ~= [s]; }
    }

    kept
}

/**
 * @returns: the speed the rows scroll at while rows are dragged, in pixels a second, negative upwards: the cursor in
 * the top or the bottom row of the view, or past them, scrolls the rows faster as it goes further
 * @params:
 *    - y: the position of the cursor, in pixels from the top of the rows shown
 *    - view: the height of the rows shown, in pixels
 *    - height: the height of a row, in pixels
 * */
pub fn edgeScroll(y: f32, view: f32, height: f32)-> f64 {
    if height <= 0.0f || view <= 0.0f { return 0.0; }

    let zone = min(height, view / 2.0f);
    let depth = if y < zone {
        -min((zone - y) / zone, 2.0f)
    } else if y > view - zone {
        min((y - (view - zone)) / zone, 2.0f)
    } else {
        0.0f
    };

    cast!f64(depth) * SCROLL_ROWS * cast!f64(height)
}
