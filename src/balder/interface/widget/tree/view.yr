in view;

use balder::core::dispose;
use balder::core::application::{input, signal};
use balder::interface::loader::registry::schema;
use balder::interface::style;
use balder::interface::style::{kinds, property};
use balder::interface::widget::{image, marker};
use balder::interface::widget::list::rows_view;
use balder::interface::widget::text::{input, label};
use balder::interface::widget::tree::{drag, dragging, drop, edit, expansion, model};
use balder::math::vector;

use std::time;

use ::sdl3::{keyboard, keycode, mouse};

use ::std::algorithm::comparison;

// The text the height of a row is measured with, a single line of the font of the rows
def PROBE_TEXT = "Mg";

// The distance the cursor goes from where it pressed a row before the rows selected are dragged, in pixels
def DRAG_DISTANCE = 4.0f;

// The time a node collapsed is hovered by the rows dragged before it expands, in seconds
def EXPAND_DELAY = 0.6;

// The distance from the cursor to the icon of the rows dragged out of a tree, right and down, in pixels
def GHOST_OFFSET = 14.0f;

// The narrowest the field editing the text of a row gets, in pixels
def EDIT_MIN_WIDTH = 48.0f;

/**
 * The icon of a row of a tree view, between its marker and its text: an image drawing the background and the border of
 * the part ::icon, the image of its node as its background image
 * */
class TreeIcon over Image {

    pub self (dmut manager: &WidgetManager)
        with super(alias manager, "")
    {
        self:.setOwnerPart("icon");
        self:.hide();
    }
}

/**
 * The line a tree view draws between two rows while rows are dragged, where they would be dropped: a label without
 * text drawing the background of the part ::drop
 * */
class TreeDropLine over Label {

    pub self (dmut manager: &WidgetManager)
        with super(alias manager, "")
    {
        self._hasBackground = true;
        self._hasBorder = true;
        self:.setOwnerPart("drop");
        self:.forceNoWrap(true);
        self:.hide();
    }
}

/**
 * The icon of the rows dragged out of a tree view, following the cursor over the other widgets: an image drawing the
 * part ::ghost, the icon of the first node dragged as its background image
 * */
class TreeDragIcon over Image {

    pub self (dmut manager: &WidgetManager)
        with super(alias manager, "")
    {
        self:.setOwnerPart("ghost");
        self:.hide();
    }
}

/**
 * The field the text of a row of a tree view is edited in, over the text of the row: an input text of the class
 * tree-edit, Escape cancelling the edit, Enter giving the focus back to the tree
 * */
class TreeRowInput over InputText {

    // True once Escape was pressed, the text typed being dropped as the field loses the focus
    pub let mut cancelled: bool = false;

    // The tree whose row is edited
    let dmut _tree: &Widget;

    // Called with the text typed once the field loses the focus
    let _done: dg ([c8])-> void;

    /**
     * @params:
     *    - tree: the tree whose row is edited, focused again once the text is validated
     *    - done: called with the text typed once the field loses the focus, cancelled or not
     * */
    pub self (dmut manager: &WidgetManager, dmut tree: &Widget, done: dg ([c8])-> void)
        with super(alias manager, "")
        , _tree = alias tree
        , _done = done
    {
        self:.setClasses(copy ["tree-edit"]);
        self:.hide();
    }

    pub over onLoseFocus(mut self) {
        self.__super__:.onLoseFocus();
        self._done(self.getText());
    }

    /**
     * Escape cancels the edit, the field losing the focus once it is released
     * */
    pub over onKeyPressed(mut self, key: SDL_Keycode, mods: SDL_Keymod)-> bool {
        if key == SDLK_ESCAPE {
            self.cancelled = true;
            return true;
        }

        self.__super__:.onKeyPressed(key, mods)
    }

    /**
     * Enter, and the release of Escape, give the focus back to the tree, the field losing it
     * */
    pub over onTextValidate(mut self, _: KeyInfo) {
        self._manager:.setFocus((alias self._tree)?);
    }
}

/**
 * A row of a tree view: a label on a single line drawing the background and the border of the part ::row, its text
 * indented by the level of its node, after the marker of a node having children and the icon of the node
 * */
class TreeRow over Label {

    // The marker, shown for a node having children
    let dmut _marker: &FoldMarker;

    // The level of the node, 0 for the children of the root
    let mut _level: usize = 0us;

    // The width of a level, and the width of the margin box of the marker, in pixels
    let mut _indent: f32 = 0.0f;
    let mut _markerWidth: f32 = 0.0f;

    // True iif the node has children, its marker being shown
    let mut _hasMarker: bool = false;

    // The icon of the node, its image, the style of the part ::icon in the states of the row, and its width, 0 when the
    // style of the tree gives the icons no room
    let dmut _icon: &TreeIcon;
    let mut _iconImage: [c8] = "";
    let mut _iconStyle: &Style = copy Style();
    let mut _iconWidth: f32 = 0.0f;

    pub self (dmut manager: &WidgetManager)
        with super(alias manager, "")
        , _marker = copy FoldMarker(alias manager, false)
        , _icon = copy TreeIcon(alias manager)
    {
        self._hasBackground = true;
        self._hasBorder = true;
        self:.setOwnerPart("row");
        self:.forceNoWrap(true);
        self._marker:.hide();
    }

    /**
     * Show a node
     * @params:
     *    - text: the text of the node
     *    - level: the level of the node, 0 for the children of the root
     *    - hasChildren: true iif the node has children, its marker being shown
     *    - expanded: true iif the node is expanded
     *    - indent: the width of a level, in pixels
     *    - markerWidth: the width of the margin box of the marker, in pixels
     *    - icon: the image of the icon of the node, "" for none
     *    - iconWidth: the width of the margin box of the icons, in pixels, 0 for none
     * */
    pub fn setNode(mut self, text: [c8], level: usize, hasChildren: bool, expanded: bool, indent: f32, markerWidth: f32,
                   icon: [c8], iconWidth: f32) {
        self._level = level;
        self._indent = indent;
        self._markerWidth = markerWidth;
        self._hasMarker = hasChildren;
        self._marker:.setExpanded(expanded);
        self._iconWidth = iconWidth;
        if icon != self._iconImage {
            self._iconImage = icon;
            self:.styleIcon();
        }

        self:.setText(text);
        self:.placeMarks();
    }

    /**
     * Give the marker the style of the part ::marker in its states
     * */
    pub fn setMarkerStyle(mut self, style: &Style) {
        self._marker:.setMarkerStyle(style);
    }

    /**
     * Give the icon the style of the part ::icon in its states, its image over it
     * */
    pub fn setIconStyle(mut self, style: &Style) {
        if style is self._iconStyle { return; }

        self._iconStyle = style;
        self:.styleIcon();
    }

    pub over getMaxDepth(self)-> u32 {
        max(self._depth, max(self._marker.getMaxDepth(), self._icon.getMaxDepth()))
    }

    /**
     * The text starts after the marker and the icon, indented by the level of the node
     * */
    over onUpdateSize(mut self) {
        self.__super__:.onUpdateSize();
        if self._absoluteSize.x > 0.0f {
            let start = TreeView::textOffset(self._level, self._indent, self._markerWidth, self._iconWidth);
            self._relTextPos = makeVec2(self._relTextPos.x + start / self._absoluteSize.x, self._relTextPos.y);
        }

        self:.placeMarks();
    }

    over onUpdateScissors(mut self) {
        self._marker:.setScissors(self._scissorPos, self._scissorSize);
        self._icon:.setScissors(self._scissorPos, self._scissorSize);
    }

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self._marker:.onAttach((self)?);
        self._icon:.onAttach((self)?);

        // attached, the icon takes the style of the part ::icon of the row, its image left out
        self:.styleIcon();
    }

    over onHide(mut self) {
        self._marker:.hide();
        self._icon:.hide();
    }

    over onShow(mut self) {
        if self._hasMarker { self._marker:.show(); } else { self._marker:.hide(); }
        if self.showsIcon() { self._icon:.show(); } else { self._icon:.hide(); }
    }

    impl Disposable {
        pub over dispose(mut self) {
            self._marker:.dispose();
            self._icon:.dispose();
            self.__super__:.dispose();
        }
    }

    /**
     * @returns: true iif the icon of the node is shown, the node having one and the style of the tree giving it room
     * */
    fn showsIcon(self)-> bool {
        self._iconImage != "" && self._iconWidth > 0.0f
    }

    /**
     * Give the icon the style of the part ::icon, the image of the node as its background image
     * */
    fn styleIcon(mut self) {
        let dmut style = copy Style();
        style:.merge(self._iconStyle);
        if self._iconImage != "" {
            style.backgroundImage = (true, self._iconImage);
        }

        self._icon:.setStyle(style);
    }

    /**
     * Place the marker before the text, indented by the level of the node, as wide as its style says and as high as the
     * content of the row, shown for a node having children while the row is drawn, and the icon of the node between
     * them, as wide as the style of the part ::icon says
     * */
    fn placeMarks(mut self) {
        if !self._attached { return; }

        let x = self._absolutePosition.x + TreeView::markerOffset(self._level, self._indent);
        self._marker:.setSize(makeVec2(x, self._absolutePosition.y), makeVec2(self._markerWidth, self._absoluteSize.y),
                              self._depth, self._absoluteSize);
        self._marker:.setScissors(self._scissorPos, self._scissorSize);
        if self._hasMarker && self.isDrawn() { self._marker:.show(); } else { self._marker:.hide(); }

        self._icon:.setSize(makeVec2(x + self._markerWidth, self._absolutePosition.y), makeVec2(self._iconWidth, self._absoluteSize.y),
                            self._depth, self._absoluteSize);
        self._icon:.setScissors(self._scissorPos, self._scissorSize);
        if self.showsIcon() && self.isDrawn() { self._icon:.show(); } else { self._icon:.hide(); }
    }
}

/**
 * A tree of nodes read on demand from a model, shown as rows a node expanded shows its children under, a single row,
 * or several, being selected by the user
 * @info:
 * =====
 * The nodes are given by the code, through a `TreeModel` the view reads on demand: it asks the number of children of
 * the root and of the nodes expanded, and the text of the rows it shows only. A node is named by its path, the index of
 * each of its ancestors among the children of the one before, then its own. Only the rows shown exist, recycled as the
 * tree scrolls, and only the nodes expanded are kept (TreeExpansion), so that a level of a million nodes costs no more
 * than the dozen shown.
 *
 * The rows are the part `::row`, all of the height of a single line of their style, in the states `:hover`, `:selected`
 * and `:current` of a list view. A node having children is preceded by the part `::marker`, ▸ when it is collapsed, ▾
 * in the state `:expanded`, in the states of its row as well; a marker whose style has an image (a chevron, another one
 * under `::marker:expanded`) draws it in place of the glyph. The marker is as wide as its style says, a level of the
 * tree indenting the rows by the property `indent` of the tree (`indent: 14;`), the width of the marker when it is not
 * set; the leaves keep the room of a marker, so that they line up with the text of their siblings having children.
 * The part `::icon`, between the marker and the text, shows the image the model gives a node (TreeModel::icon) as its
 * background image, in the states of its row; it is as wide as its style says, the texts of the rows starting after it
 * whether their node has an icon or not, and a tree whose style gives it no width shows no icon.
 *
 * A click on the marker expands or collapses its node, and a double click on a row having children does as well. The
 * keys select as in a list view; Right expands the current node, or moves to its first child when it is expanded, and
 * Left collapses it, or moves to its parent when it is collapsed. `on-select` gives the paths of the selected nodes, in
 * the order of the rows, when the user changes them, a node collapsed unselecting the nodes under it, and `on-activate`
 * gives the path of the current node when Enter is pressed on it, or of a leaf double clicked.
 *
 * A tree `draggable` drags the rows selected once the cursor pressing one of them moves (a click on a row among several
 * selected selecting it alone at its release, so that they are dragged together). A row being dragged over shows where
 * they would go: in its top quarter before its node, in its bottom quarter after it (before its first child when it is
 * expanded), as the part `::drop`, a line between the rows, indented at the level they would go to, and in between under
 * its node, the row taking the state `:drop`; below the rows they go after the last node of the first level. A node
 * collapsed hovered a moment expands, the rows scroll while the cursor is at their top or their bottom edge, and Escape
 * cancels the drag. Released, `on-drop` gives the nodes dragged and the place they were dropped at (TreeDrop), the model
 * deciding what to do of them; a place under one of the nodes dragged is none.
 *
 * The model marks the nodes it wants told apart (TreeModel::marked, a file opened...), their rows, their markers and
 * their icons taking the state `:marked`.
 *
 * A tree `drag-out` drags its rows selected out of it, to another widget (the files of a project into a scene): each
 * move of the cursor emits `on-drag-out` (TreeDrag), telling where the cursor is and whether it is out of the tree, and
 * so does the release, or the cancelling, of the drag, the receivers taking the nodes released out of the tree. A tree
 * both draggable and drag-out drops its rows inside it as well. While they are dragged, the icon of the first of them
 * follows the cursor, the part `::ghost` drawn over the other widgets, and the cursor is a hand. A widget dragging
 * something else over a tree finds the node under the cursor (nodeAt) and marks its row in the state `:drop`
 * (showDropOn).
 *
 * A right click on a row selects it alone unless it is selected, then emits `on-context` with its path, [] for a click
 * below the rows, the application opening its menu; the keys the tree does not use are emitted by keyPressed (F2
 * renaming the node...).
 *
 * The code edits the text of a row in place (editNode): a field of the class `tree-edit` over its text, Enter or a
 * click elsewhere emitting `on-edit` with the text typed (TreeEdit), Escape cancelling it.
 * ====
 * */
pub class TreeView over RowsView {

    // The model whose nodes the tree shows, none for an empty tree
    let dmut _model: (&TreeModel)? = none;

    // The nodes expanded, and the rows they show
    let dmut _expansion: &TreeExpansion = copy TreeExpansion();

    // A row, a marker and an icon never drawn, measuring the height of the rows, the width of a level and that of the
    // icons
    let dmut _probe: &TreeRow;
    let dmut _markerProbe: &FoldMarker;
    let dmut _iconProbe: &TreeIcon;

    // The width of a level of the tree, its property indent or else that of the marker, in pixels
    let mut _indent: f32 = 0.0f;

    // The width of the margin box of the markers, in pixels
    let mut _markerWidth: f32 = 0.0f;

    // The width of the margin box of the icons, in pixels, 0 when the style of the part ::icon gives them no room
    let mut _iconWidth: f32 = 0.0f;

    prot { // dragging

        // True iif the user drags the rows selected (see setDraggable)
        let mut _draggable: bool = false;

        // The row the left button pressed, the rows selected being dragged once the cursor goes far enough from where it
        // pressed it, in pixels from the top left corner of the inner box, none when it pressed no row
        let mut _pressed: (usize)? = none;
        let mut _pressedAt: vec2 = vec2();

        // A row pressed among several rows selected, selected alone when the button is released before they are dragged
        let mut _selectOnRelease: (usize)? = none;

        // True while rows are dragged
        let mut _dragging: bool = false;

        // The nodes dragged, those under another one left out
        let mut _dragged: [[usize]] = [];

        // The position of the cursor dragging them, in pixels from the top left corner of the inner box
        let mut _cursor: vec2 = vec2();

        // Where they would be dropped, none over no place they can go to
        let mut _drop: (TreeDrop)? = none;

        // The row whose top edge the line of a drop between rows lies on, the number of rows for the bottom of the last
        let mut _dropEdge: usize = 0us;

        // The time the node the rows would be dropped on was hovered, in seconds, expanded past EXPAND_DELAY
        let mut _hoverTime: f64 = 0.0;

        // The line shown between the rows they would be dropped between, and its thickness, in pixels
        let dmut _dropLine: &TreeDropLine;
        let mut _dropThickness: f32 = 0.0f;

        // True iif the rows dragged go out of the tree (see setDragOut)
        let mut _dragOut: bool = false;

        // The icon following the cursor dragging rows out of the tree, and the image it shows
        let dmut _ghost: &TreeDragIcon;
        let mut _ghostImage: [c8] = "";
    }

    prot { // editing

        // The field the text of a row is edited in, created by the first edit
        let dmut _input: (&TreeRowInput)? = none;

        // The node whose row is edited, none while no row is
        let mut _editing: ([usize])? = none;
    }

    prot { // signals
        let dmut _selected: (&Signal!{[[usize]]})? = none;
        let dmut _activated: (&Signal!{[usize]})? = none;
        let dmut _dropped: (&Signal!{TreeDrop})? = none;
        let dmut _draggedOut: (&Signal!{TreeDrag})? = none;
        let dmut _context: (&Signal!{[usize]})? = none;
        let dmut _edited: (&Signal!{TreeEdit})? = none;
        let dmut _keyPressed: (&Signal!{SDL_Keycode, SDL_Keymod})? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "TreeView")
        , _probe = copy TreeRow(alias manager)
        , _markerProbe = copy FoldMarker(alias manager, false)
        , _iconProbe = copy TreeIcon(alias manager)
        , _dropLine = copy TreeDropLine(alias manager)
        , _ghost = copy TreeDragIcon(alias manager)
    {
        self._probe:.setText(PROBE_TEXT);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          MODEL          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Show the nodes of a model, every node collapsed, the tree reading it again each time it changes; the selection is
     * cleared
     * @params:
     *    - model: the model
     * */
    pub fn setModel(mut self, dmut model: &TreeModel) {
        if let Ok(dmut old) = alias self._model {
            old:.unwatch(&self:.refresh);
        }

        model:.watch(&self:.refresh);
        self._model = (alias model)?;
        self._expansion:.reset(model.len([]));
        self._selection:.clear();
        self._offset = 0.0;
        self:.reloadRows();
    }

    /**
     * @returns: the model whose nodes the tree shows, none for an empty tree
     * */
    pub fn getModel(mut self)-> dmut (&TreeModel)? {
        alias self._model
    }

    /**
     * Read the model again, after its nodes changed: the nodes expanded stay so while they have children, the rows past
     * the nodes shown are unselected, and the rows shown take their texts again
     * */
    pub fn refresh(mut self) {
        self._expansion:.update(&self.countChildren);
        self:.reloadRows();
    }

    pub over getRowCount(self)-> usize {
        self._expansion.getRowCount()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          EXPANDING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Expand a node, and its ancestors, its children being shown under it
     * @params:
     *    - node: the path of the node
     * */
    pub fn expandNode(mut self, node: [usize]) {
        for depth in 1us .. node.len + 1us {
            self:.setExpanded(node[0us .. depth], true, user-> false);
        }
    }

    /**
     * Collapse a node, the nodes under it being unselected and collapsed, without emitting on-select
     * @params:
     *    - node: the path of the node
     * */
    pub fn collapseNode(mut self, node: [usize]) {
        self:.setExpanded(node, false, user-> false);
    }

    /**
     * @returns: true iif a node is expanded
     * @params:
     *    - node: the path of the node
     * */
    pub fn isExpanded(self, node: [usize])-> bool {
        node.len != 0us && self._expansion.isExpanded(node)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SELECTION          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select some nodes, their ancestors being expanded, without emitting on-select, the last one becoming the current
     * node, scrolled to; a single tree selects the last one only
     * @params:
     *    - nodes: the paths of the nodes to select, those naming no node being left out
     * */
    pub fn setSelected(mut self, nodes: [[usize]]) {
        let mut rows: [usize] = [];
        for n in nodes {
            if n.len != 0us {
                self:.expandNode(n[0us .. n.len - 1us]);
                if let Ok(r) = self._expansion.rowOf(n) { rows ~= [r]; }
            }
        }

        self._selection:.select(rows);
        self:.showCurrent();
    }

    /**
     * @returns: the paths of the selected nodes, in the order of the rows
     * */
    pub fn getSelected(self)-> [[usize]] {
        let mut result: [[usize]] = [];
        for r in self._selection.getSelected() {
            result ~= [self._expansion.pathOf(r)];
        }

        result
    }

    /**
     * @returns: the path of the current node, the one the keys move from, none before a row is clicked or moved to
     * */
    pub fn getCurrent(self)-> ([usize])? {
        if let Ok(c) = self._selection.getCurrent() {
            return (self._expansion.pathOf(c))?;
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DRAGGING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Let the user drag the rows selected, and drop them under a node or between two rows (see dropped), or not
     * */
    pub fn setDraggable(mut self, draggable: bool) {
        if !draggable { self:.endDrag(cancelled-> true); }
        self._draggable = draggable;
    }

    /**
     * Let the user drag the rows selected out of the tree, onto another widget (see draggedOut), or not
     * */
    pub fn setDragOut(mut self, out: bool) {
        if !out { self:.endDrag(cancelled-> true); }
        self._dragOut = out;
    }

    /**
     * @returns: true iif the user can drag the rows selected out of the tree
     * */
    pub fn isDragOut(self)-> bool {
        self._dragOut
    }

    /**
     * @returns: true iif the user can drag the rows selected
     * */
    pub fn isDraggable(self)-> bool {
        self._draggable
    }

    /**
     * @returns: true iif rows are dragged
     * */
    pub fn isDragging(self)-> bool {
        self._dragging
    }

    /**
     * @returns: the node of the row under a point of the window, none over no row (a drop from another widget)
     * @params:
     *    - at: the point, in the layout pixels from the top left corner of the window
     * */
    pub fn nodeAt(self, at: vec2)-> ([usize])? {
        let pixels = at - self._absolutePosition;
        let y = pixels.y - self._headerHeight;
        if pixels.x < 0.0f || y < 0.0f || pixels.x >= self._rowsWidth || y >= self._rowsHeight || self._rowHeight <= 0.0f {
            return none;
        }

        let item = cast!usize(cast!u64((cast!f64(y) + self._offset) / cast!f64(self._rowHeight)));
        if item < self.getRowCount() { (self._expansion.pathOf(item))? } else { none }
    }

    /**
     * Mark the row of a node as the one something dragged from another widget is dropped on, in the state :drop, or no
     * row; nothing while the rows of the tree are dragged
     * @params:
     *    - node: the path of the node, none for no row
     * */
    pub fn showDropOn(mut self, node: ([usize])?) {
        if self._dragging { return; }

        let before = if let Ok(d) = self._drop { (d.parent)? } else { none };
        if before == node { return; }

        self._drop = if let Ok(n) = node { (TreeDrop(parent-> n, onto-> true))? } else { none };
        self:.restyleRows();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          EDITING          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Edit the text of the row of a node in place, in a field over it focused, its ancestors expanded and the row
     * scrolled to; on-edit gives the text once validated, Escape cancelling it; a row edited already is cancelled
     * @params:
     *    - node: the path of the node
     *    - text: the text the field starts with
     *    - from: the start of the part of the text selected, in bytes
     *    - to: the end of the part selected, past the text being its end
     * */
    pub fn editNode(mut self, node: [usize], text: [c8], from: usize = 0us, to: usize = usize::max) {
        if node.len == 0us { return; }

        self:.cancelEdit();
        self:.expandNode(node[0us .. node.len - 1us]);
        let row = if let Ok(r) = self._expansion.rowOf(node) { r } else { return; };
        self:.scrollToRow(row);

        let dmut field = if let Ok(dmut i) = alias self._input { alias i } else {
            let dmut i = copy TreeRowInput(alias self._manager, alias self, &self:.onEditValidated);
            if self._attached { i:.onAttach((self)?); }
            self._input = (alias i)?;
            alias i
        };

        self._editing = (node)?;
        field.cancelled = false;
        field:.restyle(deep-> true);
        field:.setText(text);
        self:.placeInput();
        self._manager:.setFocus((alias field)?);
        field:.selectText(from, to);
    }

    /**
     * Cancel the edit of a row, the text typed dropped, the tree taking the focus back
     * */
    pub fn cancelEdit(mut self) {
        if !self._editing.hasValue { return; }

        if let Ok(dmut i) = alias self._input { i.cancelled = true; }
        self._manager:.setFocus((alias self)?);
        self:.stopEditing();
    }

    /**
     * @returns: true iif the text of a row is edited
     * */
    pub fn isEditing(self)-> bool {
        self._editing.hasValue
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the user changes the selected nodes, with their paths in the order of the rows
     * */
    pub fn selected(mut self)-> dmut &Signal!{[[usize]]} {
        if let Ok(dmut s) = alias self._selected {
            return alias s;
        }

        let dmut s = copy Signal!{[[usize]]} ();
        self._selected = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted when Enter is pressed on the current node, or when a leaf is double clicked, with the
     * path of that node
     * */
    pub fn activated(mut self)-> dmut &Signal!{[usize]} {
        if let Ok(dmut s) = alias self._activated {
            return alias s;
        }

        let dmut s = copy Signal!{[usize]} ();
        self._activated = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted when the user drops the rows dragged, with the nodes dragged and the place they were
     * dropped at, the model deciding what to do of them
     * */
    pub fn dropped(mut self)-> dmut &Signal!{TreeDrop} {
        if let Ok(dmut s) = alias self._dropped {
            return alias s;
        }

        let dmut s = copy Signal!{TreeDrop} ();
        self._dropped = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted at each move of the cursor dragging rows out of the tree, and at the release or the
     * cancelling of the drag, with the nodes dragged, where the cursor is and whether it is out of the tree
     * */
    pub fn draggedOut(mut self)-> dmut &Signal!{TreeDrag} {
        if let Ok(dmut s) = alias self._draggedOut {
            return alias s;
        }

        let dmut s = copy Signal!{TreeDrag} ();
        self._draggedOut = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted with the path of the node right clicked, selected, [] for a click below the rows
     * */
    pub fn context(mut self)-> dmut &Signal!{[usize]} {
        if let Ok(dmut s) = alias self._context {
            return alias s;
        }

        let dmut s = copy Signal!{[usize]} ();
        self._context = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted with the node whose row was edited in place and the text typed, once validated
     * */
    pub fn edited(mut self)-> dmut &Signal!{TreeEdit} {
        if let Ok(dmut s) = alias self._edited {
            return alias s;
        }

        let dmut s = copy Signal!{TreeEdit} ();
        self._edited = (alias s)?;

        alias s
    }

    /**
     * @returns: the signal emitted with the keys pressed on the tree that it does not use (F2, Delete...), the
     * application giving them a meaning
     * */
    pub fn keyPressed(mut self)-> dmut &Signal!{SDL_Keycode, SDL_Keymod} {
        if let Ok(dmut s) = alias self._keyPressed {
            return alias s;
        }

        let dmut s = copy Signal!{SDL_Keycode, SDL_Keymod} ();
        self._keyPressed = (alias s)?;

        alias s
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          ROWS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        self._markerProbe:.setMarkerStyle(self._currentStyle.getSubStyle("marker"));
        self._markerWidth = self._markerProbe:.measureIntrinsicWidths()._1;
        self._indent = TreeView::indentOf(self._currentStyle, self._markerWidth);
        self._iconProbe:.setStyle(self._currentStyle.getSubStyle("icon"));
        self._iconWidth = self._iconProbe:.measureIntrinsicWidths()._1;
        self._dropLine:.setStyle(self._currentStyle.getSubStyle("drop"));
        self._dropThickness = self._dropLine:.measureIntrinsicHeights(self._absoluteSize.x)._1;
        self.__super__:.onUpdateSize();
    }

    over onUpdateScissors(mut self) {
        self.__super__:.onUpdateScissors();
        let (sciPos, sciSize) = self.getRowsScissors();
        self._dropLine:.setScissors(sciPos, sciSize);
        if let Ok(dmut i) = alias self._input { i:.setScissors(sciPos, sciSize); }
    }

    pub over getMaxDepth(self)-> u32 {
        let mut depth = self.__super__.getMaxDepth();
        if self._dragging { depth = max(depth, self._dropLine.getMaxDepth()); }
        if let Ok(i) = self._input && self._editing.hasValue { depth = max(depth, i.getMaxDepth()); }
        depth
    }

    prot over createRow(mut self)-> dmut &Widget {
        copy TreeRow(alias self._manager)
    }

    prot over fillRow(mut self, dmut row: &Widget, item: usize) {
        if let Ok(dmut r: &TreeRow) = (alias row)? {
            let path = self._expansion.pathOf(item);
            let (text, children, icon) = if let Ok(m) = self._model { (m.text(path), m.len(path), m.icon(path)) } else { ("", 0us, "") };
            r:.setNode(text, path.len - 1us, children != 0us, self._expansion.isExpanded(path), self._indent,
                       self._markerWidth, icon, self._iconWidth);
        }
    }

    /**
     * The row the rows dragged would be dropped on takes the state :drop, the row of a node the model marks the state
     * :marked; the marker takes the states of its row, and :expanded for a node expanded, the icon the states of its row
     * */
    prot over styleRow(mut self, dmut row: &Widget, item: usize) {
        let path = self._expansion.pathOf(item);
        let target = if let Ok(d) = self._drop && d.onto { d.parent == path } else { false };
        let mut marks: [[c8]] = [];
        if let Ok(m) = self._model && m.marked(path) { marks ~= ["marked"]; }

        row:.setStyle(self:.getPartStyle("row", item, extra-> if target { marks ~ copy ["drop"] } else { marks }));
        if let Ok(dmut r: &TreeRow) = (alias row)? {
            let expanded = self._expansion.isExpanded(path);
            r:.setMarkerStyle(self:.getPartStyle("marker", item, extra-> if expanded { marks ~ copy ["expanded"] } else { marks }));
            r:.setIconStyle(self:.getPartStyle("icon", item, extra-> marks));
        }
    }

    /**
     * The line of a drop between rows follows the rows as they scroll
     * */
    prot over onRowsPlaced(mut self) {
        self:.placeDropLine();
        self:.placeInput();
    }

    /**
     * @returns: the height of the margin box of a row, a single line of the style of the part ::row laid out in a width
     * */
    prot over measureRowHeight(mut self, width: f32)-> f32 {
        self._probe:.setStyle(self._currentStyle.getSubStyle("row"));
        self._probe:.measureIntrinsicHeights(width)._1
    }

    /**
     * A click on the marker of a node having children expands or collapses it
     * */
    prot over clickRow(mut self, row: usize, pos: vec2)-> bool {
        if !self.isOnMarker(row, pos) { return false; }

        let path = self._expansion.pathOf(row);
        self:.setExpanded(path, !self._expansion.isExpanded(path), user-> true);
        true
    }

    prot over emitSelected(mut self) {
        if let Ok(dmut s) = alias self._selected {
            s:.emit(self.getSelected());
        }
    }

    prot over emitActivated(mut self, row: usize) {
        if let Ok(dmut s) = alias self._activated {
            s:.emit(self._expansion.pathOf(row));
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          EVENTS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The left button on a row of a tree draggable keeps it to drag the rows selected; on a row among several selected,
     * without Ctrl nor Shift, it selects it alone once released only, so that they are dragged together
     * */
    pub over onClick(mut self, pos: vec2, button: u8)-> dmut (&Widget)? {
        if let Ok(dmut i) = alias self._input && self._editing.hasValue {
            let at = self._absoluteFullPosition + pos * self._absoluteFullSize;
            let from = i.getAbsolutePosition(), size = i.getAbsoluteSize();
            if at.x >= from.x && at.y >= from.y && at.x < from.x + size.x && at.y < from.y + size.y {
                return i:.onClick((at - from) / size, button);
            }
        }

        self._pressed = none;
        self._selectOnRelease = none;
        if button == SDL_BUTTON_RIGHT {
            self:.openContext(pos);
            return (alias self)?;
        }

        if button == SDL_BUTTON_LEFT && (self._draggable || self._dragOut) {
            if let Ok(row) = self.rowUnder(pos) {
                let pixels = self.toPixels(pos);
                if !self.isOnMarker(row, pixels) {
                    self._pressed = (row)?;
                    self._pressedAt = pixels;

                    let mods = SDL_GetModState();
                    let alone = (mods & (SDL_KMOD_CTRL | SDL_KMOD_SHIFT | SDL_KMOD_GUI)) == 0u16;
                    if alone && self._selection.isSelected(row) && self._selection.getSelected().len > 1us {
                        self._selectOnRelease = (row)?;
                        return (alias self)?;
                    }
                }
            }
        }

        self.__super__:.onClick(pos, button)
    }

    /**
     * The cursor pressing a row drags the rows selected once it went far enough, the place they would be dropped at
     * following it
     * */
    pub over onSliding(mut self, pos: vec2, speed: vec2, button: u8) {
        if button != SDL_BUTTON_LEFT || !self._pressed.hasValue {
            self.__super__:.onSliding(pos, speed, button);
            return;
        }

        self._cursor = self.toPixels(pos);
        if !self._dragging {
            if (self._cursor - self._pressedAt).length() < DRAG_DISTANCE { return; }
            if !self:.startDrag() { return; }
        }

        self:.updateDrop();
        self:.placeGhost();
        self:.emitDraggedOut(self._dragged, released-> false);
    }

    /**
     * The release of the left button drops the rows dragged, on-drop being emitted when they are over a place they can
     * go to and on-drag-out when they are dragged out of the tree, or selects alone the row it pressed among several
     * selected
     * */
    pub over onSlidingEnd(mut self, button: u8) {
        if button == SDL_BUTTON_LEFT {
            if self._dragging {
                let released = self._drop;
                let nodes = self._dragged;
                self:.endDrag(cancelled-> false);
                if let Ok(d) = released {
                    if let Ok(dmut s) = alias self._dropped {
                        s:.emit(TreeDrop(nodes-> d.nodes, parent-> d.parent, index-> d.index, onto-> d.onto, mods-> SDL_GetModState()));
                    }
                }

                self:.emitDraggedOut(nodes, released-> true);
            } else if let Ok(row) = self._selectOnRelease {
                let changed = self._selection:.click(row, 0u16);
                self:.showCurrent();
                if changed { self:.emitSelected(); }
            }

            self._pressed = none;
            self._selectOnRelease = none;
        }

        self.__super__:.onSlidingEnd(button);
    }

    /**
     * While rows are dragged, the rows scroll with the cursor at their top or their bottom edge, and the node collapsed
     * they would be dropped on expands once hovered a moment
     * */
    pub over onTick(mut self, delta: Duration) {
        if !self._dragging || !self._draggable { return; }

        let seconds = cast!f64(delta.allMicros) / 1_000_000.0;
        let speed = edgeScroll(self._cursor.y - self._headerHeight, self._rowsHeight, self._rowHeight);
        if speed != 0.0 && self:.scrollBy(speed * seconds) {
            self:.updateDrop();
        }

        if let Ok(d) = self._drop && d.onto {
            if self._expansion.isExpanded(d.parent) || self.countChildren(d.parent) == 0us { return; }

            self._hoverTime += seconds;
            if self._hoverTime >= EXPAND_DELAY {
                self:.setExpanded(d.parent, true, user-> false);
                self:.updateDrop();
            }
        }
    }

    /**
     * A drag ends with the focus, the rows dragged going nowhere
     * */
    pub over onLoseFocus(mut self) {
        self:.endDrag(cancelled-> true);
        self.__super__:.onLoseFocus();
    }

    /**
     * A double click on a node having children expands or collapses it, a leaf being activated
     * */
    pub over onDoubleClick(mut self, pos: vec2)-> dmut (&Widget)? {
        if let Ok(row) = self.rowUnder(pos) {
            let path = self._expansion.pathOf(row);
            if self.countChildren(path) != 0us {
                self:.setExpanded(path, !self._expansion.isExpanded(path), user-> true);
                return (alias self)?;
            }
        }

        self.__super__:.onDoubleClick(pos)
    }

    /**
     * Right expands the current node, or moves to its first child, and Left collapses it, or moves to its parent; the
     * other keys select as in a list view, those it does not use being emitted by keyPressed
     * */
    pub over onKeyPressed(mut self, key: SDL_Keycode, mods: SDL_Keymod)-> bool {
        if self._dragging {
            // Escape cancels the drag, the other keys wait for its end
            if key == SDLK_ESCAPE { self:.endDrag(cancelled-> true); }
            return true;
        }

        if key != SDLK_LEFT && key != SDLK_RIGHT {
            let used = self.__super__:.onKeyPressed(key, mods);
            if !used {
                if let Ok(dmut s) = alias self._keyPressed { s:.emit(key, mods); }
            }

            return used;
        }
        if (mods & (SDL_KMOD_CTRL | SDL_KMOD_ALT | SDL_KMOD_GUI | SDL_KMOD_SHIFT)) != 0u16 { return false; }

        let current = if let Ok(c) = self._selection.getCurrent() { c } else { return false; };
        let path = self._expansion.pathOf(current);
        let expanded = self._expansion.isExpanded(path);
        if key == SDLK_RIGHT {
            if expanded {
                self:.moveTo(current + 1us);
            } else {
                self:.setExpanded(path, true, user-> true);
            }
        } else if expanded {
            self:.setExpanded(path, false, user-> true);
        } else if path.len > 1us {
            if let Ok(parent) = self._expansion.rowOf(path[0us .. path.len - 1us]) {
                self:.moveTo(parent);
            }
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self._dropLine:.onAttach((self)?);
        self._ghost:.onAttach((self)?);
        if let Ok(dmut i) = alias self._input { i:.onAttach((self)?); }
    }

    over onHide(mut self) {
        self.__super__:.onHide();
        self._dropLine:.hide();
        self._ghost:.hide();
        if let Ok(dmut i) = alias self._input { i:.hide(); }
    }

    impl Disposable {
        pub over dispose(mut self) {
            if let Ok(dmut m) = alias self._model {
                m:.unwatch(&self:.refresh);
            }

            self._probe:.dispose();
            self._markerProbe:.dispose();
            self._iconProbe:.dispose();
            self._dropLine:.dispose();
            self._ghost:.dispose();
            if let Ok(dmut i) = alias self._input { i:.dispose(); }
            self.__super__:.dispose();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Expand or collapse a node, the rows under it being inserted in the selection or removed from it
     * @params:
     *    - node: the path of the node
     *    - expanded: true to expand it, false to collapse it
     *    - user: true iif the user expands or collapses it, on-select being emitted when collapsing it unselects rows
     * */
    fn setExpanded(mut self, node: [usize], expanded: bool, user: bool) {
        if expanded {
            if let Ok(rows) = self._expansion:.expandNode(node, self.countChildren(node)) {
                self._selection:.insertRows(rows._0, rows._1);
                self:.reloadRows();
            }
        } else if let Ok(rows) = self._expansion:.collapseNode(node) {
            let changed = self._selection:.removeRows(rows._0, rows._1);
            self:.reloadRows();
            if changed && user { self:.emitSelected(); }
        }
    }

    /**
     * Select a row alone, the row becoming the current row, scrolled to
     * */
    fn moveTo(mut self, row: usize) {
        let changed = self._selection:.selectAlone(row);
        self:.showCurrent();
        if changed { self:.emitSelected(); }
    }

    /**
     * @returns: the number of children of a node of the model, 0 without a model
     * */
    fn countChildren(self, node: [usize])-> usize {
        if let Ok(m) = self._model { m.len(node) } else { 0us }
    }

    /**
     * @returns: true iif a position is over the marker of a row whose node has children
     * @params:
     *    - pos: the position, in pixels from the top left corner of the inner box
     * */
    fn isOnMarker(self, row: usize, pos: vec2)-> bool {
        let path = self._expansion.pathOf(row);
        let start = TreeView::markerOffset(path.len - 1us, self._indent);
        pos.x >= start && pos.x < start + self._markerWidth && self.countChildren(path) != 0us
    }

    /**
     * Start dragging the rows selected, the row pressed among them
     * @returns: true iif the rows are dragged, false when the row pressed is not selected
     * */
    fn startDrag(mut self)-> bool {
        let pressed = if let Ok(p) = self._pressed { p } else { return false; };
        if !self._selection.isSelected(pressed) {
            self._pressed = none;
            return false;
        }

        self._dragged = draggedOf(self.getSelected());
        self._dragging = true;
        self._selectOnRelease = none;
        self._hoverTime = 0.0;
        true
    }

    /**
     * Stop dragging, the rows dragged going nowhere, the line and the state :drop leaving the rows
     * @params:
     *    - cancelled: true iif the drag is cancelled, on-drag-out telling it, false for a release
     * */
    fn endDrag(mut self, cancelled: bool) {
        let was = self._dragging;
        if was && cancelled {
            self:.emitDraggedOut(self._dragged, released-> true, cancelled-> true);
        }

        if was { self:.hideGhost(); }

        self._dragging = false;
        self._dragged = [];
        self._drop = none;
        self._pressed = none;
        self._dropLine:.hide();
        if was { self:.restyleRows(); }
    }

    /**
     * Find where the rows dragged would be dropped, under the cursor, restyling the rows and placing the line between
     * them as it changes
     * */
    fn updateDrop(mut self) {
        let before = self._drop;
        let count = self.getRowCount();
        let y = self._cursor.y - self._headerHeight;

        let mut found: (TreeDrop)? = none;
        if self._draggable && self._cursor.x >= 0.0f && self._cursor.x < self._rowsWidth && y >= 0.0f && y < self._rowsHeight && self._rowHeight > 0.0f {
            let height = cast!f64(self._rowHeight);
            let at = cast!f64(y) + self._offset;
            let item = cast!usize(cast!u64(at / height));

            let mut place = dropBelowRows(self.countChildren([]));
            self._dropEdge = count;
            if item < count {
                let path = self._expansion.pathOf(item);
                let part = cast!f32((at - cast!f64(cast!u64(item)) * height) / height);
                place = dropOnRow(path, part, self.countChildren(path), self._expansion.isExpanded(path));
                self._dropEdge = if part < DROP_EDGE { item } else { item + 1us };
            }

            let full = TreeDrop(nodes-> self._dragged, parent-> place.parent, index-> place.index, onto-> place.onto);
            if !isUnderDragged(full) { found = (full)?; }
        }

        self._drop = found;
        let samePlace = if let Ok(b) = before {
            if let Ok(d) = found { b.parent == d.parent && b.index == d.index && b.onto == d.onto } else { false }
        } else {
            !found.hasValue
        };

        if !samePlace {
            self._hoverTime = 0.0;
            self:.restyleRows();
            self:.placeDropLine();
        }
    }

    /**
     * Show the line of a drop between rows on the edge between them, indented at the level the rows dragged go to,
     * hidden for a drop on a row or for no drop
     * */
    fn placeDropLine(mut self) {
        let level = if let Ok(d) = self._drop && !d.onto { d.parent.len } else {
            self._dropLine:.hide();
            return;
        };

        let indent = cast!f32(cast!u64(level)) * self._indent;
        let top = cast!f64(cast!u64(self._dropEdge)) * cast!f64(self._rowHeight) - self._offset;
        let pos = self._absolutePosition + makeVec2(indent - self._offsetX,
                                                    self._headerHeight + cast!f32(top) - self._dropThickness / 2.0f);
        let width = max(0.0f, max(self._rowsWidth, self.getContentWidth()) - indent);

        let mut depth = self._depth + 1;
        for r in self._rows { depth = max(depth, r.getMaxDepth()); }

        self._dropLine:.setSize(pos, makeVec2(width, self._dropThickness), depth + 1, self._absoluteSize);
        let (sciPos, sciSize) = self.getRowsScissors();
        self._dropLine:.setScissors(sciPos, sciSize);
        if self.isDrawn() { self._dropLine:.show(); }
    }

    /**
     * Emit on-drag-out, for a tree whose rows go out of it, with where the cursor is
     * @params:
     *    - nodes: the nodes dragged
     *    - released: true iif the drag ends
     *    - cancelled: true iif it is cancelled, the cursor told in the tree
     * */
    fn emitDraggedOut(mut self, nodes: [[usize]], released: bool, cancelled: bool = false) {
        if !self._dragOut { return; }

        let at = self._manager.getMousePosition();
        let from = self._absolutePosition, size = self._absoluteSize;
        let inside = at.x >= from.x && at.y >= from.y && at.x < from.x + size.x && at.y < from.y + size.y;
        if let Ok(dmut s) = alias self._draggedOut {
            s:.emit(TreeDrag(nodes-> nodes, at-> at, outside-> !inside && !cancelled, released-> released,
                             mods-> SDL_GetModState()));
        }
    }

    /**
     * Show the icon of the first node dragged out of the tree under the cursor, over the other widgets, the cursor a
     * hand
     * */
    fn placeGhost(mut self) {
        if !self._dragOut || self._dragged.len == 0us { return; }

        let image = if let Ok(m) = self._model { m.icon(self._dragged[0us]) } else { "" };
        if image != self._ghostImage || !self._ghost.isDrawn() {
            self._ghostImage = image;
            let dmut style = copy Style();
            style:.merge(self._currentStyle.getSubStyle("ghost"));
            if image != "" { style.backgroundImage = (true, image); }
            self._ghost:.setStyle(style);
        }

        let width = self._ghost:.measureIntrinsicWidths()._1;
        let height = self._ghost:.measureIntrinsicHeights(width)._1;
        let layout = self._manager.getLayoutSize();
        let at = self._manager.getMousePosition() + makeVec2(GHOST_OFFSET, GHOST_OFFSET);
        let depth = if let Ok(dmut c) = alias self._manager:.getContent() { c.getMaxDepth() + 1 } else { self._depth + 1 };

        self._ghost:.setSize(at, makeVec2(width, height), depth, layout);
        self._ghost:.setScissors(vec2(), layout);
        self._ghost:.show();
        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_POINTER);
    }

    /**
     * Hide the icon of the rows dragged out of the tree, the cursor an arrow again
     * */
    fn hideGhost(mut self) {
        if !self._dragOut { return; }

        self._ghost:.hide();
        self._manager:.getCursorManager():.setCursor(SDL_SystemCursor::SDL_SYSTEM_CURSOR_DEFAULT);
    }

    /**
     * A right click on a row selects it alone unless it is selected, then emits on-context with its path, [] below the
     * rows
     * */
    fn openContext(mut self, pos: vec2) {
        let mut node: [usize] = [];
        if let Ok(row) = self.rowUnder(pos) {
            if !self._selection.isSelected(row) {
                let changed = self._selection:.selectAlone(row);
                self:.showCurrent();
                if changed { self:.emitSelected(); }
            }

            node = self._expansion.pathOf(row);
        }

        if let Ok(dmut s) = alias self._context {
            s:.emit(node);
        }
    }

    /**
     * The field of the row edited lost the focus: on-edit gives the text typed, unless Escape cancelled it
     * */
    fn onEditValidated(mut self, text: [c8]) {
        let node = if let Ok(n) = self._editing { n } else { return; };
        let cancelled = if let Ok(i) = self._input { i.cancelled } else { true };
        self:.stopEditing();
        if cancelled { return; }

        if let Ok(dmut s) = alias self._edited {
            s:.emit(TreeEdit(node-> node, text-> text));
        }
    }

    /**
     * Stop editing a row, its field hidden
     * */
    fn stopEditing(mut self) {
        self._editing = none;
        if let Ok(dmut i) = alias self._input { i:.hide(); }
    }

    /**
     * Place the field of the row edited over the text of the row, as wide as the rows from there, following the rows as
     * they scroll; an edit whose node is no longer shown is cancelled
     * */
    fn placeInput(mut self) {
        let node = if let Ok(n) = self._editing { n } else { return; };
        let row = if let Ok(r) = self._expansion.rowOf(node) { r } else {
            self:.cancelEdit();
            return;
        };

        let start = TreeView::textOffset(node.len - 1us, self._indent, self._markerWidth, self._iconWidth) - self._offsetX;
        let top = cast!f64(cast!u64(row)) * cast!f64(self._rowHeight) - self._offset;
        let pos = self._absolutePosition + makeVec2(start, self._headerHeight + cast!f32(top));
        let width = max(EDIT_MIN_WIDTH, self._rowsWidth - start);

        let mut depth = self._depth + 1;
        for r in self._rows { depth = max(depth, r.getMaxDepth()); }

        if let Ok(dmut i) = alias self._input {
            i:.setSize(pos, makeVec2(width, self._rowHeight), depth + 1, self._absoluteSize);
            let (sciPos, sciSize) = self.getRowsScissors();
            i:.setScissors(sciPos, sciSize);
            if self.isDrawn() { i:.show(); } else { i:.hide(); }
        }
    }
}

/**
 * The tree views in a .gui file, their nodes being given by the code
 * */
pub mod TreeView {

    /**
     * @returns: the schema of the tree views
     * */
    #[widgetSchema]
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("TreeView",
                          |dmut m, id|-> dmut &Widget => copy TreeView(alias m, id),
                          attributes-> copy [copy Setter!{&TreeView, bool}("multiple", |dmut t, m| => { t:.setMultiple(m); }),
                                             copy Setter!{&TreeView, bool}("draggable", |dmut t, d| => { t:.setDraggable(d); }),
                                             copy Setter!{&TreeView, bool}("drag-out", |dmut t, d| => { t:.setDragOut(d); })],
                          signals-> copy [copy Emitter!{&TreeView, [[usize]]}("on-select", |dmut t|-> dmut &Signal!{[[usize]]} => alias t:.selected()),
                                          copy Emitter!{&TreeView, [usize]}("on-activate", |dmut t|-> dmut &Signal!{[usize]} => alias t:.activated()),
                                          copy Emitter!{&TreeView, TreeDrop}("on-drop", |dmut t|-> dmut &Signal!{TreeDrop} => alias t:.dropped()),
                                          copy Emitter!{&TreeView, TreeDrag}("on-drag-out", |dmut t|-> dmut &Signal!{TreeDrag} => alias t:.draggedOut()),
                                          copy Emitter!{&TreeView, [usize]}("on-context", |dmut t|-> dmut &Signal!{[usize]} => alias t:.context()),
                                          copy Emitter!{&TreeView, TreeEdit}("on-edit", |dmut t|-> dmut &Signal!{TreeEdit} => alias t:.edited())],
                          parts-> copy ["row", "marker", "icon", "drop", "ghost", "scrollbar"],
                          partStates-> copy ["row" => copy ["hover", "selected", "current", "drop", "marked"],
                                             "marker" => copy ["hover", "selected", "current", "expanded", "marked"],
                                             "icon" => copy ["hover", "selected", "current", "marked"],
                                             "scrollbar" => copy ["hover", "pressed"]],
                          properties-> copy [TreeView::indent()])
    }

    /**
     * @returns: the property of the width of a level of a tree view, the rows of a node being indented by it from the
     * rows of its parent
     * */
    pub fn indent()-> &WidgetProperty!{u32} {
        copy WidgetProperty!{u32}("indent", Kind::PIXELS, &?kinds::pixels, affectsLayout-> true)
    }

    /**
     * @returns: the width of a level of a tree view, its property indent, the width of its markers when it has none
     * @params:
     *    - style: the style of the tree view
     *    - markerWidth: the width of the margin box of its markers, in pixels
     * */
    pub fn indentOf(style: &Style, markerWidth: f32)-> f32 {
        if let Ok(i) = style.getCustom!{u32}("indent") {
            return cast!f32(i);
        }

        markerWidth
    }

    /**
     * @returns: the distance from the start of a row to its marker, in pixels
     * @params:
     *    - level: the level of the node of the row, 0 for the children of the root
     *    - indent: the width of a level, in pixels
     * */
    pub fn markerOffset(level: usize, indent: f32)-> f32 {
        cast!f32(cast!u64(level)) * indent
    }

    /**
     * @returns: the distance from the start of a row to its text, after its marker and its icon, in pixels
     * @params:
     *    - level: the level of the node of the row, 0 for the children of the root
     *    - indent: the width of a level, in pixels
     *    - markerWidth: the width of the margin box of the markers, in pixels
     *    - iconWidth: the width of the margin box of the icons, in pixels, 0 for none
     * */
    pub fn textOffset(level: usize, indent: f32, markerWidth: f32, iconWidth: f32)-> f32 {
        TreeView::markerOffset(level, indent) + markerWidth + iconWidth
    }
}
