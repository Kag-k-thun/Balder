in file_node;

/**
 * A file or a directory of a FileTreeModel: its name, its path, its size, and the entries of a directory
 * */
@final
pub class FileNode {

    // The name of the entry in its directory
    pub let name: [c8];

    // The absolute path of the entry
    pub let path: [c8];

    // True iif the entry is a directory, or a link to one
    pub let isDirectory: bool;

    // The size of a file in bytes, 0 for a directory
    pub let size: u64;

    // The entries of a directory, the directories first then the files, each by name; none for a file
    pub let children: [&FileNode];

    /**
     * @params:
     *    - name: the name of the entry in its directory
     *    - path: the absolute path of the entry
     *    - isDirectory: true for a directory
     *    - size: the size of a file in bytes
     *    - children: the entries of a directory, in order
     * */
    pub self (name: [c8], path: [c8], isDirectory: bool = false, size: u64 = 0u64, children: [&FileNode] = [])
        with name = name
        , path = path
        , isDirectory = isDirectory
        , size = size
        , children = children
    {}
}
