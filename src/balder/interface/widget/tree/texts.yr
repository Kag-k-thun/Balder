in texts;

use balder::interface::widget::tree::{item, model};

/**
 * A tree model holding its nodes, each a text and its children
 * */
@final
pub class TextTreeModel over TreeModel {

    // The children of the root, the first level of the tree
    let mut _items: [&TreeItem];

    /**
     * @params:
     *    - items: the children of the root, the first level of the tree
     * */
    pub self (items: [&TreeItem] = [])
        with _items = items
    {}

    pub over len(self, node: [usize])-> usize {
        if node.len == 0us { return self._items.len; }
        if let Ok(i) = self.find(node) { i.children.len } else { 0us }
    }

    pub over text(self, node: [usize])-> [c8] {
        if let Ok(i) = self.find(node) { i.text } else { "" }
    }

    /**
     * Replace the nodes, the views showing the model reading it again
     * @params:
     *    - items: the children of the root, the first level of the tree
     * */
    pub fn setItems(mut self, items: [&TreeItem]) {
        self._items = items;
        self.changed();
    }

    /**
     * @returns: the children of the root, the first level of the tree
     * */
    pub fn getItems(self)-> [&TreeItem] {
        self._items
    }

    /**
     * @returns: the node of a path, none when the path names no node
     * */
    fn find(self, node: [usize])-> (&TreeItem)? {
        let mut children = self._items;
        let mut found: (&TreeItem)? = none;
        for i in node {
            if i >= children.len { return none; }
            found = (children[i])?;
            children = children[i].children;
        }

        found
    }
}
