/**
 * The order of the rows of a table sorted by a column: texts compared as people read them, numbers by their value, and
 * rows sorted stably, the rows equal keeping their order
 * */
in order;

/**
 * @returns: a negative number when a text comes before another, a positive one when it comes after, 0 when they are
 * equal: letters compared regardless of their case, and runs of digits by the number they write, "Row 9" coming before
 * "Row 10"
 * */
pub fn compareTexts(a: [c8], b: [c8])-> i32 {
    let mut i = 0us;
    let mut j = 0us;
    while i < a.len && j < b.len {
        if isDigit(a[i]) && isDigit(b[j]) {
            let si = i;
            let sj = j;
            while i < a.len && isDigit(a[i]) { i += 1us; }
            while j < b.len && isDigit(b[j]) { j += 1us; }

            let c = compareNumbers(a[si .. i], b[sj .. j]);
            if c != 0 { return c; }
        } else {
            let x = lower(a[i]);
            let y = lower(b[j]);
            if x != y { return if x < y { -1 } else { 1 }; }

            i += 1us;
            j += 1us;
        }
    }

    if i < a.len { 1 } else if j < b.len { -1 } else { 0 }
}

/**
 * @returns: the rows of a table in the order of a comparison, the rows it finds equal keeping their order
 * @params:
 *    - count: the number of rows
 *    - compare: a negative number when a row comes before another, a positive one when it comes after, 0 when they are
 *               equal
 *    - descending: true to sort the rows from the last to the first, the rows equal still keeping their order
 * */
pub fn sortRows(count: usize, compare: dg (usize, usize)-> i32, descending: bool = false)-> [usize] {
    let dmut rows = copy [0us; count];
    for i in 0us .. count { rows[i] = i; }

    // a merge sort, from runs of one row up, stable
    let dmut buffer = copy [0us; count];
    let mut width = 1us;
    while width < count {
        let mut start = 0us;
        while start < count {
            let middle = if start + width < count { start + width } else { count };
            let end = if start + 2us * width < count { start + 2us * width } else { count };
            let mut i = start;
            let mut j = middle;
            for k in start .. end {
                let takeLeft = if i >= middle { false } else if j >= end { true } else {
                    let c = compare(rows[j], rows[i]);
                    if descending { c <= 0 } else { c >= 0 }
                };

                if takeLeft {
                    buffer[k] = rows[i];
                    i += 1us;
                } else {
                    buffer[k] = rows[j];
                    j += 1us;
                }
            }

            start = end;
        }

        for k in 0us .. count { rows[k] = buffer[k]; }
        width *= 2us;
    }

    rows
}

/**
 * @returns: the place of each row in an order, the inverse of the order
 * @params:
 *    - order: the rows in an order, each row once
 * */
pub fn invertOrder(order: [usize])-> [usize] {
    let dmut places = copy [0us; order.len];
    for place, row in order {
        places[row] = place;
    }

    places
}

/**
 * @returns: true iif a character is a digit
 * */
fn isDigit(c: c8)-> bool {
    c >= '0'c8 && c <= '9'c8
}

/**
 * @returns: an ascii letter in lower case, any other character as it is
 * */
fn lower(c: c8)-> c8 {
    if c >= 'A'c8 && c <= 'Z'c8 { cast!c8(cast!u8(c) + 32u8) } else { c }
}

/**
 * @returns: the comparison of the numbers two runs of digits write, their leading zeros left out
 * */
fn compareNumbers(a: [c8], b: [c8])-> i32 {
    let x = withoutZeros(a);
    let y = withoutZeros(b);
    if x.len != y.len { return if x.len < y.len { -1 } else { 1 }; }

    for k in 0us .. x.len {
        if x[k] != y[k] { return if x[k] < y[k] { -1 } else { 1 }; }
    }

    0
}

/**
 * @returns: a run of digits without its leading zeros
 * */
fn withoutZeros(digits: [c8])-> [c8] {
    let mut i = 0us;
    while i < digits.len && digits[i] == '0'c8 { i += 1us; }
    digits[i .. digits.len]
}
