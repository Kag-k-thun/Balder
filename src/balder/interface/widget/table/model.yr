in model;

use balder::interface::widget::list::view_model;
use balder::interface::widget::table::order;

/**
 * The rows and the columns a table view shows, read on demand: the view asks the number of rows and of columns, the
 * headers of the columns, and the text of the cells of the rows it shows only
 * @info:
 * =====
 * A model of the application derives from it to give rows it computes or holds elsewhere, a million rows costing no more
 * than the dozen shown. Sorting the rows by a column reads that column of every row through `compare`, which compares
 * their texts as people read them (compareTexts), and which a model overrides to compare the values it holds. A model
 * whose rows or columns change calls `changed`, every view showing it reading it again.
 * ====
 * */
@abstract
pub class TableModel over ViewModel {

    prot self ()
        with super()
    {}

    /**
     * @returns: the number of rows
     * */
    pub fn len(self)-> usize;

    /**
     * @returns: the number of columns
     * */
    pub fn columns(self)-> usize;

    /**
     * @returns: the header of a column
     * @params:
     *    - column: the column, below the number of columns
     * */
    pub fn header(self, column: usize)-> [c8];

    /**
     * @returns: the text of a cell
     * @params:
     *    - row: the row, below the number of rows
     *    - column: the column, below the number of columns
     * */
    pub fn text(self, row: usize, column: usize)-> [c8];

    /**
     * @returns: a negative number when a row comes before another sorted by a column, a positive one when it comes after,
     * 0 when they are equal; their texts compared as people read them unless the model knows better
     * @params:
     *    - a, b: the rows, below the number of rows
     *    - column: the column, below the number of columns
     * */
    pub fn compare(self, a: usize, b: usize, column: usize)-> i32 {
        compareTexts(self.text(a, column), self.text(b, column))
    }
}
