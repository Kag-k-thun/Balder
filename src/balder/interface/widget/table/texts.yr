in texts;

use balder::interface::widget::table::model;

/**
 * A table model holding the headers of its columns and the texts of its cells
 * */
@final
pub class TextTableModel over TableModel {

    // The header of each column, in order
    let mut _headers: [[c8]];

    // The texts of the cells of each row, in order, a row shorter than the headers having empty cells
    let mut _rows: [[[c8]]];

    /**
     * @params:
     *    - headers: the header of each column, in order
     *    - rows: the texts of the cells of each row, in order
     * */
    pub self (headers: [[c8]] = [], rows: [[[c8]]] = [])
        with _headers = headers
        , _rows = rows
    {}

    pub over len(self)-> usize {
        self._rows.len
    }

    pub over columns(self)-> usize {
        self._headers.len
    }

    pub over header(self, column: usize)-> [c8] {
        self._headers[column]
    }

    pub over text(self, row: usize, column: usize)-> [c8] {
        let cells = self._rows[row];
        if column < cells.len { cells[column] } else { "" }
    }

    /**
     * Replace the rows, the views showing the model reading it again
     * @params:
     *    - rows: the texts of the cells of each row, in order
     * */
    pub fn setRows(mut self, rows: [[[c8]]]) {
        self._rows = rows;
        self.changed();
    }

    /**
     * Replace the headers of the columns, the views showing the model reading it again
     * @params:
     *    - headers: the header of each column, in order
     * */
    pub fn setHeaders(mut self, headers: [[c8]]) {
        self._headers = headers;
        self.changed();
    }

    /**
     * @returns: the texts of the cells of each row, in order
     * */
    pub fn getRows(self)-> [[[c8]]] {
        self._rows
    }

    /**
     * @returns: the header of each column, in order
     * */
    pub fn getHeaders(self)-> [[c8]] {
        self._headers
    }
}
