in columns;

use ::std::algorithm::comparison;

/**
 * The widths of the columns of a table, laid out from the left of the first one
 * @info:
 * =====
 * Until their widths are set, by the user resizing a column or by the code, the columns share the width of the table
 * equally. Once set, the widths are kept whatever the width of the table, a column added taking the width of the last
 * one. A column is never narrower than the minimum width.
 * ====
 * */
pub class TableColumns {

    // The width of each column, in pixels
    let dmut _widths: [f32] = [];

    // True iif the widths were set, the columns sharing the width of the table otherwise
    let mut _set: bool = false;

    // The width a column is never narrower than, in pixels
    let _minWidth: f32;

    /**
     * @params:
     *    - minWidth: the width a column is never narrower than, in pixels
     * */
    pub self (minWidth: f32 = 24.0f)
        with _minWidth = minWidth
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of columns
     * */
    pub fn len(self)-> usize {
        self._widths.len
    }

    /**
     * @returns: the width of each column, in pixels
     * */
    pub fn getWidths(self)-> [f32] {
        self._widths
    }

    /**
     * @returns: true iif the widths were set, the columns sharing the width of the table otherwise
     * */
    pub fn isSet(self)-> bool {
        self._set
    }

    /**
     * @returns: the width of the columns together, in pixels
     * */
    pub fn getTotal(self)-> f32 {
        self.startOf(self._widths.len)
    }

    /**
     * @returns: the left of a column, from the left of the first one, the right of the last one past them
     * */
    pub fn startOf(self, column: usize)-> f32 {
        let mut x = 0.0f;
        for i in 0us .. min(column, self._widths.len) {
            x += self._widths[i];
        }

        x
    }

    /**
     * @returns: the column under a position, none past the last one
     * @params:
     *    - x: the position, from the left of the first column, in pixels
     * */
    pub fn columnAt(self, x: f32)-> (usize)? {
        if x < 0.0f { return none; }

        let mut end = 0.0f;
        for i, w in self._widths {
            end += w;
            if x < end { return (i)?; }
        }

        none
    }

    /**
     * @returns: the column whose right edge is the nearest to a position, none when none is as near as the grip
     * @params:
     *    - x: the position, from the left of the first column, in pixels
     *    - grip: the distance from an edge it is grabbed at, in pixels
     * */
    pub fn edgeAt(self, x: f32, grip: f32)-> (usize)? {
        let mut end = 0.0f;
        let mut nearest: (usize)? = none;
        let mut distance = grip;
        for i, w in self._widths {
            end += w;
            let d = if x > end { x - end } else { end - x };
            if d <= distance {
                nearest = (i)?;
                distance = d;
            }
        }

        nearest
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Lay the columns out in a table: their number, the width of the table being shared equally until the widths are set
     * @params:
     *    - count: the number of columns
     *    - width: the width the columns share, in pixels
     * */
    pub fn layout(mut self, count: usize, width: f32) {
        if !self._set {
            let share = if count == 0us { 0.0f } else { max(self._minWidth, width / cast!f32(cast!u64(count))) };
            self._widths = copy [share; count];
            return;
        }

        if count <= self._widths.len {
            self._widths = alias self._widths[0us .. count];
        } else {
            let added = if self._widths.len == 0us { self._minWidth } else { self._widths[self._widths.len - 1us] };
            while self._widths.len < count {
                self._widths ~= [added];
            }
        }
    }

    /**
     * Set the width of a column, the widths of the columns being kept from then on
     * @params:
     *    - column: the column, those past the columns being left out
     *    - width: its width, in pixels, the minimum width at least
     * */
    pub fn setWidth(mut self, column: usize, width: f32) {
        if column >= self._widths.len { return; }

        self._widths[column] = max(self._minWidth, width);
        self._set = true;
    }

    /**
     * Set the width of every column, kept from then on
     * @params:
     *    - widths: the width of each column, in pixels, the minimum width at least
     * */
    pub fn setWidths(mut self, widths: [f32]) {
        self._widths = copy [0.0f; widths.len];
        for i, w in widths {
            self._widths[i] = max(self._minWidth, w);
        }

        self._set = true;
    }

    /**
     * Let the columns share the width of the table again
     * */
    pub fn reset(mut self) {
        self._set = false;
    }
}
