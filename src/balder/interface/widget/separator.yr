in separator;

use balder::interface::loader::registry::schema;
use balder::interface::widget::{alignement, layout};

// The thickness of the content of a separator, in pixels
def THICKNESS = 1.0f;

/**
 * A separator is a rule between two groups of widgets, a line of the background of its style
 * @info: the style property direction lays the rule along a row (the default, a horizontal rule) or a column (a
 * vertical rule): its content is a pixel thick across it and empty along it, so that an auto size stretches it
 * along the layout it is in
 * */
pub class Separator over Widget {

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "Separator")
    {}

    /**
     * @returns: true iif the rule lies along a row, set by the style direction, false along a column
     * */
    pub fn isRow(self)-> bool {
        if let Ok(d) = self.getStyle().getCustom!{Direction}("direction") {
            return d == Direction::ROW;
        }

        true
    }

    /**
     * The content of a separator is a pixel thick across its direction, and empty along it
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        if self.isRow() { (0.0f, 0.0f) } else { (THICKNESS, THICKNESS) }
    }

    prot over measureContentHeights(mut self, _: f32)-> (f32, f32) {
        if self.isRow() { (THICKNESS, THICKNESS) } else { (0.0f, 0.0f) }
    }
}

/**
 * The separators in a .gui file
 * */
pub mod Separator {

    /**
     * @returns: the schema of the separators, taking no attribute
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("Separator",
                          |dmut m, id|-> dmut &Widget => copy Separator(alias m, id),
                          properties-> copy [Layout::direction()])
    }
}
