in image;

use balder::utils;
use balder::core::dispose;
use balder::core::application::refcount;
use balder::core::shader::texture;
use balder::interface::style;
use balder::interface::loader::registry::schema;
use balder::math::vector;

/**
 * An image is a widget showing a picture loaded from a file, as large as the picture when it is sized to its content
 * @info:
 * =====
 * The picture is the background image of the widget, set over its style as its inline style, so that the style
 * properties image-fill, image-keep-ratio and image-color apply to it. Its content is the picture, its max-content width
 * the width of the picture, its min-content width 0, and its height the height of the picture scaled to the width it is
 * laid out in, keeping its ratio.
 * ====
 * */
pub class Image over Widget {

    // The file of the picture, "" for none
    let mut _source: [c8] = "";

    // The picture, kept loaded while the widget is attached so that its size is known before it is drawn
    let dmut _texture: &RefCount!{&Texture};

    // The size of the picture, in pixels
    let mut _imageSize: vec2 = vec2();

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "Image")
        , _texture = manager:.getWindow():.emptyResource!{&Texture2D} ()
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SOURCE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Show the picture of a file
     * @params:
     *    - path: the path of the file, project paths (res:/) accepted, "" to show none
     * */
    pub fn setSource(mut self, path: [c8]) {
        self._source = path;

        let dmut withPicture = copy Style();
        withPicture:.merge(self.getInlineStyle());
        withPicture.backgroundImage = (true, path);
        self:.setInlineStyle(withPicture);

        if self._attached {
            self:.loadPicture();
            self:.relayout();
        }
    }

    /**
     * @returns: the file of the picture, "" for none
     * */
    pub fn getSource(self)-> [c8] {
        self._source
    }

    /**
     * @returns: the size of the picture in pixels, (0, 0) when none is loaded
     * */
    pub fn getImageSize(self)-> vec2 {
        self._imageSize
    }

    /**
     * Load the picture of the source, to know its size
     * */
    fn loadPicture(mut self) {
        self._texture:.dispose();
        self._imageSize = vec2();
        if self._source == "" { return; }

        {
            self._texture = self._manager:.getWindow():.loadResource!{&Texture2D} (self._source);
            if !self._texture.isEmpty() {
                self._imageSize = makeVec2(cast!f32(self._texture.get().width), cast!f32(self._texture.get().height));
            }
        } catch {
            err => {
                log::error #("Image", "Failed to load the picture ", self._source, " : ", err);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The content of an image is its picture, shrinking to nothing
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        (0.0f, self._imageSize.x)
    }

    /**
     * The height of the picture scaled to the width, keeping its ratio
     * */
    prot over measureContentHeights(mut self, width: f32)-> (f32, f32) {
        if self._imageSize.x <= 0.0f { return (0.0f, 0.0f); }

        let height = self._imageSize.y * width / self._imageSize.x;
        (height, height)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self:.loadPicture();
        self.__super__:.onAttach(parent);
    }

    impl Disposable {
        pub over dispose(mut self) {
            self._texture:.dispose();
            self.__super__:.dispose();
        }
    }
}

/**
 * The images in a .gui file
 * */
pub mod Image {

    /**
     * @returns: the schema of the images, their file being their default attribute
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("Image",
                          |dmut m, id|-> dmut &Widget => copy Image(alias m, id),
                          attributes-> copy [copy Setter!{&Image, [c8]}("src", |dmut i, p| => { i:.setSource(p); })],
                          defaultAttribute-> "src")
    }
}
