in radio;

use balder::interface::loader::registry::schema;
use balder::interface::widget::layout;
use balder::interface::widget::button::toggle;

/**
 * A radio button is a toggle button a click checks, and only checks: the radio buttons of the same group in the
 * interface are exclusive, checking one unchecking the others
 * @info: a radio button without a group is never unchecked by another one
 * */
pub class RadioButton over ToggleButton {

    // The group of the radio button, "" for none
    let mut _group: [c8] = "";

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "RadioButton")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          GROUP          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Put the radio button in a group, "" for none
     * */
    pub fn setGroup(mut self, group: [c8]) {
        self._group = group;
    }

    /**
     * @returns: the group of the radio button, "" for none
     * */
    pub fn getGroup(self)-> [c8] {
        self._group
    }

    /**
     * Check or uncheck the radio button without emitting its signal, checking it unchecking the others of its group
     * */
    pub over setChecked(mut self, checked: bool) {
        self.__super__:.setChecked(checked);
        if checked {
            self:.uncheckGroup(emit-> false);
        }
    }

    /**
     * A radio button checked before it was attached unchecks the others of its group once attached, the last one
     * attached staying checked
     * */
    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        if self.isChecked() {
            self:.uncheckGroup(emit-> false);
        }
    }

    /**
     * A click checks an unchecked radio button, the others of its group emitting their signal as they are unchecked
     * */
    prot over toggleByUser(mut self)-> bool {
        if self.isChecked() { return false; }

        self.__super__:.setChecked(true);
        self:.uncheckGroup(emit-> true);
        true
    }

    /**
     * Uncheck the other radio buttons of the group of this one, attached to the interface
     * @params:
     *    - emit: true for those that were checked to emit their signal
     * */
    fn uncheckGroup(mut self, emit: bool) {
        if self._group == "" || !self._attached { return; }
        if let Ok(dmut root) = alias self._manager:.getContent() {
            self:.uncheckIn(alias root, emit-> emit);
        }
    }

    /**
     * Uncheck the radio buttons of the group of this one among a widget and its descendants
     * */
    fn uncheckIn(mut self, dmut w: &Widget, emit: bool) {
        if let dmut r: &RadioButton = alias w {
            if r !is self && r._group == self._group && r.isChecked() {
                r:.setChecked(false);
                if emit { r:.emitToggled(); }
            }
        } else if let dmut l: &Layout = alias w {
            for dmut c in alias l:.getChildren() {
                self:.uncheckIn(alias c, emit-> emit);
            }
        }
    }
}

/**
 * The radio buttons in a .gui file
 * */
pub mod RadioButton {

    /**
     * @returns: the schema of the radio buttons, their text being their default attribute
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("RadioButton",
                          |dmut m, id|-> dmut &Widget => copy RadioButton(alias m, id),
                          attributes-> copy [copy Setter!{&RadioButton, [c8]}("text", |dmut b, t| => { b:.setText(t); }),
                                             copy Setter!{&RadioButton, bool}("checked", |dmut b, c| => { b:.setChecked(c); }),
                                             copy Setter!{&RadioButton, [c8]}("group", |dmut b, g| => { b:.setGroup(g); })],
                          defaultAttribute-> "text",
                          signals-> copy [ToggleButton::toggle()],
                          states-> ToggleButton::states(),
                          parts-> ToggleButton::parts())
    }
}
