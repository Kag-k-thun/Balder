in push;

use balder::core::application::signal;
use balder::interface::loader;
use balder::interface::loader::registry::schema;
use balder::math::vector;




/**
 * A push button is a simple button widget that emit signal when hit
 * */
pub class PushButton over Button {

    let dmut _doubleClicked : (&Signal!{()})? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager : &WidgetManager, id : [c8])
        with super (alias manager, id, WidgetKeys::PUSH_BUTTON)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onDoubleClick (mut self, _ : vec2)-> dmut (&Widget)? {
        if let Ok (dmut m) = alias self._doubleClicked {
            m:.emit ();
        }

        (alias self)?
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the push button is double clicked
     * */
    pub fn doubleClick (mut self)-> dmut &Signal!{()} {
        if let Ok (dmut m) = alias self._doubleClicked {
            return alias m;
        }

        let dmut m = copy Signal!{()} ();
        self._doubleClicked = (alias m)?;

        alias m
    }

}

/**
 * The push buttons in a .gui file
 * */
pub mod PushButton {

    /**
     * @returns: the schema of the push buttons, their text being their default attribute
     * */
    pub fn schema ()-> &WidgetSchema {
        copy WidgetSchema (WidgetKeys::PUSH_BUTTON,
                           |dmut m, id|-> dmut &Widget => copy PushButton (alias m, id),
                           attributes-> copy [copy Setter!{&PushButton, [c8]} ("text", |dmut b, t| => { b:.setText (t); })],
                           defaultAttribute-> "text",
                           parts-> copy ["label"])
    }
}
