in menu;

use balder::utils;
use balder::core::dispose;
use balder::interface::loader::registry::schema;
use balder::interface::style::{kinds, property};
use balder::interface::widget::alignement;
use balder::interface::widget::layout::menu;
use balder::math::vector;


/**
 * A menu button is a button that once clicked (or just hovered depending on its configuration) opens a floating menu item list
 * */
pub class MenuButton over Button {

    // The menu item to display on click
    let dmut _menu: (&Widget)? = none;

    // The id of the menu in the root floating layout (to open and close it)
    let mut _menuId: usize = 0;

    // if true display the menu even if the button is just hovered
    let mut _onlyHover: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with self (alias manager, id, "MenuButton")
    {}

    /**
     * Create a menu button of a type over the menu buttons
     * @params:
     *    - typeName: the name of the type, written in the .gui files and selected in the style sheets
     * */
    prot self (dmut manager: &WidgetManager, id: [c8], typeName: [c8])
        with super (alias manager, id, typeName)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn setMenu(mut self, dmut menu: &Widget) {
        // self:.closeMenu ();
        self._menu = (alias menu)?;
    }

    pub fn setOnlyHover(mut self, b: bool) {
        // self:.closeMenu ();
        self._onlyHover = b;
    }

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
    }

    /**
     * The menu of the button is found under it, its widgets being reachable before the menu is open
     * */
    pub over find(mut self, names: [[c8]])-> dmut(&Widget)? {
        if let Ok(dmut m) = alias self._menu {
            return m:.resolve(names);
        }

        none
    }

    pub over setMenuContext(mut self, dmut menu: &MenuLayout) {
        self._menuContext = (alias menu)?;
        if let Ok(dmut i) = alias self._menu {
            i:.setMenuContext(alias menu);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onHover(mut self, _: vec2)-> dmut(&Widget)? {
        if !self.isHover() && !self:.menuExists() {
            if let Ok(dmut menuCtx) = alias self._menuContext {
                if MenuButton::opensOnHover(menuCtx.isInBar(self), menuCtx.isMenuBarOpen(), menuCtx.isInOpenMenu(self), self._onlyHover) {
                    menuCtx:.closeAllNonParentMenu(self);
                    self:.openMenu();
                }
            }
        }

        self:.setHover(true);
        (alias self)?
    }

    /**
     * A menu button opens a menu: its click keeps the menus open
     * */
    pub over closesMenuOnClick(self)-> bool {
        false
    }

    pub over onClick(mut self, _: vec2, _: u8)-> dmut(&Widget)? {
        if let Ok(dmut menuCtx) = alias self._menuContext && (menuCtx.isInBar(self) && self:.menuExists()) {
            menuCtx:.closeAllMenu();
            return (alias self)?;
        }

        if let Ok(dmut menuCtx) = alias self._menuContext {
            menuCtx:.closeAllNonParentMenu(self);
        }

        self:.openMenu();

        self:.setPressed(true);
        (alias self)?
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          KEYBOARD EVENTS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Enter and Space open the menu as a click does, the focus moving to its first widget
     * */
    prot over activate(mut self) {
        if let Ok(dmut menuCtx) = alias self._menuContext {
            menuCtx:.closeAllNonParentMenu(self);
        }

        self:.openMenu();
        self.__super__:.activate();

        if self:.menuExists() {
            self._manager:.moveFocus(backward-> false);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          OPEN/CLOSE MENU          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the alignment of the menu against the button, set by the style popup-align, its left side under the
     * button when it sets none
     * */
    pub fn getMenuAlignment(self)-> (XAlign, YAlign) {
        if let Ok(align) = self.getStyle().getCustom!{(XAlign, YAlign)} ("popup-align") {
            return align;
        }

        (XAlign::LEFT, YAlign::BOTTOM)
    }

    /**
     * Open the menu of the button at a place of the window rather than against the button (a menu opened under the
     * cursor by a key), the menus open closed first
     * @params:
     *    - x, y: the top left corner of the menu, in pixels from the top left corner of the menu layout
     * */
    pub fn openMenuAt(mut self, x: f32, y: f32) {
        if let Ok(dmut menuCtx) = alias self._menuContext {
            menuCtx:.closeAllMenu();
        }

        self:.showMenu(x, y);
    }

    /**
     * Open the menu associated to the button on the screen, aligned by the style against the border box of the button
     * (a submenu on the right of its item, outside its paddings)
     * */
    fn openMenu(mut self) {
        let (xalign, yalign) = self.getMenuAlignment();
        let pos = self._absolutePostMarginPosition;
        let size = self._absolutePostMarginSize;
        let x = match xalign {
            XAlign::LEFT => { pos.x }
            XAlign::RIGHT => { pos.x + size.x }
            _ => { pos.x + size.x / 2.0f }
        };

        let y = match yalign {
            YAlign::TOP => { pos.y }
            YAlign::BOTTOM => { pos.y + size.y }
            _ => { pos.y + size.y / 2.0f }
        };

        self:.showMenu(x, y);
    }

    /**
     * Open the menu associated to the button at a place, closing it first when it is open
     * @params:
     *    - x, y: the top left corner of the menu, in pixels from the top left corner of the menu layout
     * */
    fn showMenu(mut self, x: f32, y: f32) {
        self:.closeMenu();
        if let Ok(dmut menu) = alias self._menu {
            if let Ok(dmut menuCtx) = alias self._menuContext {
                self._menuId = menuCtx:.openMenu(alias menu,
                                                 x-> x,
                                                 y-> y,
                                                 fromMenuBar-> menuCtx.isInBar(self),
                                                 by-> (alias self)?);
            } else {
                log::error #("MenuButton", "Menu cannot be opened outside a menu layout context");
            }
        }
    }

    /**
     * Close the item menu associated to the button
     * */
    fn closeMenu(mut self) {
        if self._menuId != 0 {
            if let Ok(dmut menuCtx) = alias self._menuContext {
                menuCtx:.closeChildMenus(self);
                menuCtx:.closeMenu(self._menuId);
            } else {
                log::error #("MenuButton", "Menu cannot be opened outside a menu layout context");
                panic;
            }

            self._menuId = 0;
        }
    }

    /**
     * Verify that the menu of the button is open
     * @returns: true if still open on the root layout
     * */
    fn menuExists(mut self)-> bool {
        if self._menuId == 0 {
            return false;
        }

        if let Ok(menuCtx) = self._menuContext {
            if !menuCtx.isMenuOpened(self._menuId) {
                self._menuId = 0;
            }
        }

        self._menuId != 0
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSABLE          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        pub over dispose(mut self) {
            self:.closeMenu();

            if let Ok(dmut d) = alias self._menu {
                d:.dispose();
            }

            self.__super__:.dispose();
        }


    }



}

/**
 * The menu buttons in a .gui file
 * */
pub mod MenuButton {

    /**
     * @returns: the schema of the menu buttons, their text being their default attribute, their shortcut written after
     * it, and their child their popup
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("MenuButton",
            |dmut m, id|-> dmut &Widget => copy MenuButton(alias m, id),
                          attributes-> copy [copy Setter!{&MenuButton, [c8]} ("text", |dmut b, t| => { b:.setText(t); }),
                                             copy Setter!{&MenuButton, [c8]} ("shortcut", |dmut b, s| => { b:.setShortcut(s); }),
                                             copy Setter!{&MenuButton, bool} ("open-on-hover", |dmut b, h| => { b:.setOnlyHover(h); })],
                          defaultAttribute-> "text",
                          children-> (copy Inserter!{&MenuButton} (|dmut b, dmut c, _| => { b:.setMenu(alias c); },
                                                                   roles-> copy ["popup"]))?,
                          parts-> copy ["label", "shortcut"],
                          properties-> copy [MenuButton::popupAlign()])
    }

    /**
     * @returns: the property of the alignment of the popup of a menu button against it, a horizontal then a vertical
     * alignment (popup-align: left bottom)
     * */
    pub fn popupAlign()-> &WidgetProperty!{(XAlign, YAlign)} {
        copy WidgetProperty!{(XAlign, YAlign)} ("popup-align", Kind::POPUP_ALIGN, &?kinds::popupAlign)
    }

    /**
     * @returns: true iff hovering a menu button opens its menu
     */
    pub fn opensOnHover(inBar: bool, barMenuOpen: bool, inMenu: bool, onlyHover: bool)-> bool {
        if inBar {
            return barMenuOpen;
        }

        inMenu || onlyHover
    }
}
