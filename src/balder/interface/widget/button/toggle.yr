in toggle;

use balder::core::dispose;
use balder::core::application::signal;
use balder::interface::loader::registry::schema;
use balder::interface::widget::box;
use balder::math::vector;

use ::sdl3::mouse;

use ::std::algorithm::comparison;

// The size of the box of a toggle whose style sets none, in pixels
def DEFAULT_BOX_SIZE = 16.0f;

/**
 * Ancestor class of the buttons the user checks: a box on the left of the label, and a mark drawn in the box while the
 * button is checked
 * @info:
 * =====
 * The box and the mark are the parts `::box` and `::mark`: the box sized by its width and height (16 pixels when its
 * style sets none) and centred on the height of the button, the mark by its width and height in the content box of the
 * box, filling it when its style sets none. The button is in the state `:checked` while it is checked, so that
 * `CheckBox:checked::mark` colours the mark of a checked box.
 * ====
 * */
@abstract
pub class ToggleButton over Button {

    // The box showing whether the button is checked
    let dmut _box: &Box;

    // The mark drawn in the box
    let dmut _mark: &Box;

    // The size of the margin box of the box, in pixels
    let mut _boxSize: vec2 = vec2();

    prot { // signals
        let dmut _toggled: (&Signal!{bool})? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot self (dmut manager: &WidgetManager, id: [c8], typeName: [c8])
        with super(alias manager, id, typeName)
        , _box = copy Box(alias manager, "")
        , _mark = copy Box(alias manager, "")
    {
        self._box:.setOwnerPart("box");
        self._mark:.setOwnerPart("mark");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHECKED          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check or uncheck the button, without emitting its signal
     * */
    pub fn setChecked(mut self, checked: bool) {
        self:.setState("checked", checked);
    }

    /**
     * @returns: true iif the button is checked
     * */
    pub fn isChecked(self)-> bool {
        self.hasState("checked")
    }

    /**
     * Change the state of the button after the user clicked it
     * @returns: true iif the click checked or unchecked it
     * */
    prot fn toggleByUser(mut self)-> bool;

    /**
     * Emit the signal of the button, after the user checked or unchecked it
     * */
    prot fn emitToggled(mut self) {
        if let Ok(dmut s) = alias self._toggled {
            s:.emit(self.isChecked());
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STYLE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot over onApplyStyle(mut self) {
        self.__super__:.onApplyStyle();
        self._box:.setStyle(self.getStyle().getSubStyle("box"));
        self._mark:.setStyle(self.getStyle().getSubStyle("mark"));
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The box on the left, centred on the height of the button, the mark in the box, and the label taking the rest
     * */
    over onUpdateSize(mut self) {
        self._boxSize = self:.measureBox(self._absoluteSize);

        let boxPos = makeVec2(self._absolutePosition.x,
                              self._absolutePosition.y + (self._absoluteSize.y - self._boxSize.y) / 2.0f);
        self._box:.setSize(boxPos, self._boxSize, self._depth + 1, self._absoluteSize);

        let inner = self._box.getAbsoluteInnerSize();
        let markSize = self._mark:.measurePartSize(inner, inner);

        let markPos = self._box.getAbsoluteInnerPosition() + (inner - markSize) / 2.0f;
        self._mark:.setSize(markPos, markSize, self._box.getMaxDepth(), inner);

        let labelPos = makeVec2(self._absolutePosition.x + self._boxSize.x, self._absolutePosition.y);
        let labelSize = makeVec2(max(0.0f, self._absoluteSize.x - self._boxSize.x), self._absoluteSize.y);
        self._label:.setSize(labelPos, labelSize, self._depth + 1);

        self:.onUpdateScissors();
    }

    over onUpdateScissors(mut self) {
        let (sciPos, sciSize) = self.getScissors(self._absolutePosition, self._absoluteSize);
        self._label:.setScissors(sciPos, sciSize);
        self._box:.setScissors(sciPos, sciSize);
        self._mark:.setScissors(sciPos, sciSize);
    }

    pub over getMaxDepth(self)-> u32 {
        max(self._label.getMaxDepth(), self._mark.getMaxDepth())
    }

    /**
     * The content of a toggle is its box followed by its label
     * */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        let box = self:.measureBox(makeVec2(INDEFINITE_SIZE, INDEFINITE_SIZE)).x;
        let (minWidth, maxWidth) = self._label:.measureIntrinsicWidths();
        (box + minWidth, box + maxWidth)
    }

    prot over measureContentHeights(mut self, width: f32)-> (f32, f32) {
        let box = self:.measureBox(makeVec2(INDEFINITE_SIZE, INDEFINITE_SIZE));
        let labelWidth = self._label:.measureWidth(makeVec2(max(0.0f, width - box.x), INDEFINITE_SIZE), stretch-> true);
        let (minHeight, maxHeight) = self._label:.measureIntrinsicHeights(labelWidth);
        (max(box.y, minHeight), max(box.y, maxHeight))
    }

    /**
     * @returns: the size of the margin box of the box, 16 pixels on an axis its style resolves no size on
     * @params:
     *    - container: the content box of the toggle, a component being INDEFINITE_SIZE when it is unknown
     * */
    fn measureBox(mut self, container: vec2)-> vec2 {
        self._box:.measurePartSize(container, makeVec2(DEFAULT_BOX_SIZE, DEFAULT_BOX_SIZE))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          ATTACH/DETACH          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onAttach(mut self, parent: (&Widget)?) {
        self.__super__:.onAttach(parent);
        self._box:.onAttach((self)?);
        self._mark:.onAttach((self)?);
    }

    over onHide(mut self) {
        self.__super__:.onHide();
        self._box:.hide();
        self._mark:.hide();
    }

    over onShow(mut self) {
        self.__super__:.onShow();
        self._box:.show();
        self._mark:.show();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENT          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A click of the left button released on the toggle checks or unchecks it
     * */
    pub over onClickEnd(mut self, button: u8)-> dmut (&Widget)? {
        self.__super__:.onClickEnd(button);
        if button == SDL_BUTTON_LEFT && self:.toggleByUser() {
            self:.emitToggled();
        }

        (alias self)?
    }

    /**
     * Enter and Space check or uncheck the toggle as a click does
     * */
    prot over activate(mut self) {
        if self:.toggleByUser() {
            self:.emitToggled();
        }

        self.__super__:.activate();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the user checks or unchecks the button, with true iif it is now checked
     * */
    pub fn toggled(mut self)-> dmut &Signal!{bool} {
        if let Ok(dmut s) = alias self._toggled {
            return alias s;
        }

        let dmut s = copy Signal!{bool} ();
        self._toggled = (alias s)?;

        alias s
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self._box:.dispose();
            self._mark:.dispose();
            self.__super__:.dispose();
        }
    }
}

/**
 * What the toggle buttons register in a .gui file
 * */
pub mod ToggleButton {

    /**
     * @returns: the states of the toggle buttons, checked with those of every widget
     * */
    pub fn states()-> [[c8]] {
        copy ["hover", "focus", "pressed", "checked"]
    }

    /**
     * @returns: the parts of the toggle buttons: their label, their box and the mark in it
     * */
    pub fn parts()-> [[c8]] {
        copy ["label", "box", "mark"]
    }

    /**
     * @returns: the signal of the toggle buttons, on-toggle with true iif the user checked the button
     * */
    pub fn toggle()-> &SignalAttribute {
        copy Emitter!{&ToggleButton, bool}("on-toggle", |dmut b|-> dmut &Signal!{bool} => alias b:.toggled())
    }
}
