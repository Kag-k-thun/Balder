in icon;

use balder::core::application::signal;
use balder::interface::style;
use balder::interface::loader::registry::schema;
use balder::interface::widget::layout;
use balder::math::vector;

use std::math;
use std::algorithm::comparison;

use ::sdl3::mouse;

// The side of the icon of a button whose style sets no size, in pixels
def DEFAULT_ICON_SIZE = 16.0f;

/**
 * An icon button shows an icon instead of a text; its name, told by its tooltip
 * with its shortcut, is its accessible name
 *
 * @info:
 * =====
 *
 * The icon is the background image of the button, an SVG drawn in the largest
 * square of its content box, snapped to the pixels, rasterised at that size and
 * tinted by image-color: the icons are drawn white, the style colours them per
 * state. A checkable button switches the state `:checked` at each click; the
 * checkable buttons of a group are exclusive, a click checking one and
 * unchecking the others, never unchecking the checked one. In a ToolGroup the
 * first and the last buttons are in the states `:first` and `:last`, so that
 * the sheets round their outer corners only.
 *
 * ====
 * */
pub class IconButton over Button {

    // THe file of the icon, "" for the image of the style
    let mut _icon: [c8] = "";

    // What the button does, told by its tooltip, "" for none
    let mut _name: [c8] = "";

    // The keys doing what the button does, told by its tooltop after its name, "" for none
    let mut _keys: [c8] = "";

    // True if a click checks or unchecks the button
    let mut _checkable: bool = false;

    // The group of the button, its checkable button exclusive, "" for none
    let mut _group: [c8] = "";

    // The pixels in a layout pixel at the last layout, the icon snapped to them
    let mut _scale: f32 = 1.0f;

    let dmut _toggled: (&Signal!{bool})? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super (alias manager, id, "IconButton")
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Show the icon of a file, set over the style as the inline style of the
     * button
     *
     * @params:
     *    - path: the SVG file, engine:/ and res:/ paths accepted
     *
     * */
    pub fn setIcon(mut self, path: [c8]) {
        if self._icon == path {
            return;
        }

        self._icon = path;
        let dmut withIcon = copy Style();
        withIcon:.merge(self.getInlineStyle());
        withIcon.backgroundImage = (true, path);
        self:.setInlineStyle(withIcon);
    }

    /**
     * Name what the button does, told by its tooltip, its accessible name
     * */
    pub fn setName(mut self, name: [c8]) {
        self._name = name;
        self:.setTooltip(name, shortcut-> self._keys);
    }

    /**
     * @returns: what the button does, its accessible name
     * */
    pub fn getAccessibleName(self)-> [c8] {
        self._name
    }

    /**
     * The keys of an icon button are told by its tooltip after its name, never
     * written in the button
     *
     * */
    pub over setShortcut(mut self, keys: [c8]) {
        self._keys = keys;
        self:.setTooltip(self._name, shortcut-> keys);
    }

    pub over getShortcut(self)-> [c8] {
        self._keys
    }

    /**
     * Make a click check or uncheck the button
     * */
    pub fn setCheckable(mut self, checkable: bool) {
        self._checkable = checkable;
    }

    /**
     * Put the button in a group, its checkable buttons exclusive, "" for none
     * */
    pub fn setGroup(mut self, group: [c8]) {
        self._group = group;
    }

    /**
     * Check or uncheck the button without emitting its signal, checking it
     * unchecking the others of its group
     *
     * */
    pub fn setChecked(mut self, checked: bool) {
        self:.setState("checked", checked);
        if checked {
            self:.uncheckGroup(emit-> false);
        }
    }

    /**
     * @returns: true iif the button is checked
     * */
    pub fn isChecked(self)-> bool {
        self.hasState("checked")
    }

    /**
     * Put the button at the ends of a segmented group, its outer corners
     * rounded by the style
     *
     * */
    pub fn setSegment(mut self, first: bool, last: bool) {
        self:.setState("first", first);
        self:.setState("last", last);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onUpdateSize(mut self) {
        self._scale = self._manager:.getWindow().getScale();
        self.__super__:.onUpdateSize();
    }

    /**
     * The content of an icon button is its icon, 16 pixels square
     *
     */
    prot over measureContentWidths(mut self)-> (f32, f32) {
        (DEFAULT_ICON_SIZE, DEFAULT_ICON_SIZE)
    }


    prot over measureContentHeights(mut self, _: f32)-> (f32, f32) {
        (DEFAULT_ICON_SIZE, DEFAULT_ICON_SIZE)
    }

    /**
     * The icon is the largest square of the content box, snapped to the pixels, instead of the padding box
     * */
    over computeBackgroundImageSize(self)-> (vec2, vec2) {
        IconButton::iconBox(self._absolutePosition, self._absoluteSize, self._scale)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A click of the left button released on a checkable button checks or
     * unchecks it
     *
     * */
    pub over onClickEnd(mut self, button: u8)-> dmut(&Widget)? {
        self.__super__:.onClickEnd(button);
        if button == SDL_BUTTON_LEFT && self:.toggleByUser() {
            self:.emitToggled();
        }

        (alias self)?
    }


    /**
     * Enter and Space check or uncheck the button as a click does
     *
     * */
    prot over activate(mut self) {
        if self:.toggleByUser() {
            self:.emitToggled();
        }

        self.__super__:.activate();
    }

    /**
     * Change the state of the button after the user clicked it
     *
     * @returns: true iif the click checked or unchecked it
     *
     * */
    fn toggleByUser(mut self)-> bool {
        if !self._checkable {
            return false;
        }

        if self._group == "" {
            self:.setState("checked", !self.isChecked());
            return true;
        }

        if self.isChecked() {
            return false;
        }

        self:.setState("checked", true);
        self:.uncheckGroup(emit-> true);
        true
    }

    fn emitToggled(mut self) {
        if let Ok(dmut s) = alias self._toggled {
            s:.emit(self.isChecked());
        }
    }

    fn uncheckGroup(mut self, emit: bool) {
        if self._group == "" || !self._attached { return; }
        if let Ok(dmut root) = alias self._manager:.getContent() {
            self:.uncheckIn(alias root, emit-> emit);
        }
    }

    /**
     * Uncheck the other buttons of the group of this one, attached to the
     * interface
     *
     * @params:
     *    - emit: true for those that were checked to emit their signal
     * */
    fn uncheckIn(mut self, dmut w: &Widget, emit: bool) {
        if let dmut b: &IconButton = alias w {
            if b !is self && b._group == self._group && b.isChecked() {
                b:.setState("checked", false);
                if emit {
                    b:.emitToggled();
                }
            }
        } else if let dmut l: &Layout = alias w {
            for dmut c in alias l:.getChildren() {
                self:.uncheckIn(alias c, emit-> emit);
            }
        }
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the user checks or unchecks the button,
     * with true iif it is now checked
     *
     * */
    pub fn toggled(mut self)-> dmut &Signal!{bool} {
        if let Ok(dmut s) = alias self._toggled {
            return alias s;
        }

        let dmut s = copy Signal!{bool}();
        self._toggled = (alias s)?;
        alias s
    }
}

@companion
pub mod IconButton {

    /**
     * @returns: the schema of the icon buttons, their name being their default
     * attribute
     *
     * */
    #[widgetSchema]
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("IconButton",
            |dmut m, id|-> dmut &Widget => copy IconButton(alias m, id),
                          attributes-> copy [copy Setter!{&IconButton, [c8]}("name", |dmut b, n| => { b:.setName(n); }),
                                             copy Setter!{&IconButton, [c8]}("icon", |dmut b, p| => { b:.setIcon(p); }),
                                             copy Setter!{&IconButton, [c8]}("shortcut", |dmut b, k| => { b:.setShortcut(k); }),
                                             copy Setter!{&IconButton, bool}("checkable", |dmut b, c| => { b:.setCheckable(c); }),
                                             copy Setter!{&IconButton, bool}("checked", |dmut b, c| => { b:.setChecked(c); }),
                                             copy Setter!{&IconButton, [c8]}("group", |dmut b, g| => { b:.setGroup(g); })],
                          defaultAttribute-> "name",
                          signals-> copy [IconButton::toggle()],
                          states-> IconButton::states())
    }

    /**
     * @returns: the states of the icon buttons, checked, and at the ends of a
     * ToolGroup
     *
     * */
    pub fn states()-> [[c8]] {
        copy ["hover", "focus", "pressed", "checked", "first", "last"]
    }

    /**
     * @returns: the signal of the icon buttons, on-toggle with true iif the
     * user checked the button
     *
     * */
    pub fn toggle()-> &SignalAttribute {
        copy Emitter!{&IconButton, bool}("on-toggle", |dmut b|-> dmut &Signal!{bool} => alias b:.toggled())
    }

    /**
     * @returns: the square the icon is drawn in, the largest one centred in the
     * content box, its side and its corner on whole pixels
     *
     * @params:
     *    - pos, size: the content box, in layout pixels
     *    - scale: the pixels in a layout pixel
     * */
    pub fn iconBox(pos: vec2, size: vec2, scale: f32)-> (vec2, vec2) {
        let side = round(min(size.x, size.y) * scale) / scale;
        let corner = pos + (size - makeVec2(side, side)) / 2.0f;
        (makeVec2(round(corner.x * scale), round(corner.y * scale)) / scale, makeVec2(side, side))
    }
}
