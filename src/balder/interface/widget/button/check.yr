in check;

use balder::interface::loader::registry::schema;
use balder::interface::widget::button::toggle;

/**
 * A check box is a toggle button the user checks and unchecks with a click
 * */
pub class CheckBox over ToggleButton {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &WidgetManager, id: [c8])
        with super(alias manager, id, "CheckBox")
    {}

    /**
     * A click checks an unchecked box, and unchecks a checked one
     * */
    prot over toggleByUser(mut self)-> bool {
        self:.setChecked(!self.isChecked());
        true
    }
}

/**
 * The check boxes in a .gui file
 * */
pub mod CheckBox {

    /**
     * @returns: the schema of the check boxes, their text being their default attribute
     * */
    pub fn schema()-> &WidgetSchema {
        copy WidgetSchema("CheckBox",
                          |dmut m, id|-> dmut &Widget => copy CheckBox(alias m, id),
                          attributes-> copy [copy Setter!{&CheckBox, [c8]}("text", |dmut b, t| => { b:.setText(t); }),
                                             copy Setter!{&CheckBox, bool}("checked", |dmut b, c| => { b:.setChecked(c); })],
                          defaultAttribute-> "text",
                          signals-> copy [ToggleButton::toggle()],
                          states-> ToggleButton::states(),
                          parts-> ToggleButton::parts())
    }
}
