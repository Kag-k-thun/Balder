/**
 * The widgets showing a value between two bounds: the slider and the progress bar, the spin box being an input text
 * */
in range;

pub mod ::slider;
pub mod ::progress;
mod ::utils;

use std::math;
use std::algorithm::comparison;

use ::sdl3::keycode;

// The number of steps of a range that has no step, moving a value by one of them
def STEPS_OF_A_CONTINUOUS_RANGE = 100.0f;

// The number of steps Page Up and Page Down move a value by
def STEPS_OF_A_PAGE = 10;

/**
 * The bounds of the value of a slider, a progress bar or a spin box, and the step between two of its values
 * */
@data
pub record ValueRange {

    // The lowest value
    pub let lower: f32 = 0.0f;

    // The highest value, the lowest one when it is under it
    pub let upper: f32 = 100.0f;

    // The distance between two values, from the lowest one, 0 for any value between the bounds
    pub let step: f32 = 0.0f;

    /**
     * @returns: the highest value, the lowest one when the upper bound is under it
     * */
    pub fn top(self)-> f32 {
        max(self.lower, self.upper)
    }

    /**
     * @returns: the distance between the two bounds
     * */
    pub fn span(self)-> f32 {
        self.top() - self.lower
    }

    /**
     * @returns: the value the closest to 'value' in the range: between its bounds, and a whole number of steps from the
     * lowest one, the step under the highest one when the highest is not a whole number of steps away
     * */
    pub fn snap(self, value: f32)-> f32 {
        let inside = clamp(value, self.lower, self.top());
        if self.step <= 0.0f { return inside; }

        let mut steps = round((inside - self.lower) / self.step);
        if self.lower + steps * self.step > self.top() {
            steps = floor(self.span() / self.step);
        }

        self.lower + steps * self.step
    }

    /**
     * @returns: the part of the range under a value, from 0 at the lowest value to 1 at the highest one, 0 for a range of
     * a single value
     * */
    pub fn fractionOf(self, value: f32)-> f32 {
        if self.span() <= 0.0f { return 0.0f; }

        (self.snap(value) - self.lower) / self.span()
    }

    /**
     * @returns: the value of the range at a part of it, from 0 for the lowest value to 1 for the highest one, snapped
     * */
    pub fn valueAt(self, fraction: f32)-> f32 {
        self.snap(self.lower + clamp(fraction, 0.0f, 1.0f) * self.span())
    }

    /**
     * @returns: the value a number of steps away from 'value', a hundredth of the range standing for a step when the
     * range has none, snapped
     * @params:
     *    - steps: the number of steps, negative to go down
     * */
    pub fn moveBy(self, value: f32, steps: i32)-> f32 {
        let step = if self.step > 0.0f { self.step } else { self.span() / STEPS_OF_A_CONTINUOUS_RANGE };
        self.snap(value + cast!f32(steps) * step)
    }

    /**
     * @returns: the value a key moves 'value' to: a step up for Up, a step down for Down, ten steps for Page Up and Page
     * Down, the lowest and the highest value for Home and End, snapped; none for another key
     * @params:
     *    - sideways: true for Right and Left to move the value as Up and Down do
     * */
    pub fn moveByKey(self, value: f32, key: SDL_Keycode, sideways: bool)-> (f32)? {
        if key == SDLK_HOME { return (self.snap(self.lower))?; }
        if key == SDLK_END { return (self.snap(self.top()))?; }

        let steps = if key == SDLK_UP || (sideways && key == SDLK_RIGHT) {
            1
        } else if key == SDLK_DOWN || (sideways && key == SDLK_LEFT) {
            -1
        } else if key == SDLK_PAGEUP {
            STEPS_OF_A_PAGE
        } else if key == SDLK_PAGEDOWN {
            -STEPS_OF_A_PAGE
        } else {
            return none;
        };

        (self.moveBy(value, steps))?
    }
}
