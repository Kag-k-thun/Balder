in parser;

use balder::utils::_;
use balder::core::error;
use balder::interface::style::_;
use balder::interface::font::family;
use balder::interface::loader;
use balder::interface::loader::parser;
use balder::interface::widget::alignement;
use balder::math::vector;

use std::{conv, io, stream, syntax::_, traits};
use std::algorithm::searching;

/**
 * Class parsing a style sheet string
 * */
pub record StyleParser {

    // The content parsed by the parser
    let mut _content: [c8] = "";

    // The style manager
    let dmut _styleManager: &StyleManager;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut manager: &StyleManager, content: [c8])
        with _styleManager = alias manager
        , _content = content
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PARSING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load a style sheet string and register the style into the parser
     * */
    pub fn load(mut self)
        throws BalderError
    {
        let dmut lex = copy Lexer!{c8} (self._content,
                                        tokens-> copy Tokens::__members__,
                                        comments-> copy Comments::__members__);

        while !lex.isEof() {
            let (widgetName, line, col) = lex:.next();
            if widgetName == Keywords::FONT_FACE {
                self:.readFontFace(alias lex);
            } else if widgetName != "" && !lex.isEof() {
                self.verifyIdentifier(widgetName, line, col);
                self:.readWidgetStyle(widgetName, line, col, alias lex);
            }
        }
    }

    /**
     * Read a @font-face rule, registering a font file in a family
     * ```
     * @font-face {
     *     font-family: "Noto Sans";
     *     src: "res:/fonts/noto/NotoSans-Bold.ttf";
     *     font-weight: 700;     // optional, read from the file if omitted
     *     font-style: normal;   // optional, read from the file if omitted
     * }
     * ```
     * */
    fn readFontFace(mut self, dmut lexer: &Lexer!{c8})
        throws BalderError
    {
        let (_, line, col) = self.readTokens(alias lexer, Tokens::LACC);

        let mut family = "", mut src = "";
        let mut weight: (u32)? = none;
        let mut style: (FontStyle)? = none;
        loop {
            let (n, l, c) = lexer:.next();
            match n {
                Tokens::RACC => { break; }
                Keywords::FONT_FAMILY => {
                    let families = self.readFontFamilies(alias lexer);
                    if families.len != 1us {
                        throw copy BalderError(std::format::format("A @font-face names a single family at ({}:{})", l, c));
                    }

                    family = families[0];
                }
                Keywords::SRC => {
                    src = self.readString(alias lexer);
                }
                Keywords::FONT_WEIGHT => {
                    weight = (self.readFontWeight(alias lexer))?;
                }
                Keywords::FONT_STYLE => {
                    style = (self.readFontStyle(alias lexer))?;
                }
                _ => {
                    throw self.unexpected(n, l, c);
                }
            }
        }

        if family == "" || src == "" {
            throw copy BalderError(std::format::format("A @font-face needs a font-family and a src at ({}:{})", line, col));
        }

        self._styleManager:.insertFontFace(FontFaceRule(family, src, weight, style));
    }

    /**
     * Read a widget style into a rule of the style manager
     * @params:
     *    - line: the line of the name of the widget
     *    - col: the column of the name of the widget
     * */
    fn readWidgetStyle(mut self, widgetName: [c8], line: usize, col: usize, dmut lexer: &Lexer!{c8})
        throws BalderError
    {
        let mut classes: [[c8]] = [];
        let mut subItem         = "";
        let dmut state          = [false; 3];
        let mut readClass = false, mut readState = false;

        loop {
            match lexer:.next() {
                (_ = Tokens::COLON, l, c) => {
                    if (readClass) { throw self.unexpected(Tokens::COLON, l, c); }
                    readState = true;

                    self.readStyleState(ref state, alias lexer);
                }
                (_ = Tokens::DCOLON, l, c) => {
                    if subItem != "" || readClass {
                        throw self.unexpected(Tokens::DCOLON, l, c);
                    }

                    let (ident, l2, c2) = lexer:.next();
                    self.verifyIdentifier(ident, l2, c2);
                    subItem = ident;
                }
                (_ = Tokens::POINT, _, _) => {
                    let (ident, l2, c2) = lexer:.next();
                    self.verifyIdentifier(ident, l2, c2);

                    classes = classes ~ [ident];
                    readClass = true;
                }
                (_ = Tokens::LACC, _, _) => { break; }
                (v, l, c) => {
                    throw self.unexpected(v, l, c);
                }
            }
        }

        let style = self.readStyleContent(alias lexer, readState);
        let mut states: [[c8]] = [];
        if state[0] { states ~= ["hover"]; }
        if state[1] { states ~= ["focus"]; }
        if state[2] { states ~= ["check"]; }

        self._styleManager:.insertRule(StyleParser::rule(widgetName, classes, states, subItem, style, line, col));
    }

    /**
     * Read the style state
     * */
    fn readStyleState(self, ref dmut state: [bool; 3], dmut lexer: &Lexer!{c8})
        throws BalderError
    {
        let (name, l, c) = lexer:.next();
        match name {
            Keywords::HOVER => {
                state[0] = true;
            }
            Keywords::FOCUS => {
                state[1] = true;
            }
            Keywords::CHECK => {
                state[2] = true;
            }
            _ => {
                throw self.unexpected(name, l, c);
            }
        }
    }

    /**
     * Read the content of a style
     * @params:
     *    - lexer: the lexer tokenizing the style sheet string
     * */
    fn readStyleContent(self, dmut lexer: &Lexer!{c8}, withModifier: bool)-> dmut &Style
        throws BalderError
    {
        let dmut result = copy Style();

        loop {
            let (n, l, c) = lexer:.next();
            match n {
                Tokens::RACC => { break; }
                Keywords::COLOR => {
                    result.color.0 = true;
                    result.color.1 = self.readColor(alias lexer);
                }
                Keywords::BORDER_COLOR => {
                    result.borderColor.0 = true;
                    result.borderColor.1 = self.readColor(alias lexer);
                }
                Keywords::BACKGROUND_COLOR => {
                    result.backgroundColor.0 = true;
                    result.backgroundColor.1 = self.readColor(alias lexer);
                }
                Keywords::IMAGE_COLOR => {
                    result.imageColor.0 = true;
                    result.imageColor.1 = self.readColor(alias lexer);
                }
                Keywords::IMAGE_KEEP_RATIO => {
                    result.backgroundImageKeepRatio._0 = true;
                    result.backgroundImageKeepRatio._1 = self.readBool(alias lexer);
                }
                Keywords::IMAGE_FILL => {
                    result.backgroundImageFill._0 = true;
                    result.backgroundImageFill._1 = self.readBool(alias lexer);
                }
                Keywords::TEXT_COLOR => {
                    result.textColor.0 = true;
                    result.textColor.1 = self.readColor(alias lexer);
                }
                Keywords::TEXT_XALIGN => {
                    result.xalign.0 = true;
                    result.xalign.1 = self.readXAlign(alias lexer);
                }
                Keywords::TEXT_YALIGN => {
                    result.yalign.0 = true;
                    result.yalign.1 = self.readYAlign(alias lexer);
                }
                Keywords::TEXT_WRAP => {
                    result.textWrap.0 = true;
                    result.textWrap.1 = self.readWrap(alias lexer);
                }
                Keywords::SELECTION_COLOR => {
                    result.selectionColor.0 = true;
                    result.selectionColor.1 = self.readColor(alias lexer);
                }
                Keywords::BACKGROUND_IMAGE => {
                    result.backgroundImage.0 = true;
                    result.backgroundImage.1 = self.readString(alias lexer);
                }
                Keywords::FONT_FAMILY => {
                    result.fontFamily.0 = true;
                    result.fontFamily.1 = copy self.readFontFamilies(alias lexer);
                }
                Keywords::FONT_WEIGHT => {
                    result.fontWeight.0 = true;
                    result.fontWeight.1 = self.readFontWeight(alias lexer);
                }
                Keywords::FONT_STYLE => {
                    result.fontStyle.0 = true;
                    result.fontStyle.1 = self.readFontStyle(alias lexer);
                }
                Keywords::FONT_SIZE => {
                    result.fontSize.0 = true;
                    self.readTokens(alias lexer, Tokens::COLON);
                    result.fontSize.1 = self.readInt!{u32} (alias lexer);
                    self.readTokens(alias lexer, Tokens::SEMI_COLON);
                }
                Keywords::RADIUS => {
                    result.radius.0 = true;
                    self.readTokens(alias lexer, Tokens::COLON);
                    result.radius.1 = self.readInt!{u32} (alias lexer);
                    self.readTokens(alias lexer, Tokens::SEMI_COLON);
                }
                _ => {
                    if withModifier {
                        let inner = self.unexpected(n, l, c);
                        throw copy BalderError("Size modifier is only applicable on non-contextual style classes : "
                                               ~ inner.msg);
                    }

                    self.readStyleContentSize(n, l, c, alias lexer, alias result);
                }
            }
        }

        alias result
    }

    /**
     * Read a size style modifier
     * */
    fn readStyleContentSize(self, n: [c8], l: usize, c: usize, dmut lexer: &Lexer!{c8}, dmut result: &Style)
        throws BalderError
    {
        match n {
            Keywords::BORDER => {
                result.borderWidth.0 = true;
                self.readTokens(alias lexer, Tokens::COLON);
                result.borderWidth.1 = self.readInt!{u32} (alias lexer);
                self.readTokens(alias lexer, Tokens::SEMI_COLON);
            }
            Keywords::PADDING => {
                let size = (true, self.readSize(alias lexer));
                result.paddingTop = size;
                result.paddingRight = size;
                result.paddingBottom = size;
                result.paddingLeft = size;
            }
            Keywords::PADDING_TOP => {
                result.paddingTop = (true, self.readSize(alias lexer));
            }
            Keywords::PADDING_BOTTOM => {
                result.paddingBottom = (true, self.readSize(alias lexer));
            }
            Keywords::PADDING_LEFT => {
                result.paddingLeft = (true, self.readSize(alias lexer));
            }
            Keywords::PADDING_RIGHT => {
                result.paddingRight = (true, self.readSize(alias lexer));
            }
            Keywords::MARGIN => {
                let size = (true, self.readSize(alias lexer));
                result.marginTop = size;
                result.marginRight = size;
                result.marginBottom = size;
                result.marginLeft = size;
            }
            Keywords::MARGIN_TOP => {
                result.marginTop = (true, self.readSize(alias lexer));
            }
            Keywords::MARGIN_BOTTOM => {
                result.marginBottom = (true, self.readSize(alias lexer));
            }
            Keywords::MARGIN_LEFT => {
                result.marginLeft = (true, self.readSize(alias lexer));
            }
            Keywords::MARGIN_RIGHT => {
                result.marginRight = (true, self.readSize(alias lexer));
            }
            Keywords::SIZE => {
                let size = (true, self.readSize(alias lexer));
                result.width = size;
                result.height = size;
            }
            Keywords::WIDTH => {
                result.width = (true, self.readSize(alias lexer));
            }
            Keywords::HEIGHT => {
                result.height = (true, self.readSize(alias lexer));
            }
            Keywords::FLEX_GROW => {
                result.flexGrow.0 = true;
                result.flexGrow.1 = self.readFactor(alias lexer);
            }
            Keywords::FLEX_SHRINK => {
                result.flexShrink.0 = true;
                result.flexShrink.1 = self.readFactor(alias lexer);
            }
            Keywords::FLEX_BASIS => {
                result.flexBasis.0 = true;
                result.flexBasis.1 = self.readSize(alias lexer);
            }
            _ => {
                throw self.unexpected(n, l, c);
            }
        }
    }

    /**
     * Read a color
     * */
    fn readColor(self, dmut lexer: &Lexer!{c8})-> vec4
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);

        let mut color      = vec4();
        let (colorS, l, c) = lexer:.next();
        {
            if colorS.len != 0 && colorS[0] == '#' {
                color = palette::colorFromHex(std::conv::to!{u32, "x"} ("0x" ~ colorS[1 .. $]));
            } else if let Ok(pos) = colorS.find('!') {
                let level = std::conv::to!{u32} (colorS[pos + 1 .. $]);
                color = ColorPalette.get(colorS[0 .. pos], cast!f32(level) / 100.0f);
            } else {
                color = ColorPalette.get(colorS, 0.0f);
            }
        } catch {
            _ => { throw self.unexpected(colorS, l, c); }
        }

        let (end, l2, c2) = lexer:.next();
        let (end2, l4, c4) = if end == Tokens::COLON {
            let (alphaS, l3, c3) = lexer:.next();
            {
                color.w = cast!f32(std::conv::to!{u32} (alphaS)) / 255.0f;
            } catch {
                _ => { throw self.unexpected(alphaS, l3, c3); }
            }

            lexer:.next()
        } else {
            (end, l2, c2)
        };

        if end2 != Tokens::SEMI_COLON {
            throw self.unexpected(end2, l4, c4);
        }

        color
    }

    /**
     * Read the wrapping of a text, 'wrap' or 'nowrap'
     * @returns: true if the text is wrapped
     * */
    fn readWrap(self, dmut lexer: &Lexer!{c8})-> bool
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);
        let (tok, _, _) = self.readTokens(alias lexer, Keywords::WRAP, Keywords::NOWRAP);
        self.readTokens(alias lexer, Tokens::SEMI_COLON);

        tok == Keywords::WRAP
    }

    /**
     * Read a text xalignement
     * */
    fn readXAlign(self, dmut lexer: &Lexer!{c8})-> XAlign
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);
        let c = lexer:.next();
        let align = match c._0 {
            Keywords::LEFT   => { XAlign::LEFT }
            Keywords::RIGHT  => { XAlign::RIGHT }
            Keywords::CENTER => { XAlign::CENTER }
            _ => {
                throw self.unexpected(expand c);
            }
        };

        self.readTokens(alias lexer, Tokens::SEMI_COLON);
        align
    }

    /**
     * Read a text xalignement
     * */
    fn readYAlign(self, dmut lexer: &Lexer!{c8})-> YAlign
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);
        let c = lexer:.next();
        let align = match c._0 {
            Keywords::TOP    => { YAlign::TOP }
            Keywords::BOTTOM => { YAlign::BOTTOM }
            Keywords::CENTER => { YAlign::CENTER }
            _ => {
                throw self.unexpected(expand c);
            }
        };

        self.readTokens(alias lexer, Tokens::SEMI_COLON);
        align
    }

    /**
     * Read a list of font families, separated by commas, a family being quoted ("Noto Sans") or not (sans-serif)
     * */
    fn readFontFamilies(self, dmut lexer: &Lexer!{c8})-> [[c8]]
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);

        let mut families: [[c8]] = [];
        loop {
            let (n, l, c) = lexer:.next();
            let mut name = "";
            if n == Tokens::DQUOTE || n == Tokens::SQUOTE {
                let dmut result = copy StringStream();
                lexer:.setSkipTokens(false);
                {
                    loop {
                        let (s, _, _) = lexer:.next();
                        if s == n { break; }
                        if s == "" { throw self.unexpected(n, l, c); }
                        result:.write(s);
                    }
                } exit {
                    lexer:.setSkipTokens(true);
                }

                name = result[];
            } else if n != Tokens::COMMA && n != Tokens::SEMI_COLON && n != "" {
                // an unquoted family is a sequence of identifiers, "Noto Sans" being the same as Noto Sans
                name = n;
                let mut cursor = lexer.getCursor();
                loop {
                    let (w, _, _) = lexer:.next();
                    if w == Tokens::COMMA || w == Tokens::SEMI_COLON || w == "" { break; }
                    name = name ~ " " ~ w;
                    cursor = lexer.getCursor();
                }

                lexer:.rewind(expand cursor);
            } else {
                throw self.unexpected(n, l, c);
            }

            if name == "" { throw self.unexpected(n, l, c); }
            families ~= [name];

            let (sep, l2, c2) = lexer:.next();
            if sep == Tokens::SEMI_COLON { break; }
            if sep != Tokens::COMMA { throw self.unexpected(sep, l2, c2); }
        }

        families
    }

    /**
     * Read a font weight, a number from 1 to 1000, normal (400) or bold (700)
     * */
    fn readFontWeight(self, dmut lexer: &Lexer!{c8})-> u32
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);

        let (n, l, c) = lexer:.next();
        let weight = match n {
            Keywords::NORMAL => { FONT_WEIGHT_NORMAL }
            Keywords::BOLD   => { FONT_WEIGHT_BOLD }
            _ => {
                let w = {
                    std::conv::to!{u32} (n)
                } catch {
                    _ => { throw self.unexpected(n, l, c); }
                };

                if w < 1u32 || w > 1000u32 { throw self.unexpected(n, l, c); }
                w
            }
        };

        self.readTokens(alias lexer, Tokens::SEMI_COLON);
        weight
    }

    /**
     * Read a font style, normal, italic or oblique
     * */
    fn readFontStyle(self, dmut lexer: &Lexer!{c8})-> FontStyle
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);

        let (n, l, c) = lexer:.next();
        let style = match n {
            Keywords::NORMAL  => { FontStyle::NORMAL }
            Keywords::ITALIC  => { FontStyle::ITALIC }
            Keywords::OBLIQUE => { FontStyle::OBLIQUE }
            _ => { throw self.unexpected(n, l, c); }
        };

        self.readTokens(alias lexer, Tokens::SEMI_COLON);
        style
    }

    /**
     * Read a float
     * */
    fn if isFloating!{T} readFloat {T} (self, dmut lexer: &Lexer!{c8})-> T
        throws BalderError
    {
        let pix    = lexer:.next();
        let cursor = lexer.getCursor();

        let point = lexer:.next();

        let mut result = cast!{T} (0.0f);
        {
            if point._0 == Tokens::POINT {
                let end = lexer:.next();
                result = std::conv::to!{T} (pix._0 ~ "." ~ end._0);
            } else {
                lexer:.rewind(expand cursor);
                result = std::conv::to!{T} (pix._0);
            }
        } catch {
            _ => { throw self.unexpected(expand pix); }
        }

        result
    }

    /**
     * Read a int
     * */
    fn if isIntegral!{T} readInt {T} (self, dmut lexer: &Lexer!{c8})-> T
        throws BalderError
    {
        let pix = lexer:.next();

        let mut result = cast!{T} (0);
        {
            result = std::conv::to!{T} (pix._0);
        } catch {
            _ => { throw self.unexpected(expand pix); }
        }

        result
    }

    /**
     * Read a string
     * */
    fn readString(self, dmut lexer: &Lexer!{c8})-> [c8]
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);
        let beg = self.readTokens(alias lexer, Tokens::SQUOTE, Tokens::DQUOTE);

        let dmut result = copy StringStream();
        lexer:.setSkipTokens(false);
        {
            loop {
                let n = lexer:.next();
                if n._0 == beg._0 { break; }
                result:.write(n._0);
            }
        } exit {
            lexer:.setSkipTokens(true);
        }

        self.readTokens(alias lexer, Tokens::SEMI_COLON);

        result[]
    }

    /**
     * Read a bool keyword
     * */
    fn readBool(self, dmut lexer: &Lexer!{c8})-> bool
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);
        let (tok, _, _) = self.readTokens(alias lexer, Keywords::TRUE, Keywords::FALSE);
        self.readTokens(alias lexer, Tokens::SEMI_COLON);

        tok == Keywords::TRUE
    }

    /**
     * Read a widget size
     * */
    fn readSize(self, dmut lexer: &Lexer!{c8})-> WidgetSize
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);

        let pix = lexer:.next();
        if pix._0 == Tokens::LACC {
            return self.readComplexSize(alias lexer);
        }

        if let Ok(kind) = self.toSizeKind(pix._0) {
            self.readTokens(alias lexer, Tokens::SEMI_COLON);
            return WidgetSize(kind-> kind);
        }

        let mut size = {
            WidgetSize(pix-> std::conv::to!{u32} (pix._0))
        } catch {
            _ => {
                throw self.unexpected(expand pix);
            }
        };

        self.readTokens(alias lexer, Tokens::SEMI_COLON);

        size
    }

    /**
     * Read a complex size
     * */
    fn readComplexSize(self, dmut lexer: &Lexer!{c8})-> WidgetSize
        throws BalderError
    {
        let mut result = WidgetSize();
        loop {
            let (n, l, c) = lexer:.next();
            match n {
                Tokens::RACC => { break; }
                Keywords::RELATIVE => {
                    self.readTokens(alias lexer, Tokens::COLON);
                    result.relative = self.readFloat!{f32} (alias lexer);
                    self.readTokens(alias lexer, Tokens::SEMI_COLON);
                }
                Keywords::MIN => {
                    self.readTokens(alias lexer, Tokens::COLON);
                    result.minPix = self.readInt!{u32} (alias lexer);
                    self.readTokens(alias lexer, Tokens::SEMI_COLON);
                }
                Keywords::MAX => {
                    self.readTokens(alias lexer, Tokens::COLON);
                    result.maxPix = self.readInt!{u32} (alias lexer);
                    self.readTokens(alias lexer, Tokens::SEMI_COLON);
                }
                Keywords::FIT => {
                    self.readTokens(alias lexer, Tokens::COLON);
                    let (k, kl, kc) = lexer:.next();
                    if let Ok(kind) = self.toSizeKind(k) {
                        result.kind = kind;
                    } else {
                        throw self.unexpected(k, kl, kc);
                    }

                    self.readTokens(alias lexer, Tokens::SEMI_COLON);
                }
                _ => {
                    throw self.unexpected(n, l, c);
                }
            }
        }

        result
    }

    /**
     * @returns: the kind of a size computed from the content of the widget, 'auto', 'min-content' or 'max-content'
     * */
    fn toSizeKind(self, tok: [c8])-> (SizeKind)? {
        match tok {
            Keywords::AUTO        => { (SizeKind::AUTO)? }
            Keywords::MIN_CONTENT => { (SizeKind::MIN_CONTENT)? }
            Keywords::MAX_CONTENT => { (SizeKind::MAX_CONTENT)? }
            _                     => { none }
        }
    }

    /**
     * Read a flex factor, a positive float
     * */
    fn readFactor(self, dmut lexer: &Lexer!{c8})-> f32
        throws BalderError
    {
        self.readTokens(alias lexer, Tokens::COLON);
        let (_, l, c) = lexer.getCursor();
        let factor = self.readFloat!{f32} (alias lexer);
        if factor < 0.0f {
            throw self.unexpected(std::conv::to!{[c8]} (factor), l, c);
        }

        self.readTokens(alias lexer, Tokens::SEMI_COLON);
        factor
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CHECKING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read the next token in the lexer and check that it correspond to one of the expected tokens
     * */
    fn readTokens {T...} (self, dmut lexer: &Lexer!{c8}, expect: T)-> ([c8], usize, usize)
        throws BalderError
    {
        let n = lexer:.next();
        cte for j in expect {
            if n._0 == j { return n; }
        }

        throw self.unexpected(expand n);
    }

    /**
     * Read the next token in the lexer and check that it correspond to one of the expected tokens
     * */
    fn readTokens(self, dmut lexer: &Lexer!{c8}, expect: [c8])-> ([c8], usize, usize)
        throws BalderError
    {
        let n = lexer:.next();
        if expect == n._0 {
            return n;
        }

        throw self.unexpected(expand n);
    }

    /**
     * Throw an unexpected token exception
     * @params:
     *    - tok: the read token
     *    - line: the line of the reading
     *    - col: the column of the reading
     * */
    fn unexpected(self, tok: [c8], line: usize, col: usize)-> &BalderError {
        let msg = std::format::format("Unexpected '{}' at ({}:{})", tok, line, col);

        copy BalderError(msg)
    }

    /**
     * Verify that the name is a identifier
     * */
    fn verifyIdentifier(self, name: [c8], line: usize, col: usize)
        throws BalderError
    {
        if !self.isIdentifier(name) {
            let msg = std::format::format("Invalid identifier '{}' at ({}:{})", name, line, col);
            throw copy BalderError(msg);
        }
    }

    /**
     * @returns: true if name is an identifier
     * */
    fn isIdentifier(self, str: [c8])-> bool {
        let mut i     = 0u64;
        let mut found = false;
        for j in str { // must start by a letter, but can be preceded by as many _ as wanted
            if (j >= 'a' && j <= 'z') || (j >= 'A' && j <= 'Z') {
                found = true;
                break;
            } else if (j != '_' && j != '-') {
                return false;
            }
            i += 1u64;
        }

        i += 1u64;
        if (i < str.len) { // the rest of the identifier must be composed of letters, numbers, or _
            for j in str[cast!usize(i) .. $] {
                if (j < 'a' || j > 'z') && (j < 'A' || j > 'Z') && (j != '_') && (j < '0' || j > '9') && (j != '-') {
                    return false;
                }
            }
        } else {
            return found;
        }

        true
    }
}

/**
 * The rules of the styles read
 * */
mod StyleParser {

    /**
     * @returns: the rule of a style, its classes and its states being alternatives: a selector for each class and each
     * state, `PushButton :hover :check .a .b` selecting `PushButton.a:hover`, `PushButton.a:check`, `PushButton.b:hover`
     * and `PushButton.b:check`
     * @info: the states of the tabs of a TabLayout are written on the layout, `:hover ::tab` for the hovered tab and
     * `:focus ::tab` for the selected one: they are the states of the part, `::tab:hover` and `::tab:selected`
     * */
    pub fn rule(widget: [c8], classes: [[c8]], states: [[c8]], part: [c8], style: &Style, line: usize, col: usize)-> StyleRule {
        let any: [[c8]] = copy [""];
        let stateAlternatives = if states.len == 0us { any } else { states };
        let classAlternatives = if classes.len == 0us { any } else { classes };
        let mut selectors: [Selector] = [];
        for c in classAlternatives {
            for s in stateAlternatives {
                let tabState = widget == WidgetKeys::TAB_LAYOUT && part == "tab";
                let mut own: [[c8]] = [];
                let mut ofPart: [[c8]] = [];
                if s == "focus" && tabState {
                    ofPart = copy ["selected"];
                } else if s != "" && tabState {
                    ofPart = copy [s];
                } else if s != "" {
                    own = copy [s];
                }

                let mut tested: [[c8]] = [];
                if c != "" { tested = copy [c]; }

                let compound = Compound(combinator-> Combinator::NONE,
                                        typeName-> widget,
                                        id-> "",
                                        classes-> tested,
                                        states-> own,
                                        part-> part,
                                        partStates-> ofPart,
                                        line-> line,
                                        col-> col);

                selectors ~= [Selector(compounds-> copy [compound], source-> widget, line-> line, col-> col)];
            }
        }

        StyleRule(selectors-> selectors, style-> style, whens-> [], condition-> none, line-> line, col-> col)
    }
}
