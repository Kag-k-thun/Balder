in source;

/**
 * A .style file loaded by the widget manager, with the sheets of its last version that could be decoded
 * @info:
 * =====
 * The sheets of the files loaded are added again in the order the files were loaded when one of them changes, a file
 * that cannot be decoded any more keeping the sheets of its last good version.
 * ====
 * */
@data
pub record StyleSource {

    // The path of the file, qualified (res:/) or not
    pub let path: [c8];

    // Where the sheets of the file come from
    pub let origin: SheetOrigin;

    // The decoded sheets of the file and of those it imports, each one after those it imports
    pub let sheets: [StyleSheet];

    // The file and those it imports, in the order they were read
    pub let files: [[c8]];

    // True iif the file and those it imports are watched, to load them again when one of them changes
    pub let watched: bool;
}
