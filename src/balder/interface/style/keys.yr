in keys;

pub enum Tokens
| LACC       = "{"
| RACC       = "}"
| SEMI_COLON = ";"
| COMMA      = ","
| COLON      = ":"
| DCOLON     = "::"
| POINT      = "."
| SQUOTE     = "'"
| DQUOTE     = "\"";

pub enum Comments
| SINGLE_LINE    = ("//", "\n")
| MULTIPLE_LINES = ("/*", "*/");

