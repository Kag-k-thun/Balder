/**
 * The decoding of the values of the style properties, one function per kind of value (doc/gui-v2.md, §5), each throwing
 * an error that names the kind it expected
 * @info:
 * =====
 * Until the box model (BAL-64), the lengths and the sizes map onto WidgetSize: a percentage is relative to the parent,
 * a number is in pixels, and the bounds of a size are pixels only.
 * ====
 * */
in kinds;

use balder::interface::font::family;
use balder::interface::loader::parser;
use balder::interface::widget::alignement;
use balder::math::vector;

use std::syntax::errors;

/**
 * @returns: the channels of a colour: #rgb, #rgba, #rrggbb, #rrggbbaa, a named colour, transparent, rgb() or hsl(), then
 * an opacity
 * */
pub fn color(v: &Value)-> vec4
    throws SyntaxError
{
    Color(v).rgba
}

/**
 * @returns: the size of a width or a height: a length, auto, min-content or max-content
 * */
pub fn size(v: &Value)-> WidgetSize
    throws SyntaxError
{
    let s = Size(v);
    match s.sizing {
        Sizing::AUTO        => { return WidgetSize(kind-> SizeKind::AUTO); }
        Sizing::MIN_CONTENT => { return WidgetSize(kind-> SizeKind::MIN_CONTENT); }
        Sizing::MAX_CONTENT => { return WidgetSize(kind-> SizeKind::MAX_CONTENT); }
        _                   => {}
    }

    widgetSize(v, s.length)
}

/**
 * @returns: the tracks of a grid, one or more sizes or shares of the free space separated by spaces (1fr 2fr 120)
 * */
pub fn tracks(v: &Value)-> [Track]
    throws SyntaxError
{
    let mut result: [Track] = [];
    for item in v.toTuple() {
        result = result ~ [track(item)];
    }

    result
}

/**
 * @returns: a single track of a grid: a length, a share in fr, auto, min-content or max-content
 * */
pub fn track(v: &Value)-> Track
    throws SyntaxError
{
    let s = Size(v, track-> true);
    match s.sizing {
        Sizing::AUTO        => { return Track(TrackKind::AUTO, 0.0f); }
        Sizing::MIN_CONTENT => { return Track(TrackKind::MIN_CONTENT, 0.0f); }
        Sizing::MAX_CONTENT => { return Track(TrackKind::MAX_CONTENT, 0.0f); }
        _                   => {}
    }

    if s.length.amount < 0.0f {
        throw v.expected("a track of 0 or more");
    }

    match s.length.unit {
        Unit::PERCENT => { Track(TrackKind::PERCENT, s.length.amount) }
        Unit::FR      => { Track(TrackKind::SHARE, s.length.amount) }
        _             => { Track(TrackKind::PIXELS, s.length.amount) }
    }
}

/**
 * @returns: the size of a side of a margin or a padding: a length in px or in %
 * */
pub fn length(v: &Value)-> WidgetSize
    throws SyntaxError
{
    widgetSize(v, Length(v))
}

/**
 * @returns: a number of pixels, a length in px rounded to the closest pixel
 * */
pub fn pixels(v: &Value)-> u32
    throws SyntaxError
{
    let l = {
        Length(v)
    } catch {
        _: &SyntaxError => { throw v.expected("a length in px"); }
    };

    if l.unit != Unit::PX || l.amount < 0.0f {
        throw v.expected("a length in px");
    }

    cast!u32(l.amount + 0.5f)
}

/**
 * @returns: a factor, a number of 0 or more
 * */
pub fn factor(v: &Value)-> f32
    throws SyntaxError
{
    let n = {
        v.toNumber()
    } catch {
        _: &SyntaxError => { throw v.expected("a number of 0 or more"); }
    };

    if n < 0.0 {
        throw v.expected("a number of 0 or more");
    }

    cast!f32(n)
}

/**
 * @returns: the content of a string
 * */
pub fn text(v: &Value)-> [c8]
    throws SyntaxError
{
    v.toText()
}

/**
 * @returns: the boolean of the keyword true or false
 * */
pub fn boolean(v: &Value)-> bool
    throws SyntaxError
{
    v.toBool()
}

/**
 * @returns: true for the keyword wrap, false for nowrap
 * */
pub fn wrap(v: &Value)-> bool
    throws SyntaxError
{
    v.toKeyword(copy ["wrap", "nowrap"]) == "wrap"
}

/**
 * @returns: the horizontal alignment of the keyword left, center or right
 * */
pub fn xalign(v: &Value)-> XAlign
    throws SyntaxError
{
    match v.toKeyword(copy ["left", "center", "right"]) {
        "left"  => { XAlign::LEFT }
        "right" => { XAlign::RIGHT }
        _       => { XAlign::CENTER }
    }
}

/**
 * @returns: the vertical alignment of the keyword top, center or bottom
 * */
pub fn yalign(v: &Value)-> YAlign
    throws SyntaxError
{
    match v.toKeyword(copy ["top", "center", "bottom"]) {
        "top"    => { YAlign::TOP }
        "bottom" => { YAlign::BOTTOM }
        _        => { YAlign::CENTER }
    }
}

/**
 * @returns: the alignment of a popup against the widget opening it, a horizontal then a vertical alignment (left bottom)
 * */
pub fn popupAlign(v: &Value)-> (XAlign, YAlign)
    throws SyntaxError
{
    let items = v.toTuple();
    if items.len != 2us {
        throw v.expected("a horizontal and a vertical alignment");
    }

    (xalign(items[0]), yalign(items[1]))
}

/**
 * @returns: the direction of the keyword row or column
 * */
pub fn direction(v: &Value)-> Direction
    throws SyntaxError
{
    if v.toKeyword(copy ["row", "column"]) == "row" { Direction::ROW } else { Direction::COLUMN }
}

/**
 * @returns: the overflow of the keyword hidden or scroll
 * */
pub fn overflow(v: &Value)-> Overflow
    throws SyntaxError
{
    if v.toKeyword(copy ["hidden", "scroll"]) == "scroll" { Overflow::SCROLL } else { Overflow::HIDDEN }
}

/**
 * @returns: the style of the keyword normal, italic or oblique
 * */
pub fn fontStyle(v: &Value)-> FontStyle
    throws SyntaxError
{
    match v.toKeyword(copy ["normal", "italic", "oblique"]) {
        "italic"  => { FontStyle::ITALIC }
        "oblique" => { FontStyle::OBLIQUE }
        _         => { FontStyle::NORMAL }
    }
}

/**
 * @returns: the weight of the keyword normal (400) or bold (700), or of an integer from 1 to 1000
 * */
pub fn fontWeight(v: &Value)-> u32
    throws SyntaxError
{
    let what = "a font weight, normal, bold or from 1 to 1000";
    if let Name(name-> n) = v {
        match n {
            "normal" => { return FONT_WEIGHT_NORMAL; }
            "bold"   => { return FONT_WEIGHT_BOLD; }
            _        => { throw v.expected(what); }
        }
    }

    let w = {
        v.toInteger()
    } catch {
        _: &SyntaxError => { throw v.expected(what); }
    };

    if w < 1i64 || w > 1000i64 {
        throw v.expected(what);
    }

    cast!u32(w)
}

/**
 * @returns: the families of a list separated by commas, a family being quoted ("Noto Sans") or not (sans-serif, Noto
 * Sans)
 * */
pub fn families(v: &Value)-> [[c8]]
    throws SyntaxError
{
    let mut result: [[c8]] = [];
    for item in v.toList() {
        result = result ~ [family(item)];
    }

    result
}

/**
 * @returns: a single family, quoted or not
 * */
pub fn family(v: &Value)-> [c8]
    throws SyntaxError
{
    match v {
        Text(text-> t) => { return t; }
        Name(name-> n) => { return n; }
        Tuple(items-> items) => {
            let mut words = "";
            for i, item in items {
                if let Name(name-> n) = item {
                    words = if i == 0us { n } else { words ~ " " ~ n };
                } else {
                    throw v.expected("a font family");
                }
            }

            return words;
        }
        _ => {}
    }

    throw v.expected("a font family");
}

/**
 * @returns: the size of a length, a part of the parent for a percentage, a number of pixels otherwise
 * @params:
 *    - v: the value of the length, for the error
 * */
fn widgetSize(v: &Value, l: Length)-> WidgetSize
    throws SyntaxError
{
    if l.amount < 0.0f {
        throw v.expected("a length of 0 or more");
    }

    if l.unit == Unit::PERCENT {
        return WidgetSize(relative-> l.amount / 100.0f);
    }

    WidgetSize(pix-> cast!u32(l.amount + 0.5f))
}
