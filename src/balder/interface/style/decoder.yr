in decoder;

use balder::core::error;
use balder::interface::font::{family, registry};
use balder::interface::loader::parser;
use balder::interface::loader::registry;
use balder::interface::loader::registry::{error, schema};
use balder::interface::style::{conditions, implem, kinds, manager, table};

use std::syntax::errors;

/**
 * The declarations of a rule that apply while a condition holds, decoded into a style
 * */
@data
pub record StyleWhen {

    // The condition
    pub let condition: &Condition;

    // The style of the declarations applied while it holds
    pub let style: &Style;

    // The line of the directive, from 1
    pub let line: usize;

    // The column of the directive, from 1
    pub let col: usize;
}

/**
 * A rule of a style sheet, its declarations decoded into a style
 * */
@data
pub record StyleRule {

    // The selectors sharing the block
    pub let selectors: [Selector];

    // The style of the declarations of the block, a later declaration overriding the longhands an earlier one set
    pub let style: &Style;

    // The @when blocks of the rule, coming after its own declarations in the cascade
    pub let whens: [StyleWhen];

    // The condition of the top level @when holding the rule, none when the rule always applies
    pub let condition: (&Condition)?;

    // The line of the first selector, from 1
    pub let line: usize;

    // The column of the first selector, from 1
    pub let col: usize;
}

/**
 * The rules and the font faces of a style sheet, decoded
 * */
@data
pub record StyleSheet {

    // The @font-face blocks
    pub let fontFaces: [FontFaceRule];

    // The rules, in the order of the file
    pub let rules: [StyleRule];

    /**
     * Register the font files of the @font-face blocks in their families
     * @throws: when a file cannot be read
     * */
    pub fn registerFonts(self, dmut fonts: &FontRegistry)
        throws BalderError
    {
        for face in self.fontFaces {
            fonts:.registerFile(face.src, family-> face.family, weight-> face.weight, style-> face.style);
        }
    }
}

/**
 * Decoder of the declarations of a style sheet into styles (doc/gui-v2.md, §2 and §5)
 * @info:
 * =====
 * A declaration names a common property (PropertyTable), or a property registered by the widget type its rule selects,
 * by any type when the selector names none. Its value is decoded into the longhands it sets, in the order of the
 * declarations, so `padding: 6; padding-left: 20;` sets a padding of 6 with a left side of 20. An unknown property, or a
 * value of the wrong kind, is an error naming the file, the line, the property and the kind expected.
 *
 * The selectors are checked against the widget types: a type, a state, a part or a state of a part none of the types
 * they can select registers is an error, as a part anywhere but at the end of a selector. A rule testing a state cannot
 * set a property that affects the layout: hovering a widget must not move it.
 *
 * The conditions of the @when blocks read width, height, the variables of the window or those of the application
 * (app.name), any other being an error. A variable is compared to a number in px or without unit, a keyword or a string;
 * '<', '<=', '>' and '>=' compare numbers only, and the variables of the layout and of the window are numbers.
 * ====
 * */
pub record SheetDecoder {

    // The common properties
    let _table: &PropertyTable;

    // The widget types, for the properties they register
    let _registry: &WidgetRegistry;

    // The path of the file the sheet was read from, for the errors
    let _file: [c8];

    /**
     * @params:
     *    - registry: the widget types, for the properties they register
     *    - file: the path of the file the sheet was read from, for the errors
     * */
    pub self (registry: &WidgetRegistry, file: [c8])
        with _table = copy PropertyTable()
        , _registry = registry
        , _file = file
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DECODING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Decode the rules and the font faces of a sheet, its imports being left to its loader
     * @throws: at the first declaration refused
     * */
    pub fn decode(self, sheet: Sheet)-> StyleSheet
        throws LoadError
    {
        let mut fontFaces: [FontFaceRule] = [];
        for face in sheet.fontFaces {
            fontFaces = fontFaces ~ [self.decodeFontFace(face)];
        }

        let mut rules: [StyleRule] = [];
        for rule in sheet.rules {
            rules = rules ~ [self.decodeRule(rule)];
        }

        StyleSheet(fontFaces-> fontFaces, rules-> rules)
    }

    /**
     * Decode the declarations of a rule, and those of its @when blocks
     * */
    pub fn decodeRule(self, rule: Rule)-> StyleRule
        throws LoadError
    {
        for sel in rule.selectors {
            self.checkSelector(sel);
        }

        if let Ok(c) = rule.condition {
            self.checkCondition(c);
        }

        let mut whens: [StyleWhen] = [];
        for w in rule.whens {
            self.checkCondition(w.condition);
            whens = whens ~ [StyleWhen(condition-> w.condition,
                                       style-> self.decodeStyle(w.declarations, rule.selectors),
                                       line-> w.line,
                                       col-> w.col)];
        }

        StyleRule(selectors-> rule.selectors,
                  style-> self.decodeStyle(rule.declarations, rule.selectors),
                  whens-> whens,
                  condition-> rule.condition,
                  line-> rule.line,
                  col-> rule.col)
    }

    /**
     * Decode declarations into a style
     * @params:
     *    - selectors: the selectors of their rule, whose widget types tell the properties they register
     * */
    pub fn decodeStyle(self, declarations: [Declaration], selectors: [Selector])-> dmut &Style
        throws LoadError
    {
        let dmut style = copy Style();
        let stateful = SheetDecoder::testsAState(selectors);
        for d in declarations {
            let p = if let Ok(p) = self.property(d.name, selectors) {
                p
            } else {
                throw copy LoadError(self._file, "unknown property '" ~ d.name ~ "'", d.line, d.col);
            };

            if stateful && p.affectsLayout {
                throw copy LoadError(self._file, "property '" ~ d.name ~ "' affects the layout, which a rule testing a state cannot change",
                                     d.line, d.col);
            }

            {
                p.apply(alias style, d.value);
            } catch {
                e: &SyntaxError => { throw self.refused(d, e); }
            }
        }

        alias style
    }

    /**
     * Decode a @font-face block: its font-family and its src, and optionally the font-weight and the font-style of its
     * faces, read from the file when they are not set
     * */
    pub fn decodeFontFace(self, face: parser::FontFace)-> FontFaceRule
        throws LoadError
    {
        let mut family = "", mut src = "";
        let mut weight: (u32)? = none;
        let mut style: (FontStyle)? = none;
        for d in face.declarations {
            {
                match d.name {
                    "font-family" => {
                        let names = families(d.value);
                        if names.len != 1us {
                            throw d.value.expected("a single font family");
                        }

                        family = names[0];
                    }
                    "src"         => { src = kinds::text(d.value); }
                    "font-weight" => {
                        let w = fontWeight(d.value);
                        weight = (w)?;
                    }
                    "font-style" => {
                        let f = fontStyle(d.value);
                        style = (f)?;
                    }
                    _ => {
                        throw copy LoadError(self._file, "unknown property '" ~ d.name ~ "' in a @font-face", d.line, d.col);
                    }
                }
            } catch {
                e: &SyntaxError => { throw self.refused(d, e); }
                e: &LoadError   => { throw e; }
            }
        }

        if family == "" || src == "" {
            throw copy LoadError(self._file, "a @font-face needs a font-family and a src", face.line, face.col);
        }

        FontFaceRule(family, src, weight, style)
    }

    /**
     * @returns: the property named name, common or registered by the widget type a selector names, none if it is
     * neither
     * */
    pub fn property(self, name: [c8], selectors: [Selector])-> (&Property)? {
        if let Ok(p) = self._table.get(name) {
            return (p)?;
        }

        for s in selectors {
            if s.compounds.len != 0us {
                if let Ok(p) = self._registry.property(s.compounds[s.compounds.len - 1us].typeName, name) {
                    return (p)?;
                }
            }
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SELECTORS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check that the types, the states, the parts and the states of the parts of a selector are registered by the
     * widget types its compounds can select, and that a part ends it
     * */
    pub fn checkSelector(self, sel: Selector)
        throws LoadError
    {
        for i, c in sel.compounds {
            let schemas = self._registry.selectable(c.typeName);
            if schemas.len == 0us {
                throw copy LoadError(self._file, "unknown widget type '" ~ c.typeName ~ "'", c.line, c.col);
            }

            for state in c.states {
                if !SheetDecoder::anyHasState(schemas, state) {
                    throw self.unknown("state ':" ~ state ~ "'", c);
                }
            }

            if c.part != "" {
                if i != sel.compounds.len - 1us {
                    throw copy LoadError(self._file, "a part ends its selector, found '::" ~ c.part ~ "' before a combinator",
                                         c.line, c.col);
                }

                if !SheetDecoder::anyHasPart(schemas, c.part) {
                    throw self.unknown("part '::" ~ c.part ~ "'", c);
                }

                for state in c.partStates {
                    if !SheetDecoder::anyHasPartState(schemas, c.part, state) {
                        throw self.unknown("state ':" ~ state ~ "' of the part '::" ~ c.part ~ "'", c);
                    }
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CONDITIONS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check that the tests of a condition read known variables, and compare them to values of their kind
     * */
    pub fn checkCondition(self, c: &Condition)
        throws LoadError
    {
        if let t: &Test = c {
            self.checkTest(t);
        } else if let n: &Not = c {
            self.checkCondition(n.operand);
        } else if let a: &And = c {
            for o in a.operands { self.checkCondition(o); }
        } else if let o: &Or = c {
            for x in o.operands { self.checkCondition(x); }
        }
    }

    /**
     * Check that a test reads a known variable, and compares it to a value of its kind
     * */
    fn checkTest(self, t: &Test)
        throws LoadError
    {
        if !isKnown(t.variable) {
            throw copy LoadError(self._file, "unknown variable '" ~ t.variable ~ "'", t.line, t.col);
        }

        let value = if let Ok(v) = t.value { v } else { return; };
        let isNumber = if let Number(unit-> u) = value {
            if u != "" && u != "px" {
                throw self.refused(value, "a number, or a length in px");
            }

            true
        } else {
            match value {
                Name() => {}
                Text() => {}
                _      => { throw self.refused(value, "a number, a length in px, a keyword or a string"); }
            }

            false
        };

        if isNumber { return; }
        if t.comparison != Comparison::EQ && t.comparison != Comparison::NE {
            throw self.refused(value, "a number to order");
        }

        if isNumeric(t.variable) {
            throw self.refused(value, "a number, '" ~ t.variable ~ "' being one");
        }
    }

    /**
     * @returns: the error of a state or a part a compound tests, which none of the types it can select registers
     * @params:
     *    - what: what is tested, with its kind ("state ':hover'")
     * */
    fn unknown(self, what: [c8], c: Compound)-> &LoadError {
        if c.typeName != "" {
            return copy LoadError(self._file, "unknown " ~ what ~ " of '" ~ c.typeName ~ "'", c.line, c.col);
        }

        copy LoadError(self._file, "unknown " ~ what, c.line, c.col)
    }

    /**
     * @returns: the error of a value compared in a condition that is not of the kind expected, located at the value
     * */
    fn refused(self, value: &Value, what: [c8])-> &LoadError {
        let e = value.expected(what);
        copy LoadError(self._file, e.msg, e.line, e.col)
    }

    /**
     * @returns: the error of a declaration whose value was refused, located at the value
     * */
    fn refused(self, d: Declaration, e: &SyntaxError)-> &LoadError {
        copy LoadError(self._file, "property '" ~ d.name ~ "': " ~ e.msg, e.line, e.col)
    }
}

/**
 * The helpers of the decoder
 * */
mod SheetDecoder {

    /**
     * @returns: true iif one of the selectors tests a state, of a widget or of a part
     * */
    pub fn testsAState(selectors: [Selector])-> bool {
        for sel in selectors {
            for c in sel.compounds {
                if c.states.len != 0us || c.partStates.len != 0us { return true; }
            }
        }

        false
    }

    /**
     * @returns: true iif one of the schemas registers the state
     * */
    pub fn anyHasState(schemas: [&WidgetSchema], state: [c8])-> bool {
        for s in schemas {
            for st in s.states {
                if st == state { return true; }
            }
        }

        false
    }

    /**
     * @returns: true iif one of the schemas registers the part
     * */
    pub fn anyHasPart(schemas: [&WidgetSchema], part: [c8])-> bool {
        for s in schemas {
            for p in s.parts {
                if p == part { return true; }
            }
        }

        false
    }

    /**
     * @returns: true iif one of the schemas registers the part with the state
     * */
    pub fn anyHasPartState(schemas: [&WidgetSchema], part: [c8], state: [c8])-> bool {
        for s in schemas {
            for st in s.statesOf(part) {
                if st == state { return true; }
            }
        }

        false
    }
}
