in table;

use balder::interface::font::family;
use balder::interface::style::{kinds, property};
use balder::interface::widget::alignement;
use balder::math::vector;

/**
 * The properties every widget reads, by name: their kind of value, the field of a Style they set, and whether they are
 * inherited and affect the layout
 * @info:
 * =====
 * | Property | Kind | Inherited | Layout |
 * |---|---|---|---|
 * | color, background-color, border-color, selection-color, image-color | colour | | |
 * | text-color | colour | yes | |
 * | font-family | list of families | yes | yes |
 * | font-size | length in px | yes | yes |
 * | font-weight | normal, bold, 1 to 1000 | yes | yes |
 * | font-style | normal, italic, oblique | yes | yes |
 * | text-xalign, text-yalign | left/top, center, right/bottom | yes | |
 * | text-wrap | wrap, nowrap | yes | yes |
 * | radius | length in px | | |
 * | image | string | | |
 * | image-fill, image-keep-ratio | boolean | | |
 * | border-width | length in px | | yes |
 * | margin-top, -right, -bottom, -left, padding-… | length | | yes |
 * | width, height | size | | yes |
 * | min-width, max-width, min-height, max-height | length in px | | yes |
 * | left, top | length | | yes |
 * | flex-grow, flex-shrink | number of 0 or more | | yes |
 * | flex-basis | size | | yes |
 *
 * The shorthands set their longhands: `margin` and `padding` (1 to 4 lengths, in the CSS order), `border` (a width
 * and a colour) and `flex` (1, none, auto, or grow shrink basis).
 * ====
 * */
@final
pub class PropertyTable {

    let mut _properties: [[c8] => mut &Property] = copy [];

    // The properties, the longhands then the shorthands setting them
    let mut _ordered: [&Property] = [];

    /**
     * Create the table of the common properties
     * */
    pub self () {
        self._ordered = PropertyTable::common();
        for p in self._ordered {
            self._properties[p.name] = p;
        }
    }

    /**
     * @returns: the property named name, none if it is not a common property
     * */
    pub fn get(self, name: [c8])-> (&Property)? {
        if let Ok(p) = self._properties[name] {
            return (p)?;
        }

        none
    }

    /**
     * @returns: the common properties, the longhands then the shorthands setting them, in the order of the table
     * */
    pub fn all(self)-> [&Property] {
        self._ordered
    }
}

/**
 * The building of the table
 * */
mod PropertyTable {

    /**
     * @returns: the common properties, the longhands then the shorthands setting them
     * */
    pub fn common()-> [&Property] {
        colors() ~ fonts() ~ texts() ~ images() ~ borders() ~ boxes() ~ sizes() ~ positions() ~ flex()
    }

    /**
     * @returns: the colours
     * */
    fn colors()-> [&Property] {
        copy [copy Longhand!{vec4}("color", Kind::COLOR, &?color, |dmut s, c| => { s.color = (true, c); }),
              copy Longhand!{vec4}("background-color", Kind::COLOR, &?color,
                                   |dmut s, c| => { s.backgroundColor = (true, c); }),
              copy Longhand!{vec4}("selection-color", Kind::COLOR, &?color,
                                   |dmut s, c| => { s.selectionColor = (true, c); }),
              copy Longhand!{vec4}("text-color", Kind::COLOR, &?color, |dmut s, c| => { s.textColor = (true, c); },
                                   inherited-> true)]
    }

    /**
     * @returns: the font of the texts
     * */
    fn fonts()-> [&Property] {
        copy [copy Longhand!{[[c8]]}("font-family", Kind::FAMILIES, &?families,
                                     |dmut s, f| => { s.fontFamily = (true, f); },
                                     inherited-> true, affectsLayout-> true),
              copy Longhand!{u32}("font-size", Kind::PIXELS, &?pixels, |dmut s, n| => { s.fontSize = (true, n); },
                                  inherited-> true, affectsLayout-> true),
              copy Longhand!{u32}("font-weight", Kind::FONT_WEIGHT, &?fontWeight,
                                  |dmut s, w| => { s.fontWeight = (true, w); },
                                  inherited-> true, affectsLayout-> true),
              copy Longhand!{FontStyle}("font-style", Kind::FONT_STYLE, &?fontStyle,
                                        |dmut s, f| => { s.fontStyle = (true, f); },
                                        inherited-> true, affectsLayout-> true)]
    }

    /**
     * @returns: the alignment and the wrapping of the texts
     * */
    fn texts()-> [&Property] {
        copy [copy Longhand!{XAlign}("text-xalign", Kind::XALIGN, &?xalign, |dmut s, a| => { s.xalign = (true, a); },
                                     inherited-> true),
              copy Longhand!{YAlign}("text-yalign", Kind::YALIGN, &?yalign, |dmut s, a| => { s.yalign = (true, a); },
                                     inherited-> true),
              copy Longhand!{bool}("text-wrap", Kind::WRAP, &?wrap, |dmut s, w| => { s.textWrap = (true, w); },
                                   inherited-> true, affectsLayout-> true)]
    }

    /**
     * @returns: the background image
     * */
    fn images()-> [&Property] {
        copy [copy Longhand!{[c8]}("image", Kind::TEXT, &?kinds::text,
                                   |dmut s, t| => { s.backgroundImage = (true, t); }),
              copy Longhand!{vec4}("image-color", Kind::COLOR, &?color, |dmut s, c| => { s.imageColor = (true, c); }),
              copy Longhand!{bool}("image-fill", Kind::BOOLEAN, &?boolean,
                                   |dmut s, b| => { s.backgroundImageFill = (true, b); }),
              copy Longhand!{bool}("image-keep-ratio", Kind::BOOLEAN, &?boolean,
                                   |dmut s, b| => { s.backgroundImageKeepRatio = (true, b); })]
    }

    /**
     * @returns: the border, its corners, and its shorthand
     * */
    fn borders()-> [&Property] {
        let width = copy Longhand!{u32}("border-width", Kind::PIXELS, &?pixels,
                                        |dmut s, n| => { s.borderWidth = (true, n); },
                                        affectsLayout-> true);
        let color = copy Longhand!{vec4}("border-color", Kind::COLOR, &?color,
                                         |dmut s, c| => { s.borderColor = (true, c); });

        copy [width, color,
              copy Longhand!{u32}("radius", Kind::PIXELS, &?pixels, |dmut s, n| => { s.radius = (true, n); }),
              copy Shorthand("border", Kind::BORDER, copy [width, color], &?Shorthand::border)]
    }

    /**
     * @returns: the margins and the paddings, each side and their shorthand
     * */
    fn boxes()-> [&Property] {
        let marginTop = copy Longhand!{WidgetSize}("margin-top", Kind::LENGTH, &?length,
                                                   |dmut s, l| => { s.marginTop = (true, l); },
                                                   affectsLayout-> true);
        let marginRight = copy Longhand!{WidgetSize}("margin-right", Kind::LENGTH, &?length,
                                                     |dmut s, l| => { s.marginRight = (true, l); },
                                                     affectsLayout-> true);
        let marginBottom = copy Longhand!{WidgetSize}("margin-bottom", Kind::LENGTH, &?length,
                                                      |dmut s, l| => { s.marginBottom = (true, l); },
                                                      affectsLayout-> true);
        let marginLeft = copy Longhand!{WidgetSize}("margin-left", Kind::LENGTH, &?length,
                                                    |dmut s, l| => { s.marginLeft = (true, l); },
                                                    affectsLayout-> true);

        let paddingTop = copy Longhand!{WidgetSize}("padding-top", Kind::LENGTH, &?length,
                                                    |dmut s, l| => { s.paddingTop = (true, l); },
                                                    affectsLayout-> true);
        let paddingRight = copy Longhand!{WidgetSize}("padding-right", Kind::LENGTH, &?length,
                                                      |dmut s, l| => { s.paddingRight = (true, l); },
                                                      affectsLayout-> true);
        let paddingBottom = copy Longhand!{WidgetSize}("padding-bottom", Kind::LENGTH, &?length,
                                                       |dmut s, l| => { s.paddingBottom = (true, l); },
                                                       affectsLayout-> true);
        let paddingLeft = copy Longhand!{WidgetSize}("padding-left", Kind::LENGTH, &?length,
                                                     |dmut s, l| => { s.paddingLeft = (true, l); },
                                                     affectsLayout-> true);

        copy [marginTop, marginRight, marginBottom, marginLeft,
              copy Shorthand("margin", Kind::SIDES, copy [marginTop, marginRight, marginBottom, marginLeft],
                             &?Shorthand::sides),
              paddingTop, paddingRight, paddingBottom, paddingLeft,
              copy Shorthand("padding", Kind::SIDES, copy [paddingTop, paddingRight, paddingBottom, paddingLeft],
                             &?Shorthand::sides)]
    }

    /**
     * @returns: the sizes and their bounds
     * */
    fn sizes()-> [&Property] {
        copy [copy Longhand!{WidgetSize}("width", Kind::SIZE, &?size, |dmut s, w| => { s.width = (true, w); },
                                         affectsLayout-> true),
              copy Longhand!{WidgetSize}("height", Kind::SIZE, &?size, |dmut s, h| => { s.height = (true, h); },
                                         affectsLayout-> true),
              copy Longhand!{u32}("min-width", Kind::PIXELS, &?pixels, |dmut s, n| => { s.minWidth = (true, n); },
                                  affectsLayout-> true),
              copy Longhand!{u32}("max-width", Kind::PIXELS, &?pixels, |dmut s, n| => { s.maxWidth = (true, n); },
                                  affectsLayout-> true),
              copy Longhand!{u32}("min-height", Kind::PIXELS, &?pixels, |dmut s, n| => { s.minHeight = (true, n); },
                                  affectsLayout-> true),
              copy Longhand!{u32}("max-height", Kind::PIXELS, &?pixels, |dmut s, n| => { s.maxHeight = (true, n); },
                                  affectsLayout-> true)]
    }

    /**
     * @returns: the position of a widget in a floating layout
     * */
    fn positions()-> [&Property] {
        copy [copy Longhand!{WidgetSize}("left", Kind::LENGTH, &?length, |dmut s, l| => { s.left = (true, l); },
                                         affectsLayout-> true),
              copy Longhand!{WidgetSize}("top", Kind::LENGTH, &?length, |dmut s, l| => { s.top = (true, l); },
                                         affectsLayout-> true)]
    }

    /**
     * @returns: the sizing of a widget in a linear layout, and its shorthand
     * */
    fn flex()-> [&Property] {
        let grow = copy Longhand!{f32}("flex-grow", Kind::FACTOR, &?factor, |dmut s, f| => { s.flexGrow = (true, f); },
                                       affectsLayout-> true);
        let shrink = copy Longhand!{f32}("flex-shrink", Kind::FACTOR, &?factor,
                                         |dmut s, f| => { s.flexShrink = (true, f); },
                                         affectsLayout-> true);
        let basis = copy Longhand!{WidgetSize}("flex-basis", Kind::SIZE, &?size,
                                               |dmut s, b| => { s.flexBasis = (true, b); },
                                               affectsLayout-> true);

        copy [grow, shrink, basis, copy Shorthand("flex", Kind::FLEX, copy [grow, shrink, basis], &?Shorthand::flex)]
    }
}
