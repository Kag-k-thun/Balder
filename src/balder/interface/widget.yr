in widget;

use balder::utils;
use balder::core::{application::_, dispose};
use balder::core::shader::texture;
use balder::interface::_;
use balder::interface::font::{chain, layout};
use balder::interface::loader::parser;
use balder::interface::shape;
use balder::interface::shape::text;
use balder::interface::style::conditions;
use balder::interface::widget::sizing;
use balder::interface::widget::layout::{flex, menu};
use balder::math::vector;

pub mod ::layout;
pub mod ::box;
pub mod ::graph;
pub mod ::text;
pub mod ::button;
pub mod ::alignement;
pub mod ::sizing;

use std::{io, time::_, algorithm::comparison, fs::path};

// The size of a container that is not known yet, when a parent measures its content: a percentage of it is auto for
// a size, and 0 for a margin or a padding
pub def INDEFINITE_SIZE = -1.0f;

pub enum WidgetShapeKind: u8
| BACKGROUND = 1
| BORDER     = 2
| TEXT       = 3
| SELECTION  = 4
| IMAGE      = 5;

pub class WidgetShape {
    pub let dmut shape : (&Shape)? = none;
    pub self () {}
}

@abstract
pub class Widget {

    // The id of the widget, after the '#' in a .gui file, "" for an anonymous widget
    pub let id : [c8];

    // The type of the widget, the name it is written with in a .gui file and selected with in a style sheet
    pub let typeName : [c8];

    // The widget containing this one, set when it is attached
    let mut _parent : (&Widget)? = none;

    // The manager of the widget
    let dmut _manager : &WidgetManager;

    // The menu context of the widget (set to open/close menu item)
    let dmut _menuContext : (&MenuLayout)? = none;


    prot { // widget sizes, 4 boxes: the margin box the widget is placed in, its border, padding and content boxes

        // The size of the content box of the parent, the percentages of the margins and the paddings being parts of it
        let mut _containerSize : vec2 = vec2 ();

        // The inner size
        let mut _absolutePosition : vec2 = vec2 ();
        let mut _absoluteSize : vec2 = vec2 ();

        // The size inside borders
        let mut _absolutePostBorderPosition : vec2 = vec2 ();
        let mut _absolutePostBorderSize : vec2 = vec2 ();

        // The size inside margins
        let mut _absolutePostMarginPosition : vec2 = vec2 ();
        let mut _absolutePostMarginSize : vec2 = vec2 ();

        // The outer size
        let mut _absoluteFullSize : vec2 = vec2 ();
        let mut _absoluteFullPosition : vec2 = vec2 ();

    }

    prot { // scissors defines the size of parent widget to avoid displaying shapes outside the correct bounding box
        let mut _scissorPos : vec2 = vec2 ();
        let mut _scissorSize : vec2 = vec2 ();
    }

    // The depth of the widget (for the rendering order)
    let mut _depth : u32 = 0;

    // The shapes of the widgets
    let dmut _shapes : [u8 => &Shape] = copy [];

    prot { // background image
        let dmut _backgroundTexture : &RefCount!{&Texture};
        let mut _backgroundTextureSize : uvec2 = uvec2 ();
        let mut _currentBackImage : [c8] = "";

        let mut _currentBackColor : vec4 = vec4 ();
        let mut _currentBorderColor : vec4 = vec4 ();

        let mut _hasBackground : bool = true;
        let mut _hasBorder : bool = true;
    }

    // True iif attached to a window
    let mut _attached : bool = false;

    prot { // The list of styles of the widget

        // The classes of the widget, in the order of the file
        let mut _classes : [[c8]] = [];

        // The current style of the widget
        let mut _currentStyle : &Style = copy Style ();

        // The style set by code on the widget, applied over the rules of the sheets
        let mut _inlineStyle : &Style = copy Style ();

        // True iif the widget is hidden by code (and does not receive events), whatever its style says
        let mut _hidden : bool = false;

        // True iif the style of the widget displays it, as it was last applied to its shapes and its children
        let mut _displayed : bool = true;

        // The variables read by the conditions of the rules matching the widget, its style being computed again when
        // one of them changes
        let mut _reads : [[c8]] = [];

        // The space available to the widget when its style was last computed, read by the conditions as width and
        // height
        let mut _available : vec2 = vec2 ();

    }

    prv { // states

        // The states the widget is in, as the style sheets select them (:hover), among those its type registers
        let mut _states : [[c8]] = [];

        // The part of its parent the widget draws, styled by the parent, "" for a widget styled by the sheets
        let mut _ownerPart : [c8] = "";
    }


    prot { // signals
        let dmut _clicked : (&Signal!{u8})? = none;
        let dmut _focused : (&Signal!{()})? = none;
        let dmut _unfocused : (&Signal!{()})? = none;
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot self (dmut manager : &WidgetManager,
               id : [c8],
               typeName : [c8])

        with _manager = alias manager
        , id = id
        , typeName = typeName
        , _backgroundTexture = manager:.getWindow ():.emptyResource!{&Texture2D} ()
    {}

    __dtor (mut self) {
        self:.dispose ()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register a shape to be drawn by the widget when displayed
     * */
    @{final}
    prot fn registerColorShape (mut self, c : WidgetShapeKind) {
        let dmut shDr = self._manager:.getShapeDrawer ();

        {
            if let Ok (dmut old) = alias self._shapes [c] {
                shDr:.removeShape (old.uid);
            }
            
            let dmut shape = shDr:.registerColorQuad (color-> self._currentStyle.getColor (c), level-> self._depth);
            self._shapes [c] = alias shape;
            if !self.isDrawn () { shape:.hide (); }
        } catch {
            _ => {
                log::error #("Widget", "Failed to create color shape : ", c);
            }
        }
    }

    /**
     * Register a shape to be drawn by the widget when displayed
     * */
    @{final}
    prot fn registerTextureShape (mut self, c : WidgetShapeKind, dmut texture : &RefCount!{&Texture}) {
        let dmut shDr = self._manager:.getShapeDrawer ();

        {
            if let Ok (dmut old) = alias self._shapes [c] {
                shDr:.removeShape (old.uid);
            }
            
            let dmut shape = shDr:.registerTextureQuad (texture-> alias texture, level-> self._depth);
            self._shapes [c] = alias shape;
            if !self.isDrawn () { shape:.hide (); }
        } catch {
            err => {
                log::error #("Widget", "Failed to create texture shape : ", c, " => ", err);
            }
        }
    }

    /**
     * Register a text to be drawn by the widget when displayed, replacing the glyphs of the text shape already registered
     * @params:
     *    - chain: the faces the text was shaped with
     *    - text: the lines of the text, laid out in device pixels
     * */
    @{final}
    prot fn registerTextShape (mut self, c : WidgetShapeKind, dmut chain : &FontChain, text : TextLayout) {
        let dmut shDr = self._manager:.getShapeDrawer ();

        {
            if let Ok (dmut old) = alias self._shapes [c] {
                if let dmut shape : &TextShape = alias old {
                    shape:.setText (alias chain, text, shDr.getPixelRatio ());
                    return;
                }

                shDr:.removeShape (old.uid);
            }

            let dmut shape = shDr:.registerText (alias chain, text, level-> self._depth);
            self._shapes [c] = alias shape;
            if !self.isDrawn () { shape:.hide (); }
        } catch {
            err => {
                log::error #("Widget", "Failed to create text shape : ", c, " => ", err);
            }
        }
    }

    /**
     * Register a shape to be drawn by the widget when displayed
     * */
    @{final}
    prot fn removeShape (mut self, c : WidgetShapeKind) {
        let dmut shDr = self._manager:.getShapeDrawer ();
        if let Ok (dmut old) = alias self._shapes [c] {
            shDr:.removeShape (old.uid);
            self._shapes:.remove (c);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SETS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the depth of the widget tree
     * */
    pub fn getMaxDepth (self)-> u32 {
        self._depth
    }

    /**
     * @returns: the absolute position of the widget (in pixels)
     * */
    pub fn getAbsolutePosition (self)-> vec2 {
        self._absoluteFullPosition
    }

    /**
     * @returns: the absolute size of the widget (in pixels)
     * */
    pub fn getAbsoluteSize (self)-> vec2 {
        self._absoluteFullSize
    }

    /**
     * @returns: the absolute inner position of the widget (in pixels) after margin, border, padding
     * */
    pub fn getAbsoluteInnerPosition (self)-> vec2 {
        self._absolutePosition
    }

    /**
     * @returns: the absolute inner size of the widget (in pixels) after margin, border, padding
     * */
    pub fn getAbsoluteInnerSize (self)-> vec2 {
        self._absoluteSize
    }

    /**
     * @returns: the current style applied to the widget
     * */
    pub fn getStyle (self)-> &Style {
        self._currentStyle
    }

    /**
     * @returns: true iif the widget gains focus when left clicked
     * */
    pub fn isFocusableLeftClick (self)-> bool {
        false
    }

    /**
     * @returns: true iif the widget gains focus when right clicked
     * */
    pub fn isFocusableRightClick (self)-> bool {
        false
    }

    /**
     * @returns: true iif the widget gains focus when middle clicked
     * */
    pub fn isFocusableMiddleClick (self)-> bool {
        false
    }

    /**
     * @returns: true iif the widget lose focus when left click is released
     * */
    pub fn loseFocusOnReleaseLeft (self)-> bool {
        false
    }

    /**
     * @returns: true iif the widget lose focus when right click is released
     * */
    pub fn loseFocusOnReleaseRight (self)-> bool {
        false
    }

    /**
     * @returns: true iif the widget lose focus when middle click is released
     * */
    pub fn loseFocusOnReleaseMiddle (self)-> bool {
        false
    }

    /**
     * @returns: true iif the widget can capture wheel events when focused
     * */
    pub fn captureWheelOnFocus (self)-> bool {
        false
    }

    /**
     * @returns: the widget under this one at the path names, the anonymous widgets adding no segment to it
     * */
    pub fn find (mut self, names : [[c8]])-> dmut (&Widget)? {
        names;
        none
    }

    /**
     * @returns: the widget at the path names, this widget being its first segment, or a widget under this one when it
     * is anonymous
     * */
    @{final}
    pub fn resolve (mut self, names : [[c8]])-> dmut (&Widget)? {
        if names.len == 0 { return none; }
        if self.id == "" { return self:.find (names); }
        if self.id != names [0] { return none; }
        if names.len == 1 { return (alias self)?; }

        self:.find (names [1 .. $])
    }

    /**
     * @returns: a widget from a given path name
     * */
    @{final}
    pub fn find (mut self, name : [c8])-> dmut (&Widget)? {
        self:.find (std::fs::path::Path (name).parts ())
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SIZES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the size of the widget in absolute position and size in pixels, the space it is placed in being its container
     * @params:
     *   - pos: the position of the margin box of the widget in pixels
     *   - size: the size of the margin box of the widget in pixels
     *   - depth: the depth of the widget in pixels
     * */
    @{final}
    pub fn setSize (mut self, pos : vec2, size : vec2, depth : u32) {
        self:.setSize (pos, size, depth, size);
    }

    /**
     * Set the size of the widget in absolute position and size in pixels
     * @params:
     *   - pos: the position of the margin box of the widget in pixels
     *   - size: the size of the margin box of the widget in pixels
     *   - depth: the depth of the widget in pixels
     *   - container: the size of the content box of the parent, the percentages of the margins and paddings being parts
     *                of it
     * */
    @{final}
    pub fn setSize (mut self, pos : vec2, size : vec2, depth : u32, container : vec2) {
        self._depth = depth + 5;
        self._absoluteFullSize = size;
        self._absoluteFullPosition = pos;
        self._containerSize = container;

        self:.computeSize ();
    }

    /**
     * Compute the size of the different parts of the widget
     * */
    @{final}
    prot fn computeSize (mut self) {
        self:.computePostMarginSize ();
        self:.computePostBorderSize ();
        self:.computePostPaddingSize ();

        // a widget out of the layout leaves its children where they are, hidden with it
        if self._currentStyle.isDisplayed () {
            self:.onUpdateSize ();
        }

        self:.applyStyle ();
    }


    /**
     * @returns: the space available to the widget, read by the conditions of the style sheets as width and height: on
     * each axis, the content box of its nearest ancestor whose size on that axis is fixed, the window for the root
     * @info: an ancestor of a fixed size does not move when the conditions change the style of what it contains, so
     * that a condition never measures what it changes
     * */
    @{final}
    pub fn getAvailableSize (self)-> vec2 {
        if let Ok (p) = self._parent {
            return makeVec2 (p.getFixedContent (true), p.getFixedContent (false));
        }

        self._manager.getLayoutSize ()
    }

    /**
     * @returns: true iif the size of the widget on an axis depends neither on its content nor on what its content can
     * change: the root, filling the window, or a widget its parent sizes from boxes of a fixed size only (fixesSizeOf)
     * @params:
     *    - row: true for the width, false for the height
     * */
    @{final}
    pub fn isSizeFixed (self, row : bool)-> bool {
        if let Ok (p) = self._parent {
            return self._ownerPart == "" && p.fixesSizeOf (self, row);
        }

        true
    }

    /**
     * @returns: true iif the widget gives a child a size on an axis that depends neither on the content of the child
     * nor on what it can change, false unless the layout knows better
     * @params:
     *    - child: the child
     *    - row: true for the width, false for the height
     * */
    prot fn fixesSizeOf (self, _ : &Widget, _ : bool)-> bool {
        false
    }

    /**
     * @returns: true iif a child sized from its style in the content box of the widget, an auto size filling it, has a
     * fixed size on an axis: a length in px, or a percentage or auto in a widget whose size is fixed on that axis, its
     * bounds not depending on its content
     * @params:
     *    - child: the child
     *    - row: true for the width, false for the height
     * */
    @{final}
    prot fn fixesStretched (self, child : &Widget, row : bool)-> bool {
        let style = child.getStyle ();
        let (size, lower, upper) = if row {
            (style.width._1, style.minWidth._1, style.maxWidth._1)
        } else {
            (style.height._1, style.minHeight._1, style.maxHeight._1)
        };

        if needsContent (lower) || needsContent (upper) { return false; }

        match size.sizing {
            Sizing::LENGTH => { size.length.unit == Unit::PX || self.isSizeFixed (row) }
            Sizing::AUTO   => { self.isSizeFixed (row) }
            _              => { false }
        }
    }

    /**
     * @returns: the size of the content box of the widget on an axis if its size on that axis is fixed, that of its
     * nearest ancestor of a fixed size otherwise
     * */
    @{final}
    fn getFixedContent (self, row : bool)-> f32 {
        if self.isSizeFixed (row) {
            return if row { self._absoluteSize.x } else { self._absoluteSize.y };
        }

        if let Ok (p) = self._parent {
            return p.getFixedContent (row);
        }

        let window = self._manager.getLayoutSize ();
        if row { window.x } else { window.y }
    }

    /**
     * Lay the widget out again after its content changed, the whole interface when its size can depend on its content,
     * a part being placed by the widget owning it whatever its content
     * */
    @{final}
    prot fn relayout (mut self) {
        let fixed = (self._currentStyle.width._1).isLength () && (self._currentStyle.height._1).isLength ();
        if self._ownerPart == "" && !fixed {
            self._manager:.updateWidgets ();
        } else {
            self:.computeSize ();
        }
    }

    /**
     * Set the scissors of the shape to cut every pixel drawn outside
     * */
    @{final}
    pub fn setScissors (mut self, pos : vec2, size : vec2) {
        self._scissorPos = pos;
        self._scissorSize = size;

        self:.onUpdateScissors ();
        self:.applyStyle ();
    }

    /**
     * Method called when the size of the widget have changed
     * */
    prot fn onUpdateSize (mut self) {}

    /**
     * Method when scissors have been updated
     * */
    prot fn onUpdateScissors (mut self) {}

    /**
     * @returns: the position and size of the shapes
     * */
    prot fn getShapePositionAndSize (self, kind : WidgetShapeKind)-> (vec2, vec2) {
        match kind {
            WidgetShapeKind::TEXT => { (self._absolutePosition, self._absoluteSize) }
            WidgetShapeKind::BORDER => { (self._absolutePostMarginPosition, self._absolutePostMarginSize) }
            WidgetShapeKind::BACKGROUND => { (self._absolutePostBorderPosition, self._absolutePostBorderSize) }
            WidgetShapeKind::IMAGE => { self.computeBackgroundImageSize () }
            _ => { (self._absoluteFullPosition, self._absoluteFullSize) }
        }
    }

    prot fn getScissors (self, wpos : vec2, wsize : vec2)-> (vec2, vec2) {
        let sciPos = makeVec2 (max (wpos.x, self._scissorPos.x),
                               max (wpos.y, self._scissorPos.y));

        let sciEnd = makeVec2 (min (wpos.x + wsize.x, self._scissorPos.x + self._scissorSize.x),
                               min (wpos.y + wsize.y, self._scissorPos.y + self._scissorSize.y));


        (sciPos, sciEnd - sciPos)
    }

    fn computeBackgroundImageSize (self)-> (vec2, vec2) {
        if self._currentStyle.backgroundImageKeepRatio._1 {
            let test = if self._currentStyle.backgroundImageFill._1 {
                self._absolutePostBorderSize.x < self._absolutePostBorderSize.y
            } else {
                self._absolutePostBorderSize.x > self._absolutePostBorderSize.y
            };

            let (pos, size) = if test {
                let xsize = self._absolutePostBorderSize.y;
                let xpos = self._absolutePostBorderPosition.x + (self._absolutePostBorderSize.x - xsize) / 2.0f;

                (makeVec2 (xpos, self._absolutePostBorderPosition.y), makeVec2 (xsize, self._absolutePostBorderSize.y))
            } else {
                let ysize = self._absolutePostBorderSize.x;
                let ypos = self._absolutePostBorderPosition.y + (self._absolutePostBorderSize.y - ysize) / 2.0f;

                (makeVec2 (self._absolutePostBorderPosition.x, ypos), makeVec2 (self._absolutePostBorderSize.x, ysize))
            };

            (pos, size)
        } else {
            (self._absolutePostBorderPosition, self._absolutePostBorderSize)
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MEASURE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Measure the border-box width of the widget in a container, its width resolved against the container, an auto
     * width stretched to the container or fitted to its content in it, then clamped to its bounds, 0 for a widget out
     * of the layout (display: none)
     * @params:
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     *    - stretch: true for an auto width to fill the container, false for it to fit the content in it
     * @returns: the width of the border box, in pixels
     * */
    @{final}
    pub fn measureWidth (mut self, container : vec2, stretch : bool)-> f32 {
        self:.measureWidth (container, container.x, stretch-> stretch)
    }

    /**
     * Measure the border-box width of the widget in a space of its container
     * @params:
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     *    - space: the width the margin box of an auto width fills or fits in, INDEFINITE_SIZE for its max-content
     *    - stretch: true for an auto width to fill the space, false for it to fit the content in it
     * @returns: the width of the border box, in pixels
     * */
    @{final}
    pub fn measureWidth (mut self, container : vec2, space : f32, stretch : bool)-> f32 {
        let style = self._currentStyle;
        if !style.isDisplayed () { return 0.0f; }

        let frame = self.getFrame (container).x;
        let fill = stretch && space >= 0.0f;
        let content = self:.contentWidths ((style.width._1).isAuto () && !fill,
                                                   copy [style.width._1, style.minWidth._1, style.maxWidth._1]);

        let width = if let Ok (w) = resolveBox (style.width._1, container.x, frame, content) {
            w
        } else {
            autoBox (space, self.getMarginSize (container).x, frame, content, stretch-> fill)
        };

        clampBox (width, boundsOf (style.minWidth._1, style.maxWidth._1, container.x, frame, content))
    }

    /**
     * Measure the border-box height of the widget at a width, its height resolved against the container, an auto height
     * stretched to the container or the height of its content laid out in the width, then clamped to its bounds
     * @params:
     *    - width: the width of the border box, in pixels
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     *    - stretch: true for an auto height to fill the container, false for it to be the height of the content
     * @returns: the height of the border box, in pixels
     * */
    @{final}
    pub fn measureHeight (mut self, width : f32, container : vec2, stretch : bool)-> f32 {
        self:.measureHeight (width, container, container.y, stretch-> stretch)
    }

    /**
     * Measure the border-box height of the widget at a width, in a space of its container
     * @params:
     *    - width: the width of the border box, in pixels
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     *    - space: the height the margin box of a stretched auto height fills, INDEFINITE_SIZE for the content height
     *    - stretch: true for an auto height to fill the space, false for it to be the height of the content
     * @returns: the height of the border box, in pixels
     * */
    @{final}
    pub fn measureHeight (mut self, width : f32, container : vec2, space : f32, stretch : bool)-> f32 {
        let style = self._currentStyle;
        if !style.isDisplayed () { return 0.0f; }

        let frame = self.getFrame (container);
        let fill = stretch && space >= 0.0f;
        let content = self:.contentHeight ((style.height._1).isAuto () && !fill, width - frame.x,
                                                   copy [style.height._1, style.minHeight._1, style.maxHeight._1]);

        let height = if let Ok (h) = resolveBox (style.height._1, container.y, frame.y, content) {
            h
        } else {
            autoBox (space, self.getMarginSize (container).y, frame.y, content, stretch-> fill)
        };

        clampBox (height, boundsOf (style.minHeight._1, style.maxHeight._1, container.y, frame.y, content))
    }

    /**
     * Resolve a width of the widget (its style width, or its flex basis) against its container
     * @params:
     *    - size: the width to resolve
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     * @returns: the width of the border box in pixels, none for auto, and for a percentage of an unknown container
     * */
    @{final}
    pub fn resolveWidth (mut self, size : Size, container : vec2)-> (f32)? {
        if !self._currentStyle.isDisplayed () { return (0.0f)?; }

        resolveBox (size, container.x, self.getFrame (container).x, self:.contentWidths (false, copy [size]))
    }

    /**
     * Resolve a height of the widget (its style height, or its flex basis) against its container
     * @params:
     *    - size: the height to resolve
     *    - width: the width of the border box, the content being laid out in it, in pixels
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     * @returns: the height of the border box in pixels, none for auto, and for a percentage of an unknown container
     * */
    @{final}
    pub fn resolveHeight (mut self, size : Size, width : f32, container : vec2)-> (f32)? {
        if !self._currentStyle.isDisplayed () { return (0.0f)?; }

        let frame = self.getFrame (container);
        resolveBox (size, container.y, frame.y, self:.contentHeight (false, width - frame.x, copy [size]))
    }

    /**
     * Measure the item of a flex line sizing the widget along the axis of a linear layout or a splitter
     * @params:
     *    - row: true to size its width, false its height
     *    - container: the content box of the layout, a component being INDEFINITE_SIZE when it is unknown
     *    - width: the width of the border box, the content being laid out in it, when its height is sized, in pixels
     * @returns: the item, sizing the border box from its flex basis, size, bounds and factors
     * */
    @{final}
    pub fn measureFlexItem (mut self, row : bool, container : vec2, width : f32 = 0.0f)-> FlexItem {
        let style = self._currentStyle;
        if !style.isDisplayed () { return FlexItem (shrink-> 0.0f, max-> 0.0f); }

        let frame = self.getFrame (container);
        if row {
            flexItemOf (style.width._1, style.flexBasis._1, style.minWidth._1, style.maxWidth._1, container.x, frame.x,
                        self:.measureContentWidths (), style.flexGrow._1, style.flexShrink._1)
        } else {
            let content = self:.contentHeight (true, width - frame.x, []);
            flexItemOf (style.height._1, style.flexBasis._1, style.minHeight._1, style.maxHeight._1, container.y,
                        frame.y, content, style.flexGrow._1, style.flexShrink._1)
        }
    }

    /**
     * Measure the widths the widget asks to a parent sized to its content: its width when it is a length, the widths of
     * its content otherwise, clamped to its bounds, a percentage of the parent standing for auto
     * @returns: the min-content and max-content widths of the margin box, in pixels
     * */
    @{final}
    pub fn measureIntrinsicWidths (mut self)-> (f32, f32) {
        let style = self._currentStyle;
        if !style.isDisplayed () { return (0.0f, 0.0f); }

        let container = makeVec2 (INDEFINITE_SIZE, INDEFINITE_SIZE);
        let frame = self.getFrame (container).x;
        let margins = self.getMarginSize (container).x;
        let content = self:.measureContentWidths ();

        let bounds = boundsOf (style.minWidth._1, style.maxWidth._1, INDEFINITE_SIZE, frame, content);
        let (minWidth, maxWidth) = if let Ok (w) = resolveBox (style.width._1, INDEFINITE_SIZE, frame, content) {
            (w, w)
        } else {
            (content._0 + frame, content._1 + frame)
        };

        (clampBox (minWidth, bounds) + margins, clampBox (maxWidth, bounds) + margins)
    }

    /**
     * Measure the height the widget asks to a parent sized to its content, at a width
     * @params:
     *    - width: the width of the border box, in pixels
     * @returns: the height of the margin box, in pixels
     * */
    @{final}
    pub fn measureIntrinsicHeight (mut self, width : f32)-> f32 {
        if !self._currentStyle.isDisplayed () { return 0.0f; }

        let container = makeVec2 (INDEFINITE_SIZE, INDEFINITE_SIZE);
        self:.measureHeight (width, container, stretch-> false) + self.getMarginSize (container).y
    }

    /**
     * @returns: the min-content and max-content widths of the content, (0, 0) when they are not needed
     * @params:
     *    - needed: true if the content is needed whatever the sizes
     *    - sizes: the sizes to resolve, the content being needed when one of them is min-content or max-content
     * */
    @{final}
    fn contentWidths (mut self, needed : bool, sizes : [Size])-> (f32, f32) {
        for s in sizes {
            if needsContent (s) { return self:.measureContentWidths (); }
        }

        if needed { self:.measureContentWidths () } else { (0.0f, 0.0f) }
    }

    /**
     * @returns: the height of the content laid out in a width, twice (as its min-content and its max-content), (0, 0)
     * when it is not needed
     * @params:
     *    - needed: true if the content is needed whatever the sizes
     *    - width: the width of the content box, in pixels
     *    - sizes: the sizes to resolve, the content being needed when one of them is min-content or max-content
     * */
    @{final}
    fn contentHeight (mut self, needed : bool, width : f32, sizes : [Size])-> (f32, f32) {
        let mut need = needed;
        for s in sizes {
            if needsContent (s) { need = true; }
        }

        if !need { return (0.0f, 0.0f); }

        let h = self:.measureContentHeight (max (0.0f, width));
        (h, h)
    }

    /**
     * Measure the widths of the content of the widget, inside its paddings
     * @returns: the smallest width the content fits in, its lines wrapped at every opportunity, and the width of the
     * content, its lines never wrapped, in pixels
     * */
    prot fn measureContentWidths (mut self)-> (f32, f32) {
        (0.0f, 0.0f)
    }

    /**
     * Measure the height of the content of the widget, inside its paddings, laid out in a width
     * @params:
     *    - width: the inner width of the widget, in pixels
     * @returns: the height of the content, in pixels
     * */
    prot fn measureContentHeight (mut self, _ : f32)-> f32 {
        0.0f
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          TICK EVENTS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Event emitted by the application at each UI frameo
     * */
    pub fn onTick (mut self, delta : Duration) {
        delta;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          MOUSE EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Method called when the object is on the widget
     * @params:
     *  - pos: the position of the cursor relative to the widget between 0 and 1
     */
    pub fn onHover (mut self, _ : vec2)-> dmut (&Widget)? {
        (alias self)?
    }

    /**
     * Method called when the cursor left the widget
     */
    pub fn onLoseHoverFocus (mut self) {}

    /**
     * Method called when the cursor is on the widget and clicked
     * @params:
     *  - pos: the position of the cursor relative to the widget between 0 and 1
     *  - button: the button being clicked
     * @returns: the widget that have been clicked
     */
    pub fn onClick (mut self, _ : vec2, _ : u8)-> dmut (&Widget)? {
        (alias self)?
    }

    /**
     * Method called when the cursor was clicked (self:.onClick ()) and click was released (even if the cursor is now outside the widget)
     * @params:
     *  - button: the button being clicked
     * @returns: the widget that have been clicked
     */
    pub fn onClickEnd (mut self, _ : u8)-> dmut (&Widget)? {
        (alias self)?
    }

    /**
     * Method called when the cursor is on the widget and the left clicked is pressed two times in less than __DOUBLE_CLICK_SENSIBILITY__
     * @params:
     *   - pos: the position of the cursor relative to the widget between 0 and 1
     * @returns: the widget that have been clicked
     */
    pub fn onDoubleClick (mut self, _ : vec2)-> dmut (&Widget)? {
        (alias self)?
    }

    /**
     * Method called when the mouse cursor is on the widget and the scroll event occurs
     * @params:
     *   - pos: the position of the cursor
     *   - amoutX: the amount of scrolling along the x axis
     *   - amountY: the amount of scrolling along the y axis
     * @returns: true, if the widget did scroll
     */
    pub fn onScroll (mut self, _ : vec2, _ : i32, _ : i32)-> bool {
        false
    }

    /**
     * Method called when a sliding event is observed by the manager and the widget has the focus
     * @params:
     *    - pos: the position of the cursor (relative to widget)
     *    - speed: the speed of the sliding
     *    - button: the button being pressed during sliding (SDL_BUTTON_LEFT, RIGHT, MIDDLE)
     * */
    pub fn onSliding (mut self, _ : vec2, _ : vec2, _ : u8) {}

    /**
     * Method called when sliding motions is released on the widget that is focused
     * @params:
     *    - button: the button that was pressed during the sliding event
     * */
    pub fn onSlidingEnd (mut self, _ : u8) {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          FOCUS EVENTS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Method called when the object gain the focus
     */
    pub fn onGainFocus (mut self) {}

    /**
     * Method called when the object lose the focus
     */
    pub fn onLoseFocus (mut self) {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Hide the widget and all its shapes, whatever its style says
     * */
    @{final}
    pub fn hide (mut self) {
        self:.onHide ();

        if self.isDrawn () {
            self:.hideShapes ();
        }

        self._hidden = true;
        self:.applyStyle ();
    }

    /**
     * Show the widget and all its shapes, unless its style displays none
     * */
    @{final}
    pub fn show (mut self) {
        let wasDrawn = self.isDrawn ();
        self._hidden = false;
        if self._displayed {
            self:.onShow ();
            if !wasDrawn {
                self:.showShapes ();
            }
        }

        self:.applyStyle ();
    }

    /**
     * @returns: true iif the widget is drawn: neither hidden by code nor displayed none by its style
     * */
    @{final}
    pub fn isDrawn (self)-> bool {
        !self._hidden && self._displayed
    }


    /**
     * Hide the shapes of the widget (without hiding the object itself)
     * */
    @{final}
    prot fn hideShapes (mut self) {
        for _, dmut ws in alias self._shapes {
            ws:.hide ();
        }
    }

    /**
     * Show the shapes of the widget (without showing the object itself)
     * */
    @{final}
    prot fn showShapes (mut self) {
        for _, dmut ws in alias self._shapes{
            ws:.show ();
        }
    }

    /**
     * Method called when the widget have been hidden
     * */
    prot fn onHide (mut self) {}

    /**
     * Method called when the widget have been displayed
     * */
    prot fn onShow (mut self) {}

    /**
     * Method called when the widget is attached to a window
     * */
    pub fn onAttach (mut self, parent : (&Widget)?) {
        self._parent = parent;
        if self._ownerPart == "" {
            self._currentStyle = self:.computeStyle ();
        } else if let Ok (p) = parent {
            self._currentStyle = p.getStyle ().getSubStyle (self._ownerPart);
        }

        self._attached = true;
    }

    /**
     * Make the widget a part of the widget it is attached to, its style being set by that widget from the style of the
     * part instead of being computed from the sheets
     * @params:
     *    - part: the name of the part
     * */
    @{final}
    pub fn setOwnerPart (mut self, part : [c8]) {
        self._ownerPart = part;
    }

    /**
     * Set the menu context, so the widget can open/close menu items
     * */
    pub fn setMenuContext (mut self, dmut menu : &MenuLayout) {
        self._menuContext = (alias menu)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          STATES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Enter or leave a state, computing the style of the widget again, and those of its descendants when a rule tests
     * the state on an ancestor
     * @params:
     *    - state: the name of the state, as the style sheets select it (:hover)
     *    - set: true to enter the state, false to leave it
     * */
    @{final}
    prot fn setState (mut self, state : [c8], set : bool) {
        if self.hasState (state) == set { return; }
        if set {
            self._states ~= [state];
        } else {
            let mut rest : [[c8]] = [];
            for s in self._states {
                if s != state { rest ~= [s]; }
            }

            self._states = rest;
        }

        self:.reloadStyle (deep-> self._manager:.getStyleManager ().isAncestorState (state));
    }

    /**
     * Set to true iif the widget is focused
     * */
    @{final}
    pub fn setFocus (mut self, set : bool) {
        self:.setState ("focus", set);
    }

    /**
     * Set to true iif the widget is hovered
     * */
    @{final}
    prot fn setHover (mut self, set : bool) {
        self:.setState ("hover", set);
    }

    /**
     * Set to true iif the widget is checked
     * */
    @{final}
    prot fn setChecked (mut self, set : bool) {
        self:.setState ("check", set);
    }

    /**
     * Set the classes of the widget, computing the styles of the widget and of its descendants again
     * */
    @{final}
    pub fn setClasses (mut self, classes : [[c8]]) {
        if self._classes != classes {
            self._classes = classes;
            self:.reloadStyle (deep-> true);
        }
    }

    /**
     * @returns: the inline style of the widget, set by code
     * */
    @{final}
    pub fn getInlineStyle (self)-> &Style {
        self._inlineStyle
    }

    /**
     * Set the inline style of the widget, applied over the rules of the sheets as the style attribute of an HTML element,
     * computing the style of the widget again
     * */
    @{final}
    pub fn setInlineStyle (mut self, style : &Style) {
        self._inlineStyle = style;
        self:.reloadStyle ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iif the widget is hovered
     * */
    @{final}
    pub fn isHover (self)-> bool {
        self.hasState ("hover")
    }

    /**
     * @returns: true iif the widget is checked
     * */
    @{final}
    pub fn isChecked (self)-> bool {
        self.hasState ("check")
    }

    /**
     * @returns: true iif the widget is focused
     * */
    @{final}
    pub fn isFocus (self)-> bool {
        self.hasState ("focus")
    }

    /**
     * @returns: true iif the widget is in a state
     * */
    @{final}
    pub fn hasState (self, state : [c8])-> bool {
        for s in self._states {
            if s == state { return true; }
        }

        false
    }

    /**
     * @returns: the widget containing this one, none for the root or a widget not attached
     * */
    @{final}
    pub fn getParent (self)-> (&Widget)? {
        self._parent
    }

    /**
     * @returns: true iif w is this widget or one of its ancestors
     * */
    @{final}
    pub fn isWithin (self, w : &Widget)-> bool {
        if self is w { return true; }
        if let Ok (p) = self._parent {
            return p.isWithin (w);
        }

        false
    }

    /**
     * @returns: the classes of the widget, in the order of the file
     * */
    @{final}
    pub fn getClasses (self)-> [[c8]] {
        self._classes
    }

    /**
     * @returns: what the selectors of the style sheets test on the widget, then on each of its ancestors up to the root
     * */
    @{final}
    pub fn getStylePath (self)-> [Element] {
        let own = copy [Element (self.typeName, id-> self.id, classes-> self._classes, states-> self._states)];
        if let Ok (p) = self._parent {
            return own ~ p.getStylePath ();
        }

        own
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the widget is clicked
     * */
    pub fn clicked (mut self)-> dmut &Signal!{u8} {
        if let Ok (dmut t) = alias self._clicked {
            return alias t;
        }

        let dmut ret = copy Signal!{u8} ();
        self._clicked = (alias ret)?;

        alias ret
    }

    /**
     * Emit the click signal of the widget
     * */
    pub fn emitClicked (mut self, button : u8) {
        if let Ok (dmut m) = alias self._clicked {
            m:.emit (button);
        }
    }

    /**
     * @returns: the signal emitted when the widget is mouse focused
     * */
    pub fn focused (mut self)-> dmut &Signal!{()} {
        if let Ok (dmut t) = alias self._focused {
            return alias t;
        }

        let dmut ret = copy Signal!{()} ();
        self._focused = (alias ret)?;

        alias ret
    }

    /**
     * Emit the focus signal of the widget
     * */
    pub fn emitFocused (mut self) {
        if let Ok (dmut m) = alias self._focused {
            m:.emit ();
        }
    }

    /**
     * @returns: the signal emitted when the widget is mouse unfocused
     * */
    pub fn unfocused (mut self)-> dmut &Signal!{()} {
        if let Ok (dmut t) = alias self._unfocused {
            return alias t;
        }

        let dmut ret = copy Signal!{()} ();
        self._unfocused = (alias ret)?;

        alias ret
    }

    /**
     * Emit the unfocus signal of the widget
     * */
    pub fn emitUnfocused (mut self) {
        if let Ok (dmut m) = alias self._unfocused {
            m:.emit ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dispose the shapes of the widgets
     * */
    @{final}
    fn disposeShapes (mut self) {
        let dmut shDr = self._manager:.getShapeDrawer ();
        for _, dmut ws in alias self._shapes {
            shDr:.removeShape (ws.uid);
        }

        self._shapes = copy [];
        self._backgroundTexture:.dispose ();

        self._currentBackImage = "";
        self._currentBackColor = vec4 ();
        self._currentBorderColor = vec4 ();
    }

    impl Disposable {

        /**
         * Every widget is disposable
         * Even if this ancestor class Widget doesn't need to be disposed, some child class may
         */
        pub over dispose (mut self) {
            self._attached = false;
            self._menuContext = none;
            self._parent = none;

            self:.disposeShapes ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          SHAPE MANAGEMENTS          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the style of the widget again, and those of its descendants when theirs can depend on it, laying the
     * interface out again only if a property that affects the layout changed
     * @params:
     *    - deep: true to compute the styles of every descendant again
     * */
    @{final}
    pub fn reloadStyle (mut self, deep : bool = false) {
        if self:.restyle (deep) {
            self._manager:.updateWidgets ();
        }
    }

    /**
     * Compute the style of the widget again, and those of its descendants when they inherit a property that changed,
     * applying at once the changes that do not affect the layout
     * @params:
     *    - deep: true to compute the styles of every descendant again
     * @returns: true iif a property that affects the layout changed, in the widget or in a descendant
     * */
    @{final}
    pub fn restyle (mut self, deep : bool)-> bool {
        if !self._attached || self._ownerPart != "" { return false; }

        let newStyle = self:.computeStyle ();
        let inherited = !self._currentStyle.sameInherited (newStyle);
        let mut layout = !self._currentStyle.sameLayout (newStyle);
        let look = !self._currentStyle.sameLook (newStyle);

        self._currentStyle = newStyle;
        if !layout && look {
            self:.applyStyle ();
        }

        if (deep || inherited) && self:.restyleChildren (deep) {
            layout = true;
        }

        layout
    }

    /**
     * Compute the styles of the children again
     * @params:
     *    - deep: true to compute the styles of every descendant again
     * @returns: true iif a property that affects the layout changed, in a child or in one of its descendants
     * */
    prot fn restyleChildren (mut self, deep : bool)-> bool {
        deep;
        false
    }

    /**
     * @returns: the style of the widget computed from the sheets and its inline style, the inherited properties taken
     * from its parent, with the styles of the parts its type registers
     * */
    @{final}
    fn computeStyle (mut self)-> &Style {
        let parent = if let Ok (p) = self._parent { p.getStyle () } else { copy Style () };
        let parts = if let Ok (schema) = self._manager:.getRegistry ().get (self.typeName) { schema.parts } else { [] };
        let path = self.getStylePath ();

        self._reads = self._manager:.getStyleManager ().reads (path);
        let available = if self.readsAvailable () {
            self._available = self.getAvailableSize ();
            (self._available)?
        } else { none };

        let scope = ConditionScope (self._manager.getStyleVariables (), available-> available);
        self._manager:.getStyleManager ().compute (path, parent, parts-> parts, inline-> (self._inlineStyle)?, scope-> scope)
    }

    /**
     * Compute the style of the widget again when one of the variables its conditions read changed, or when they read
     * width or height and the space available to it changed since its style was computed
     * @params:
     *    - names: the variables that changed
     * @returns: true iif a property that affects the layout changed, in the widget or in a descendant
     * */
    pub fn restyleConditions (mut self, names : [[c8]])-> bool {
        if !self._attached || self._ownerPart != "" { return false; }

        let mut changed = false;
        for r in self._reads {
            for n in names {
                if r == n { changed = true; }
            }
        }

        if !changed && self.readsAvailable () {
            changed = self.getAvailableSize () != self._available;
        }

        if changed { self:.restyle (false) } else { false }
    }

    /**
     * @returns: true iif the conditions of the rules matching the widget read the space available to it
     * */
    @{final}
    fn readsAvailable (self)-> bool {
        for r in self._reads {
            if r == AvailableVariable::WIDTH || r == AvailableVariable::HEIGHT { return true; }
        }

        false
    }

    /**
     * Force the style of the widget
     * */
    @{final}
    pub fn setStyle (mut self, newStyle : &Style) {
        if self._attached {
            // the interface is laid out again only when a property that affects the layout changed
            if !self._currentStyle.sameLayout (newStyle) {
                self._currentStyle = newStyle;
                self._manager:.updateWidgets ();
            }

            // the others are applied to the shapes
            else if !self._currentStyle.sameLook (newStyle) {
                self._currentStyle = newStyle;
                self:.applyStyle ();
            }
        }

        self._currentStyle = newStyle;

    }

    /**
     * Apply the current style to the shapes of the widget
     * */
    @{final}
    prv fn applyStyle (mut self) {
        if !self._attached { return; }

        self:.applyDisplay ();
        if self._hasBackground {
            self:.loadBackTexture ();
            self:.loadBackColor ();
        }

        if self._hasBorder {
            self:.loadBorderColor ();
        }

        for kind in WidgetShapeKind::__members__ {
            if let Ok (dmut ws) = alias self._shapes [kind] {
                self:.applyStyle (kind, alias ws);
            }
        }

        self:.onApplyStyle ();
    }


    /**
     * Take the display of the current style: a widget displayed none hides its shapes and its children, which are shown
     * again when it is displayed normal, unless it is hidden by code
     * */
    @{final}
    prv fn applyDisplay (mut self) {
        let displayed = self._currentStyle.isDisplayed ();
        if displayed == self._displayed { return; }

        self._displayed = displayed;
        if self._hidden { return; }

        if displayed {
            self:.onShow ();
            self:.showShapes ();
        } else {
            self:.onHide ();
            self:.hideShapes ();
        }
    }

    /**
     * Apply the background image style in case of update
     * */
    @{final}
    prv fn loadBackTexture (mut self) {
        if self._currentBackImage != self._currentStyle.backgroundImage._1 {
            self._currentBackImage = self._currentStyle.backgroundImage._1;

            let dmut shDr = self._manager:.getShapeDrawer ();
            if let Ok (dmut ws) = alias self._shapes [WidgetShapeKind::IMAGE] {
                shDr:.removeShape (ws.uid);
                self._shapes:.remove (WidgetShapeKind::IMAGE);
            }

            self._backgroundTexture:.dispose ();
            if self._currentBackImage != "" { // new image
                {
                    self._backgroundTexture = self._manager:.getWindow ():.loadResource!{&Texture2D} (self._currentBackImage);
                } catch {
                    err => {
                        log::error #("Widget", "Failed to load background image", err);
                        return;
                    }
                }

                if !self._backgroundTexture.isEmpty () {
                    {
                        let dmut newShape = shDr:.registerTextureQuad (texture-> self._backgroundTexture:.clone ());
                        self._shapes [WidgetShapeKind::IMAGE] = alias newShape;
                        if !self.isDrawn () { newShape:.hide (); }

                        self._backgroundTextureSize = makeVec2 (self._backgroundTexture.get ().width,
                                                                self._backgroundTexture.get ().height);

                    } catch {
                        err => {
                            log::error #("Widget", "Failed to create texture background image shape  => ", err);
                            return;
                        }
                    }
                }
            }
        }
    }

    /**
     * Load the background color shape
     * */
    @{final}
    prv fn loadBackColor (mut self) {
        if self._currentBackColor != self._currentStyle.getColor (WidgetShapeKind::BACKGROUND) {
            self._currentBackColor = self._currentStyle.getColor (WidgetShapeKind::BACKGROUND);

            if WidgetShapeKind::BACKGROUND !in alias self._shapes {
                self:.registerColorShape (WidgetShapeKind::BACKGROUND);
            }
        }
    }

    /**
     * Load the border color shape
     * */
    @{final}
    prv fn loadBorderColor (mut self) {
        if self._currentBorderColor != self._currentStyle.getColor (WidgetShapeKind::BORDER) {
            self._currentBorderColor = self._currentStyle.getColor (WidgetShapeKind::BORDER);

            if WidgetShapeKind::BORDER !in self._shapes {
                self:.registerColorShape (WidgetShapeKind::BORDER);
            }
        }
    }

    /**
     * Apply the current style to the shapes of the widget
     * */
    @{final}
    prv fn applyStyle (mut self, kind : WidgetShapeKind, dmut ws : &Shape) {
        let (pos, size) = self.getShapePositionAndSize (kind);

        // the ink of a glyph overhangs its advance (italics, accents), so a text is only cut to the scissors of the widget
        let (sciPos, sciSize) = if kind == WidgetShapeKind::TEXT {
            (self._scissorPos, self._scissorSize)
        } else {
            self.getScissors (pos, size)
        };

        if !self.isDrawn () {
            ws:.hide ();
        } else {
            ws:.setPosition (pos);
            ws:.setSize (size);
            ws:.setScissors (sciPos, sciSize);

            ws:.setColor (self._currentStyle.getColor (kind));            
            ws:.setLevel (self.getDepth (kind));
            ws:.show ();
        }
    }

    /**
     * Method called when the style of the widget has been applied
     * */
    prot fn onApplyStyle (mut self) {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          SIZE COMPUTING          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true if the point is in the square
     * */
    @{final}
    fn isInSquare (self, pos : vec2, start : vec2, end : vec2)-> (vec2)? {
        if (pos.x >= start.x
            && pos.x <= end.x
            && pos.y >= start.y
            && pos.y <= end.y) {

            let relPos = makeVec2 ((pos.x - start.x) / (end.x - start.x),
                                   (pos.y - start.y) / (end.y - start.y));

            return (relPos)?;
        }

        none
    }

    /**
     * @returns: true if the point is in the border of the shape
     * @params:
     *    - pos: the position of the point relative to the widget (0 <= (x,y) <= 1)
     * */
    @{final}
    fn isInBorder (self, pos : vec2)-> (vec2)? {
        let a = (self._absolutePostMarginPosition - self._absoluteFullPosition) / self._absoluteFullSize;
        let b = a + (self._absolutePostMarginSize / self._absoluteFullSize);

        return self.isInSquare (pos, a, b);
    }

    /**
     * @returns: true if the point is in the border of the shape
     * @params:
     *    - pos: the position of the point relative to the widget (0 <= (x,y) <= 1)
     * */
    @{final}
    fn isInPadding (self, pos : vec2)-> (vec2)? {
        let a = (self._absolutePosition - self._absoluteFullPosition) / self._absoluteFullSize;
        let b = a + (self._absoluteSize / self._absoluteFullSize);

        return self.isInSquare (pos, a, b);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          SIZE COMPUTATION          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the size of the border box, the margin box less the margins
     * */
    @{final}
    prv fn computePostMarginSize (mut self) {
        self._absolutePostMarginSize = self._absoluteFullSize;
        self._absolutePostMarginPosition = self._absoluteFullPosition;

        let margin = self.getMargins (self._containerSize);

        self._absolutePostMarginSize.y -= margin.x;
        self._absolutePostMarginSize.y -= margin.y;
        self._absolutePostMarginPosition.y += margin.x;

        self._absolutePostMarginSize.x -= margin.z;
        self._absolutePostMarginPosition.x += margin.z;
        self._absolutePostMarginSize.x -= margin.w;
    }

    /**
     * Compute the size of the padding box, the border box less the borders
     * */
    @{final}
    prv fn computePostBorderSize (mut self) {
        self._absolutePostBorderSize = self._absolutePostMarginSize;
        self._absolutePostBorderPosition = self._absolutePostMarginPosition;

        let border = self.getBorderWidth ();

        self._absolutePostBorderSize.x -= 2.0f * border;
        self._absolutePostBorderPosition.x += border;

        self._absolutePostBorderSize.y -= 2.0f * border;
        self._absolutePostBorderPosition.y += border;
    }

    /**
     * Compute the size of the content box, the padding box less the paddings
     * */
    @{final}
    prv fn computePostPaddingSize (mut self) {
        self._absoluteSize = self._absolutePostBorderSize;
        self._absolutePosition = self._absolutePostBorderPosition;

        let padding = self.getPaddings (self._containerSize);

        self._absoluteSize.y -= padding.x;
        self._absolutePosition.y += padding.x;
        self._absoluteSize.y -= padding.y;

        self._absoluteSize.x -= padding.z;
        self._absolutePosition.x += padding.z;
        self._absoluteSize.x -= padding.w;
    }

    /**
     * @returns: the depth to apply to the shape
     * */
    fn getDepth (self, kind : WidgetShapeKind)-> u32 {
        match kind {
            WidgetShapeKind::BORDER => { self._depth - 4 }
            WidgetShapeKind::BACKGROUND => { self._depth - 3 }
            WidgetShapeKind::IMAGE => { self._depth - 2 }
            WidgetShapeKind::SELECTION => { self._depth - 1 }
            WidgetShapeKind::TEXT => { self._depth }
        }
    }

    /**
     * @returns: the space the margins take around the border box, (horizontal, vertical)
     * @params:
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     * */
    @{final}
    pub fn getMarginSize (self, container : vec2)-> vec2 {
        if !self._currentStyle.isDisplayed () { return makeVec2 (0.0f, 0.0f); }

        let margin = self.getMargins (container);
        makeVec2 (margin.z + margin.w, margin.x + margin.y)
    }

    /**
     * @returns: the space the borders and the paddings take in the border box, (horizontal, vertical)
     * @params:
     *    - container: the size of the content box of the parent, a component being INDEFINITE_SIZE when it is unknown
     * */
    @{final}
    pub fn getFrame (self, container : vec2)-> vec2 {
        let padding = self.getPaddings (container);
        let border = 2.0f * self.getBorderWidth ();
        makeVec2 (border + padding.z + padding.w, border + padding.x + padding.y)
    }

    /**
     * @returns: the line width of the border, in pixels
     * */
    fn getBorderWidth (self)-> f32 {
        if self._currentStyle.borderWidth.0 {
            cast!f32 (self._currentStyle.borderWidth.1)
        } else { 0.0f }
    }

    /**
     * @returns: the size of the margins (top, bottom, left, right)
     * @params:
     *    - container: the size of the content box of the parent, the percentages being parts of it on the same axis
     * */
    fn getMargins (self, container : vec2)-> vec4 {
        self.getSides (self._currentStyle.getMargins (), container)
    }

    /**
     * @returns: the size of the paddings (top, bottom, left, right)
     * @params:
     *    - container: the size of the content box of the parent, the percentages being parts of it on the same axis
     * */
    fn getPaddings (self, container : vec2)-> vec4 {
        self.getSides (self._currentStyle.getPaddings (), container)
    }

    /**
     * @returns: the size of the four sides of a margin or a padding (top, bottom, left, right)
     * @params:
     *    - sides: the lengths of the top, bottom, left and right sides
     *    - container: the size of the content box of the parent, the percentages being parts of it on the same axis,
     *                 and 0 when it is unknown
     * */
    @{final}
    fn getSides (self, sides : [Length; 4], container : vec2)-> vec4 {
        makeVec4 ((sides [0]).resolve (container.y),
                  (sides [1]).resolve (container.y),
                  (sides [2]).resolve (container.x),
                  (sides [3]).resolve (container.x))
    }

}
