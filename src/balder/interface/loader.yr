in loader;

pub mod ::parser;
pub mod ::registry;

use balder::core::error;
use balder::interface::loader::parser;
use balder::interface::loader::registry::error;

use std::fs::_;
use std::syntax::errors;

/**
 * @returns: the content of a file
 * @params:
 *    - path: the path of the file, qualified (res:/) or not
 * @throws: when the file cannot be read
 * */
pub fn readFile(path: [c8])-> [c8]
    throws BalderError
{
    let completePath = balder::utils::path::projectPath(path);
    {
        let dmut file = File::open(completePath);
        file:.readAll()
    } catch {
        _: &FsError => {
            throw copy BalderError("File not found : " ~ completePath.toStr());
        }
    }
}

/**
 * @returns: the document of a .gui file
 * @params:
 *    - path: the path of the file, qualified (res:/) or not, naming it in the errors
 * @throws: when the file cannot be read, or is not a .gui document
 * */
pub fn readGuiFile(path: [c8])-> Document
    throws BalderError
{
    let content = readFile(path);
    {
        let dmut reader = GuiReader(content);
        reader:.read()
    } catch {
        e: &SyntaxError => {
            throw copy LoadError(path, e.msg, e.line, e.col);
        }
    }
}
