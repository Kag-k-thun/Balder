in shape;

use balder::core::{dispose, error};
use balder::interface::drawer;
use balder::interface::shape::rounded;
use balder::math::vector;

use ::vulkan::core;

pub mod ::color;
pub mod ::texture;
pub mod ::list;
pub mod ::text;
pub mod ::rounded;

/**
 * The data of a shape read by the shaders, in the slot of the shape in the storage buffer of the drawer (std430)
 * */
pub record World {
    pub let mut pos : vec2 = vec2 ();
    pub let mut size : vec2 = vec2 ();
    pub let mut color : vec4 = vec4 ();

    // The rectangle the shape is cut to, its corners in CSS pixels
    pub let mut scissors : vec4 = vec4 ();

    // The widths of the ring the shape is drawn as (top, bottom, left, right), the whole shape being drawn when they
    // are all 0
    pub let mut edges : vec4 = vec4 ();

    // The rectangle the shape is drawn in, its corners in CSS pixels, and the radii of its corners clockwise from the
    // top left one
    pub let mut box : vec4 = vec4 ();
    pub let mut radii : vec4 = vec4 ();

    pub let mut level : u32 = 0;
            
    pub self () {}
}

/**
 * The size of the slot of a shape in the storage buffer of the drawer, World padded to the alignment of its vec4
 * */
pub def WORLD_STRIDE = 112us;

/**
 * The number of indices of the quad of the drawer, drawn by the color and the texture shapes
 * */
pub def QUAD_INDICES = 6u32;

/**
 * The pipelines drawing the shapes
 * */
pub enum ShapeKind
| COLOR   = 0u32
| TEXTURE = 1u32
| TEXT    = 2u32;

/**
 * A draw of a shape, drawn with the draws before it in the same multi-draw when they share its pipeline and its
 * descriptor set
 * */
@data
pub record ShapeDraw {

    // The pipeline of the draw
    pub let kind : ShapeKind;

    // The descriptor set of the draw among those of its pipeline (the page of the atlas of a text...)
    pub let key : usize;

    // The draw, its first instance being the slot of the shape
    pub let command : VkDrawIndexedIndirectCommand;
}

/**
 * Ancestor class of shapes that are drawn in 2D by the ShapeDrawer
 * */
@abstract
pub class Shape {

    pub let uid : usize;

    let dmut _context : &ShapeDrawer;

    // The slot of the shape in the storage buffer of the drawer
    let _slot : u32;

    // True once the slot was given back to the drawer
    let mut _disposed : bool = false;

    let mut _hidden : bool = false;    
    let mut _needRedraw : bool = false;

    // True when the world was modified since the last commit, a new shape uploading its world at its first commit
    let mut _changed : bool = true;

    let mut _world : World = World ();

    // True once the box of the shape was set, the shape being drawn in its whole quad until then
    let mut _ownBox : bool = false;

    // The visibility the draws are recorded with, the one of the last commit
    let mut _drawnHidden : bool = false;
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (uid : usize, dmut drawer : &ShapeDrawer)
        with uid = uid
        , _context = alias drawer
        , _slot = drawer:.allocObject ()
        throws BalderError
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Change the position of the shape in the window (in pixels, (0,0) being top left corner)
     * */
    pub fn setPosition (mut self, pos : vec2) {
        if self._world.pos != pos {
            self._world.pos = pos;
            self._changed = true;
        }
    }

    /**
     * Change the size of the shape in the window (in pixels)
     */
    pub fn setSize (mut self, size : vec2) {
        if self._world.size != size {
            self._world.size = size;
            self._changed = true;
        }
    }

    /**
     * Change the level of the shape, the shapes being drawn from the lowest level to the highest
     */
    pub fn setLevel (mut self, v : u32) {
        if self._world.level != v {
            self._world.level = v;
            self._changed = true;
            self._context:.reorder (alias self);
        }
    }

    /**
     * Change the color of the shape
     */
    pub fn setColor (mut self, v : vec4) {
        if self._world.color != v {
            self._world.color = v;
            self._changed = true;
        }
    }
    
    /**
     * Change the box the shape is drawn in, the shape being cut to it: a quad rounded at its corners, an image cut to the
     * padding box of its widget
     * */
    pub fn setBox (mut self, box : RoundedBox) {
        let corners = makeVec4 (box.pos.x, box.pos.y, box.pos.x + box.size.x, box.pos.y + box.size.y);
        self._ownBox = true;
        if self._world.box != corners || self._world.radii != box.radii {
            self._world.box = corners;
            self._world.radii = box.radii;
            self._changed = true;
        }
    }

    /**
     * Draw the shape as a ring along the sides of its box, of the widths (top, bottom, left, right) in CSS pixels, the
     * inside being left out, or as a whole when they are all 0
     * */
    pub fn setEdges (mut self, widths : vec4) {
        if self._world.edges != widths {
            self._world.edges = widths;
            self._changed = true;
        }
    }

    /**
     * Change the scissors of the shape
     */
    pub fn setScissors (mut self, pos : vec2, size : vec2) {
        let scissors = makeVec4 (pos.x, pos.y, pos.x + size.x, pos.y + size.y);
        if scissors != self._world.scissors {
            self._world.scissors = scissors;
            self._changed = true;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          HIDE/SHOW          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn level (self)-> u32 {
        self._world.level
    }
    
    /**
     * Hide the shape in the next drawing
     * */
    @final
    pub fn hide (mut self) {
        if !self._hidden {
            self._hidden = true;
            self._needRedraw = true;
        }
    }

    /**
     * Show the shape in the next drawing
     * */
    @final
    pub fn show (mut self) {
        if self._hidden {
            self._hidden = false;
            self._needRedraw = true;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          COMMIT          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Commit the modifications of the shape to be rendered in the next frame, the draws being recorded with the state
     * of the last commit only, so a frame never shows a modification without the others made with it
     * */
    pub fn commit (mut self) {
        if self._changed {
            if !self._ownBox {
                let end = self._world.pos + self._world.size;
                self._world.box = makeVec4 (self._world.pos.x, self._world.pos.y, end.x, end.y);
            }

            self._context:.writeObject (self._slot, self._world);
            self._changed = false;
        }

        if self._needRedraw {
            self._drawnHidden = self._hidden;
            self._context:.redraw ();
            self._needRedraw = false;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iif the shape is hidden (and therefore must not be drawn)
     * */
    @final
    pub fn isHidden (self)-> bool {
        self._hidden 
    }

    /**
     * @returns: true iif the shape was visible at the last commit, the draws being recorded with that state
     * */
    @final
    pub fn isDrawn (self)-> bool {
        !self._drawnHidden
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the draws of the shape, laid out in its drawing order at each recording
     * */
    pub fn getDraws (self)-> [ShapeDraw];

    /**
     * @returns: a draw of 'nbIndices' indices of the shape
     * */
    @final
    prot fn makeDraw (self, kind : ShapeKind, key : usize, nbIndices : u32, firstIndex : u32 = 0u32, vertexOffset : i32 = 0)-> ShapeDraw {
        let mut cmd = VkDrawIndexedIndirectCommand ();
        cmd.indexCount = nbIndices;
        cmd.instanceCount = 1u32;
        cmd.firstIndex = firstIndex;
        cmd.vertexOffset = vertexOffset;
        cmd.firstInstance = self._slot;

        ShapeDraw (kind, key, cmd)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        /**
         * Give back the slot of the shape
         * @warning: through a retire, the recordings in use may still draw the shape
         * */
        pub over dispose (mut self) {
            if self._disposed { return; }

            self._disposed = true;
            self._context:.freeObject (self._slot);
        }
    }

}
