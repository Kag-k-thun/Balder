in drawer;

use balder::utils;
use balder::core::{_, application::_, driver::_};
use balder::core::config::shader;
use balder::core::config::shader::_;
use balder::core::shader::{_, buffers::_};
use balder::interface::shape::_;
use balder::interface::font::{atlas, chain, layout};
use balder::math::vector;

use std::math;
use std::algorithm::comparison;

use ::vulkan::core;


/**
 * Shape drawer that draws 2D elements on the window
 * */
@final
pub class ShapeDrawer {

    let dmut _window : &Window;
    let dmut _subpass : &DrawSubpass;
    
    // The dimension of the drawing area in CSS pixels, the window being scaled by its DPI
    let mut _windowDimension : uvec2 = uvec2 ();

    // The number of pixels in a CSS pixel the dimension of the drawing area was computed at
    let mut _scale : f32 = 1.0f;
    
    let dmut _colorShader : &RefCount!{&Shader};        
    let dmut _textureShader : &RefCount!{&Shader};    
    let dmut _textShader : &RefCount!{&Shader};

    // The glyphs drawn by the text shapes
    let dmut _atlas : &GlyphAtlas;
    
    let dmut _quadColorVBO   : &VertexBufferObject = copy VertexBufferObject ();
    let dmut _quadTextureVBO : &VertexBufferObject = copy VertexBufferObject ();
    let dmut _quadIBO        : &IndexBufferObject!{u16} = copy IndexBufferObject!{u16} ();        

    // The quads of the text shapes
    let dmut _textPool : &GeometryPool;

    // The worlds of the shapes, one slot per shape
    let dmut _objects : (&ObjectStorage)? = none;

    // The draws of the shapes laid out by the recording of each frame
    let dmut _batch : &DrawBatch;

    // The descriptor set of the color shapes
    let dmut _colorSet : (&DescriptorSet)? = none;

    // The descriptor set of each texture shape, by uid
    let dmut _textureSets : [usize => &DescriptorSet] = copy [];

    // The descriptor set of each page of the atlas sampled by the text shapes
    let dmut _pageSets : [u32 => &DescriptorSet] = copy [];

    // The shape sorted by their drawing order
    let dmut _shapeList : &ShapeList = copy ShapeList ();

    // The shapes the draws are recorded with, those of the shape list at the last commit
    let dmut _drawn : [&Shape] = [];

    // The shapes removed since the last commit, retired once they are not drawn anymore
    let dmut _removed : [&Shape] = [];

    // True when the shape list changed since the last commit
    let mut _listChanged : bool = false;
    
    let dmut _uid       : usize = 1us;
    let mut _needRedraw : bool = false;    
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (dmut win : &Window)
        with _window = alias win
        , _colorShader = win:.emptyResource!{&RasterShader} ()
        , _textureShader = win:.emptyResource!{&RasterShader} ()
        , _textShader = win:.emptyResource!{&RasterShader} ()
        , _atlas = copy GlyphAtlas (win:.getVulkanDevice ())
        , _textPool = copy GeometryPool (win:.getVulkanDevice (), 4u32)
        , _batch = copy DrawBatch (win:.getVulkanDevice ())
        , _subpass = alias win:.getVulkanDevice ():.getSwapchain ():.getRenderPass ()
    {
        let dim = win.getDimension ();
        self._scale = win.getScale ();
        self._windowDimension = layoutDimension (dim._0, dim._1, self._scale);
    }

    __dtor (mut self) {
        self:.dispose ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Configure the widget drawer on the given window
     * */
    pub fn configure (mut self)
        throws BalderError
    {
        let dmut device = self._window:.getVulkanDevice ();
        
        self._colorShader = self._window:.loadResource!{&RasterShader} (DefaultShaders::COLOR_2D);                        
        self._textureShader = self._window:.loadResource!{&RasterShader} (DefaultShaders::TEXTURE_2D);
        self._textShader = self._window:.loadResource!{&RasterShader} (DefaultShaders::TEXT_2D);

        self._objects = (copy ObjectStorage (alias device, WORLD_STRIDE))?;
        self._colorSet = (alias self._colorShader:.get ():.allocateDescriptorSet (DescriptorContext::OBJECT))?;
                
        self._quadIBO:.update (alias device, copy [1u32, 0u32, 2u32,
                                                   2u32, 0u32, 3u32]);

        self._quadColorVBO:.update (alias device,
                                    4us,
                                    copy [-1.0f, -1.0f,
                                          -1.0f, 1.0f,
                                          1.0f, 1.0f,
                                          1.0f, -1.0f]);

        self._quadTextureVBO:.update (alias device,
                                      4us,
                                      copy [-1.0f, -1.0f, 0.0f, 0.0f,
                                            -1.0f, 1.0f, 0.0f, 1.0f,
                                            1.0f, 1.0f, 1.0f, 1.0f,
                                            1.0f, -1.0f, 1.0f, 0.0f]);
        
        self._subpass:.onDraw ():.connect (&self:.onPassDraw);
    } catch {
        err => {
            log::error #("Drawer", "Failed to create widget drawer", err);
            throw err;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the window on which the drawing is done
     * */
    pub fn getWindow (mut self)-> dmut &Window {
        alias self._window
    }

    /**
     * @returns: the dimension of the drawing area, in CSS pixels
     * */
    pub fn getDimension (self)-> uvec2 {
        self._windowDimension
    }

    /**
     * @returns: the number of pixels in a CSS pixel, the scale of the interface at the DPI of the window when the
     * dimension of the drawing area was last computed
     * */
    pub fn getScale (self)-> f32 {
        self._scale
    }

    /**
     * @returns: the position in CSS pixels of the pixel ('x', 'y') of the window, those of the mouse signals
     * */
    pub fn toLayout (self, x : i32, y : i32)-> vec2 {
        let (w, h) = self._window.getDimension ();
        if w == 0u32 || h == 0u32 { return makeVec2 (cast!f32 (x), cast!f32 (y)); }

        makeVec2 (cast!f32 (x) * cast!f32 (self._windowDimension.x) / cast!f32 (w),
                  cast!f32 (y) * cast!f32 (self._windowDimension.y) / cast!f32 (h))
    }

    /**
     * @returns: the dimension in CSS pixels of the framebuffer the shapes are drawn on, at the scale of the drawing area
     * @info: differs from the dimension of the drawing area while the window is resized, the swapchain being recreated
     * at the new size before the widgets are laid out at it; drawn at this dimension, they keep their size meanwhile
     * */
    pub fn getFramebufferDimension (self)-> uvec2 {
        let (w, h) = self._subpass.getDimension ();
        if w == 0u32 || h == 0u32 { return self._windowDimension; }

        layoutDimension (w, h, self._scale)
    }

    /**
     * @returns: the number of framebuffer pixels in a CSS pixel along each axis, unquantised
     * */
    pub fn getFramebufferRatio (self)-> vec2 {
        let (w, h) = self._subpass.getDimension ();
        let dim = self.getFramebufferDimension ();
        if w == 0u32 || h == 0u32 { return makeVec2 (1.0f, 1.0f); }

        makeVec2 (cast!f32 (w) / cast!f32 (dim.x), cast!f32 (h) / cast!f32 (dim.y))
    }

    /**
     * @returns: the number of device pixels in a CSS pixel, the texts are shaped at, quantised to a quarter of pixel
     * @info: the scale of the drawing area, not the framebuffer over it: while the window is resized the framebuffer
     * still has the size of the last swapchain, and the ratio would change at each resize
     * */
    pub fn getPixelRatio (self)-> f32 {
        self._scale
    }

    /**
     * @returns: the atlas holding the glyphs of the text shapes
     * */
    pub fn getGlyphAtlas (mut self)-> dmut &GlyphAtlas {
        alias self._atlas
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ADDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register a color quad in the window to draw
     * */
    pub fn registerColorQuad (mut self, position : vec2 = vec2 (), color : vec4 = vec4 (), size : vec2 = vec2 (), level : u32 = 1)-> dmut &ColorShape
        throws BalderError
    {        
        {
            let dmut result = copy ColorShape (self._uid, alias self);
            self._uid += 1;
            
            result:.setPosition (position);
            result:.setSize (size);                
            result:.setColor (color);                
            result:.setLevel (level);
            result:.show ();

            atomic self {
                self._shapeList:.insert (alias result);
                self._listChanged = true;
            }
            
            self:.redraw ();
            
            return alias result;            
        }
    }

    /**
     * Register a textured quad in the window to draw
     * */
    pub fn registerTextureQuad (mut self, dmut texture : &RefCount!{&Texture}, position : vec2 = vec2 (), color : vec4 = vec4 (), size : vec2 = vec2 (), level : u32 = 1)-> dmut &TextureShape
        throws BalderError
    {        
        {
            let dmut result = copy TextureShape (self._uid, alias self, alias texture);

            self._uid += 1;
            
            result:.setPosition (position);
            result:.setSize (size);                
            result:.setColor (color);
            result:.setLevel (level);

            atomic self {            
                self._shapeList:.insert (alias result);
                self._listChanged = true;
            }
                
            self:.redraw ();
            return alias result;            
        }
    }

    /**
     * Register a text in the window to draw
     * @params:
     *    - chain: the faces the text was shaped with
     *    - text: the lines of the text, laid out in device pixels
     * */
    pub fn registerText (mut self, dmut chain : &FontChain, text : TextLayout, position : vec2 = vec2 (), color : vec4 = vec4 (), level : u32 = 1)-> dmut &TextShape
        throws BalderError
    {
        {
            let dmut result = copy TextShape (self._uid, alias self, alias self._atlas);

            self._uid += 1;

            result:.setText (alias chain, text, self.getPixelRatio ());
            result:.setPosition (position);
            result:.setColor (color);
            result:.setLevel (level);

            atomic self {
                self._shapeList:.insert (alias result);
                self._listChanged = true;
            }

            self:.redraw ();
            return alias result;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SHAPE DATA          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Reserve the slot of a shape in the storage buffer of the worlds
     * */
    pub fn allocObject (mut self)-> u32
        throws BalderError
    {
        if let Ok (dmut objects) = alias self._objects {
            return objects:.alloc ();
        }

        throw copy BalderError ("Shape drawer not configured");
    }

    /**
     * Give back the slot of a shape
     * */
    pub fn freeObject (mut self, slot : u32) {
        if let Ok (dmut objects) = alias self._objects {
            objects:.free (slot);
        }
    }

    /**
     * Write the world of a shape in its slot, drawn from the next submission
     * */
    pub fn writeObject (mut self, slot : u32, world : World) {
        if let Ok (dmut objects) = alias self._objects {
            objects:.setData (slot, 0us, world);
        }
    }

    /**
     * Allocate the descriptor set of a texture shape, binding its texture
     * */
    pub fn allocTextureSet (mut self, uid : usize, dmut texture : &Texture)
        throws BalderError
    {
        let dmut set = self._textureShader:.get ():.allocateDescriptorSet (DescriptorContext::OBJECT);
        set:.setTexture (TextureKind::ALBEDO, texture);

        atomic self {
            self._textureSets [uid] = alias set;
        }
    }

    /**
     * Dispose the descriptor set of a texture shape
     * @assume: the recordings in use do not draw the shape anymore (it was retired)
     * */
    pub fn freeTextureSet (mut self, uid : usize) {
        atomic self {
            if let Ok (dmut set) = alias self._textureSets [uid] {
                set:.dispose ();
                self._textureSets:.remove (uid);
            }
        }
    }

    /**
     * Allocate the descriptor set of a page of the atlas, the first time a text samples it
     * */
    pub fn selectPage (mut self, page : u32)
        throws BalderError
    {
        atomic self {
            if page in self._pageSets { return; }

            let dmut set = self._textShader:.get ():.allocateDescriptorSet (DescriptorContext::OBJECT);
            set:.setTexture (TextureKind::ALBEDO, self._atlas:.getPage (page));
            self._pageSets [page] = alias set;
        }
    }

    /**
     * Place the quads of a text in the text pool
     * @params:
     *    - points: the corners and the texture coordinates of the quads, four floats per corner
     *    - indices: the indices of the quads, counting from their first corner
     * @returns: the range of the quads, to retire once they are not drawn anymore
     * */
    pub fn allocText (mut self, points : [f32], indices : [u32])-> dmut &GeometryRange
        throws BalderError
    {
        self._textPool:.alloc (points, indices)
    }

    /**
     * Dispose an object only the shapes draw (a removed shape, the quads of a text), once the recordings of the subpass
     * of the drawer no longer reference it
     * @info: requests the redraw of the subpass itself, the recordings of the other subpasses staying valid
     * */
    pub fn retire {T impl Disposable} (mut self, dmut obj : T) {
        self._subpass:.retire (&obj:.dispose);
    }

    /**
     * Move a shape whose level changed to its place in the drawing order, the shapes being drawn from the lowest level
     * to the highest
     * @params:
     *    - shape: the shape whose level changed
     * */
    pub fn reorder (mut self, dmut shape : &Shape) {
        atomic self {
            if let Ok (dmut sh) = alias self._shapeList:.remove (shape.uid) {
                self._shapeList:.insert (alias sh);
                self._listChanged = true;
                self._needRedraw = true;
            }
        }
    }

    /**
     * Remove a shape from the drawer, still drawn until the next commit
     * @params:
     *    - uid: the uid of the shape to remove
     * */
    pub fn removeShape (mut self, uid : usize) {
        let removed = atomic self {
            if let Ok (dmut sh) = alias self._shapeList:.remove (uid) {
                self._removed ~= [alias sh];
                self._listChanged = true;
                self._needRedraw = true;
                true
            } else {
                false
            }
        };
        
        if !removed {                    
            log::error #("ShapeDrawer", "Removing a shape that was not created by the drawer ? -> ", uid);            
        }
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Method connected to the signal of the drawing subpass
     * @trigger: the subpass is redrawn
     * */
    fn onPassDraw (mut self) {
        let dmut cmd = copy IndexedDrawCommandAllocator (alias self._subpass);
        let frame = self._subpass.getCurrentFrame ();
        
        atomic self {
            let runs = self:.layoutDraws (frame);

            {
                let dmut cSh = alias self._colorShader:.get ();
                let dmut tSh = alias self._textureShader:.get ();
                let dmut xSh = alias self._textShader:.get ();

                { // pushing the dimension of the framebuffer, the one of the drawing area once the widgets are laid out at its size
                    cSh.select (cmd.getCommandBuffer ());                    
                    cSh:.setPush (cmd.getCommandBuffer (), UniformNames::WINDOW, WindowPush (self.getFramebufferDimension (), self.getFramebufferRatio ()));
                }

                let mut current = ShapeKind::COLOR;
                for i, r in runs {
                    if i == 0us || r.kind != current {
                        current = r.kind;
                        match r.kind {
                            ShapeKind::COLOR => {
                                cSh.select (cmd.getCommandBuffer ());
                                self._quadColorVBO.select (cmd.getCommandBuffer ());
                                self._quadIBO.select (cmd.getCommandBuffer ());
                            }
                            ShapeKind::TEXTURE => {
                                tSh.select (cmd.getCommandBuffer ());
                                self._quadTextureVBO.select (cmd.getCommandBuffer ());
                                self._quadIBO.select (cmd.getCommandBuffer ());
                            }
                            ShapeKind::TEXT => {
                                xSh.select (cmd.getCommandBuffer ());
                                self._textPool.select (cmd.getCommandBuffer ());
                            }
                        }
                    }

                    self:.selectSet (frame, cmd.getCommandBuffer (), r.kind, r.key);
                    cmd:.drawIndexed (self._batch, r.first, r.count);
                }
            } catch {
                err => log::error #("ShapeDrawer", "Failed to draw...", err);                    
            }
        }
    }

    /**
     * Lay out the draws of the shapes drawn by the recording of a frame, in their drawing order
     * @atomic
     * @returns: the runs of draws sharing their pipeline and their descriptor set, each drawn by one multi-draw
     * */
    fn layoutDraws (mut self, frame : u32)-> [DrawRun] {
        self._atlas:.advance ();
        self._batch:.begin (frame);

        let mut draws : [ShapeDraw] = [];
        for dmut s in alias self._drawn {
            if !s.isDrawn () { continue; }
            if let dmut t : &TextShape = alias s {
                t:.touchGlyphs ();
            }

            for d in s.getDraws () {
                self._batch:.add (frame, s.uid, copy [d.command]);
                draws ~= [d];
            }
        }

        {
            self._batch:.end (frame);
        } catch {
            err => {
                log::error #("ShapeDrawer", "Failed to lay out the draws", err);
                return [];
            }
        }

        splitRuns (draws)
    }

    /**
     * Bind the descriptor set of a run of draws, and the storage buffer of the worlds in it
     * @atomic
     * */
    fn selectSet (mut self, frame : u32, cmd : VkCommandBuffer, kind : ShapeKind, key : usize) {
        if let Ok (dmut objects) = alias self._objects {
            let dmut set = match kind {
                ShapeKind::COLOR => { alias self._colorSet }
                ShapeKind::TEXTURE => { alias self._textureSets [key] }
                ShapeKind::TEXT => { alias self._pageSets [cast!u32 (key)] }
            };

            if let Ok (dmut s) = alias set {
                s:.setBuffer (UniformNames::OBJECTS, objects.getBuffer (), frame);
                s.select (frame, cmd);
            }
        }
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          TRIGGERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Triggered when the window change size
     * */
    pub fn onWindowResize (mut self, x : u32, y : u32) {
        atomic self {
            self._scale = self._window.getScale ();
            self._windowDimension = layoutDimension (x, y, self._scale);
        }
    }

    @{final}
    pub fn redraw (mut self) {
        atomic self {
            self._needRedraw = true;
        }
    }

    /**
     * Commit the change of shapes in the last iteration, all drawn from the same frame
     * */
    pub fn commit (mut self) {
        {
            // A frame submitted in the middle of the commit would upload a part of it only
            self._window:.lockFrame ();

            let need = atomic self {            
                for dmut c in alias self._shapeList {
                    c:.commit ();
                }

                if self._listChanged {
                    let dmut drawn : [&Shape] = [];
                    for dmut c in alias self._shapeList {
                        drawn ~= [alias c];
                    }

                    self._drawn = alias drawn;
                    self._listChanged = false;
                }

                // Not drawn by the recordings to come, the ones in flight still using them
                for dmut r in alias self._removed {
                    self:.retire (alias r);
                }

                self._removed = [];

                let need = self._needRedraw;
                self._needRedraw = false;
                need
            };
        
            // The shapes are drawn by the subpass of the drawer only, the recordings of the other subpasses stay valid
            if need {
                self._window:.redrawPass (self._subpass);
            }
        } exit {
            self._window:.unlockFrame ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CLEARING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Clear all loaded widgets
     * */
    pub fn clear (mut self) {
        let dmut cp = atomic self {
            let dmut cp = alias self._shapeList;
            self._shapeList = copy ShapeList ();

            for dmut r in alias self._removed {
                self._window:.retire (alias r);
            }

            self._drawn = [];
            self._removed = [];
            self._listChanged = false;
            alias cp
        };
        
        for dmut c in alias cp {
            self._window:.retire (alias c);                
        }                    
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self:.clear ();

            atomic self {                                                        
                self._colorShader:.dispose ();
                self._textureShader:.dispose ();                                
                self._textShader:.dispose ();
                self._atlas:.dispose ();
                
                self._window:.retire (alias self._quadColorVBO);
                self._window:.retire (alias self._quadTextureVBO);
                self._window:.retire (alias self._quadIBO);                
                self._window:.retire (alias self._textPool);
                self._window:.retire (alias self._batch);

                if let Ok (dmut objects) = alias self._objects {
                    self._window:.retire (alias objects);
                    self._objects = none;
                }

                if let Ok (dmut set) = alias self._colorSet {
                    self._window:.retire (alias set);
                    self._colorSet = none;
                }

                for _, dmut set in alias self._pageSets {
                    self._window:.retire (alias set);
                }

                self._pageSets = copy [];
            }
        }
    }

}

/**
 * @returns: the dimension in CSS pixels of a window of 'w' x 'h' window units, at 'scale' units in a CSS pixel
 * */
fn layoutDimension (w : u32, h : u32, scale : f32)-> uvec2 {
    makeVec2 (max (1u32, cast!u32 (cast!f32 (w) / scale + 0.5f)), max (1u32, cast!u32 (cast!f32 (h) / scale + 0.5f)))
}

/**
 * The push constant of the 2D shaders
 * */
@data
record WindowPush {

    // The dimension of the framebuffer, in CSS pixels
    pub let dimension : uvec2;

    // The number of framebuffer pixels in a CSS pixel
    pub let ratio : vec2;
}

/**
 * A run of consecutive draws of the shapes sharing their pipeline and their descriptor set
 * */
@data
pub record DrawRun {

    // The pipeline of the draws
    pub let kind : ShapeKind;

    // The descriptor set of the draws among those of the pipeline
    pub let key : usize;

    // The index of the first draw
    pub let first : u32;

    // The number of draws
    pub let count : u32;
}

/**
 * Split draws laid out in their drawing order into runs of consecutive draws sharing their pipeline and their descriptor
 * set, the order being kept as the shapes overlap and blend
 * @returns: the runs, in the order of the draws
 * */
pub fn splitRuns (draws : [ShapeDraw])-> [DrawRun] {
    let mut runs : [DrawRun] = [];
    let mut start = 0us;
    for i in 1us .. draws.len + 1us {
        if i == draws.len || draws [i].kind != draws [start].kind || draws [i].key != draws [start].key {
            runs ~= [DrawRun (draws [start].kind, draws [start].key, cast!u32 (start), cast!u32 (i - start))];
            start = i;
        }
    }

    runs
}
