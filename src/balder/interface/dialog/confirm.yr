in confirm;

use balder::core::application::signal;
use balder::interface::widget::button;
use balder::interface::widget::text::label;

use ::sdl3::mouse;

/**
 * A confirm dialog asks to confirm an action, accepted by its accepting button (Enter, the button having the focus) or
 * cancelled by its cancelling one, emitting true when it is accepted and false when it is cancelled or dismissed
 * @example:
 * ===
 * let dmut d = copy ConfirmDialog ("Clear every field of the form?", accept-> "Clear");
 * d:.answered ():.connect (self.box, &self:.onClearAnswered);   // fn onClearAnswered (mut self, accepted: bool)
 * d:.open (DialogMode::OVERLAY, alias self.gui)?;
 * ===
 * */
pub class ConfirmDialog over Dialog {

    // The question asked
    let _question: [c8];

    // The texts of the accepting and of the cancelling buttons
    let _accept: [c8];
    let _cancel: [c8];

    // Emitted with the answer, true when the dialog is accepted, in the thread of the slots connected to it
    let dmut _answered: &Signal!{bool} = copy Signal!{bool} ();

    /**
     * @params:
     *    - question: the question asked
     *    - accept: the text of the accepting button, the action confirmed
     *    - cancel: the text of the cancelling button
     *    - title: the title of its window
     * */
    pub self (question: [c8], accept: [c8] = "OK", cancel: [c8] = "Cancel", title: [c8] = "")
        with super("res:/dialog/confirm.gui", "res:/dialog/confirm.toml", title)
        , _question = question
        , _accept = accept
        , _cancel = cancel
    {
        // the slots the 'on-…' attributes of confirm.gui name
        self:.slot("accept", &self:.onAcceptClicked);
        self:.slot("cancel", &self:.onCancelClicked);
    }

    /**
     * @returns: the signal emitted with the answer, true when the dialog is accepted
     * */
    pub fn answered(mut self)-> dmut &Signal!{bool} {
        alias self._answered
    }

    pub over dismiss(mut self) {
        self:.answer(false);
    }

    prot over onShow(mut self) {
        if let Ok(dmut question: &Label) = self:.find("QUESTION") {
            question:.setText(self._question);
        }

        if let Ok(dmut b: &Button) = self:.find("ACCEPT") {
            b:.setText(self._accept);
        }

        if let Ok(dmut b: &Button) = self:.find("CANCEL") {
            b:.setText(self._cancel);
        }

        self:.focus("ACCEPT");
    }

    fn onAcceptClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.answer(true);
        }
    }

    fn onCancelClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.answer(false);
        }
    }

    /**
     * Close the dialog then emit its answer, a dialog closed already answering nothing
     * */
    fn answer(mut self, accepted: bool) {
        if !self.isOpen { return; }

        self:.close();
        self._answered:.emit(accepted);
    }
}
