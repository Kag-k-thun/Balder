in message;

use balder::core::application::signal;
use balder::interface::widget::text::label;

use ::sdl3::mouse;

/**
 * The answer of a message dialog
 * */
pub enum MessageDialogStatus: u8
| YES    = 1
| NO     = 2
// The dialog was dismissed: its window closed, or Escape pressed
| CANCEL = 3;

/**
 * A message dialog asks a question answered by yes or no, emitting the answer by answered: YES, NO, or CANCEL when it is
 * dismissed
 * @example:
 * ===
 * let dmut d = copy MessageDialog ("Do you like it?");
 * d:.answered ():.connect (self.box, &self:.onLiked);   // fn onLiked (mut self, status: MessageDialogStatus)
 * d:.open (DialogMode::WINDOW, alias self.gui)?;
 * ===
 * */
pub class MessageDialog over Dialog {

    // The question asked
    let _message: [c8];

    // Emitted with the answer, in the thread of the slots connected to it
    let dmut _answered: &Signal!{MessageDialogStatus} = copy Signal!{MessageDialogStatus} ();

    /**
     * @params:
     *    - message: the question asked
     *    - title: the title of its window
     * */
    pub self (message: [c8], title: [c8] = "")
        with super("res:/dialog/message.gui", "res:/dialog/message.toml", title)
        , _message = message
    {
        // the slots the 'on-…' attributes of message.gui name
        self:.slot("yes", &self:.onYesClicked);
        self:.slot("no", &self:.onNoClicked);
    }

    /**
     * @returns: the signal emitted with the answer
     * */
    pub fn answered(mut self)-> dmut &Signal!{MessageDialogStatus} {
        alias self._answered
    }

    pub over dismiss(mut self) {
        self:.answer(MessageDialogStatus::CANCEL);
    }

    prot over onShow(mut self) {
        if let Ok(dmut question: &Label) = self:.find("QUESTION") {
            question:.setText(self._message);
        }

        self:.focus("YES");
    }

    fn onYesClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.answer(MessageDialogStatus::YES);
        }
    }

    fn onNoClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.answer(MessageDialogStatus::NO);
        }
    }

    /**
     * Close the dialog then emit its answer, a dialog closed already answering nothing
     * */
    fn answer(mut self, status: MessageDialogStatus) {
        if !self.isOpen { return; }

        self:.close();
        self._answered:.emit(status);
    }
}
