in utils;

use balder::interface::dialog::file::entry;
use balder::interface::widget::table::order;

use std::conv;
use std::fs::{path, sys};

/**
 * @returns: the entries of a directory, the directories first then by name, as people read them; none when it cannot
 * be read
 * @params:
 *    - directory: the path of the directory
 *    - filters: the extensions of the files listed, without their dot ("png"), every file when it is empty
 *    - hidden: true to list the entries whose name starts with a dot
 *    - directoriesOnly: true to list the directories only
 * */
pub fn listDirectory(directory: [c8], filters: [[c8]], hidden: bool, directoriesOnly: bool)-> [DirectoryEntry] {
    let mut dirs: [DirectoryEntry] = [];
    let mut files: [DirectoryEntry] = [];
    {
        for e in readDir(Path(directory)) {
            let name = e.path.file();
            if name == "" || name == "." || name == ".." { continue; }
            if !hidden && name[0us] == '.' { continue; }

            if isDir(e.path) {
                dirs ~= [DirectoryEntry(name-> name, isDirectory-> true)];
            } else if !directoriesOnly && matchesFilters(name, filters) {
                let size = {
                    cast!u64(fileSize(e.path).bytes)
                } catch {
                    _ => { 0u64 }
                };

                files ~= [DirectoryEntry(name-> name, size-> size)];
            }
        }
    } catch {
        _ => {
            return [];
        }
    }

    sortByName(dirs) ~ sortByName(files)
}

/**
 * @returns: true iif a file name has one of the extensions of the filters, ignoring the case, or the filters are empty
 * @params:
 *    - filters: the extensions, without their dot ("png")
 * */
pub fn matchesFilters(name: [c8], filters: [[c8]])-> bool {
    if filters.len == 0us { return true; }

    let ext = lowerCase(Path(name).extension());
    for f in filters {
        if lowerCase(f) == ext { return true; }
    }

    false
}

/**
 * @returns: the path a name typed in a file dialog designates: the directory for an empty name, the name itself when
 * it is absolute, the name in the directory otherwise, normalized ('..' going up)
 * @params:
 *    - directory: the absolute path of the directory the dialog shows
 *    - name: the name typed
 * */
pub fn resolveName(directory: [c8], name: [c8])-> [c8] {
    if name == "" { return directory; }

    let path = Path(name);
    if path.isAbsolute() {
        return path.normalize().toStr();
    }

    Path(directory).push(path).normalize().toStr()
}

/**
 * @returns: the directory above a directory, the root being its own parent
 * */
pub fn parentDirectory(directory: [c8])-> [c8] {
    let parent = Path(directory).parent();
    if parent.isEmpty() { return directory; }

    let text = parent.toStr();
    if text == "" { "/" } else { text }
}

/**
 * @returns: a size in bytes as people read it: "512 B", "1.5 KB", "12 MB", "2.1 GB"
 * */
pub fn sizeText(bytes: u64)-> [c8] {
    if bytes < 1024u64 {
        return to![c8] (bytes) ~ " B";
    }

    let units = copy ["KB", "MB", "GB", "TB"];
    let mut value = cast!f64(bytes) / 1024.0;
    let mut unit = 0us;
    while value >= 1024.0 && unit + 1us < units.len {
        value = value / 1024.0;
        unit += 1us;
    }

    // a decimal under 10 of the unit, none above
    let text = if value < 10.0 {
        let tenths = cast!u64(value * 10.0 + 0.5);
        to![c8] (tenths / 10u64) ~ "." ~ to![c8] (tenths % 10u64)
    } else {
        to![c8] (cast!u64(value + 0.5))
    };

    text ~ " " ~ units[unit]
}

/**
 * @returns: the kind of an entry as people read it: Folder, or the extension of a file in capitals then File
 * */
pub fn kindText(e: DirectoryEntry)-> [c8] {
    if e.isDirectory { return "Folder"; }

    let ext = Path(e.name).extension();
    if ext == "" { "File" } else { upperCase(ext) ~ " file" }
}

/**
 * @returns: the entries sorted by name, as people read them
 * */
fn sortByName(list: [DirectoryEntry])-> [DirectoryEntry] {
    let dmut sorted = copy list;
    std::algorithm::sorting::sort(alias sorted, |x, y| => { compareTexts(x.name, y.name) < 0 });
    sorted
}

/**
 * @returns: a text whose ASCII capitals are lowered
 * */
fn lowerCase(text: [c8])-> [c8] {
    copy [if c >= 'A'c8 && c <= 'Z'c8 { cast!c8(cast!u8(c) + 32u8) } else { c } for c in text]
}

/**
 * @returns: a text whose ASCII small letters are raised
 * */
fn upperCase(text: [c8])-> [c8] {
    copy [if c >= 'a'c8 && c <= 'z'c8 { cast!c8(cast!u8(c) - 32u8) } else { c } for c in text]
}
