in model;

use balder::interface::dialog::file::entry;
use balder::interface::widget::table::{model, order};

/**
 * The entries of a directory shown by the table of a file dialog: their name, their size and their kind, the
 * directories coming before the files whatever the column the rows are sorted by
 * */
pub class DirectoryModel over TableModel {

    // The entries, directories first then by name
    let mut _entries: [DirectoryEntry] = [];

    pub self () {}

    /**
     * Replace the entries, the table reading them again
     * */
    pub fn setEntries(mut self, entries: [DirectoryEntry]) {
        self._entries = entries;
        self.changed();
    }

    /**
     * @returns: the entry of a row
     * */
    pub fn getEntry(self, row: usize)-> DirectoryEntry {
        self._entries[row]
    }

    pub over len(self)-> usize {
        self._entries.len
    }

    pub over columns(self)-> usize {
        3us
    }

    pub over header(self, column: usize)-> [c8] {
        (copy ["Name", "Size", "Kind"])[column]
    }

    pub over text(self, row: usize, column: usize)-> [c8] {
        let e = self._entries[row];
        if column == 0us {
            e.name
        } else if column == 1us {
            if e.isDirectory { "" } else { utils::sizeText(e.size) }
        } else {
            utils::kindText(e)
        }
    }

    /**
     * The directories come before the files, the sizes compare by their value, the other texts as people read them
     * */
    pub over compare(self, a: usize, b: usize, column: usize)-> i32 {
        let x = self._entries[a], y = self._entries[b];
        if x.isDirectory != y.isDirectory {
            return if x.isDirectory { -1 } else { 1 };
        }

        if column == 1us && x.size != y.size {
            return if x.size < y.size { -1 } else { 1 };
        }

        compareTexts(self.text(a, column), self.text(b, column))
    }
}
