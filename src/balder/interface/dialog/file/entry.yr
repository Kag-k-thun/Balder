in entry;

/**
 * An entry of a directory listed by a file dialog
 * */
@data
pub record DirectoryEntry {

    // The name of the entry in its directory
    pub let name: [c8] = "";

    // True iif the entry is a directory, or a link to one
    pub let isDirectory: bool = false;

    // The size of a file in bytes, 0 for a directory
    pub let size: u64 = 0u64;
}
