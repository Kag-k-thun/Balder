in color;

pub mod ::utils;

use balder::core::application::signal;
use balder::interface::style;
use balder::interface::widget::box;
use balder::interface::widget::range::slider;
use balder::interface::widget::text::{input, spin};
use balder::math::vector;

use ::sdl3::mouse;

/**
 * A colour dialog chooses a colour by its red, green and blue channels and its opacity, each set by a slider or a spin
 * box, or by its hexadecimal code (#rrggbb, #rrggbbaa) or its name typed, a swatch showing it next to the colour the
 * dialog started from. It emits the colour chosen, its channels from 0 to 1, or none when it is cancelled or dismissed
 * @example:
 * ===
 * let dmut d = copy ColorDialog (color-> makeVec4 (0.2f, 0.5f, 0.9f, 1.0f));
 * d:.answered ():.connect (self.box, &self:.onColorChosen);   // fn onColorChosen (mut self, rgba: (vec4)?)
 * d:.open (DialogMode::OVERLAY, alias self.gui)?;
 * ===
 * */
pub class ColorDialog over Dialog {

    // The colour the dialog started from
    let _initial: vec4;

    // The colour chosen so far
    let mut _color: vec4;

    // Emitted with the colour chosen, none when the dialog is cancelled, in the thread of the slots connected to it
    let dmut _answered: &Signal!{(vec4)?} = copy Signal!{(vec4)?} ();

    /**
     * @params:
     *    - color: the colour the dialog starts from, its channels from 0 to 1
     *    - title: the title of its window
     * */
    pub self (color: vec4 = makeVec4(1.0f, 1.0f, 1.0f, 1.0f), title: [c8] = "")
        with super("res:/dialog/color.gui", "res:/dialog/color.toml", title)
        , _initial = color
        , _color = color
    {
        // the slots the 'on-…' attributes of color.gui name, a slider and a spin box sharing the slot of their channel
        self:.slot("red", &self:.onRedChanged);
        self:.slot("green", &self:.onGreenChanged);
        self:.slot("blue", &self:.onBlueChanged);
        self:.slot("opacity", &self:.onOpacityChanged);
        self:.slot("hex", &self:.onHexValidated);
        self:.slot("accept", &self:.onAcceptClicked);
        self:.slot("cancel", &self:.onCancelClicked);
    }

    /**
     * @returns: the signal emitted with the colour chosen, none when the dialog is cancelled
     * */
    pub fn answered(mut self)-> dmut &Signal!{(vec4)?} {
        alias self._answered
    }

    /**
     * @returns: the colour chosen so far, its channels from 0 to 1
     * */
    pub fn getColor(self)-> vec4 {
        self._color
    }

    pub over dismiss(mut self) {
        self:.answer(none);
    }

    prot over onShow(mut self) {
        self:.paint("INITIAL", self._initial);
        self:.showColor();
        self:.focus("ACCEPT");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLOTS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn onRedChanged(mut self, value: f32) {
        self._color = makeVec4(value / 255.0f, self._color.y, self._color.z, self._color.w);
        self:.showColor();
    }

    fn onGreenChanged(mut self, value: f32) {
        self._color = makeVec4(self._color.x, value / 255.0f, self._color.z, self._color.w);
        self:.showColor();
    }

    fn onBlueChanged(mut self, value: f32) {
        self._color = makeVec4(self._color.x, self._color.y, value / 255.0f, self._color.w);
        self:.showColor();
    }

    fn onOpacityChanged(mut self, value: f32) {
        self._color = makeVec4(self._color.x, self._color.y, self._color.z, value / 100.0f);
        self:.showColor();
    }

    /**
     * Take the colour typed, the code of the colour chosen being written again when the text writes none
     * */
    fn onHexValidated(mut self, text: [c8]) {
        if let Ok(rgba) = utils::parseColor(text) {
            self._color = rgba;
        }

        self:.showColor();
    }

    fn onAcceptClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.answer((self._color)?);
        }
    }

    fn onCancelClicked(mut self, b: u8) {
        if b == SDL_BUTTON_LEFT {
            self:.answer(none);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          WIDGETS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Show the colour chosen in every widget of the dialog: the sliders, the spin boxes, the code and the swatch, none of
     * them emitting their signal
     * */
    fn showColor(mut self) {
        let c = self._color;
        self:.setChannel("RED", cast!f32(utils::toByte(c.x)));
        self:.setChannel("GREEN", cast!f32(utils::toByte(c.y)));
        self:.setChannel("BLUE", cast!f32(utils::toByte(c.z)));
        self:.setChannel("OPACITY", cast!f32(cast!u32(c.w * 100.0f + 0.5f)));

        if let Ok(dmut i: &InputText) = self:.find("HEX") {
            i:.setText(utils::hexText(c));
        }

        self:.paint("CHOSEN", c);
    }

    /**
     * Set the slider of a channel and its spin box, named after it with _VALUE
     * */
    fn setChannel(mut self, name: [c8], value: f32) {
        if let Ok(dmut s: &Slider) = self:.find(name) {
            s:.setValue(value);
        }

        if let Ok(dmut s: &SpinBox) = self:.find(name ~ "_VALUE") {
            s:.setValue(value);
        }
    }

    /**
     * Fill a swatch of the dialog with a colour, as the background of its inline style
     * */
    fn paint(mut self, name: [c8], rgba: vec4) {
        if let Ok(dmut b: &Box) = self:.find(name) {
            let dmut filled = copy Style();
            filled:.merge(b.getInlineStyle());
            filled.backgroundColor = (true, rgba);
            b:.setInlineStyle(filled);
        }
    }

    /**
     * Close the dialog then emit its answer, a dialog closed already answering nothing
     * */
    fn answer(mut self, rgba: (vec4)?) {
        if !self.isOpen { return; }

        self:.close();
        self._answered:.emit(rgba);
    }
}
