in utils;

use balder::interface::loader::parser;
use balder::math::vector;

use std::algorithm::comparison;

/**
 * @returns: the channel of a colour from 0 to 1 as a number from 0 to 255, rounded
 * */
pub fn toByte(channel: f32)-> u32 {
    cast!u32(min(1.0f, max(0.0f, channel)) * 255.0f + 0.5f)
}

/**
 * @returns: a colour written in hexadecimal as in CSS, #rrggbb when it is opaque, #rrggbbaa otherwise
 * */
pub fn hexText(rgba: vec4)-> [c8] {
    let text = "#" ~ hexByte(toByte(rgba.x)) ~ hexByte(toByte(rgba.y)) ~ hexByte(toByte(rgba.z));
    if toByte(rgba.w) == 255u32 { text } else { text ~ hexByte(toByte(rgba.w)) }
}

/**
 * @returns: the colour a text typed in a colour dialog writes, as in the style sheets (#rrggbb, #rgba, steelblue,
 * rgb(56 139 253), hsl(214 98% 61%), #388bfd / 40%), the # of a hexadecimal code being optional; none when it writes
 * none
 * */
pub fn parseColor(text: [c8])-> (vec4)? {
    let mut start = 0us;
    while start < text.len && text[start] == ' 'c8 { start += 1us; }

    let mut end = text.len;
    while end > start && text[end - 1us] == ' 'c8 { end -= 1us; }

    let trimmed = text[start .. end];
    if trimmed.len == 0us { return none; }

    if let Ok(rgba) = decodeColor(trimmed) {
        return (rgba)?;
    }

    decodeColor("#" ~ trimmed)
}

/**
 * @returns: the colour a text writes as in the style sheets, none when it writes none
 * */
fn decodeColor(text: [c8])-> (vec4)? {
    {
        let dmut scanner = copy Scanner(text);
        let dmut reader = ValueReader(alias scanner);
        let rgba = Color(reader:.read()).rgba;
        return (rgba)?;
    } catch {
        _ => {
            return none;
        }
    }
}

/**
 * @returns: a number from 0 to 255 written with two hexadecimal digits
 * */
fn hexByte(value: u32)-> [c8] {
    let digits = "0123456789abcdef";
    copy [digits[(value >> 4u32) & 0xFu32], digits[value & 0xFu32]]
}
