in activity;

use balder::core::application::_;
use balder::utils::log;

/**
 * The activity showing a dialog in a window of its own, opened by Dialog.open in the mode WINDOW: the dialog is the
 * content of its window, which is closed when the dialog is answered, closing it or pressing Escape dismissing it
 * */
pub class DialogActivity over Activity {

    // The dialog shown, none until the dialog gives itself (host)
    let dmut _dialog: (&Dialog)? = none;

    // True once the application started the activity
    let mut _started: bool = false;

    pub self (uid: usize, dmut app: &Application, dmut window: &Window)
        with super(uid, alias app, alias window)
    {}

    /**
     * Show a dialog in the window of the activity, once both the dialog is given and the activity is started: the
     * application starts it from its own thread, before or after the dialog gives itself
     * */
    pub fn host(mut self, dmut dialog: &Dialog) {
        atomic self {
            self._dialog = (alias dialog)?;
            if self._started {
                self:.showDialog();
            }
        }
    }

    /**
     * Close the window of the dialog, the activity closing with it
     * */
    pub fn closeWindow(mut self) {
        self.app:.close(alias self);
    }

    over onStart(mut self) {
        self.input:.quit():.connect(self.box, &self:.onDismiss);
        self.gui:.escaped():.connect(self.box, &self:.onDismiss);

        self._started = true;
        if self._dialog.hasValue {
            self:.showDialog();
        }
    }

    /**
     * Load the dialog in the interface of the window, closing it when it cannot be
     * */
    fn showDialog(mut self) {
        if let Ok(dmut d) = alias self._dialog {
            self.window:.setName(d.getTitle());
            {
                d:.showIn(alias self.gui);
            } catch {
                err => {
                    log::error #("DialogActivity", "Failed to show the dialog", err);
                    d:.close();
                }
            }
        }
    }

    /**
     * Dismiss the dialog, its window being closed or Escape pressed
     * */
    fn onDismiss(mut self) {
        if let Ok(dmut d) = alias self._dialog {
            d:.dismiss();
        } else {
            self.app:.close(alias self);
        }
    }
}
