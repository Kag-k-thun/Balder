in rounded;

use balder::math::vector;

use std::algorithm::comparison;

/**
 * A rectangle with rounded corners, in CSS pixels: the box a shape is drawn in
 * */
pub record RoundedBox {

    // The top left corner of the rectangle
    pub let pos: vec2;

    // The size of the rectangle
    pub let size: vec2;

    // The radii of the corners, clockwise from the top left one (top left, top right, bottom right, bottom left)
    pub let radii: vec4;

    pub self (pos: vec2, size: vec2, radii: vec4 = vec4())
        with pos = pos
        , size = size
        , radii = radii
    {}

    /**
     * @returns: the box, its radii scaled down as in CSS when the corners of a side would overlap: all of them by the
     * same factor, the smallest ratio of the length of a side to the sum of the radii of its two corners
     * */
    pub fn fitted(self)-> RoundedBox {
        let r = self.radii;

        // the length of each side (top, bottom, left, right), and the sum of the radii of its corners
        let sides = [(self.size.x, r.x + r.y), (self.size.x, r.w + r.z),
                     (self.size.y, r.x + r.w), (self.size.y, r.y + r.z)];

        let mut factor = 1.0f;
        for side in sides {
            if side._1 > side._0 {
                factor = min(factor, max(0.0f, side._0) / side._1);
            }
        }

        RoundedBox(self.pos, self.size, radii-> r * factor)
    }

    /**
     * @returns: the box inside sides of the widths (top, bottom, left, right), the padding box within a border box: the
     * radius of each corner less the widest of its two sides, 0 at least
     * */
    pub fn inset(self, widths: vec4)-> RoundedBox {
        let pos = self.pos + makeVec2(widths.z, widths.x);
        let size = makeVec2(max(0.0f, self.size.x - widths.z - widths.w), max(0.0f, self.size.y - widths.x - widths.y));
        let r = self.radii;

        RoundedBox(pos, size, radii-> makeVec4(max(0.0f, r.x - max(widths.x, widths.z)),
                                              max(0.0f, r.y - max(widths.x, widths.w)),
                                              max(0.0f, r.z - max(widths.y, widths.w)),
                                              max(0.0f, r.w - max(widths.y, widths.z))))
    }

    /**
     * @returns: the box moved by an offset, in CSS pixels
     * */
    pub fn moved(self, offset: vec2)-> RoundedBox {
        RoundedBox(self.pos + offset, self.size, radii-> self.radii)
    }

    /**
     * @returns: the box grown by a distance past each of its sides, shrunk when it is negative, as the box of a shadow:
     * a rounded corner grows with it, a square one stays square
     * */
    pub fn spread(self, distance: f32)-> RoundedBox {
        let size = makeVec2(max(0.0f, self.size.x + 2.0f * distance), max(0.0f, self.size.y + 2.0f * distance));
        let r = self.radii;

        RoundedBox(self.pos - makeVec2(distance, distance), size,
                   radii-> makeVec4(self.spreadRadius(r.x, distance), self.spreadRadius(r.y, distance),
                                    self.spreadRadius(r.z, distance), self.spreadRadius(r.w, distance)))
    }

    pub fn opEquals(self, other: RoundedBox)-> bool {
        self.pos == other.pos && self.size == other.size && self.radii == other.radii
    }

    /**
     * @returns: the radius of a corner of the box grown by a distance, 0 for a square corner
     * */
    fn spreadRadius(self, radius: f32, distance: f32)-> f32 {
        if radius > 0.0f { max(0.0f, radius + distance) } else { 0.0f }
    }
}
