in texture;

use balder::core::{dispose, error};
use balder::core::application::refcount;
use balder::core::shader::texture;
use balder::interface::drawer;


/**
 * A 2D textured shape, a quad drawn with the quad of the drawer and a descriptor set binding its texture
 * */
@final
pub class TextureShape over Shape {

    let dmut _texture: (&RefCount!{&Texture})?;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (uid: usize, dmut drawer: &ShapeDrawer, dmut texture: &RefCount!{&Texture})
        with super(uid, alias drawer)
        , _texture = (alias texture)?
        throws BalderError
    {
        drawer:.allocTextureSet(uid, texture:.get());
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the draw of the quad, with the descriptor set binding the texture of the shape
     * */
    pub over getDraws(self)-> [ShapeDraw] {
        copy [self.makeDraw(ShapeKind::TEXTURE, self.uid, QUAD_INDICES)]
    }

    impl Disposable {
        pub over dispose(mut self) {
            if self._disposed { return; }

            self.__super__:.dispose();
            self._context:.freeTextureSet(self.uid);

            if let Ok(dmut txt) = alias self._texture {
                txt:.dispose();
                self._texture = none;
            }
        }
    }
}
