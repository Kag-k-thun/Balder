in texture;

use balder::core::_;
use balder::core::application::refcount;
use balder::core::config::shader::_;
use balder::core::shader::{_, buffers::_};
use balder::interface::drawer;


/**
 * A 2D textured shape
 * */
@final
pub class TextureShape over Shape {

    let dmut _texture: (&RefCount!{&Texture})?;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (uid: usize,
              dmut drawer: &ShapeDrawer,
              dmut shader: &Shader,
              vbo: &VertexBufferObject,
              ibo: &IndexBufferObject,
              dmut texture: &RefCount!{&Texture})
        with super(uid, alias drawer, vbo, ibo,
                   ubo-> copy UniformBufferObject(alias shader:.getDevice(), shape::World::size),
                   descSet-> shader:.allocateDescriptorSet(DescriptorContext::OBJECT))
        , _texture = (alias texture)?
        throws BalderError
    {
        if let Ok(dmut ds) = alias self._descSet {
            if let Ok(dmut t) = alias texture:.get()? {
                ds:.setTexture(TextureKind::ALBEDO, t);
            }
        }
    }

    impl Disposable {
        pub over dispose(mut self) {
            self.__super__:.dispose();

            if let Ok(dmut txt) = alias self._texture {
                txt:.dispose();
                self._texture = none;
            }
        }
    }
}
