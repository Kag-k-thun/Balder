/**
 * The classes of the nodes a scene file names by their types: the built-in classes of Balder (a light, a camera…) and
 * the actor classes a game declares with the tags of this module (a door, an enemy, a pickup), each registered at the
 * start of the program in one registry (see nodeClasses), its properties edited in the editor and its signals connected
 * to the slots of other actors by the scene files
 * @info:
 * =====
 * ```
 * #[actor ("door", category-> "Gameplay")]
 * pub class Door over Node3D {
 *
 *     #[export (label-> "Opening speed", min-> 0.0f, max-> 10.0f)]
 *     let mut _speed: f32 = 2.0f;
 *
 *     #[emits]
 *     pub let dmut opened: &Signal!{()} = copy Signal!{()} ();
 *
 *     pub self (name: [c8], dmut parent: &Node)
 *         with super (name, alias parent)
 *     {}
 *
 *     #[slot]
 *     pub fn open (mut self) { … }
 * }
 * ```
 * ====
 * */
in actors;

pub mod ::actor_class;
pub mod ::actor_members;
pub mod ::builtin_class;
pub mod ::node_class;
pub mod ::node_classes;
pub mod ::node_connection;
pub mod ::signal_info;
pub mod ::slot_info;
pub mod ::slot_ref;
pub mod ::tags;
pub mod ::unknown_actor;
pub mod ::wiring;
mod ::utils;
