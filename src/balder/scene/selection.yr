in selection;

use balder::core::application::signal;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{solid, visual};

use ::sdl3::keycode;

/**
 * The nodes selected in a scene, those the inspector and the gizmo work on
 * @info:
 * =====
 * A click selects the node under the cursor alone, Ctrl (or Command) toggles it, and a click on no node clears the
 * selection, a Ctrl click on no node leaving it as it is. The changed signal is emitted at each change, the selected
 * nodes being read from the selection then. A click on a mesh of a model selects the model (see selectedOnClick), the
 * node placing the meshes together.
 * ====
 * */
pub class Selection {

    // The selected nodes, in the order they were selected
    let dmut _nodes: [&Node3D] = [];

    // The signal emitted when the selection changed
    let dmut _changed: (&Signal!{()})? = none;

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the selected nodes, in the order they were selected, the last one selected last
     * */
    @field
    pub fn nodes(self)-> [&Node3D] {
        self._nodes
    }

    /**
     * @returns: the selected nodes, in the order they were selected, the last one selected last
     * */
    @field
    pub fn nodes(mut self)-> dmut [&Node3D] {
        alias self._nodes
    }

    /**
     * @returns: the number of selected nodes
     * */
    @field
    pub fn len(self)-> usize {
        self._nodes.len
    }

    /**
     * @returns: true iif a node is selected
     * */
    pub fn contains(self, node: &Node)-> bool {
        for n in self._nodes {
            if n.uid == node.uid { return true; }
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select a node alone
     * @returns: true iif the selection changed
     * */
    pub fn select(mut self, dmut node: &Node3D)-> bool {
        if self._nodes.len == 1us && self._nodes[0].uid == node.uid { return false; }

        self._nodes = copy [alias node];
        self:.emitChanged();
        true
    }

    /**
     * Add a node to the selection, after the nodes selected
     * @returns: true iif the selection changed, false when the node was selected
     * */
    pub fn add(mut self, dmut node: &Node3D)-> bool {
        if self.contains(node) { return false; }

        self._nodes ~= [alias node];
        self:.emitChanged();
        true
    }

    /**
     * Remove a node from the selection
     * @returns: true iif the selection changed, false when the node was not selected
     * */
    pub fn remove(mut self, node: &Node)-> bool {
        if !self.contains(node) { return false; }

        let dmut kept: [&Node3D] = [];
        for dmut n in alias self._nodes {
            if n.uid != node.uid { kept ~= [alias n]; }
        }

        self._nodes = alias kept;
        self:.emitChanged();
        true
    }

    /**
     * Select a node if it is not selected, remove it from the selection otherwise
     * @returns: always true, the selection changing
     * */
    pub fn toggle(mut self, dmut node: &Node3D)-> bool {
        if self:.remove(node) { return true; }

        self:.add(alias node)
    }

    /**
     * Unselect every node
     * @returns: true iif the selection changed, false when it was empty
     * */
    pub fn clear(mut self)-> bool {
        if self._nodes.len == 0us { return false; }

        self._nodes = [];
        self:.emitChanged();
        true
    }

    /**
     * Select as a click does with some modifiers held: the node clicked alone, toggled with Ctrl (or Command), and none
     * clearing the selection without Ctrl
     * @params:
     *    - node: the node under the cursor, none when the click is on no node
     *    - mods: the modifiers held (SDL_KMOD_*)
     * @returns: true iif the selection changed
     * */
    pub fn click(mut self, dmut node: (&Node3D)?, mods: SDL_Keymod)-> bool {
        let ctrl = (mods & (SDL_KMOD_CTRL | SDL_KMOD_GUI)) != 0u16;
        if let Ok(dmut n) = alias node {
            return if ctrl { self:.toggle(alias n) } else { self:.select(alias n) };
        }

        if ctrl { return false; }
        self:.clear()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the signal emitted when the selection changed, the selected nodes being read from the selection
     * */
    pub fn changed(mut self)-> dmut &Signal!{()} {
        if let Ok(dmut s) = alias self._changed {
            return alias s;
        }

        let dmut s = copy Signal!{()} ();
        self._changed = (alias s)?;

        alias s
    }

    /**
     * Emit the changed signal, when it was asked for
     * */
    fn emitChanged(mut self) {
        if let Ok(dmut s) = alias self._changed {
            s:.emit();
        }
    }

}

/**
 * @returns: the node a click on an instance selects: the model the instance is a mesh of, placed and scaled as a whole,
 * the instance itself otherwise
 * @info: a mesh turned inside a model scaled unevenly would be sheared by its scale
 * */
pub fn selectedOnClick(dmut instance: &VisualInstance3D)-> dmut &Node3D {
    if let Ok(dmut parent) = alias instance:.getParent() {
        if let dmut model: &SolidObjectModel = alias parent {
            return alias model;
        }
    }

    alias instance
}
