in collider_shape;

mod ::utils;

use balder::math::{bounds, vector};
use balder::scene::node::node3D::volume_shape;

use std::algorithm::comparison;

/**
 * The kinds of the shapes of a collider
 * */
pub enum ColliderKind : u32
| BOX     = 0u32 // a box, of a side along each axis
| SPHERE  = 1u32 // a sphere, of a radius
| CAPSULE = 2u32 // a cylinder along the Y axis capped by two half spheres, of a radius and a height
| MESH    = 3u32; // the triangles of a mesh, a surface holding no volume

/**
 * The shape of a collider, in the space of its body, centred on its origin: a box, a sphere, a capsule standing along
 * the Y axis, or the triangles of a mesh
 * @info:
 * =====
 * The sides of a box, the radius of a sphere and of a capsule are MIN_VOLUME_SIZE at least, the height of a capsule
 * (its caps included) twice its radius at least, as those of a VolumeShape. A mesh is only a surface: a ray hits its
 * triangles by either of their faces, a shape overlaps it when it crosses one of them, and two meshes never touch.
 * ====
 * */
pub record ColliderShape {

    // What the shape is
    pub let kind: ColliderKind;

    // The sides of a box along the X, the Y and the Z axes of its body
    pub let size: vec3;

    // The radius of a sphere, of a capsule
    pub let radius: f32;

    // The height of a capsule along the Y axis of its body, its caps included
    pub let height: f32;

    // The triangles of a mesh, none for the other kinds
    pub let triangles: (&TriangleBvh)?;

    // The hierarchy of the boxes of the triangles of a mesh, built with the shape, none for the other kinds
    pub let hierarchy: (&Bvh)?;

    /**
     * A box of a unit side
     * */
    pub self ()
        with self(VolumeShape())
    {}

    /**
     * The shape of a volume (see Volume3D): a box, a sphere or a capsule of its sizes
     * */
    pub self (volume: VolumeShape)
        with kind = utils::kindOf(volume.kind)
        , size = volume.size
        , radius = volume.radius
        , height = volume.height
        , triangles = none
        , hierarchy = none
    {}

    /**
     * @params:
     *    - size: the sides of the box along the axes of its body, MIN_VOLUME_SIZE at least
     * */
    pub self box(size: vec3)
        with kind = ColliderKind::BOX
        , size = makeVec3(comparison::max(size.x, MIN_VOLUME_SIZE), comparison::max(size.y, MIN_VOLUME_SIZE),
                          comparison::max(size.z, MIN_VOLUME_SIZE))
        , radius = 0.0f
        , height = 0.0f
        , triangles = none
        , hierarchy = none
    {}

    /**
     * @params:
     *    - radius: the radius of the sphere, MIN_VOLUME_SIZE at least
     * */
    pub self sphere(radius: f32)
        with kind = ColliderKind::SPHERE
        , size = vec3()
        , radius = comparison::max(radius, MIN_VOLUME_SIZE)
        , height = 0.0f
        , triangles = none
        , hierarchy = none
    {}

    /**
     * @params:
     *    - radius: the radius of the capsule, MIN_VOLUME_SIZE at least
     *    - height: the height of the capsule along the Y axis of its body, its caps included, twice its radius at least
     * */
    pub self capsule(radius: f32, height: f32)
        with kind = ColliderKind::CAPSULE
        , size = vec3()
        , radius = comparison::max(radius, MIN_VOLUME_SIZE)
        , height = comparison::max(height, 2.0f * comparison::max(radius, MIN_VOLUME_SIZE))
        , triangles = none
        , hierarchy = none
    {}

    /**
     * The triangles of a mesh, in the space of its body
     * @info: the hierarchy of the triangles is built at once if it was not yet, the queries reading it without changing
     * it; the triangles of a mesh instance kept for its picking (see Scene::keepsTriangles) can be shared this way
     * */
    pub self mesh(dmut triangles: &TriangleBvh)
        with kind = ColliderKind::MESH
        , size = vec3()
        , radius = 0.0f
        , height = 0.0f
        , hierarchy = (triangles:.hierarchy())?
        , triangles = (triangles)?
    {}

    /**
     * @returns: the box enclosing the shape, in the space of its body, empty for a mesh without triangles
     * */
    pub fn localBox(self)-> Aabb {
        let half = match self.kind {
            ColliderKind::SPHERE  => { makeVec3(self.radius, self.radius, self.radius) }
            ColliderKind::CAPSULE => { makeVec3(self.radius, self.height / 2.0f, self.radius) }
            ColliderKind::MESH    => {
                if let Ok(h) = self.hierarchy { return h.bounds; }
                return Aabb();
            }
            _ => { self.size / 2.0f }
        };

        Aabb(-half, half)
    }

}
