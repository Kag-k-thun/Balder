in contact_scratch;

use balder::math::vector;

/**
 * The buffers the narrowphase finds the points of two shapes in: the corners of their faces, the two polygons a
 * clipping goes between and the points it keeps, reused from pair to pair and from step to step, so that finding the
 * points of a pair builds no slice for each face, each side clipped and each point
 *
 * @info: a method gives a view of a buffer grown to the length asked, valid until the same buffer is asked for again;
 * what is kept of it (the points of a manifold) is copied
 *
 * */
@final
pub class ContactScratch {

    // The corners of the face of the first shape of a pair, and of the second
    let dmut _firstCorners: [vec3] = [];
    let dmut _secondCorners: [vec3] = [];

    // The corners of the two polygons a clipping goes between, and the features they come from
    let dmut _polygon: [vec3] = [];
    let dmut _polygonFeatures: [u32] = [];
    let dmut _clipped: [vec3] = [];
    let dmut _clippedFeatures: [u32] = [];

    // The points a clipping keeps, before they are reduced and copied into their manifold
    let dmut _points: [ContactPoint] = [];

    pub self () {}

    /**
     * @returns: a view of the buffer of the corners of a face
     * @params:
     *    - second: true for the face of the second shape, false for the first, each in a buffer of its own
     *    - len: the number of corners
     * */
    pub fn corners(mut self, second: bool, len: usize)-> dmut [vec3] {
        if second {
            while self._secondCorners.len < len { self._secondCorners ~= [vec3()]; }
            return alias self._secondCorners[0us .. len];
        }

        while self._firstCorners.len < len { self._firstCorners ~= [vec3()]; }
        alias self._firstCorners[0us .. len]
    }

    /**
     * @returns: a view of the corners of one of the two polygons a clipping goes between
     * @params:
     *    - clipped: true for the polygon a side clips into, false for the one it clips
     *    - len: the number of corners the polygon may have
     * */
    pub fn polygon(mut self, clipped: bool, len: usize)-> dmut [vec3] {
        if clipped {
            while self._clipped.len < len { self._clipped ~= [vec3()]; }
            return alias self._clipped[0us .. len];
        }

        while self._polygon.len < len { self._polygon ~= [vec3()]; }
        alias self._polygon[0us .. len]
    }

    /**
     * @returns: a view of the features of the corners of one of the two polygons a clipping goes between
     * @params:
     *    - clipped: true for the polygon a side clips into, false for the one it clips
     *    - len: the number of corners the polygon may have
     * */
    pub fn features(mut self, clipped: bool, len: usize)-> dmut [u32] {
        if clipped {
            while self._clippedFeatures.len < len { self._clippedFeatures ~= [0u32]; }
            return alias self._clippedFeatures[0us .. len];
        }

        while self._polygonFeatures.len < len { self._polygonFeatures ~= [0u32]; }
        alias self._polygonFeatures[0us .. len]
    }

    /**
     * @returns: a view of the buffer of the points a clipping keeps
     * @params:
     *    - len: the number of points it may keep
     * */
    pub fn points(mut self, len: usize)-> dmut [ContactPoint] {
        while self._points.len < len { self._points ~= [ContactPoint()]; }
        alias self._points[0us .. len]
    }
}
