in query_filter;

/**
 * The bodies a query of a physics world can hit
 * */
@data
pub record QueryFilter {

    // The layers of the bodies hit, one bit by layer
    pub let mut mask: u32 = ALL_LAYERS;

    // True when the query hits the triggers too
    pub let mut triggers: bool = false;

    // The handles of the bodies the query never hits (the body of the character casting a ray...)
    pub let mut exclude: [u32] = [];

}
