in solver_settings;

/**
 * How the solver sub steps, iterates over the contacts and the joints, pushes the penetrations out and pulls the errors of the joints back (see PhysicsConfig)
 * */
@data
pub record SolverSettings {

    // The sub steps a step is solved in, the contacts found once a step
    let mut substeps: u32 = 4u32;

    // The passes of the solver over the contacts at each sub step, a pass relaxing the correction following them
    let mut iterations: u32 = 2u32;

    // The frequency of the spring pushing a penetration out, in hertz, a quarter of the rate of the sub steps at most
    let mut contactHertz: f32 = 60.0f;

    // The damping ratio of the spring, 1 for a critical damping, more for a stiffer contact that never bounces
    let mut contactDamping: f32 = 10.0f;

    // The frequency of the spring pulling the error of a joint back, in hertz, a quarter of the rate of the sub steps at
    // most
    let mut jointHertz: f32 = 60.0f;

    // The damping ratio of that spring
    let mut jointDamping: f32 = 2.0f;

    // The speed the correction of a penetration pushes out by at most, in metres a second
    let mut maxCorrection: f32 = 2.0f;

    // The speed two bodies must close by for a contact to bounce, in metres a second
    let mut bounceThreshold: f32 = 1.0f;
}
