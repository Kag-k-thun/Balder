in shape_contact;

use balder::math::vector;

/**
 * How deep a shape sinks into a body of a world (see PhysicsWorld::penetrations)
 * */
@data
pub record ShapeContact {

    // The handle of the body
    pub let mut body: u32 = 0u32;

    // The unit normal from the shape to the body, the shape getting out of the body by moving against it
    pub let mut normal: vec3 = vec3();

    // How deep the shape sinks into the body along the normal, positive
    pub let mut depth: f32 = 0.0f;

    // The deepest point of the contact, in the world
    pub let mut point: vec3 = vec3();

}
