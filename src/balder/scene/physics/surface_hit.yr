in surface_hit;

use balder::math::vector;

/**
 * The point where a ray or a moving shape hits the surface of a collider first
 * */
@data
pub record SurfaceHit {

    // The distance along the ray, or travelled by the shape, to the hit; 0 when it starts inside the collider
    pub let mut distance: f32 = 0.0f;

    // The point hit, on the surface of the collider, in world space
    pub let mut point: vec3 = vec3();

    // The unit normal of the surface at the point hit, facing the ray or the shape; opposite to the direction of the ray
    // or of the shape when it starts inside the collider
    pub let mut normal: vec3 = vec3();

}
