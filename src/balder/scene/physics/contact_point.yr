in contact_point;

use balder::math::vector;


/**
 * The id of no feature, a point found again by its position only
 * */
pub def NO_FEATURE = u32::max;


/**
 * A point where two shapes touch, or are about to (a speculative point), with
 * the impulses the solver gave it
 *
 * */
@data
pub record ContactPoint {

    // The point in the world, midway between the two surfaces
    let mut point: vec3 = vec3();

    // The point on the first shape, in the space of its collider
    let mut localA: vec3 = vec3();

    // The point on the second shape, in the space of its collider
    let mut localB: vec3 = vec3();

    // How deep the shapes overlap along the normal, negative when they are
    // apart (a speculative point)
    let mut depth: f32 = 0.0f;

    // The features of the two shapes making the point (a face clipped by a
    // side, a corner kept), NO_FEATURE when there is none to tell
    let mut feature: u32 = NO_FEATURE;

    // The impulse the solver pushed the shapes apart with along the normal, at the last step
    let mut normalImpulse: f32 = 0.0f;

    // The impulse of friction at the last step, in the world, across the normal
    let mut frictionImpulse: vec3 = vec3();
}
