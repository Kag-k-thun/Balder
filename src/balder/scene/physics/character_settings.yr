in character_settings;

use balder::math::vector;

/**
 * How a character controller moves its body through the level (see CharacterController)
 * */
@data
pub record CharacterSettings {

    // The up direction of the character, gravity pulling it the other way
    pub let mut up: vec3 = makeVec3(0.0f, 1.0f, 0.0f);

    // The steepest slope the character stands and walks on, in radians from the horizontal; it slides down a steeper one
    // and cannot walk up it
    pub let mut slopeLimit: f32 = 0.7853982f;

    // The highest ledge the character steps onto while walking, in metres
    pub let mut stepOffset: f32 = 0.3f;

    // The farthest the character is put back on the ground below it while walking down a slope or a stair, in metres,
    // so that it does not leave the ground
    pub let mut snapDistance: f32 = 0.3f;

    // The distance the character keeps from the surfaces it moves along, in metres, its casts starting clear of them
    pub let mut skin: f32 = 0.01f;

    // The time the character can still jump once it walked off the ground, in seconds
    pub let mut coyoteTime: f32 = 0.15f;

    // The mass the character pushes the dynamic bodies it walks into with, in kilograms: a lighter body takes the speed
    // of the character, a heavier one only the momentum of that mass
    pub let mut pushMass: f32 = 40.0f;

    // The surfaces the character slides along at most in a move, each turning the rest of the move along it
    pub let mut maxSlides: u32 = 4u32;

    // The passes pushing the character out of the bodies it sinks into at most, at the start of a move
    pub let mut depenetrations: u32 = 4u32;

}
