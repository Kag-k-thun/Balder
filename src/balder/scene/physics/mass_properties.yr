in mass_properties;

mod ::utils;

use balder::math::{inertia, matrix, vector};


pub record MassProperties {

    // The mass, 0 for a  body nothing pushes
    pub let mut mass: f32 = 0.0f;

    // The center of mass, in the space of the body
    pub let mut centre: vec3 = vec3();

    // The inertia tensor about the center of the mass, along the axes of the body
    pub let mut inertia: mat3 = diagonalTensor(vec3());

    pub self() {}

    /**
     * The mass of a shape of a uniform density
     * @params:
     *    - shape: the shape, scaled as its body is (see ColliderShape::scaled)
     *    - mass: the mass of the shape, above 0
     * @info: a mesh and a plane, holding no volume, have no mass
     * */
    pub self(shape: ColliderShape, mass: f32)
        with mass = (if shape.volume > 0.0f { mass } else { 0.0f })
        , centre = utils::centreOf(shape)
        , inertia = utils::inertiaOf(shape, if shape.volume > 0.0f { mass } else { 0.0f })
    {}


    /**
     * @returns: the inverse of the mass, 0 if no mass
     * */
    @field
    pub fn inverseMass(self)-> f32 {
        if self.mass > 0.0f {
            1.0f / self.mass
        } else {
            0.0f
        }
    }

    /**
     * @returns: the inverse of the inertia tensor, zero if no mass
     * */
    @field
    pub fn inverseInertia(self)-> mat3 {
        if self.mass > 0.0f {
            self.inertia.inversed()
        } else {
            diagonalTensor(vec3())
        }
    }
}
