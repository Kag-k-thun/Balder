in separation;

use balder::math::vector;

/**
 * How far apart two convex shapes are (see gjk::separation)
 * */
@data
pub record Separation {

    // True when the shapes share a point, touching or overlapping
    pub let mut overlapping: bool = false;

    // The distance between the shapes, 0 when they overlap
    pub let mut distance: f32 = 0.0f;

    // The point of the first shape closest to the second, on its surface, the origin when they overlap
    pub let mut pointA: vec3 = vec3();

    // The point of the second shape closest to the first, on its surface, the origin when they overlap
    pub let mut pointB: vec3 = vec3();

    // The unit direction from the first shape to the second, zero when they overlap
    pub let mut normal: vec3 = vec3();

}
