in hull_face;

use balder::math::vector;

@data
pub record HullFace {

    // The indices of the corners in the vertices of the hull
    let mut a: u32 = 0;
    let mut b: u32 = 0;
    let mut c: u32 = 0;

    // The unit normal of the face, pointing out of the hull
    let mut normal: vec3 = vec3();

    // normal.dot(p) for every point p of the face,
    // a point q being inside the hull when normal.dot(q) <= offset
    let mut offset: f32 = 0.0f;
}
