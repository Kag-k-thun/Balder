in body_state;

use balder::math::{inertia, matrix, rigid_transform, utils, vector};

/**
 * What the solver moves of a body: its pose, its velocities, the inverse of its
 * mass and of its inertia, and how long it stayed still
 *
 * @info: kept by the world in an array by handle, next to the colliders, the
 * solver running over them without reaching the nodes; a static or a kinematic
 * body has no inverse mass nor inverse inertia, nothing pushing it
 *
 */
pub record BodyState {

    // THe placement of the origin of the body, its scale apart
    pub let mut pose: RigidTransform = RigidTransform();

    // The scale of the transformation of the body, applied to its shape before the pose
    pub let mut scale: vec3 = makeVec3(1.0f, 1.0f, 1.0f);

    // The centre of the mass, in the shape of the body
    pub let mut centre: vec3 = vec3();

    // The velocity of the centre of the mass, in metres a second
    pub let mut linearVelocity: vec3 = vec3();

    // The angular velocity in the world, in radians a second about its direction
    pub let mut angularVelocity: vec3 = vec3();

    // The inverse of the mass, 0 for a body nothing pushes
    pub let mut inverseMass: f32 = 0.0f;

    // The inverse of the inertia tensor about the centre of the mass, along the axes of the body
    pub let mut localInverseInertia: mat3 = diagonalTensor(vec3());

    // The same in the world, turned with the pose (see refresh)
    pub let mut inverseInertia: mat3 = diagonalTensor(vec3());

    // False for a body asleep, the solver skipping it until something wakes it
    pub let mut awake: bool = true;

    // The time the body stayed still, in seconds (see updateSleep)
    pub let mut stillTime: f32 = 0.0f;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self() {}

    pub self(transform: mat4, mass: MassProperties = MassProperties())
        with pose = RigidTransform(transform)
        , scale = axesScale(transform)
        , centre = mass.centre
        , inverseMass = mass.inverseMass
        , localInverseInertia = mass.inverseInertia
        , inverseInertia = worldInverseInertia(RigidTransform(transform).rotation, mass.inverseInertia)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * @returns: the centre of the mass in the world
     * */
    @field
    pub fn worldCentre(self)-> vec3 {
        self.pose.transformPoint(self.centre)
    }

    /**
     * @returns: the transformation placing the collider of the body, its pose then its scale
     * */
    @field
    pub fn placement(self)-> mat4 {
        self.pose.matrix() * scaling(self.scale)
    }

    /**
     * @returns: the velocity of a point of the world moving with the body
     * */
    pub fn velocityAt(self, point: vec3)-> vec3 {
        self.linearVelocity + self.angularVelocity.cross(point - self.worldCentre)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Place the body by a transformation, its scale kept apart, its inverse inertia turned with it
     * */
    pub fn place(mut self, transform: mat4) {
        self.pose = RigidTransform(transform);
        self.scale = axesScale(transform);
        self:.refresh();
    }

    /**
     * Turn the inverse inertia in the  world with the rotation of the pose, after the solver turned the body
     */
    pub fn refresh(mut self) {
        self.inverseInertia = worldInverseInertia(self.pose.rotation, self.localInverseInertia);
    }

    /**
     * Wake the body, its time still counted again from 0
     */
    pub fn wake(mut self) {
        self.awake = true;
        self.stillTime = 0.0f;
    }

    /**
     * Count the time the body stays still during a step
     *
     * @returns: true iif it stayed still for long enough to sleep
     *
     * */
    pub fn updateSleep(mut self, dt: f32, thresholds: SleepThresholds)-> bool {
        let lin = thresholds.linear * thresholds.linear;
        let ang = thresholds.angular * thresholds.angular;
        if self.linearVelocity.dot(self.linearVelocity) >= lin || self.angularVelocity.dot(self.angularVelocity) >= ang {
            self.stillTime = 0.0f;
            return false;
        }

        self.stillTime += dt;
        self.stillTime >= thresholds.time
    }

    /**
     * Put the body to sleep, its velocities dropped
     *
     * */
    pub fn sleep(mut self) {
        self.awake = false;
        self.linearVelocity = vec3();
        self.angularVelocity = vec3();
    }
}
