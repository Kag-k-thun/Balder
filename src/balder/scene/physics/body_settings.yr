in body_settings;

/**
 * How a body moves
 * */
pub enum BodyMotion : u32
| STATIC    = 0u32 // never moves, or rarely: the ground, the walls; two static bodies never touch each other
| KINEMATIC = 1u32 // moved by the game, its transformation set at each tick: a door, a platform, a character
| DYNAMIC   = 2u32; // moved by the solver, pushed by the others; never a mesh nor a plane

/**
 * How a body takes part in the physics of its world
 * */
@data
pub record BodySettings {

    // How the body moves
    let mut motion: BodyMotion = BodyMotion::STATIC;

    // True for a trigger, reporting the bodies it overlaps and stopping none of them; a query hits it only when its
    // filter asks for the triggers
    let mut trigger: bool = false;

    // The layers the body is in, one bit by layer
    let mut layer: u32 = DEFAULT_LAYER;

    // The layers of the bodies the body touches, one bit by layer: two bodies touch when one of them is in a layer of
    // the mask of the other
    let mut mask: u32 = ALL_LAYERS;

    // The mass of a dynamic body, in kilograms, spread uniformly in its shape
    // does not apply to static or kinematic
    let mut mass: f32 = 1.0f;

    // The friction of the surface of the body, 0 sliding freely
    let mut friction: f32 = 0.5f;

    // The part of the speed a dynamic keeps bouncing off another, 0 not bouncing, 1 bouncing back as fast
    let mut restitution: f32 = 0.0f;

    // The part of its linear speed a dynamic body loses each second, the air slowing it down
    pub let mut linearDamping: f32 = 0.05f;

    // The part of its angular speed a dynamic body loses each second
    pub let mut angularDamping: f32 = 0.05f;

    // False for dynamic body that never sleeps, a player's body or a body the game polls
    pub let mut canSleep: bool = true;
}
