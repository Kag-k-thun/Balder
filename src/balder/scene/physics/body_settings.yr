in body_settings;

/**
 * How a body moves
 * */
pub enum BodyMotion : u32
| STATIC    = 0u32 // never moves, or rarely: the ground, the walls; two static bodies never touch each other
| KINEMATIC = 1u32; // moved by the game, its transformation set at each tick: a door, a platform, a character

/**
 * How a body takes part in the physics of its world
 * */
@data
pub record BodySettings {

    // How the body moves
    pub let mut motion: BodyMotion = BodyMotion::STATIC;

    // True for a trigger, reporting the bodies it overlaps and stopping none of them; a query hits it only when its
    // filter asks for the triggers
    pub let mut trigger: bool = false;

    // The layers the body is in, one bit by layer
    pub let mut layer: u32 = DEFAULT_LAYER;

    // The layers of the bodies the body touches, one bit by layer: two bodies touch when one of them is in a layer of
    // the mask of the other
    pub let mut mask: u32 = ALL_LAYERS;

}
