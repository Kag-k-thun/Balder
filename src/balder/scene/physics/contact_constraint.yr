in contact_constraint;

use balder::math::vector;

/**
 * A point of contact as the solver pushes on it: its two bodies, its arms, its masses along the normal and the
 * tangents, its separation, the speed it bounces back with, and the impulses it gathered
 *
 * */
@data
pub record ContactConstraint {

    // The index of the first body in the solver bodies of the island, pushed against the normal
    let mut a: usize = 0us;

    // The index of the second body, pushed along the normal
    let mut b: usize = 0us;

    // The slot of the pair the point is in, its impulses written back there
    let mut slot: usize = 0us;

    // The index of the manifold of the point in its pair
    let mut manifold: usize = 0us;

    // The index of the point in its manifold
    let mut point: usize = 0us;

    // The unit normal, from the first body to the second
    let mut normal: vec3 = vec3();

    // A unit tangent across the normal
    let mut tangent1: vec3 = vec3();

    // The unit tangent across the normal and the first tangent
    let mut tangent2: vec3 = vec3();

    // The arm from the centre of the mass of the first body to the point
    let mut armA: vec3 = vec3();

    // The arm from the centre of the mass of the second body to the point
    let mut armB: vec3 = vec3();

    // The mass of the point along the normal, the inverse of what a unit impulse there changes its speed by
    let mut normalMass: f32 = 0.0f;

    // The mass of the point along the first tangent
    let mut tangentMass1: f32 = 0.0f;

    // The mass of the point along the second tangent
    let mut tangentMass2: f32 = 0.0f;

    // How far apart the two bodies are along the normal at the point at the start of the step, negative when they
    // overlap, the sub steps moving it by the motion of the bodies
    let mut separation: f32 = 0.0f;

    // The speed along the normal the point bounces back with, 0 for a contact closing too slowly to bounce
    let mut bounce: f32 = 0.0f;

    // The friction of the contact
    let mut friction: f32 = 0.0f;

    // The impulse gathered along the normal at a sub step, never pulling
    let mut normalImpulse: f32 = 0.0f;

    // The largest impulse along the normal of the sub steps of the step, 0 for a point never reached
    let mut maxNormalImpulse: f32 = 0.0f;

    // The impulse of friction gathered along the first tangent
    let mut tangentImpulse1: f32 = 0.0f;

    // The impulse of friction gathered along the second tangent
    let mut tangentImpulse2: f32 = 0.0f;
}
