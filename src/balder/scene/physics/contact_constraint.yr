in contact_constraint;

use balder::math::vector;

/**
 * A manifold as the solver pushes on it: its two bodies, its normal and its tangents, its friction, and the range of
 * its points in the points of the island
 *
 * @info: the solver loads the velocities of the two bodies once for all the points of a manifold, and writes them back
 * once (Box2D v3)
 *
 * */
@data
pub record ContactConstraint {

    // The index of the first body in the solver bodies of the island, pushed against the normal
    let mut a: usize = 0us;

    // The index of the second body, pushed along the normal
    let mut b: usize = 0us;

    // The slot of the pair the manifold is in, its impulses written back there
    let mut slot: usize = 0us;

    // The index of the manifold in its pair
    let mut manifold: usize = 0us;

    // The index of the first point of the manifold in the points of the island
    let mut first: usize = 0us;

    // The number of points of the manifold, four at most
    let mut count: usize = 0us;

    // The unit normal, from the first body to the second
    let mut normal: vec3 = vec3();

    // A unit tangent across the normal
    let mut tangent1: vec3 = vec3();

    // The unit tangent across the normal and the first tangent
    let mut tangent2: vec3 = vec3();

    // The friction of the contact
    let mut friction: f32 = 0.0f;
}
