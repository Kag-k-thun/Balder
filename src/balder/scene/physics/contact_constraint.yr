in contact_constraint;

use balder::math::vector;

/**
 * A manifold as the solver pushes on it: its two bodies, its normal and its tangents, its friction, its rolling and
 * spinning friction, and the range of its points in the points of the island
 *
 * @info: the solver loads the velocities of the two bodies once for all the points of a manifold, and writes them back
 * once (Box2D v3)
 *
 * */
@data
pub record ContactConstraint {

    // The index of the first body in the solver bodies of the island, pushed against the normal
    let mut a: usize = 0us;

    // The index of the second body, pushed along the normal
    let mut b: usize = 0us;

    // The slot of the pair the manifold is in, its impulses written back there
    let mut slot: usize = 0us;

    // The index of the manifold in its pair
    let mut manifold: usize = 0us;

    // The index of the first point of the manifold in the points of the island
    let mut first: usize = 0us;

    // The number of points of the manifold, four at most
    let mut count: usize = 0us;

    // The unit normal, from the first body to the second
    let mut normal: vec3 = vec3();

    // A unit tangent across the normal
    let mut tangent1: vec3 = vec3();

    // The unit tangent across the normal and the first tangent
    let mut tangent2: vec3 = vec3();

    // The friction of the contact
    let mut friction: f32 = 0.0f;

    // The rolling friction of the contact times its radius: the largest angular impulse about an axis across the
    // normal a unit of normal impulse of the manifold resists the rolling with
    let mut rolling: f32 = 0.0f;

    // The spinning friction of the contact times its radius, the same about the normal
    let mut spinning: f32 = 0.0f;

    // The angular masses of the two bodies about the first tangent, the second and the normal, the inverse of what a
    // unit angular impulse about each changes their relative angular speed by
    let mut rollingMass1: f32 = 0.0f;
    let mut rollingMass2: f32 = 0.0f;
    let mut spinningMass: f32 = 0.0f;

    // The angular impulses gathered against the rolling about the first tangent and the second, bounded together
    let mut rollingImpulse1: f32 = 0.0f;
    let mut rollingImpulse2: f32 = 0.0f;

    // The angular impulse gathered against the spinning about the normal
    let mut spinningImpulse: f32 = 0.0f;
}
