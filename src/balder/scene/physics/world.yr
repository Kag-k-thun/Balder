in world;

mod ::utils;

use balder::core::config::physics;
use balder::math::{bounds, matrix, quaternion, rigid_transform, vector};
use balder::utils::log;

use std::{math, time};
use std::algorithm::{comparison, sorting};

/**
 * The handle of no body
 * */
def NO_BODY = u32::max;

/**
 * The distance the boxes of the hierarchy are grown by around their colliders,
 * in metres
 *
 * */
def BROAD_MARGIN = 0.05f;

/**
 * The number of steps of its velocity the box of a body is stretched by in the hierarchy, beyond the step its
 * speculative points cover, so that a moving body is not inserted again at each step
 *
 * */
def PREDICTION = 2.0f;

/**
 * The distance apart under which two bodies always make speculative points, in
 * metres
 *
 * */
def SPECULATIVE_FLOOR = 0.02f;

/**
 * The distance a bullet stops at from the body it hits along its motion, in metres, its speculative points against it
 * taking over at the next step
 *
 * */
def IMPACT_DISTANCE = 0.005f;

/**
 * The reach of the motion of a bullet over a step, over its half thickness, from which it is advanced along it, slower
 * bullets sinking by less than that into what they meet and left to their speculative points (Box2D v3)
 *
 * */
def FAST_RATIO = 0.5f;

/**
 * The duration of a step of the solver until a step is run, in seconds, the
 * speculative distances covering what the bodies travel in a step
 *
 * */
def STEP = 1.0f / 60.0f;

/**
 * The distance under which a kinematic body is not moved between two ticks, in metres
 * */
def STILL_MOVE = 1.0e-6f;

/**
 * The difference from 1 of the cosine of half the angle under which a kinematic body is not turned between two ticks
 * */
def STILL_TURN = 1.0e-6f;

/**
 * The index of a body in no island being solved, by handle
 * */
def NOT_SOLVED = usize::max;

/**
 * A slot of the joints of a world, holding a joint or free
 * */
@data
record WorldJoint {

    // The joint
    pub let mut joint: Joint = Joint();

    // True when the slot holds a joint
    pub let mut used: bool = false;

    // The next free slot after a free one, NO_JOINT for the last
    pub let mut next: u32 = NO_JOINT;
}

/**
 * A slot of the bodies of a world, holding a body or free
 * */
@data
record WorldBody {

    // The collider of the body, its shape placed in the world
    pub let mut collider: Collider = Collider(ColliderShape(), mat4());

    // How the body takes part in the physics of the world
    pub let mut settings: BodySettings = BodySettings();

    // True when the slot holds a body
    pub let mut used: bool = false;

    // The next free slot after a free one, NO_BODY for the last
    pub let mut next: u32 = NO_BODY;

    // For a bullet, the distance from its centre of mass to the farthest point of the cores of its shape, and the
    // thinnest half thickness of its parts, measured at the start of each step (see PhysicsWorld::measureBullet)
    pub let mut coreReach: f32 = 0.0f;
    pub let mut halfThickness: f32 = 0.0f;

}

/**
 * The bodies of a scene, their colliders placed in the world, the queries
 * running on them, and the contacts between them
 *
 * @info:
 * =====
 * A body is known by its handle, the index of its slot, given back when it is
 * added and free again once it is removed (a later body may get it). The world
 * boxes of the colliders are kept in a bounding volume hierarchy, the
 * broadphase of the queries and of the contacts, refit when a body moves.
 *
 * The queries (raycast, shapeCast, overlapShape...) need no solver: they test
 * the colliders whose boxes the query reaches, a ray exactly, the shapes by the
 * distance between their cores (see gjk). A step (step) moves the dynamic
 * bodies, their contacts solved by island; the contacts are reported on request
 * (contactEvents, once a tick of a scene, or updateContacts without a step):
 * the pairs of touching bodies one of which is not static or is a trigger, as
 * seen by the layers and the masks of the two, compared with those the last
 * report gave. Two meshes never touch, nor two static bodies that are not
 * triggers.
 *
 * A joint holds two bodies by a frame placed on both (see addJoint), solved with their contacts in their island: two
 * dynamic bodies joined share an island, waking and sleeping together. Two bodies joined do not touch each other
 * unless the settings of their joint say so. A joint breaks once it holds its bodies by more than its settings allow.
 * ====
 * */
@final
pub class PhysicsWorld {

    // The slots of the bodies, by handle, the free ones included
    let dmut _bodies: [WorldBody] = [];

    // The first free slot, NO_BODY when there is none
    let mut _free: u32 = NO_BODY;

    // The number of bodies in the world
    let mut _len: usize = 0us;

    // The speeds and the time under which dynamic bodies go to sleep
    let mut _sleep: SleepThresholds = SleepThresholds();

    // The world boxes of the colliders, by handle
    let dmut _bvh: &Bvh = copy Bvh();

    // The handles of the bodies whose collider is a plane, kept out of the hierarchy, holding no box
    let mut _planes: [usize] = [];

    // What the solver moves of the bodies, by handle, next to their solts, the free ones at rest
    let dmut _states: [BodyState] = [];

    // The bodies whose box left its enlarged box since the last update of the
    // pairs, or that were added or changed, by handle
    let dmut _moved: [u32 => bool] = copy [];

    // The pairs of bodies whose enlarged boxes overlap and that may touch
    let dmut _pairs: &PairCache = copy PairCache();

    // The acceleration of the dynamic bodies falling, in metres a second squared
    let mut _gravity: vec3 = makeVec3(0.0f, -9.81f, 0.0f);

    // How the solver iterates over the contacts and corrects their penetrations
    let mut _solver: SolverSettings = SolverSettings();

    // The duration of the last step, the speculative distances covering what the bodies travel in a step
    let mut _step: f32 = STEP;

    // The poses of the bodies before the last step, by handle, the display interpolating from them
    let dmut _previous: [RigidTransform] = [];

    // The dynamic bodies put to sleep since the last call of takeSlept, their poses still to show
    let dmut _slept: [u32 => bool] = copy [];

    // The pairs dropped since the last contact events while their contact was reported, their end to report
    let mut _endedUnreported: [BroadPair] = [];

    // The poses of the kinematic bodies at the last derivation of their velocities, by handle
    let dmut _kinematicFrom: [u32 => RigidTransform] = copy [];

    // The kinematic bodies whose velocities were set rather than derived from their moves, until they move again
    let dmut _kinematicSet: [u32 => bool] = copy [];

    // What the last step cost, phase by phase
    let mut _timings: StepTimings = StepTimings();

    // The buffers the narrowphase clips the faces of the pairs in, reused from pair to pair
    let dmut _scratch: &ContactScratch = copy ContactScratch();

    // The islands of the last step
    let dmut _islands: &IslandSet = copy IslandSet();

    // The bodies, the manifolds and the points of the island being solved, kept from island to island and from step
    // to step, the first of each in use
    let dmut _solverBodies: [SolverBody] = [];
    let dmut _constraints: [ContactConstraint] = [];
    let dmut _points: [ConstraintPoint] = [];

    // The index of each body in the solver bodies of the island being solved, NOT_SOLVED for a body in none, by handle
    let dmut _solverIndex: [usize] = [];

    // The slots of the joints, by handle, the free ones included
    let dmut _joints: [WorldJoint] = [];

    // The first free slot of the joints, NO_JOINT when there is none
    let mut _freeJoint: u32 = NO_JOINT;

    // The number of joints in the world
    let mut _jointLen: usize = 0us;

    // The number of joints holding each pair of bodies apart, by the key of the pair (see pairKey)
    let dmut _apart: [u64 => u32] = copy [];

    // The joints broken since the last call of takeBroken
    let mut _broken: [u32] = [];

    // The joints of the island being solved, kept from island to island and from step to step, the first in use
    let dmut _jointConstraints: [JointConstraint] = [];

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: what the last step cost, the time of each of its phases and what it ran over
     * */
    @field
    pub fn timings(self)-> StepTimings {
        self._timings
    }

    /**
     * @returns: the number of bodies in the world
     * */
    @field
    pub fn len(self)-> usize {
        self._len
    }

    /**
     * @returns: the number of joints in the world, the broken ones included
     * */
    @field
    pub fn jointCount(self)-> usize {
        self._jointLen
    }

    /**
     * @returns: the speed and the time under which the dynamic bodies may sleep
     * */
    @field
    pub fn sleepThresholds(self)-> SleepThresholds {
        self._sleep
    }

    /**
     * Set the speed and the time under which the dynamic bodies may sleep
     * */
    @field
    pub fn sleepThresholds(mut self, thresholds: SleepThresholds) {
        self._sleep = thresholds;
    }

    /**
     * @returns: the acceleration of the dynamic bodies falling, in metres a second squared
     * */
    @field
    pub fn gravity(self)-> vec3 {
        self._gravity
    }

    /**
     * Change the acceleration of the dynamic bodies falling, in metres a second squared
     * */
    @field
    pub fn gravity(mut self, gravity: vec3) {
        self._gravity = gravity;
    }

    /**
     * @returns: how the solver iterates over the contacts and corrects their penetrations
     * */
    @field
    pub fn solverSettings(self)-> SolverSettings {
        self._solver
    }

    /**
     * Change how the solver iterates over the contacts and corrects their penetrations
     * */
    @field
    pub fn solverSettings(mut self, settings: SolverSettings) {
        self._solver = settings;
    }

    /**
     * Set the gravity, the solver and the sleep of the world from the configuration of the physics
     * */
    pub fn configure(mut self, config: PhysicsConfig) {
        self._gravity = config.gravity;
        self._solver = SolverSettings(substeps-> config.substeps,
                                      iterations-> config.iterations,
                                      contactHertz-> config.contactHertz,
                                      contactDamping-> config.contactDamping,
                                      jointHertz-> config.jointHertz,
                                      jointDamping-> config.jointDamping,
                                      maxCorrection-> config.maxCorrection,
                                      bounceThreshold-> config.bounceThreshold);
        self._sleep = SleepThresholds(linear-> config.sleepLinear,
                                      angular-> config.sleepAngular,
                                      time-> config.sleepTime);
    }

    /**
     * @returns: the pairs of bodies whose enlarged boxes overlap and that may
     * touch, at the last update the pairs
     *
     * */
    @field
    pub fn pairs(self)-> [BroadPair] {
        self._pairs.pairs
    }

    /**
     * @returns: true iif a body of the world has a handle
     * */
    pub fn contains(self, handle: u32)-> bool {
        cast!usize(handle) < self._bodies.len && self._bodies[handle].used
    }

    /**
     * @returns: true iif a body of the world has a handle and is dynamic, moved by the solver
     * */
    pub fn isDynamic(self, handle: u32)-> bool {
        self.contains(handle) && self._bodies[handle].settings.motion == BodyMotion::DYNAMIC
    }

    /**
     * @returns: the collider of a body, its shape placed in the world
     * @warning: the body is in the world (see contains)
     * */
    pub fn getCollider(self, handle: u32)-> Collider {
        self._bodies[handle].collider
    }

    /**
     * @returns: how a body takes part in the physics of the world
     * @warning: the body is in the world (see contains)
     * */
    pub fn getSettings(self, handle: u32)-> BodySettings {
        self._bodies[handle].settings
    }

    /**
     * @returns: what the solver moves of a body: its pose, its velocities, its
     * inverse mass and inertia
     *
     * @warning: the body is in the world (see contains)
     *
     * */
    pub fn getState(self, handle: u32)-> BodyState {
        self._states[handle]
    }

    /**
     * @returns: the pose of a body before the last step, the display placing it between that pose and the one of its
     * state (see RigidTransform::interpolated)
     *
     * @warning: the body is in the world (see contains)
     *
     * */
    pub fn getPrevious(self, handle: u32)-> RigidTransform {
        self._previous[handle]
    }

    /**
     * @returns: the handles of the bodies of the world, in their order
     * */
    pub yield handles(self)-> u32 {
        for i in 0us .. self._bodies.len if self._bodies[i].used {
            yield cast!u32(i);
        }
    }

    /**
     * @returns: the hierarchy of the enlarged boxes of the bodies, the broadphase of the queries and of the contacts, the
     * planes apart
     * */
    @field
    pub fn hierarchy(self)-> &Bvh {
        self._bvh
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BODIES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a body to the world
     * @params:
     *    - shape: the shape of its collider, in the space of the body
     *    - transform: the transformation of the body, from its space to the world
     *    - settings: how it takes part in the physics of the world
     * @returns: the handle of the body
     * */
    pub fn add(mut self, shape: ColliderShape, transform: mat4, settings: BodySettings = BodySettings())-> u32 {
        let handle = if self._free != NO_BODY {
            let h = self._free;
            self._free = self._bodies[h].next;
            h
        } else {
            self._bodies = self._bodies ~ copy [WorldBody()];
            self._states = self._states ~ copy [BodyState()];
            self._previous = self._previous ~ copy [RigidTransform()];
            cast!u32(self._bodies.len - 1us)
        };

        let taken = utils::checked(shape, settings);
        let state = utils::stateOf(shape, transform, taken);
        let collider = Collider(shape, utils::placementOf(state, transform, taken));

        self._bodies[handle] = WorldBody(collider-> collider, settings-> taken, used-> true);
        self._states[handle] = state;
        self._previous[handle] = state.pose;

        if collider.isPlane {
            self._planes ~= [cast!usize(handle)];
        } else {
            self._bvh:.moveBox(cast!usize(handle), collider.bounds, BROAD_MARGIN);
        }

        self._moved[handle] = true;
        self._len += 1us;

        handle
    }

    /**
     * Remove a body from the world, its handle free for another body
     *
     * @info: the contacts of the body end at once, the next contact events not
     * reporting them, as its handle may be given to another body by then; its
     * joints are removed with it
     *
     * @returns: the contacts of the body the last contact events reported,
     * ended; none when the world has no such body
     *
     * */
    pub fn remove(mut self, handle: u32)-> [ContactEvent] {
        if !self.contains(handle) { return []; }

        let mut ended: [ContactEvent] = [];
        let mut unreported: [BroadPair] = [];
        for p in self._endedUnreported {
            if p.a == handle || p.b == handle {
                ended ~= [ContactEvent(a-> p.a, b-> p.b, phase-> ContactPhase::ENDED)];
            } else {
                unreported ~= [p];
            }
        }

        self._endedUnreported = unreported;
        let mut slot = 0us;
        while slot < self._pairs.len {
            let p = self._pairs.get(slot);
            if p.a != handle && p.b != handle { slot += 1us; continue; }

            // the last pair is moved into the slot, looked at next, what the body held up woken
            self._pairs:.remove(pairKey(p.a, p.b));
            self:.wakeIfAsleep(if p.a == handle { p.b } else { p.a });
            if p.reported {
                ended ~= [ContactEvent(a-> p.a, b-> p.b, phase-> ContactPhase::ENDED)];
            }
        }

        for j in self.jointsOf(handle) {
            self:.removeJoint(j);
        }

        self:.unindex(handle, self._bodies[handle].collider.isPlane);
        self._moved:.remove(handle);
        self._kinematicFrom:.remove(handle);
        self._kinematicSet:.remove(handle);
        self._slept:.remove(handle);
        self._bodies[handle] = WorldBody(next-> self._free);
        self._states[handle] = BodyState();
        self._free = handle;
        self._len -= 1us;

        ended
    }

    /**
     * Move a body, its collider placed again in the world
     * @info: does nothing when the world has no such body
     * */
    pub fn setTransform(mut self, handle: u32, transform: mat4) {
        if !self.contains(handle) { return; }

        let body = self._bodies[handle];
        let state = utils::movedState(self._states[handle], body.collider.shape, transform, body.settings);
        self._states[handle] = state;
        self._previous[handle] = state.pose;

        let placement = utils::placementOf(state, transform, body.settings);
        self:.place(handle, Collider(self._bodies[handle].collider.shape, placement));
        self:.wakeContactsOf(handle);
    }

    /**
     * Change the shape of the collider of a body
     * @info: does nothing when the world has no such body
     * */
    pub fn setShape(mut self, handle: u32, shape: ColliderShape) {
        if !self.contains(handle) { return; }

        let body = self._bodies[handle];
        let taken = utils::checked(shape, body.settings);
        let transform = body.collider.transform;

        let mut state = utils::stateOf(shape, transform, taken);
        state.linearVelocity = self._states[handle].linearVelocity;
        state.angularVelocity = self._states[handle].angularVelocity;

        self._bodies[handle].settings = taken;
        self._states[handle] = state;

        let placement = utils::placementOf(state, transform, taken);
        self:.place(handle, Collider(shape, placement));
    }

    /**
     * Change how a body takes part in the physics of the world, its contacts following at the next update
     * @info: does nothing when the world has no such body
     * */
    pub fn setSettings(mut self, handle: u32, settings: BodySettings) {
        if !self.contains(handle) { return; }

        let body = self._bodies[handle];
        let taken = utils::checked(body.collider.shape, settings);
        if taken.motion != body.settings.motion || taken.mass != body.settings.mass {
            self._states[handle] = utils::stateOf(body.collider.shape, body.collider.transform, taken);
        }

        self._bodies[handle].settings = taken;
        self._moved[handle] = true;
    }

    /**
     * Change the velocities of a dynamic or a kinematic body, waking it
     * @params:
     *    - linear: the velocity of its centre of mass, in metres a second
     *    - angular: its angular velocity in the world, in radians a second about its direction
     *
     * @info: does nothing for a static body, or when the world has no such body
     *
     * */
    pub fn setVelocity(mut self, handle: u32, linear: vec3, angular: vec3) {
        if !self.contains(handle) || self._bodies[handle].settings.motion == BodyMotion::STATIC {
            return;
        }

        self._states[handle].linearVelocity = linear;
        self._states[handle].angularVelocity = angular;
        if self._bodies[handle].settings.motion == BodyMotion::KINEMATIC {
            self._kinematicSet[handle] = true;
        }

        self:.wake(handle);
        self:.refit(handle);
    }

    /**
     * Give the kinematic bodies the velocities of their moves since the last call, the solver pushing and carrying
     * what they touch with them: the displacement over the duration, the rotation from the orientation before to the
     * one now
     *
     * @params:
     *    - seconds: the time since the last call, a tick of a scene
     *
     * @info: a kinematic body not moved has no velocity, unless its velocity was set (see setVelocity), kept until it
     * moves again; the steps do not move a kinematic body, the game placing it
     *
     * */
    pub fn deriveKinematics(mut self, seconds: f32) {
        if seconds <= 0.0f { return; }

        for i in 0us .. self._bodies.len {
            let h = cast!u32(i);
            if !self.contains(h) || self._bodies[i].settings.motion != BodyMotion::KINEMATIC { continue; }

            let now = self._states[i].pose;
            if let Ok(before) = self._kinematicFrom[h] {
                let moved = (now.position - before.position).length() > STILL_MOVE
                         || math::abs(now.rotation.dot(before.rotation)) < 1.0f - STILL_TURN;
                if moved || !(h in self._kinematicSet) {
                    let (angle, axis) = (now.rotation * before.rotation.inversed()).normalized().axisAngle();
                    self._states[i].linearVelocity = (now.position - before.position) / seconds;
                    self._states[i].angularVelocity = axis * (angle / seconds);
                    self._kinematicSet:.remove(h);
                    self:.refit(h);
                }
            }

            self._kinematicFrom[h] = now;
        }
    }

    /**
     * Push a dynamic body by an impulse at a point of the world, its velocities changed at once, waking it
     * @params:
     *    - impulse: the impulse, in newton seconds
     *    - at: the point of the world it pushes at
     *
     * @info: does nothing for another body, or when the world has no such body
     *
     * */
    pub fn applyImpulse(mut self, handle: u32, impulse: vec3, at: vec3) {
        if !self.isDynamic(handle) { return; }

        let mut state = self._states[handle];
        state:.applyImpulse(impulse, at);
        self._states[handle] = state;
        self:.refit(handle);
    }

    /**
     * Push a dynamic body by a force at a point of the world until the forces are cleared (see clearForces), waking it
     * @params:
     *    - force: the force, in newtons
     *    - at: the point of the world it pushes at
     *
     * @info: does nothing for another body, or when the world has no such body
     *
     * */
    pub fn applyForce(mut self, handle: u32, force: vec3, at: vec3) {
        if !self.isDynamic(handle) { return; }

        let mut state = self._states[handle];
        state:.applyForce(force, at);
        self._states[handle] = state;
    }

    /**
     * Drop the forces and the torques of the bodies, at the end of a tick
     * */
    pub fn clearForces(mut self) {
        for i in 0us .. self._states.len {
            self._states[i].force = vec3();
            self._states[i].torque = vec3();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          JOINTS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Join two bodies by a frame of the world, placed on both as they are: its origin the anchor, its X axis the axis of
     * a hinge or a slider, waking them, their time still counted again from 0
     *
     * @params:
     *    - a, b: the two bodies, the frame of a hinge or a slider turning with the first
     *    - frame: the frame of the joint in the world
     *    - settings: how the joint holds the two
     *
     * @returns: the handle of the joint, NO_JOINT when one of the bodies is not in the world or both are the same
     *
     * @info: the position of a hinge or a slider is 0 as the joint is made; a joint between two bodies that are not
     * dynamic holds nothing
     *
     * */
    pub fn addJoint(mut self, a: u32, b: u32, frame: RigidTransform, settings: JointSettings = JointSettings())-> u32 {
        if !self.contains(a) || !self.contains(b) || a == b {
            log::error #("PhysicsWorld", f"A joint needs two bodies of the world, not ${a} and ${b}");
            return NO_JOINT;
        }

        let handle = if self._freeJoint != NO_JOINT {
            let h = self._freeJoint;
            self._freeJoint = self._joints[h].next;
            h
        } else {
            self._joints = self._joints ~ copy [WorldJoint()];
            cast!u32(self._joints.len - 1us)
        };

        let joint = Joint(a-> a, b-> b, settings-> settings,
                          frameA-> self._states[a].pose.inversed() * frame,
                          frameB-> self._states[b].pose.inversed() * frame);
        self._joints[handle] = WorldJoint(joint-> joint, used-> true);
        self._jointLen += 1us;
        self:.holdApart(joint, true);

        self:.wake(a);
        self:.wake(b);
        handle
    }

    /**
     * Remove a joint from the world, its handle free for another joint, waking its bodies
     * @info: does nothing when the world has no such joint
     * */
    pub fn removeJoint(mut self, handle: u32) {
        if !self.containsJoint(handle) { return; }

        let joint = self._joints[handle].joint;
        if !joint.broken { self:.holdApart(joint, false); }

        self._joints[handle] = WorldJoint(next-> self._freeJoint);
        self._freeJoint = handle;
        self._jointLen -= 1us;
        self._broken = copy [j for j in self._broken if j != handle];

        self:.wake(joint.a);
        self:.wake(joint.b);
    }

    /**
     * Change how a joint holds its bodies, waking them; the impulses it gathered kept
     * @info: does nothing when the world has no such joint, or for a broken joint, which holds nothing
     * */
    pub fn setJointSettings(mut self, handle: u32, settings: JointSettings) {
        if !self.containsJoint(handle) || self._joints[handle].joint.broken { return; }

        let mut joint = self._joints[handle].joint;
        self:.holdApart(joint, false);
        joint.settings = settings;
        if !settings.motor { joint.motorImpulse = 0.0f; }
        if !settings.limited {
            joint.lowerImpulse = 0.0f;
            joint.upperImpulse = 0.0f;
        }

        self._joints[handle].joint = joint;
        self:.holdApart(joint, true);

        self:.wake(joint.a);
        self:.wake(joint.b);
    }

    /**
     * @returns: true iif a joint of the world has a handle
     * */
    pub fn containsJoint(self, handle: u32)-> bool {
        cast!usize(handle) < self._joints.len && self._joints[handle].used
    }

    /**
     * @returns: a joint: its bodies, its settings, its frames on them, whether it broke
     * @warning: the joint is in the world (see containsJoint)
     * */
    pub fn getJoint(self, handle: u32)-> Joint {
        self._joints[handle].joint
    }

    /**
     * @returns: the frames of a joint in the world, on its first body and on its second, one on the other while the joint
     * holds
     * @warning: the joint is in the world (see containsJoint)
     * */
    pub fn jointFrames(self, handle: u32)-> (RigidTransform, RigidTransform) {
        let joint = self._joints[handle].joint;
        (self._states[joint.a].pose * joint.frameA, self._states[joint.b].pose * joint.frameB)
    }

    /**
     * @returns: the position of a joint: the angle a hinge turned by about its axis since it was made, in radians within
     * [-pi, pi], the distance a slider slid along its axis, in metres; 0 for another joint
     * @warning: the joint is in the world (see containsJoint)
     * */
    pub fn jointPosition(self, handle: u32)-> f32 {
        let (fa, fb) = self.jointFrames(handle);
        joint_solver::positionOf(self._joints[handle].joint.settings.kind, fa.rotation, fb.rotation,
                                 fb.position - fa.position)
    }

    /**
     * @returns: the handles of the joints of the world, in their order
     * */
    pub yield jointHandles(self)-> u32 {
        for i in 0us .. self._joints.len if self._joints[i].used {
            yield cast!u32(i);
        }
    }

    /**
     * @returns: the joints broken since the last call, forgotten
     * */
    pub fn takeBroken(mut self)-> [u32] {
        let broken = self._broken;
        self._broken = [];
        broken
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          QUERIES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the body a ray hits first, the boxes of the bodies it enters visited closest first
     * @returns: the hit, none when the ray misses every body the filter keeps
     * */
    pub fn raycast(self, ray: Ray, filter: QueryFilter = QueryFilter())-> (PhysicsHit)? {
        let first = self._bvh.raycast(ray, copy |id: usize, _: f32| {
            if !self.accepts(cast!u32(id), filter) {
                f32::max
            } else if let Ok(h) = self._bodies[id].collider.raycast(ray) {
                h.distance
            } else {
                f32::max
            }
        });

        let mut best: (PhysicsHit)? = none;
        if let Ok(f) = first {
            if let Ok(h) = self._bodies[f.id].collider.raycast(ray) {
                best = utils::hitOf(cast!u32(f.id), h)?;
            }
        }

        for id in self._planes if self.accepts(cast!u32(id), filter) {
            if let Ok(h) = self._bodies[id].collider.raycast(ray) {
                let closer = if let Ok(b) = best {
                    h.distance < b.distance
                } else {
                    true
                };

                if closer {
                    best = utils::hitOf(cast!u32(id), h)?;
                }
            }
        }

        best
    }

    /**
     * Find every body a ray hits
     * @returns: the hits, the closest first, a body being hit once, where the ray hits it first
     * */
    pub fn raycastAll(self, ray: Ray, filter: QueryFilter = QueryFilter())-> [PhysicsHit] {
        let mut hits: [PhysicsHit] = [];
        for id in self.alongRay(ray) if self.accepts(cast!u32(id), filter) {
            if let Ok(h) = self._bodies[id].collider.raycast(ray) {
                hits ~= [utils::hitOf(cast!u32(id), h)];
            }
        }

        let dmut sorted = copy hits;
        sorting::sort(alias sorted, |x, y| => { x.distance < y.distance });
        sorted
    }

    /**
     * Move a convex shape along a direction until it hits a body (see gjk::sweep)
     * @params:
     *    - shape: the shape moved, a box, a sphere or a capsule (a mesh hits nothing), in the space of the transformation
     *    - transform: the transformation placing the shape in the world where it starts
     *    - direction: the direction it moves along
     *    - length: the distance it travels at most
     * @returns: the body hit first, at the distance the shape travels to touch it, 0 for a body it starts touching; none
     * when it hits no body the filter keeps
     * */
    pub fn shapeCast(self, shape: ColliderShape, transform: mat4, direction: vec3, length: f32,
                     filter: QueryFilter = QueryFilter())-> (PhysicsHit)? {
        if shape.kind == ColliderKind::MESH { return none; }

        self.castConvex(Collider(shape, transform).convex(), direction, length, filter)
    }

    /**
     * Move a sphere along a direction until it hits a body (see shapeCast)
     * @params:
     *    - origin: the centre of the sphere where it starts
     * */
    pub fn sphereCast(self, origin: vec3, radius: f32, direction: vec3, length: f32,
                      filter: QueryFilter = QueryFilter())-> (PhysicsHit)? {
        self.castConvex(Convex::sphere(origin, radius), direction, length, filter)
    }

    /**
     * Find the bodies sharing a point with a shape, crossing a triangle of a mesh
     * @params:
     *    - shape: the shape, a box, a sphere or a capsule (a mesh overlaps nothing), in the space of the transformation
     *    - transform: the transformation placing the shape in the world
     * @returns: the handles of the bodies the filter keeps overlapping the shape, in no order
     * */
    pub fn overlapShape(self, shape: ColliderShape, transform: mat4, filter: QueryFilter = QueryFilter())-> [u32] {
        if shape.kind == ColliderKind::MESH { return []; }

        self.overlapConvex(Collider(shape, transform).convex(), filter)
    }

    /**
     * @returns: how deep a shape sinks into each body it overlaps, a contact by sub shape of the body it sinks into (a
     * part of a compound, a triangle of a mesh), the bodies of the filter only; none for a mesh, nor for a shape barely
     * touching a body
     * @info: a shape moved against the normal of a contact by its depth gets out of that sub shape; the character
     * controller pushes its capsule out of the level with them (see CharacterController)
     * */
    pub fn penetrations(self, shape: ColliderShape, transform: mat4, filter: QueryFilter = QueryFilter())-> [ShapeContact] {
        if shape.kind == ColliderKind::MESH { return []; }

        let collider = Collider(shape, transform);
        let mut result: [ShapeContact] = [];
        for id in self.candidates(collider.bounds) if self.accepts(cast!u32(id), filter) {
            for m in narrow::collide(collider, self._bodies[id].collider, 0.0f) {
                let mut deepest: (ContactPoint)? = none;
                for p in m.points if p.depth > 0.0f {
                    let deeper = if let Ok(d) = deepest { p.depth > d.depth } else { true };
                    if deeper { deepest = p?; }
                }

                if let Ok(d) = deepest {
                    result ~= [ShapeContact(body-> cast!u32(id), normal-> m.normal, depth-> d.depth, point-> d.point)];
                }
            }
        }

        result
    }

    /**
     * Find the bodies sharing a point with a sphere (see overlapShape)
     * */
    pub fn overlapSphere(self, centre: vec3, radius: f32, filter: QueryFilter = QueryFilter())-> [u32] {
        self.overlapConvex(Convex::sphere(centre, radius), filter)
    }

    /**
     * Find the bodies sharing a point with a box (see overlapShape)
     * @params:
     *    - centre: the centre of the box
     *    - size: the sides of the box along its axes
     *    - rotation: the rotation of the box, from its axes to those of the world
     * */
    pub fn overlapBox(self, centre: vec3, size: vec3, rotation: Quaternion = Quaternion(),
                      filter: QueryFilter = QueryFilter())-> [u32] {
        let h = size / 2.0f;
        let box = Convex::box(centre, rotation * makeVec3(h.x, 0.0f, 0.0f), rotation * makeVec3(0.0f, h.y, 0.0f),
                              rotation * makeVec3(0.0f, 0.0f, h.z));
        self.overlapConvex(box, filter)
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          STEP          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Advance the dynamic bodies by a step: the pairs and their manifolds updated, the bodies grouped in islands, each
     * awake island solved and moved in sub steps with its joints (see solveIsland), the islands still for long enough put
     * to sleep
     *
     * @params:
     *    - dt: the duration of the step, in seconds
     *
     * */
    pub fn step(mut self, dt: f32) {
        if dt <= 0.0f { return; }

        let start = Instant::now();
        let mut timings = StepTimings();
        self._step = dt;
        for i in 0us .. self._states.len {
            self._previous[i] = self._states[i].pose;
            if self.isBullet(cast!u32(i)) { self:.measureBullet(cast!u32(i)); }
        }

        let beforePairs = Instant::now();
        self:.updatePairs();
        let beforeManifolds = Instant::now();
        self:.updateAllManifolds();

        let beforeIslands = Instant::now();
        self:.groupIslands();
        self:.wakeTouched();

        let beforeSolve = Instant::now();
        for k in 0us .. self._islands.len {
            let island = self._islands.bodiesOf(k);
            if !self._states[island[0]].awake { continue; }

            timings.constraintCount += self:.solveIsland(island, self._islands.slotsOf(k), self._islands.jointsOf(k), dt);
            timings.awakeCount += island.len;
        }

        let beforeSleep = Instant::now();
        self:.sleepIslands(dt);
        let end = Instant::now();

        timings.pairs = utils::microsBetween(beforePairs, beforeManifolds);
        timings.manifolds = utils::microsBetween(beforeManifolds, beforeIslands);
        timings.islands = utils::microsBetween(beforeIslands, beforeSolve);
        timings.solve = utils::microsBetween(beforeSolve, beforeSleep);
        timings.sleep = utils::microsBetween(beforeSleep, end);
        timings.total = utils::microsBetween(start, end);
        timings.pairCount = self._pairs.len;
        timings.islandCount = self._islands.len;
        self._timings = timings;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          PAIRS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the pairs of bodies whose enlarged boxes started overlapping around
     * the bodies moved since the last update, and drop those whose boxes no
     * longer overlap or that may no longer touch
     *
     * @returns: the pairs dropped, as they were before
     *
     * */
    pub fn updatePairs(mut self)-> [BroadPair] {
        if self._bvh.isDegraded {
            self._bvh:.rebuild();
        }

        for handle, _ in self._moved if self.contains(handle) {
            for j in self.candidatesOf(handle) if j != cast!usize(handle) {
                if utils::canTouch(self._bodies[handle], self._bodies[j]) && !(pairKey(handle, cast!u32(j)) in self._apart) {
                    self._pairs:.add(handle, cast!u32(j));
                }
            }
        }

        self._moved = copy [];
        let mut dropped: [BroadPair] = [];
        let mut slot = 0us;
        while slot < self._pairs.len {
            let p = self._pairs.get(slot);
            if self.keeps(p) {
                slot += 1us;
            } else {
                self._pairs:.remove(pairKey(p.a, p.b));
                dropped ~= [p];
                if p.reported { self._endedUnreported ~= [p]; }
            }
        }

        dropped
    }

    /**
     * @returns: the bodies a body may pair with: every body for a plane, those
     * whose enlarged box overlaps its own and the planes otherwise
     *
     * */
    yield candidatesOf(self, handle: u32)-> usize {
        let collider = self._bodies[handle].collider;
        if collider.isPlane {
            for i in 0 .. self._bodies.len if self._bodies[i].used {
                yield i;
            }
        }

        for i in self._bvh.overlapping(self._bvh.getBox(cast!usize(handle))) {
            yield i;
        }

        for i in self._planes {
            yield i;
        }
    }

    /**
     * @returns: true iif a pair stays: its bodies in the world, still able to
     * touch, held apart by no joint, their enlarged boxes overlapping (a plane
     * overlapping every box)
     *
     * */
    fn keeps(self, p: BroadPair)-> bool {
        if !self.contains(p.a) || !self.contains(p.b) {
            return false;
        }

        if !utils::canTouch(self._bodies[p.a], self._bodies[p.b]) || pairKey(p.a, p.b) in self._apart {
            return false;
        }

        if self._bodies[p.a].collider.isPlane || self._bodies[p.b].collider.isPlane {
            return true;
        }

        self._bvh.getBox(cast!usize(p.a)).overlaps(self._bvh.getBox(cast!usize(p.b)))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SLEEPING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Count the time each awake dynamic body that can sleep stays still during a step
     *
     * @returns: the handles of the bodies still for long enough to sleep, their
     * islands deciding whether they do
     *
     * */
    pub fn updateSleep(mut self, dt: f32)-> [u32] {
        let mut ready: [u32] = [];
        for i in 0 .. self._bodies.len {
            let body = self._bodies[i];
            if !body.used || body.settings.motion != BodyMotion::DYNAMIC || !body.settings.canSleep {
                continue;
            }

            if !self._states[i].awake {
                continue;
            }

            let mut state = self._states[i];
            if state:.updateSleep(dt, self._sleep) {
                ready ~= [cast!u32(i)];
            }
            self._states[i] = state;
        }

        ready
    }

    /**
     * Wake a dynamic body asleep
     *
     * @info: does nothing for another body, or when the world has no such body
     *
     * */
    pub fn wake(mut self, handle: u32) {
        if !self.contains(handle) || self._bodies[handle].settings.motion != BodyMotion::DYNAMIC {
            return;
        }

        let mut state = self._states[handle];
        state:.wake();
        self._states[handle] = state;
    }

    /**
     * Wake the dynamic bodies a body is in contact with or joined to, a body moved by the game not leaving them asleep
     * in the air
     * */
    pub fn wakeContactsOf(mut self, handle: u32) {
        for slot in 0us .. self._pairs.len {
            let p = self._pairs.get(slot);
            if p.a == handle { self:.wakeIfAsleep(p.b); }
            else if p.b == handle { self:.wakeIfAsleep(p.a); }
        }

        for j in self.jointsOf(handle) {
            let joint = self._joints[j].joint;
            self:.wakeIfAsleep(if joint.a == handle { joint.b } else { joint.a });
        }
    }

    /**
     * Put a dynamic body to sleep, its velocities dropped, until something
     * wakes it (see wake)
     *
     * @info: does nothing for another body, or when the world has no such body
     *
     * */
    pub fn sleep(mut self, handle: u32) {
        if !self.contains(handle) || self._bodies[handle].settings.motion != BodyMotion::DYNAMIC {
            return;
        }

        let mut state = self._states[handle];
        state:.sleep();
        self._states[handle] = state;
        self._slept[handle] = true;
    }

    /**
     * @returns: the dynamic bodies put to sleep since the last call, forgotten, the display placing them one last time
     * where they stopped
     * */
    pub fn takeSlept(mut self)-> [u32] {
        let mut result: [u32] = [];
        for h, _ in self._slept if self.isDynamic(h) && !self._states[h].awake {
            result ~= [h];
        }

        self._slept = copy [];
        result
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CONTACTS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the pairs of bodies touching each other without a step, one of them at least being kinematic, dynamic or a
     * trigger and one of them seeing the other through its mask, then report their contacts (see contactEvents)
     * @returns: the contacts begun, those that stayed and those that ended since the last contact events (the removal
     * of a body ending its contacts at once, see remove)
     * */
    pub fn updateContacts(mut self)-> [ContactEvent] {
        self:.updatePairs();
        self:.updateAllManifolds();
        self:.contactEvents()
    }

    /**
     * @returns: the contacts begun, those that stayed and those that ended since the last call, from the touching of
     * each pair against what the last call reported: once a tick of a scene, whatever the steps it runs
     *
     * @info: a contact begun and ended between two calls is not reported
     *
     * */
    pub fn contactEvents(mut self)-> [ContactEvent] {
        let mut events: [ContactEvent] = [];
        for p in self._endedUnreported {
            events ~= [ContactEvent(a-> p.a, b-> p.b, phase-> ContactPhase::ENDED)];
        }

        self._endedUnreported = [];
        for slot in 0us .. self._pairs.len {
            let mut p = self._pairs.get(slot);
            if p.touching {
                let phase = if p.reported { ContactPhase::STAYED } else { ContactPhase::BEGAN };
                events ~= [ContactEvent(a-> p.a, b-> p.b, phase-> phase)];
            } else if p.reported {
                events ~= [ContactEvent(a-> p.a, b-> p.b, phase-> ContactPhase::ENDED)];
            }

            if p.reported != p.touching {
                p.reported = p.touching;
                self._pairs:.set(slot, p);
            }
        }

        events
    }

    /**
     * @returns: the handles of the bodies a body touched at the last update of the contacts
     * */
    pub yield contactsOf(self, handle: u32)-> u32 {
        for p in self._pairs.pairs if p.touching {
            if p.a == handle { yield p.b; }
            else if p.b == handle { yield p.a; }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the manifolds of the pairs, a pair whose bodies are both asleep or static keeping its own (a trigger
     * always looking again)
     * */
    fn updateAllManifolds(mut self) {
        for slot in 0us .. self._pairs.len {
            let p = self._pairs.get(slot);
            let a = self._bodies[p.a], b = self._bodies[p.b];
            let still = !self._states[p.a].awake && !self._states[p.b].awake;
            if still && !a.settings.trigger && !b.settings.trigger { continue; }

            self:.updateManifolds(slot);
        }
    }

    /**
     * Count the time the bodies of each awake island stayed still during a step, the island sleeping when all its
     * bodies stayed still for long enough and may sleep
     * */
    fn sleepIslands(mut self, dt: f32) {
        for k in 0us .. self._islands.len {
            let island = self._islands.bodiesOf(k);
            if !self._states[island[0]].awake { continue; }

            let mut ready = true;
            for b in island {
                let mut s = self._states[b];
                let still = s:.updateSleep(dt, self._sleep);
                self._states[b] = s;
                if !still || !self._bodies[b].settings.canSleep { ready = false; }
            }

            if ready {
                for b in island { self:.sleep(b); }
            }
        }
    }

    /**
     * Solve and move an island during a step: its dynamic bodies, and the static and kinematic bodies they touch,
     * copied as solver bodies, the constraints of their points prepared, then, at each sub step, the velocities
     * changed by gravity and the forces, the constraints warm started and solved, the bodies moved, the velocities the
     * correction of the penetrations left relaxed; the impulses written back to the points for the next step, the
     * velocities and the poses to the states
     *
     * @params:
     *    - island: the dynamic bodies of the island
     *    - slots: the slots of the pairs in contact of the island
     *    - joints: the joints of the island holding, warm started and solved before the contacts at each sub step
     *
     * @returns: the number of points of contact solved
     *
     * @info: the contacts are found once a step, the sub steps moving the separation of each point by the motion of
     * its bodies (Box2D v3, solver2d); a stack holds still at a shorter step where more passes over the contacts of a
     * longer one leave it swaying
     *
     * */
    fn solveIsland(mut self, island: [u32], slots: [usize], joints: [u32], dt: f32)-> usize {
        while self._solverIndex.len < self._bodies.len { self._solverIndex ~= [NOT_SOLVED]; }

        let mut nbodies = 0us;
        for b in island {
            nbodies = self:.addSolverBody(b, nbodies);
        }

        let mut nconstraints = 0us;
        let mut npoints = 0us;
        for slot in slots {
            let p = self._pairs.get(slot);
            nbodies = self:.addSolverBody(p.a, nbodies);
            nbodies = self:.addSolverBody(p.b, nbodies);

            let ia = self._solverIndex[p.a], ib = self._solverIndex[p.b];
            let (friction, restitution) = solver::materialOf(self._bodies[p.a].settings, self._bodies[p.b].settings);
            let (rolling, spinning) = solver::rollingOf(self._bodies[p.a].settings, self._bodies[p.b].settings);
            for m in 0us .. p.manifolds.len {
                let manifold = p.manifolds[m];
                let mut c = solver::prepare(ia, ib, manifold.normal, friction, npoints);
                c.slot = slot;
                c.manifold = m;
                c.count = manifold.points.len;
                for k in 0us .. manifold.points.len {
                    let mut cp = solver::preparePoint(self._solverBodies[0us .. nbodies], c, manifold.points[k],
                                                      restitution, self._solver);
                    cp.point = k;
                    if npoints < self._points.len { self._points[npoints] = cp; } else { self._points ~= [cp]; }
                    npoints += 1us;
                }

                c = solver::prepareRolling(self._solverBodies[0us .. nbodies], c, self._points[c.first .. npoints],
                                           rolling, spinning, manifold.rollingImpulse);
                if nconstraints < self._constraints.len {
                    self._constraints[nconstraints] = c;
                } else {
                    self._constraints ~= [c];
                }
                nconstraints += 1us;
            }
        }

        let mut njoints = 0us;
        for j in joints {
            let joint = self._joints[j].joint;
            nbodies = self:.addSolverBody(joint.a, nbodies);
            nbodies = self:.addSolverBody(joint.b, nbodies);

            let c = joint_solver::prepare(self._solverBodies[0us .. nbodies], self._solverIndex[joint.a],
                                          self._solverIndex[joint.b], j, joint, self._states[joint.a],
                                          self._states[joint.b]);
            if njoints < self._jointConstraints.len {
                self._jointConstraints[njoints] = c;
            } else {
                self._jointConstraints ~= [c];
            }
            njoints += 1us;
        }

        let dmut bodies = alias self._solverBodies[0us .. nbodies];
        let dmut constraints = alias self._constraints[0us .. nconstraints];
        let dmut points = alias self._points[0us .. npoints];
        let dmut held = alias self._jointConstraints[0us .. njoints];

        let substeps = comparison::max(self._solver.substeps, 1u32);
        let h = dt / cast!f32(substeps);
        for _ in 0u32 .. substeps {
            solver::integrateVelocities(alias bodies, h);
            joint_solver::warmStart(alias bodies, held);
            solver::warmStart(alias bodies, constraints, points);
            for _ in 0u32 .. self._solver.iterations {
                joint_solver::solve(alias bodies, alias held, h, self._solver, true);
                solver::solve(alias bodies, alias constraints, alias points, h, self._solver, true);
            }

            solver::integratePositions(alias bodies, h);
            joint_solver::solve(alias bodies, alias held, h, self._solver, false);
            solver::solve(alias bodies, alias constraints, alias points, h, self._solver, false);
        }

        solver::applyRestitution(alias bodies, constraints, alias points);
        self:.storeImpulses(constraints, points);
        self:.storeJoints(held, h);

        for sb in bodies if self.isDynamic(sb.handle) {
            let mut turn = sb.deltaRotation;
            let mut shift = sb.deltaPosition;
            if self._bodies[sb.handle].settings.bullet {
                let motion = StepMotion(sb.centre, sb.deltaPosition, sb.deltaRotation);
                if self.isFast(sb.handle, motion.displacement.length(), motion.angle) {
                    if let Ok(f) = self.impactOf(sb.handle, motion) {
                        turn = motion.rotationAt(f);
                        shift = sb.deltaPosition * f;
                    }
                }
            }

            let mut s = self._states[sb.handle];
            s.linearVelocity = sb.linearVelocity;
            s.angularVelocity = sb.angularVelocity;
            s.pose.rotation = (turn * s.pose.rotation).normalized();
            s.pose.position = sb.centre + shift - s.pose.rotation * s.centre;
            s:.refresh();
            self._states[sb.handle] = s;

            self:.place(sb.handle, Collider(self._bodies[sb.handle].collider.shape, s.placement));
        }

        for sb in bodies { self._solverIndex[sb.handle] = NOT_SOLVED; }
        npoints
    }

    /**
     * Copy a body into the solver bodies of the island being solved, unless it is there already
     * @params:
     *    - handle: the body
     *    - len: the number of solver bodies of the island
     * @returns: the number of solver bodies of the island with the body
     * */
    fn addSolverBody(mut self, handle: u32, len: usize)-> usize {
        if self._solverIndex[handle] != NOT_SOLVED { return len; }

        let b = self.solverBodyOf(handle);
        if len < self._solverBodies.len { self._solverBodies[len] = b; } else { self._solverBodies ~= [b]; }
        self._solverIndex[handle] = len;
        len + 1us
    }

    /**
     * Write the impulses the points gathered back to the points of their manifolds, and the angular impulses of the
     * rolling and the spinning back to the manifolds, the constraints of a pair following each other
     * */
    fn storeImpulses(mut self, constraints: [ContactConstraint], points: [ConstraintPoint]) {
        let mut k = 0us;
        while k < constraints.len {
            let slot = constraints[k].slot;
            let mut p = self._pairs.get(slot);
            let dmut manifolds = copy p.manifolds;
            while k < constraints.len && constraints[k].slot == slot {
                let c = constraints[k];
                let m = manifolds[c.manifold];
                let dmut stored = copy m.points;
                for j in c.first .. c.first + c.count {
                    let cp = points[j];
                    stored[cp.point].normalImpulse = cp.normalImpulse;
                    stored[cp.point].frictionImpulse = c.tangent1 * cp.tangentImpulse1 + c.tangent2 * cp.tangentImpulse2;
                }

                let mut kept = ContactManifold(m.key, m.normal, stored);
                kept.rollingImpulse = c.tangent1 * c.rollingImpulse1 + c.tangent2 * c.rollingImpulse2
                    + c.normal * c.spinningImpulse;
                manifolds[c.manifold] = kept;
                k += 1us;
            }

            p.manifolds = manifolds;
            self._pairs:.set(slot, p);
        }
    }

    /**
     * Write the impulses the joints gathered back to them for the next step, breaking those that held their bodies by
     * more than their settings allow, their bodies woken
     * @params:
     *    - h: the duration of a sub step, the impulses gathered being those of a sub step
     * */
    fn storeJoints(mut self, joints: [JointConstraint], h: f32) {
        for c in joints {
            let mut joint = self._joints[c.joint].joint;
            let (force, torque) = joint_solver::loadsOf(c, h);
            let s = joint.settings;
            if (s.breakForce > 0.0f && force > s.breakForce) || (s.breakTorque > 0.0f && torque > s.breakTorque) {
                self:.holdApart(joint, false);
                self._joints[c.joint].joint = Joint(a-> joint.a, b-> joint.b, settings-> s, frameA-> joint.frameA,
                                                    frameB-> joint.frameB, broken-> true);
                self._broken ~= [c.joint];

                // held still by the joint up to now, the two are not left to sleep where nothing holds them
                self:.wake(joint.a);
                self:.wake(joint.b);
                continue;
            }

            joint.linearImpulse = c.linearImpulse;
            joint.angularImpulse = c.angularImpulse;
            joint.motorImpulse = c.motorImpulse;
            joint.lowerImpulse = c.lowerImpulse;
            joint.upperImpulse = c.upperImpulse;
            self._joints[c.joint].joint = joint;
        }
    }

    /**
     * Count a joint holding its two bodies apart, or no longer, unless its bodies touch each other; the two looking for
     * their pairs again once they are no longer held apart
     * @params:
     *    - holds: true when the joint starts holding them, false when it stops
     * */
    fn holdApart(mut self, joint: Joint, holds: bool) {
        if joint.settings.collide { return; }

        let key = pairKey(joint.a, joint.b);
        let count = if let Ok(n) = self._apart[key] { n } else { 0u32 };
        if holds {
            self._apart[key] = count + 1u32;
        } else if count <= 1u32 {
            self._apart:.remove(key);
            self._moved[joint.a] = true;
            self._moved[joint.b] = true;
        } else {
            self._apart[key] = count - 1u32;
        }
    }

    /**
     * @returns: the joints of a body, broken or not
     * */
    fn jointsOf(self, handle: u32)-> [u32] {
        let mut result: [u32] = [];
        for i in 0us .. self._joints.len if self._joints[i].used {
            let joint = self._joints[i].joint;
            if joint.a == handle || joint.b == handle { result ~= [cast!u32(i)]; }
        }

        result
    }

    /**
     * @returns: true iif a joint of the world holds its bodies, not broken
     * */
    fn holds(self, handle: u32)-> bool {
        self._joints[handle].used && !self._joints[handle].joint.broken
    }

    /**
     * @returns: a body as the solver pushes and moves it, gravity and its forces accelerating a dynamic body, nothing
     * pushing nor moving a static or a kinematic body
     * */
    fn solverBodyOf(self, handle: u32)-> SolverBody {
        let s = self._states[handle];
        let mut b = SolverBody(handle-> handle,
                               linearVelocity-> s.linearVelocity,
                               angularVelocity-> s.angularVelocity,
                               centre-> s.worldCentre);
        if self.isDynamic(handle) {
            let settings = self._bodies[handle].settings;
            b.inverseMass = s.inverseMass;
            b.inverseInertia = s.inverseInertia;
            b.linearAcceleration = self._gravity + s.force * s.inverseMass;
            b.angularAcceleration = s.inverseInertia * s.torque;
            b.linearDamping = settings.linearDamping;
            b.angularDamping = settings.angularDamping;
        }

        b
    }

    /**
     * Group the dynamic bodies in islands, those in contact through their pairs (a point of a manifold, even
     * speculative) or held by a joint put in one island, a static or a kinematic body joining none; a dynamic body in
     * contact with no other an island of its own; the sleeping bodies in their islands too; the pairs in contact and the
     * joints holding dealt to the islands of their dynamic bodies
     *
     * */
    fn groupIslands(mut self) {
        self._islands:.reset(self._bodies.len);
        for p in self._pairs.pairs if utils::inContact(p) && self.isDynamic(p.a) && self.isDynamic(p.b) {
            self._islands:.join(p.a, p.b);
        }

        for i in 0us .. self._joints.len if self.holds(cast!u32(i)) {
            let joint = self._joints[i].joint;
            if self.isDynamic(joint.a) && self.isDynamic(joint.b) { self._islands:.join(joint.a, joint.b); }
        }

        for i in 0us .. self._bodies.len if self.isDynamic(cast!u32(i)) {
            self._islands:.addBody(cast!u32(i));
        }
        self._islands:.sealBodies();

        for slot in 0us .. self._pairs.len {
            let p = self._pairs.get(slot);
            if utils::inContact(p) { self._islands:.addSlot(slot, p.a, p.b); }
        }
        self._islands:.sealSlots();

        for i in 0us .. self._joints.len if self.holds(cast!u32(i)) {
            let joint = self._joints[i].joint;
            self._islands:.addJoint(cast!u32(i), joint.a, joint.b);
        }
        self._islands:.sealJoints();
    }

    /**
     * Wake the sleeping dynamic bodies in contact with, or joined to, an awake dynamic body or a moving kinematic body,
     * their whole island with them: a stack woken at once, not a body a step
     *
     * */
    fn wakeTouched(mut self) {
        for p in self._pairs.pairs if utils::inContact(p) {
            if self.pushes(p.a) { self:.wakeIfAsleep(p.b); }
            if self.pushes(p.b) { self:.wakeIfAsleep(p.a); }
        }

        for i in 0us .. self._joints.len if self.holds(cast!u32(i)) {
            let joint = self._joints[i].joint;
            if self.pushes(joint.a) { self:.wakeIfAsleep(joint.b); }
            if self.pushes(joint.b) { self:.wakeIfAsleep(joint.a); }
        }

        for k in 0us .. self._islands.len {
            let island = self._islands.bodiesOf(k);
            let mut awake = false;
            for b in island if self._states[b].awake { awake = true; }

            if awake {
                for b in island { self:.wakeIfAsleep(b); }
            }
        }
    }

    /**
     * Wake a dynamic body if it sleeps, an awake body counting its time still on
     * */
    fn wakeIfAsleep(mut self, handle: u32) {
        if self.isDynamic(handle) && !self._states[handle].awake {
            self:.wake(handle);
        }
    }

    /**
     * @returns: true iif a body wakes those it is in contact with: a dynamic body awake, a kinematic body moving
     * */
    fn pushes(self, handle: u32)-> bool {
        let s = self._states[handle];
        match self._bodies[handle].settings.motion {
            BodyMotion::DYNAMIC => { s.awake }
            BodyMotion::KINEMATIC => {
                s.linearVelocity.dot(s.linearVelocity) > 0.0f || s.angularVelocity.dot(s.angularVelocity) > 0.0f
            }
            _ => { false }
        }
    }

    /**
     * Find the manifolds of a pair that is not a trigger from those of the step
     * before, and whether it touches: a point of a manifold that is not
     * speculative; a trigger only telling whether it overlaps
     *
     * @returns: the pair updated, in its slot
     *
     * */
    fn updateManifolds(mut self, slot: usize)-> BroadPair {
        let mut p = self._pairs.get(slot);
        let a = self._bodies[p.a], b = self._bodies[p.b];
        if a.settings.trigger || b.settings.trigger {
            p.manifolds = [];
            p.touching = a.collider.touches(b.collider);
        } else {
            p.manifolds = narrow::collideWith(alias self._scratch, a.collider, b.collider, self.speculativeOf(p),
                                              p.manifolds);
            p.touching = false;
            for m in p.manifolds if m.touching {
                p.touching = true;
            }
        }

        self._pairs:.set(slot, p);
        p
    }

    /**
     * @returns: the distance apart down to which a pair makes speculative
     * points: what its bodies may travel toward each other in a step, by their
     * speeds and by their spins at the reach of their boxes, SPECULATIVE_FLOOR at
     * least; the speed of a bullet left out against a body that is not dynamic,
     * its advancement stopping it there (see impactOf)
     *
     * */
    fn speculativeOf(self, p: BroadPair)-> f32 {
        let (va, spinA) = self.coveredOf(p.a, p.b);
        let (vb, spinB) = self.coveredOf(p.b, p.a);
        SPECULATIVE_FLOOR + ((va - vb).length() + spinA + spinB) * self._step
    }

    /**
     * @returns: the motion of a body the speculative points of its pair with another one cover; for a fast bullet
     * against a body that is not dynamic, its spin only, at the reach of the cores of its shape (none for a ball), so
     * that a corner it passes by gets no point slowing it
     *    - 0: its linear velocity
     *    - 1: the speed of its spin at the reach of its box, or of its cores
     * */
    fn coveredOf(self, handle: u32, other: u32)-> (vec3, f32) {
        let s = self._states[handle];
        let spin = s.angularVelocity.length();
        if self.isBullet(handle) && !self.isDynamic(other)
            && self.isFast(handle, s.linearVelocity.length() * self._step, spin * self._step)
        {
            return (vec3(), spin * self._bodies[handle].coreReach);
        }

        (s.linearVelocity, spin * self.reachOf(handle))
    }

    /**
     * Measure a bullet at the start of a step: the distance from its centre of mass to the farthest point of the cores
     * of its shape, its parts for a compound (see Convex::reachFrom), and the thinnest half thickness of its parts (see
     * Convex::halfThickness)
     * */
    fn measureBullet(mut self, handle: u32) {
        let collider = self._bodies[handle].collider;
        let centre = self._states[handle].worldCentre;
        let mut reach = 0.0f;
        let mut thinnest = f32::max;
        if collider.isCompound {
            for p in collider.parts {
                let part = p.convex();
                reach = comparison::max(reach, part.reachFrom(centre));
                thinnest = comparison::min(thinnest, part.halfThickness);
            }
        } else if !collider.isPlane && !collider.isMesh {
            let shape = collider.convex();
            reach = shape.reachFrom(centre);
            thinnest = shape.halfThickness;
        }

        self._bodies[handle].coreReach = reach;
        self._bodies[handle].halfThickness = if thinnest == f32::max { 0.0f } else { thinnest };
    }

    /**
     * @returns: true iif a bullet moving by a distance and turning by an angle over a step is advanced along its motion
     * (see impactOf): what the cores of its shape travel reaches FAST_RATIO of its half thickness, a slower bullet
     * sinking by less into what it meets, its speculative points covering its speed (Box2D v3)
     * */
    fn isFast(self, handle: u32, distance: f32, angle: f32)-> bool {
        let body = self._bodies[handle];
        distance + angle * body.coreReach >= FAST_RATIO * body.halfThickness
    }

    /**
     * @returns: true iif a body of the world is a dynamic bullet, advanced along its motion at each step
     * */
    fn isBullet(self, handle: u32)-> bool {
        self.isDynamic(handle) && self._bodies[handle].settings.bullet
    }

    /**
     * Advance a bullet along its motion of a step against the static and the kinematic bodies it may touch (see
     * Collider::advance), each convex part of its collider where it starts
     * @params:
     *    - handle: the bullet
     *    - motion: its motion over the step, from the pose of its collider
     * @returns: the earliest fraction of the step at which the bullet comes within IMPACT_DISTANCE of one of them, none
     * when it hits none
     * */
    fn impactOf(self, handle: u32, motion: StepMotion)-> (f32)? {
        let collider = self._bodies[handle].collider;
        if !collider.isCompound {
            return self.impactOfPart(handle, collider.convex(), motion);
        }

        let mut best: (f32)? = none;
        for part in collider.parts {
            best = earliest(best, self.impactOfPart(handle, part.convex(), motion));
        }

        best
    }

    /**
     * @returns: the earliest fraction of the step at which a convex part of a bullet comes within IMPACT_DISTANCE of a
     * static or a kinematic body, none when it hits none
     * */
    fn impactOfPart(self, handle: u32, moving: Convex, motion: StepMotion)-> (f32)? {
        let swept = motion.bounds(moving.reachFrom(motion.pivot) + moving.margin);
        let mut best: (f32)? = none;
        for id in self.candidates(swept) if self.stops(handle, cast!u32(id)) {
            best = earliest(best, self._bodies[id].collider.advance(moving, motion, IMPACT_DISTANCE));
        }

        best
    }

    /**
     * @returns: true iif a body stops a bullet advanced along its motion: a static or a kinematic body that is not a
     * trigger, touching it by their layers and masks, held apart from it by no joint
     * */
    fn stops(self, bullet: u32, other: u32)-> bool {
        if other == bullet || !self.contains(other) { return false; }

        let body = self._bodies[other];
        if body.settings.motion == BodyMotion::DYNAMIC || body.settings.trigger { return false; }

        utils::canTouch(self._bodies[bullet], body) && !(pairKey(bullet, other) in self._apart)
    }

    /**
     * @returns: the half diagonal of the box of a body, 0 for a plane
     * */
    fn reachOf(self, handle: u32)-> f32 {
        let collider = self._bodies[handle].collider;
        if collider.isPlane { return 0.0f; }

        collider.bounds.extent.length()
    }

    /**
     * Place the collider of a body, its box refit in the hierarchy
     * */
    fn place(mut self, handle: u32, collider: Collider) {
        let before = self._bodies[handle].collider;
        self._bodies[handle].collider = collider;

        if before.isPlane != collider.isPlane {
            self:.unindex(handle, before.isPlane);
            if collider.isPlane {
                self._planes ~= [cast!usize(handle)];
            } else {
                self._bvh:.moveBox(cast!usize(handle), collider.bounds, BROAD_MARGIN);
            }
            self._moved[handle] = true;
            return;
        }

        if collider.isPlane {
            self._moved[handle] = true;
            return;
        }

        // the box covers what the body travels in the next step, its speculative points needing their pairs
        let s = self._states[handle];
        let travel = s.linearVelocity * self._step;
        let turn = s.angularVelocity.length() * collider.bounds.extent.length() * self._step;
        let grow = makeVec3(turn, turn, turn);
        let ahead = Aabb(collider.bounds.min - grow, collider.bounds.max + grow);
        if self._bvh:.moveBox(cast!usize(handle), ahead.merged(Aabb(ahead.min + travel, ahead.max + travel)), BROAD_MARGIN,
                              displacement-> travel * PREDICTION)
        {
            self._moved[handle] = true;
        }
    }

    /**
     * Fit the box of a body in the hierarchy again to what it travels in the next step, after its velocities changed
     * */
    fn refit(mut self, handle: u32) {
        self:.place(handle, self._bodies[handle].collider);
    }

    /**
     * @returns: true iif a query hits a body through its filter
     * */
    fn accepts(self, handle: u32, filter: QueryFilter)-> bool {
        let settings = self._bodies[handle].settings;
        if (settings.layer & filter.mask) == 0u32 { return false; }
        if settings.trigger && !filter.triggers { return false; }
        for e in filter.exclude if e == handle { return false; }

        true
    }

    /**
     * @returns: the body a convex shape moving along a direction hits first
     * */
    fn castConvex(self, moving: Convex, direction: vec3, length: f32, filter: QueryFilter)-> (PhysicsHit)? {
        if direction.dot(direction) <= 0.0f { return none; }

        let unit = direction.normalized();
        let swept = moving.bounds.merged(moving.translated(unit * length).bounds);
        let mut best: (PhysicsHit)? = none;
        for id in self.candidates(swept) if self.accepts(cast!u32(id), filter) {
            if let Ok(h) = self._bodies[id].collider.sweep(moving, unit, length) {
                let closer = if let Ok(b) = best { h.distance < b.distance } else { true };
                if closer { best = utils::hitOf(cast!u32(id), h)?; }
            }
        }

        best
    }

    /**
     * @returns: the handles of the bodies a convex shape overlaps
     * */
    fn overlapConvex(self, shape: Convex, filter: QueryFilter)-> [u32] {
        let mut result: [u32] = [];
        for id in self.candidates(shape.bounds) if self.accepts(cast!u32(id), filter) {
            if self._bodies[id].collider.overlaps(shape) { result ~= [cast!u32(id)]; }
        }

        result
    }

    /**
     * @returns: the bodies whose box overlaps a box of the world, and the planes
     *
     * */
    yield candidates(self, box: Aabb)-> usize {
        for i in self._bvh.overlapping(box) {
            yield i;
        }

        for i in self._planes {
            yield i;
        }
    }

    /**
     * @returns: the bodies whose box a ray enters, and the planes
     *
     * */
    yield alongRay(self, ray: Ray)-> usize {
        for i in self._bvh.alongRay(ray) {
            yield i;
        }

        for i in self._planes {
            yield i;
        }
    }

    /**
     * @returns: the bodies a collider may touch: every body for a plane, the
     * candidates of its box otherwise
     *
     * */
    yield near(self, collider: Collider)-> usize {
        if !collider.isPlane {
            yield in self.candidates(collider.bounds);
            return;
        }

        for i in 0us .. self._bodies.len if self._bodies[i].used {
            yield i;
        }
    }

    /**
     * Take a body out of the hierarchy, or out of the planes
     *
     * */
    fn unindex(mut self, handle: u32, plane: bool) {
        if !plane {
            self._bvh:.remove(cast!usize(handle));
            return;
        }

        let kept = copy [id for id in self._planes if id != cast!usize(handle)];
        self._planes = kept;
    }
}
