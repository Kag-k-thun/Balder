in step_timings;

/**
 * What the last step of a world cost: the time of each of its phases, in microseconds, and what it ran over
 *
 * @info: the phases follow each other in the step: the pairs of the broadphase updated, their manifolds found, the
 * islands grouped (and the sleeping ones woken), the awake islands solved and their bodies moved, the islands put to
 * sleep; total covers the whole step, the copy of the previous poses included
 *
 * */
@data
pub record StepTimings {

    // The update of the pairs: the hierarchy rebuilt when degraded, the pairs of the moved bodies found, those apart dropped
    let mut pairs: u64 = 0u64;

    // The narrowphase: the manifolds of the pairs whose bodies are not all asleep or static
    let mut manifolds: u64 = 0u64;

    // The islands grouped by their contacts, the islands touched woken, the pairs dealt to their islands
    let mut islands: u64 = 0u64;

    // The awake islands: their constraints prepared, solved in sub steps, their bodies moved and placed in the hierarchy
    let mut solve: u64 = 0u64;

    // The islands still for long enough put to sleep
    let mut sleep: u64 = 0u64;

    // The whole step
    let mut total: u64 = 0u64;

    // The pairs of the broadphase after the step
    let mut pairCount: usize = 0us;

    // The points of contact the solver pushed on, over the awake islands
    let mut constraintCount: usize = 0us;

    // The islands, asleep or awake
    let mut islandCount: usize = 0us;

    // The dynamic bodies the solver moved
    let mut awakeCount: usize = 0us;
}
