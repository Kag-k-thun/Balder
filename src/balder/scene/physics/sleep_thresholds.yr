in sleep_thresholds;

@data
pub record SleepThresholds {
    // The linear speed under which a body is still, in metres a second
    let mut linear: f32 = 0.05f;

    // The angular speed under which a body is still, in radians per second
    let mut angular: f32 = 0.05f;

    // The time a body stay still before it may sleep, in seconds
    let mut time: f32 = 0.5f;
}
