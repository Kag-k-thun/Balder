in broad_pair;


/**
 * A pair of bodies whose enlarged boxes overlap, kept from step to step while
 * they do
 *
 * */
@data
pub record BroadPair {

    // The smaller handle of the two bodies
    let mut a: u32 = 0u32;

    // The larger handle
    let mut b: u32 = 0u32;

    // True when the two touched at the last update of the manifolds
    let mut touching: bool = false;

    // True when the last contact events reported the two touching (see PhysicsWorld::contactEvents), the steps of a
    // tick updating the manifolds more often than the events are reported
    let mut reported: bool = false;

    // The manifolds of the convex sub shapes of the two bodies in contact, or
    // within the speculative distance, kept from step to step with the pair;
    // none for a trigger
    let mut manifolds: [ContactManifold] = [];
}
