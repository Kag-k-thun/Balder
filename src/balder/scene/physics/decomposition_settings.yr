in decomposition_settings;

use std::config;

/**
 * How a concave model is split into convex hulls (see ConvexDecomposition)
 * @info: serialized as the decomposition of the table [export] of a project (see Project)
 * */
#[serializable (case-> "kebab-case")]
@data
pub record DecompositionSettings {

    // The volume a hull may hold outside the model, over the volume of the model: a hull above it is split, two hulls
    // whose hull stays under it are merged
    let mut concavity: f32 = 0.01f;

    // The number of hulls at most, the hulls closest to convex being merged until there are no more
    #[key ("hulls")]
    let mut maxHulls: u32 = 16u32;

    // The number of vertices of a hull at most, four at least
    #[key ("vertices")]
    let mut maxVertices: u32 = 32u32;

    // The number of voxels along the longest side of the model, its volume being measured in voxels
    let mut resolution: u32 = 64u32;
}
