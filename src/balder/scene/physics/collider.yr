in collider;

mod ::utils;

use balder::math::{bounds, matrix, vector};

use std::algorithm::comparison;

/**
 * The depth a shape advanced along the motion of its body is eroded by when it starts against a sub shape, over half its
 * thinnest extent (see Collider::advance)
 * */
def EROSION_RATIO = 0.5f;

/**
 * The radius of the core of a shape advanced along the motion of its body, a sphere about its centre, over half its
 * thinnest extent (see Collider::advance)
 * */
def CORE_RATIO = 0.25f;

/**
 * A shape placed in the world by the transformation of its body
 * @info:
 * =====
 * The transformation may scale the shape: a box is scaled along each of its axes (and sheared under a parent scaled
 * along other axes), a mesh is transformed as it is drawn; a sphere keeps its roundness, scaled by the largest scale of
 * the transformation, and a capsule is scaled along its axis by the scale of Y (its cylinder), in radius by the largest
 * of the scales of X and Z.
 * ====
 * */
pub record Collider {

    // The shape, in the space of its body
    pub let shape: ColliderShape;

    // The transformation of the body, from its space to the world
    pub let transform: mat4;

    // The transformation from the world to the space of the body
    pub let inverse: mat4;

    // The box enclosing the collider in world space
    pub let bounds: Aabb;

    // The plane bounding a half space in the world, the default plane for the other kinds
    pub let plane: Plane;

    // The colliders of the parts of a comparison placed in the world, empty for the other kinds
    pub let parts: [Collider];

    /**
     * @params:
     *    - shape: the shape, in the space of its body
     *    - transform: the transformation of the body, from its space to the world
     * */
    pub self (shape: ColliderShape, transform: mat4)
        with shape = shape
        , transform = transform
        , inverse = transform.inversed()
        , bounds = utils::worldBox(shape, transform)
        , plane = (if shape.kind == ColliderKind::PLANE { utils::planeOf(transform, transform.inversed()) } else { Plane() })
        , parts = utils::partOf(shape, transform)
    {}

    /**
     * @returns: true iif the collider is the surface of a mesh, holding no volume
     * */
    @field
    pub fn isMesh(self)-> bool {
        self.shape.kind == ColliderKind::MESH
    }

    /**
     * @returns: true iif the collider is a half space, holding no box
     */
    @field
    pub fn isPlane(self)-> bool {
        self.shape.kind == ColliderKind::PLANE
    }

    /**
     * @returns: true iif the coliider is made of the colliders of its parts
     */
    @field
    pub fn isCompound(self)-> bool {
        self.shape.kind == ColliderKind::COMPOUND
    }

    /**
     * @returns: the collider as a convex shape of the world, a point for a mesh
     * */
    pub fn convex(self)-> Convex {
        utils::convexOf(self.shape, self.transform)
    }

    /**
     * @returns: the triangles of a mesh whose boxes overlap a box of the world, in world space; none for another kind
     * */
    pub yield trianglesIn(self, box: Aabb)-> Convex {
        if let Ok(hierarchy) = self.shape.hierarchy {
            if let Ok(triangles) = self.shape.triangles {
                for i in hierarchy.overlapping(box.transformed(self.inverse)) {
                    let t = triangles.getTriangle(i);
                    yield Convex::triangle(utils::pointTo(self.transform, t.a), utils::pointTo(self.transform, t.b),
                                           utils::pointTo(self.transform, t.c));
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          QUERIES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @info: a ray starting inside a box, a sphere or a capsule hits it at its
     * origin; a mesh is hit by either face of its triangles
     *
     * @returns: the point where a ray hits the collider first, none when it misses it or stops before it
     * */
    pub fn raycast(self, ray: Ray)-> (SurfaceHit)? {
        if self.isCompound {
            return self.raycastCompound(ray);
        }

        match self.shape.kind {
            ColliderKind::MESH => { return utils::rayMesh(ray, self.shape, self.transform, self.inverse); }
            ColliderKind::BOX => { return utils::rayBox(ray, self.shape.size / 2.0f, self.inverse); }
            ColliderKind::PLANE => { return utils::rayPlane(ray, self.plane); }
            ColliderKind::HULL => {
                if let Ok(h) = self.shape.convexHull {
                    return utils::rayHull(ray, h, self.inverse);
                }
                return none;
            }
            ColliderKind::CYLINDER => {
                let r = self.shape.radius;
                let h = self.shape.height / 2.0f;
                let toUnit = math::utils::scaling(makeVec3(1.0f / r, 1.0f / h, 1.0f / r)) * self.inverse;
                return utils::rayUnitCylinder(ray, toUnit);
            }
            _ => {}
        }

        let convex = self.convex();
        if convex.kind == ConvexKind::POINT {
            return utils::raySphere(ray, convex.a, convex.margin);
        }

        utils::rayCapsule(ray, convex.a, convex.b, convex.margin)
    }

    /**
     * @returns: true iif a convex shape of the world shares a point with the collider, crossing a triangle of a mesh
     * */
    pub fn overlaps(self, other: Convex)-> bool {
        if self.isCompound {
            let box = other.bounds;
            for p in self.parts if p.bounds.overlaps(box) {
                if p.overlaps(other) {
                    return true;
                }
            }

            return false;
        }

        if self.isPlane {
            return utils::heightOver(self.plane, other) <= 0.0f;
        }

        if !self.isMesh {
            return gjk::separation(self.convex(), other).overlapping;
        }

        for t in self.trianglesIn(other.bounds) {
            if gjk::separation(other, t).overlapping { return true; }
        }

        false
    }

    /**
     * @returns: true iif two colliders share a point, two meshes never touching
     * */
    pub fn touches(self, other: Collider)-> bool {
        if self.isCompound {
            for p in self.parts if other.isPlane || p.bounds.overlaps(other.bounds) {
                if p.touches(other) {
                    return true;
                }
            }

            return false;
        }

        if self.isPlane {
            if other.isPlane || other.isMesh { return false; }
            return self.overlaps(other.convex());
        }

        if other.isPlane {
            return other.touches(self);
        }

        if self.isMesh {
            if other.isMesh { return false; }
            return self.overlaps(other.convex());
        }

        other.overlaps(self.convex())
    }

    /**
     * @params:
     *    - moving: the shape moved, in world space
     *    - direction: the unit direction it moves along
     *    - length: the distance it travels at most
     * @returns: the point where a moving convex shape hits the collider first (see gjk::sweep), none when it never does
     * */
    pub fn sweep(self, moving: Convex, direction: vec3, length: f32)-> (SurfaceHit)? {
        if self.isCompound {
            return self.sweepCompound(moving, direction, length);
        }

        if self.isPlane {
            return utils::sweepPlane(moving, direction, length, self.plane);
        }

        if !self.isMesh {
            return gjk::sweep(moving, direction, length, self.convex());
        }

        let swept = moving.bounds.merged(moving.translated(direction * length).bounds);
        let mut best: (SurfaceHit)? = none;
        for t in self.trianglesIn(swept) {
            if let Ok(hit) = gjk::sweep(moving, direction, length, t) {
                let closer = if let Ok(b) = best { hit.distance < b.distance } else { true };
                if closer { best = hit?; }
            }
        }

        best
    }


    /**
     * Advance a convex shape along the motion of its body over a step until it comes within a distance of the collider
     * (see gjk::advance), the collider still: a compound by its parts, a mesh by its triangles near the motion
     * @params:
     *    - moving: the shape moved, in world space where it starts
     *    - motion: the motion of its body over the step
     *    - stop: the distance it stops at from the collider
     * @returns: the earliest fraction of the step at which the shape comes within the stop distance of a sub shape of the
     * collider, above 0; none when it never does
     * @info:
     * =====
     * A sub shape the shape starts within the stop distance of is left to the contacts, the shape being already against
     * it: the shape eroded by half its half thickness (EROSION_RATIO) is advanced against it instead, stopping within
     * half that depth at most, so that it sinks into it by a part of its thickness and no more; then, when the shape is
     * sunk that deep, its core, a sphere about its centre a quarter of its half thickness across (CORE_RATIO), so that it
     * never passes through (after Box2D v3).
     *
     * A triangle of a mesh whose plane the shape starts within the stop distance of, but apart from the triangle, is
     * left out: the shape slides in its plane onto it from a neighbour, and would only meet an inner edge of the mesh.
     * ====
     * */
    pub fn advance(self, moving: Convex, motion: StepMotion, stop: f32)-> (f32)? {
        let half = moving.halfThickness;
        let core = Convex::sphere(moving.centre, CORE_RATIO * half);
        let nested = copy [(moving, stop),
                           (moving.eroded(EROSION_RATIO * half), comparison::min(stop, EROSION_RATIO * half / 2.0f)),
                           (core, comparison::min(stop, CORE_RATIO * half / 2.0f))];
        if self.isPlane {
            return utils::advanceOntoPlane(nested, motion, self.plane);
        }

        if !self.isCompound && !self.isMesh {
            return utils::advanceOnto(nested, motion, self.convex());
        }

        let swept = motion.bounds(moving.reachFrom(motion.pivot) + moving.margin);
        let mut best: (f32)? = none;
        if self.isCompound {
            for p in self.parts if p.bounds.overlaps(swept) {
                best = earliest(best, p.advance(moving, motion, stop));
            }

            return best;
        }

        for t in self.trianglesIn(swept) if !utils::slidesOnto(moving, t, stop) {
            best = earliest(best, utils::advanceOnto(nested, motion, t));
        }

        best
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn raycastCompound(self, ray: Ray)-> (SurfaceHit)? {
        let mut best: (SurfaceHit)? = none;
        for p in self.parts if p.bounds.intersect(ray).hasValue {
            if let Ok(hit) = p.raycast(ray) {
                let closer = if let Ok(b) = best {
                    hit.distance < b.distance
                } else {
                    true
                };

                if closer {
                    best = hit?;
                }
            }
        }

        best
    }

    fn sweepCompound(self, moving: Convex, direction: vec3, length: f32)-> (SurfaceHit)? {
        let swept = moving.bounds.merged(moving.translated(direction * length).bounds);
        let mut best: (SurfaceHit)? = none;
        for p in self.parts if p.bounds.overlaps(swept) {
            if let Ok(hit) = p.sweep(moving, direction, length) {
                let closer = if let Ok(b) = best {
                    hit.distance < b.distance
                } else {
                    true
                };

                if closer {
                    best = hit?;
                }
            }
        }

        best
    }
}
