in utils;

use balder::scene::node::node3D::volume_shape;

/**
 * @returns: the kind of collider of the kind of a volume
 * */
pub fn kindOf(kind: VolumeKind)-> ColliderKind {
    match kind {
        VolumeKind::SPHERE  => { ColliderKind::SPHERE }
        VolumeKind::CAPSULE => { ColliderKind::CAPSULE }
        _                   => { ColliderKind::BOX }
    }
}
