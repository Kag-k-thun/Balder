in convex_hull;

mod ::utils;

use balder::core::error;
use balder::math::{bounds, inertia, matrix, vector};

/**
 * The smallest convex shape holding points: its vertices, the triangles of its
 * surface, its volume, the centre of its volume and its inertia
 *
 * @info: built once, at load, then shared by every collider of its shape; the
 * points inside the hull are dropped
 *
 * */
@final
pub class ConvexHull {

    // The vertices of the hull, in the space of its body
    let mut _vertices: [vec3] = [];

    // The triangles of its surface
    let mut _faces: [HullFace] = [];

    // The box enclosing the vertices
    let mut _bounds: Aabb = Aabb();

    // The volume of the hull
    let mut _volume: f32 = 0.0f;

    // The center of the volume, in the space of the body
    let mut _centroid: vec3 = vec3();

    // The inertia tensor of the hull at a density of 1, about its centroid, along the axes of its body
    let mut _unitInertia: mat3 = diagonalTensor(vec3());



    /**
     * The hull of points
     * @params:
     *    - points: the points, in the space of the body, four at least spanning a volume
     * @throws: BalderError when the points span no volume (fewer than four, or all on a line or a plane)
     * */
    pub self (points: [vec3])
        throws BalderError
    {
        let (vertices, faces) = utils::surfaceOf(points);
        self:.setSurface(vertices, faces);
    }

    /**
     * The hull of a surface already built, convex and closed
     */
    self fromSurface(vertices: [vec3], faces: [HullFace]) {
        self:.setSurface(vertices, faces);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the vertices of the hull, in the space of its body
     *
     * */
    @field
    pub fn vertices(self)-> [vec3] {
        self._vertices
    }

    /**
     * @returns: the traingles of the surface of the hull
     *
     * */
    @field
    pub fn faces(self)-> [HullFace] {
        self._faces
    }

    /**
     * @returns: the box enclosing the hull, in the space of its body
     * */
    @field
    pub fn bounds(self)-> Aabb {
        self._bounds
    }

    /**
     * @returns: the volume of the hull
     * */
    @field
    pub fn volume(self)-> f32 {
        self._volume
    }

    /**
     * @returns: the center of the volume of the hull, in the space of its body
     *
     * */
    @field
    pub fn centroid(self)-> vec3 {
        self._centroid
    }

    /**
     * @returns: the inertia tensor of the hull at a density of 1, about its
     * centroid; times the mass over the volume for a hull of a mass
     *
     * */
    @field
    pub fn unitInertia(self)-> mat3 {
        self._unitInertia
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    fn setSurface(mut self, vertices: [vec3], faces: [HullFace]) {
        self._vertices = vertices;
        self._faces = faces;
        for v in vertices {
            self._bounds = self._bounds.merged(Aabb(v, v));
        }

        let (volume, centroid, tensor) = utils::massOf(vertices, faces);
        self._volume = volume;
        self._centroid = centroid;
        self._unitInertia = tensor;
    }
}
