in convex_decomposition;

mod ::decomposer;
mod ::utils;

use balder::core::error;
use balder::math::bounds;
use balder::scene::asset::mesh_asset;
use balder::utils::path;

use std::{checksum, fs};

/**
 * The approximate convex decomposition of a concave model: convex hulls whose compound is the shape of a dynamic body,
 * a triangle mesh being static only
 *
 * @info: slow by nature (see Decomposer), the decomposition runs offline, by the export of a game or the decompose
 * tool (see ofModel), and is saved in a file next to the model (see fileOf), which the game reads instead of
 * decomposing the model at load (see MeshAsset.decomposition)
 *
 * @example:
 * ```
 * let model = "res:/models/mug.glb";
 * if !ConvexDecomposition::isUpToDate(model) {
 *     ConvexDecomposition::ofModel(model, settings-> DecompositionSettings(maxHulls-> 8u32))
 *         .save(ConvexDecomposition::fileOf(model));
 * }
 * ```
 * */
@final
pub class ConvexDecomposition {

    // The hulls, in the space of the model
    let _hulls: [&ConvexHull];

    // The settings the model was decomposed with
    let _settings: DecompositionSettings;

    // The checksum of the file of the model the hulls were made from (see checksumOf), 0 when unknown
    let _source: u32;

    /**
     * The decomposition of the triangles of a model
     * @params:
     *    - triangles: the triangles of the surface of the model, in the space of the model
     *    - settings: how the model is split
     *    - source: the checksum of the file of the model (see checksumOf), 0 when unknown
     * @throws: BalderError when the triangles span no volume
     * */
    pub self (triangles: [Triangle], settings: DecompositionSettings = DecompositionSettings(), source: u32 = 0u32)
        with _hulls = (copy decomposer::Decomposer(triangles, settings)):.hulls()
        , _settings = settings
        , _source = source
        throws BalderError
    {}

    /**
     * The decomposition saved in a file
     * @params:
     *    - path: the project path of the file (see fileOf)
     * @throws: BalderError when the file cannot be read, or is not a decomposition
     * */
    pub self fromFile(path: [c8])
        with self(utils::read(path))
        throws BalderError
    {}

    /**
     * The decomposition read from a file: its hulls, its settings and the checksum of its model
     * */
    self (read: ([&ConvexHull], DecompositionSettings, u32))
        with _hulls = read._0
        , _settings = read._1
        , _source = read._2
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the hulls, in the space of the model
     * */
    @field
    pub fn hulls(self)-> [&ConvexHull] {
        self._hulls
    }

    /**
     * @returns: the settings the model was decomposed with
     * */
    @field
    pub fn settings(self)-> DecompositionSettings {
        self._settings
    }

    /**
     * @returns: the checksum of the file of the model the hulls were made from (see checksumOf), 0 when unknown
     * */
    @field
    pub fn source(self)-> u32 {
        self._source
    }

    /**
     * @returns: the number of vertices of the hulls
     * */
    @field
    pub fn vertexCount(self)-> usize {
        let mut count = 0us;
        for h in self._hulls {
            count += h.vertices.len;
        }

        count
    }

    /**
     * @returns: the compound of the hulls, the shape of a body in the space of the model
     * */
    pub fn shape(self)-> ColliderShape {
        let parts = copy [CompoundPart(shape-> ColliderShape::hull(h)) for h in self._hulls];
        {
            ColliderShape::compound(copy CompoundShape(parts))
        } catch {
            _ => panic;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SAVING          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Write the decomposition in a file, its settings, the checksum of its model and the vertices of its hulls
     * @params:
     *    - path: the project path of the file (see fileOf)
     * @throws: BalderError when the file cannot be written
     * */
    pub fn save(self, path: [c8])
        throws BalderError
    {
        let text = utils::textOf(self._hulls, self._settings, self._source);
        {
            writeFile(projectPath(path), text);
        } catch {
            err => {
                throw copy BalderError(f"Failed to write the hulls of ${path}: ${err}");
            }
        }
    }

}

/**
 * The files of the decompositions
 * */
pub mod ConvexDecomposition {

    /**
     * The extension of the file of a decomposition
     * */
    pub def EXTENSION = ".hulls";

    /**
     * @returns: the project path of the file holding the decomposition of a model, next to the model file, its
     * extension replaced (res:/models/mug/mug.glb gives res:/models/mug/mug.hulls)
     * */
    pub fn fileOf(model: [c8])-> [c8] {
        let mut slash = 0us;
        for i, c in model if c == '/' { slash = i + 1us; }

        let mut dot = model.len;
        for i in slash .. model.len if model[i] == '.' { dot = i; }

        model[0us .. dot] ~ EXTENSION
    }

    /**
     * @returns: the decomposition of a model file, read again from its file (never the mesh of the cache, which may
     * have released its vertices), the checksum of the file kept as its source
     * @params:
     *    - model: the project path of the model file
     *    - settings: how the model is split
     * @throws: BalderError when the model cannot be read, or its triangles span no volume
     * */
    pub fn ofModel(model: [c8], settings: DecompositionSettings = DecompositionSettings())-> &ConvexDecomposition
        throws BalderError
    {
        let mesh = MeshAsset::read(model, lods-> false);
        copy ConvexDecomposition(mesh.triangles(), settings-> settings, source-> checksumOf(model))
    }

    /**
     * @returns: true iif the decomposition saved next to a model (see fileOf) was made from its file as it is, its
     * checksum matching; false when there is none, it cannot be read, or its source is unknown
     * @params:
     *    - model: the project path of the model file
     * */
    pub fn isUpToDate(model: [c8])-> bool {
        {
            let decomposition = copy ConvexDecomposition::fromFile(fileOf(model));
            decomposition.source != 0u32 && decomposition.source == checksumOf(model)
        } catch {
            _ => { false }
        }
    }

    /**
     * @returns: the checksum (CRC-32) of the file of a model, telling whether a decomposition was made from it
     * @throws: BalderError when the file cannot be read
     * */
    pub fn checksumOf(model: [c8])-> u32
        throws BalderError
    {
        {
            crc32(readFile(projectPath(model)))
        } catch {
            err => {
                throw copy BalderError(f"Failed to read the model ${model}: ${err}");
            }
        }
    }
}
