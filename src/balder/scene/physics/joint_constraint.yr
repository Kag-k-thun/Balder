in joint_constraint;

use balder::math::{quaternion, vector};

/**
 * A joint as the solver pushes on it during a step: its two bodies, its arms and its frames in the world at the start
 * of the step, and the impulses it gathers, written back to the joint once the step is solved
 *
 * @info: the sub steps turn the arms and the frames with the bodies (see SolverBody::deltaRotation), the joint being
 * prepared once a step like the contacts (Box2D v3)
 *
 * */
@data
pub record JointConstraint {

    // The index of the joint in the world, its impulses written back there
    let mut joint: u32 = 0u32;

    // The index of the first body in the solver bodies of the island
    let mut a: usize = 0us;

    // The index of the second body
    let mut b: usize = 0us;

    // How the joint holds its bodies
    let mut settings: JointSettings = JointSettings();

    // The arm from the centre of the mass of the first body to its anchor, in the world at the start of the step
    let mut armA: vec3 = vec3();

    // The arm from the centre of the mass of the second body to its anchor
    let mut armB: vec3 = vec3();

    // The rotation of the frame of the joint on the first body in the world at the start of the step
    let mut basisA: Quaternion = Quaternion();

    // The rotation of the frame on the second body
    let mut basisB: Quaternion = Quaternion();

    // The centre of the mass of the second body less that of the first, at the start of the step
    let mut deltaCentre: vec3 = vec3();

    // The impulses gathered, as the joint keeps them (see Joint)
    let mut linearImpulse: vec3 = vec3();
    let mut angularImpulse: vec3 = vec3();
    let mut motorImpulse: f32 = 0.0f;
    let mut lowerImpulse: f32 = 0.0f;
    let mut upperImpulse: f32 = 0.0f;
}
