in contact_manifold;

use balder::math::vector;

use std::algorithm::comparison;

/**
 * The distance under which a point of a step is the point of the step before,
 * on both shapes, in their spaces
 *
 * */
def PERSIST_DISTANCE = 0.02f;

/**
 * The cosine of the angle the normal may turn by between two steps, the
 * friction of the points carried
 *
 * */
def FRICTION_KEPT = 0.99f;

/**
 * The points where two convex shapes touch, four at most, sharing a normal
 *
 * */
pub record ContactManifold {

    // The sub shapes the manifold is between: (part of the first << 32) | part
    // or triangle of the second, 0 for two convex bodies
    pub let mut key: u64 = 0u64;

    // The unit normal, from the first shape to the second
    pub let mut normal: vec3 = vec3();

    // The points, four at most
    pub let mut points: [ContactPoint] = [];

    pub self () {}

    pub self (key: u64, normal: vec3, points: [ContactPoint])
        with key = key
        , normal = normal
        , points = points
    {}

    /**
     * @returns: true iif a point of the manifold is not speculative, the shapes sharing a point
     * */
    @field
    pub fn touching(self)-> bool {
        for p in self.points if p.depth >= 0.0f { return true; }
        false
    }

    /**
     * @returns: the manifold, its points given the impulses of the points of
     * the step before they are found again in: the point of the same feature,
     * or the closest within PERSIST_DISTANCE on both shapes; the friction
     * carried only while the normal turns little
     *
     * */
    pub fn persisted(self, previous: ContactManifold)-> ContactManifold {
        let keepFriction = self.normal.dot(previous.normal) >= FRICTION_KEPT;
        let dmut points = copy self.points;
        for i in 0us .. points.len {
            let p = points[i];
            let mut best: (ContactPoint)? = none;
            let mut closest = PERSIST_DISTANCE;
            for old in previous.points {
                if p.feature != contact_point::NO_FEATURE && old.feature == p.feature {
                    best = old?;
                    break;
                }

                let d = comparison::max((old.localA - p.localA).length(), (old.localB - p.localB).length());
                if d < closest {
                    closest = d;
                    best = old?;
                }
            }

            if let Ok(old) = best {
                points[i].normalImpulse = old.normalImpulse;
                if keepFriction {
                    points[i].frictionImpulse = old.frictionImpulse;
                }
            }
        }

        ContactManifold(self.key, self.normal, points)
    }
}
