in solver_body;

use balder::math::{inertia, matrix, quaternion, vector};

/**
 * A body as the solver pushes and moves it during a step: its velocities, the centre of its mass, the inverse of its
 * mass and of its inertia, what accelerates and slows it, and how far it moved and turned since the start of the step
 *
 * @info: the bodies of an island are copied into a dense array the sub steps read and write, never reaching the world;
 * a static or a kinematic body has no inverse mass nor inverse inertia, nothing pushing nor moving it
 *
 * */
@data
pub record SolverBody {

    // The handle of the body in the world
    let mut handle: u32 = 0u32;

    // The velocity of the centre of the mass, in metres a second
    let mut linearVelocity: vec3 = vec3();

    // The angular velocity in the world, in radians a second about its direction
    let mut angularVelocity: vec3 = vec3();

    // The centre of the mass in the world, at the start of the step
    let mut centre: vec3 = vec3();

    // The inverse of the mass, 0 for a body nothing pushes
    let mut inverseMass: f32 = 0.0f;

    // The inverse of the inertia tensor about the centre of the mass, in the world
    let mut inverseInertia: mat3 = diagonalTensor(vec3());

    // The acceleration of gravity and of the forces on the body, in metres a second squared
    let mut linearAcceleration: vec3 = vec3();

    // The angular acceleration of the torques on the body, in radians a second squared
    let mut angularAcceleration: vec3 = vec3();

    // The parts of its linear and its angular speeds the body loses each second
    let mut linearDamping: f32 = 0.0f;
    let mut angularDamping: f32 = 0.0f;

    // How far the centre of the mass moved since the start of the step
    let mut deltaPosition: vec3 = vec3();

    // How far the body turned since the start of the step
    let mut deltaRotation: Quaternion = Quaternion();
}
