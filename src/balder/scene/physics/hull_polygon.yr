in hull_polygon;

use balder::math::vector;

/**
 * A flat face of a convex hull, its triangles of one plane merged, its corners
 * counterclockwise seen from outside
 *
 * */
@data
pub record HullPolygon {

    // The indices of the corners in the vertices of the hull, in their order around the face
    let mut corners: [u32] = [];

    // The unit normal of the face, pointing out of the hull
    let mut normal: vec3 = vec3();
}
