in pair_cache;

/**
 * The pairs of bodies the broadphase keeps, in a dense array the narrowphase
 * and the solver run over, found by their key
 *
 * @info: a pair is known by the key of its two handles (see
 * world::utils::pairKey), the same while it stays in the cache; its slot may
 * change as other pairs are removed, the last pair moved into the slot of the
 * one removed
 *
 * */
@final
pub class PairCache {

    // The pairs, in no particular order
    let dmut _pairs: [BroadPair] = [];

    // The slot of each pair, by its key
    let dmut _slots: [u64 => usize] = copy [];

    pub self() {}

    /**
     * @returns: the number of pairs
     */
    @field
    pub fn len(self)-> usize {
        self._pairs.len
    }

    /**
     * @returns: the pairs, in no particular order
     * */
    @field
    pub fn pairs(self)-> [BroadPair] {
        self._pairs
    }

    /**
     * @returns: true iff the cache holds the pair of a key
     * */
    pub fn contains(self, key: u64)-> bool {
        key in self._slots
    }

    /**
     * @returns: the pair in a slot
     */
    pub fn get(self, slot: usize)-> BroadPair {
        self._pairs[slot]
    }

    /**
     * Replace the pair in a slot, the narrowphase writing what it found
     */
    pub fn set(mut self, slot: usize, pair: BroadPair) {
        self._pairs[slot] = pair;
    }

    /**
     * Add the pair of two bodies
     * @returns: true iff it was not in the cache
     * */
    pub fn add(mut self, a: u32, b: u32)-> bool {
        let key = pairKey(a, b);
        if key in self._slots { return false; }

        self._slots[key] = self._pairs.len;
        self._pairs = self._pairs ~ copy [BroadPair(a-> firstOf(key),
                                                    b-> secondOf(key))];

        true
    }

    /**
     * Remove the pair of a key, the last pair moved into its slot
     *
     * @returns: the pair removed, none when the cache did not hold it
     *
     * */
    pub fn remove(mut self, key: u64)-> (BroadPair)? {
        if let Ok(slot) = self._slots[key] {
            let removed = self._pairs[slot];
            let last = self._pairs.len - 1;
            if slot != last {
                self._pairs[slot] = self._pairs[last];
                self._slots[pairKey(self._pairs[slot].a, self._pairs[slot].b)] = slot;
            }

            self._pairs = alias self._pairs[0 .. last];
            self._slots:.remove(key);
            return removed?;
        }

        none
    }
}
