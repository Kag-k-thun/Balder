in compound_part;

use balder::math::rigid_transform;


/**
 * A convex part of a compound shape, placed in the space of the compound
 *
 * */
@data
pub record CompoundPart {

    // The shape of the part, centred on its own origin
    let mut shape: ColliderShape = ColliderShape();

    // The placement of the part in the space of the compound
    let mut place: RigidTransform = RigidTransform();
}
