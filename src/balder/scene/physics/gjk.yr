in gjk;

use balder::math::vector;

use std::math;
use std::algorithm::comparison;

/**
 * The number of points the search of the closest points adds to its simplex at most
 * */
def MAX_ITERATIONS = 32us;

/**
 * The number of advances of a shape cast at most, a shape grazing another one advancing by smaller and smaller steps
 * */
def MAX_CAST_STEPS = 32us;

/**
 * The number of advances of a shape along the motion of its body at most (see advance), each one a search of the
 * closest points then of a root of the separation along their axis
 * */
def MAX_ADVANCES = 20us;

/**
 * The number of deepest points along an axis whose separation is followed back to its root at most, each one deeper
 * than the one before at that root (see impactAlong)
 * */
def MAX_PUSHES = 8us;

/**
 * The number of parts of the rest of a step whose ends the separation along an axis is looked at at most, a shape
 * turning by less between them than lets one of its points come closer between the two than at either (see impactAlong)
 * */
def MAX_TURN_PARTS = 64u32;

/**
 * The number of bisections and secants of the search of a root of the separation along an axis at most (see rootOf)
 * */
def MAX_ROOT_STEPS = 50us;

/**
 * The distance a shape advanced along the motion of its body aims at from what it hits, over the distance it stops at,
 * and how far from it the separation may stop, so that it stops between half that distance and that distance (see
 * advance)
 * */
def IMPACT_AIM = 0.75f;
def IMPACT_TOLERANCE = 0.25f;

/**
 * The progress toward the origin, relative to its squared distance, under which the search of the closest points stops
 * */
def RELATIVE_PROGRESS = 1.0e-5f;

/**
 * The squared distance under which two cores touch
 * */
def TOUCHING = 1.0e-10f;

/**
 * The squared sine of an angle under which a triangle or a tetrahedron of the simplex is flat
 * */
def FLAT = 1.0e-12f;

/**
 * The distance under which a shape cast stops, touching what it hits
 * */
def CAST_TOLERANCE = 1.0e-4f;

/**
 * The number of points the expansion of the polytope adds at most
 * */
def MAX_EXPANSION = 64us;

/**
 * The progress of the support along the closest face, relative to its distance, under which the expansion stops
 * */
def EXPANSION_TOLERANCE = 1.0e-4f;

/**
 * A point of the Minkowski difference of two cores, and the points of the cores giving it
 * */
@data
record Vertex {

    // The point of the difference, a - b
    pub let mut w: vec3 = vec3();

    // The point of the first core
    pub let mut a: vec3 = vec3();

    // The point of the second core
    pub let mut b: vec3 = vec3();

}

/**
 * A simplex of the Minkowski difference of two cores, one to four vertices held in place, and the point of it closest to
 * the origin as weights of its vertices, so that the search of the closest points allocates nothing
 * */
@data
record Simplex {

    // The vertices, the first count of them
    pub let dmut vertices: [Vertex ; 4] = [Vertex() ; 4];

    // The weights of the vertices, summing to 1
    pub let dmut weights: [f32 ; 4] = [0.0f ; 4];

    // The number of vertices
    pub let mut count: usize = 0us;

    // True when the simplex, a tetrahedron, holds the origin
    pub let mut inside: bool = false;

}

/**
 * The closest points of two cores, their margins left out, and the simplex the
 * search ended on
 *
 * */
@data
record CoreSearch {

    // True when the cores share a point, the simplex then holding the origin or touching it
    let mut overlapping: bool = false;

    // The distance between the cores, their closest points and the unit direction from the first to the second
    let mut distance: f32 = 0.0f;
    let mut pointA: vec3 = vec3();
    let mut pointB: vec3 = vec3();
    let mut normal: vec3 = vec3();

    // The last simplex
    let mut simplex: Simplex = Simplex();
}


/**
 * What the search of the fraction at which a shape moving along the motion of its body comes to a distance of a still
 * one along an axis found (see impactAlong)
 * */
enum Impact : u32
| SEPARATED = 0u32 // farther than the distance along the axis until the end of the step
| REACHED   = 1u32 // at the distance along the axis at a later fraction, the closest points to search again there
| HIT       = 2u32; // within the distance from the fraction it started at, or out of deepest points

/**
 * A triangle of the polytope of the expansion, its corners in the vertices,
 * counterclockwise from outside
 *
 * */
@data
record PolytopeFace {
    let mut i: u32 = 0u32;
    let mut j: u32 = 0u32;
    let mut k: u32 = 0u32;
    let mut normal: vec3 = vec3();
    let mut distance: f32 = 0.0f;
}


/**
 * @params:
 *    - start: the direction the first vertex of the search is the farthest along, in the difference of the cores: from
 *    the centre of the second toward the first, or the normal found last to start from its closest vertex
 * */
fn closestCores(a: Convex, b: Convex, start: vec3)-> CoreSearch {
    let mut first = start;
    if first.dot(first) <= TOUCHING { first = makeVec3(1.0f, 0.0f, 0.0f); }

    let mut simplex = single(vertexAlong(a, b, first));
    let mut closest = simplex.vertices[0].w;
    for _ in 0us .. MAX_ITERATIONS {
        let squared = closest.dot(closest);
        if squared <= TOUCHING {
            return CoreSearch(overlapping-> true, simplex-> simplex);
        }

        let next = vertexAlong(a, b, -closest);
        if squared - closest.dot(next.w) <= RELATIVE_PROGRESS * squared {
            break;
        }

        let dmut candidate = simplex;
        candidate.vertices[candidate.count] = next;
        candidate.count += 1us;

        let reduced = closestToOrigin(candidate);
        if reduced.inside {
            return CoreSearch(overlapping-> true, simplex-> candidate);
        }

        let point = pointOf(reduced);
        if point.dot(point) >= squared {
            break;
        }

        simplex = reduced;
        closest = point;
    }

    let mut onA = vec3();
    let mut onB = vec3();
    for i in 0us .. simplex.count {
        onA = onA + simplex.vertices[i].a * simplex.weights[i];
        onB = onB + simplex.vertices[i].b * simplex.weights[i];
    }

    // the search may run out of iterations on a simplex touching the origin, no direction joining the cores
    if closest.dot(closest) <= TOUCHING {
        return CoreSearch(overlapping-> true, simplex-> simplex);
    }

    let distance = closest.length();
    CoreSearch(distance-> distance,
               pointA-> onA,
               pointB-> onB,
               normal-> (onB - onA) / distance,
               simplex-> simplex)
}

/**
 * Find the points of two convex shapes closest to each other, by the search of
 * Gilbert, Johnson and Keerthi: the point of their Minkowski difference closest
 * to the origin is approached by simplices of the difference, each one
 * replacing the farthest vertex by the point of the difference the farthest
 * toward the origin
 *
 * @info: the search runs on the cores of the shapes, their margins being taken
 * off the distance found, so a sphere or a capsule is exact
 *
 * @returns: the separation of the shapes, overlapping when their cores are
 * closer than their margins
 *
 * */
pub fn separation(a: Convex, b: Convex)-> Separation {
    let s = closestCores(a, b, a.centre - b.centre);
    let margins = a.margin + b.margin;
    if s.overlapping || s.distance <= margins {
        return Separation(overlapping-> true);
    }

    Separation(distance-> s.distance - margins,
               pointA-> s.pointA + s.normal * a.margin,
               pointB-> s.pointB - s.normal * b.margin,
               normal-> s.normal)
}

/**
 * Move a convex shape along a direction until it touches another one, by conservative advancement: the distance between
 * two convex shapes, one moving in a straight line, is a convex function of the distance travelled, so the shape can
 * advance by the distance between them divided by the speed at which they get closer without passing through; each
 * advance stops half of CAST_TOLERANCE short, so that a face met flat is not reached exactly, the shapes touching there
 * without telling where
 * @params:
 *    - moving: the shape moved
 *    - direction: the unit direction it moves along
 *    - length: the distance it travels at most
 *    - target: the shape it may hit
 * @returns: the hit, the moving shape stopping within CAST_TOLERANCE of the target; at a distance 0 when it starts
 * touching it; none when it never touches it, gets away from it, or travels its length first
 * */
pub fn sweep(moving: Convex, direction: vec3, length: f32, target: Convex)-> (SurfaceHit)? {
    let mut travelled = 0.0f;
    let mut last: (Separation)? = none;
    for _ in 0us .. MAX_CAST_STEPS {
        let s = separation(moving.translated(direction * travelled), target);
        if s.overlapping {
            // reached by the rounding errors only, the previous separation telling where the shapes meet
            if let Ok(previous) = last {
                return SurfaceHit(distance-> travelled, point-> previous.pointB, normal-> -previous.normal)?;
            }

            return SurfaceHit(distance-> travelled, point-> moving.centre, normal-> -direction)?;
        }

        if s.distance <= CAST_TOLERANCE {
            return SurfaceHit(distance-> travelled, point-> s.pointB, normal-> -s.normal)?;
        }

        let closing = direction.dot(s.normal);
        if closing <= 1.0e-6f { return none; }

        travelled += (s.distance - CAST_TOLERANCE / 2.0f) / closing;
        if travelled > length { return none; }
        last = s?;
    }

    none
}

/**
 * Advance a convex shape along the motion of its body over a step, its rotation included, until it comes within a
 * distance of another one, by the time of impact of Catto (Box2D, b2TimeOfImpact): the closest points of the shapes give
 * an axis, along which the shape comes to the distance at a fraction of the step found along its actual motion (see
 * impactAlong); the separation along an axis never exceeds the distance between the shapes, so the shape comes no
 * closer before that fraction; the closest points are searched again there, from the normal found last, until the
 * shapes are within the distance or the shape stays farther along an axis to the end of the step
 * @params:
 *    - moving: the shape moved, where it starts
 *    - motion: the motion of its body over the step
 *    - target: the shape it may hit, still
 *    - stop: the distance it stops at from the target, above 0
 * @returns: the fraction of the step at which the shape comes within the stop distance of the target, more than half
 * of it away; 0 when it starts within it; none when it stays farther over the whole step; the fraction reached when it
 * runs out of advances, before the impact
 * */
pub fn advance(moving: Convex, motion: StepMotion, target: Convex, stop: f32)-> (f32)? {
    let aim = IMPACT_AIM * stop, tolerance = IMPACT_TOLERANCE * stop;
    let margins = moving.margin + target.margin;
    let reach = moving.reachFrom(motion.pivot);
    let mut fraction = 0.0f;
    let mut start = moving.centre - target.centre;
    for _ in 0us .. MAX_ADVANCES {
        let s = closestCores(motion.moved(moving, fraction), target, start);
        if s.overlapping || s.distance - margins <= stop { return fraction?; }

        let offset = s.normal.dot(target.support(-s.normal)) - target.margin;
        let (impact, reached) = impactAlong(moving, motion, reach, s.normal, offset, fraction, aim, tolerance);
        match impact {
            Impact::SEPARATED => { return none; }
            Impact::HIT => { return reached?; }
            _ => { fraction = reached; }
        }

        start = s.normal;
    }

    fraction?
}

/**
 * Advance a convex shape along the motion of its body over a step until it comes within a distance of a still half
 * space, all that lies beyond an offset along an axis (see advance), the separation along the axis being the distance
 * @params:
 *    - axis: the unit axis from the shape toward the half space
 *    - offset: where the half space starts along the axis
 * @returns: the fraction of the step at which the shape comes within the stop distance of the half space, 0 when it
 * starts within it; none when it stays farther over the whole step
 * */
pub fn advanceAlong(moving: Convex, motion: StepMotion, axis: vec3, offset: f32, stop: f32)-> (f32)? {
    let aim = IMPACT_AIM * stop, tolerance = IMPACT_TOLERANCE * stop;
    let reach = moving.reachFrom(motion.pivot);
    let mut fraction = 0.0f;
    for _ in 0us .. MAX_ADVANCES {
        let at = motion.moved(moving, fraction);
        if offset - axis.dot(at.support(axis)) - at.margin <= stop { return fraction?; }

        let (impact, reached) = impactAlong(moving, motion, reach, axis, offset, fraction, aim, tolerance);
        match impact {
            Impact::SEPARATED => { return none; }
            Impact::HIT => { return reached?; }
            _ => { fraction = reached; }
        }
    }

    fraction?
}

/**
 * Find the fraction of a step at which a shape moving along the motion of its body comes to a distance of a still one
 * along a fixed axis, part of the rest of the step after part (see pushedBack): a point turning by an angle about the
 * centre of the mass comes closer along the axis between two fractions than at the closer of them by its reach times
 * the square of the angle over 8 at most, so the parts turn by little enough that no point of the shape comes closer
 * within one than at its ends by more than the tolerance
 * @params:
 *    - moving: the shape moved, where it starts
 *    - motion: the motion of its body over the step
 *    - reach: the distance from the centre of the mass to the farthest point of the core of the shape
 *    - axis: the unit axis from the shape toward the other one
 *    - offset: where the other one starts along the axis, its margin taken off
 *    - from: the fraction the shape starts at, farther than the distance
 *    - aim: the distance
 *    - tolerance: how far from the distance the separation may end
 * @returns: what the search found, and the fraction the shape reached
 * */
fn impactAlong(moving: Convex, motion: StepMotion, reach: f32, axis: vec3, offset: f32, from: f32, aim: f32,
               tolerance: f32)-> (Impact, f32) {
    let turn = motion.angle * (1.0f - from);
    let mut parts = 1u32;
    if reach > 0.0f && turn > 0.0f {
        let most = math::sqrt(8.0f * tolerance / reach);
        parts = cast!u32(comparison::min(math::ceil(turn / most), cast!f32(MAX_TURN_PARTS)));
        parts = comparison::max(parts, 1u32);
    }

    let mut start = from;
    for i in 1u32 .. parts + 1u32 {
        let end = if i == parts { 1.0f } else { from + (1.0f - from) * cast!f32(i) / cast!f32(parts) };
        let (impact, reached) = pushedBack(moving, motion, axis, offset, start, end, aim, tolerance);
        if impact != Impact::SEPARATED { return (impact, reached); }

        start = end;
    }

    (Impact::SEPARATED, 1.0f)
}

/**
 * Find the fraction between two at which a shape moving along the motion of its body comes to a distance of a still one
 * along a fixed axis: the point of the shape the deepest along the axis at the later fraction is followed along the
 * motion back to the fraction its separation reaches the distance (see rootOf), then the point the deepest there, until
 * the deepest one is at the distance (Catto, "Continuous Collision", GDC 2013)
 * @params:
 *    - from, until: the fractions, the shape farther than the distance at the first
 * @returns: what the search found, separated when the shape is still farther at the later fraction, and the fraction
 * the shape reached
 * */
fn pushedBack(moving: Convex, motion: StepMotion, axis: vec3, offset: f32, from: f32, until: f32, aim: f32,
              tolerance: f32)-> (Impact, f32) {
    let mut to = until;
    for _ in 0us .. MAX_PUSHES {
        let deepest = moving.support(motion.rotationAt(to).conjugate() * axis);
        let s2 = separationAlong(moving, motion, axis, offset, deepest, to);
        if s2 > aim + tolerance {
            if to >= until { return (Impact::SEPARATED, to); }
            return (Impact::REACHED, to);
        }

        if s2 > aim - tolerance { return (Impact::REACHED, to); }

        let s1 = separationAlong(moving, motion, axis, offset, deepest, from);
        if s1 <= aim + tolerance { return (Impact::HIT, from); }

        to = rootOf(moving, motion, axis, offset, deepest, (from, s1), (to, s2), aim, tolerance);
    }

    (Impact::HIT, from)
}

/**
 * @returns: the fraction between two others at which the separation of a point of a shape moving along the motion of its
 * body reaches a distance along an axis, within a tolerance, by bisections and secants in turn; the latest fraction
 * found farther when it runs out of steps
 * @params:
 *    - point: the point of the shape, where it starts
 *    - before, after: two fractions and the separation of the point at them, farther and closer than the distance
 * */
fn rootOf(moving: Convex, motion: StepMotion, axis: vec3, offset: f32, point: vec3, before: (f32, f32), after: (f32, f32),
          aim: f32, tolerance: f32)-> f32 {
    let mut t1 = before._0;
    let mut s1 = before._1;
    let mut t2 = after._0;
    let mut s2 = after._1;
    for k in 0us .. MAX_ROOT_STEPS {
        let t = if k % 2us == 1us { t1 + (aim - s1) * (t2 - t1) / (s2 - s1) } else { (t1 + t2) / 2.0f };
        let s = separationAlong(moving, motion, axis, offset, point, t);
        if math::abs(s - aim) < tolerance { return t; }

        if s > aim {
            t1 = t;
            s1 = s;
        } else {
            t2 = t;
            s2 = s;
        }
    }

    t1
}

/**
 * @returns: the separation along an axis between a point of a shape moving along the motion of its body, at a fraction
 * of the step, and an offset along the axis, the margin of the shape taken off
 * @params:
 *    - point: the point, where the shape starts
 * */
fn separationAlong(moving: Convex, motion: StepMotion, axis: vec3, offset: f32, point: vec3, fraction: f32)-> f32 {
    let at = motion.pivot + motion.displacement * fraction + motion.rotationAt(fraction) * (point - motion.pivot);
    offset - axis.dot(at) - moving.margin
}

/**
 * @returns: the vertex of the Minkowski difference of two cores the farthest along a direction
 * */
fn vertexAlong(a: Convex, b: Convex, d: vec3)-> Vertex {
    let onA = a.support(d);
    let onB = b.support(-d);
    Vertex(w-> onA - onB, a-> onA, b-> onB)
}

/**
 * @returns: the point a reduced simplex gives
 * */
fn pointOf(closest: Simplex)-> vec3 {
    let mut point = vec3();
    for i in 0us .. closest.count {
        point = point + closest.vertices[i].w * closest.weights[i];
    }

    point
}

/**
 * @returns: the point of a simplex of one to four vertices closest to the origin
 * */
fn closestToOrigin(simplex: Simplex)-> Simplex {
    let v = simplex.vertices;
    match simplex.count {
        1us => { single(v[0]) }
        2us => { closestOnSegment(v[0], v[1]) }
        3us => { closestOnTriangle(v[0], v[1], v[2]) }
        _ => { closestInTetrahedron(v[0], v[1], v[2], v[3]) }
    }
}

/**
 * @returns: a vertex alone
 * */
fn single(p: Vertex)-> Simplex {
    let dmut s = Simplex(count-> 1us);
    s.vertices[0] = p;
    s.weights[0] = 1.0f;
    s
}

/**
 * @returns: the point of a segment at a fraction from its first vertex to its second
 * */
fn onSegment(p: Vertex, q: Vertex, t: f32)-> Simplex {
    let dmut s = Simplex(count-> 2us);
    s.vertices[0] = p;
    s.vertices[1] = q;
    s.weights[0] = 1.0f - t;
    s.weights[1] = t;
    s
}

/**
 * @returns: the point of a triangle of weights v and w of its second and third vertices
 * */
fn onTriangle(a: Vertex, b: Vertex, c: Vertex, v: f32, w: f32)-> Simplex {
    let dmut s = Simplex(count-> 3us);
    s.vertices[0] = a;
    s.vertices[1] = b;
    s.vertices[2] = c;
    s.weights[0] = 1.0f - v - w;
    s.weights[1] = v;
    s.weights[2] = w;
    s
}

/**
 * @returns: the point of a segment closest to the origin
 * */
fn closestOnSegment(p: Vertex, q: Vertex)-> Simplex {
    let pq = q.w - p.w;
    let squared = pq.dot(pq);
    if squared <= TOUCHING { return single(p); }

    let t = (-p.w).dot(pq) / squared;
    if t <= 0.0f { return single(p); }
    if t >= 1.0f { return single(q); }

    onSegment(p, q, t)
}

/**
 * @info: the regions of Voronoi of the corners, the edges and the face of the triangle (Ericson, Real-Time Collision
 * Detection, 5.1.5), a flat triangle giving the closest point of its edges
 * @returns: the point of a triangle closest to the origin
 * */
fn closestOnTriangle(a: Vertex, b: Vertex, c: Vertex)-> Simplex {
    let ab = b.w - a.w, ac = c.w - a.w;

    let d1 = ab.dot(-a.w), d2 = ac.dot(-a.w);
    if d1 <= 0.0f && d2 <= 0.0f { return single(a); }

    let d3 = ab.dot(-b.w), d4 = ac.dot(-b.w);
    if d3 >= 0.0f && d4 <= d3 { return single(b); }

    let vc = d1 * d4 - d3 * d2;
    if vc <= 0.0f && d1 >= 0.0f && d3 <= 0.0f {
        return onSegment(a, b, d1 / (d1 - d3));
    }

    let d5 = ab.dot(-c.w), d6 = ac.dot(-c.w);
    if d6 >= 0.0f && d5 <= d6 { return single(c); }

    let vb = d5 * d2 - d1 * d6;
    if vb <= 0.0f && d2 >= 0.0f && d6 <= 0.0f {
        return onSegment(a, c, d2 / (d2 - d6));
    }

    let va = d3 * d6 - d5 * d4;
    if va <= 0.0f && (d4 - d3) >= 0.0f && (d5 - d6) >= 0.0f {
        return onSegment(b, c, (d4 - d3) / ((d4 - d3) + (d5 - d6)));
    }

    // va + vb + vc is the squared area of the parallelogram of the edges, nothing for a flat triangle
    let sum = va + vb + vc;
    if sum <= FLAT * ab.dot(ab) * ac.dot(ac) {
        return nearest(nearest(closestOnSegment(a, b), closestOnSegment(a, c)), closestOnSegment(b, c));
    }

    onTriangle(a, b, c, vb / sum, vc / sum)
}

/**
 * @info: the faces of the tetrahedron whose plane separates the origin from the tetrahedron (Ericson, 5.1.6)
 * @returns: the point of a tetrahedron closest to the origin, inside when the origin is in it
 * */
fn closestInTetrahedron(a: Vertex, b: Vertex, c: Vertex, d: Vertex)-> Simplex {
    let mut best = Simplex(inside-> true);
    let mut distance = f32::max;
    closerFace(a, b, c, d, ref best, ref distance);
    closerFace(a, c, d, b, ref best, ref distance);
    closerFace(a, d, b, c, ref best, ref distance);
    closerFace(b, d, c, a, ref best, ref distance);

    best
}

/**
 * Keep the point of a face of a tetrahedron closest to the origin, if the origin is on the other side of the face than
 * the tetrahedron and the point is closer than the best one
 * @params:
 *    - p, q, r: the corners of the face
 *    - opposite: the corner of the tetrahedron off the face
 *    - best: the closest point so far
 *    - distance: the squared distance of the closest point so far
 * */
fn closerFace(p: Vertex, q: Vertex, r: Vertex, opposite: Vertex, ref mut best: Simplex, ref mut distance: f32) {
    let n = (q.w - p.w).cross(r.w - p.w);
    let toOpposite = opposite.w - p.w;
    let sideOrigin = (-p.w).dot(n);
    let sideOpposite = toOpposite.dot(n);

    // a flat tetrahedron has no inside, each of its faces being looked at
    let flat = sideOpposite * sideOpposite <= FLAT * n.dot(n) * toOpposite.dot(toOpposite);
    if !flat && sideOrigin * sideOpposite >= 0.0f { return; }

    let closest = closestOnTriangle(p, q, r);
    let point = pointOf(closest);
    if point.dot(point) < distance {
        distance = point.dot(point);
        best = closest;
    }
}

/**
 * @returns: the closest to the origin of two points of a simplex
 * */
fn nearest(x: Simplex, y: Simplex)-> Simplex {
    let px = pointOf(x), py = pointOf(y);
    if px.dot(px) <= py.dot(py) { x } else { y }
}


/**
 * Find how deep two convex shapes overlap: the closest points of their cores
 * when the cores are apart, the expansion of a polytope of the difference of
 * the cores holding the origin otherwise (van den Bergen)
 *
 * @returns: the depth (margins included), the normal from a to b and the
 * deepest points; none when the shapes do not overlap
 *
 * */
pub fn penetration(a: Convex, b: Convex)-> (Penetration)? {
    let s = closestCores(a, b, a.centre - b.centre);
    let margins = a.margin + b.margin;
    if !s.overlapping {
        if s.distance > margins { return none; }
        return Penetration(depth-> margins - s.distance,
                           normal-> s.normal,
                           pointA-> s.pointA + s.normal * a.margin,
                           pointB-> s.pointB - s.normal * b.margin)?;
    }

    let mut vertices = tetrahedronOf(a, b, verticesOf(s.simplex));
    if vertices.len < 4us {
        return Penetration(depth-> margins,
                           normal-> makeVec3(0.0f, 1.0f, 0.0f),
                           pointA-> a.centre,
                           pointB-> b.centre)?;
    }

    let mut faces = copy [polytopeFace(vertices, 0u32, 1u32, 2u32),
                          polytopeFace(vertices, 0u32, 3u32, 1u32),
                          polytopeFace(vertices, 0u32, 2u32, 3u32),
                          polytopeFace(vertices, 1u32, 3u32, 2u32)];

    let mut closest = faces[0];
    for _ in 0us .. MAX_EXPANSION {
        closest = faces[0];
        for f in faces if f.distance < closest.distance { closest = f; }

        let next = vertexAlong(a, b, closest.normal);
        if next.w.dot(closest.normal) - closest.distance <= EXPANSION_TOLERANCE * comparison::max(closest.distance, 1.0f) {
            break;
        }

        let index = cast!u32(vertices.len);
        vertices = vertices ~ [next];

        let dmut edges: [u64 => bool] = copy [];
        let mut kept: [PolytopeFace] = [];
        for f in faces {
            if f.normal.dot(next.w - vertices[f.i].w) > 0.0f {
                edges[edgeKey(f.i, f.j)] = true;
                edges[edgeKey(f.j, f.k)] = true;
                edges[edgeKey(f.k, f.i)] = true;
            } else {
                kept ~= [f];
            }
        }

        for key, _ in edges if !(edgeKey(endOf(key), startOf(key)) in edges) {
            kept ~= [polytopeFace(vertices, startOf(key), endOf(key), index)];
        }

        faces = kept;
    }

    // every face flat: the difference spans no volume the expansion could measure
    if closest.distance == f32::max {
        return none;
    }

    let (u, v, w) = barycentric(closest.normal * closest.distance,
                                vertices[closest.i].w,
                                vertices[closest.j].w,
                                vertices[closest.k].w);

    let onA = vertices[closest.i].a * u + vertices[closest.j].a * v + vertices[closest.k].a * w;
    let onB = vertices[closest.i].b * u + vertices[closest.j].b * v + vertices[closest.k].b * w;

    let n = closest.normal;
    Penetration(depth-> closest.distance + margins,
                normal-> n,
                pointA-> onA + n * a.margin,
                pointB-> onB - n * b.margin)?
}

/**
 * @returns: the vertices of a simplex, to grow
 * */
fn verticesOf(simplex: Simplex)-> [Vertex] {
    let mut vertices: [Vertex] = [];
    for i in 0us .. simplex.count {
        vertices ~= [simplex.vertices[i]];
    }

    vertices
}

/**
 * @returns: the simplex grown to a tetrahedron by the supports along the axes,
 * then along the normal of a flat triangle; fewer vertices when the difference
 * spans no volume
 *
 * */
fn tetrahedronOf(a: Convex, b: Convex, simplex: [Vertex])-> [Vertex] {
    let mut s = simplex;
    let x = makeVec3(1.0f, 0.0f, 0.0f);
    let y = makeVec3(0.0f, 1.0f, 0.0f);
    let z = makeVec3(0.0f, 0.0f, 1.0f);
    for d in (x, -x, y, -y, z, -z) if s.len < 3us {
        let v = vertexAlong(a, b, d);
        if grows(s, v) {
            s ~= [v];
        }
    }

    if s.len == 3us {
        let n = (s[1].w - s[0].w).cross(s[2].w - s[0].w);
        for d in (n, -n) if s.len < 4us {
            let v = vertexAlong(a, b, d);
            if grows(s, v) {
                s ~= [v];
            }
        }
    }

    s
}

/**
 * @info: the segment and the triangle formed are compared by the squared sine of their angle to FLAT, whatever the size
 * of the shapes
 * @returns: true iif a vertex adds a dimension to a simplex
 * */
fn grows(s: [Vertex], v: Vertex)-> bool {
    if s.len == 0us { return true; }

    let toV = v.w - s[0].w;
    match s.len {
        1us => { toV.dot(toV) > TOUCHING }
        2us => {
            let edge = s[1].w - s[0].w;
            let n = edge.cross(toV);
            n.dot(n) > FLAT * edge.dot(edge) * toV.dot(toV)
        }
        _ => {
            let n = (s[1].w - s[0].w).cross(s[2].w - s[0].w);
            let side = n.dot(toV);
            side * side > FLAT * n.dot(n) * toV.dot(toV)
        }
    }
}

/**
 * @returns: the face of three vertices of the polytope, its normal turned away from the origin
 * */
fn polytopeFace(vertices: [Vertex], i: u32, j: u32, k: u32)-> PolytopeFace {
    let cross = (vertices[j].w - vertices[i].w).cross(vertices[k].w - vertices[i].w);
    if cross.dot(cross) <= 0.0f {
        // a flat face has no normal, nor any distance making it the closest
        return PolytopeFace(i-> i, j-> j, k-> k, normal-> makeVec3(0.0f, 1.0f, 0.0f), distance-> f32::max);
    }

    let n = cross.normalized();
    let d = n.dot(vertices[i].w);
    if d < 0.0f {
        return PolytopeFace(i-> i,
                            j-> k,
                            k-> j,
                            normal-> -n,
                            distance-> -d);
    }

    PolytopeFace(i-> i, j-> j, k-> k, normal-> n, distance-> d)
}

/**
 * @returns: the barycentric weights (u, v, w) of a point in the plane of a triangle, p = a * u + b * v + c * w
 * (Ericson, 3.4); the weights of the centroid when the triangle is flat
 * */
fn barycentric(p: vec3, a: vec3, b: vec3, c: vec3)-> (f32, f32, f32) {
    let v0 = b - a, v1 = c - a, v2 = p - a;
    let d00 = v0.dot(v0), d01 = v0.dot(v1), d11 = v1.dot(v1);
    let d20 = v2.dot(v0), d21 = v2.dot(v1);

    // the squared norm of v0 x v1, compared like the flat triangles of grows
    let denom = d00 * d11 - d01 * d01;
    if denom <= FLAT * d00 * d11 {
        return (1.0f / 3.0f, 1.0f / 3.0f, 1.0f / 3.0f);
    }

    let v = (d11 * d20 - d01 * d21) / denom;
    let w = (d00 * d21 - d01 * d20) / denom;
    (1.0f - v - w, v, w)
}
