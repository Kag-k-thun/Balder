in gjk;

use balder::math::vector;

use std::algorithm::comparison;

/**
 * The number of points the search of the closest points adds to its simplex at most
 * */
def MAX_ITERATIONS = 32us;

/**
 * The number of advances of a shape cast at most, a shape grazing another one advancing by smaller and smaller steps
 * */
def MAX_CAST_STEPS = 32us;

/**
 * The number of advances of a shape along the motion of its body at most (see advance), a shape grazing another one
 * advancing by smaller and smaller steps
 * */
pub def MAX_ADVANCES = 64us;

/**
 * The progress toward the origin, relative to its squared distance, under which the search of the closest points stops
 * */
def RELATIVE_PROGRESS = 1.0e-5f;

/**
 * The squared distance under which two cores touch
 * */
def TOUCHING = 1.0e-10f;

/**
 * The squared sine of an angle under which a triangle or a tetrahedron of the simplex is flat
 * */
def FLAT = 1.0e-12f;

/**
 * The distance under which a shape cast stops, touching what it hits
 * */
def CAST_TOLERANCE = 1.0e-4f;

/**
 * The number of points the expansion of the polytope adds at most
 * */
def MAX_EXPANSION = 64us;

/**
 * The progress of the support along the closest face, relative to its distance, under which the expansion stops
 * */
def EXPANSION_TOLERANCE = 1.0e-4f;

/**
 * A point of the Minkowski difference of two cores, and the points of the cores giving it
 * */
@data
record Vertex {

    // The point of the difference, a - b
    pub let mut w: vec3 = vec3();

    // The point of the first core
    pub let mut a: vec3 = vec3();

    // The point of the second core
    pub let mut b: vec3 = vec3();

}

/**
 * The point of a simplex closest to the origin, as weights of the vertices of the smallest face holding it
 * */
@data
record Closest {

    // The vertices of the face holding the point
    pub let mut vertices: [Vertex] = [];

    // The weights of the vertices, summing to 1
    pub let mut weights: [f32] = [];

    // True when the simplex, a tetrahedron, holds the origin
    pub let mut inside: bool = false;

}

/**
 * The closest points of two cores, their margins left out, and the simplex the
 * search ended on
 *
 * */
@data
record CoreSearch {

    // True when the cores share a point, the simplex then holding the origin or touching it
    let mut overlapping: bool = false;

    // The distance between the cores, their closest points and the unit direction from the first to the second
    let mut distance: f32 = 0.0f;
    let mut pointA: vec3 = vec3();
    let mut pointB: vec3 = vec3();
    let mut normal: vec3 = vec3();

    // The vertices of the last simplex
    let mut simplex: [Vertex] = [];
}


/**
 * A triangle of the polytope of the expansion, its corners in the vertices,
 * counterclockwise from outside
 *
 * */
@data
record PolytopeFace {
    let mut i: u32 = 0u32;
    let mut j: u32 = 0u32;
    let mut k: u32 = 0u32;
    let mut normal: vec3 = vec3();
    let mut distance: f32 = 0.0f;
}


fn closestCores(a: Convex, b: Convex)-> CoreSearch {
    let mut start = a.centre - b.centre;
    if start.dot(start) <= TOUCHING { start = makeVec3(1.0f, 0.0f, 0.0f); }

    let mut simplex: [Vertex] = copy [vertexAlong(a, b, start)];
    let mut weights: [f32] = copy [1.0f];
    let mut closest = simplex[0].w;
    for _ in 0us .. MAX_ITERATIONS {
        let squared = closest.dot(closest);
        if squared <= TOUCHING {
            return CoreSearch(overlapping-> true, simplex-> simplex);
        }

        let next = vertexAlong(a, b, -closest);
        if squared - closest.dot(next.w) <= RELATIVE_PROGRESS * squared {
            break;
        }

        let candidate = simplex ~ [next];
        let reduced = closestToOrigin(candidate);
        if reduced.inside {
            return CoreSearch(overlapping-> true, simplex-> candidate);
        }

        let point = pointOf(reduced);
        if point.dot(point) >= squared {
            break;
        }

        simplex = reduced.vertices;
        weights = reduced.weights;
        closest = point;
    }

    let mut onA = vec3();
    let mut onB = vec3();
    for i in 0us .. simplex.len {
        onA = onA + simplex[i].a * weights[i];
        onB = onB + simplex[i].b * weights[i];
    }

    // the search may run out of iterations on a simplex touching the origin, no direction joining the cores
    if closest.dot(closest) <= TOUCHING {
        return CoreSearch(overlapping-> true, simplex-> simplex);
    }

    let distance = closest.length();
    CoreSearch(distance-> distance,
               pointA-> onA,
               pointB-> onB,
               normal-> (onB - onA) / distance,
               simplex-> simplex)
}

/**
 * Find the points of two convex shapes closest to each other, by the search of
 * Gilbert, Johnson and Keerthi: the point of their Minkowski difference closest
 * to the origin is approached by simplices of the difference, each one
 * replacing the farthest vertex by the point of the difference the farthest
 * toward the origin
 *
 * @info: the search runs on the cores of the shapes, their margins being taken
 * off the distance found, so a sphere or a capsule is exact
 *
 * @returns: the separation of the shapes, overlapping when their cores are
 * closer than their margins
 *
 * */
pub fn separation(a: Convex, b: Convex)-> Separation {
    let s = closestCores(a, b);
    let margins = a.margin + b.margin;
    if s.overlapping || s.distance <= margins {
        return Separation(overlapping-> true);
    }

    Separation(distance-> s.distance - margins,
               pointA-> s.pointA + s.normal * a.margin,
               pointB-> s.pointB - s.normal * b.margin,
               normal-> s.normal)
}

/**
 * Move a convex shape along a direction until it touches another one, by conservative advancement: the distance between
 * two convex shapes, one moving in a straight line, is a convex function of the distance travelled, so the shape can
 * advance by the distance between them divided by the speed at which they get closer without passing through; each
 * advance stops half of CAST_TOLERANCE short, so that a face met flat is not reached exactly, the shapes touching there
 * without telling where
 * @params:
 *    - moving: the shape moved
 *    - direction: the unit direction it moves along
 *    - length: the distance it travels at most
 *    - target: the shape it may hit
 * @returns: the hit, the moving shape stopping within CAST_TOLERANCE of the target; at a distance 0 when it starts
 * touching it; none when it never touches it, gets away from it, or travels its length first
 * */
pub fn sweep(moving: Convex, direction: vec3, length: f32, target: Convex)-> (SurfaceHit)? {
    let mut travelled = 0.0f;
    let mut last: (Separation)? = none;
    for _ in 0us .. MAX_CAST_STEPS {
        let s = separation(moving.translated(direction * travelled), target);
        if s.overlapping {
            // reached by the rounding errors only, the previous separation telling where the shapes meet
            if let Ok(previous) = last {
                return SurfaceHit(distance-> travelled, point-> previous.pointB, normal-> -previous.normal)?;
            }

            return SurfaceHit(distance-> travelled, point-> moving.centre, normal-> -direction)?;
        }

        if s.distance <= CAST_TOLERANCE {
            return SurfaceHit(distance-> travelled, point-> s.pointB, normal-> -s.normal)?;
        }

        let closing = direction.dot(s.normal);
        if closing <= 1.0e-6f { return none; }

        travelled += (s.distance - CAST_TOLERANCE / 2.0f) / closing;
        if travelled > length { return none; }
        last = s?;
    }

    none
}

/**
 * Advance a convex shape along the motion of its body over a step, its rotation included, until it comes within a
 * distance of another one, by conservative advancement (Mirtich): no point of the core gets closer to the other shape
 * along the normal between them than by the displacement along that normal plus the angle times the reach of the core
 * from the centre of the mass, so the shape can advance by the distance between them over that bound without passing
 * through; each advance stops half the distance short, so that the shapes never meet
 * @params:
 *    - moving: the shape moved, where it starts
 *    - motion: the motion of its body over the step
 *    - target: the shape it may hit, still
 *    - stop: the distance it stops at from the target, above 0
 * @returns: the fraction of the step at which the shape comes within the stop distance of the target, 0 when it starts
 * within it; none when it stays farther over the whole step; the fraction reached when it runs out of advances, before
 * the impact
 * */
pub fn advance(moving: Convex, motion: StepMotion, target: Convex, stop: f32)-> (f32)? {
    let turning = motion.angle * moving.reachFrom(motion.pivot);
    let mut fraction = 0.0f;
    for _ in 0us .. MAX_ADVANCES {
        let s = separation(motion.moved(moving, fraction), target);
        if s.overlapping || s.distance <= stop { return fraction?; }

        let closing = motion.displacement.dot(s.normal) + turning;
        if closing <= 1.0e-6f { return none; }

        fraction += (s.distance - stop / 2.0f) / closing;
        if fraction >= 1.0f { return none; }
    }

    fraction?
}

/**
 * @returns: the vertex of the Minkowski difference of two cores the farthest along a direction
 * */
fn vertexAlong(a: Convex, b: Convex, d: vec3)-> Vertex {
    let onA = a.support(d);
    let onB = b.support(-d);
    Vertex(w-> onA - onB, a-> onA, b-> onB)
}

/**
 * @returns: the point a reduced simplex gives
 * */
fn pointOf(closest: Closest)-> vec3 {
    let mut point = vec3();
    for i in 0us .. closest.vertices.len {
        point = point + closest.vertices[i].w * closest.weights[i];
    }

    point
}

/**
 * @returns: the point of a simplex of one to four vertices closest to the origin
 * */
fn closestToOrigin(simplex: [Vertex])-> Closest {
    match simplex.len {
        1us => { single(simplex[0]) }
        2us => { closestOnSegment(simplex[0], simplex[1]) }
        3us => { closestOnTriangle(simplex[0], simplex[1], simplex[2]) }
        _ => { closestInTetrahedron(simplex[0], simplex[1], simplex[2], simplex[3]) }
    }
}

/**
 * @returns: a vertex alone
 * */
fn single(p: Vertex)-> Closest {
    Closest(vertices-> copy [p], weights-> copy [1.0f])
}

/**
 * @returns: the point of a segment closest to the origin
 * */
fn closestOnSegment(p: Vertex, q: Vertex)-> Closest {
    let pq = q.w - p.w;
    let squared = pq.dot(pq);
    if squared <= TOUCHING { return single(p); }

    let t = (-p.w).dot(pq) / squared;
    if t <= 0.0f { return single(p); }
    if t >= 1.0f { return single(q); }

    Closest(vertices-> copy [p, q], weights-> copy [1.0f - t, t])
}

/**
 * @info: the regions of Voronoi of the corners, the edges and the face of the triangle (Ericson, Real-Time Collision
 * Detection, 5.1.5), a flat triangle giving the closest point of its edges
 * @returns: the point of a triangle closest to the origin
 * */
fn closestOnTriangle(a: Vertex, b: Vertex, c: Vertex)-> Closest {
    let ab = b.w - a.w, ac = c.w - a.w;

    let d1 = ab.dot(-a.w), d2 = ac.dot(-a.w);
    if d1 <= 0.0f && d2 <= 0.0f { return single(a); }

    let d3 = ab.dot(-b.w), d4 = ac.dot(-b.w);
    if d3 >= 0.0f && d4 <= d3 { return single(b); }

    let vc = d1 * d4 - d3 * d2;
    if vc <= 0.0f && d1 >= 0.0f && d3 <= 0.0f {
        let t = d1 / (d1 - d3);
        return Closest(vertices-> copy [a, b], weights-> copy [1.0f - t, t]);
    }

    let d5 = ab.dot(-c.w), d6 = ac.dot(-c.w);
    if d6 >= 0.0f && d5 <= d6 { return single(c); }

    let vb = d5 * d2 - d1 * d6;
    if vb <= 0.0f && d2 >= 0.0f && d6 <= 0.0f {
        let t = d2 / (d2 - d6);
        return Closest(vertices-> copy [a, c], weights-> copy [1.0f - t, t]);
    }

    let va = d3 * d6 - d5 * d4;
    if va <= 0.0f && (d4 - d3) >= 0.0f && (d5 - d6) >= 0.0f {
        let t = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return Closest(vertices-> copy [b, c], weights-> copy [1.0f - t, t]);
    }

    // va + vb + vc is the squared area of the parallelogram of the edges, nothing for a flat triangle
    let sum = va + vb + vc;
    if sum <= FLAT * ab.dot(ab) * ac.dot(ac) {
        return nearest(nearest(closestOnSegment(a, b), closestOnSegment(a, c)), closestOnSegment(b, c));
    }

    let v = vb / sum, w = vc / sum;
    Closest(vertices-> copy [a, b, c], weights-> copy [1.0f - v - w, v, w])
}

/**
 * @info: the faces of the tetrahedron whose plane separates the origin from the tetrahedron (Ericson, 5.1.6)
 * @returns: the point of a tetrahedron closest to the origin, inside when the origin is in it
 * */
fn closestInTetrahedron(a: Vertex, b: Vertex, c: Vertex, d: Vertex)-> Closest {
    let mut best = Closest(inside-> true);
    let mut distance = f32::max;
    closerFace(a, b, c, d, ref best, ref distance);
    closerFace(a, c, d, b, ref best, ref distance);
    closerFace(a, d, b, c, ref best, ref distance);
    closerFace(b, d, c, a, ref best, ref distance);

    best
}

/**
 * Keep the point of a face of a tetrahedron closest to the origin, if the origin is on the other side of the face than
 * the tetrahedron and the point is closer than the best one
 * @params:
 *    - p, q, r: the corners of the face
 *    - opposite: the corner of the tetrahedron off the face
 *    - best: the closest point so far
 *    - distance: the squared distance of the closest point so far
 * */
fn closerFace(p: Vertex, q: Vertex, r: Vertex, opposite: Vertex, ref mut best: Closest, ref mut distance: f32) {
    let n = (q.w - p.w).cross(r.w - p.w);
    let toOpposite = opposite.w - p.w;
    let sideOrigin = (-p.w).dot(n);
    let sideOpposite = toOpposite.dot(n);

    // a flat tetrahedron has no inside, each of its faces being looked at
    let flat = sideOpposite * sideOpposite <= FLAT * n.dot(n) * toOpposite.dot(toOpposite);
    if !flat && sideOrigin * sideOpposite >= 0.0f { return; }

    let closest = closestOnTriangle(p, q, r);
    let point = pointOf(closest);
    if point.dot(point) < distance {
        distance = point.dot(point);
        best = closest;
    }
}

/**
 * @returns: the closest to the origin of two points of a simplex
 * */
fn nearest(x: Closest, y: Closest)-> Closest {
    let px = pointOf(x), py = pointOf(y);
    if px.dot(px) <= py.dot(py) { x } else { y }
}


/**
 * Find how deep two convex shapes overlap: the closest points of their cores
 * when the cores are apart, the expansion of a polytope of the difference of
 * the cores holding the origin otherwise (van den Bergen)
 *
 * @returns: the depth (margins included), the normal from a to b and the
 * deepest points; none when the shapes do not overlap
 *
 * */
pub fn penetration(a: Convex, b: Convex)-> (Penetration)? {
    let s = closestCores(a, b);
    let margins = a.margin + b.margin;
    if !s.overlapping {
        if s.distance > margins { return none; }
        return Penetration(depth-> margins - s.distance,
                           normal-> s.normal,
                           pointA-> s.pointA + s.normal * a.margin,
                           pointB-> s.pointB - s.normal * b.margin)?;
    }

    let mut vertices = tetrahedronOf(a, b, s.simplex);
    if vertices.len < 4us {
        return Penetration(depth-> margins,
                           normal-> makeVec3(0.0f, 1.0f, 0.0f),
                           pointA-> a.centre,
                           pointB-> b.centre)?;
    }

    let mut faces = copy [polytopeFace(vertices, 0u32, 1u32, 2u32),
                          polytopeFace(vertices, 0u32, 3u32, 1u32),
                          polytopeFace(vertices, 0u32, 2u32, 3u32),
                          polytopeFace(vertices, 1u32, 3u32, 2u32)];

    let mut closest = faces[0];
    for _ in 0us .. MAX_EXPANSION {
        closest = faces[0];
        for f in faces if f.distance < closest.distance { closest = f; }

        let next = vertexAlong(a, b, closest.normal);
        if next.w.dot(closest.normal) - closest.distance <= EXPANSION_TOLERANCE * comparison::max(closest.distance, 1.0f) {
            break;
        }

        let index = cast!u32(vertices.len);
        vertices = vertices ~ [next];

        let dmut edges: [u64 => bool] = copy [];
        let mut kept: [PolytopeFace] = [];
        for f in faces {
            if f.normal.dot(next.w - vertices[f.i].w) > 0.0f {
                edges[edgeKey(f.i, f.j)] = true;
                edges[edgeKey(f.j, f.k)] = true;
                edges[edgeKey(f.k, f.i)] = true;
            } else {
                kept ~= [f];
            }
        }

        for key, _ in edges if !(edgeKey(endOf(key), startOf(key)) in edges) {
            kept ~= [polytopeFace(vertices, startOf(key), endOf(key), index)];
        }

        faces = kept;
    }

    // every face flat: the difference spans no volume the expansion could measure
    if closest.distance == f32::max {
        return none;
    }

    let (u, v, w) = barycentric(closest.normal * closest.distance,
                                vertices[closest.i].w,
                                vertices[closest.j].w,
                                vertices[closest.k].w);

    let onA = vertices[closest.i].a * u + vertices[closest.j].a * v + vertices[closest.k].a * w;
    let onB = vertices[closest.i].b * u + vertices[closest.j].b * v + vertices[closest.k].b * w;

    let n = closest.normal;
    Penetration(depth-> closest.distance + margins,
                normal-> n,
                pointA-> onA + n * a.margin,
                pointB-> onB - n * b.margin)?
}

/**
 * @returns: the simplex grown to a tetrahedron by the supports along the axes,
 * then along the normal of a flat triangle; fewer vertices when the difference
 * spans no volume
 *
 * */
fn tetrahedronOf(a: Convex, b: Convex, simplex: [Vertex])-> [Vertex] {
    let mut s = simplex;
    let x = makeVec3(1.0f, 0.0f, 0.0f);
    let y = makeVec3(0.0f, 1.0f, 0.0f);
    let z = makeVec3(0.0f, 0.0f, 1.0f);
    for d in (x, -x, y, -y, z, -z) if s.len < 3us {
        let v = vertexAlong(a, b, d);
        if grows(s, v) {
            s ~= [v];
        }
    }

    if s.len == 3us {
        let n = (s[1].w - s[0].w).cross(s[2].w - s[0].w);
        for d in (n, -n) if s.len < 4us {
            let v = vertexAlong(a, b, d);
            if grows(s, v) {
                s ~= [v];
            }
        }
    }

    s
}

/**
 * @info: the segment and the triangle formed are compared by the squared sine of their angle to FLAT, whatever the size
 * of the shapes
 * @returns: true iif a vertex adds a dimension to a simplex
 * */
fn grows(s: [Vertex], v: Vertex)-> bool {
    if s.len == 0us { return true; }

    let toV = v.w - s[0].w;
    match s.len {
        1us => { toV.dot(toV) > TOUCHING }
        2us => {
            let edge = s[1].w - s[0].w;
            let n = edge.cross(toV);
            n.dot(n) > FLAT * edge.dot(edge) * toV.dot(toV)
        }
        _ => {
            let n = (s[1].w - s[0].w).cross(s[2].w - s[0].w);
            let side = n.dot(toV);
            side * side > FLAT * n.dot(n) * toV.dot(toV)
        }
    }
}

/**
 * @returns: the face of three vertices of the polytope, its normal turned away from the origin
 * */
fn polytopeFace(vertices: [Vertex], i: u32, j: u32, k: u32)-> PolytopeFace {
    let cross = (vertices[j].w - vertices[i].w).cross(vertices[k].w - vertices[i].w);
    if cross.dot(cross) <= 0.0f {
        // a flat face has no normal, nor any distance making it the closest
        return PolytopeFace(i-> i, j-> j, k-> k, normal-> makeVec3(0.0f, 1.0f, 0.0f), distance-> f32::max);
    }

    let n = cross.normalized();
    let d = n.dot(vertices[i].w);
    if d < 0.0f {
        return PolytopeFace(i-> i,
                            j-> k,
                            k-> j,
                            normal-> -n,
                            distance-> -d);
    }

    PolytopeFace(i-> i, j-> j, k-> k, normal-> n, distance-> d)
}

/**
 * @returns: the barycentric weights (u, v, w) of a point in the plane of a triangle, p = a * u + b * v + c * w
 * (Ericson, 3.4); the weights of the centroid when the triangle is flat
 * */
fn barycentric(p: vec3, a: vec3, b: vec3, c: vec3)-> (f32, f32, f32) {
    let v0 = b - a, v1 = c - a, v2 = p - a;
    let d00 = v0.dot(v0), d01 = v0.dot(v1), d11 = v1.dot(v1);
    let d20 = v2.dot(v0), d21 = v2.dot(v1);

    // the squared norm of v0 x v1, compared like the flat triangles of grows
    let denom = d00 * d11 - d01 * d01;
    if denom <= FLAT * d00 * d11 {
        return (1.0f / 3.0f, 1.0f / 3.0f, 1.0f / 3.0f);
    }

    let v = (d11 * d20 - d01 * d21) / denom;
    let w = (d00 * d21 - d01 * d20) / denom;
    (1.0f - v - w, v, w)
}
