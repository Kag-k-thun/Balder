in body_hit;

use balder::math::vector;
use balder::scene::node::node3D::body;

/**
 * A body of a scene hit by a ray or a moving shape (see Scene::raycast)
 * */
pub record BodyHit {

    // The body hit
    pub let dmut body: &PhysicsBody3D;

    // The distance along the ray, or travelled by the shape, to the hit; 0 when it starts inside the body
    pub let distance: f32;

    // The point hit, on the surface of the body, in world space
    pub let point: vec3;

    // The unit normal of the surface of the body at the point hit, facing the ray or the shape
    pub let normal: vec3;

    /**
     * @params:
     *    - body: the body hit
     *    - hit: the hit of the body in the physics world of its scene
     * */
    pub self (dmut body: &PhysicsBody3D, hit: PhysicsHit)
        with body = alias body
        , distance = hit.distance
        , point = hit.point
        , normal = hit.normal
    {}

}
