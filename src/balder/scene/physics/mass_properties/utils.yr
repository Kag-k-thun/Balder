in utils;


use balder::math::{inertia, matrix, vector};

/**
 * @returns: the center of the volume of a shape, in the space of its body
 * */
pub fn centreOf(shape: ColliderShape)-> vec3 {
    if let Ok(h) = shape.convexHull {
        return h.centroid;
    }

    if let Ok(c) = shape.parts {
        let mut weighted = vec3();
        for p in c.parts {
            weighted = weighted + p.place.transformPoint(centreOf(p.shape)) * p.shape.volume;
        }

        return weighted / c.volume;
    }

    vec3()
}


/**
 * @returns: the inertia tensor of a shape of a mass about the centre of its
 * volume, along the axes of its body
 *
 * @info: the mass of a compound splits between its parts by volume, each tensor
 * turned to the axes of the compound, then moved to its centre (parallel axes)
 *
 * */
pub fn inertiaOf(shape: ColliderShape, mass: f32)-> mat3 {
    match shape.kind {
        ColliderKind::BOX => { diagonalTensor(boxInertia(mass, shape.size)) }
        ColliderKind::SPHERE => { diagonalTensor(sphereInertia(mass, shape.radius)) }
        ColliderKind::CAPSULE => { diagonalTensor(capsuleInertia(mass, shape.radius, shape.height)) }
        ColliderKind::CYLINDER => { diagonalTensor(cylinderInertia(mass, shape.radius, shape.height)) }
        ColliderKind::HULL => {
            if let Ok(h) = shape.convexHull {
                return h.unitInertia * (mass / h.volume);
            }
            diagonalTensor(vec3())
        }
        ColliderKind::COMPOUND => {
            let mut sum = diagonalTensor(vec3());
            if let Ok(c) = shape.parts {
                let centre = centreOf(shape);
                for p in c.parts {
                    let m = mass * p.shape.volume / c.volume;
                    let at = p.place.transformPoint(centreOf(p.shape));
                    sum = sum + shiftedTensor(rotatedTensor(inertiaOf(p.shape, m), p.place.rotation), m, at - centre);
                }
            }

            sum
        }
        ColliderKind::PLANE | ColliderKind::MESH => {
            diagonalTensor(vec3())
        }
    }
}
