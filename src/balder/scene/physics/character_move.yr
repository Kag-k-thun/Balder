in character_move;

use balder::math::vector;

/**
 * Where a move of a character controller left its body (see CharacterController::moveAndSlide)
 * */
@data
pub record CharacterMove {

    // The position of the body in the world, the translation of its collider
    pub let mut position: vec3 = vec3();

    // The velocity asked for, without what the surfaces met stopped
    pub let mut velocity: vec3 = vec3();

    // The surfaces the body met while it moved, in their order, the floor found under it included
    pub let mut hits: [PhysicsHit] = [];

}
