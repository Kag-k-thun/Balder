in convex;

use balder::math::{bounds, vector};

use std::math;

/**
 * The kinds of the cores of a convex shape
 * */
pub enum ConvexKind : u32
| POINT    = 0u32 // a point, the core of a sphere
| SEGMENT  = 1u32 // a segment, the core of a capsule
| TRIANGLE = 2u32 // a triangle, of a mesh
| BOX      = 3u32; // a box, turned, scaled and maybe sheared by the transformation of its body

/**
 * A convex shape in world space: a core (a point, a segment, a triangle or a box) grown by a margin in every direction,
 * a sphere being a point grown by its radius and a capsule a segment grown by its radius
 * @info: the distance between two shapes is the distance between their cores, their margins taken off (see
 * gjk::separation)
 * */
pub record Convex {

    // What the core is
    pub let kind: ConvexKind;

    // The point; the ends of the segment (a, b); the corners of the triangle (a, b, c); the centre of the box (a)
    pub let a: vec3;
    pub let b: vec3;
    pub let c: vec3;

    // The half sides of the box along its three edges, in world space
    pub let u: vec3;
    pub let v: vec3;
    pub let w: vec3;

    // The distance the core is grown by in every direction
    pub let margin: f32;

    /**
     * @params:
     *    - kind: what the core is
     *    - a, b, c: the point, the ends of the segment, the corners of the triangle, the centre of the box
     *    - u, v, w: the half sides of the box along its edges
     *    - margin: the distance the core is grown by
     * */
    pub self (kind: ConvexKind, a: vec3, b: vec3, c: vec3, u: vec3, v: vec3, w: vec3, margin: f32)
        with kind = kind
        , a = a, b = b, c = c
        , u = u, v = v, w = w
        , margin = margin
    {}

    /**
     * A sphere, a point grown by a radius
     * */
    pub self sphere(centre: vec3, radius: f32)
        with self(ConvexKind::POINT, centre, centre, centre, vec3(), vec3(), vec3(), radius)
    {}

    /**
     * A capsule, a segment grown by a radius
     * */
    pub self capsule(a: vec3, b: vec3, radius: f32)
        with self(ConvexKind::SEGMENT, a, b, b, vec3(), vec3(), vec3(), radius)
    {}

    /**
     * A triangle, of no margin
     * */
    pub self triangle(a: vec3, b: vec3, c: vec3)
        with self(ConvexKind::TRIANGLE, a, b, c, vec3(), vec3(), vec3(), 0.0f)
    {}

    /**
     * A box, of no margin
     * @params:
     *    - centre: the centre of the box
     *    - u, v, w: the half sides of the box along its three edges, from its centre to the centres of three of its faces
     * */
    pub self box(centre: vec3, u: vec3, v: vec3, w: vec3)
        with self(ConvexKind::BOX, centre, centre, centre, u, v, w, 0.0f)
    {}

    /**
     * @returns: the point of the core the farthest along a direction, not normalized
     * */
    pub fn support(self, d: vec3)-> vec3 {
        match self.kind {
            ConvexKind::POINT => { self.a }
            ConvexKind::SEGMENT => {
                if d.dot(self.b - self.a) > 0.0f { self.b } else { self.a }
            }
            ConvexKind::TRIANGLE => {
                let da = d.dot(self.a), db = d.dot(self.b), dc = d.dot(self.c);
                if da >= db && da >= dc { self.a } else if db >= dc { self.b } else { self.c }
            }
            _ => {
                let su = if d.dot(self.u) >= 0.0f { 1.0f } else { -1.0f };
                let sv = if d.dot(self.v) >= 0.0f { 1.0f } else { -1.0f };
                let sw = if d.dot(self.w) >= 0.0f { 1.0f } else { -1.0f };
                self.a + self.u * su + self.v * sv + self.w * sw
            }
        }
    }

    /**
     * @returns: a point inside the core, its centre
     * */
    @field
    pub fn centre(self)-> vec3 {
        match self.kind {
            ConvexKind::SEGMENT  => { (self.a + self.b) / 2.0f }
            ConvexKind::TRIANGLE => { (self.a + self.b + self.c) / 3.0f }
            _                    => { self.a }
        }
    }

    /**
     * @returns: the shape moved by an offset
     * */
    pub fn translated(self, offset: vec3)-> Convex {
        Convex(self.kind, self.a + offset, self.b + offset, self.c + offset, self.u, self.v, self.w, self.margin)
    }

    /**
     * @returns: the smallest box aligned with the axes enclosing the shape, its margin included
     * */
    @field
    pub fn bounds(self)-> Aabb {
        let grow = makeVec3(self.margin, self.margin, self.margin);
        if self.kind == ConvexKind::BOX {
            let reach = makeVec3(math::abs(self.u.x) + math::abs(self.v.x) + math::abs(self.w.x),
                                 math::abs(self.u.y) + math::abs(self.v.y) + math::abs(self.w.y),
                                 math::abs(self.u.z) + math::abs(self.v.z) + math::abs(self.w.z));
            return Aabb(self.a - reach - grow, self.a + reach + grow);
        }

        let core = Aabb(self.a, self.a).merged(Aabb(self.b, self.b)).merged(Aabb(self.c, self.c));
        Aabb(core.min - grow, core.max + grow)
    }

}
