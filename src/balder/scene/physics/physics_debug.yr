in physics_debug;

/**
 * The categories of the debug view of the physics of a scene, one bit each (see Scene::physicsDebug)
 * */
pub enum PhysicsDebug : u32
| NONE       = 0u32
| SHAPES     = 1u32  // the colliders, coloured by the motion and the sleep of their bodies
| CONTACTS   = 2u32  // the points of the manifolds and their normals
| BOXES      = 4u32  // the boxes of the colliders in the world
| BROADPHASE = 8u32  // the hierarchy of the enlarged boxes, coloured by depth
| JOINTS     = 16u32 // the anchors of the joints, their arms from the centres of their bodies and their axes
| ALL        = 31u32;
