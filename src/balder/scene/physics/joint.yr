in joint;

use balder::math::{rigid_transform, vector};

/**
 * A joint of a world between two bodies: its settings, its frame placed on each body, and the impulses it gathered at
 * the last step, the next one starting from them
 *
 * @info: the frames are in the space of the poses of the bodies (their scale apart), equal in the world when the joint
 * was made; the joint keeps the motion of the second frame with respect to the first by its kind. The impulses are
 * those of a sub step, in the frame of the first body for the rows across the axis (see JointConstraint)
 *
 * */
@data
pub record Joint {

    // The first body, the frame of a hinge or a slider turning with it
    let mut a: u32 = 0u32;

    // The second body
    let mut b: u32 = 0u32;

    // How the joint holds its bodies
    let mut settings: JointSettings = JointSettings();

    // The frame of the joint in the space of the pose of the first body, its origin the anchor, its X axis the axis
    let mut frameA: RigidTransform = RigidTransform();

    // The frame of the joint in the space of the pose of the second body
    let mut frameB: RigidTransform = RigidTransform();

    // True once the joint broke, holding its bodies no longer
    let mut broken: bool = false;

    // The impulse of the linear rows, the anchor kept (x, y, z in the world) or the slider kept on its axis (x, y across
    // the axis in the frame of the first body)
    let mut linearImpulse: vec3 = vec3();

    // The impulse of the angular rows, the rotation kept (in the world) or the hinge kept on its axis (x, y across the
    // axis in the frame of the first body)
    let mut angularImpulse: vec3 = vec3();

    // The impulse of the motor along the axis
    let mut motorImpulse: f32 = 0.0f;

    // The impulses of the lower and of the upper limits along the axis, never pulling
    let mut lowerImpulse: f32 = 0.0f;
    let mut upperImpulse: f32 = 0.0f;
}
