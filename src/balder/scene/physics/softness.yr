in softness;

use std::algorithm::comparison;

/**
 * The share of a step a sub step must stay under for a contact to be as stiff as it is asked, a stiffer one wobbling
 * */
def STIFFEST = 0.25f;

/**
 * How a soft contact pushes a penetration out during a sub step, as a damped spring (Box2D v3, Erin Catto, "Solver2D")
 * */
@data
pub record Softness {

    // The speed a penetration is pushed out by, per metre of its depth
    let mut biasRate: f32 = 0.0f;

    // The part of the mass of a point its push takes
    let mut massScale: f32 = 1.0f;

    // The part of the impulse gathered given back at each pass, the give of the spring
    let mut impulseScale: f32 = 0.0f;

    /**
     * The softness of the contacts of a sub step, their frequency kept under STIFFEST of the rate of the sub steps
     * @params:
     *    - h: the duration of the sub step
     * */
    pub self (settings: SolverSettings, h: f32) {
        let hertz = comparison::min(settings.contactHertz, STIFFEST / h);
        let omega = 2.0f * 3.14159265f * hertz;
        let a1 = 2.0f * settings.contactDamping + h * omega;
        let a2 = h * omega * a1;
        let a3 = 1.0f / (1.0f + a2);
        self.biasRate = omega / a1;
        self.massScale = a2 * a3;
        self.impulseScale = a3;
    }
}
