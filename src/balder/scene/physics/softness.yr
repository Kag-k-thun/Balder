in softness;

use std::algorithm::comparison;

/**
 * The share of a step a sub step must stay under for a contact to be as stiff as it is asked, a stiffer one wobbling
 * */
def STIFFEST = 0.25f;

/**
 * How a soft contact pushes a penetration out during a sub step, as a damped spring (Box2D v3, Erin Catto, "Solver2D")
 * */
@data
pub record Softness {

    // The frequency of the spring, in hertz, as stiff as it was asked or as the sub step lets it be, 0 for no spring
    let mut hertz: f32 = 0.0f;

    // The speed a penetration is pushed out by, per metre of its depth
    let mut biasRate: f32 = 0.0f;

    // The part of the mass of a point its push takes
    let mut massScale: f32 = 1.0f;

    // The part of the impulse gathered given back at each pass, the give of the spring
    let mut impulseScale: f32 = 0.0f;

    /**
     * The softness of a spring during a sub step, its frequency kept under STIFFEST of the rate of the sub steps
     * @params:
     *    - hertz: the frequency of the spring
     *    - damping: its damping ratio
     *    - h: the duration of the sub step
     * */
    pub self (hertz: f32, damping: f32, h: f32) {
        let stiffest = comparison::min(hertz, STIFFEST / h);
        self.hertz = stiffest;
        let omega = 2.0f * 3.14159265f * stiffest;
        let a1 = 2.0f * damping + h * omega;
        let a2 = h * omega * a1;
        let a3 = 1.0f / (1.0f + a2);
        self.biasRate = omega / a1;
        self.massScale = a2 * a3;
        self.impulseScale = a3;
    }

    /**
     * No softness: no penetration nor error pushed out, the whole mass taken, nothing given back (a relaxing pass)
     * */
    pub self rigid() {}
}
