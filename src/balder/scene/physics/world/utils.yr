in utils;

use balder::math::{matrix, utils};
use balder::utils::log;

/**
 * @returns: true iif a body looks for its contacts, being kinematic or a trigger
 * */
pub fn isActive(settings: BodySettings)-> bool {
    settings.motion != BodyMotion::STATIC || settings.trigger
}

/**
 * @returns: true iif one of two bodies is in a layer of the mask of the other
 * */
pub fn sees(a: BodySettings, b: BodySettings)-> bool {
    (a.mask & b.layer) != 0u32 || (b.mask & a.layer) != 0u32
}

/**
 * @returns: the hit of a body
 * */
pub fn hitOf(body: u32, hit: SurfaceHit)-> PhysicsHit {
    PhysicsHit(body-> body, distance-> hit.distance, point-> hit.point, normal-> hit.normal)
}

/**
 * @returns: the settings of a body as the world takes them: a mesh or a plane
 * never dynamic, a dynamic body of no mass weighing 1
 *
 * */
pub fn checked(shape: ColliderShape, settings: BodySettings)-> BodySettings {
    if settings.motion != BodyMotion::DYNAMIC {
        return settings;
    }

    let mut result = settings;
    if shape.kind == ColliderKind::MESH || shape.kind == ColliderKind::PLANE {
        log::error #("PhysicsWorld", "A mesh or a plane is never dynamic, the body is kept static");
        result.motion = BodyMotion::STATIC;
    }

    else if settings.mass <= 0.0f {
        log::error #("PhysicsWorld", f"A dynamic body needs a mass above 0, not ${settings.mass}; it weighs 1");
        result.mass = 1.0f;
    }

    result
}

/**
 * @returns: the state of a body at rest, the mass of its scaled shape for a
 * dynamic body; a static body asleep
 *
 * */
pub fn stateOf(shape: ColliderShape, transform: mat4, settings: BodySettings)-> BodyState {
    if settings.motion != BodyMotion::DYNAMIC {
        let mut still = BodyState(transform);
        still.awake = (settings.motion == BodyMotion::KINEMATIC);
        return still;
    }

    BodyState(transform,
              mass-> MassProperties(shape.scaled(axesScale(transform)), settings.mass))
}

/**
 * @returns: the state of a body moved by a transformation, awake, its
 * velocities kept, its mass computed again only when its scale changed
 *
 * */
pub fn movedState(state: BodyState, shape: ColliderShape, transform: mat4, settings: BodySettings)-> BodyState {
    let rescaled = (axesScale(transform) - state.scale).length() > 1.0e-6f;
    let mut moved = if rescaled {
        stateOf(shape, transform, settings)
    } else {
        state
    };

    moved:.place(transform);
    moved.linearVelocity = state.linearVelocity;
    moved.angularVelocity = state.angularVelocity;
    moved:.wake();

    moved
}

/**
 * @returns: the transformation placing the collider of a body: rigid for a
 * dynamic body, that of its node otherwise
 *
 * */
pub fn placementOf(state: BodyState, transform: mat4, settings: BodySettings)-> mat4 {
    if settings.motion == BodyMotion::DYNAMIC {
        state.placement
    } else {
        transform
    }
}

/**
 * @returns: true iif two bodies may touch, the pair kept by the broadphase: one
 * of them active, one seeing the other through its mask, and not two surfaces
 * (two meshes, two planes, a mesh and a plane)
 *
 * @info: the only filter of the pairs, the narrowphase testing every pair it is
 * given
 *
 * */
pub fn canTouch(a: WorldBody, b: WorldBody)-> bool {
    if !isActive(a.settings) && !isActive(b.settings) { return false; }
    if !sees(a.settings, b.settings) { return false; }

    let surfaceA = a.collider.isMesh || a.collider.isPlane;
    let surfaceB = b.collider.isMesh || b.collider.isPlane;
    !(surfaceA && surfaceB)
}
