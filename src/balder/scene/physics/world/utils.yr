in utils;

/**
 * @returns: the key of a pair of bodies, the smaller handle in the high bits, the same whatever their order
 * */
pub fn pairKey(a: u32, b: u32)-> u64 {
    let (low, high) = if a < b { (a, b) } else { (b, a) };
    (cast!u64(low) << 32u64) | cast!u64(high)
}

/**
 * @returns: the smaller handle of a pair of bodies
 * */
pub fn firstOf(key: u64)-> u32 {
    cast!u32(key >> 32u64)
}

/**
 * @returns: the larger handle of a pair of bodies
 * */
pub fn secondOf(key: u64)-> u32 {
    cast!u32(key & 0xFFFFFFFFu64)
}

/**
 * @returns: true iif a body looks for its contacts, being kinematic or a trigger
 * */
pub fn isActive(settings: BodySettings)-> bool {
    settings.motion == BodyMotion::KINEMATIC || settings.trigger
}

/**
 * @returns: true iif one of two bodies is in a layer of the mask of the other
 * */
pub fn sees(a: BodySettings, b: BodySettings)-> bool {
    (a.mask & b.layer) != 0u32 || (b.mask & a.layer) != 0u32
}

/**
 * @returns: the hit of a body
 * */
pub fn hitOf(body: u32, hit: SurfaceHit)-> PhysicsHit {
    PhysicsHit(body-> body, distance-> hit.distance, point-> hit.point, normal-> hit.normal)
}
