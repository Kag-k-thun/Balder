in islands;

/**
 * @returns: the root of the island of a body in a union-find, the path to it shortened on the way
 * @params:
 *    - parent: the parent of each body, a root being its own parent
 * */
pub fn rootOf(dmut parent: [u32], body: u32)-> u32 {
    let mut r = body;
    while parent[r] != r { r = parent[r]; }

    let mut b = body;
    while parent[b] != r {
        let next = parent[b];
        parent[b] = r;
        b = next;
    }

    r
}

/**
 * Put two bodies of a union-find in one island
 * */
pub fn join(dmut parent: [u32], a: u32, b: u32) {
    let ra = rootOf(alias parent, a), rb = rootOf(alias parent, b);
    if ra != rb { parent[ra] = rb; }
}
