in physics_hit;

use balder::math::vector;

/**
 * A body of a physics world hit by a ray or a moving shape
 * */
@data
pub record PhysicsHit {

    // The handle of the body hit
    pub let mut body: u32 = 0u32;

    // The distance along the ray, or travelled by the shape, to the hit; 0 when it starts inside the body
    pub let mut distance: f32 = 0.0f;

    // The point hit, on the surface of the body, in world space
    pub let mut point: vec3 = vec3();

    // The unit normal of the surface of the body at the point hit, facing the ray or the shape
    pub let mut normal: vec3 = vec3();

}
