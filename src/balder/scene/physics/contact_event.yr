in contact_event;

/**
 * The phases of the contact of two bodies, from one update of the contacts of their world to the next
 * */
pub enum ContactPhase : u32
| BEGAN  = 0u32 // the bodies touch, and did not at the previous update
| STAYED = 1u32 // the bodies touch, and did at the previous update
| ENDED  = 2u32; // the bodies touched at the previous update, and no longer do (or one of them left the world)

/**
 * A change of the contact of two bodies of a physics world, or its continuation
 * */
@data
pub record ContactEvent {

    // The handle of the first body, the smaller of the two
    pub let mut a: u32 = 0u32;

    // The handle of the second body
    pub let mut b: u32 = 0u32;

    // The phase of the contact
    pub let mut phase: ContactPhase = ContactPhase::BEGAN;

}
