in step_motion;

use balder::math::{bounds, quaternion, vector};

/**
 * The motion of a body over a step, the path its conservative advancement follows (see gjk::advance): the centre of its
 * mass moving in a straight line, the body turning about it by an angle about a fixed axis, both at a constant speed
 * */
pub record StepMotion {

    // The centre of the mass at the start of the step, in the world
    pub let pivot: vec3;

    // How far the centre of the mass moves over the step
    pub let displacement: vec3;

    // The angle the body turns by over the step, in radians, within [0, 2 pi]
    pub let angle: f32;

    // The unit axis the body turns about, in the world
    pub let axis: vec3;

    /**
     * @params:
     *    - pivot: the centre of the mass at the start of the step, in the world
     *    - displacement: how far it moves over the step
     *    - rotation: how the body turns over the step, the way it turns (see Quaternion::turn)
     * */
    pub self (pivot: vec3, displacement: vec3, rotation: Quaternion)
        with pivot = pivot
        , displacement = displacement
        , angle = rotation.turn()._0
        , axis = rotation.turn()._1
    {}

    /**
     * @returns: the rotation of the body at a fraction of the step, from where it starts
     * */
    pub fn rotationAt(self, fraction: f32)-> Quaternion {
        Quaternion::fromAxisAngle(self.angle * fraction, self.axis)
    }

    /**
     * @returns: a convex shape of the body, where it starts, moved with the body to a fraction of the step
     * */
    pub fn moved(self, shape: Convex, fraction: f32)-> Convex {
        shape.transformed(self.rotationAt(fraction), self.pivot, self.displacement * fraction)
    }

    /**
     * @returns: the box enclosing what a shape of the body sweeps over the step, a shape within a distance of the
     * centre of the mass
     * @params:
     *    - reach: the distance from the centre of the mass to the farthest point of the shape
     * */
    pub fn bounds(self, reach: f32)-> Aabb {
        let grow = makeVec3(reach, reach, reach);
        let end = self.pivot + self.displacement;
        Aabb(self.pivot - grow, self.pivot + grow).merged(Aabb(end - grow, end + grow))
    }

}
