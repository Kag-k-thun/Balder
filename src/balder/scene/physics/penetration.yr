in penetration;

use balder::math::vector;

/**
 * How deep two convex shapes overlap (see gjk::penetration)
 *
 */
@data
pub record Penetration {
    // The depth of the overla along the normal, the margins included
    let mut depth: f32 = 0.0f;

    // The unit normal from the first shape to the second, the second moving along it by the depth to part them
    let mut normal: vec3 = vec3();

    // The point of the first shape the deepest in the second, on its surface
    let mut pointA: vec3 = vec3();

    // The point of the second shape the deepest in the first, on its surface
    let mut pointB: vec3 = vec3();
}
