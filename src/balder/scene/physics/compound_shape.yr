in compound_shape;

use balder::core::error;
use balder::math::{bounds, rigid_transform, vector};


@final
pub class CompoundShape {

    // The parts, none of them a compound
    let mut _parts: [CompoundPart] = [];

    // The box enclosing the parts, in the space of the body
    let mut _bounds: Aabb = Aabb();


    pub self(parts: [CompoundPart])
        throws BalderError
    {
        for p in parts {
            self:.take(p);
        }

        if self._parts.len == 0 {
            throw copy BalderError("A compound shape needs a part at least");
        }
    }

    /**
     * The parts of a compound already checked
     * */
    self fromParts(parts: [CompoundPart]) {
        {
            for p in parts {
                self:.take(p);
            }
        } catch {
            _ => panic;
        }
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the parts, none of them a compound
     * */
    @field
    pub fn parts(self)-> [CompoundPart] {
        self._parts
    }

    /**
     * @returns: the box enclosing the parts, in the space of the body
     * */
    @field
    pub fn bounds(self)-> Aabb {
        self._bounds
    }

    /**
     * @returns: the sum of the volumes of the parts, those they share counted
     * twice
     *
     * */
    @field
    pub fn volume(self)-> f32 {
        let mut sum = 0.0f;
        for p in self._parts {
            sum += p.shape.volume;
        }
        sum
    }

    /**
     * @returns: the parts placed by a scale of the space of the compound, each
     * part scaled by the scale along its own axes
     *
     * */
    pub fn scaled(self, scale: vec3)-> &CompoundShape {
        let parts = copy [{
            let along = math::utils::axesScale(math::utils::scaling(scale) * p.place.rotation.matrix());
            let at = makeVec3(p.place.position.x * scale.x, p.place.position.y * scale.y, p.place.position.z * scale.z);
            CompoundPart(shape-> p.shape.scaled(along),
                         place-> RigidTransform(position-> at, rotation-> p.place.rotation))
        } for p in self._parts];

        copy CompoundShape::fromParts(parts)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Add a part, the parts of a compound part placed under it
     * */
    fn take(mut self, part: CompoundPart)
        throws BalderError
    {
        if part.shape.kind == ColliderKind::MESH || part.shape.kind == ColliderKind::PLANE {
            throw copy BalderError("A mesh or a plane is no part of a compound shape");
        }

        if let Ok(inner) = part.shape.parts {
            for p in inner.parts {
                self:.take(CompoundPart(shape-> p.shape,
                                        place-> part.place * p.place));
            }

            return;
        }


        self._parts ~= [part];
        self._bounds = self._bounds.merged(part.shape.localBox().transformed(part.place.matrix()));
    }

}
