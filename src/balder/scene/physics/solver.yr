in solver;

use balder::math::vector;

use std::math;
use std::algorithm::comparison;

/**
 * The absolute coordinate of a unit normal along X under which its tangents start from X, the normal being far enough
 * from it (1 / sqrt (3), a unit vector having a coordinate at least that large)
 *
 * */
def TANGENT_FROM_X = 0.57735f;





/**
 * @returns: the constraint of a manifold between two solver bodies, its points not filled (see preparePoint)
 *
 * @params:
 *    - a, b: the indices of the two bodies, the normal going from a to b
 *    - normal: the unit normal of the manifold
 *    - friction: the friction of the contact (see materialOf)
 *    - first: the index of the first point of the manifold in the points of the island
 *
 * */
pub fn prepare(a: usize, b: usize, normal: vec3, friction: f32, first: usize)-> ContactConstraint {
    let (t1, t2) = tangentsOf(normal);
    ContactConstraint(a-> a, b-> b, normal-> normal, tangent1-> t1, tangent2-> t2, friction-> friction, first-> first)
}

/**
 * @returns: a point of a manifold as the solver pushes on it, its impulses those the point carried from the step
 * before (the friction projected on the tangents of the step)
 *
 * @params:
 *    - bodies: the solver bodies of the island
 *    - c: the constraint of the manifold of the point
 *    - p: the point
 *    - restitution: the restitution of the contact (see materialOf)
 *    - settings: when the point bounces
 *
 * @info: a point closing faster than the bounce threshold before the step bounces back by its restitution (see
 * applyRestitution)
 *
 * */
pub fn preparePoint(bodies: [SolverBody], c: ContactConstraint, p: ContactPoint, restitution: f32,
                    settings: SolverSettings)-> ConstraintPoint {
    let ba = bodies[c.a], bb = bodies[c.b];
    let ra = p.point - ba.centre, rb = p.point - bb.centre;
    let mut cp = ConstraintPoint(armA-> ra, armB-> rb, separation-> -p.depth,
                                 normalImpulse-> p.normalImpulse,
                                 tangentImpulse1-> p.frictionImpulse.dot(c.tangent1),
                                 tangentImpulse2-> p.frictionImpulse.dot(c.tangent2));

    cp.normalMass = inverseOf(massAlong(ba, bb, ra, rb, c.normal));
    cp.tangentMass1 = inverseOf(massAlong(ba, bb, ra, rb, c.tangent1));
    cp.tangentMass2 = inverseOf(massAlong(ba, bb, ra, rb, c.tangent2));

    let vn = ((bb.linearVelocity + bb.angularVelocity.cross(rb)) - (ba.linearVelocity + ba.angularVelocity.cross(ra)))
        .dot(c.normal);
    if vn < -settings.bounceThreshold {
        cp.bounce = -restitution * vn;
    }

    cp
}

/**
 * Change the velocities of the bodies that move by their accelerations during a sub step, then slow them down by
 * their damping (v / (1 + c h), stable whatever c)
 * */
pub fn integrateVelocities(dmut bodies: [SolverBody], h: f32) {
    for i in 0us .. bodies.len if bodies[i].inverseMass > 0.0f {
        let b = bodies[i];
        bodies[i].linearVelocity = (b.linearVelocity + b.linearAcceleration * h) / (1.0f + b.linearDamping * h);
        bodies[i].angularVelocity = (b.angularVelocity + b.angularAcceleration * h) / (1.0f + b.angularDamping * h);
    }
}

/**
 * Move the bodies that move by their velocities during a sub step, their centres along their linear velocities, their
 * rotations by their angular velocities
 * */
pub fn integratePositions(dmut bodies: [SolverBody], h: f32) {
    for i in 0us .. bodies.len if bodies[i].inverseMass > 0.0f {
        let b = bodies[i];
        bodies[i].deltaPosition = b.deltaPosition + b.linearVelocity * h;
        bodies[i].deltaRotation = b.deltaRotation.integrated(b.angularVelocity, h);
    }
}

/**
 * Apply to the bodies the impulses the points gathered at the sub step before, the solver starting from them rather
 * than from nothing (warm starting): what keeps a stack still
 *
 * */
pub fn warmStart(dmut bodies: [SolverBody], constraints: [ContactConstraint], points: [ConstraintPoint]) {
    for c in constraints {
        let mA = bodies[c.a].inverseMass, mB = bodies[c.b].inverseMass;
        let iA = bodies[c.a].inverseInertia, iB = bodies[c.b].inverseInertia;
        let mut vA = bodies[c.a].linearVelocity;
        let mut wA = bodies[c.a].angularVelocity;
        let mut vB = bodies[c.b].linearVelocity;
        let mut wB = bodies[c.b].angularVelocity;
        for j in c.first .. c.first + c.count {
            let p = points[j];
            let impulse = c.normal * p.normalImpulse + c.tangent1 * p.tangentImpulse1 + c.tangent2 * p.tangentImpulse2;
            vA = vA - impulse * mA;
            wA = wA - iA * p.armA.cross(impulse);
            vB = vB + impulse * mB;
            wB = wB + iB * p.armB.cross(impulse);
        }

        store(alias bodies, c, vA, wA, vB, wB);
    }
}

/**
 * Run a pass of the solver over the constraints during a sub step (projected Gauss-Seidel): the normal of each point
 * of a manifold, never pulling, then the friction of each, bounded by its friction times the impulse of its normal
 * (the pyramid of the cone of friction)
 *
 * @params:
 *    - h: the duration of the sub step
 *    - correct: true to push the penetrations out (a pass of the sub step), false to relax the velocities the
 *      correction left (the last pass of a sub step), the bodies staying where it moved them
 *
 * @info: a point apart closes in by its gap and no more, which stops a fast body at a thin wall; a point sunk is pushed
 * out as by a spring of contactHertz damped by contactDamping (a soft contact, Box2D v3), maxCorrection at most; the
 * impulses gathered are clamped, not the impulse of a pass, so a pass takes back what an earlier one overdid
 *
 * */
pub fn solve(dmut bodies: [SolverBody], constraints: [ContactConstraint], dmut points: [ConstraintPoint], h: f32,
             settings: SolverSettings, correct: bool) {
    let soft = Softness(settings.contactHertz, settings.contactDamping, h);
    for c in constraints {
        let mA = bodies[c.a].inverseMass, mB = bodies[c.b].inverseMass;
        let iA = bodies[c.a].inverseInertia, iB = bodies[c.b].inverseInertia;
        let dpA = bodies[c.a].deltaPosition, dqA = bodies[c.a].deltaRotation;
        let dpB = bodies[c.b].deltaPosition, dqB = bodies[c.b].deltaRotation;
        let mut vA = bodies[c.a].linearVelocity;
        let mut wA = bodies[c.a].angularVelocity;
        let mut vB = bodies[c.b].linearVelocity;
        let mut wB = bodies[c.b].angularVelocity;

        for j in c.first .. c.first + c.count {
            let p = points[j];

            // the separation at the start of the step moved by how far the bodies moved and turned since
            let da = dpA + dqA * p.armA - p.armA, db = dpB + dqB * p.armB - p.armB;
            let s = p.separation + (db - da).dot(c.normal);
            let mut target = 0.0f;
            let mut massScale = 1.0f;
            let mut impulseScale = 0.0f;
            if s > 0.0f {
                target = -s / h;
            } else if correct {
                target = comparison::min(-soft.biasRate * s, settings.maxCorrection);
                massScale = soft.massScale;
                impulseScale = soft.impulseScale;
            }

            let vn = ((vB + wB.cross(p.armB)) - (vA + wA.cross(p.armA))).dot(c.normal);
            let impulse = comparison::max(p.normalImpulse - p.normalMass * massScale * (vn - target)
                                          - impulseScale * p.normalImpulse, 0.0f);
            let push = c.normal * (impulse - p.normalImpulse);
            vA = vA - push * mA;
            wA = wA - iA * p.armA.cross(push);
            vB = vB + push * mB;
            wB = wB + iB * p.armB.cross(push);

            points[j].normalImpulse = impulse;
            points[j].maxNormalImpulse = comparison::max(p.maxNormalImpulse, impulse);
        }

        for j in c.first .. c.first + c.count {
            let p = points[j];
            let limit = c.friction * p.normalImpulse;

            let v1 = ((vB + wB.cross(p.armB)) - (vA + wA.cross(p.armA))).dot(c.tangent1);
            let impulse1 = clamped(p.tangentImpulse1 - p.tangentMass1 * v1, -limit, limit);
            let push1 = c.tangent1 * (impulse1 - p.tangentImpulse1);
            vA = vA - push1 * mA;
            wA = wA - iA * p.armA.cross(push1);
            vB = vB + push1 * mB;
            wB = wB + iB * p.armB.cross(push1);

            let v2 = ((vB + wB.cross(p.armB)) - (vA + wA.cross(p.armA))).dot(c.tangent2);
            let impulse2 = clamped(p.tangentImpulse2 - p.tangentMass2 * v2, -limit, limit);
            let push2 = c.tangent2 * (impulse2 - p.tangentImpulse2);
            vA = vA - push2 * mA;
            wA = wA - iA * p.armA.cross(push2);
            vB = vB + push2 * mB;
            wB = wB + iB * p.armB.cross(push2);

            points[j].tangentImpulse1 = impulse1;
            points[j].tangentImpulse2 = impulse2;
        }

        store(alias bodies, c, vA, wA, vB, wB);
    }
}

/**
 * Make the points closing fast enough before the step bounce back by their restitution, once the sub steps are run:
 * only those a sub step pushed on, a speculative point never reached bouncing nothing
 *
 * */
pub fn applyRestitution(dmut bodies: [SolverBody], constraints: [ContactConstraint], dmut points: [ConstraintPoint]) {
    for c in constraints {
        let mut bounces = false;
        for j in c.first .. c.first + c.count if points[j].bounce > 0.0f && points[j].maxNormalImpulse > 0.0f {
            bounces = true;
        }

        if !bounces { continue; }

        let mA = bodies[c.a].inverseMass, mB = bodies[c.b].inverseMass;
        let iA = bodies[c.a].inverseInertia, iB = bodies[c.b].inverseInertia;
        let mut vA = bodies[c.a].linearVelocity;
        let mut wA = bodies[c.a].angularVelocity;
        let mut vB = bodies[c.b].linearVelocity;
        let mut wB = bodies[c.b].angularVelocity;
        for j in c.first .. c.first + c.count if points[j].bounce > 0.0f && points[j].maxNormalImpulse > 0.0f {
            let p = points[j];
            let vn = ((vB + wB.cross(p.armB)) - (vA + wA.cross(p.armA))).dot(c.normal);
            let impulse = comparison::max(p.normalImpulse - p.normalMass * (vn - p.bounce), 0.0f);
            let push = c.normal * (impulse - p.normalImpulse);
            vA = vA - push * mA;
            wA = wA - iA * p.armA.cross(push);
            vB = vB + push * mB;
            wB = wB + iB * p.armB.cross(push);
            points[j].normalImpulse = impulse;
        }

        store(alias bodies, c, vA, wA, vB, wB);
    }
}

/**
 * @returns:
 *    - 0: the friction of a contact between two bodies, the geometric mean of theirs, ice on rubber sliding
 *    - 1: the restitution of the contact, the larger of theirs, a ball bouncing off any floor
 * */
pub fn materialOf(a: BodySettings, b: BodySettings)-> (f32, f32) {
    (math::sqrt(a.friction * b.friction), comparison::max(a.restitution, b.restitution))
}

/**
 * @returns: two unit tangents across a unit normal, orthogonal to each other, (normal, t1, t2) direct
 * */
pub fn tangentsOf(n: vec3)-> (vec3, vec3) {
    let other = if math::abs(n.x) < TANGENT_FROM_X { makeVec3(1.0f, 0.0f, 0.0f) } else { makeVec3(0.0f, 1.0f, 0.0f) };
    let t1 = n.cross(other).normalized();
    (t1, n.cross(t1))
}

/**
 * Write back the velocities of the two bodies of a constraint, those of a body nothing pushes left as they were
 * */
fn store(dmut bodies: [SolverBody], c: ContactConstraint, vA: vec3, wA: vec3, vB: vec3, wB: vec3) {
    if bodies[c.a].inverseMass > 0.0f {
        bodies[c.a].linearVelocity = vA;
        bodies[c.a].angularVelocity = wA;
    }

    if bodies[c.b].inverseMass > 0.0f {
        bodies[c.b].linearVelocity = vB;
        bodies[c.b].angularVelocity = wB;
    }
}

/**
 * @returns: a value within [low, high]
 * */
fn clamped(x: f32, low: f32, high: f32)-> f32 {
    comparison::max(low, comparison::min(high, x))
}

/**
 * @returns: what a unit impulse along a direction at the arms of two bodies changes their relative speed along it by
 * */
fn massAlong(a: SolverBody, b: SolverBody, ra: vec3, rb: vec3, d: vec3)-> f32 {
    let ca = ra.cross(d), cb = rb.cross(d);
    a.inverseMass + b.inverseMass + ca.dot(a.inverseInertia * ca) + cb.dot(b.inverseInertia * cb)
}

/**
 * @returns: the inverse of a mass along a direction, 0 when nothing moves along it
 * */
fn inverseOf(k: f32)-> f32 {
    if k > 0.0f { 1.0f / k } else { 0.0f }
}
