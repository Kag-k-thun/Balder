in clipping;

use balder::math::vector;

use std::math;
use std::algorithm::comparison;

/**
 * The cosine between the normal of a contact and a face over which the face
 * makes the points of the contact: a face of the shapes along an edge on edge
 * normal makes none, the single point of the contact staying
 *
 * */
def FACING = 0.95f;

/**
 * The bit of the id of a point cut on an edge of the incident face by a side of
 * the reference face, the id of the other points being their corner
 *
 * */
def CUT = 0x1000u32;

/**
 * Clip the face of b against the face of a along a normal, or the other way
 * when the face of b is the most facing the other shape
 *
 * @params:
 *    - scratch: the buffers the faces are clipped in
 *    - normal: the unit normal from a to b
 *    - speculative: the distance apart down to which the points are kept, of a negative depth
 *
 * @returns:
 *    - 0: the normal of the reference face from a to b, the depths of the points
 *      measured along it; the normal given when no face clips
 *    - 1: the points of the incident face under the reference face, none when
 *      neither face is a polygon facing the other shape along the normal
 *
 * @info: the normal of the reference face is exact where the normal given (of a
 * penetration) is only within the tolerance of its expansion, which would tilt
 * the push of a resting contact a little differently at each step
 *
 * */
pub fn clipped(dmut scratch: &ContactScratch, a: Collider, b: Collider, normal: vec3, speculative: f32)
    -> (vec3, [ContactPoint])
{
    let fa = faces::supportFace(alias scratch, a, normal, false);
    let fb = faces::supportFace(alias scratch, b, -normal, true);
    let alignA = if fa.corners.len >= 3us { fa.normal.dot(normal) } else { -1.0f };
    let alignB = if fb.corners.len >= 3us { -fb.normal.dot(normal) } else { -1.0f };
    if comparison::max(alignA, alignB) < FACING {
        return (normal, []);
    }

    // the reference face is the polygon the most facing the other shape
    if alignB > alignA + 1.0e-3f {
        return (-fb.normal, clipFaces(alias scratch, fb, fa, true, speculative));
    }

    (fa.normal, clipFaces(alias scratch, fa, fb, false, speculative))
}

/**
 * Clip an incident face (a polygon, a segment or a point) by the side planes of
 * a reference face, its corners under the reference plane kept
 *
 * @params:
 *    - scratch: the buffers the polygons are clipped in, from one to the other at each side
 *    - reference: the polygon clipping, of the first shape unless flipped
 *    - incident: the face clipped, of the other shape
 *    - flipped: true when the reference face is of the second shape
 *    - speculative: the distance apart down to which the points are kept, of a negative depth
 *
 * @returns: the points of the incident face under the reference face, four at
 * most (see reduced), their corners on the first shape then on the second, their
 * feature telling the two faces and the corner or the cut; a slice of their own
 *
 * */
pub fn clipFaces(dmut scratch: &ContactScratch, reference: faces::Face, incident: faces::Face, flipped: bool,
                 speculative: f32)-> [ContactPoint] {
    // a side cuts a convex polygon into one more corner at most
    let count = reference.corners.len;
    let room = incident.corners.len + count;
    let dmut polygon = alias scratch:.polygon(false, room);
    let dmut polygonFeatures = alias scratch:.features(false, room);
    let dmut clipped = alias scratch:.polygon(true, room);
    let dmut clippedFeatures = alias scratch:.features(true, room);
    for i in 0us .. incident.corners.len {
        polygon[i] = incident.corners[i];
        polygonFeatures[i] = cast!u32(i);
    }

    let mut centre = vec3();
    for c in reference.corners {
        centre = centre + c;
    }

    centre = centre / cast!f32(cast!u64(count));

    let n = reference.normal;
    let mut len = incident.corners.len;
    let mut inClipped = false;
    for i in 0us .. count {
        let p = reference.corners[i], q = reference.corners[(i + 1us) % count];
        let mut side = (q - p).cross(n);
        if side.dot(side) <= 1.0e-12f {
            continue;
        }

        side = side.normalized();
        if side.dot(centre - p) > 0.0f {
            side = -side;
        }

        if inClipped {
            len = clipBy(clipped, clippedFeatures, len, alias polygon, alias polygonFeatures, side, side.dot(p),
                         cast!u32(i));
        } else {
            len = clipBy(polygon, polygonFeatures, len, alias clipped, alias clippedFeatures, side, side.dot(p),
                         cast!u32(i));
        }

        inClipped = !inClipped;
    }

    let corners = if inClipped { clipped } else { polygon };
    let ids = if inClipped { clippedFeatures } else { polygonFeatures };
    let offset = n.dot(reference.corners[0]);
    let faces = ((reference.index & 0xFFu32) << 24u32) | ((incident.index & 0xFFu32) << 16u32)
              | (if flipped { 0x8000u32 } else { 0u32 });

    let dmut points = alias scratch:.points(len);
    let mut kept = 0us;
    for k in 0us .. len {
        let depth = offset - n.dot(corners[k]);
        if depth < -speculative {
            continue;
        }

        let onReference = corners[k] + n * depth;
        let (onA, onB) = if flipped { (corners[k], onReference) } else { (onReference, corners[k]) };
        points[kept] = ContactPoint(point-> (onA + onB) / 2.0f,
                                    localA-> onA,
                                    localB-> onB,
                                    depth-> depth,
                                    feature-> faces | (ids[k] & 0x7FFFu32));
        kept += 1us;
    }

    if kept > 4us {
        return reduced(points[0us .. kept], n);
    }

    copy points[0us .. kept]
}

/**
 * @returns: four points at most, spread: the deepest, the farthest from it, the
 * one making the largest triangle with them, the one adding the most area on
 * the other side of that triangle
 *
 * */
pub fn reduced(points: [ContactPoint], normal: vec3)-> [ContactPoint] {
    if points.len <= 4us {
        return points;
    }

    let mut i0 = 0us;
    for i in 0us .. points.len if points[i].depth > points[i0].depth {
        i0 = i;
    }

    let p0 = points[i0].point;
    let mut i1 = i0;
    for i in 0us .. points.len if (points[i].point - p0).length() > (points[i1].point - p0).length() {
        i1 = i;
    }

    let p1 = points[i1].point;
    let mut i2 = i0;
    let mut area = 0.0f;
    for i in 0us .. points.len {
        let a = (p1 - p0).cross(points[i].point - p0).dot(normal);
        if math::abs(a) > math::abs(area) {
            area = a;
            i2 = i;
        }
    }

    // the most area added outside one of the edges of the triangle
    let p2 = points[i2].point;
    let s = if area >= 0.0f { -1.0f } else { 1.0f };
    let mut i3 = i0;
    let mut added = 0.0f;
    for i in 0us .. points.len {
        let q = points[i].point;
        let a = comparison::max(s * (p1 - p0).cross(q - p0).dot(normal),
                                comparison::max(s * (p2 - p1).cross(q - p1).dot(normal),
                                                s * (p0 - p2).cross(q - p2).dot(normal)));
        if a > added {
            added = a;
            i3 = i;
        }
    }

    if added > 0.0f {
        return copy [points[i0], points[i1], points[i2], points[i3]];
    }

    copy [points[i0], points[i1], points[i2]]
}

/**
 * Clip a polygon (or a segment, or a point) by a plane, the part behind it,
 * n.dot(p) <= offset, written to another; a point cut on an edge taking the id
 * of the side and of the edge
 *
 * @params:
 *    - corners, ids: the corners of the polygon clipped and their features
 *    - len: the number of corners of the polygon clipped
 *    - outCorners, outIds: where the corners of the part behind the plane are written, one more than len at most
 *
 * @returns: the number of corners of the part behind the plane
 *
 * */
fn clipBy(corners: [vec3], ids: [u32], len: usize, dmut outCorners: [vec3], dmut outIds: [u32], n: vec3,
          offset: f32, side: u32)-> usize {
    if len == 0us {
        return 0us;
    }

    if len == 1us {
        if n.dot(corners[0]) <= offset {
            outCorners[0] = corners[0];
            outIds[0] = ids[0];
            return 1us;
        }

        return 0us;
    }

    if len == 2us {
        return clipSegment(corners, ids, alias outCorners, alias outIds, n, offset, side);
    }

    let mut out = 0us;
    for i in 0us .. len {
        let j = (i + 1us) % len;
        let dp = n.dot(corners[i]) - offset, dq = n.dot(corners[j]) - offset;
        if dp <= 0.0f {
            outCorners[out] = corners[i];
            outIds[out] = ids[i];
            out += 1us;
        }

        if (dp < 0.0f && dq > 0.0f) || (dp > 0.0f && dq < 0.0f) {
            outCorners[out] = cutOf(corners[i], corners[j], dp, dq);
            outIds[out] = cutId(ids[i], side);
            out += 1us;
        }
    }

    out
}

/**
 * Clip a segment by a plane, the part behind it written to another, its ends in their order
 * @returns: the number of ends of the part behind the plane
 * */
fn clipSegment(corners: [vec3], ids: [u32], dmut outCorners: [vec3], dmut outIds: [u32], n: vec3, offset: f32,
               side: u32)-> usize {
    let dp = n.dot(corners[0]) - offset, dq = n.dot(corners[1]) - offset;
    if dp > 0.0f && dq > 0.0f {
        return 0us;
    }

    if dp <= 0.0f && dq <= 0.0f {
        outCorners[0] = corners[0]; outIds[0] = ids[0];
        outCorners[1] = corners[1]; outIds[1] = ids[1];
        return 2us;
    }

    if dp <= 0.0f {
        outCorners[0] = corners[0]; outIds[0] = ids[0];
        outCorners[1] = cutOf(corners[0], corners[1], dp, dq); outIds[1] = cutId(ids[0], side);
        return 2us;
    }

    outCorners[0] = cutOf(corners[0], corners[1], dp, dq); outIds[0] = cutId(ids[0], side);
    outCorners[1] = corners[1]; outIds[1] = ids[1];
    2us
}

/**
 * @returns: the point where an edge crosses a plane, its ends at signed distances dp and dq from it
 * */
fn cutOf(p: vec3, q: vec3, dp: f32, dq: f32)-> vec3 {
    p + (q - p) * (dp / (dp - dq))
}

/**
 * @returns: the id of a point cut on an edge, of the side cutting it and of the corner the edge starts from
 * */
fn cutId(from: u32, side: u32)-> u32 {
    CUT | ((side & 0x3Fu32) << 6u32) | (from & 0x3Fu32)
}
