in joint_settings;

/**
 * What a joint keeps of the motion of its two bodies, one with respect to the other, its frame placed on both
 * */
pub enum JointKind : u32
| FIXED  = 0u32 // the two move as one: six rows, three linear and three angular
| BALL   = 1u32 // a ball and socket: the anchor shared, the bodies turning freely about it, three linear rows
| HINGE  = 2u32 // the anchor shared and the bodies turning about the X axis of the frame only: three linear rows, two angular
| SLIDER = 3u32; // the bodies sliding along the X axis of the frame without turning: two linear rows, three angular

/**
 * How a joint holds its two bodies: its kind, the limits of a hinge or a slider, its motor, when it breaks, and whether
 * the two bodies still touch each other
 *
 * @info: the position of a hinge is the angle its bodies turned by about its axis since it was made, in radians; the
 * position of a slider the distance its second body slid along the axis, in metres (see PhysicsWorld::jointPosition)
 *
 * */
@data
pub record JointSettings {

    // What the joint keeps of the motion of its two bodies
    let mut kind: JointKind = JointKind::BALL;

    // True when the position of a hinge or a slider is kept within [lower, upper]
    let mut limited: bool = false;

    // The lowest position of a hinge (radians, -pi at least) or a slider (metres)
    let mut lower: f32 = 0.0f;

    // The highest position of a hinge (radians, pi at most) or a slider (metres)
    let mut upper: f32 = 0.0f;

    // True when a motor drives a hinge or a slider at motorSpeed
    let mut motor: bool = false;

    // The speed the motor drives the position at, in radians or metres a second
    let mut motorSpeed: f32 = 0.0f;

    // The largest torque (newton metres, a hinge) or force (newtons, a slider) of the motor
    let mut maxMotorForce: f32 = 0.0f;

    // The force the linear rows of the joint hold at most before it breaks, in newtons, 0 never breaking
    let mut breakForce: f32 = 0.0f;

    // The torque the angular rows of the joint hold at most before it breaks, in newton metres, 0 never breaking
    let mut breakTorque: f32 = 0.0f;

    // True when the two bodies still touch each other, false leaving the limbs of a ragdoll free to overlap
    let mut collide: bool = false;
}
