in node3D;

pub mod ::visual;
pub mod ::solid;
pub mod ::camera;
pub mod ::light;
pub mod ::transform;
pub mod ::empty;
pub mod ::icon;
pub mod ::guide;

use balder::math::_;
use balder::core::application::signal;
use balder::scene::node::node3D::{guide, icon};

use std::uuid;

@abstract
pub class Node3D over Node {

    // the position of the node
    let mut _position : vec3 = vec3 ();

    // The rotation of the node
    let mut _rotation : vec3 = vec3 ();

    // The scale of the node
    let mut _scale : vec3 = makeVec3 (1.0f, 1.0f, 1.0f);

    // The transformation matrix of the node
    let mut _transformation : mat4 = mat4 ();

    // Signal emited when the node changed position/rotation/scale
    let dmut _transformationChanged : (&Signal!{()})? = none;

    // The box enclosing the node and its children in world space
    let mut _bounds : Aabb = Aabb ();

    // True when the node or one of its descendants moved, entered or left the tree since _bounds was computed
    let mut _boundsDirty : bool = true;

    // The id of the node in the scene files, kept from one save to the next
    let mut _guid : Uuid = v4 ();

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    prot self (name : [c8], dmut parent : &Node)
        with super (name, alias parent)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @{field, final}
    pub fn position (self)-> vec3 {
        self._position
    }

    /**
     * Change the position of the node in the scene
     * */
    @{final, field}
    pub fn position (mut self, pos : vec3) {
        self._position = pos;
        self:.updateTransformation ();
    }

    @{field, final}
    pub fn rotation (self)-> vec3 {
        self._rotation
    }

    /**
     * Change the rotation of the node in the scene
     * */
    @{final, field}
    pub fn rotation (mut self, rot : vec3) {
        self._rotation = rot;
        self:.updateTransformation ();
    }

    @{field, final}
    pub fn scale (self)-> vec3 {
        self._scale
    }

    /**
     * Change the scale of the node in the scene
     * */
    @{final, field}
    pub fn scale (mut self, scale : vec3) {
        self._scale = scale;
        self:.updateTransformation ();
    }

    /**
     * Change the position, the rotation and the scale of the node at once, its transformation computed once
     * */
    @final
    pub fn setTransform (mut self, pos : vec3, rot : vec3, scale : vec3) {
        self._position = pos;
        self._rotation = rot;
        self._scale = scale;
        self:.updateTransformation ();
    }

    /**
     * @returns: the id of the node in the scene files: a new one for a node created, the one of its description for a
     * node built from a scene file (see NodeDescription), kept from one save of the scene to the next
     * */
    @{field, final}
    pub fn guid (self)-> Uuid {
        self._guid
    }

    /**
     * Change the id of the node in the scene files, the id a scene file gives it
     * */
    @{field, final}
    pub fn guid (mut self, id : Uuid) {
        self._guid = id;
    }

    /**
     * @returns: the transformation matrix of the object
     * */
    @{field, final}
    pub fn transformation (self)-> mat4 {
        self._transformation
    }

    /**
     * @returns: the transformation matrix of the parent of the node, the identity when the parent is not a 3D node
     * @info: the transformation of the node is the one of its parent times translation (position) * rotationX
     * (rotation.x) * rotationY (rotation.y) * rotationZ (rotation.z) * scaling (scale)
     * */
    @{field, final}
    pub fn parentTransformation (self)-> mat4 {
        if let Ok (parent : &Node3D) = self._parent {
            return parent._transformation;
        }

        mat4 ()
    }

    /**
     * @returns: the box enclosing the node and its children in world space, empty when none of them has a volume
     * @info: computed when read after a change only
     * */
    @final
    pub fn bounds (mut self)-> Aabb {
        if self._boundsDirty {
            let mut bounds = self:.computeOwnBounds ();
            for _, dmut t in alias self._childs if let dmut c : &Node3D = alias t {
                bounds = bounds.merged (c:.bounds ());
            }

            self._bounds = bounds;
            self._boundsDirty = false;
        }

        self._bounds
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          EDITOR          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the glyph an editor draws the node as over the image of the scene, the node being picked by it: the icon
     * of a node without geometry (a light, a camera, an empty...), none for a node seen by its geometry
     * @info: a class of nodes without geometry gives its icon by overriding this method (see NodeIcons)
     * */
    pub fn editorIcon(self)-> (NodeIcon)? {
        none
    }

    /**
     * @returns: the lines an editor draws the node with while it is selected, in world space, telling its shape (the
     * range of a light, the frustum of a camera...), none by default
     * @params:
     *    - size: the length in world units covering a span of the image at the origin of the node, for the lines to
     *            keep a size on the image wherever the node is (the arrows of a direction light)
     * */
    pub fn editorGuides(self, _: f32)-> [NodeGuide] {
        []
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Connect the signal emitted when the node changed position/rotation/scale
     * */
    pub fn transformationChanged (mut self)-> dmut &Signal!{()} {
        if let Ok (dmut t) = alias self._transformationChanged {
            return alias t;
        }

        let dmut sig = copy Signal!{()} ();
        self._transformationChanged = (alias sig)?;

        alias sig
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          TREE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over onTreeEnter (mut self, dmut who : &Node) {
        self._boundsDirty = true;
        self._super:.onTreeEnter (alias who);
    }

    over onTreeExit (mut self, dmut who : &Node) {
        self._boundsDirty = true;
        self._super:.onTreeExit (alias who);
    }

    /**
     * The node moved under another parent computes its transformation under it, the bounds of the parent it left and of
     * the one it went under being computed again
     * */
    prot over onMoved (mut self, dmut from : &Node) {
        if let dmut f : &Node3D = alias from {
            f:.invalidateBounds ();
        }

        // the node may be marked already, its new parent not
        if let Ok (dmut p : &Node3D) = alias self._parent {
            p:.invalidateBounds ();
        }

        self:.updateTransformation ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPUTATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Update the transformation matrix of the node
     * */
    fn updateTransformation (mut self) {
        // scaled along its own axes, then turned, then moved: the scale never shears the rotation, nor the position
        self._transformation = math::utils::translation (self._position);
        self._transformation *= math::utils::rotationX (self._rotation.x);
        self._transformation *= math::utils::rotationY (self._rotation.y);
        self._transformation *= math::utils::rotationZ (self._rotation.z);
        self._transformation *= math::utils::scaling (self._scale);

        if let Ok (dmut parent : &Node3D) = alias self._parent {
            self._transformation = parent._transformation * self._transformation;
        }
        
        for _, dmut t in alias self._childs if let dmut c : &Node3D = alias t {
            c:.updateTransformation ();
        }

        self:.invalidateBounds ();
        if let Ok (dmut t) = alias self._transformationChanged {            
            t:.emit ();
        }
    }

    /**
     * @returns: the box enclosing the volume of the node itself in world space, its children aside
     * */
    fn computeOwnBounds (mut self)-> Aabb {
        Aabb ()
    }

    /**
     * Mark the bounds of the node and of its ancestors to be computed again
     * @info: an ancestor of a node whose bounds are to be computed has its bounds to be computed too, so the walk stops
     * at the first node already marked
     * */
    fn invalidateBounds (mut self) {
        if self._boundsDirty { return; }

        self._boundsDirty = true;
        if let Ok (dmut parent : &Node3D) = alias self._parent {
            parent:.invalidateBounds ();
        }
    }

}
