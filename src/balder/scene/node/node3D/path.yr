in path;

use balder::math::{curve, vector};
use balder::scene::node::node3D::{guide, icon, path_point};

/**
 * The number of segments drawing each span of the curve of a path in an editor
 * */
def WIRE_SUBDIVISIONS = 8us;

/**
 * A curve through points, Catmull-Rom or Bézier, open or closed, sampled by the distance along it: the path of a camera
 * on rails, of a patrol, of a moving platform
 * @info:
 * =====
 * The points of the path are the PathPoint3D under it, in their order (see Node::getChildrenInOrder), the other nodes
 * under it left out: moved, turned and scaled as nodes, the curve follows them. A Catmull-Rom curve goes through the
 * points, each one turned toward its neighbours; a Bézier curve leaves each point along its X axis, as long as its
 * scale along X makes it (see PathPoint3D::worldHandle). The curve is in the world, built from the points each time it
 * is read (see curve): the game keeps the Curve while the points stay where they are.
 * An editor draws the curve at all times, with the handles of the points of a Bézier path, fainter.
 * ====
 * */
pub class Path3D over Node3D {

    // How the curve goes from a point to the next
    let mut _curveKind: CurveKind = CurveKind::CATMULL_ROM;

    // True iif the curve goes back from its last point to its first
    let mut _closed: bool = false;

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the path is attached to
     *    - curveKind: how the curve goes from a point to the next
     *    - closed: true for a curve going back from its last point to its first
     * */
    pub self (name: [c8], dmut parent: &Node, curveKind: CurveKind = CurveKind::CATMULL_ROM, closed: bool = false)
        with super(name, alias parent)
        , _curveKind = curveKind
        , _closed = closed
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: how the curve goes from a point to the next
     * */
    @field
    pub fn curveKind(self)-> CurveKind {
        self._curveKind
    }

    /**
     * Change how the curve goes from a point to the next
     * */
    @field
    pub fn curveKind(mut self, kind: CurveKind) {
        self._curveKind = kind;
    }

    /**
     * @returns: true iif the curve goes back from its last point to its first
     * */
    @field
    pub fn closed(self)-> bool {
        self._closed
    }

    /**
     * Close the curve, going back from its last point to its first, or open it
     * */
    @field
    pub fn closed(mut self, closed: bool) {
        self._closed = closed;
    }

    /**
     * @returns: the points of the path, the PathPoint3D under it, in their order
     * */
    pub fn points(self)-> [&PathPoint3D] {
        let mut points: [&PathPoint3D] = [];
        for c in self._order if let p: &PathPoint3D = c {
            points ~= [p];
        }

        points
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CURVE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the curve through the points in the world, as they stand
     * @params:
     *    - subdivisions: the number of segments sampling each span between two points
     * */
    pub fn curve(self, subdivisions: usize = CURVE_SUBDIVISIONS)-> Curve {
        let mut positions: [vec3] = [], mut handles: [vec3] = [];
        for p in self.points() {
            positions ~= [p.worldPosition];
            handles ~= [p.worldHandle];
        }

        Curve(self._curveKind, positions, handles-> handles, closed-> self._closed, subdivisions-> subdivisions)
    }

    /**
     * @returns: the length of the curve in the world
     * */
    pub fn length(self)-> f32 {
        self.curve().length
    }

    /**
     * @returns: the point of the curve in the world at a distance along it from its first point (see Curve::pointAt)
     * */
    pub fn pointAt(self, distance: f32)-> vec3 {
        self.curve().pointAt(distance)
    }

    /**
     * @returns: the unit direction the curve goes along in the world at a distance along it from its first point, none
     * when it has no length (see Curve::directionAt)
     * */
    pub fn directionAt(self, distance: f32)-> (vec3)? {
        self.curve().directionAt(distance)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          EDITOR          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the glyph of a path, a curve between two points
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        NodeIcon::path()?
    }

    /**
     * @returns: the curve of the path, and the handles of the points of a Bézier path, fainter
     * */
    pub over editorWires(self)-> [NodeGuide] {
        let samples = self.curve(subdivisions-> WIRE_SUBDIVISIONS).samples;
        let mut lines: [NodeGuide] = [];
        for k in 1us .. samples.len {
            lines ~= [NodeGuide(from-> samples[k - 1us], to-> samples[k])];
        }

        if self._curveKind == CurveKind::BEZIER {
            for p in self.points() {
                let at = p.worldPosition, handle = p.worldHandle;
                lines ~= [NodeGuide(from-> at - handle, to-> at + handle, faint-> true)];
            }
        }

        lines
    }

}
