in empty;

use balder::scene::node::node3D::icon;

/**
 * A 3D node drawing nothing, only placing the nodes under it: moved, turned and scaled, it moves, turns and scales them
 * as a whole (an empty)
 * */
pub class Empty3D over Node3D {

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the empty is attached to
     * */
    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

    /**
     * @returns: the glyph of an empty, three axes from its origin, the empty having no geometry of its own
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        NodeIcon::empty()?
    }

}
