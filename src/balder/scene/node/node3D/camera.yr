in camera;

mod ::persp;
mod ::ortho;
mod ::debug_view;
mod ::projection;
pub mod ::flight;

use balder::math::_;
use balder::core::dispose;
use balder::core::shader::buffers::ubo;
use balder::scene::node::node3D::{guide, icon};
use balder::scene::property::{choice_property, condition, group, node_schema, range, typed_property};
use balder::utils::log;

pub def PerspectiveCamera: persp::PerspectiveCamera;
pub def OrthoCamera: ortho::OrthoCamera;
pub def DebugView: debug_view::DebugView;
pub def CameraProjection: projection::CameraProjection;

/**
 * The offset of the exposure in the uniform buffer of a camera, after its projection, its view, their product and its
 * position (the Camera block of the shaders)
 * */
def EXPOSURE_OFFSET = (mat4::size * 3) + vec3::size;

/**
 * The offset of the view-projection of the frame before in the uniform buffer of a camera, after its exposure
 * */
def PREV_VIEWPROJ_OFFSET = EXPOSURE_OFFSET + f32::size;

/**
 * The offset of the debug view in the uniform buffer of a camera, after the view-projection of the frame before
 * */
def DEBUG_VIEW_OFFSET = PREV_VIEWPROJ_OFFSET + mat4::size;

/**
 * The size of the uniform buffer of a camera
 * */
pub def CAMERA_SIZE = DEBUG_VIEW_OFFSET + u32::size;

/**
 * Ancestor class of all cameras
 * @info: a camera looks along the -Z axis of its node, the +Y axis toward the top of its image, its view following the
 * rotation of its node and the transforms of its parents (see transformation); target turns the node toward a point
 * */
@abstract
pub class Camera over Node3D {

    // The distance from the camera to the point it was turned toward last (see target), in the space of its parent
    let mut _aim: f32 = 1.0f;

    // The up of the camera
    let mut _up: vec3 = makeVec3(0.0f, 1.0f, 0.0f);

    // The position of the camera in world space, the eye its view looks from
    let mut _eye: vec3 = vec3();

    let mut _near: f32 = 0.1f;
    let mut _far: f32  = 100.0f;

    // The exposure of the camera, in stops: the light it sees is scaled by 2^exposure before being tone mapped
    let mut _exposure: f32 = 0.0f;

    // What the g-buffer shows instead of the materials
    let mut _debugView: DebugView = DebugView::NONE;

    let mut _proj: mat4     = mat4();
    let mut _view: mat4     = mat4();
    let mut _viewProj: mat4 = mat4();

    // The offset of the projection drawing the frames, in normalized device coordinates (see jitter)
    let mut _jitter: vec2 = makeVec2(0.0f, 0.0f);

    // The view-projection the last frame submitted drew with, none before the first one
    let mut _frameViewProj: mat4? = none;

    // The volume seen by the camera, in world space
    let mut _frustum: Frustum = Frustum();

    // The uniform buffer object containing the matrices of the camera
    let dmut _ubo: (&UniformBufferObject)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {
        // looking at the origin, as target would turn it
        self._position = makeVec3(-10.0f, 10.0f, -10.0f);
        self._aim = self._position.length();
        self._orientation = facing(self._position.normalized(), self._up);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the point the camera looks at, in the space of its parent: the point it was turned toward last, moved
     * with it, and turned with it since (see target)
     * */
    @field
    pub fn target(self)-> vec3 {
        self._position + (self._orientation * makeVec3(0.0f, 0.0f, -1.0f)) * self._aim
    }

    /**
     * Turn the camera toward a point from where it stands, in the space of its parent, its top toward its up (see up)
     * @info: the rotation of its node changes, the camera keeping it when it moves afterwards; a point where the camera
     * stands changes nothing
     * */
    @field
    pub fn target(mut self, v: vec3) {
        let away = self._position - v;
        let distance = away.length();
        if distance == 0.0f { return; }

        self._aim = distance;
        self.orientation = facing(away / distance, self._up);
    }

    /**
     * @returns: the direction the top of the image of the camera goes toward when it is turned toward a point (see
     * target), in the space of its parent
     * */
    @field
    pub fn up(self)-> vec3 {
        self._up
    }

    @field
    pub fn up(mut self, v: vec3) {
        self._up = v;
    }

    /**
     * @returns: the position of the camera in world space, the eye its view looks from
     * */
    @field
    pub fn eye(self)-> vec3 {
        self._eye
    }

    /**
     * @returns: how the camera projects what it sees on its image, its class telling it
     * */
    pub fn projection(self)-> CameraProjection;

    @field
    pub fn near(self)-> f32 {
        self._near
    }

    @field
    pub fn near(mut self, near: f32) {
        self._near = near;
        self:.updateView();
    }

    @field
    pub fn far(self)-> f32 {
        self._far
    }

    @field
    pub fn far(mut self, far: f32) {
        self._far = far;
        self:.updateView();
    }

    /**
     * @returns: the exposure of the camera, in stops
     * */
    @field
    pub fn exposure(self)-> f32 {
        self._exposure
    }

    /**
     * Set the exposure of the camera, in stops (EV): the light it sees is scaled by 2^exposure before being tone mapped,
     * each stop doubling it, 0 leaving it as the lights give it
     * */
    @field
    pub fn exposure(mut self, ev: f32) {
        atomic self {
            self._exposure = ev;
            if let Ok(dmut u) = alias self._ubo {
                u:.setData(EXPOSURE_OFFSET, ev);
            }
        }
    }

    /**
     * @returns: what the g-buffer shows instead of the materials
     * */
    @field
    pub fn debugView(self)-> DebugView {
        self._debugView
    }

    /**
     * Show the triangles, the clusters or the levels of detail drawn in flat colours instead of the materials, or the
     * materials again (DebugView::NONE)
     * */
    @field
    pub fn debugView(mut self, view: DebugView) {
        atomic self {
            self._debugView = view;
            if let Ok(dmut u) = alias self._ubo {
                let word: u32 = view;
                u:.setData(DEBUG_VIEW_OFFSET, word);
            }
        }
    }

    /**
     * @returns: the projection multiplied by the view, from world space to clip space
     * */
    @field
    pub fn viewProj(self)-> mat4 {
        self._viewProj
    }

    /**
     * @returns: the volume seen by the camera, in world space
     * */
    @field
    pub fn frustum(self)-> Frustum {
        self._frustum
    }

    /**
     * @returns: the projection of the camera, without its jitter
     * */
    @field
    pub fn proj(self)-> mat4 {
        self._proj
    }

    /**
     * @returns: the offset of the projection drawing the frames, in normalized device coordinates
     * */
    @field
    pub fn jitter(self)-> vec2 {
        self._jitter
    }

    /**
     * Offset the projection the frames are drawn with by a fraction of a pixel, in normalized device coordinates (2 / the
     * width of the image is a pixel along x), the samples of the frames covering each pixel (a temporal anti-aliasing)
     * @info: written for the frame being submitted, without requesting another one (see Window::connectFrameSubmit); the
     * view-projection, culling the instances and moving them between the frames, stays unjittered
     * */
    pub fn setJitter(mut self, offset: vec2) {
        atomic self {
            self._jitter = offset;
            if let Ok(dmut u) = alias self._ubo {
                u:.setFrameData(0us, jittered(self._proj, offset));
            }
        }
    }

    /**
     * Write the view-projection of the frame before in the uniform buffer, for the frame being submitted, the motion of
     * the camera between the two; the frame submitted is the frame before of the next one
     * @info: called while the frame is submitted (see Window::connectFrameSubmit), the first frame moving nothing
     * */
    pub fn advanceFrame(mut self) {
        atomic self {
            let previous = self._frameViewProj ?? self._viewProj;
            if let Ok(dmut u) = alias self._ubo {
                u:.setFrameData(PREV_VIEWPROJ_OFFSET, previous);
            }

            self._frameViewProj = self._viewProj?;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPUTATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The transformation of the node computed, then the view and the projection of the camera, written in its uniform
     * buffer
     * */
    over updateTransformation(mut self) {
        self.__super__:.updateTransformation();
        self:.updateView();
    }

    /**
     * Compute the view and the projection of the camera again, writing them in its uniform buffer
     * @info: the setters of the projection (fov, near, far...) call it, the transformation of the node unchanged
     * */
    prot fn updateView(mut self) {
        atomic self {
            self:.computeView();
            self:.computeProj();

            self._viewProj = self._proj * self._view;
            self._frustum = Frustum(self._viewProj);
            if let Ok(dmut u) = alias self._ubo {
                u:.setData(0, jittered(self._proj, self._jitter));
                u:.setData(mat4::size, self._view);
                u:.setData(2 * mat4::size, self._viewProj);
                u:.setData(3 * mat4::size, self._eye);
                u:.setData(EXPOSURE_OFFSET, self._exposure);

                let word: u32 = self._debugView;
                u:.setData(DEBUG_VIEW_OFFSET, word);
            }
        }
    }

    /**
     * Compute the view matrix from the transformation of the node, its scale left out: the inverse of its rotation and
     * its position, turned half a turn around Z, the image mirroring X and its rows going down (as lookAt gives it)
     * */
    fn computeView(mut self) {
        let w = self._transformation;
        let x = makeVec3(w.a1, w.b1, w.c1).normalized();
        let y = makeVec3(w.a2, w.b2, w.c2).normalized();
        let z = makeVec3(w.a3, w.b3, w.c3).normalized();
        let eye = makeVec3(w.a4, w.b4, w.c4);

        self._eye = eye;
        self._view = makeMat4(a1-> -x.x, a2-> -x.y, a3-> -x.z, a4-> x.dot(eye),
                              b1-> -y.x, b2-> -y.y, b3-> -y.z, b4-> y.dot(eye),
                              c1-> z.x, c2-> z.y, c3-> z.z, c4-> -z.dot(eye),
                              d1-> 0.0f, d2-> 0.0f, d3-> 0.0f, d4-> 1.0f);
    }

    /**
     * Compute the projection matrix
     * */
    fn computeProj(mut self);

    /**
     * @returns: the fraction of the height of the view covered by a length seen at a position
     * @params:
     *    - position: the position of the length, in world space
     *    - size: the length, in world units
     * */
    pub fn screenSize(self, position: vec3, size: f32)-> f32;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          EDITOR          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the glyph of a camera, its body and its lens
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        NodeIcon::camera()?
    }

    /**
     * @returns: the frustum of the camera, the volume it sees from its near plane to its far plane: the edges of the two
     * planes and the four lines joining their corners
     * */
    pub over editorGuides(self, _: f32)-> [NodeGuide] {
        let inverse = self._viewProj.inversed();
        let mut near: [vec3] = [];
        let mut far: [vec3] = [];
        for corner in copy [makeVec2(-1.0f, -1.0f), makeVec2(1.0f, -1.0f), makeVec2(1.0f, 1.0f), makeVec2(-1.0f, 1.0f)] {
            let n = inverse * makeVec4(corner, -1.0f, 1.0f);
            let f = inverse * makeVec4(corner, 1.0f, 1.0f);
            near ~= [n.xyz / n.w];
            far ~= [f.xyz / f.w];
        }

        let mut lines: [NodeGuide] = [];
        for i in 0us .. 4us {
            let j = (i + 1us) % 4us;
            lines ~= [NodeGuide(from-> near[i], to-> near[j]),
                      NodeGuide(from-> far[i], to-> far[j]),
                      NodeGuide(from-> near[i], to-> far[i])];
        }

        lines
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onEnter(mut self, dmut scene: &Scene) {
        if let Ok(dmut ubo) = alias self._ubo {
            scene:.getWindow():.retire(alias ubo);
        }

        {
            let dmut ubo = copy UniformBufferObject(scene:.getWindow():.getVulkanDevice(), CAMERA_SIZE);
            self._ubo = (alias ubo)?;
            self._frameViewProj = none;
        } catch {
            err => {
                log::error #("Camera", "Failed to allocate ubo for the camera", err);
            }
        }
    }

    pub over onExit(mut self, dmut scene: &Scene) {
        log::debug #("Camera", "onExit");
        if let Ok(dmut ubo) = alias self._ubo {
            scene:.getWindow():.retire(alias ubo);
            self._ubo = none;
        }
    }

    /**
     * @returns: the uniform buffer object of the camera
     * */
    pub fn getUBO(mut self)-> dmut(&UniformBufferObject)? {
        alias self._ubo
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DISPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            self.__super__:.dispose();
            if self._ubo.hasValue {
                log::error #("Camera", "Forgot to remove camera from the scene before disposing it");
            }
        }
    }
}


/**
 * The properties of the cameras
 * */
pub mod Camera {

    /**
     * The group of the properties of a camera, its section of the inspector
     * */
    pub def GROUP = "Camera";

    /**
     * @returns: the schema of the cameras: their projection, given at the creation of a camera, the field of view of a
     * perspective camera, in degrees, or the height of the view of an orthographic one, the planes they see between, and
     * whether they are the active camera of their scene, one camera of a scene file at most
     * */
    pub fn schema()-> &NodeSchema {
        copy NodeSchema("camera", groups-> copy [PropertyGroup(name-> GROUP)], properties-> copy [
            copy ChoiceProperty!{&Camera, CameraProjection}("projection", CameraProjection::PERSPECTIVE,
                                                            copy [("perspective", "Perspective", CameraProjection::PERSPECTIVE),
                                                                  ("orthographic", "Orthographic", CameraProjection::ORTHOGRAPHIC)],
                                                            |dmut c| => c.projection(), label-> "Projection", group-> GROUP),
            copy Property!{&Camera, f32}("fov", 90.0f, |dmut c| => fovOf(c), set-> (|dmut c, f| => { setFov(alias c, f); })?,
                                         check-> (|_, f| => { checkFov(f) })?,
                                         label-> "Field of view (degrees)", group-> GROUP,
                                         when-> (Condition(property-> "projection", choices-> copy ["perspective"]))?,
                                         range-> NumberRange(min-> 1.0f, max-> 179.0f, step-> 0.5f, decimals-> 1u32)),
            copy Property!{&Camera, f32}("size", 10.0f, |dmut c| => sizeOf(c), set-> (|dmut c, h| => { setSize(alias c, h); })?,
                                         check-> (|_, h| => { if h <= 0.0f { "The view of an orthographic camera must have a height" } else { "" } })?,
                                         label-> "Height of the view", group-> GROUP,
                                         when-> (Condition(property-> "projection", choices-> copy ["orthographic"]))?,
                                         range-> NumberRange(min-> 0.1f, max-> 100000.0f, step-> 0.1f, decimals-> 2u32)),
            copy Property!{&Camera, f32}("near", 0.1f, |dmut c| => c.near, set-> (|dmut c, n| => { c.near = n; })?,
                                         check-> (|c, n| => { checkPlanes(n, c.far) })?,
                                         label-> "Near plane", group-> GROUP,
                                         range-> NumberRange(min-> 0.01f, max-> 100000.0f, step-> 0.01f, decimals-> 2u32)),
            copy Property!{&Camera, f32}("far", 100.0f, |dmut c| => c.far, set-> (|dmut c, f| => { c.far = f; })?,
                                         check-> (|c, f| => { checkPlanes(c.near, f) })?,
                                         label-> "Far plane", group-> GROUP,
                                         range-> NumberRange(min-> 1.0f, max-> 1000000.0f, step-> 1.0f, decimals-> 1u32)),
            copy Property!{&Camera, bool}("active", false, |dmut c| => isActive(alias c),
                                          set-> (|dmut c, a| => { if a { activate(alias c); } })?,
                                          label-> "Active, the game seen through it", group-> GROUP, unique-> true)
        ])
    }

    /**
     * @returns: the field of view of a perspective camera, the default of the schema for an orthographic one
     * */
    pub fn fovOf(cam: &Camera)-> f32 {
        if let p: &PerspectiveCamera = cam { p.fov } else { 90.0f }
    }

    /**
     * Give a perspective camera a field of view, an orthographic one keeping its view
     * */
    pub fn setFov(dmut cam: &Camera, fov: f32) {
        if let dmut p: &PerspectiveCamera = alias cam { p.fov = fov; }
    }

    /**
     * @returns: the height of the view of an orthographic camera, the default of the schema for a perspective one
     * */
    pub fn sizeOf(cam: &Camera)-> f32 {
        if let o: &OrthoCamera = cam { o.size } else { 10.0f }
    }

    /**
     * Give an orthographic camera the height of its view, a perspective one keeping its field of view
     * */
    pub fn setSize(dmut cam: &Camera, size: f32) {
        if let dmut o: &OrthoCamera = alias cam { o.size = size; }
    }

    /**
     * @returns: why a camera refuses a field of view, not between 0 and 180 degrees, empty when it takes it
     * */
    pub fn checkFov(fov: f32)-> [c8] {
        if fov <= 0.0f || fov >= 180.0f { "The field of view of a camera must be between 0 and 180 degrees" } else { "" }
    }

    /**
     * @returns: why a camera refuses its planes, the near one not in front of it or the far one not past the near one,
     * empty when it takes them
     * */
    pub fn checkPlanes(near: f32, far: f32)-> [c8] {
        if near <= 0.0f { return "The near plane of a camera must be in front of it"; }
        if far <= near { return "The far plane of a camera must be past its near plane"; }
        ""
    }

    /**
     * @returns: true iif a camera is the active camera of its scene
     * */
    pub fn isActive(dmut cam: &Camera)-> bool {
        if let Ok(dmut scene) = alias cam:.getScene() {
            if let Ok(a) = scene:.getActiveCamera() { return a is cam; }
        }

        false
    }

    /**
     * Make a camera the active camera of its scene
     * */
    pub fn activate(dmut cam: &Camera) {
        if let Ok(dmut scene) = alias cam:.getScene() { scene:.setActiveCamera(alias cam); }
    }

}

/**
 * @returns: the rotation of a camera looking along -back, its top toward up as far as it can, the camera rolled by
 * nothing; looking straight along up, its top is toward -Z
 * @params:
 *    - back: the direction from the point looked at to the camera, of unit length
 *    - up: the direction the top of the image goes toward
 * */
pub fn facing(back: vec3, up: vec3)-> Quaternion {
    let mut right = up.cross(back);
    if right.length() < 1.0e-6f {
        right = makeVec3(0.0f, 0.0f, -1.0f).cross(back);
        if right.length() < 1.0e-6f { right = makeVec3(1.0f, 0.0f, 0.0f); }
    }

    let x = right.normalized();
    let y = back.cross(x);
    Quaternion::fromRotation(mat4(a1-> x.x, b1-> x.y, c1-> x.z,
                                  a2-> y.x, b2-> y.y, c2-> y.z,
                                  a3-> back.x, b3-> back.y, c3-> back.z))
}

/**
 * @returns: a projection whose clip space is offset in normalized device coordinates, whatever the projection
 * (perspective or orthographic): x and y move by offset times w
 * */
pub fn jittered(proj: mat4, offset: vec2)-> mat4 {
    mat4(a4-> offset.x, b4-> offset.y) * proj
}
