in camera;

mod ::persp;
mod ::ortho;

use balder::math::_;
use balder::core::dispose;
use balder::core::shader::buffers::ubo;
use balder::utils::log;

pub def PerspectiveCamera: persp::PerspectiveCamera;
pub def OrthoCamera      : ortho::OrthoCamera;

/**
 * The offset of the exposure in the uniform buffer of a camera, after its projection, its view, their product and its
 * position (the Camera block of the shaders)
 * */
def EXPOSURE_OFFSET = (mat4::size * 3) + vec3::size;

/**
 * The offset of the view-projection of the frame before in the uniform buffer of a camera, after its exposure
 * */
def PREV_VIEWPROJ_OFFSET = EXPOSURE_OFFSET + f32::size;

/**
 * The size of the uniform buffer of a camera
 * */
pub def CAMERA_SIZE = PREV_VIEWPROJ_OFFSET + mat4::size;

/**
 * Ancestor class of all cameras
 * */
@abstract
pub class Camera over Node3D {

    // The target of the camera
    let mut _target: vec3 = makeVec3(0.0f, 0.0f, 0.0f);

    let mut _near: f32 = 0.1f;
    let mut _far: f32  = 100.0f;

    // The exposure of the camera, in stops: the light it sees is scaled by 2^exposure before being tone mapped
    let mut _exposure: f32 = 0.0f;

    let mut _proj: mat4     = mat4();
    let mut _view: mat4     = mat4();
    let mut _viewProj: mat4 = mat4();

    // The view-projection the last frame submitted drew with, none before the first one
    let mut _frameViewProj: mat4? = none;

    // The volume seen by the camera, in world space
    let mut _frustum: Frustum = Frustum();

    // The uniform buffer object containing the matrices of the camera
    let dmut _ubo: (&UniformBufferObject)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {
        self._position = makeVec3(-10.0f, 10.0f, -10.0f);
        self._rotation = makeVec3(0.0f, 1.0f, 0.0f);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn target(self)-> vec3 {
        self._target
    }

    @field
    pub fn target(mut self, v: vec3) {
        self._target = v;
        self:.updateTransformation();
    }

    @field
    pub fn near(self)-> f32 {
        self._near
    }

    @field
    pub fn near(mut self, near: f32) {
        self._near = near;
        self:.updateTransformation();
    }

    @field
    pub fn far(self)-> f32 {
        self._far
    }

    @field
    pub fn far(mut self, far: f32) {
        self._far = far;
        self:.updateTransformation();
    }

    /**
     * @returns: the exposure of the camera, in stops
     * */
    @field
    pub fn exposure(self)-> f32 {
        self._exposure
    }

    /**
     * Set the exposure of the camera, in stops (EV): the light it sees is scaled by 2^exposure before being tone mapped,
     * each stop doubling it, 0 leaving it as the lights give it
     * */
    @field
    pub fn exposure(mut self, ev: f32) {
        atomic self {
            self._exposure = ev;
            if let Ok(dmut u) = alias self._ubo {
                u:.setData(EXPOSURE_OFFSET, ev);
            }
        }
    }

    /**
     * @returns: the projection multiplied by the view, from world space to clip space
     * */
    @field
    pub fn viewProj(self)-> mat4 {
        self._viewProj
    }

    /**
     * @returns: the volume seen by the camera, in world space
     * */
    @field
    pub fn frustum(self)-> Frustum {
        self._frustum
    }

    /**
     * Write the view-projection of the frame before in the uniform buffer, for the frame being submitted, the motion of
     * the camera between the two; the frame submitted is the frame before of the next one
     * @info: called while the frame is submitted (see Window::connectFrameSubmit), the first frame moving nothing
     * */
    pub fn advanceFrame(mut self) {
        atomic self {
            let previous = self._frameViewProj ?? self._viewProj;
            if let Ok(dmut u) = alias self._ubo {
                u:.setFrameData(PREV_VIEWPROJ_OFFSET, previous);
            }

            self._frameViewProj = self._viewProj?;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPUTATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over updateTransformation(mut self) {
        atomic self {
            self:.computeView();
            self:.computeProj();

            self._viewProj = self._proj * self._view;
            self._frustum = Frustum(self._viewProj);
            if let Ok(dmut u) = alias self._ubo {
                u:.setData(0, self._proj);
                u:.setData(mat4::size, self._view);
                u:.setData(2 * mat4::size, self._viewProj);
                u:.setData(3 * mat4::size, self._position);
                u:.setData(EXPOSURE_OFFSET, self._exposure);
            }
        }
    }

    /**
     * Compute the view matrix
     * */
    fn computeView(mut self) {
        self._view = lookAt!{f32} (self._position, self._target, self._rotation);
    }

    /**
     * Compute the projection matrix
     * */
    fn computeProj(mut self);

    /**
     * @returns: the fraction of the height of the view covered by a length seen at a position
     * @params:
     *    - position: the position of the length, in world space
     *    - size: the length, in world units
     * */
    pub fn screenSize(self, position: vec3, size: f32)-> f32;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onEnter(mut self, dmut scene: &Scene) {
        if let Ok(dmut ubo) = alias self._ubo {
            scene:.getWindow():.retire(alias ubo);
        }

        {
            let dmut ubo = copy UniformBufferObject(scene:.getWindow():.getVulkanDevice(), CAMERA_SIZE);
            self._ubo = (alias ubo)?;
            self._frameViewProj = none;
        } catch {
            err => {
                log::error #("Camera", "Failed to allocate ubo for the camera", err);
            }
        }
    }

    pub over onExit(mut self, dmut scene: &Scene) {
        log::debug #("Camera", "onExit");
        if let Ok(dmut ubo) = alias self._ubo {
            scene:.getWindow():.retire(alias ubo);
            self._ubo = none;
        }
    }

    /**
     * @returns: the uniform buffer object of the camera
     * */
    pub fn getUBO(mut self)-> dmut (&UniformBufferObject)? {
        alias self._ubo
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DISPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            if self._ubo.hasValue {
                log::error #("Camera", "Forgot to remove camera from the scene before disposing it");
            }
        }
    }
}
