in transform;

use balder::math::{matrix, utils, vector};

/**
 * The position, the rotation and the scale of a 3D node, as its setters take them (see Node3D::position, rotation and
 * scale)
 * */
pub record NodeTransform {

    // The position of the node, in the space of its parent
    pub let position: vec3;

    // The angles of the rotation of the node along the X, the Y and the Z axes, in radian
    pub let rotation: vec3;

    // The scale of the node along its own axes
    pub let scale: vec3;

    /**
     * The transform of a node as it stands
     * */
    pub self (node: &Node3D)
        with position = node.position
        , rotation = node.rotation
        , scale = node.scale
    {}

    pub self (position: vec3, rotation: vec3, scale: vec3)
        with position = position
        , rotation = rotation
        , scale = scale
    {}

    /**
     * The transform of a transformation in the space of the parent, translation (position) * the rotation along X, Y
     * then Z * scaling (scale), as a 3D node composes it (see Node3D::parentTransformation)
     * @params:
     *    - local: the transformation, in the space of the parent
     * @info: a transformation a transform cannot give, sheared (a node turned under a parent scaled unevenly), gets the
     * scale of the lengths of its axes, and the rotation of their directions; a transformation mirroring the space has
     * its X axis scaled by a negative factor
     * */
    pub self (local: mat4)
        with position = makeVec3(local.a4, local.b4, local.c4)
        , rotation = eulerAngles(axesRotation(local))
        , scale = axesScale(local)
    {}

    /**
     * The transform giving a node under a parent the transformation it has in the world, the one a node keeps when it
     * moves under that parent (see Node::moveUnder)
     * @params:
     *    - world: the transformation the node keeps, in the world (see Node3D::transformation)
     *    - parent: the transformation of the parent in the world, the identity for a parent that is not a 3D node
     * */
    pub self inParent(world: mat4, parent: mat4)
        with self(parent.inversed() * world)
    {}

    /**
     * Give the transform to a node, its transformation computed once (see Node3D::setTransform)
     * */
    pub fn applyTo(self, dmut node: &Node3D) {
        node:.setTransform(self.position, self.rotation, self.scale);
    }

}
