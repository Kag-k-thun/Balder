in transform;

use balder::math::vector;

/**
 * The position, the rotation and the scale of a 3D node, as its setters take them (see Node3D::position, rotation and
 * scale)
 * */
pub record NodeTransform {

    // The position of the node, in the space of its parent
    pub let position: vec3;

    // The angles of the rotation of the node along the X, the Y and the Z axes, in radian
    pub let rotation: vec3;

    // The scale of the node along its own axes
    pub let scale: vec3;

    /**
     * The transform of a node as it stands
     * */
    pub self (node: &Node3D)
        with position = node.position
        , rotation = node.rotation
        , scale = node.scale
    {}

    pub self (position: vec3, rotation: vec3, scale: vec3)
        with position = position
        , rotation = rotation
        , scale = scale
    {}

    /**
     * Give the transform to a node, its transformation computed once (see Node3D::setTransform)
     * */
    pub fn applyTo(self, dmut node: &Node3D) {
        node:.setTransform(self.position, self.rotation, self.scale);
    }

}
