in utils;

use balder::core::error;
use balder::math::{bounds, matrix, rigid_transform, utils, vector};
use balder::scene::asset::assets;
use balder::scene::node::node3D::{mesh_instance, visual, volume};
use balder::scene::physics;
use balder::scene::physics::convex_decomposition;
use balder::utils::path;

use std::fs;

/**
 * @returns: the hulls of a model: its convex decomposition saved next to its file, or the hull of each of its meshes
 * when it has none (see MeshAsset.hulls), placed in the space of the body by the transformation of the model
 * there, its scale given to the hulls
 * @params:
 *    - place: the transformation of the model in the space of the body (see PhysicsBody3D::placeOfModel)
 * @throws:
 *    - &BalderError: if the model, or its decomposition, cannot be read
 * */
pub fn hullsOf(model: [c8], place: mat4 = mat4())-> ColliderShape
    throws BalderError
{
    let saved = ConvexDecomposition::fileOf(model);
    let hulls = if std::fs::isFile(projectPath(saved)) {
        ConvexDecomposition::fromFile(saved).shape()
    } else {
        Assets::mesh(model, lods-> false).hulls()
    };

    if place == mat4() { return hulls; }

    // the parts of a compound part are placed under it (see CompoundShape)
    ColliderShape::compound(copy CompoundShape(copy [CompoundPart(shape-> hulls.scaled(axesScale(place)),
                                                                  place-> RigidTransform(place))]))
}

/**
 * @returns: the triangles of the parts of a model, placed in the space of the body by the transformation of the model
 * there
 * @params:
 *    - place: the transformation of the model in the space of the body (see PhysicsBody3D::placeOfModel)
 * @throws:
 *    - &BalderError: if the model cannot be read, or has no triangle
 * */
pub fn trianglesOf(model: [c8], place: mat4 = mat4())-> ColliderShape
    throws BalderError
{
    let triangles = Assets::mesh(model, lods-> false).triangles();
    if triangles.len == 0us {
        throw copy BalderError(f"The model ${model} has no triangle");
    }

    let mut positions: [vec3] = [];
    let mut indices: [u32] = [];
    for i, t in triangles {
        positions ~= [(place * makeVec4(t.a, 1.0f)).xyz, (place * makeVec4(t.b, 1.0f)).xyz, (place * makeVec4(t.c, 1.0f)).xyz];
        let k = cast!u32(i) * 3u32;
        indices ~= [k, k + 1u32, k + 2u32];
    }

    ColliderShape::mesh(copy TriangleBvh(positions, indices))
}

/**
 * @returns: the transformation in the world of the first mesh of a model file under a node, those under a body left out (the
 * body of their own), none if there is none
 * */
pub fn modelUnder(dmut node: &Node, model: [c8])-> (mat4)? {
    for dmut c in alias node:.getChildrenInOrder() {
        if let _: &PhysicsBody3D = c { continue; }
        if let m: &MeshInstance3D = c && m.mesh.path == model { return (m.transformation)?; }
        if let Ok(t) = modelUnder(alias c, model) { return (t)?; }
    }

    none
}

/**
 * Add to the parts of a compound the volumes of a node and of the nodes under it, those under a body left out (the body
 * of their own), each placed by its transformation in the space of the compound, its scale given to its shape
 * @params:
 *    - inverse: the inverse of the transformation of the compound in the world
 * */
pub fn gatherVolumes(dmut node: &Node, inverse: mat4, ref mut parts: [CompoundPart]) {
    if let _: &PhysicsBody3D = node { return; }

    if let v: &Volume3D = node {
        let local = inverse * v.transformation;
        parts ~= [CompoundPart(shape-> ColliderShape(v.shape).scaled(axesScale(local)), place-> RigidTransform(local))];
    }

    for dmut c in alias node:.getChildrenInOrder() {
        gatherVolumes(alias c, inverse, ref parts);
    }
}

/**
 * @returns: true iif a visual instance is under a node, the body being seen by the meshes it moves
 * */
pub fn holdsGeometry(node: &Node)-> bool {
    for c in node.childrenInOrder() {
        if let _: &VisualInstance3D = c { return true; }
        if holdsGeometry(c) { return true; }
    }

    false
}
