in utils;

use balder::math::vector;

use std::math;

/**
 * @returns: a value, a bound at least
 * */
pub fn atLeast(v: f32, low: f32)-> f32 {
    if v < low { low } else { v }
}

/**
 * @returns: a component of a vector, 0 for x, 1 for y, 2 for z
 * */
pub fn component(v: vec3, axis: usize)-> f32 {
    if axis == 0us { v.x } else if axis == 1us { v.y } else { v.z }
}

/**
 * @returns: a corner of the rectangle of half sides h.x and h.y, turning about its centre, its z left at 0
 * */
pub fn corner(h: vec3, i: usize)-> vec3 {
    makeVec3(if i == 0us || i == 3us { -h.x } else { h.x }, if i < 2us { -h.y } else { h.y }, 0.0f)
}

/**
 * @returns: the segments of an arc of a circle about a point, from an angle to another, the angles turning from u to v
 * @params:
 *    - u, v: two unit axes of the plane of the circle, orthogonal
 * */
pub fn arc(centre: vec3, u: vec3, v: vec3, radius: f32, from: f32, to: f32, segments: usize)-> [(vec3, vec3)] {
    let mut lines: [(vec3, vec3)] = [];
    let mut last = centre + (u * math::cos(from) + v * math::sin(from)) * radius;
    for k in 1us .. segments + 1us {
        let angle = from + (to - from) * cast!f32(cast!u64(k)) / cast!f32(cast!u64(segments));
        let next = centre + (u * math::cos(angle) + v * math::sin(angle)) * radius;
        lines ~= [(last, next)];
        last = next;
    }

    lines
}
