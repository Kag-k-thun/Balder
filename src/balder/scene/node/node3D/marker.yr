in marker;

use balder::scene::node::node3D::icon;

/**
 * What a marker marks, the glyph an editor draws it as following it
 * */
pub enum MarkerPurpose : u32
| GENERIC  = 0u32 // a place of no purpose given
| SPAWN    = 1u32 // where something appears: a player, an enemy...
| WAYPOINT = 2u32 // a place to go through: a patrol, a race...
| SOCKET   = 3u32; // where something attaches: a weapon to a hand, a lamp to a wall...

/**
 * An empty with a purpose: a place the game looks up, by its name or by its tags, to put something at (a spawn point, a
 * waypoint, an attachment socket), drawing nothing, placing the nodes under it as an empty does
 * @info: the place of a marker is its transformation in the world (see Node3D::transformation), its rotation turning
 * what goes there; the markers under a node are looked up by Marker3D::find, tagged and ofPurpose
 * */
pub class Marker3D over Node3D {

    // What the marker marks
    let mut _purpose: MarkerPurpose = MarkerPurpose::GENERIC;

    // The tags the game looks the marker up by, each once
    let mut _tags: [[c8]] = [];

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the marker is attached to
     *    - purpose: what the marker marks
     * */
    pub self (name: [c8], dmut parent: &Node, purpose: MarkerPurpose = MarkerPurpose::GENERIC)
        with super(name, alias parent)
        , _purpose = purpose
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: what the marker marks
     * */
    @field
    pub fn purpose(self)-> MarkerPurpose {
        self._purpose
    }

    /**
     * Change what the marker marks
     * */
    @field
    pub fn purpose(mut self, purpose: MarkerPurpose) {
        self._purpose = purpose;
    }

    /**
     * @returns: the tags the game looks the marker up by, in the order they were given
     * */
    @field
    pub fn tags(self)-> [[c8]] {
        self._tags
    }

    /**
     * Change the tags the game looks the marker up by, the empty ones left out and each kept once
     * */
    @field
    pub fn tags(mut self, tags: [[c8]]) {
        let mut kept: [[c8]] = [];
        for t in tags if t.len != 0us {
            let mut known = false;
            for k in kept if k == t { known = true; }
            if !known { kept ~= [t]; }
        }

        self._tags = kept;
    }

    /**
     * @returns: true iif the marker has a tag
     * */
    pub fn hasTag(self, tag: [c8])-> bool {
        for t in self._tags if t == tag { return true; }
        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          EDITOR          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the glyph of the purpose of the marker: a figure for a spawn point, a flag for a waypoint, a ring about a
     * dot for a socket, a cross for a marker of no purpose given
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        match self._purpose {
            MarkerPurpose::SPAWN    => { NodeIcon::spawnPoint()? }
            MarkerPurpose::WAYPOINT => { NodeIcon::waypoint()? }
            MarkerPurpose::SOCKET   => { NodeIcon::socket()? }
            _                       => { NodeIcon::marker()? }
        }
    }

}

/**
 * The look up of the markers under a node, by the game
 * */
pub mod Marker3D {

    /**
     * @returns: the first marker of a name under a node, the nodes under it walked in their order, each one before the
     * nodes under it; none when no marker has that name
     * */
    pub fn find(dmut under: &Node, name: [c8])-> dmut (&Marker3D)? {
        for dmut c in alias under:.getChildrenInOrder() {
            if let dmut m: &Marker3D = alias c {
                if m.name.file() == name { return (alias m)?; }
            }

            if let Ok(dmut found) = alias find(alias c, name) {
                return (alias found)?;
            }
        }

        none
    }

    /**
     * @returns: the markers of a tag under a node, in the order of the nodes, each one before the nodes under it
     * */
    pub fn tagged(dmut under: &Node, tag: [c8])-> dmut [&Marker3D] {
        let dmut found: [&Marker3D] = [];
        for dmut c in alias under:.getChildrenInOrder() {
            if let dmut m: &Marker3D = alias c {
                if m.hasTag(tag) { found ~= [alias m]; }
            }

            found ~= alias tagged(alias c, tag);
        }

        alias found
    }

    /**
     * @returns: the markers of a purpose under a node (the spawn points of a level...), in the order of the nodes, each
     * one before the nodes under it
     * */
    pub fn ofPurpose(dmut under: &Node, purpose: MarkerPurpose)-> dmut [&Marker3D] {
        let dmut found: [&Marker3D] = [];
        for dmut c in alias under:.getChildrenInOrder() {
            if let dmut m: &Marker3D = alias c {
                if m.purpose == purpose { found ~= [alias m]; }
            }

            found ~= alias ofPurpose(alias c, purpose);
        }

        alias found
    }

}
