in solid;

use balder::math::_;
use balder::core::error;
use balder::core::config::shader::entry;
use balder::scene::node::node3D::visual::{_, material::_};
use balder::utils::log;

use ::assimp::_;

use ::std::{conv, fs::_};

/**
 * A solid object model is a 3D model containing multiple meshes
 * */
pub class SolidObjectModel over Node3D {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          LOADING FROM FILE          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load a 3D index mesh from a file
     * @params:
     *   - path: the project path of the file to load
     *   - lods: true to build the levels of detail of the meshes of the model
     * @returns: the mesh
     * */
    pub self fromFile (name : [c8], dmut parent : &Node, path : [c8], lods : bool = true)
        with super (name, alias parent)
        throws BalderError
    {
        let filePath = balder::utils::path::projectPath (path);

        unsafe {
            // the transformations of the nodes are applied to their meshes, placed in the model as the file places them
            let sceneAI = aiImportFile (filePath.toStr ().toStringZ (),
                                        aiPostProcessSteps::TargetRealtime_Quality
                                        | aiPostProcessSteps::ConvertToLeftHanded
                                        | aiPostProcessSteps::PreTransformVertices);

            if sceneAI == null {
                throw copy BalderError ("Failed to load model from file " ~ filePath.toStr ());
            }

            {
                let dir = filePath.parent ();
                let (mins, maxs) = self.computeMinMax (sceneAI.rootNode (), sceneAI);
                let dimension = (maxs - mins);
                let centroid = (maxs + mins) / 2.0f;
                
                let s = std::algorithm::comparison::max (std::algorithm::comparison::max (dimension.x, dimension.y), dimension.z);
                let scale = makeVec3 (1.0f / s, 1.0f / s, 1.0f / s);                
                let position = makeVec3 (-centroid.x, -mins.y, -centroid.z);
                
                let loadTransform = math::utils::scaling (scale) *  
                    math::utils::translation (position);
                
                let root = sceneAI.rootNode ();
                self:.processSolidNode (root, sceneAI, dir, loadTransform, lods);
                                                                     
            } exit {
                aiReleaseImport (sceneAI);
            }
        }
    }
        
    /**
     * Create a model drawing the meshes of another, sharing their geometry: placed once in the geometry pool of each
     * shader, the meshes of the models sharing it are drawn by one instanced command
     * @info: the meshes of a model uploaded before the copy released their vertices, the copy drawing the geometry they
     * placed while they are in the scene; a model copied before entering the scene keeps them for its copies
     * @params:
     *    - model: the model to draw again, its meshes drawn with copies of their materials
     * */
    pub self copyOf (name : [c8], dmut parent : &Node, dmut model : &SolidObjectModel)
        with super (name, alias parent)
    {
        for _, dmut c in alias model._childs if let dmut mesh : &IndexedMesh3D = alias c {
            let chName = "mesh_" ~ std::conv::to!{[c8]} (self._childs.len);
            let dmut copied = copy IndexedMesh3D::sharing (chName,
                                                           alias self,
                                                           alias mesh.mesh,
                                                           mesh.material.clone (),
                                                           shadow-> mesh.castShadow ());

            copied.position = mesh.position;
            copied.rotation = mesh.rotation;
            copied.scale = mesh.scale;
            copied.forcedLod = mesh.forcedLod;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onEnter (mut self, dmut _ : &Scene) {}
    pub over onExit (mut self, dmut _ : &Scene) {}

    /**
     * Draw every mesh of the model at a level of detail whatever the camera, or none to select it from the camera
     * */
    pub fn forceLod (mut self, level : (usize)?) {
        for _, dmut c in alias self._childs if let dmut mesh : &IndexedMesh3D = alias c {
            mesh.forcedLod = level;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          BOUND COMPUTATIONS          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compute the bounds of the scene
     * @returns:
     * - 0: the minimum bound
     * - 1: the maximum bound
     */
    @unsafe
    fn computeMinMax (self, node : *aiNode, scene : *aiScene)-> (vec3, vec3) {
        let mut min = vec3 (), mut max = vec3 ();
        for i in 0 .. node.numMeshes () {
            let mesh = scene.meshes () [i];
            let (aux_min, aux_max) = self.computeMinMax (mesh);
            min = self.updateMin (min, aux_min);
            max = self.updateMax (max, aux_max);
        }

        for i in 0 .. (*node).mNumChildren {
            let child = node.children () [i];
            let (aux_min, aux_max) = self.computeMinMax (child, scene);
            min = self.updateMin (min, aux_min);
            max = self.updateMax (max, aux_max);
        }

        (min, max)
    }

    /**
     * Compute the bound of a mesh
     */
    @unsafe
    fn computeMinMax (self, mesh : *aiMesh)-> (vec3, vec3) {
        let mut min = vec3 (), mut max = vec3 ();
        for i in 0u32 .. mesh.numVertices () {
            min = self.updateMin (min, mesh.vertices () [i]);
            max = self.updateMax (max, mesh.vertices () [i]);
        }

        (min, max)
    }

    /**
     * @returns: the minimum between the two vectors (field by field)
     */
    fn updateMin {T} (self, min : vec3, aux : T)-> vec3 {
        let min_x = if (min.x > aux.x) { aux.x } else { min.x };
        let min_y = if (min.y > aux.y) { aux.y } else { min.y };
        let min_z = if (min.z > aux.z) { aux.z } else { min.z };

        makeVec3 (min_x, min_y, min_z)
    }

    /**
     * @returns: the maximum between the two vectors (field by field)
     */
    fn updateMax {T} (self, max : vec3, aux : T)-> vec3 {
        let max_x = if (max.x < aux.x) { aux.x } else { max.x };
        let max_y = if (max.y < aux.y) { aux.y } else { max.y };
        let max_z = if (max.z < aux.z) { aux.z } else { max.z };

        makeVec3 (max_x, max_y, max_z)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          LOADING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read all the meshes and material inside a node and its childs, and register the meshes inside the solid object
     * @info: the window resource manager is used to load Managed resources (e.g. textures)
     * */
    @unsafe
    fn processSolidNode (mut self, node : *aiNode, scene : *aiScene, dir : Path, loadTransform : mat4, lods : bool)
        throws BalderError
    {
        for i in 0 .. node.numMeshes () {
            let mesh = scene.meshes ()[i];
            self:.processSolidMesh (mesh, scene, dir, loadTransform, lods);
        }

        for i in 0 .. (*node).mNumChildren {
            let child = node.children ()[i];
            self:.processSolidNode (child, scene, dir, loadTransform, lods);
        }
    }

    /**
     * Read a mesh and its associated material, and build its levels of detail
     * */
    @unsafe
    fn processSolidMesh (mut self, mesh : *aiMesh, scene : *aiScene, dir : Path, loadTransform : mat4, lods : bool)
        throws BalderError
    {        
        let dmut material = if scene.numMaterials () > mesh.materialIndex () {
            let innerMat = scene.materials () [mesh.materialIndex ()];
            self:.processMaterial (mesh, innerMat, dir)
        } else {        
            let dmut mt = copy ConstantMaterial (MaterialConfig ());            
            alias mt
        };

        let array = self:.loadSolidMeshVertices (mesh, material, loadTransform);
        let dmut indices = copy [0u32 ; 3 * mesh.numFaces ()];
        
        for i in 0u32 .. mesh.numFaces () {
            let face = mesh.faces () [i];
            if (face.mNumIndices != 3u32) throw copy BalderError ("Object is not triangulated");
            for j in 0u32 .. 3u32 {
                indices [i * 3u32 + j] = face.mIndices [j];
            }
        }

        let chName = "mesh_" ~ std::conv::to!{[c8]} (self._childs.len);
        let chain = if lods {
            let vertices = array.compactVertices (material, forShadow-> false);
            let welded = weldVertices (indices, vertices, vertices.len / array.positions.len);
            buildLodChain (array.positions, welded)
        } else { LodChain (indices) };
        log::debug #("SolidObjectModel", chName, "has", chain.levels.len, "levels of detail");

        let dmut _ = copy IndexedMesh3D (chName,
                                         alias self,
                                         chain,
                                         array,
                                         alias material);            
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          MATERIAL          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load a material from a material assump description: a metallic/roughness material when it has maps other than its
     * base colour, a material of its base colour texture when it has only this one, a constant material otherwise
     * */
    @unsafe
    fn processMaterial (mut self, mesh : *aiMesh, mat : *aiMaterial, dir : Path)-> dmut &Material
        throws BalderError
    {        
        let config = self.readConfig (mat);
        if mesh.numUVComponents (0) == 0 {
            return copy ConstantMaterial (config);
        }

        // the slots of the maps, by preference: assimp gives the occlusion of glTF as a lightmap
        let baseColor = copy [aiTextureType::BASE_COLOR, aiTextureType::DIFFUSE];
        let occlusion = copy [aiTextureType::AMBIENT_OCCLUSION, aiTextureType::LIGHTMAP];
        let emissive = copy [aiTextureType::EMISSIVE, aiTextureType::EMISSION_COLOR];

        let maps = MaterialMaps (baseColor-> self.texturePath (mat, dir, baseColor),
                                 metallicRoughness-> self.metallicRoughnessPath (mat, dir),
                                 normal-> self.texturePath (mat, dir, copy [aiTextureType::NORMALS]),
                                 occlusion-> self.texturePath (mat, dir, occlusion),
                                 emissive-> self.texturePath (mat, dir, emissive));

        if maps.metallicRoughness != "" || maps.normal != "" || maps.occlusion != "" || maps.emissive != "" {
            return copy MetallicRoughnessMaterial (maps, config);
        }

        if maps.baseColor != "" {
            return copy DiffuseTextureMaterial (maps.baseColor, config);
        }
        
        return copy ConstantMaterial (config);
    }

    /**
     * @returns: the path of the map of a material holding its roughness in green and its metalness in blue, empty when
     * it has none
     * @info: assimp gives the map of glTF its own slot, and the same file as the metalness and the roughness maps; two
     * different files there are not packed that way, and are not read
     * */
    fn metallicRoughnessPath (self, mat : *aiMaterial, dir : Path)-> [c8] {
        let packed = self.texturePath (mat, dir, copy [aiTextureType::GLTF_METALLIC_ROUGHNESS]);
        if packed != "" {
            return packed;
        }

        let metalness = self.texturePath (mat, dir, copy [aiTextureType::METALNESS]);
        if metalness == self.texturePath (mat, dir, copy [aiTextureType::DIFFUSE_ROUGHNESS]) {
            return metalness;
        }

        ""
    }

    /**
     * @returns: the path of the first texture of a material in the first of its slots having one, in the directory of
     * the model when the file is there, empty when it has none
     * @info: the textures embedded in the file (named *0, *1...) are not read
     * */
    fn texturePath (self, mat : *aiMaterial, dir : Path, slots : [aiTextureType])-> [c8] {
        for slot in slots {
            if mat.textureCount (slot) == 0 {
                continue;
            }

            let ainame = mat.texture (slot, 0);
            let name = copy ainame.data [0 .. ainame.len];
            if name.len != 0 && name [0] == '*' {
                log::warn #("SolidObjectModel", "The embedded texture", name, "is not read");
                return "";
            }

            let path = dir.push (name);
            return if std::fs::sys::isFile (path) { path.toStr () } else { name };
        }

        ""
    }

    /**
     * @returns: the factors of a material, read from its metallic/roughness properties (glTF), or converted from its
     * Phong properties (OBJ) when it has none
     * */
    fn readConfig (self, mat : *aiMaterial)-> MaterialConfig {
        let emissive = self.readColor (mat.emissiveColor ()) * (mat.emissiveIntensity () ?? 1.0f);
        let metallic = mat.metallicFactor (), roughness = mat.roughnessFactor ();
        if !metallic.hasValue && !roughness.hasValue {
            return MaterialConfig::phong (self.readColor (mat.diffuseColor ()),
                                          self.readColor (mat.specularColor ()),
                                          mat.shininess (),
                                          emissive);
        }

        let mut config = MaterialConfig ();
        config.baseColor = self.readColor (mat.baseColor () ?? mat.diffuseColor ());
        config.emissive = emissive;

        // the defaults of glTF, a fully rough metal
        config.metallic = metallic ?? 1.0f;
        config.roughness = roughness ?? 1.0f;

        config
    }

    /**
     * Transform an assimp vector into a balder vector
     * */
    fn readColor (self, color : aiColor4D)-> vec3 {
        makeVec3 (color.r, color.g, color.b)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          VERTICES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Process a solid mesh whose material is a simple color material
     * */
    @unsafe
    fn loadSolidMeshVertices (mut self, mesh : *aiMesh, material : &Material, loadTransform : mat4)-> MeshArray {
        let mut array = MeshArray ();
        array.positions = copy [vec3 () ; mesh.numVertices ()];
        if mesh.normals () != null && VertexEntry::NORMALS in material.shaderConfig.entries {
            array.normals = copy [vec3 () ; mesh.numVertices ()];
        }

        let mut handedness : [f32] = [];
        if mesh.tangents () != null && mesh.normals () != null && mesh.textureCoords (0) != null
           && VertexEntry::TANGENTS in material.shaderConfig.entries {
            array.tangents = copy [vec4 () ; mesh.numVertices ()];
            handedness = self.tangentHandedness (mesh);
        }

        if mesh.textureCoords (0) != null && VertexEntry::TEX_UV in material.shaderConfig.entries {
            array.textureUVs = copy [vec2 () ; mesh.numVertices ()];
        }

        if mesh.textureCoords (1) != null && VertexEntry::TEX_UV2 in material.shaderConfig.entries {
            array.textureUVs2 = copy [vec2 () ; mesh.numVertices ()];
        }

        if mesh.colors (0) != null && VertexEntry::COLORS in material.shaderConfig.entries {
            array.colors = copy [vec3 () ; mesh.numVertices ()];
        }

        for i in 0 .. mesh.numVertices () {
            let pos = mesh.vertices ()[i];
            let v = makeVec4 (pos.x, pos.y, pos.z, 1.0f);
            array.positions [i] = (loadTransform * v).xyz;            
            
            if array.normals.len > i {
                let norm = mesh.normals () [i];
                array.normals [i] = makeVec3 (norm.x, norm.y, norm.z);
            }

            if array.tangents.len > i {
                let tan = mesh.tangents () [i];
                array.tangents [i] = makeVec4 (tan.x, tan.y, tan.z, handedness [i]);
            }

            if array.textureUVs.len > i {
                let tan = mesh.textureCoords (0) [i];
                array.textureUVs [i] = makeVec2 (tan.x, tan.y);
            }

            if array.textureUVs2.len > i {
                let tan = mesh.textureCoords (1) [i];
                array.textureUVs2 [i] = makeVec2 (tan.x, tan.y);
            }

            if array.colors.len > i {
                let tan = mesh.colors (0) [i];
                array.colors [i] = makeVec3 (tan.r, tan.g, tan.b);
            }
        }

        array
    }

    /**
     * @returns: the handedness of the tangent space of each vertex of a mesh, -1 where the growing v of its texture
     * coordinates runs against the cross product of its normal and its tangent (a mirrored texture), 1 otherwise
     * @info: the bitangents of assimp are not read, running along the growing v when the file gives the tangents but
     * against it when assimp computes them; the growing v is found from the faces around each vertex instead
     * */
    @unsafe
    fn tangentHandedness (self, mesh : *aiMesh)-> [f32] {
        let dmut along = copy [vec3 () ; mesh.numVertices ()];
        for i in 0u32 .. mesh.numFaces () {
            let face = mesh.faces () [i];
            if face.mNumIndices != 3u32 { continue; }

            let a = face.mIndices [0], b = face.mIndices [1], c = face.mIndices [2];
            let (pa, pb, pc) = (mesh.vertices () [a], mesh.vertices () [b], mesh.vertices () [c]);
            let (ta, tb, tc) = (mesh.textureCoords (0) [a], mesh.textureCoords (0) [b], mesh.textureCoords (0) [c]);

            let e1 = makeVec3 (pb.x - pa.x, pb.y - pa.y, pb.z - pa.z);
            let e2 = makeVec3 (pc.x - pa.x, pc.y - pa.y, pc.z - pa.z);
            let (du1, dv1, du2, dv2) = (tb.x - ta.x, tb.y - ta.y, tc.x - ta.x, tc.y - ta.y);

            let det = du1 * dv2 - du2 * dv1;
            if det == 0.0f { continue; }

            // the derivative of the position along v on the face
            let dv = (e2 * du1 - e1 * du2) / det;
            for v in [a, b, c] {
                along [v] = along [v] + dv;
            }
        }

        let dmut result = copy [1.0f ; mesh.numVertices ()];
        for i in 0u32 .. mesh.numVertices () {
            let tan = mesh.tangents () [i], norm = mesh.normals () [i];
            let normal = makeVec3 (norm.x, norm.y, norm.z);
            if normal.cross (makeVec3 (tan.x, tan.y, tan.z)).dot (along [i]) < 0.0f {
                result [i] = -1.0f;
            }
        }

        result
    }

}
