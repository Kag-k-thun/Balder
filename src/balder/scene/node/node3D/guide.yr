in guide;

use balder::math::vector;

use std::math;

/**
 * The number of segments drawing a circle of the guides
 * */
def CIRCLE_SEGMENTS = 32us;

/**
 * A line an editor draws a node selected with, in world space, the lines of a node telling its shape: the arrows of a
 * direction light, the range of a point light, the cone of a spot light, the frustum of a camera (see
 * Node3D::editorGuides)
 * */
@data
pub record NodeGuide {

    // The ends of the line, in world space
    pub let from: vec3 = vec3();
    pub let to: vec3 = vec3();

    // True iif the line is drawn fainter than the others (the full light of a spot light inside its light)
    pub let faint: bool = false;

}

/**
 * The guides of the shapes the nodes of Balder have
 * */
pub mod NodeGuide {

    /**
     * @returns: the lines of a circle about a point
     * @params:
     *    - normal: the unit axis of the circle
     *    - radius: the radius of the circle, in world units
     * */
    pub fn circle(centre: vec3, normal: vec3, radius: f32, faint: bool = false)-> [NodeGuide] {
        let (u, v) = across(normal);
        let mut lines: [NodeGuide] = [];
        let mut last = centre + u * radius;
        for k in 1us .. CIRCLE_SEGMENTS + 1us {
            let angle = 2.0f * cast!f32(math::PI) * cast!f32(cast!u64(k)) / cast!f32(cast!u64(CIRCLE_SEGMENTS));
            let next = centre + (u * math::cos(angle) + v * math::sin(angle)) * radius;
            lines ~= [NodeGuide(from-> last, to-> next, faint-> faint)];
            last = next;
        }

        lines
    }

    /**
     * @returns: the lines of an arrow from a point to another, its head four lines back from its tip
     * @params:
     *    - head: the length of the head, in world units
     * */
    pub fn arrow(from: vec3, to: vec3, head: f32)-> [NodeGuide] {
        let span = to - from;
        let len = span.length();
        if len <= 0.0f { return []; }

        let d = span / len;
        let (u, v) = across(d);
        let base = to - d * head;
        let half = head * 0.5f;
        copy [NodeGuide(from-> from, to-> to),
              NodeGuide(from-> to, to-> base + u * half),
              NodeGuide(from-> to, to-> base - u * half),
              NodeGuide(from-> to, to-> base + v * half),
              NodeGuide(from-> to, to-> base - v * half)]
    }

    /**
     * @returns: two unit vectors orthogonal to a unit axis and to each other
     * */
    pub fn across(axis: vec3)-> (vec3, vec3) {
        let side = if math::abs(axis.x) < 0.9f { makeVec3(1.0f, 0.0f, 0.0f) } else { makeVec3(0.0f, 1.0f, 0.0f) };
        let u = axis.cross(side).normalized();
        (u, axis.cross(u))
    }

}
