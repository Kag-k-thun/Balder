in group;

/**
 * A 3D node drawing nothing, placing the nodes under it together: moved, turned and scaled, it moves, turns and scales
 * them as a whole
 * */
pub class Group3D over Node3D {

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the group is attached to
     * */
    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}
