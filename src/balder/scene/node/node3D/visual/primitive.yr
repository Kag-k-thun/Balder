/**
 * The meshes of the simple shapes, a cube, a sphere and a plane, each in the unit box standing on its origin as a model
 * loaded from a file (see SolidObjectModel::fromFile): x and z in [-0.5, 0.5], y in [0, 1], so the scale of a node
 * drawing one is its size and its position the centre of its base
 * @info: the triangles face outward, cross (b - a, c - a) along the normal of their surface
 * */
in primitive;

use balder::math::vector;
use balder::scene::node::node3D::visual::array;

use std::math;

/**
 * @returns: the vertices of a cube, four per face for the faces to keep their normal, and the indices of its triangles
 * */
pub fn cubeMesh()-> (MeshArray, [u32]) {
    let x = makeVec3(0.5f, 0.0f, 0.0f), y = makeVec3(0.0f, 0.5f, 0.0f), z = makeVec3(0.0f, 0.0f, 0.5f);
    let center = makeVec3(0.0f, 0.5f, 0.0f);

    // each face along its normal, then two axes across it whose cross product is the normal
    let faces = [(x, y, z), (-x, z, y), (y, z, x), (-y, x, z), (z, x, y), (-z, y, x)];

    let mut array = MeshArray();
    let dmut positions: [vec3] = [];
    let dmut normals: [vec3] = [];
    let dmut indices: [u32] = [];
    for f in faces {
        let (out, u, v) = f;
        let first = cast!u32(positions.len);
        let c = center + out;
        let n = out.normalized();
        positions ~= [c - u - v, c + u - v, c + u + v, c - u + v];
        normals ~= [n, n, n, n];
        indices ~= [first, first + 1u32, first + 2u32, first, first + 2u32, first + 3u32];
    }

    array.positions = alias positions;
    array.normals = alias normals;
    (array, indices)
}

/**
 * @returns: the vertices of a sphere 1 unit wide, its normals pointing away from its centre, and the indices of its
 * triangles
 * @params:
 *    - rings: the number of rings from pole to pole
 *    - segments: the number of segments around the vertical axis
 * */
pub fn sphereMesh(rings: u32 = 24u32, segments: u32 = 48u32)-> (MeshArray, [u32]) {
    let center = makeVec3(0.0f, 0.5f, 0.0f);

    let mut array = MeshArray();
    let dmut positions: [vec3] = [];
    let dmut normals: [vec3] = [];
    for r in 0u32 ... rings {
        let theta = cast!f32(r) * math::PI / cast!f32(rings);
        for s in 0u32 ... segments {
            let phi = cast!f32(s) * 2.0f * math::PI / cast!f32(segments);
            let normal = makeVec3(math::sin(theta) * math::cos(phi), math::cos(theta), math::sin(theta) * math::sin(phi));
            positions ~= [center + normal * 0.5f];
            normals ~= [normal];
        }
    }

    let dmut indices: [u32] = [];
    for r in 0u32 .. rings {
        for s in 0u32 .. segments {
            let a = r * (segments + 1u32) + s;
            let b = a + segments + 1u32;
            indices ~= [a, a + 1u32, b, b, a + 1u32, b + 1u32];
        }
    }

    array.positions = alias positions;
    array.normals = alias normals;
    (array, indices)
}

/**
 * @returns: the vertices of a square 1 unit wide lying at y = 0, facing up, and the indices of its two triangles
 * */
pub fn planeMesh()-> (MeshArray, [u32]) {
    let x = makeVec3(0.5f, 0.0f, 0.0f), z = makeVec3(0.0f, 0.0f, 0.5f);
    let up = makeVec3(0.0f, 1.0f, 0.0f);

    let mut array = MeshArray();
    array.positions = copy [-z - x, z - x, z + x, x - z];
    array.normals = copy [up, up, up, up];
    (array, copy [0u32, 1u32, 2u32, 0u32, 2u32, 3u32])
}
