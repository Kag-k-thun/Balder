in array;

use balder::math::_;
use balder::core::error;
use balder::core::config::shader::_;

/**
 * Record containing the kind of point data that a mesh can accept
 * */
pub record MeshArray {

    pub let dmut positions : [vec3] = [];
    pub let dmut normals : [vec3] = [];
    // The tangents along the growing u of the texture coordinates, their handedness in w: -1 where the texture is
    // mirrored, its bitangent (along the growing v) opposite to the cross product of the normal and the tangent
    pub let dmut tangents : [vec4] = [];
    pub let dmut colors : [vec3] = [];
    pub let dmut textureUVs : [vec2] = [];
    pub let dmut textureUVs2 : [vec2] = [];
    pub let dmut bones : [vec4] = [];
    pub let dmut weights : [vec4] = [];

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          COMPUTE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the box bounding the positions, empty when there is none
     * */
    pub fn aabb (self)-> Aabb {
        let mut box = Aabb ();
        for p in self.positions {
            box = box.merged (Aabb (p, p));
        }

        box
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compact the vertices to make them fold in one buffer, laid out as the shader of a configuration reads them
     * @info: a vertex skinned before it is drawn starts at its bind position the frame before (VertexEntry::PREVIOUS)
     * @params:
     *    - config: the configuration of the shader, its vertex entries
     *    - forShadow: true for the positions only
     * */
    pub fn compactVertices (self, config : &RasterShaderConfig, forShadow : bool)-> [f32]
        throws BalderError
    {
        let mut size = 0u32;
        size += self.addSize (config, VertexEntry::POSITIONS, self.positions);
        if !forShadow {
            size += self.addSize (config, VertexEntry::NORMALS  , self.normals);
            size += self.addSize (config, VertexEntry::TANGENTS , self.tangents);
            size += self.addSize (config, VertexEntry::COLORS   , self.colors);
            size += self.addSize (config, VertexEntry::TEX_UV   , self.textureUVs);
            size += self.addSize (config, VertexEntry::TEX_UV2  , self.textureUVs2);
            size += self.addSize (config, VertexEntry::BONES    , self.bones);
            size += self.addSize (config, VertexEntry::WEIGHTS  , self.weights);
            size += self.addSize (config, VertexEntry::PREVIOUS , self.positions);
        }

        // size counts bytes, the vertices hold floats
        let dmut result = copy [0.0f ; cast!usize (size / 4u32) * self.positions.len];
        let mut current = 0us;
        for i in 0 .. self.positions.len {
            current = self.append (VertexEntry::POSITIONS in config.entries,     alias result, self.positions, current, i);
            if !forShadow {
                current = self.append (VertexEntry::NORMALS in config.entries,  alias result, self.normals, current, i);
                current = self.append (VertexEntry::TANGENTS in config.entries, alias result, self.tangents, current, i);
                current = self.append (VertexEntry::COLORS in config.entries,   alias result, self.colors, current, i);
                current = self.append (VertexEntry::TEX_UV in config.entries,   alias result, self.textureUVs, current, i);
                current = self.append (VertexEntry::TEX_UV2 in config.entries,  alias result, self.textureUVs2, current, i);
                current = self.append (VertexEntry::BONES in config.entries,    alias result, self.bones, current, i);
                current = self.append (VertexEntry::WEIGHTS in config.entries,  alias result, self.weights, current, i);
                current = self.append (VertexEntry::PREVIOUS in config.entries, alias result, self.positions, current, i);
            }
        }

        result
    }

    /**
     * Append the values in the final array
     * */
    fn append {V} (self, has : bool, dmut result : [f32], elements : [V], current : usize, index : usize) -> usize {
        if has {
            if elements.len > index {
                result [current] = elements [index].x;
                result [current + 1] = elements [index].y;
                cte if arity!{V} > 2 {
                    result [current + 2] = elements [index].z;
                }
                cte if arity!{V} > 3 {
                    result [current + 3] = elements [index].w;
                }
            } else {
                for i in 0 .. arity!{V} {
                    result [current + cast!usize (i)] = 0.0f;
                }
            }

            current + cast!usize (arity!{V})
        } else {
            current
        }
    }

    /**
     * Compute the size of the additional entry
     * */
    fn addSize {V} (self, config : &RasterShaderConfig, entry : VertexEntry, _ : [V])-> u32
        throws BalderError
    {        
        if let Ok (en) = config.entries [entry] { // entry is activated in the shader
            if en._1 != arity!{V} * 4 { // entry but wrong size, error
                throw copy BalderError ("Incompatible entry : " ~ entry);
            }

            arity!{V} * 4
        } else {  // no entry, skipped
            0
        }                
    }

}
