in array;

use balder::math::_;
use balder::core::error;
use balder::core::config::shader::_;
use balder::scene::node::node3D::visual::material;

/**
 * Record containing the kind of point data that a mesh can accept
 * */
pub record MeshArray {

    pub let dmut positions : [vec3] = [];
    pub let dmut normals : [vec3] = [];
    pub let dmut tangents : [vec3] = [];
    pub let dmut colors : [vec3] = [];
    pub let dmut textureUVs : [vec2] = [];
    pub let dmut textureUVs2 : [vec2] = [];
    pub let dmut bones : [vec4] = [];
    pub let dmut weights : [vec4] = [];

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          COMPUTE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the box bounding the positions, empty when there is none
     * */
    pub fn aabb (self)-> Aabb {
        let mut box = Aabb ();
        for p in self.positions {
            box = box.merged (Aabb (p, p));
        }

        box
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compact the vertices to make them fold in one buffer
     * */
    pub fn compactVertices (self, material : &Material, forShadow : bool)-> [f32]
        throws BalderError
    {
        let mut size = 0u32;
        size += self.addSize (material.shaderConfig, VertexEntry::POSITIONS, self.positions);
        if !forShadow {
            size += self.addSize (material.shaderConfig, VertexEntry::NORMALS  , self.normals);
            size += self.addSize (material.shaderConfig, VertexEntry::TANGENTS , self.tangents);
            size += self.addSize (material.shaderConfig, VertexEntry::COLORS   , self.colors);
            size += self.addSize (material.shaderConfig, VertexEntry::TEX_UV   , self.textureUVs);
            size += self.addSize (material.shaderConfig, VertexEntry::TEX_UV2  , self.textureUVs2);
            size += self.addSize (material.shaderConfig, VertexEntry::BONES    , self.bones);
            size += self.addSize (material.shaderConfig, VertexEntry::WEIGHTS  , self.weights);
        }

        // size counts bytes, the vertices hold floats
        let dmut result = copy [0.0f ; cast!usize (size / 4u32) * self.positions.len];
        let mut current = 0us;
        for i in 0 .. self.positions.len {
            current = self.append (VertexEntry::POSITIONS in material.shaderConfig.entries,     alias result, self.positions, current, i);
            if !forShadow {
                current = self.append (VertexEntry::NORMALS in material.shaderConfig.entries,  alias result, self.normals, current, i);
                current = self.append (VertexEntry::TANGENTS in material.shaderConfig.entries, alias result, self.tangents, current, i);
                current = self.append (VertexEntry::COLORS in material.shaderConfig.entries,   alias result, self.colors, current, i);
                current = self.append (VertexEntry::TEX_UV in material.shaderConfig.entries,   alias result, self.textureUVs, current, i);
                current = self.append (VertexEntry::TEX_UV2 in material.shaderConfig.entries,  alias result, self.textureUVs2, current, i);
                current = self.append (VertexEntry::BONES in material.shaderConfig.entries,    alias result, self.bones, current, i);
                current = self.append (VertexEntry::WEIGHTS in material.shaderConfig.entries,  alias result, self.weights, current, i);
            }
        }

        result
    }

    /**
     * Append the values in the final array
     * */
    fn append {V} (self, has : bool, dmut result : [f32], elements : [V], current : usize, index : usize) -> usize {
        if has {
            if elements.len > index {
                result [current] = elements [index].x;
                result [current + 1] = elements [index].y;
                cte if arity!{V} > 2 {
                    result [current + 2] = elements [index].z;
                }
                cte if arity!{V} > 3 {
                    result [current + 3] = elements [index].w;
                }
            } else {
                for i in 0 .. arity!{V} {
                    result [current + cast!usize (i)] = 0.0f;
                }
            }

            current + cast!usize (arity!{V})
        } else {
            current
        }
    }

    /**
     * Compute the size of the additional entry
     * */
    fn addSize {V} (self, config : &RasterShaderConfig, entry : VertexEntry, _ : [V])-> u32
        throws BalderError
    {        
        if let Ok (en) = config.entries [entry] { // entry is activated in the shader
            if en._1 != arity!{V} * 4 { // entry but wrong size, error
                throw copy BalderError ("Incompatible entry : " ~ entry);
            }

            arity!{V} * 4
        } else {  // no entry, skipped
            0
        }                
    }

}
