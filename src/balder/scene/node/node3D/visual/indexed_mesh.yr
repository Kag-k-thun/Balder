in indexed_mesh;

use balder::core::shader::buffers::{instance_draw, pool};
use balder::scene::node::node3D::{camera, visual::_, visual::lod};
use balder::scene::utils::batch;
use balder::utils::log;

use std::time::dur;

/**
 * Mesh of vertices and indices, placed in the geometry pool of the shader of its material
 * @info: the indices hold the levels of detail of the mesh one after the other, all drawn from the same vertices;
 * a change of level cross-fades the two levels with a dithering, during FADE_DURATION
 */
pub class IndexedMesh3D over VisualInstance3D {

    // The material used to draw the node
    let dmut _material : &Material;

    prot { // Local data

        // The data of the mesh to upload on device
        let mut _array : (MeshArray)? = none;

        // The levels of detail of the mesh, the indices dropped after the upload
        let mut _lods : LodChain;

        // Destroy the array after uploading (meaning it can be detached and reattached to the scene)
        let mut _destroyOnUpload : bool = false;

    }

    prot { // Levels of detail

        // The level drawn, the incoming one during a cross-fade
        let mut _level : usize = 0us;

        // The outgoing level of the cross-fade in progress
        let mut _fadingLevel : (usize)? = none;

        // The progress of the cross-fade, from 0 to 1
        let mut _fade : f32 = 0.0f;

        // False until a first level is selected after entering the scene, that one is not faded in
        let mut _selected : bool = false;

        // The level drawn whatever the camera, none to select it from the camera
        let mut _forcedLod : (usize)? = none;

    }

    prot { // Draws

        // The place of the mesh in the draws of the scene, its world in the storage buffer of its shader
        let dmut _draws : (&SceneDraws)? = none;

        // The index of the material in the composition pass, once registered in the scene
        let mut _matID : (u32)? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a new indexed mesh
     * @params:
     *    - lods: the levels of detail of the mesh, LodChain (indices) for the indices of the full mesh only
     *    - array: the vertices of the mesh
     */
    pub self  (name : [c8],
               dmut parent : &Node,
               lods : LodChain,
               array : MeshArray,
               dmut material : &Material,
               shadow : bool = true,
               destroyOnUpload : bool = true)

        with super (name, alias parent, array.aabb (), shadow)
        , _material = alias material
        , _array = (array?)
        , _lods = lods
        , _destroyOnUpload = destroyOnUpload

    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onEnter (mut self, dmut scene : &Scene) {
        self:.destroyBuffers (alias scene);

        {
            if let Ok (array) = self._array && self._lods.indices.len != 0 {
                let matID = scene:.registerMaterialRef (self._material.config);
                self._matID = matID?;
                self._material:.attach (scene:.getWindow (), matID);

                let vertices = array.compactVertices (self._material, forShadow-> false);
                let dmut draws = scene:.registerDraws (alias self._material, alias self, vertices, self._lods.indices);
                draws:.setObject (OBJECT_WORLD, self._transformation);
                draws:.setObject (OBJECT_FADE, self._fade);
                draws:.setObject (OBJECT_MATERIAL, matID);
                self._draws = (alias draws)?;

                log::debug #("IndexedMesh3D", "Registered draws of material ", matID);
            } else {
                log::warn #("IndexedMesh3D", "Empty mesh");
            }
        } catch {
            err => {
                log::error #("IndexedMesh3D", "Failed to upload mesh data to device", err);
                self:.destroyBuffers (alias scene);
            }
        }

        if self._destroyOnUpload {
            self._array = none;
            self._lods.indices = [];
        }

        self._selected = false;
    }

    pub over onExit (mut self, dmut scene : &Scene) {
        log::debug #("IndexedMesh3D", "onExit");            
        self:.destroyBuffers (alias scene);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          LEVELS OF DETAIL          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select the level whose error, seen from the camera at the point of the bounding sphere closest to it, stays
     * under the threshold; a cross-fade in progress finishes before another level is selected
     * */
    pub over selectLod (mut self, camera : &Camera, height : f32, threshold : f32, delta : Duration)-> bool {
        if self._lods.levels.len < 2us || !self._draws.hasValue { return false; }

        if self._fadingLevel.hasValue {
            self._fade += cast!f32 (delta.allMillis) / FADE_DURATION;
            if self._fade < 1.0f {
                self:.writeFade ();
                return false;
            }

            // the incoming level is drawn alone from now on
            self._fade = 1.0f;
            self:.writeFade ();
            self._fadingLevel = none;
            return self:.writeDraws ();
        }

        let sphere = self:.boundingSphere ();
        let center = sphere.center, radius = sphere.radius;
        let eye = camera.position;
        let distance = (eye - center).length ();
        let closest = if distance > radius { center + (eye - center) * (radius / distance) } else { eye };

        let unitSize = camera.screenSize (closest, self.worldScale ()) * height;
        let level = if let Ok (forced) = self._forcedLod {
            if forced < self._lods.levels.len { forced } else { self._lods.levels.len - 1us }
        } else {
            self._lods.select (self._level, unitSize, threshold)
        };
        if level == self._level && self._selected { return false; }

        if self._selected {
            self._fadingLevel = (self._level)?;
            self._fade = 0.0f;
            self:.writeFade ();
        }

        self._level = level;
        self._selected = true;
        self:.writeDraws ()
    }

    /**
     * Write the progress of the cross-fade in the slot of the mesh
     * */
    fn writeFade (mut self) {
        if let Ok (dmut draws) = alias self._draws {
            draws:.setObject (OBJECT_FADE, self._fade);
        }
    }

    /**
     * Modify in place the draws of the mesh, after a change of its levels
     * @returns: true iif the recordings have to be done again to draw them
     * */
    fn writeDraws (mut self)-> bool {
        let commands = self.getDraws ();
        if let Ok (dmut draws) = alias self._draws {
            return draws:.setDraws (self.uid, commands);
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Cull the mesh or draw it again, its draws being modified in place
     * */
    pub over setCulled (mut self, culled : bool)-> bool {
        if culled == self.culled { return false; }

        self._super_:.setCulled (culled);
        self:.writeDraws ()
    }

    /**
     * @returns: the two draws of the mesh, the incoming then the outgoing level of a cross-fade, or the level drawn alone
     * then an empty draw, two empty draws when the mesh is culled; their word holds the slot of the mesh above its two
     * low bits, and in them the role of the draw read by the shaders
     * */
    pub over getDraws (self)-> [InstanceDraw] {
        if let Ok (draws) = self._draws {
            if self.culled {
                return copy [InstanceDraw (), InstanceDraw ()];
            }

            let geometry = draws.getGeometry ();
            if let Ok (fading) = self._fadingLevel {
                return copy [self.levelDraw (geometry, draws.slot, self._level, INCOMING_DRAW),
                             self.levelDraw (geometry, draws.slot, fading, OUTGOING_DRAW)];
            }

            return copy [self.levelDraw (geometry, draws.slot, self._level, ALONE_DRAW), InstanceDraw ()];
        }

        []
    }

    /**
     * @returns: the draw of a level of the mesh
     * @params:
     *    - geometry: the geometry of the mesh in the pool of its shader
     *    - slot: the slot of the mesh in the objects of its shader
     *    - level: the level to draw
     *    - role: the role of the draw in a cross-fade
     * */
    fn levelDraw (self, geometry : &GeometryRange, slot : u32, level : usize, role : u32)-> InstanceDraw {
        let lod = self._lods.levels [level];

        let mut draw = InstanceDraw ();
        draw.indexCount = lod.count;
        draw.firstIndex = geometry.firstIndex + lod.firstIndex;
        draw.vertexOffset = cast!i32 (geometry.vertexOffset);
        draw.word = (slot << 2u32) | role;
        draw
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The material used to draw the object
     * */
    @field
    pub fn material (self)-> &Material {
        self._material
    }

    /**
     * @returns: the level of detail drawn whatever the camera, none when it is selected from the camera
     * */
    @field
    pub fn forcedLod (self)-> (usize)? {
        self._forcedLod
    }

    /**
     * Draw a level of detail whatever the camera (the coarsest one past the end of the chain), or none to select it
     * from the camera again
     * */
    @field
    pub fn forcedLod (mut self, level : (usize)?) {
        self._forcedLod = level;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          TRIGGERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over updateTransformation (mut self) {
        self._super_:.updateTransformation ();
        
        if let Ok (dmut draws) = alias self._draws {
            draws:.setObject (OBJECT_WORLD, self._transformation);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BUFFERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Remove the mesh from the draws of the scene, its geometry and its slot being retired
     * */
    fn destroyBuffers (mut self, dmut scene : &Scene) {
        if let Ok (dmut draws) = alias self._draws {
            scene:.releaseDraws (self._material, self);
            scene:.getWindow ():.retire (alias draws);
            self._draws = none;
        }

        if let Ok (matID) = self._matID {
            scene:.freeMaterialRef (matID);
            self._matID = none;
        }

        self._material:.detach ();
    }

}

/**
 * The time a cross-fade between two levels of detail lasts, in milliseconds
 * */
def FADE_DURATION = 250.0f;

/**
 * The role of the draw of a level drawn alone, in the low bits of its first instance, read by the shaders
 * */
def ALONE_DRAW = 0u32;

/**
 * The role of the draw of the outgoing level of a cross-fade
 * */
def OUTGOING_DRAW = 1u32;

/**
 * The role of the draw of the incoming level of a cross-fade
 * */
def INCOMING_DRAW = 2u32;
