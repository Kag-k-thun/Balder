in indexed_mesh;

use balder::core::{_, driver::_};
use balder::core::config::shader::_;
use balder::core::shader::{_, buffers::_};
use balder::math::{matrix, vector};
use balder::scene::node::node3D::{camera, visual::_, visual::lod};
use balder::utils::log;

use std::time::dur;

/**
 * Mesh with two buffers, one for vertices, and one for indices
 * @info: the index buffer holds the levels of detail of the mesh one after the other, all drawn from the same vertices;
 * a change of level cross-fades the two levels with a dithering, during FADE_DURATION
 */
pub class IndexedMesh3D over VisualInstance3D {

    // The material used to draw the node
    let dmut _material : &Material;

    prot { // Local data

        // The data of the mesh to upload on device
        let mut _array : (MeshArray)? = none;

        // The levels of detail of the mesh, the indices dropped after the upload
        let mut _lods : LodChain;

        // Destroy the array after uploading (meaning it can be detached and reattached to the scene)
        let mut _destroyOnUpload : bool = false;

    }

    prot { // Levels of detail

        // The level drawn, the incoming one during a cross-fade
        let mut _level : usize = 0us;

        // The outgoing level of the cross-fade in progress
        let mut _fadingLevel : (usize)? = none;

        // The progress of the cross-fade, from 0 to 1
        let mut _fade : f32 = 0.0f;

        // False until a first level is selected after entering the scene, that one is not faded in
        let mut _selected : bool = false;

        // The level drawn whatever the camera, none to select it from the camera
        let mut _forcedLod : (usize)? = none;

    }

    prot { // Remote data

        // The buffer containing the indices of the mesh
        let dmut _ibo : (&IndexBufferObject)? = none;

        // The buffer containing the vertices of the mesh
        let dmut _vbo : (&VertexBufferObject)? = none;

    }

    prot { // shader binding

        // The buffer containing the world transformation of the visual instance
        let dmut _world : (&UniformBufferObject)? = none;

        // The descriptor set used to attach buffers on deferred pass
        let dmut _descSet : (&DescriptorSet)? = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a new indexed mesh
     * @params:
     *    - lods: the levels of detail of the mesh, LodChain (indices) for the indices of the full mesh only
     *    - array: the vertices of the mesh
     */
    pub self  (name : [c8],
               dmut parent : &Node,
               lods : LodChain,
               array : MeshArray,
               dmut material : &Material,
               shadow : bool = true,
               destroyOnUpload : bool = true)

        with super (name, alias parent, array.aabb (), shadow)
        , _material = alias material
        , _array = (array?)
        , _lods = lods
        , _destroyOnUpload = destroyOnUpload

    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onEnter (mut self, dmut scene : &Scene) {
        self:.destroyBuffers (alias scene);

        {
            if let Ok (array) = self._array && self._lods.indices.len != 0 {
                let dmut win = scene:.getWindow ();
            
                let dmut ibo = copy IndexBufferObject!{u32} (win:.getVulkanDevice (), self._lods.indices);
                self._ibo = (alias ibo)?;

                let dmut vbo = copy VertexBufferObject ();
                self._vbo = (alias vbo)?;

                // the world transformation, then the progress of the cross-fade, padded to a vec4
                let dmut world = copy UniformBufferObject (win:.getVulkanDevice (), mat4::size + vec4::size);
                world:.setData (0, self._transformation, commit-> false);
                world:.setData (mat4::size, self._fade, commit-> true);
                self._world = (alias world)?;

                self:.configureVertices (win:.getVulkanDevice (), array, self._material);
                self:.configureShader ();
            } else {
                log::warn #("IndexBufferObject", "Empty mesh");
            }
        } catch {
            err => {
                log::error #("IndexedMesh3D", "Failed to upload mesh data to device", err);
                self:.destroyBuffers (alias scene);
            }
        }

        if self._destroyOnUpload {
            self._array = none;
            self._lods.indices = [];
        }

        self._selected = false;
    }

    pub over onExit (mut self, dmut scene : &Scene) {
        log::debug #("IndexedMesh3D", "onExit");            
        self:.destroyBuffers (alias scene);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =========================          UPLOAD DATA TO REMOTE BUFFERS          ==========================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Configure the buffers containing the points of the mesh
     * */
    fn configureVertices (mut self, dmut device : &VulkanDevice, array : MeshArray, material : &Material)
        throws BalderError
    {
        let data = array.compactVertices (material, forShadow-> false);
        if let Ok (dmut vbo) = alias self._vbo {
            vbo:.update (alias device, cast!{u32} (array.positions.len), data);
        }
    }

    /**
     * Configure the shader association to the node
     * @params:
     *    - scene: the scene containing the node
     * */
    fn configureShader (mut self)
        throws BalderError
    {
        if let Ok (dmut scene) = alias self:.getScene () {
            let dmut shader = scene:.registerShaderRef (self._material.shaderConfig,                                                         
                                                         alias self):.get ();

            let matID = scene:.registerMaterialRef (self._material.config);
                        
            log::debug #("IndexedMesh3D", "Registered shader to draw ", matID);

            let dmut set = shader:.allocateDescriptorSet (DescriptorContext::OBJECT);

            if let Ok (dmut w) = alias self._world {
                w:.setData (0, self._transformation, commit-> true);
                set:.setUniform (UniformNames::WORLD, w);
            }

            self._material:.attach (scene:.getWindow (), alias set, matID);
            self._descSet = (alias set)?;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          LEVELS OF DETAIL          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select the level whose error, seen from the camera at the point of the bounding sphere closest to it, stays
     * under the threshold; a cross-fade in progress finishes before another level is selected
     * */
    pub over selectLod (mut self, camera : &Camera, height : f32, threshold : f32, delta : Duration)-> bool {
        if self._lods.levels.len < 2us || !self._world.hasValue { return false; }

        if self._fadingLevel.hasValue {
            self._fade += cast!f32 (delta.allMillis) / FADE_DURATION;
            if self._fade < 1.0f {
                self:.writeFade ();
                return false;
            }

            // the fade stays at 1, so the commands still recorded with both levels draw the incoming one only
            self._fade = 1.0f;
            self:.writeFade ();
            self._fadingLevel = none;
            return true;
        }

        let (center, radius) = self.boundingSphere ();
        let eye = camera.position;
        let distance = (eye - center).length ();
        let closest = if distance > radius { center + (eye - center) * (radius / distance) } else { eye };

        let unitSize = camera.screenSize (closest, self.worldScale ()) * height;
        let level = if let Ok (forced) = self._forcedLod {
            if forced < self._lods.levels.len { forced } else { self._lods.levels.len - 1us }
        } else {
            self._lods.select (self._level, unitSize, threshold)
        };
        if level == self._level && self._selected { return false; }

        if self._selected {
            self._fadingLevel = (self._level)?;
            self._fade = 0.0f;
            self:.writeFade ();
        }

        self._level = level;
        self._selected = true;
        true
    }

    /**
     * Write the progress of the cross-fade in the world uniform buffer
     * */
    fn writeFade (mut self) {
        if let Ok (dmut world) = alias self._world {
            world:.setData (mat4::size, self._fade, commit-> true);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register the mesh using the command allocator, the two levels of a cross-fade, their first instance telling the
     * shaders which one is which
     * @assume: the command allocator is in load mode
     * @params:
     *    - cmd: the command allocator in which the mesh has to be registered
     */
    pub over register (mut self, dmut cmd : &IndexedDrawCommandAllocator) {
        if !self._ibo.hasValue { return; }

        if let Ok (fading) = self._fadingLevel {
            let outgoing = self._lods.levels [fading], incoming = self._lods.levels [self._level];
            cmd:.registerIndexedObject (outgoing.count, firstIndex-> outgoing.firstIndex, firstInstance-> OUTGOING_DRAW);
            cmd:.registerIndexedObject (incoming.count, firstIndex-> incoming.firstIndex, firstInstance-> INCOMING_DRAW);
        } else {
            let level = self._lods.levels [self._level];
            cmd:.registerIndexedObject (level.count, firstIndex-> level.firstIndex);
        }
    }

    /**
     * @returns: the number of draws registered by the mesh
     * */
    fn getNbDraws (self)-> u32 {
        if !self._ibo.hasValue { 0u32 }
        else if self._fadingLevel.hasValue { 2u32 }
        else { 1u32 }
    }

    /**
     * Draw the mesh using the command allocator
     * @assume:
     *    - the command allocator is in draw mode
     *    - the shader is already selected
     * @params:
     *    - shader: the shader used to draw
     *    - cmd: the command allocator in which the mesh has to be drawn
     */
    pub over draw (self,  frame : u32, dmut _ : &Shader, dmut cmd : &IndexedDrawCommandAllocator) {
        if let Ok (s) = self._descSet {
            s.select (frame, cmd.getCommandBuffer ());
        }

        if let Ok (v) = self._vbo {
            v.select (cmd.getCommandBuffer ());
        }

        if let Ok (i) = self._ibo {
            i.select (cmd.getCommandBuffer ());
        }

        for _ in 0u32 .. self.getNbDraws () {
            cmd:.drawNextIndexed ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The material used to draw the object
     * */
    @field
    pub fn material (self)-> &Material {
        self._material
    }

    /**
     * @returns: the level of detail drawn whatever the camera, none when it is selected from the camera
     * */
    @field
    pub fn forcedLod (self)-> (usize)? {
        self._forcedLod
    }

    /**
     * Draw a level of detail whatever the camera (the coarsest one past the end of the chain), or none to select it
     * from the camera again
     * */
    @field
    pub fn forcedLod (mut self, level : (usize)?) {
        self._forcedLod = level;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          TRIGGERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over updateTransformation (mut self) {
        self._super_:.updateTransformation ();
        
        if let Ok (dmut world) = alias self._world {
            world:.setData (0, self._transformation, commit-> true);
        }        
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BUFFERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Destroy all allocated buffers on device
     * */
    fn destroyBuffers (mut self, dmut scene : &Scene) {
        let dmut win = scene:.getWindow ();
        if let Ok (dmut ibo) = alias self._ibo {
            win:.retire (alias ibo);
            self._ibo = none;
        }

        if let Ok (dmut vbo) = alias self._vbo {
            win:.retire (alias vbo);
            self._vbo = none;
        }

        if let Ok (dmut world) = alias self._world {
            win:.retire (alias world);
            self._world = none;
        }

        if let Ok (dmut s) = alias self._descSet {
            win:.retire (alias s);
            self._descSet = none;
            scene:.freeShaderRef (self._material.shaderConfig, alias self);
            scene:.freeMaterialRef (self._material.matID);
        }


        self._material:.detach ();        
    }

}

/**
 * The time a cross-fade between two levels of detail lasts, in milliseconds
 * */
def FADE_DURATION = 250.0f;

/**
 * The first instance of the draw of the outgoing level of a cross-fade, read by the shaders (0 draws a level alone)
 * */
def OUTGOING_DRAW = 1u32;

/**
 * The first instance of the draw of the incoming level of a cross-fade
 * */
def INCOMING_DRAW = 2u32;
