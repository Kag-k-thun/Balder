in diffuse;

use balder::core::{_, application::_, shader::_};
use balder::core::config::shader;
use balder::core::config::shader::_;


pub class DiffuseTextureMaterial over Material {

    let dmut _texture : (&RefCount!{&Texture})? = none;

    let _texturePath : [c8];
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (texturePath : [c8], config : MaterialConfig)
        with super (loadRasterShaderConfig (DefaultShaders::TEXTURE_3D), config)                            
        , _texturePath = texturePath        
        throws BalderError
    {}

    __dtor (mut self) {
        self:.dispose ()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load the texture of the material
     * */
    pub over attach (mut self, dmut window : &Window, matID : u32)
        throws BalderError
    {
        self:.dispose ();

        let dmut tex = window:.loadResource!{&Texture2D} (self._texturePath);
        self._texture = (alias tex)?;
        self._matID = matID;
    }

    /**
     * Bind the texture of the material
     * */
    pub over bind (mut self, dmut set : &DescriptorSet)
        throws BalderError
    {
        if let Ok (dmut tex) = alias self._texture {
            set:.setTexture (TextureKind::ALBEDO, tex:.get ());
        }
    }

    /**
     * @returns: the path of the texture, the materials of the same texture being drawn together
     * */
    pub over getBatchKey (self)-> [c8] {
        self._texturePath
    }

    pub over detach (mut self) {
        if let Ok (dmut tex) = alias self._texture {
            tex:.dispose ();
            self._texture = none;
        }
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DISPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self:.detach ();
        }
    }

}
