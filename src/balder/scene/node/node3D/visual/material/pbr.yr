in pbr;

use balder::core::{_, application::_, shader::_};
use balder::core::config::shader;
use balder::core::config::shader::_;
use balder::scene::node::node3D::visual::material::maps;

/**
 * The map standing in for the maps a material has not, the factors of the material used as they are
 * */
def WHITE_MAP = "res:/images/white.png";

/**
 * The normal map standing in for the normal map a material has not, leaving its normals as they are
 * */
def FLAT_NORMAL_MAP = "res:/images/flat_normal.png";

/**
 * A metallic/roughness material drawn with its maps (glTF): their texels multiply the factors of its configuration in
 * the composition, but its normal map, bending its normals in the g-buffer
 * */
pub class MetallicRoughnessMaterial over Material {

    let _maps : MaterialMaps;

    // The textures of the maps, in the order of the slots, once attached
    let dmut _textures : [&RefCount!{&Texture}] = [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (maps : MaterialMaps, config : MaterialConfig)
        with super (loadRasterShaderConfig (DefaultShaders::PBR_3D), config)
        , _maps = maps
        throws BalderError
    {}

    /**
     * Create a material drawn by the configuration of a shader already loaded
     * */
    prot self withShader (shaderConfig : &RasterShaderConfig, maps : MaterialMaps, config : MaterialConfig)
        with super (shaderConfig, config)
        , _maps = maps
    {}

    __dtor (mut self) {
        self:.dispose ()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load the textures of the maps of the material, the default maps standing in for those it has not
     * */
    pub over attach (mut self, dmut window : &Window, matID : u32)
        throws BalderError
    {
        self:.dispose ();

        for slot in self.slots () {
            let dmut tex = window:.loadResource!{&Texture2D} (slot._1, slot._2);
            self._textures ~= [alias tex];
        }

        self._matID = matID;
    }

    /**
     * Bind the textures of the maps of the material
     * */
    pub over bind (mut self, dmut set : &DescriptorSet)
        throws BalderError
    {
        let slots = self.slots ();
        for i, dmut tex in alias self._textures {
            set:.setTexture (slots [i]._0, tex:.get ());
        }
    }

    /**
     * @returns: the paths of the maps, the materials of the same maps being drawn together
     * */
    pub over getBatchKey (self)-> [c8] {
        let mut key = "";
        for slot in self.slots () {
            key = key ~ slot._1 ~ ";";
        }

        key
    }

    pub over detach (mut self) {
        for _, dmut tex in alias self._textures {
            tex:.dispose ();
        }

        self._textures = [];
    }

    pub over clone (self)-> dmut &Material {
        copy MetallicRoughnessMaterial::withShader (self.shaderConfig, self._maps, self.config)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SLOTS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the maps of the material, by the name of their texture in the shader: their path, a default map for
     * those it has not, and whether their texels hold data rather than colours
     * */
    fn slots (self)-> [([c8], [c8], bool)] {
        copy [("base_color", self.orDefault (self._maps.baseColor, WHITE_MAP), false),
              ("metallic_roughness", self.orDefault (self._maps.metallicRoughness, WHITE_MAP), true),
              ("normal", self.orDefault (self._maps.normal, FLAT_NORMAL_MAP), true),
              ("occlusion", self.orDefault (self._maps.occlusion, WHITE_MAP), true),
              ("emissive", self.orDefault (self._maps.emissive, WHITE_MAP), false)]
    }

    /**
     * @returns: the path of a map, or of the default map when the material has not this one
     * */
    fn orDefault (self, path : [c8], default : [c8])-> [c8] {
        if path == "" { default } else { path }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DISPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self:.detach ();
        }
    }

}
