in constant;

use balder::core::_;
use balder::core::application::window;
use balder::core::config::shader;
use balder::core::config::shader::_;
use balder::core::shader::desc_set;


pub class ConstantMaterial over Material {

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (config : MaterialConfig)
        with super (loadRasterShaderConfig (DefaultShaders::CONSTANT_3D), config)
        throws BalderError
    {}

    /**
     * Create a material drawn by the configuration of a shader already loaded
     * */
    prot self withShader (shaderConfig : &RasterShaderConfig, config : MaterialConfig)
        with super (shaderConfig, config)
    {}

    __dtor (mut self) {
        self:.dispose ()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Attach the material, it has no resource
     * */
    pub over attach (mut self, dmut _ : &Window, matID : u32) {
        self._matID = matID;
    }

    /**
     * The material binds nothing, its draws only need the storage buffer of the objects
     * */
    pub over bind (mut self, dmut _ : &DescriptorSet) {}

    /**
     * @returns: the key of the constant materials, which all share the same (empty) resources
     * */
    pub over getBatchKey (self)-> [c8] {
        ""
    }

    pub over detach (mut self) {}

    pub over clone (self)-> dmut &Material {
        copy ConstantMaterial::withShader (self.shaderConfig, self.config)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DISPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self:.detach ();
        }
    }

}
