in maps;

/**
 * The paths of the maps of a metallic/roughness material, empty for the maps it has not
 * */
@data
pub record MaterialMaps {

    // The base colour, in sRGB
    pub let baseColor : [c8] = "";

    // The roughness in green and the metalness in blue (as glTF packs them), in a linear space
    pub let metallicRoughness : [c8] = "";

    // The normals in tangent space, their y up the image, in a linear space
    pub let normal : [c8] = "";

    // The occlusion in red, in a linear space
    pub let occlusion : [c8] = "";

    // The emissive colour, in sRGB
    pub let emissive : [c8] = "";

}
