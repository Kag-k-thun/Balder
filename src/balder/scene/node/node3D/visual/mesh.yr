in mesh;

use balder::core::error;
use balder::core::config::shader::raster;
use balder::math::bounds;
use balder::scene::animation::skin;
use balder::scene::node::node3D::visual::{array, cluster, lod};

lazy dmut __MESH_UID__ = copy [0us];

/**
 * @returns: a new uniq id of mesh geometry
 * */
fn nextMeshUID()-> usize {
    atomic {
        __MESH_UID__[0] += 1us;
        __MESH_UID__[0]
    }
}

/**
 * The vertices and the levels of detail of a mesh, shared by the meshes drawing it (see IndexedMesh3D): the geometry is
 * placed once in the geometry pool of each shader drawing it, and the meshes drawing it with the same material key are
 * drawn by one instanced command
 * @info: the vertices and the indices can be released once placed, the levels being kept to draw them, and the positions
 * and the indices of the full mesh when its scene picks it
 * */
@final
pub class MeshGeometry {

    // The uniq id of the geometry, keying its place in the geometry pools
    pub let uid : usize;

    // The box enclosing the positions
    pub let aabb : Aabb;

    // The joints moving the vertices, none for a rigid mesh
    pub let skin : (Skin)?;

    // The levels of detail, the indices dropped once released
    let mut _lods : LodChain;

    // The clusters of the levels, kept once released (see buildClusters)
    let mut _clusters : [MeshCluster] = [];

    // The vertices, none once released
    let mut _array : (MeshArray)?;

    // The triangles of the full mesh, for the rays to hit them, kept once the vertices are released when the scene picks
    // (see Scene.keepsTriangles), none once released with them
    let dmut _triangles : (&TriangleBvh)?;

    // The number of meshes created to draw the geometry
    let mut _sharers : usize = 0us;

    /**
     * @params:
     *    - array: the vertices of the mesh
     *    - lods: the levels of detail of the mesh, their indices following each other, split into clusters (their
     *            triangles reordered)
     *    - skin: the joints moving the vertices, which give their indices and weights, none for a rigid mesh
     * */
    pub self (array : MeshArray, lods : LodChain, skin : (Skin)? = none)
        with uid = nextMeshUID ()
        , aabb = array.aabb ()
        , skin = skin
        , _lods = lods
        , _array = (array)?
        , _triangles = (copy TriangleBvh (array.positions, lods.fullIndices))?
    {
        let (clustered, clusters) = buildClusters (array.positions, lods);
        self._lods = clustered;
        self._clusters = clusters;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the levels of detail of the mesh, without indices once released
     * */
    @field
    pub fn lods (self)-> LodChain {
        self._lods
    }

    /**
     * @returns: the clusters of the levels of detail, those of a level following each other
     * */
    @field
    pub fn clusters (self)-> [MeshCluster] {
        self._clusters
    }

    /**
     * @returns: the largest number of clusters of a level, the most a draw of the geometry has
     * */
    @field
    pub fn clusterBound (self)-> u32 {
        let mut bound = 0u32;
        for l in self._lods.levels {
            if l.clusterCount > bound { bound = l.clusterCount; }
        }

        bound
    }

    /**
     * @returns: true iif the geometry has no index to draw
     * */
    @field
    pub fn isEmpty (self)-> bool {
        self._lods.levels.len == 0us || (self._array.hasValue && self._lods.indices.len == 0us)
    }

    /**
     * @returns: true iif the triangles of the full mesh are kept, for the rays to hit them
     * */
    @field
    pub fn hasTriangles (self)-> bool {
        self._triangles.hasValue
    }

    /**
     * @returns: true iif the vertices and the indices were released
     * */
    @field
    pub fn isReleased (self)-> bool {
        !self._array.hasValue
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PICKING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @info: the triangles are those of the full mesh, whatever the level drawn
     * @params:
     *    - ray: the ray, in the space of the positions
     * @returns: the distance along a ray at which it hits a triangle of the mesh first, none when it misses them all or
     * when they were released
     * */
    pub fn raycast (mut self, ray : Ray)-> (f32)? {
        if let Ok (dmut triangles) = alias self._triangles {
            if let Ok (hit) = triangles:.raycast (ray) {
                return (hit.distance)?;
            }
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Count one more mesh drawing the geometry
     * */
    pub fn share (mut self) {
        self._sharers += 1us;
    }

    /**
     * @returns: the vertices laid out as a shader reads them, and the indices of every level
     * @params:
     *    - config: the configuration of the shader, its vertex entries
     * @throws: when the vertices were released
     * */
    pub fn compact (self, config : &RasterShaderConfig)-> ([f32], [u32])
        throws BalderError
    {
        if let Ok (array) = self._array {
            return (array.compactVertices (config, forShadow-> false), self._lods.indices);
        }

        throw copy BalderError ("The vertices of the mesh were released after their upload");
    }

    /**
     * Release the vertices and the indices once placed in a geometry pool, unless other meshes draw the geometry: they
     * may place it in the pool of another shader, or again after it left the scene
     * @params:
     *    - keepTriangles: true to keep the triangles of the full mesh, the scene picking it (see Scene.keepsTriangles)
     * */
    pub fn releaseUnshared (mut self, keepTriangles : bool) {
        if self._sharers > 1us { return; }

        self._array = none;
        self._lods.indices = [];
        if !keepTriangles {
            self._triangles = none;
        }
    }

}
