in material;

use balder::core::_;
use balder::core::application::window;
use balder::core::config::shader::raster;
use balder::core::shader::desc_set;
use balder::math::vector;

use std::algorithm::comparison;

pub mod ::constant;
pub mod ::diffuse;
pub mod ::maps;
pub mod ::pbr;

/**
 * The constant factors of a metallic/roughness material, read by the composition through the index of the material, the
 * texels of its maps multiplying them in the g-buffer
 * */
pub record MaterialConfig {

    // The colour of the surface, linear, multiplying the texels of its base colour (decoded from sRGB when sampled)
    pub let mut baseColor : vec3 = makeVec3 (1.0f, 1.0f, 1.0f);

    // The light the surface emits whatever its lights, linear, multiplying the texels of its emissive map (decoded from
    // sRGB when sampled)
    pub let mut emissive : vec3 = vec3 ();

    // 1 for a metal, whose base colour is the colour of its reflections, 0 for a dielectric, whose base colour is its
    // diffuse colour; multiplying the texels of its metallic map
    pub let mut metallic : f32 = 0.0f;

    // The perceptual roughness of the surface, from 0 (a mirror) to 1, multiplying the texels of its roughness map
    pub let mut roughness : f32 = 1.0f;

    // The reflectance of the surface where it is a dielectric, facing the eye: 0.08 times it, 0.5 giving the 4% of most
    // dielectrics
    pub let mut specular : f32 = 0.5f;

    // The strength of the occlusion of the surface, from 0 (none) to 1 (the texels of its occlusion map)
    pub let mut occlusion : f32 = 1.0f;

    pub self () {}

    /**
     * Convert a Phong material (the materials of OBJ files): a dielectric of its diffuse colour, the glossiness of its
     * highlights turned into a roughness
     * @info: a Blinn-Phong exponent n matches a distribution of roughness² = sqrt (2 / (n + 2))
     * @params:
     *    - diffuse: the diffuse colour
     *    - specular: the specular colour, its strongest component giving the reflectance (0.5 for 4%)
     *    - shininess: the exponent of the highlights
     *    - emissive: the emissive colour
     * */
    pub self phong (diffuse : vec3, specular : vec3, shininess : f32, emissive : vec3)
        with baseColor = diffuse
        , emissive = emissive
    {
        let exponent = max (shininess, 0.0f);
        self.roughness = core::math::sqrt (core::math::sqrt (2.0f / (exponent + 2.0f)));
        self.specular = clamp (max (max (specular.x, specular.y), specular.z), 0.0f, 1.0f);
    }

    pub fn opEquals (self, mat : MaterialConfig)-> bool {
        cte for i in 0 .. typeof (self)::field_infos.len {
            let name = cte {typeof (self)::field_infos [i].name};
            
            if __pragma!field (self, name) != __pragma!field (mat, name) {
                return false;
            }
        }

        true
    }   
}

@abstract
pub class Material {

    pub let shaderConfig : &RasterShaderConfig;
    pub let config : MaterialConfig;
    
    let mut _matID : u32;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    pub self (shaderConfig : &RasterShaderConfig, config : MaterialConfig)
        with shaderConfig = shaderConfig
        , config = config
        , _matID = 0
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Load the resources of the material (its textures)
     * @params:
     *    - window: the window loading the resources
     *    - matID: the index of the material in the composition pass
     * */
    pub fn attach (mut self, dmut window : &Window, matID : u32)
        throws BalderError;

    /**
     * Bind the resources of the material in the descriptor set of a batch, shared by the materials of the same key
     * @assume: the material is attached
     * */
    pub fn bind (mut self, dmut descSet : &DescriptorSet)
        throws BalderError;

    /**
     * @returns: the key of the resources of the material, the draws of the materials of the same shader and the same key
     * being drawn together with the resources bound by one of them
     * */
    pub fn getBatchKey (self)-> [c8];

    /**
     * Release the resources of the material
     * */
    pub fn detach (mut self);

    /**
     * @returns: a material of the same shader, configuration and resources, detached, to draw another mesh with
     * */
    pub fn clone (self)-> dmut &Material;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn matID (self)-> u32 {
        self._matID
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    impl Disposable;

}
