in flight;

use balder::math::vector;

use std::math;
use std::algorithm::comparison;

// The bounds of the pace of a flight, in distances per second
pub def MIN_PACE = 0.03125f;
pub def MAX_PACE = 32.0f;

// The factor the pace is multiplied by for a notch of the wheel
def PACE_STEP = 1.25f;

// The factor the speed is multiplied by while flying faster (Shift held)
pub def FAST_FACTOR = 4.0f;

// How fast the velocity eases toward the one wanted, the share of the gap closed in a second being 1 - exp(-SHARPNESS)
def SHARPNESS = 10.0f;

// The longest step of a flight in seconds, a frame held longer moving the eye no farther
def MAX_STEP = 0.1f;

// The share of its speed below which an eye slowing down stops
def STOP_SHARE = 0.001f;

/**
 * The flight of an eye through a scene, its velocity easing toward the one asked for, the eye moving at a pace of the
 * distance it looks at (the distance to what is framed), so that a room and a terrain are crossed alike
 * */
@data
pub record CameraFlight {

    // The velocity of the eye, in units per second
    pub let mut velocity: vec3 = vec3();

    // The speed of the eye, in distances per second
    pub let mut pace: f32 = 1.0f;

    pub self () {}

    /**
     * Fly faster or slower
     * @params:
     *    - notches: the notches of the wheel, positive to fly faster
     * */
    pub fn faster(mut self, notches: i32) {
        let factor = math::pow(PACE_STEP, cast!f32(notches));
        self.pace = clamp(self.pace * factor, MIN_PACE, MAX_PACE);
    }

    /**
     * Ease the velocity toward the one asked for and move the eye by it
     * @params:
     *    - direction: the direction to fly to (the sum of the keys held), zero to slow down to a stop
     *    - distance: the distance the eye looks at, in units, the speed being the pace times that distance
     *    - fast: true to fly FAST_FACTOR times faster
     *    - seconds: the time since the last step
     * @returns: the move of the eye during that time, in units
     * */
    pub fn step(mut self, direction: vec3, distance: f32, fast: bool, seconds: f32)-> vec3 {
        let dt = clamp(seconds, 0.0f, MAX_STEP);
        let length = direction.length();
        let speed = self.pace * distance * (if fast { FAST_FACTOR } else { 1.0f });
        let wanted = if length > 0.0f { direction * (speed / length) } else { vec3() };

        self.velocity = self.velocity + (wanted - self.velocity) * (1.0f - math::exp(-SHARPNESS * dt));

        // slowing down, the eye stops once it would no longer be seen moving rather than creeping on forever
        if length == 0.0f && self.velocity.length() <= speed * STOP_SHARE {
            self.velocity = vec3();
        }

        self.velocity * dt
    }

    /**
     * @returns: true iif the eye is moving
     * */
    pub fn isMoving(self)-> bool {
        self.velocity.length() > 0.0f
    }

    /**
     * Stop the eye at once
     * */
    pub fn stop(mut self) {
        self.velocity = vec3();
    }

}
