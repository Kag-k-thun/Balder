in debug_view;

/**
 * What the g-buffer of a camera shows instead of the materials lit: how the geometry is drawn, each pixel in a flat
 * colour lit from the eye, or a channel of the materials alone, unlit (a factor times the texels of its map)
 * */
pub enum DebugView : u32
| NONE       = 0u32  // the materials, lit by the lights of the scene
| TRIANGLES  = 1u32  // a colour per triangle
| CLUSTERS   = 2u32  // a colour per cluster of triangles, the unit of the culling on the GPU
| LODS       = 3u32  // a colour per level of detail, from green (the full mesh) to red and magenta (the coarsest)
| WIREFRAME  = 4u32  // the edges of the triangles seen, light over a flat grey, the hidden ones left out    
| BASE_COLOR = 5u32  // the base colour of the materials
| ROUGHNESS  = 6u32  // their roughness, in grey
| METALLIC   = 7u32  // their metalness, in grey
| NORMALS    = 8u32  // the normals bent by their normal maps, in world space, from [-1, 1] to [0, 1]
| OCCLUSION  = 9u32  // the occlusion of their maps, in grey, the occlusion of the screen left out
| EMISSIVE   = 10u32; // the light they emit
