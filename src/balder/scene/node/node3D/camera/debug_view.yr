in debug_view;

/**
 * What the g-buffer of a camera shows instead of the materials, each pixel in a flat colour lit from the eye, to look at
 * how the geometry is drawn
 * */
pub enum DebugView : u32
| NONE      = 0u32  // the materials, lit by the lights of the scene
| TRIANGLES = 1u32  // a colour per triangle
| CLUSTERS  = 2u32  // a colour per cluster of triangles, the unit of the culling on the GPU
| LODS      = 3u32; // a colour per level of detail, from green (the full mesh) to red and magenta (the coarsest)
