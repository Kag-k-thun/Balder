in ortho;

use balder::math::{utils, vector};

/**
 * A camera of an orthographic projection: a length covers the same height of its image at any distance, the view a box
 * of a height (see size) as wide as the aspect of the scene on screen makes it
 * */
pub class OrthoCamera over Camera {

    // The height of the view, in world units
    let mut _size : f32 = 10.0f;

    // The width of the view over its height
    let mut _aspect : f32 = 1920.0f / 1080.0f;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (name : [c8], dmut parent : &Node)
        with super (name, alias parent)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the height of the view, in world units
     * */
    @field
    pub fn size (self)-> f32 {
        self._size
    }

    /**
     * Change the height of the view, in world units, its width following the aspect
     * */
    @field
    pub fn size (mut self, size : f32) {
        self._size = size;
        self:.updateView ();
    }

    /**
     * @returns: the width of the view over its height
     * */
    @field
    pub fn aspect (self)-> f32 {
        self._aspect
    }

    @field
    pub fn aspect (mut self, aspect : f32) {
        self._aspect = aspect;
        self:.updateView ();
    }

    pub over projection (self)-> CameraProjection {
        CameraProjection::ORTHOGRAPHIC
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPUTATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over computeProj (mut self) {
        let h = self._size / 2.0f, w = h * self._aspect;
        self._proj = ortho!{f32} (-w, w, -h, h, self._near, self._far);
    }

    /**
     * @info: the projection is orthographic, a length covers the same height at any distance
     * */
    pub over screenSize (self, _ : vec3, size : f32)-> f32 {
        if self._size <= 0.0f { return 0.0f; }

        size / self._size
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The camera takes the aspect of the scene on screen, and follows it, as a perspective camera does
     * */
    pub over onEnter (mut self, dmut scene : &Scene) {
        self._super:.onEnter (alias scene);

        self:.updateAspect (scene.aspectWidth, scene.aspectHeight);
        scene:.aspectChanged ():.connect (scene:.getWindow ():.getSlotEmitter (), &self:.updateAspect);
    }

    pub over onExit (mut self, dmut scene : &Scene) {
        self._super:.onExit (alias scene);
        scene:.aspectChanged ():.disconnect (&self:.updateAspect);
    }

    /**
     * Take the aspect of the scene on screen, a size of nothing (the scene not laid out yet) leaving it as it is
     * */
    fn updateAspect (mut self, width : u32, height : u32) {
        if width == 0u32 || height == 0u32 { return; }

        self.aspect = cast!f32 (width) / cast!f32 (height);
    }

}
