in icon;

use balder::math::vector;
use balder::scene::utils::post::gizmo::shape;

use std::math;

/**
 * The width of the strokes of the glyphs, in units of the icons
 * */
def STROKE = 0.24f;

/**
 * The opacity of the strokes drawn fainter than the others (the beam of a spot light)
 * */
def FAINT = 0.6f;

/**
 * The glyph an editor draws a node without geometry as (a light, a camera, an empty...), over the image of the scene at
 * the origin of the node, at a size on the image wherever the node is, the node being picked by it (see
 * Node3D::editorIcon)
 * @info: the shapes are in units of the icon, the glyph within the square from (-1, -1) to (1, 1), y going down as in the
 * image; their colours are multiplied by the colour of the state of the icon (not selected, under the cursor, selected),
 * so a white shape is drawn in that colour, at its opacity
 * */
@data
pub record NodeIcon {

    // The shapes of the glyph, the first ones drawn under the next ones
    pub let shapes: [GizmoShape] = [];

    // The size of the icon, its disc, its glyph and the distance it is picked within scaled by it: 1 for the icons of the
    // nodes, smaller for the many points of a path
    pub let size: f32 = 1.0f;

}

/**
 * The glyphs of the nodes of Balder
 * */
pub mod NodeIcon {

    /**
     * @returns: the glyph of a direction light, a sun: a circle and its rays
     * */
    pub fn sun()-> NodeIcon {
        let mut shapes: [GizmoShape] = copy [GizmoShape::ring(vec2(), 0.36f, STROKE, white())];
        for k in 0us .. 8us {
            let angle = cast!f32(math::PI) * cast!f32(cast!u64(k)) / 4.0f;
            let ray = makeVec2(math::cos(angle), math::sin(angle));
            shapes ~= [GizmoShape(ray * 0.62f, ray * 0.94f, STROKE, white())];
        }

        NodeIcon(shapes-> shapes)
    }

    /**
     * @returns: the glyph of a point light, a bulb: its glass and its base
     * */
    pub fn bulb()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape::ring(makeVec2(0.0f, -0.22f), 0.52f, STROKE, white()),
                                GizmoShape(makeVec2(-0.26f, 0.5f), makeVec2(0.26f, 0.5f), STROKE, white()),
                                GizmoShape(makeVec2(-0.16f, 0.78f), makeVec2(0.16f, 0.78f), STROKE, white())])
    }

    /**
     * @returns: the glyph of a spot light: a lamp shining down, its beam fainter
     * */
    pub fn spot()-> NodeIcon {
        let top0 = makeVec2(-0.24f, -0.86f), top1 = makeVec2(0.24f, -0.86f);
        let low0 = makeVec2(-0.46f, -0.34f), low1 = makeVec2(0.46f, -0.34f);
        NodeIcon(shapes-> copy [GizmoShape(top0, top1, low1, white()),
                                GizmoShape(top0, low1, low0, white()),
                                GizmoShape(makeVec2(-0.46f, -0.12f), makeVec2(-0.86f, 0.82f), STROKE, white(alpha-> FAINT)),
                                GizmoShape(makeVec2(0.0f, -0.12f), makeVec2(0.0f, 0.86f), STROKE, white(alpha-> FAINT)),
                                GizmoShape(makeVec2(0.46f, -0.12f), makeVec2(0.86f, 0.82f), STROKE, white(alpha-> FAINT))])
    }

    /**
     * @returns: the glyph of a camera: its body and its lens
     * */
    pub fn camera()-> NodeIcon {
        let a = makeVec2(-0.88f, -0.46f), b = makeVec2(0.24f, -0.46f);
        let c = makeVec2(0.24f, 0.46f), d = makeVec2(-0.88f, 0.46f);
        NodeIcon(shapes-> copy [GizmoShape(a, b, STROKE, white()),
                                GizmoShape(b, c, STROKE, white()),
                                GizmoShape(c, d, STROKE, white()),
                                GizmoShape(d, a, STROKE, white()),
                                GizmoShape(makeVec2(0.3f, 0.0f), makeVec2(0.9f, -0.42f), makeVec2(0.9f, 0.42f), white())])
    }

    /**
     * @returns: the glyph of an empty, placing the nodes under it: three axes from its origin
     * */
    pub fn empty()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape(vec2(), makeVec2(0.0f, -0.86f), STROKE, white()),
                                GizmoShape(vec2(), makeVec2(-0.76f, 0.46f), STROKE, white()),
                                GizmoShape(vec2(), makeVec2(0.76f, 0.46f), STROKE, white()),
                                GizmoShape::ring(vec2(), 0.0f, 0.42f, white())])
    }

    /**
     * @returns: the glyph of a marker of no purpose given: a cross, a diamond on its centre
     * */
    pub fn marker()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape(makeVec2(-0.86f, 0.0f), makeVec2(0.86f, 0.0f), STROKE, white()),
                                GizmoShape(makeVec2(0.0f, -0.86f), makeVec2(0.0f, 0.86f), STROKE, white()),
                                GizmoShape(makeVec2(0.0f, -0.36f), makeVec2(0.36f, 0.0f), makeVec2(0.0f, 0.36f), white()),
                                GizmoShape(makeVec2(0.0f, -0.36f), makeVec2(0.0f, 0.36f), makeVec2(-0.36f, 0.0f), white())])
    }

    /**
     * @returns: the glyph of a spawn point: a figure, its head and its body
     * */
    pub fn spawnPoint()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape::ring(makeVec2(0.0f, -0.52f), 0.0f, 0.62f, white()),
                                GizmoShape(makeVec2(0.0f, -0.12f), makeVec2(0.62f, 0.86f), makeVec2(-0.62f, 0.86f), white())])
    }

    /**
     * @returns: the glyph of a waypoint: a flag on its pole
     * */
    pub fn waypoint()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape(makeVec2(-0.5f, -0.86f), makeVec2(-0.5f, 0.86f), STROKE, white()),
                                GizmoShape(makeVec2(-0.5f, -0.86f), makeVec2(0.72f, -0.48f), makeVec2(-0.5f, -0.1f), white())])
    }

    /**
     * @returns: the glyph of an attachment socket: a ring about a dot
     * */
    pub fn socket()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape::ring(vec2(), 0.62f, STROKE, white()),
                                GizmoShape::ring(vec2(), 0.0f, 0.5f, white()),
                                GizmoShape(makeVec2(0.0f, -0.62f), makeVec2(0.0f, -0.92f), STROKE, white()),
                                GizmoShape(makeVec2(0.0f, 0.62f), makeVec2(0.0f, 0.92f), STROKE, white())])
    }

    /**
     * @returns: the glyph of a path: a curve between two points
     * */
    pub fn path()-> NodeIcon {
        let points = [makeVec2(-0.78f, 0.62f), makeVec2(-0.48f, -0.1f), makeVec2(0.0f, 0.0f), makeVec2(0.48f, 0.1f),
                      makeVec2(0.78f, -0.62f)];
        let mut shapes: [GizmoShape] = [];
        for k in 0us .. points.len - 1us {
            shapes ~= [GizmoShape(points[k], points[k + 1us], STROKE, white())];
        }

        shapes ~= [GizmoShape::ring(points[0], 0.0f, 0.42f, white()),
                   GizmoShape::ring(points[points.len - 1us], 0.0f, 0.42f, white())];
        NodeIcon(shapes-> shapes)
    }

    /**
     * @returns: the glyph of a point of a path, a dot, at a size smaller than the other icons
     * */
    pub fn pathPoint()-> NodeIcon {
        NodeIcon(shapes-> copy [GizmoShape::ring(vec2(), 0.0f, 0.9f, white())], size-> 0.55f)
    }

    /**
     * @returns: the glyph of a volume: a box seen from a corner
     * */
    pub fn volume()-> NodeIcon {
        let top = makeVec2(0.0f, -0.86f), centre = makeVec2(0.0f, 0.0f), bottom = makeVec2(0.0f, 0.86f);
        let leftUp = makeVec2(-0.76f, -0.43f), leftDown = makeVec2(-0.76f, 0.43f);
        let rightUp = makeVec2(0.76f, -0.43f), rightDown = makeVec2(0.76f, 0.43f);
        NodeIcon(shapes-> copy [GizmoShape(top, rightUp, STROKE, white()),
                                GizmoShape(rightUp, rightDown, STROKE, white()),
                                GizmoShape(rightDown, bottom, STROKE, white()),
                                GizmoShape(bottom, leftDown, STROKE, white()),
                                GizmoShape(leftDown, leftUp, STROKE, white()),
                                GizmoShape(leftUp, top, STROKE, white()),
                                GizmoShape(centre, leftUp, STROKE, white(alpha-> FAINT)),
                                GizmoShape(centre, rightUp, STROKE, white(alpha-> FAINT)),
                                GizmoShape(centre, bottom, STROKE, white(alpha-> FAINT))])
    }

    /**
     * @returns: white, at an opacity
     * */
    fn white(alpha: f32 = 1.0f)-> vec4 {
        makeVec4(1.0f, 1.0f, 1.0f, alpha)
    }

}
