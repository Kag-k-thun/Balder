in body;

use balder::core::application::signal;
use balder::math::bounds;
use balder::scene::physics;

/**
 * A body of the physics of a scene: a collider placed by the transformation of the node in the physics world of the
 * scene it enters, hit by the queries of the scene (see Scene::raycast) and told of the bodies it touches
 * @info:
 * =====
 * The node holds the handle of its body in the world of its scene, not the body: it adds its body entering a scene and
 * removes it leaving the scene, and a transformation set on the node (or on one of its parents) moves the body. The
 * layers of the body and its mask choose the bodies it touches and the queries hitting it (see BodySettings).
 *
 * The contacts are those of the last update of the scene, after the nodes are ticked: contactBegan is emitted with the
 * other body when the two start touching, contactStayed at each update they still touch, contactEnded when they no
 * longer do, or one of them leaves the scene. A body only touches the others when one of the two is kinematic or a
 * trigger; nothing stops the bodies passing through each other yet, a trigger reporting the bodies it overlaps.
 * ====
 * */
pub class PhysicsBody3D over Node3D {

    // The shape of the collider, in the space of the node
    let mut _shape: ColliderShape;

    // How the body takes part in the physics of its scene
    let mut _settings: BodySettings;

    // The handle of the body in the physics world of the scene, none outside a scene
    let mut _handle: (u32)? = none;

    // Emitted with the other body when the two start touching
    let dmut _contactBegan: &Signal!{&PhysicsBody3D} = copy Signal!{&PhysicsBody3D} ();

    // Emitted with the other body at each update the two still touch
    let dmut _contactStayed: &Signal!{&PhysicsBody3D} = copy Signal!{&PhysicsBody3D} ();

    // Emitted with the other body when the two no longer touch
    let dmut _contactEnded: &Signal!{&PhysicsBody3D} = copy Signal!{&PhysicsBody3D} ();

    /**
     * @info: the transformation of the node is computed under its parent at once, its body entering the world of a scene
     * where the node is
     * @params:
     *    - name: the name of the node
     *    - parent: the node the body is attached to
     *    - shape: the shape of the collider, in the space of the node
     *    - settings: how the body takes part in the physics of its scene
     * */
    pub self (name: [c8], dmut parent: &Node, shape: ColliderShape = ColliderShape(), settings: BodySettings = BodySettings())
        with super(name, alias parent)
        , _shape = shape
        , _settings = settings
    {
        self:.updateTransformation();
    }

    pub over onEnter(mut self, dmut scene: &Scene) {
        scene:.registerBody(alias self);
    }

    pub over onExit(mut self, dmut scene: &Scene) {
        scene:.removeBody(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the shape of the collider, in the space of the node
     * */
    @field
    pub fn shape(self)-> ColliderShape {
        self._shape
    }

    /**
     * Change the shape of the collider, the body in the world of the scene and the bounds of the node following
     * */
    @field
    pub fn shape(mut self, shape: ColliderShape) {
        self._shape = shape;
        self:.invalidateBounds();
        self:.notifyChanged();
    }

    /**
     * @returns: how the body takes part in the physics of its scene
     * */
    @field
    pub fn settings(self)-> BodySettings {
        self._settings
    }

    /**
     * Change how the body takes part in the physics of its scene, its contacts following at the next update
     * */
    @field
    pub fn settings(mut self, settings: BodySettings) {
        self._settings = settings;
        self:.notifyChanged();
    }

    /**
     * @returns: the layers the body is in, one bit by layer
     * */
    @field
    pub fn layer(self)-> u32 {
        self._settings.layer
    }

    /**
     * Put the body in other layers, one bit by layer
     * */
    @field
    pub fn layer(mut self, layer: u32) {
        self._settings.layer = layer;
        self:.notifyChanged();
    }

    /**
     * @returns: the layers of the bodies the body touches, one bit by layer
     * */
    @field
    pub fn mask(self)-> u32 {
        self._settings.mask
    }

    /**
     * Change the layers of the bodies the body touches, one bit by layer
     * */
    @field
    pub fn mask(mut self, mask: u32) {
        self._settings.mask = mask;
        self:.notifyChanged();
    }

    /**
     * @returns: the handle of the body in the physics world of its scene, none outside a scene
     * */
    @field
    pub fn handle(self)-> (u32)? {
        self._handle
    }

    /**
     * Change the handle of the body in the physics world of its scene, given by the scene when the body enters it and
     * taken back when it leaves it (see ScenePhysics)
     * */
    pub fn setHandle(mut self, handle: (u32)?) {
        self._handle = handle;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Connect the signal emitted with the other body when the two start touching
     * */
    pub fn contactBegan(mut self)-> dmut &Signal!{&PhysicsBody3D} {
        alias self._contactBegan
    }

    /**
     * Connect the signal emitted with the other body at each update of the contacts the two still touch
     * */
    pub fn contactStayed(mut self)-> dmut &Signal!{&PhysicsBody3D} {
        alias self._contactStayed
    }

    /**
     * Connect the signal emitted with the other body when the two no longer touch, or one of them left the scene
     * */
    pub fn contactEnded(mut self)-> dmut &Signal!{&PhysicsBody3D} {
        alias self._contactEnded
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPUTATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Move the body in the world of its scene with the node
     * */
    over updateTransformation(mut self) {
        self._super_:.updateTransformation();
        if !self._handle.hasValue { return; }

        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.onBodyMoved(self);
        }
    }

    /**
     * @returns: the box enclosing the collider in the world, the body being framed by it
     * */
    over computeOwnBounds(mut self)-> Aabb {
        Collider(self._shape, self.transformation).bounds
    }

    /**
     * Tell the scene the shape or the settings of the body changed
     * */
    fn notifyChanged(mut self) {
        if !self._handle.hasValue { return; }

        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.onBodyChanged(self);
        }
    }

}
