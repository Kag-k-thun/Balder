in body;

mod ::utils;

use balder::core::error;
use balder::core::application::signal;
use balder::math::{bounds, matrix, rigid_transform, utils, vector};
use balder::scene::physics;
use balder::scene::node::node3D::{body_shape, icon};
use balder::scene::property::{choice_property, condition, group, kind, node_property, node_schema, range, typed_property};

/**
 * A body of the physics of a scene: a collider placed by the transformation of the node in the physics world of the
 * scene it enters, hit by the queries of the scene (see Scene::raycast) and told of the bodies it touches
 * @info:
 * =====
 * The node holds the handle of its body in the world of its scene, not the body: it adds its body entering a scene and
 * removes it leaving the scene, and a transformation set on the node (or on one of its parents) moves the body. The
 * layers of the body and its mask choose the bodies it touches and the queries hitting it (see BodySettings).
 *
 * A dynamic body is moved by the physics of its scene, its node placed where the simulation is at each tick (see
 * placeFromPhysics); it is pushed by the game through its velocities, impulses and forces. A static or a kinematic body
 * is placed by its node, a kinematic body pushing and carrying what it touches by the velocity of its moves.
 *
 * The contacts are those of the last tick of the scene, after the nodes are ticked: contactBegan is emitted with the
 * other body when the two start touching, contactStayed at each tick they still touch, contactEnded when they no
 * longer do, or one of them leaves the scene. Two static bodies never touch; a trigger reports the bodies it overlaps,
 * stopping none of them.
 *
 * The body knows the shape it is described by (see BodyShape), the one the scene files and an editor give: a primitive
 * of its sizes, the hulls or the triangles of a model, or the volumes under it (see reshape). A shape set by the game
 * as a hull, a mesh or a compound is described by none, a scene file not telling where it comes from.
 * ====
 * */
pub class PhysicsBody3D over Node3D {

    // The shape of the collider, in the space of the node
    let mut _shape: ColliderShape;

    // The shape the collider is described by, none for a hull, a mesh or a compound set as a collider (see shape)
    let mut _described: (BodyShape)?;

    // How the body takes part in the physics of its scene
    let mut _settings: BodySettings;

    // The handle of the body in the physics world of the scene, none outside a scene
    let mut _handle: (u32)? = none;

    // Emitted with the other body when the two start touching
    let dmut _contactBegan: &Signal!{&PhysicsBody3D} = copy Signal!{&PhysicsBody3D} ();

    // Emitted with the other body at each update the two still touch
    let dmut _contactStayed: &Signal!{&PhysicsBody3D} = copy Signal!{&PhysicsBody3D} ();

    // Emitted with the other body when the two no longer touch
    let dmut _contactEnded: &Signal!{&PhysicsBody3D} = copy Signal!{&PhysicsBody3D} ();

    /**
     * @info: the transformation of the node is computed under its parent at once, its body entering the world of a scene
     * where the node is
     * @params:
     *    - name: the name of the node
     *    - parent: the node the body is attached to
     *    - shape: the shape of the collider, in the space of the node
     *    - settings: how the body takes part in the physics of its scene
     * */
    pub self (name: [c8], dmut parent: &Node, shape: ColliderShape = ColliderShape(), settings: BodySettings = BodySettings())
        with super(name, alias parent)
        , _shape = shape
        , _described = BodyShape::describing(shape)
        , _settings = settings
    {
        self:.updateTransformation();
    }

    pub over onEnter(mut self, dmut scene: &Scene) {
        scene:.registerBody(alias self);
    }

    pub over onExit(mut self, dmut scene: &Scene) {
        scene:.removeBody(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the shape of the collider, in the space of the node
     * */
    @field
    pub fn shape(self)-> ColliderShape {
        self._shape
    }

    /**
     * Change the shape of the collider, the body in the world of the scene and the bounds of the node following
     * @info: a box, a sphere, a capsule, a cylinder or a plane describes the body (see described), a hull, a mesh or a
     * compound describes it by none
     * */
    @field
    pub fn shape(mut self, shape: ColliderShape) {
        self:.setDescribedShape(shape, BodyShape::describing(shape));
    }

    /**
     * @returns: the shape the collider of the body is described by in the scene files and in an editor, none for a
     * hull, a mesh or a compound set as a collider
     * */
    @field
    pub fn described(self)-> (BodyShape)? {
        self._described
    }

    /**
     * Change the shape of the collider to the one a description gives: a primitive of its sizes, the hulls or the
     * triangles of its model, read from its file, or the volumes under the body as they are placed now (see colliderOf)
     * @throws:
     *    - &BalderError: if the model cannot be loaded, or a compound has no volume under the body, the body keeping its
     *                    shape
     * */
    pub fn reshape(mut self, shape: BodyShape)
        throws BalderError
    {
        let collider = self:.colliderOf(shape);
        self:.setDescribedShape(collider, shape?);
    }

    /**
     * Change the shape of the collider and the shape it is described by at once, the collider built from that
     * description already (an editor undoing a change)
     * */
    pub fn setDescribedShape(mut self, shape: ColliderShape, described: (BodyShape)?) {
        self._shape = shape;
        self._described = described;
        self:.invalidateBounds();
        self:.notifyChanged();
    }

    /**
     * @returns: the collider a shape described gives the body: a primitive of its sizes; the hulls of a model, its
     * convex decomposition saved next to its file (see ConvexDecomposition::fileOf) or else the hull of each of its
     * meshes (see SolidObjectModel::hulls); the triangles of a model; both placed where the model stands under the body
     * (see placeOfModel); the compound of the volumes under the body, those
     * under another body left out, each placed and scaled as it is under the body
     * @throws:
     *    - &BalderError: if the model cannot be loaded, or a compound has no volume under the body
     * */
    pub fn colliderOf(mut self, shape: BodyShape)-> ColliderShape
        throws BalderError
    {
        if let Ok(c) = shape.collider() { return c; }

        match shape.kind {
            BodyShapeKind::HULL => { utils::hullsOf(shape.model, place-> self:.placeOfModel(shape.model)) }
            BodyShapeKind::MESH => { utils::trianglesOf(shape.model, place-> self:.placeOfModel(shape.model)) }
            _ => {
                let mut parts: [CompoundPart] = [];
                let inverse = self.transformation.inversed();
                for dmut c in alias self:.getChildrenInOrder() {
                    utils::gatherVolumes(alias c, inverse, ref parts);
                }

                if parts.len == 0us {
                    throw copy BalderError(f"${self.name.file()}: a compound shape without a volume under the body");
                }

                ColliderShape::compound(copy CompoundShape(parts))
            }
        }
    }

    /**
     * @returns: the transformation of the model a hull or a mesh is read from in the space of the body, the first model
     * of that file under the body (those under another body left out), the identity when there is none: the collider
     * lies where the body moves the model, wherever the model stands under it (a model wrapped stands at the centre of
     * its box, see the wrapping of the editor)
     * */
    pub fn placeOfModel(mut self, model: [c8])-> mat4 {
        if let Ok(m) = utils::modelUnder(alias self, model) {
            return self.transformation.inversed() * m;
        }

        mat4()
    }

    /**
     * @returns: how the body takes part in the physics of its scene
     * */
    @field
    pub fn settings(self)-> BodySettings {
        self._settings
    }

    /**
     * Change how the body takes part in the physics of its scene, its contacts following at the next update
     * */
    @field
    pub fn settings(mut self, settings: BodySettings) {
        self._settings = settings;
        self:.notifyChanged();
    }

    /**
     * @returns: the layers the body is in, one bit by layer
     * */
    @field
    pub fn layer(self)-> u32 {
        self._settings.layer
    }

    /**
     * Put the body in other layers, one bit by layer
     * */
    @field
    pub fn layer(mut self, layer: u32) {
        self._settings.layer = layer;
        self:.notifyChanged();
    }

    /**
     * @returns: the layers of the bodies the body touches, one bit by layer
     * */
    @field
    pub fn mask(self)-> u32 {
        self._settings.mask
    }

    /**
     * Change the layers of the bodies the body touches, one bit by layer
     * */
    @field
    pub fn mask(mut self, mask: u32) {
        self._settings.mask = mask;
        self:.notifyChanged();
    }

    /**
     * @returns: the handle of the body in the physics world of its scene, none outside a scene
     * */
    @field
    pub fn handle(self)-> (u32)? {
        self._handle
    }

    /**
     * Change the handle of the body in the physics world of its scene, given by the scene when the body enters it and
     * taken back when it leaves it (see ScenePhysics)
     * */
    pub fn setHandle(mut self, handle: (u32)?) {
        self._handle = handle;
    }

    /**
     * @returns: the velocity of the centre of mass of the body, in metres a second; zero outside a scene
     * */
    @field
    pub fn linearVelocity(mut self)-> vec3 {
        if let Ok(dmut scene) = alias self:.getScene() {
            return scene.velocityOf(self).0;
        }

        vec3()
    }

    /**
     * @returns: the angular velocity of the body in the world, in radians a second about its direction; zero outside a
     * scene
     * */
    @field
    pub fn angularVelocity(mut self)-> vec3 {
        if let Ok(dmut scene) = alias self:.getScene() {
            return scene.velocityOf(self).1;
        }

        vec3()
    }

    /**
     * @returns: true iif the body is dynamic and sleeps, the simulation skipping it until something wakes it
     * */
    @field
    pub fn sleeping(mut self)-> bool {
        if let Ok(dmut scene) = alias self:.getScene() {
            return scene.isBodySleeping(self);
        }

        false
    }

    /**
     * Change the velocities of a dynamic or a kinematic body, waking it; does nothing outside a scene
     * @params:
     *    - linear: the velocity of its centre of mass, in metres a second
     *    - angular: its angular velocity in the world, in radians a second about its direction
     * @info: a kinematic body keeps the velocity until it is moved, the solver carrying what it touches by it (a
     * conveyor belt), the body itself staying where its node is
     * */
    pub fn setVelocity(mut self, linear: vec3, angular: vec3 = vec3()) {
        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.setBodyVelocity(self, linear, angular);
        }
    }

    /**
     * Push a dynamic body by an impulse, its velocities changed at once, waking it; does nothing outside a scene
     * @params:
     *    - impulse: the impulse, in newton seconds
     *    - at: the point of the world it pushes at, the centre of mass of the body when none
     * */
    pub fn applyImpulse(mut self, impulse: vec3, at: (vec3)? = none) {
        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.applyBodyImpulse(self, impulse, at-> at);
        }
    }

    /**
     * Push a dynamic body by a force until the end of the tick, waking it (to push it longer, apply it at each tick);
     * does nothing outside a scene
     * @params:
     *    - force: the force, in newtons
     *    - at: the point of the world it pushes at, the centre of mass of the body when none
     * */
    pub fn applyForce(mut self, force: vec3, at: (vec3)? = none) {
        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.applyBodyForce(self, force, at-> at);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Connect the signal emitted with the other body when the two start touching
     * */
    pub fn contactBegan(mut self)-> dmut &Signal!{&PhysicsBody3D} {
        alias self._contactBegan
    }

    /**
     * Connect the signal emitted with the other body at each update of the contacts the two still touch
     * */
    pub fn contactStayed(mut self)-> dmut &Signal!{&PhysicsBody3D} {
        alias self._contactStayed
    }

    /**
     * Connect the signal emitted with the other body when the two no longer touch, or one of them left the scene
     * */
    pub fn contactEnded(mut self)-> dmut &Signal!{&PhysicsBody3D} {
        alias self._contactEnded
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMPUTATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Move the body in the world of its scene with the node
     * */
    over updateTransformation(mut self) {
        self._super_:.updateTransformation();
        if !self._handle.hasValue { return; }

        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.onBodyMoved(self);
        }
    }

    /**
     * @returns: the glyph of a body without geometry under it, a ball on the ground, none for a body seen by the meshes
     * it moves
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        if utils::holdsGeometry(self) { return none; }
        NodeIcon::body()?
    }

    /**
     * @returns: the box enclosing the collider in the world, the body being framed by it
     * */
    over computeOwnBounds(mut self)-> Aabb {
        Collider(self._shape, self.transformation).bounds
    }

    /**
     * Place the node where the simulation moved its body, a pose in the world brought under the parent of the node, its
     * scale kept
     * */
    pub fn placeFromPhysics(mut self, pose: RigidTransform) {
        let world = pose.matrix() * scaling(axesScale(self.transformation));
        let local = self.parentTransformation.inversed() * world;
        let rigid = RigidTransform(local);
        self:.setTransform(rigid.position, rigid.rotation, axesScale(local));
    }

    /**
     * Tell the scene the shape or the settings of the body changed
     * */
    fn notifyChanged(mut self) {
        if !self._handle.hasValue { return; }

        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.onBodyChanged(self);
        }
    }

}

/**
 * The properties of the bodies
 * */
pub mod PhysicsBody3D {

    /**
     * The groups of the properties of a body, its sections of the inspector: its shape and how it moves, its material,
     * the settings of a dynamic body, and its layers, folded at first
     * */
    pub def GROUP = "Physics body";
    pub def MATERIAL_GROUP = "Physics material";
    pub def DYNAMICS_GROUP = "Dynamics";
    pub def LAYERS_GROUP = "Collision layers";

    /**
     * @returns: the groups of the properties of a body or a character, the layers folded at first
     * */
    pub fn groups()-> [PropertyGroup] {
        copy [PropertyGroup(name-> GROUP), PropertyGroup(name-> MATERIAL_GROUP), PropertyGroup(name-> DYNAMICS_GROUP),
              PropertyGroup(name-> LAYERS_GROUP, folded-> true)]
    }

    /**
     * @returns: the layers a body or a character is in, and the layers it touches
     * */
    pub fn layers()-> [&NodeProperty] {
        copy [copy Property!{&PhysicsBody3D, u32}("layer", BodySettings().layer, |dmut b| => b.layer,
                                                 set-> (|dmut b, l| => { b.layer = l; })?,
                                                 kind-> PropertyKind::LAYERS, label-> "Layers it is in", group-> LAYERS_GROUP),
              copy Property!{&PhysicsBody3D, u32}("mask", BodySettings().mask, |dmut b| => b.mask,
                                                 set-> (|dmut b, m| => { b.mask = m; })?,
                                                 kind-> PropertyKind::LAYERS, label-> "Layers it touches", group-> LAYERS_GROUP)]
    }

    /**
     * @returns: the schema of the bodies: their shape and its sizes, the model of a hull or a mesh, given at the creation
     * of a body (see reshape), then how they take part in the physics of their scene (see BodySettings), the settings
     * of a dynamic body applying to a dynamic body only
     * */
    pub fn schema()-> &NodeSchema {
        let sizes = NumberRange(min-> 0.01f, max-> 10000.0f, step-> 0.05f, decimals-> 2u32);
        let dynamic = (Condition(property-> "motion", choices-> copy ["dynamic"]))?;
        let shape = BodyShape();
        let settings = BodySettings();
        copy NodeSchema("body", groups-> groups(), properties-> copy [
            copy ChoiceProperty!{&PhysicsBody3D, BodyShapeKind}("shape", BodyShapeKind::BOX,
                                                                copy [("box", "Box", BodyShapeKind::BOX),
                                                                      ("sphere", "Sphere", BodyShapeKind::SPHERE),
                                                                      ("capsule", "Capsule", BodyShapeKind::CAPSULE),
                                                                      ("cylinder", "Cylinder", BodyShapeKind::CYLINDER),
                                                                      ("plane", "Plane", BodyShapeKind::PLANE),
                                                                      ("hull", "Hulls of the model", BodyShapeKind::HULL),
                                                                      ("mesh", "Mesh of the model", BodyShapeKind::MESH),
                                                                      ("compound", "Compound of the volumes", BodyShapeKind::COMPOUND)],
                                                                |dmut b| => (b.described ?? BodyShape()).kind,
                                                                label-> "Shape", group-> GROUP),
            copy Property!{&PhysicsBody3D, vec3}("size", shape.size, |dmut b| => (b.described ?? BodyShape()).size,
                                                 label-> "Size", group-> GROUP, range-> sizes,
                                                 when-> (Condition(property-> "shape", choices-> copy ["box"]))?),
            copy Property!{&PhysicsBody3D, f32}("radius", shape.radius, |dmut b| => (b.described ?? BodyShape()).radius,
                                                label-> "Radius", group-> GROUP, range-> sizes,
                                                when-> (Condition(property-> "shape", choices-> copy ["sphere", "capsule", "cylinder"]))?),
            copy Property!{&PhysicsBody3D, f32}("height", shape.height, |dmut b| => (b.described ?? BodyShape()).height,
                                                label-> "Height", group-> GROUP, range-> sizes,
                                                when-> (Condition(property-> "shape", choices-> copy ["capsule", "cylinder"]))?),
            copy Property!{&PhysicsBody3D, [c8]}("model", "", |dmut b| => (b.described ?? BodyShape()).model,
                                                 kind-> PropertyKind::ASSET, asset-> "mesh", label-> "Model", group-> GROUP,
                                                 required-> true,
                                                 when-> (Condition(property-> "shape", choices-> copy ["hull", "mesh"]))?),
            copy ChoiceProperty!{&PhysicsBody3D, BodyMotion}("motion", BodyMotion::STATIC,
                                                             copy [("static", "Static", BodyMotion::STATIC),
                                                                   ("kinematic", "Kinematic", BodyMotion::KINEMATIC),
                                                                   ("dynamic", "Dynamic", BodyMotion::DYNAMIC)],
                                                             |dmut b| => b.settings.motion,
                                                             set-> (|dmut b, m| => { let mut s = b.settings; s.motion = m; b.settings = s; })?,
                                                             check-> (|b, m| => { neverDynamic(b, m) })?,
                                                             label-> "Motion", group-> GROUP),
            copy Property!{&PhysicsBody3D, f32}("mass", settings.mass, |dmut b| => b.settings.mass,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.mass = v; b.settings = s; })?,
                                                label-> "Mass (kg)", group-> DYNAMICS_GROUP, when-> dynamic,
                                                range-> NumberRange(min-> 0.001f, max-> 1000000.0f, step-> 0.1f, decimals-> 3u32)),
            copy Property!{&PhysicsBody3D, f32}("friction", settings.friction, |dmut b| => b.settings.friction,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.friction = v; b.settings = s; })?,
                                                label-> "Friction", group-> MATERIAL_GROUP,
                                                range-> NumberRange(min-> 0.0f, max-> 10.0f, step-> 0.05f, decimals-> 2u32)),
            copy Property!{&PhysicsBody3D, f32}("rolling-friction", settings.rollingFriction, |dmut b| => b.settings.rollingFriction,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.rollingFriction = v; b.settings = s; })?,
                                                label-> "Rolling friction", group-> DYNAMICS_GROUP, when-> dynamic,
                                                range-> NumberRange(min-> 0.0f, max-> 10.0f, step-> 0.01f, decimals-> 2u32)),
            copy Property!{&PhysicsBody3D, f32}("spinning-friction", settings.spinningFriction, |dmut b| => b.settings.spinningFriction,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.spinningFriction = v; b.settings = s; })?,
                                                label-> "Spinning friction", group-> DYNAMICS_GROUP, when-> dynamic,
                                                range-> NumberRange(min-> 0.0f, max-> 10.0f, step-> 0.01f, decimals-> 2u32)),
            copy Property!{&PhysicsBody3D, f32}("restitution", settings.restitution, |dmut b| => b.settings.restitution,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.restitution = v; b.settings = s; })?,
                                                label-> "Restitution", group-> MATERIAL_GROUP,
                                                range-> NumberRange(min-> 0.0f, max-> 1.0f, step-> 0.05f, decimals-> 2u32)),
            copy Property!{&PhysicsBody3D, f32}("linear-damping", settings.linearDamping, |dmut b| => b.settings.linearDamping,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.linearDamping = v; b.settings = s; })?,
                                                label-> "Linear damping", group-> DYNAMICS_GROUP, when-> dynamic,
                                                range-> NumberRange(min-> 0.0f, max-> 100.0f, step-> 0.01f, decimals-> 2u32)),
            copy Property!{&PhysicsBody3D, f32}("angular-damping", settings.angularDamping, |dmut b| => b.settings.angularDamping,
                                                set-> (|dmut b, v| => { let mut s = b.settings; s.angularDamping = v; b.settings = s; })?,
                                                label-> "Angular damping", group-> DYNAMICS_GROUP, when-> dynamic,
                                                range-> NumberRange(min-> 0.0f, max-> 100.0f, step-> 0.01f, decimals-> 2u32)),
            copy Property!{&PhysicsBody3D, bool}("can-sleep", settings.canSleep, |dmut b| => b.settings.canSleep,
                                                 set-> (|dmut b, v| => { let mut s = b.settings; s.canSleep = v; b.settings = s; })?,
                                                 label-> "Can sleep", group-> DYNAMICS_GROUP, when-> dynamic),
            copy Property!{&PhysicsBody3D, bool}("bullet", settings.bullet, |dmut b| => b.settings.bullet,
                                                 set-> (|dmut b, v| => { let mut s = b.settings; s.bullet = v; b.settings = s; })?,
                                                 label-> "Bullet, advanced along its motion", group-> DYNAMICS_GROUP, when-> dynamic),
            copy Property!{&PhysicsBody3D, bool}("trigger", settings.trigger, |dmut b| => b.settings.trigger,
                                                 set-> (|dmut b, v| => { let mut s = b.settings; s.trigger = v; b.settings = s; })?,
                                                 label-> "Trigger, stopping nothing", group-> GROUP)
        ] ~ layers())
    }

    /**
     * @returns: why a body refuses a motion, a plane or a mesh never being dynamic, empty when it takes it
     * */
    pub fn neverDynamic(body: &PhysicsBody3D, motion: BodyMotion)-> [c8] {
        let kind = (body.described ?? BodyShape()).kind;
        if motion != BodyMotion::DYNAMIC || (kind != BodyShapeKind::PLANE && kind != BodyShapeKind::MESH) { return ""; }

        f"${body.name.file()}: a plane or a mesh is never dynamic"
    }

}
