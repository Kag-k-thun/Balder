in body_shape;

use balder::math::vector;
use balder::scene::physics;
use balder::scene::node::node3D::volume_shape;

use std::algorithm::comparison;

/**
 * The kinds of the shapes of a body, as an editor and the scene files give them
 * */
pub enum BodyShapeKind : u32
| BOX      = 0u32 // a box, of a side along each axis
| SPHERE   = 1u32 // a sphere, of a radius
| CAPSULE  = 2u32 // a cylinder along the Y axis capped by two half spheres, of a radius and a height
| CYLINDER = 3u32 // a cylinder along the Y axis, of a radius and a height
| PLANE    = 4u32 // the half space under the XZ plane of the body
| HULL     = 5u32 // the convex hulls of a model: its decomposition saved next to its file, or the hull of each mesh
| MESH     = 6u32 // the triangles of a model, a surface holding no volume
| COMPOUND = 7u32; // the shapes of the volumes under the body, placed where they are

/**
 * The shape of a body as an editor and the scene files give it: a primitive of its sizes, the hulls or the triangles of
 * a model by the file of the model, or the volumes under the body (see PhysicsBody3D::reshape), the collider being
 * built from it
 * @info:
 * =====
 * The sizes follow the rules of a ColliderShape: the sides of a box, the radius of a sphere, a capsule or a cylinder are
 * MIN_VOLUME_SIZE at least, the height of a capsule (its caps included) twice its radius at least, the height of the
 * other kinds MIN_VOLUME_SIZE at least (kept for a capsule or a cylinder the shape turns into). A box, a sphere, a capsule and a cylinder have faces an editor drags as those of a
 * volume (see face and movedFace): a face of a box, or an end of a capsule or a cylinder, moves on its own, the opposite
 * one staying where it is; a face of a sphere, or a side of a capsule or a cylinder, changes its radius about its
 * centre.
 * ====
 * */
pub record BodyShape {

    // What the shape is
    pub let kind: BodyShapeKind;

    // The sides of a box along the X, the Y and the Z axes of its body
    pub let size: vec3;

    // The radius of a sphere, a capsule or a cylinder
    pub let radius: f32;

    // The height of a capsule (its caps included) or of a cylinder, along the Y axis of its body
    pub let height: f32;

    // The project path of the model file of a hull or a mesh, empty for the other kinds
    pub let model: [c8];

    /**
     * A box of a unit side, its radius 0.5 and its height 2 kept for a sphere, a capsule or a cylinder
     * */
    pub self ()
        with self(BodyShapeKind::BOX, makeVec3(1.0f, 1.0f, 1.0f), 0.5f, 2.0f)
    {}

    /**
     * @params:
     *    - kind: what the shape is
     *    - size: the sides of a box, MIN_VOLUME_SIZE at least
     *    - radius: the radius of a sphere, a capsule or a cylinder, MIN_VOLUME_SIZE at least
     *    - height: the height of a capsule, its caps included, twice its radius at least; of a cylinder,
     *              MIN_VOLUME_SIZE at least
     *    - model: the project path of the model file of a hull or a mesh
     * */
    pub self (kind: BodyShapeKind, size: vec3, radius: f32, height: f32, model: [c8] = "")
        with kind = kind
        , size = makeVec3(atLeast(size.x, MIN_VOLUME_SIZE), atLeast(size.y, MIN_VOLUME_SIZE), atLeast(size.z, MIN_VOLUME_SIZE))
        , radius = atLeast(radius, MIN_VOLUME_SIZE)
        , height = atLeast(height, if kind == BodyShapeKind::CAPSULE { 2.0f * atLeast(radius, MIN_VOLUME_SIZE) } else { MIN_VOLUME_SIZE })
        , model = model
    {}

    /**
     * The shape of a volume, a box, a sphere or a capsule of its sizes (see Volume3D)
     * */
    pub self (volume: VolumeShape)
        with self(match volume.kind {
            VolumeKind::SPHERE  => { BodyShapeKind::SPHERE }
            VolumeKind::CAPSULE => { BodyShapeKind::CAPSULE }
            _                   => { BodyShapeKind::BOX }
        }, volume.size, volume.radius, volume.height)
    {}

    /**
     * @returns: the shape of another kind, of the sizes and the model of this one
     * */
    pub fn withKind(self, kind: BodyShapeKind)-> BodyShape {
        BodyShape(kind, self.size, self.radius, self.height, model-> self.model)
    }

    /**
     * @returns: the shape of the hulls or the triangles of another model file, of the sizes of this one
     * */
    pub fn withModel(self, model: [c8])-> BodyShape {
        BodyShape(self.kind, self.size, self.radius, self.height, model-> model)
    }

    /**
     * @returns: true iif the shape is given by its sizes, a box, a sphere, a capsule, a cylinder or a plane, its collider
     * built without a model nor the volumes under its body
     * */
    @field
    pub fn isPrimitive(self)-> bool {
        self.kind != BodyShapeKind::HULL && self.kind != BodyShapeKind::MESH && self.kind != BodyShapeKind::COMPOUND
    }

    /**
     * @returns: true iif an editor drags the faces of the shape, a box, a sphere, a capsule or a cylinder
     * */
    @field
    pub fn hasFaces(self)-> bool {
        self.isPrimitive && self.kind != BodyShapeKind::PLANE
    }

    /**
     * @returns: the collider of a shape given by its sizes, none for a hull, a mesh or a compound, which a model or the
     * volumes under the body give (see PhysicsBody3D::reshape)
     * */
    pub fn collider(self)-> (ColliderShape)? {
        match self.kind {
            BodyShapeKind::BOX      => { ColliderShape::box(self.size)? }
            BodyShapeKind::SPHERE   => { ColliderShape::sphere(self.radius)? }
            BodyShapeKind::CAPSULE  => { ColliderShape::capsule(self.radius, self.height)? }
            BodyShapeKind::CYLINDER => { ColliderShape::cylinder(self.radius, self.height)? }
            BodyShapeKind::PLANE    => { ColliderShape::plane()? }
            _                       => { none }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          FACES          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the centre of a face of the shape, in the space of its body, where an editor draws its handle
     * @params:
     *    - face: the face, 0 to VOLUME_FACES - 1: +X, -X, +Y, -Y, +Z, -Z
     * */
    pub fn face(self, face: usize)-> vec3 {
        if self.kind != BodyShapeKind::CYLINDER { return self.toVolume().face(face); }

        let reach = if face / 2us == 1us { self.height / 2.0f } else { self.radius };
        VolumeShape::faceNormal(face) * reach
    }

    /**
     * @returns: the shape a face moved along its normal gives, and the move of the centre of the shape in the space of
     * its body: half the move of the face of a box or of an end of a capsule or a cylinder, the opposite face staying
     * where it is; none for a face of a sphere or a side of a capsule or a cylinder, its radius changing about its centre
     * @params:
     *    - face: the face, 0 to VOLUME_FACES - 1: +X, -X, +Y, -Y, +Z, -Z
     *    - offset: the move of the face along its normal, outward, in units of the space of the body
     * */
    pub fn movedFace(self, face: usize, offset: f32)-> (BodyShape, vec3) {
        if self.kind != BodyShapeKind::CYLINDER {
            let (moved, shift) = self.toVolume().movedFace(face, offset);
            return (BodyShape(moved).withKind(self.kind), shift);
        }

        if face / 2us != 1us {
            return (BodyShape(self.kind, self.size, self.radius + offset, self.height), vec3());
        }

        let height = atLeast(self.height + offset, MIN_VOLUME_SIZE);
        (BodyShape(self.kind, self.size, self.radius, height), VolumeShape::faceNormal(face) * ((height - self.height) / 2.0f))
    }

    /**
     * @returns: the shape of a volume of the sizes of this one, a box for the kinds a volume does not have
     * */
    pub fn toVolume(self)-> VolumeShape {
        let kind = match self.kind {
            BodyShapeKind::SPHERE  => { VolumeKind::SPHERE }
            BodyShapeKind::CAPSULE => { VolumeKind::CAPSULE }
            _                      => { VolumeKind::BOX }
        };

        VolumeShape(kind, self.size, self.radius, self.height)
    }

    pub fn opEquals(self, other: BodyShape)-> bool {
        self.kind == other.kind && self.size == other.size && self.radius == other.radius && self.height == other.height
            && self.model == other.model
    }

}

/**
 * The shapes of the colliders
 * */
pub mod BodyShape {

    /**
     * @returns: the shape a collider of a box, a sphere, a capsule, a cylinder or a plane is described by, none for a
     * hull, a mesh or a compound, which do not tell the model or the volumes they were made of
     * */
    pub fn describing(shape: ColliderShape)-> (BodyShape)? {
        let kind = match shape.kind {
            ColliderKind::BOX      => { BodyShapeKind::BOX }
            ColliderKind::SPHERE   => { BodyShapeKind::SPHERE }
            ColliderKind::CAPSULE  => { BodyShapeKind::CAPSULE }
            ColliderKind::CYLINDER => { BodyShapeKind::CYLINDER }
            ColliderKind::PLANE    => { BodyShapeKind::PLANE }
            _                      => { return none; }
        };

        let defaults = BodyShape();
        let size = if kind == BodyShapeKind::BOX { shape.size } else { defaults.size };
        let round = kind == BodyShapeKind::SPHERE || kind == BodyShapeKind::CAPSULE || kind == BodyShapeKind::CYLINDER;
        let radius = if round { shape.radius } else { defaults.radius };
        let height = if kind == BodyShapeKind::CAPSULE || kind == BodyShapeKind::CYLINDER { shape.height } else { defaults.height };
        BodyShape(kind, size, radius, height)?
    }

}

/**
 * @returns: a value, a bound at least
 * */
fn atLeast(v: f32, low: f32)-> f32 {
    comparison::max(v, low)
}
