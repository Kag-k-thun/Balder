in character;

use balder::math::vector;
use balder::scene::physics;
use balder::scene::node::node3D::{body, icon};
use balder::scene::property::{choice_property, group, node_schema, range, typed_property};

use std::time;

/**
 * A character of a scene: a kinematic capsule moved by the game through the level by its character controller, sliding
 * along what it meets, stepping onto low ledges, keeping to the ground walking down a slope, and pushing the dynamic
 * bodies it walks into (see CharacterController)
 * @info: the game moves the character once a tick, from its onTick or its activity, by a velocity it keeps from tick to
 * tick: gravity added to it, a jump setting its speed up while canJump; moveAndSlide gives back the velocity once the
 * surfaces met stopped it, its fall dropped on the floor. The origin of the node is the centre of its capsule.
 * ```
 * velocity.y -= 9.81f * seconds;
 * if jumping && character.canJump { velocity.y = 5.0f; character:.jumped (); }
 * velocity = character:.moveAndSlide (velocity, delta);
 * ```
 * */
pub class CharacterBody3D over PhysicsBody3D {

    // The controller moving the body, holding whether it stands on the floor
    let dmut _controller: &CharacterController;

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the character is attached to
     *    - radius: the radius of its capsule
     *    - height: the height of its capsule, its caps included
     *    - settings: how the character moves
     *    - body: the layers and the mask of the body, its motion always kinematic
     * */
    pub self (name: [c8], dmut parent: &Node, radius: f32 = 0.4f, height: f32 = 1.8f,
              settings: CharacterSettings = CharacterSettings(), body: BodySettings = BodySettings())
        with super(name, alias parent, shape-> ColliderShape::capsule(radius, height), settings-> kinematic(body))
        , _controller = copy CharacterController(settings-> settings)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the controller of the character: its settings, whether it stands on the floor, met a wall or a ceiling
     * */
    @field
    pub fn controller(self)-> &CharacterController {
        self._controller
    }

    /**
     * @returns: true iif the last move ended on a floor
     * */
    @field
    pub fn onFloor(self)-> bool {
        self._controller.onFloor
    }

    /**
     * @returns: true iif the character can jump: on the floor, or a little after it walked off it (see
     * CharacterSettings::coyoteTime)
     * */
    @field
    pub fn canJump(self)-> bool {
        self._controller.canJump
    }

    /**
     * Tell the character it jumped, its coyote time spent until it is on the floor again
     * */
    pub fn jumped(mut self) {
        self._controller:.jumped();
    }

    /**
     * Move the character by other settings from the next move
     * */
    pub fn setCharacterSettings(mut self, settings: CharacterSettings) {
        self._controller.settings = settings;
    }

    /**
     * @returns: the glyph of a character without geometry under it, a figure, none for a character seen by its meshes
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        if self.__super__.editorIcon().hasValue { return NodeIcon::character()?; }
        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MOVE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Move the character by a velocity over the duration of a tick, sliding along what it meets, the node placed where
     * the move ends
     * @returns: the velocity once the surfaces met stopped it, the velocity unchanged outside a scene
     * */
    pub fn moveAndSlide(mut self, velocity: vec3, delta: Duration)-> vec3 {
        let seconds = cast!f32(delta.allMicros) / 1_000_000.0f;
        if let Ok(dmut scene) = alias self:.getScene() {
            let result = scene:.moveCharacter(self, alias self._controller, velocity, seconds);
            let local = (self.parentTransformation.inversed() * makeVec4(result.position, 1.0f)).xyz;
            if local != self.position {
                self.position = local;
            }

            return result.velocity;
        }

        velocity
    }

}

/**
 * The properties of the characters
 * */
pub mod CharacterBody3D {

    /**
     * The group of the properties of how a character moves, its section of the inspector
     * */
    pub def GROUP = "Character";

    /**
     * @returns: the schema of the characters: the radius and the height of their capsule, given at the creation of a
     * character, how they move (see CharacterSettings, the slope limit in degrees), their layers and their mask
     * */
    pub fn schema()-> &NodeSchema {
        let sizes = NumberRange(min-> 0.01f, max-> 10000.0f, step-> 0.05f, decimals-> 2u32);
        let lengths = NumberRange(min-> 0.0f, max-> 100.0f, step-> 0.05f, decimals-> 2u32);
        let counts = NumberRange(min-> 0.0f, max-> 64.0f, step-> 1.0f, decimals-> 0u32);
        let moves = CharacterSettings();
        copy NodeSchema("character", groups-> PhysicsBody3D::groups() ~ [PropertyGroup(name-> GROUP)], properties-> copy [
            copy Property!{&CharacterBody3D, f32}("radius", 0.4f, |dmut c| => c.shape.radius, label-> "Radius",
                                                  group-> PhysicsBody3D::GROUP, range-> sizes),
            copy Property!{&CharacterBody3D, f32}("height", 1.8f, |dmut c| => c.shape.height, label-> "Height",
                                                  group-> PhysicsBody3D::GROUP, range-> sizes),
            copy Property!{&CharacterBody3D, vec3}("up", moves.up, |dmut c| => c.controller.settings.up,
                                                   set-> (|dmut c, v| => { let mut s = c.controller.settings; s.up = v; c:.setCharacterSettings(s); })?,
                                                   check-> (|_, v| => { if v.length() == 0.0f { "The up of a character cannot be null" } else { "" } })?,
                                                   label-> "Up", group-> GROUP,
                                                   range-> NumberRange(min-> -1.0f, max-> 1.0f, step-> 0.05f, decimals-> 2u32)),
            copy Property!{&CharacterBody3D, f32}("slope-limit", moves.slopeLimit, |dmut c| => c.controller.settings.slopeLimit,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.slopeLimit = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Slope limit (degrees)", group-> GROUP, degrees-> true,
                                                  range-> NumberRange(min-> 0.0f, max-> 90.0f, step-> 0.5f, decimals-> 1u32)),
            copy Property!{&CharacterBody3D, f32}("step-offset", moves.stepOffset, |dmut c| => c.controller.settings.stepOffset,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.stepOffset = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Step offset", group-> GROUP, range-> lengths),
            copy Property!{&CharacterBody3D, f32}("snap-distance", moves.snapDistance, |dmut c| => c.controller.settings.snapDistance,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.snapDistance = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Snap distance", group-> GROUP, range-> lengths),
            copy Property!{&CharacterBody3D, f32}("skin", moves.skin, |dmut c| => c.controller.settings.skin,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.skin = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Skin", group-> GROUP,
                                                  range-> NumberRange(min-> 0.0f, max-> 1.0f, step-> 0.005f, decimals-> 3u32)),
            copy Property!{&CharacterBody3D, f32}("coyote-time", moves.coyoteTime, |dmut c| => c.controller.settings.coyoteTime,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.coyoteTime = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Coyote time (s)", group-> GROUP,
                                                  range-> NumberRange(min-> 0.0f, max-> 10.0f, step-> 0.01f, decimals-> 2u32)),
            copy Property!{&CharacterBody3D, f32}("push-mass", moves.pushMass, |dmut c| => c.controller.settings.pushMass,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.pushMass = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Push mass (kg)", group-> GROUP,
                                                  range-> NumberRange(min-> 0.0f, max-> 100000.0f, step-> 1.0f, decimals-> 1u32)),
            copy Property!{&CharacterBody3D, u32}("max-slides", moves.maxSlides, |dmut c| => c.controller.settings.maxSlides,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.maxSlides = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Slides at most", group-> GROUP, range-> counts),
            copy Property!{&CharacterBody3D, u32}("depenetrations", moves.depenetrations, |dmut c| => c.controller.settings.depenetrations,
                                                  set-> (|dmut c, v| => { let mut s = c.controller.settings; s.depenetrations = v; c:.setCharacterSettings(s); })?,
                                                  label-> "Depenetration passes", group-> GROUP, range-> counts)
        ] ~ PhysicsBody3D::layers())
    }

}

/**
 * @returns: the settings of a body, kinematic
 * */
fn kinematic(body: BodySettings)-> BodySettings {
    let mut result = body;
    result.motion = BodyMotion::KINEMATIC;
    result
}
