in character;

use balder::math::vector;
use balder::scene::physics;
use balder::scene::node::node3D::{body, icon};

use std::time;

/**
 * A character of a scene: a kinematic capsule moved by the game through the level by its character controller, sliding
 * along what it meets, stepping onto low ledges, keeping to the ground walking down a slope, and pushing the dynamic
 * bodies it walks into (see CharacterController)
 * @info: the game moves the character once a tick, from its onTick or its activity, by a velocity it keeps from tick to
 * tick: gravity added to it, a jump setting its speed up while canJump; moveAndSlide gives back the velocity once the
 * surfaces met stopped it, its fall dropped on the floor. The origin of the node is the centre of its capsule.
 * ```
 * velocity.y -= 9.81f * seconds;
 * if jumping && character.canJump { velocity.y = 5.0f; character:.jumped (); }
 * velocity = character:.moveAndSlide (velocity, delta);
 * ```
 * */
pub class CharacterBody3D over PhysicsBody3D {

    // The controller moving the body, holding whether it stands on the floor
    let dmut _controller: &CharacterController;

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the character is attached to
     *    - radius: the radius of its capsule
     *    - height: the height of its capsule, its caps included
     *    - settings: how the character moves
     *    - body: the layers and the mask of the body, its motion always kinematic
     * */
    pub self (name: [c8], dmut parent: &Node, radius: f32 = 0.4f, height: f32 = 1.8f,
              settings: CharacterSettings = CharacterSettings(), body: BodySettings = BodySettings())
        with super(name, alias parent, shape-> ColliderShape::capsule(radius, height), settings-> kinematic(body))
        , _controller = copy CharacterController(settings-> settings)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the controller of the character: its settings, whether it stands on the floor, met a wall or a ceiling
     * */
    @field
    pub fn controller(self)-> &CharacterController {
        self._controller
    }

    /**
     * @returns: true iif the last move ended on a floor
     * */
    @field
    pub fn onFloor(self)-> bool {
        self._controller.onFloor
    }

    /**
     * @returns: true iif the character can jump: on the floor, or a little after it walked off it (see
     * CharacterSettings::coyoteTime)
     * */
    @field
    pub fn canJump(self)-> bool {
        self._controller.canJump
    }

    /**
     * Tell the character it jumped, its coyote time spent until it is on the floor again
     * */
    pub fn jumped(mut self) {
        self._controller:.jumped();
    }

    /**
     * Move the character by other settings from the next move
     * */
    pub fn setCharacterSettings(mut self, settings: CharacterSettings) {
        self._controller.settings = settings;
    }

    /**
     * @returns: the glyph of a character without geometry under it, a figure, none for a character seen by its meshes
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        if self.__super__.editorIcon().hasValue { return NodeIcon::character()?; }
        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MOVE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Move the character by a velocity over the duration of a tick, sliding along what it meets, the node placed where
     * the move ends
     * @returns: the velocity once the surfaces met stopped it, the velocity unchanged outside a scene
     * */
    pub fn moveAndSlide(mut self, velocity: vec3, delta: Duration)-> vec3 {
        let seconds = cast!f32(delta.allMicros) / 1_000_000.0f;
        if let Ok(dmut scene) = alias self:.getScene() {
            let result = scene:.moveCharacter(self, alias self._controller, velocity, seconds);
            let local = (self.parentTransformation.inversed() * makeVec4(result.position, 1.0f)).xyz;
            if local != self.position {
                self.position = local;
            }

            return result.velocity;
        }

        velocity
    }

}

/**
 * @returns: the settings of a body, kinematic
 * */
fn kinematic(body: BodySettings)-> BodySettings {
    let mut result = body;
    result.motion = BodyMotion::KINEMATIC;
    result
}
