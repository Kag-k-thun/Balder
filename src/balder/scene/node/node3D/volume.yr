in volume;

use balder::math::{bounds, vector};
use balder::scene::node::node3D::{guide, icon, volume_shape};

/**
 * A volume of the scene drawing nothing: a box, a sphere or a capsule, in the space of the node, centred on its origin
 * (see VolumeShape), the shape of a trigger or of a collider
 * @info: the volume is only a shape; what happens in it (a trigger entered, a body colliding) is given by the physics.
 * An editor draws its wireframe at all times, and the handles of its faces while it is the only node selected (see
 * TransformGizmo), a face dragged moving along its normal
 * */
pub class Volume3D over Node3D {

    // The shape of the volume, in the space of the node
    let mut _shape: VolumeShape = VolumeShape();

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the volume is attached to
     *    - shape: the shape of the volume, in the space of the node
     * */
    pub self (name: [c8], dmut parent: &Node, shape: VolumeShape = VolumeShape())
        with super(name, alias parent)
        , _shape = shape
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

    /**
     * @returns: the shape of the volume, in the space of the node
     * */
    @field
    pub fn shape(self)-> VolumeShape {
        self._shape
    }

    /**
     * Change the shape of the volume, its bounds following
     * */
    @field
    pub fn shape(mut self, shape: VolumeShape) {
        self._shape = shape;
        self:.invalidateBounds();
    }

    /**
     * @returns: the glyph of a volume, a box seen from a corner
     * */
    pub over editorIcon(self)-> (NodeIcon)? {
        NodeIcon::volume()?
    }

    /**
     * @returns: the wireframe of the shape, in the world
     * */
    pub over editorWires(self)-> [NodeGuide] {
        let m = self.transformation;
        let mut lines: [NodeGuide] = [];
        for w in self._shape.wires() {
            lines ~= [NodeGuide(from-> (m * makeVec4(w._0, 1.0f)).xyz, to-> (m * makeVec4(w._1, 1.0f)).xyz)];
        }

        lines
    }

    /**
     * @returns: the box enclosing the shape in the world, the volume being framed by it
     * */
    over computeOwnBounds(mut self)-> Aabb {
        self._shape.localBox().transformed(self.transformation)
    }

}
