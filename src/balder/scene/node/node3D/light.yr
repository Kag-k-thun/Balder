in light;

use balder::core::dispose;
use balder::math::vector;
use balder::utils::log;

pub enum LightType: u32
| DIRECTION = 1
| POINT     = 2
| SPOT      = 3
| AREA      = 4;

/**
 * A light in the scene
 * */
pub class Light over Node3D {

    let dmut _scene: (&Scene)? = none;
    let mut _id: u32           = u32::max;

    let mut _color: vec3     = makeVec3(1.0f, 1.0f, 1.0f);
    let mut _type: LightType = LightType::DIRECTION;
    let mut _castShadow: bool;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - castShadow: true if the light cast shadows on the scene (a direction light only, see Scene)
     * */
    pub self (name: [c8], dmut parent: &Node, castShadow: bool = false)
        with super(name, alias parent)
        , _castShadow = castShadow
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn castShadow(self)-> bool {
        self._castShadow
    }

    @field
    pub fn color(self)-> vec3 {
        self._color
    }

    @field
    pub fn type(self)-> LightType {
        self._type
    }

    /**
     * Get the index of the light in the composition shader
     * */
    pub fn getIndex(self)-> u32 {
        self._id
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Change the type of the light, the light being registered again in its scene, in the lights of its new type
     * */
    @field
    pub fn type(mut self, k: LightType) {
        if k == self._type { return; }

        if let Ok(dmut scene) = alias self._scene {
            scene:.freeLight(alias self);
            self._type = k;
            scene:.registerLight(alias self);
        } else {
            self._type = k;
        }
    }

    @field
    pub fn color(mut self, c: vec3) {
        self._color = c;
        self:.updateTransformation();
    }

    /**
     * Cast shadows on the scene or stop casting them, the light being registered again in its scene
     * @info: a direction light only casts shadows, one at a time (see Scene)
     * */
    @field
    pub fn castShadow(mut self, casts: bool) {
        if casts == self._castShadow { return; }

        if let Ok(dmut scene) = alias self._scene {
            scene:.freeLight(alias self);
            self._castShadow = casts;
            scene:.registerLight(alias self);
        } else {
            self._castShadow = casts;
        }
    }

    /**
     * Set the index of the light in the composition shader
     * */
    pub fn setIndex(mut self, id: u32) {
        self._id = id;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          UPDATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    over updateTransformation(mut self) {
        if let Ok(dmut scene) = alias self._scene {
            log::debug #("Light", "update", self._type);
            scene:.updateLight(alias self);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          BINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onEnter(mut self, dmut scene: &Scene) {
        log::debug #("Light", "enter");
        self._scene = (alias scene)?;
        scene:.registerLight(alias self);
    }

    pub over onExit(mut self, dmut scene: &Scene) {
        log::debug #("Light", "exit");
        scene:.freeLight(alias self);

        self._scene = none;
        self._id = u32::max;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DISPOSE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose(mut self) {
            if self._scene.hasValue {
                log::error #("Light", "Light was not detached from scene");
            }
        }
    }
}
