in joint;

use balder::core::application::signal;
use balder::math::rigid_transform;
use balder::scene::physics;
use balder::scene::node::node3D::body;

/**
 * A joint of the physics of a scene, holding two bodies by its frame: its origin the anchor, its X axis the axis of a
 * hinge or a slider (see JointSettings)
 * @info:
 * =====
 * The joint is made in the world of its scene at the first tick of the scene it and its two bodies are in the scene,
 * from where they are then: the frame of the node is placed on both bodies, the position of a hinge or a slider being 0
 * there, so a node is placed in the tick it is built in. Moving the node afterwards does not move the joint; a node
 * under one of the bodies moves with it. A body leaving the scene takes the joint out with it, the joint made again
 * from where they are at the first tick the body is back.
 *
 * A joint breaking (see JointSettings::breakForce) holds its bodies no longer, broken is emitted, and it stays broken
 * until it leaves the scene.
 * ====
 * */
pub class Joint3D over Node3D {

    // The first body, the frame of a hinge or a slider turning with it
    let _bodyA: &PhysicsBody3D;

    // The second body
    let _bodyB: &PhysicsBody3D;

    // How the joint holds its bodies
    let mut _settings: JointSettings;

    // The handle of the joint in the physics world of the scene, none until it is made there
    let mut _handle: (u32)? = none;

    // Emitted when the joint breaks
    let dmut _broken: &Signal!{()} = copy Signal!{()} ();

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node the joint is attached to
     *    - bodyA, bodyB: the two bodies it holds
     *    - settings: how it holds them
     * */
    pub self (name: [c8], dmut parent: &Node, bodyA: &PhysicsBody3D, bodyB: &PhysicsBody3D,
              settings: JointSettings = JointSettings())
        with super(name, alias parent)
        , _bodyA = bodyA
        , _bodyB = bodyB
        , _settings = settings
    {
        self:.updateTransformation();
    }

    pub over onEnter(mut self, dmut scene: &Scene) {
        scene:.registerJoint(alias self);
    }

    pub over onExit(mut self, dmut scene: &Scene) {
        scene:.removeJoint(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the first body, the frame of a hinge or a slider turning with it
     * */
    @field
    pub fn bodyA(self)-> &PhysicsBody3D {
        self._bodyA
    }

    /**
     * @returns: the second body
     * */
    @field
    pub fn bodyB(self)-> &PhysicsBody3D {
        self._bodyB
    }

    /**
     * @returns: how the joint holds its bodies
     * */
    @field
    pub fn settings(self)-> JointSettings {
        self._settings
    }

    /**
     * Change how the joint holds its bodies, its motor driving at another speed for instance, the joint in the world of
     * its scene following at once
     * @info: the kind of a joint made is kept, a joint of another kind being made by another node
     * */
    @field
    pub fn settings(mut self, settings: JointSettings) {
        self._settings = settings;
        if !self._handle.hasValue { return; }

        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.onJointChanged(self);
        }
    }

    /**
     * @returns: the frame of the joint in the world: its origin the anchor, its X axis the axis
     * */
    @field
    pub fn frame(self)-> RigidTransform {
        RigidTransform(self.transformation)
    }

    /**
     * @returns: the handle of the joint in the physics world of its scene, none until it is made there
     * */
    @field
    pub fn handle(self)-> (u32)? {
        self._handle
    }

    /**
     * Change the handle of the joint in the physics world of its scene, given by the scene when the joint is made and
     * taken back when it leaves (see ScenePhysics)
     * */
    pub fn setHandle(mut self, handle: (u32)?) {
        self._handle = handle;
    }

    /**
     * @returns: the angle a hinge turned by since it was made, in radians, the distance a slider slid, in metres; 0 for
     * another joint or a joint not made
     * */
    @field
    pub fn jointPosition(mut self)-> f32 {
        if let Ok(dmut scene) = alias self:.getScene() {
            return scene.jointPositionOf(self);
        }

        0.0f
    }

    /**
     * @returns: true iif the joint broke, holding its bodies no longer
     * */
    @field
    pub fn isBroken(mut self)-> bool {
        if let Ok(dmut scene) = alias self:.getScene() {
            return scene.isJointBroken(self);
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SIGNALS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Connect the signal emitted when the joint breaks, after the steps of the tick that broke it
     * */
    pub fn broken(mut self)-> dmut &Signal!{()} {
        alias self._broken
    }
}
