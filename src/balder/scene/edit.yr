in edit;

use balder::scene::node::node3D;
use balder::scene::node::node3D::transform;

/**
 * A change of the transform of a 3D node, from the transform it had to another one: the edits of a scene go through it
 * (the gizmo dragging the nodes selected), applied and reverted as a whole, so they can be undone
 * */
pub record TransformEdit {

    // The node changed
    let dmut _node: &Node3D;

    // The transform of the node before the edit
    pub let before: NodeTransform;

    // The transform of the node after the edit
    pub let after: NodeTransform;

    /**
     * An edit of a node from the transform it has now
     * @params:
     *    - after: the transform the edit gives the node
     * */
    pub self (dmut node: &Node3D, after: NodeTransform)
        with _node = alias node
        , before = NodeTransform(node)
        , after = after
    {}

    /**
     * @params:
     *    - before: the transform the node had before the edit, given back by revert
     *    - after: the transform the edit gives the node
     * */
    pub self (dmut node: &Node3D, before: NodeTransform, after: NodeTransform)
        with _node = alias node
        , before = before
        , after = after
    {}

    /**
     * @returns: the node changed
     * */
    @field
    pub fn node(self)-> &Node3D {
        self._node
    }

    /**
     * Give the node its transform after the edit
     * */
    pub fn apply(mut self) {
        self.after.applyTo(alias self._node);
    }

    /**
     * Give the node back its transform before the edit
     * */
    pub fn revert(mut self) {
        self.before.applyTo(alias self._node);
    }

}
