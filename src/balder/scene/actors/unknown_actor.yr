in unknown_actor;

use balder::scene::node;
use balder::scene::node::node3D::empty;

/**
 * A node of a scene file of an actor class the program does not know (renamed, or of another game), kept as it is
 * written: its transform is read, its other entries kept as their text, written back unchanged, so that a scene is not
 * lost when a class is renamed
 * */
pub class UnknownActor over Empty3D {

    // The type of the node in the scene file, the name of the class
    pub let className: [c8];

    // The entries of the node other than its transform and its connections, their names and the text of their values
    pub let mut entries: [([c8], [c8])];

    /**
     * @params:
     *    - name: the name of the node
     *    - parent: the node it is attached to
     *    - className: its type in the scene file
     *    - entries: its entries other than its transform and its connections
     * */
    pub self (name: [c8], dmut parent: &Node, className: [c8], entries: [([c8], [c8])])
        with super(name, alias parent)
        , className = className
        , entries = entries
    {}

}
