in utils;

use std::char;

/**
 * @returns: the name of a member of an actor class in the scene files, the name its tag gives or the name of the member
 * in kebab case, without its leading underscores: `_openSpeed` is `open-speed`
 * */
pub fn memberName(given: [c8], member: [c8])-> [c8] {
    if given.len != 0us { return given; }

    let mut res = "";
    let mut started = false;
    for c in member {
        if c == '_' {
            if started { res = res ~ "-"; }
        } else if c >= 'A' && c <= 'Z' {
            if started { res = res ~ "-"; }
            res = res ~ [toLower(c)];
            started = true;
        } else {
            res = res ~ [c];
            started = true;
        }
    }

    res
}

/**
 * @returns: the label of a member of an actor class, the label its tag gives or its name in the scene files made a
 * sentence: `open-speed` is `Open speed`
 * */
pub fn memberLabel(given: [c8], name: [c8])-> [c8] {
    if given.len != 0us { return given; }

    let mut res = "";
    for i, c in name {
        if c == '-' || c == '_' {
            res = res ~ " ";
        } else if i == 0us && c >= 'a' && c <= 'z' {
            res = res ~ [toUpper(c)];
        } else {
            res = res ~ [c];
        }
    }

    res
}

/**
 * @returns: the name of a member of an enum in the scene files, in kebab case: `SLOW_OPEN` is `slow-open`
 * */
pub fn choiceName(member: [c8])-> [c8] {
    let mut res = "";
    for c in member {
        if c == '_' {
            res = res ~ "-";
        } else if c >= 'A' && c <= 'Z' {
            res = res ~ [toLower(c)];
        } else {
            res = res ~ [c];
        }
    }

    res
}
