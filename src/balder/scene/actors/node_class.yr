in node_class;

use balder::core::application::signal;
use balder::scene::actors::{signal_info, slot_info, slot_ref};
use balder::scene::description::kind;
use balder::scene::node::node3D;
use balder::scene::property::node_schema;

/**
 * A class of nodes a scene file names by its type, a built-in class of Balder (see BuiltinClass) or an actor class a
 * game declares with #[actor] (see ActorClass), registered in the registry of the node classes (see nodeClasses)
 * */
@abstract
pub class NodeClass {

    // The type of the nodes of the class in the scene files, `door`
    pub let name: [c8];

    // The name of the class in the editor, `Door`
    pub let label: [c8];

    // The category of the class, the submenu of the Add menu of the editor listing it, `Gameplay`
    pub let category: [c8];

    // The kind of the descriptions of its nodes, ACTOR for an actor class
    pub let kind: NodeKind;

    prot self (name: [c8], label: [c8], category: [c8], kind: NodeKind)
        with name = name
        , label = label
        , category = category
        , kind = kind
    {}

    /**
     * @returns: the schema of the class, the properties of its nodes
     * */
    pub fn schema(self)-> &NodeSchema;

    /**
     * @returns: true iif a node is of the class
     * */
    pub fn isOf(self, node: &Node3D)-> bool;

    /**
     * @returns: the signals of the nodes of the class, which the scene files connect to the slots of other nodes
     * */
    pub fn signals(self)-> [SignalInfo] {
        []
    }

    /**
     * @returns: the slots of the nodes of the class, to which the scene files connect the signals of other nodes
     * */
    pub fn slots(self)-> [SlotInfo] {
        []
    }

    /**
     * @returns: the signal of a name, none when the class has none
     * */
    pub fn signal(self, name: [c8])-> (SignalInfo)? {
        for s in self.signals() if s.name == name { return s?; }
        none
    }

    /**
     * @returns: the slot of a name, none when the class has none
     * */
    pub fn slot(self, name: [c8])-> (SlotInfo)? {
        for s in self.slots() if s.name == name { return s?; }
        none
    }

    /**
     * @returns: a slot of a node of the class bound to it, none when the class has no slot of that name or the node is
     * of another class
     * */
    pub fn slotOf(self, dmut _: &Node3D, _: [c8])-> (&SlotRef)? {
        none
    }

    /**
     * Connect a signal of a node of the class to a slot of another node, the slot being emitted by a mailbox
     * @returns: false when the class has no signal of that name, the node is of another class, or the slot does not
     * take the payload of the signal
     * */
    pub fn connect(self, dmut _: &Node3D, _: [c8], _: &SlotRef, dmut _: &SlotEmitter)-> bool {
        false
    }

}
