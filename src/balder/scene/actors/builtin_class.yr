in builtin_class;

use balder::core::error;
use balder::scene::actors::node_class;
use balder::scene::description::kind;
use balder::scene::node::node3D;
use balder::scene::property::node_schema;

/**
 * A class of nodes of Balder a scene file names by its kind (a light, a camera, a body…), its schema declared beside
 * the class (see schemaOf), its nodes created by their descriptions (see NodeDescription::build)
 * */
@final
pub class BuiltinClass over NodeClass {

    /**
     * @params:
     *    - kind: the kind of the nodes of the class, its name being the name of the kind in the scene files
     *    - label: the name of the class in the editor
     *    - category: the category of the class
     * */
    pub self (kind: NodeKind, label: [c8], category: [c8])
        with super(kindName(kind), label, category, kind)
    {}

    pub over schema(self)-> &NodeSchema {
        schemaOf(self.kind)
    }

    pub over isOf(self, node: &Node3D)-> bool {
        {
            return kindOf(node) == self.kind;
        } catch {
            _: &BalderError => {}
        }

        false
    }

}
