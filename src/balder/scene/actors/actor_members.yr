in actor_members;

use balder::scene::actors::{signal_info, slot_info};
use balder::scene::property::node_property;

/**
 * What an actor class declares with its tags, read from a node of the class: its properties, its signals and its slots
 * */
@data
pub record ActorMembers {

    // The properties, the fields tagged #[export], in the order of the class, their defaults read from the node
    pub let properties: [&NodeProperty] = [];

    // The signals, the fields tagged #[emits]
    pub let signals: [SignalInfo] = [];

    // The slots, the methods tagged #[slot]
    pub let slots: [SlotInfo] = [];
}
