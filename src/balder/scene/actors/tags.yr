in tags;

use balder::core::application::signal;
use balder::math::vector;
use balder::scene::actors::{actor_class, actor_members, node_classes, signal_info, slot_info, slot_ref, utils};
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::property::{choice_property, kind, node_property, range, typed_property};

use std::uuid;

/**
 * Declare a class over Node3D an actor class, registered at the start of the program among the classes of nodes the
 * scene files name by their types (see registerActorClass), its nodes added by the editor and edited through their
 * properties
 * @params:
 *    - name: the type of its nodes in the scene files, lowercase letters, digits and '-', `door`
 *    - label: its name in the editor, the name made a sentence by default (`Door`)
 *    - category: the submenu of the Add menu of the editor listing it
 * @info:
 * =====
 * The class has a constructor `self (name: [c8], dmut parent: &Node)`, which creates the nodes of the scene files and
 * of the editor, their properties then given the values of the file. Its fields tagged #[export] are its properties,
 * its fields or methods tagged #[emits] its signals, its methods tagged #[slot] its slots, private ones included:
 * ```
 * #[actor ("door", category-> "Gameplay")]
 * pub class Door over Node3D {
 *     #[export (label-> "Opening speed", min-> 0.0f, max-> 10.0f)]
 *     let mut _speed: f32 = 2.0f;
 *
 *     #[emits]
 *     pub let dmut opened: &Signal!{()} = copy Signal!{()} ();
 *
 *     pub self (name: [c8], dmut parent: &Node) with super (name, alias parent) {}
 *
 *     #[slot]
 *     pub fn open (mut self) { … }
 * }
 * ```
 * An actor class over another one has the properties, the signals and the slots of the other one, then its own.
 * ====
 * */
pub tag actor (name: [c8], label: [c8] = "", category: [c8] = "Actors") {

    pub self {class C} () {
        registerActorClass(copy ActorClass(name, memberLabel(label, name), category, &createActor!{C}, &isActor!{C},
            |dmut probe| {
                probe;
                let mut properties: [&NodeProperty] = [];
                let mut signals: [SignalInfo] = [];
                let mut slots: [SlotInfo] = [];
                if let dmut c: C = alias probe {
                    cte for i in 0us .. C::field_infos.len {
                        cte if (__pragma!field_has_tag(C, C::field_infos[i].name, export)) {
                            cte assert(isPropertyType!{__pragma!field_type(C, C::field_infos[i].name)} (),
                                       "a field tagged #[export] is a f32, a vec3, a bool, a u32, a [c8], a [[c8]], a Uuid or an enum");
                            properties ~= [propertyOf!{C, __pragma!field_type(C, C::field_infos[i].name)} (
                                memberName(__pragma!field_tag(C, C::field_infos[i].name, export).name, C::field_infos[i].name),
                                __pragma!field(c, C::field_infos[i].name),
                                |dmut n| => __pragma!field(n, C::field_infos[i].name),
                                |dmut n, v| {
                                    cte if (__pragma!field_tag(C, C::field_infos[i].name, export).set.len != 0us) {
                                        __pragma!method(alias n, __pragma!field_tag(C, C::field_infos[i].name, export).set) (v);
                                    } else {
                                        __pragma!field(alias n, C::field_infos[i].name) = v;
                                    }
                                },
                                __pragma!field_tag(C, C::field_infos[i].name, export).label,
                                memberLabel(__pragma!field_tag(C, C::field_infos[i].name, export).group, memberLabel(label, name)),
                                NumberRange(min-> __pragma!field_tag(C, C::field_infos[i].name, export).min,
                                            max-> __pragma!field_tag(C, C::field_infos[i].name, export).max,
                                            step-> __pragma!field_tag(C, C::field_infos[i].name, export).step,
                                            decimals-> __pragma!field_tag(C, C::field_infos[i].name, export).decimals),
                                __pragma!field_tag(C, C::field_infos[i].name, export).color,
                                __pragma!field_tag(C, C::field_infos[i].name, export).asset,
                                __pragma!field_tag(C, C::field_infos[i].name, export).layers,
                                __pragma!field_tag(C, C::field_infos[i].name, export).degrees)];
                        }

                        cte if (__pragma!field_has_tag(C, C::field_infos[i].name, emits)) {
                            cte assert(__pragma!compile(payloadOf(__pragma!field(c, C::field_infos[i].name))),
                                       "a field tagged #[emits] holds a &Signal!{…}");
                            signals ~= [SignalInfo(name-> memberName(__pragma!field_tag(C, C::field_infos[i].name, emits).name, C::field_infos[i].name),
                                                   payload-> payloadOf(__pragma!field(c, C::field_infos[i].name)))];
                        }
                    }

                    cte for j in 0us .. __pragma!method_infos(C).len {
                        cte if (__pragma!method_has_tag(C, __pragma!method_infos(C)[j].name, emits)) {
                            cte assert(__pragma!method_infos(C)[j].arity == 0us,
                                       "a method tagged #[emits] takes no parameter but self, and returns the signal");
                            cte assert(__pragma!compile(payloadOf(__pragma!method(alias c, __pragma!method_infos(C)[j].name) ())),
                                       "a method tagged #[emits] returns a dmut &Signal!{…}");
                            signals ~= [SignalInfo(name-> memberName(__pragma!method_tag(C, __pragma!method_infos(C)[j].name, emits).name, __pragma!method_infos(C)[j].name),
                                                   payload-> payloadOf(__pragma!method(alias c, __pragma!method_infos(C)[j].name) ()))];
                        }

                        cte if (__pragma!method_has_tag(C, __pragma!method_infos(C)[j].name, slot)) {
                            slots ~= [SlotInfo(name-> memberName(__pragma!method_tag(C, __pragma!method_infos(C)[j].name, slot).name, __pragma!method_infos(C)[j].name),
                                               params-> slotRef(&__pragma!method(alias c, __pragma!method_infos(C)[j].name)).params)];
                        }
                    }
                }

                ActorMembers(properties-> properties, signals-> signals, slots-> slots)
            },
            |dmut node, wanted| {
                node;
                wanted;
                let mut found: (&SlotRef)? = none;
                if let dmut c: C = alias node {
                    c;
                    cte for j in 0us .. __pragma!method_infos(C).len {
                        cte if (__pragma!method_has_tag(C, __pragma!method_infos(C)[j].name, slot)) {
                            if wanted == memberName(__pragma!method_tag(C, __pragma!method_infos(C)[j].name, slot).name, __pragma!method_infos(C)[j].name) {
                                found = slotRef(&__pragma!method(alias c, __pragma!method_infos(C)[j].name))?;
                            }
                        }
                    }
                }

                found
            },
            |dmut node, wanted, target, dmut box| {
                node;
                wanted;
                target;
                box;
                if let dmut c: C = alias node {
                    c;
                    cte for i in 0us .. C::field_infos.len {
                        cte if (__pragma!field_has_tag(C, C::field_infos[i].name, emits)) {
                            if wanted == memberName(__pragma!field_tag(C, C::field_infos[i].name, emits).name, C::field_infos[i].name) {
                                return connectSignal(alias __pragma!field(alias c, C::field_infos[i].name), target, alias box);
                            }
                        }
                    }

                    cte for j in 0us .. __pragma!method_infos(C).len {
                        cte if (__pragma!method_has_tag(C, __pragma!method_infos(C)[j].name, emits)) {
                            if wanted == memberName(__pragma!method_tag(C, __pragma!method_infos(C)[j].name, emits).name, __pragma!method_infos(C)[j].name) {
                                return connectSignal(alias __pragma!method(alias c, __pragma!method_infos(C)[j].name) (), target, alias box);
                            }
                        }
                    }
                }

                false
            }));
    }

}

/**
 * Declare a field of an actor class a property of its nodes, saved by the scene files and edited by the inspector of
 * the editor; the field is mutable, of a type of the properties (f32, vec3, bool, u32, [c8], [[c8]], Uuid) or an enum
 * @params:
 *    - name: the name of its entry in the scene files, the name of the field in kebab case by default (`open-speed`)
 *    - label: the label of its row in the inspector, its name made a sentence by default (`Open speed`)
 *    - group: the section of the inspector holding it, the label of the class by default
 *    - min, max, step, decimals: the numbers the inspector lets a number or a vector take, and how it steps
 *    - color: true for a vec3 holding a colour
 *    - asset: true for a [c8] holding the project path of a file
 *    - layers: true for a u32 holding the bits of the collision layers
 *    - degrees: true for angles in radians, given in degrees by the scene files and the inspector
 *    - set: the name of a method `(mut self, T)` giving the value, instead of the field being written
 * */
pub tag export (name: [c8] = "", label: [c8] = "", group: [c8] = "",
                  min: f32 = -10000.0f, max: f32 = 10000.0f, step: f32 = 0.01f, decimals: u32 = 2u32,
                  color: bool = false, asset: bool = false, layers: bool = false, degrees: bool = false,
                  set: [c8] = "") {}

/**
 * Declare a signal of an actor class, which the scene files connect to the slots of other actors: a field holding a
 * &Signal!{…}, or a method `(mut self)` returning one, as Balder gives its signals (`transformationChanged`)
 * @params:
 *    - name: its name in the scene files, the name of the field or of the method in kebab case by default
 * @example:
 * ```
 * #[emits]
 * pub let dmut opened: &Signal!{()} = copy Signal!{()} ();
 *
 * #[emits (name-> "hit")]
 * pub fn hitSignal (mut self)-> dmut &Signal!{f32} { alias self._hit }
 * ```
 * */
pub tag emits (name: [c8] = "") {}

/**
 * Declare a method of an actor class a slot, to which the scene files connect the signals of other actors: it takes
 * the payload of the signals connected to it
 * @params:
 *    - name: its name in the scene files, the name of the method in kebab case by default
 * */
pub tag slot (name: [c8] = "") {}

/**
 * @returns: a node of an actor class under a parent
 * */
pub fn createActor {C} (name: [c8], dmut parent: &Node)-> dmut &Node3D {
    copy C (name, alias parent)
}

/**
 * @returns: true iif a node is of an actor class
 * */
pub fn isActor {C} (node: &Node3D)-> bool {
    if let _: C = node { return true; }
    false
}

/**
 * @returns: the property of a field of an actor class, a choice for an enum
 * */
pub fn propertyOf {C, T} (name: [c8], default: T, get: dg (dmut C)-> T, set: dg (dmut C, T)-> void, label: [c8],
                          group: [c8], range: NumberRange, color: bool, asset: bool, layers: bool, degrees: bool)-> &NodeProperty
{
    cte if (__pragma!compile(T::__names__)) {
        range; color; asset; layers; degrees;
        return copy ChoiceProperty!{C, T} (name, default, choiceTable!{T} (), get, set-> set?,
                                           label-> memberLabel(label, name), group-> group);
    } else {
        let kind = if color { PropertyKind::COLOR } else if asset { PropertyKind::ASSET } else if layers { PropertyKind::LAYERS } else { kindOf!{T} () };
        return copy Property!{C, T} (name, default, get, set-> set?, kind-> kind, label-> memberLabel(label, name),
                                     group-> group, range-> range, degrees-> degrees);
    }
}

/**
 * @returns: true iif a property holds values of type T, a type of PropertyValue (see kindOf) or an enum
 * */
pub fn isPropertyType {T} ()-> bool {
    cte if (__pragma!compile(T::__names__)) { return true; }
    else { return __pragma!compile(kindOf!{T} ()); }
}

/**
 * @returns: the choices of an enum, each member named in kebab case (`SLOW_OPEN` is `slow-open`, labelled `Slow open`)
 * */
pub fn choiceTable {E} ()-> [([c8], [c8], E)] {
    let mut table: [([c8], [c8], E)] = [];
    cte for i in 0us .. E::__members__.len {
        table ~= [(choiceName(E::__names__[i]), memberLabel("", choiceName(E::__names__[i])), E::__members__[i])];
    }

    table
}
