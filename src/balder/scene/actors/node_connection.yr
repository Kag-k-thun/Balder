in node_connection;

use std::uuid;

/**
 * A connection of a signal of an actor to a slot of another node of its scene, which a scene file gives and the
 * building of the scene makes (see connectActors): `on-pressed: #<id of the door> open;`
 * */
@data
pub record NodeConnection {

    // The name of the signal of the actor, `pressed`
    pub let signal: [c8] = "";

    // The id of the node receiving the signal (see Node3D.guid)
    pub let target: Uuid = Uuid::nil();

    // The name of the slot of the node receiving the signal, `open`
    pub let slot: [c8] = "";
}
