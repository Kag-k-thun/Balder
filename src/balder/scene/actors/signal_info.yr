in signal_info;

use ::core::types::info;

/**
 * A signal of an actor class, a field tagged #[emits]: the name a scene file connects it by and the types of what it
 * gives
 * */
@data
pub record SignalInfo {

    // The name of the signal in the scene files, `pressed`
    pub let name: [c8] = "";

    // The types of its payload, none for a Signal!{()}
    pub let payload: [TypeInfo] = [];
}
