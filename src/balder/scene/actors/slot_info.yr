in slot_info;

use ::core::types::info;

/**
 * A slot of an actor class, a method tagged #[slot]: the name a scene file connects a signal to it by and the types of
 * its parameters, the payload of the signals it takes
 * */
@data
pub record SlotInfo {

    // The name of the slot in the scene files, `open`
    pub let name: [c8] = "";

    // The types of its parameters
    pub let params: [TypeInfo] = [];
}
