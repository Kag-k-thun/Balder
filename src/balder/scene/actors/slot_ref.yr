in slot_ref;

use balder::core::application::signal;
use balder::utils::types;

use ::core::types::info;

/**
 * A slot of a node, the delegate of a method tagged #[slot] bound to the node, with the types of its parameters: the
 * signal of another actor connects to it when they are the types of its payload (see NodeClass::connect)
 * */
@abstract
pub class SlotRef {

    // The types of the parameters of the slot
    pub let params: [TypeInfo];

    prot self (params: [TypeInfo])
        with params = params
    {}

}

/**
 * A slot without parameter
 * */
@final
pub class SlotRef {T of ()} over SlotRef {

    // The method of the node
    pub let slot: dg ()-> void;

    pub self (slot: dg ()-> void)
        with super([])
        , slot = slot
    {}

}

/**
 * A slot of parameters T
 * */
@final
pub class SlotRef {T...} over SlotRef {

    // The method of the node
    pub let slot: dg (T)-> void;

    pub self (slot: dg (T)-> void)
        with super(typesOf!{(T,)} ())
        , slot = slot
    {}

}

/**
 * @returns: the slot of a method bound to a node
 * */
pub fn slotRef(slot: dg ()-> void)-> &SlotRef {
    copy SlotRef!{()} (slot)
}

pub fn slotRef {T...} (slot: dg (T)-> void)-> &SlotRef {
    copy SlotRef!{T} (slot)
}

/**
 * @returns: the types of the payload of a signal
 * */
pub fn payloadOf(_: &Signal!{()})-> [TypeInfo] {
    []
}

pub fn payloadOf {T...} (_: &Signal!{T})-> [TypeInfo] {
    typesOf!{(T,)} ()
}

/**
 * Connect a signal to a slot taking its payload, the slot being emitted by a mailbox
 * @returns: false when the slot takes something else than the payload of the signal
 * */
pub fn connectSignal(dmut signal: &Signal!{()}, slot: &SlotRef, dmut box: &SlotEmitter)-> bool {
    if let s: &SlotRef!{()} = slot {
        signal:.connect(alias box, s.slot);
        return true;
    }

    false
}

pub fn connectSignal {T...} (dmut signal: &Signal!{T}, slot: &SlotRef, dmut box: &SlotEmitter)-> bool {
    if let s: &SlotRef!{T} = slot {
        signal:.connect(alias box, s.slot);
        return true;
    }

    false
}
