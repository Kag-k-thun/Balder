in node_classes;

use balder::scene::actors::{actor_class, builtin_class, node_class};
use balder::scene::description::kind;
use balder::scene::node::node3D;
use balder::utils::log;

/**
 * Register an actor class, which the tag #[actor] does at the start of the program
 * @info: a class of the type of another one, built-in or actor, or of a type that is not a name of the scene files
 * (lowercase letters, digits and '-', starting with a letter) is refused, an error logged
 * */
pub fn registerActorClass(c: &ActorClass) {
    if !isClassName(c.name) {
        log::error #("Actor", f"Actor class '${c.name}' refused: its type must be lowercase letters, digits and '-', starting with a letter");
        return;
    }

    if nodeClass(c.name).hasValue {
        log::error #("Actor", f"Actor class '${c.name}' refused: another class of nodes has that type");
        return;
    }

    __ACTORS__ ~= [c];
}

/**
 * Unregister an actor class, the classes of a library about to be closed (the library of a game the editor reloads):
 * the members and the schemas read from the actor classes are dropped with it (see ActorClass::forgetMembers)
 * @returns: true iif an actor class of that type was registered
 * @info: nothing of the class may be used afterwards, its nodes, its probe and the delegates it holds being of its code
 * */
pub fn unregisterActorClass(name: [c8])-> bool {
    let mut kept: [&ActorClass] = [];
    let mut found = false;
    for c in __ACTORS__ {
        if c.name == name { found = true; } else { kept ~= [c]; }
    }

    if found {
        __ACTORS__ = kept;
        ActorClass::forgetMembers();
    }

    found
}

/**
 * @returns: the classes of the nodes the scene files describe, the built-in classes first, then the actor classes in
 * the order of their registration
 * */
pub fn nodeClasses()-> [&NodeClass] {
    let mut res: [&NodeClass] = [];
    for b in builtinClasses() { res ~= [b]; }
    for a in __ACTORS__ { res ~= [a]; }
    res
}

/**
 * @returns: the actor classes registered, in the order of their registration
 * */
pub fn actorClasses()-> [&ActorClass] {
    __ACTORS__
}

/**
 * @returns: the class of nodes of a type of the scene files, none when no class has it
 * */
pub fn nodeClass(name: [c8])-> (&NodeClass)? {
    for c in nodeClasses() if c.name == name { return c?; }
    none
}

/**
 * @returns: the actor class of a type of the scene files, none when no actor class has it
 * */
pub fn actorClass(name: [c8])-> (&ActorClass)? {
    for c in __ACTORS__ if c.name == name { return c?; }
    none
}

/**
 * @returns: the actor class of a node, the furthest from Node3D of those it is of, none for a node of no actor class
 * */
pub fn actorClassOf(node: &Node3D)-> (&ActorClass)? {
    let mut best: (&ActorClass)? = none;
    let mut depth = 0us;
    for c in __ACTORS__ if c.isOf(node) {
        let d = c.ancestors().len;
        if !best.hasValue || d > depth {
            best = c?;
            depth = d;
        }
    }

    best
}

/**
 * @returns: the built-in classes of Balder, in the order of their kinds
 * */
pub fn builtinClasses()-> [&BuiltinClass] {
    copy [copy BuiltinClass(NodeKind::EMPTY, "Empty", "Basic"),
          copy BuiltinClass(NodeKind::MESH, "Mesh", "Meshes"),
          copy BuiltinClass(NodeKind::LIGHT, "Light", "Lights"),
          copy BuiltinClass(NodeKind::MARKER, "Marker", "Markers"),
          copy BuiltinClass(NodeKind::PATH, "Path", "Paths"),
          copy BuiltinClass(NodeKind::PATH_POINT, "Point of a path", "Paths"),
          copy BuiltinClass(NodeKind::VOLUME, "Volume", "Volumes"),
          copy BuiltinClass(NodeKind::BODY, "Body", "Physics"),
          copy BuiltinClass(NodeKind::CHARACTER, "Character", "Physics"),
          copy BuiltinClass(NodeKind::CAMERA, "Camera", "Cameras")]
}

/**
 * The actor classes, in the order of their registration
 * */
lazy mut __ACTORS__: [&ActorClass] = [];

/**
 * @returns: true iif a name is a type of the scene files: lowercase letters, digits and '-', starting with a letter
 * */
fn isClassName(name: [c8])-> bool {
    if name.len == 0us || name[0] < 'a' || name[0] > 'z' { return false; }
    for c in name {
        if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; }
    }

    true
}
