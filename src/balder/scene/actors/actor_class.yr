in actor_class;

use balder::core::application::signal;
use balder::scene::actors::{actor_members, node_class, node_classes, signal_info, slot_info, slot_ref};
use balder::scene::description::kind;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::property::{group, node_property, node_schema};

/**
 * An actor class, a class of nodes a game declares with the tags #[actor], #[export], #[emits] and #[slot]: the
 * delegates the tag #[actor] builds in the scope of the class, reaching its private members
 * @info: what the class declares is read once from a node of the class created under no scene (its probe), the
 * properties of an actor class over another one being those of the other one then its own, and so are its signals and
 * its slots
 * */
@final
pub class ActorClass over NodeClass {

    let _create: fn ([c8], dmut &Node)-> dmut &Node3D;

    let _isOf: fn (&Node3D)-> bool;

    let _members: dg (dmut &Node3D)-> ActorMembers;

    let _slotOf: dg (dmut &Node3D, [c8])-> (&SlotRef)?;

    let _connect: dg (dmut &Node3D, [c8], &SlotRef, dmut &SlotEmitter)-> bool;

    /**
     * @params:
     *    - name: the type of its nodes in the scene files
     *    - label: its name in the editor
     *    - category: the submenu of the Add menu of the editor listing it
     *    - create: creates a node of the class under a parent, `C (name, alias parent)`
     *    - isOf: true for a node of the class
     *    - members: the properties, the signals and the slots the class declares, read from a node of the class
     *    - slotOf: a slot of a node of the class, by its name, bound to the node
     *    - connect: connects a signal of a node of the class, by its name, to a slot
     * */
    pub self (name: [c8], label: [c8], category: [c8],
              create: fn ([c8], dmut &Node)-> dmut &Node3D,
              isOf: fn (&Node3D)-> bool,
              members: dg (dmut &Node3D)-> ActorMembers,
              slotOf: dg (dmut &Node3D, [c8])-> (&SlotRef)?,
              connect: dg (dmut &Node3D, [c8], &SlotRef, dmut &SlotEmitter)-> bool)
        with super(name, label, category, NodeKind::ACTOR)
        , _create = create
        , _isOf = isOf
        , _members = members
        , _slotOf = slotOf
        , _connect = connect
    {}

    /**
     * @returns: a node of the class, under a parent, its properties holding the values its constructor gives
     * */
    pub fn create(self, name: [c8], dmut parent: &Node)-> dmut &Node3D {
        alias self._create(name, alias parent)
    }

    pub over isOf(self, node: &Node3D)-> bool {
        self._isOf(node)
    }

    /**
     * @returns: the node of the class the members are read from, created once under no scene
     * */
    pub fn probe(self)-> dmut &Node3D {
        if let Ok(dmut p) = alias __PROBES__[self.name] { return alias p; }

        let dmut root = copy ProbeRoot();
        let dmut p = alias self._create("__probe__", alias root);
        __PROBES__[self.name] = alias p;
        alias p
    }

    /**
     * @returns: the actor classes the class is over, the furthest first
     * */
    pub fn ancestors(self)-> [&ActorClass] {
        let dmut probe = alias self.probe();
        let mut found: [&ActorClass] = [];
        for a in actorClasses() if a.name != self.name && a.isOf(probe) {
            found ~= [a];
        }

        // the furthest is the one over the fewest
        let mut sorted: [&ActorClass] = [];
        for depth in 0us .. found.len + 1us {
            for a in found if a.ancestors().len == depth {
                sorted ~= [a];
            }
        }

        sorted
    }

    /**
     * @returns: the properties, the signals and the slots of the class, those of the actor classes it is over first, a
     * member of a name taken before left out
     * */
    pub fn members(self)-> ActorMembers {
        if let Ok(m) = __MEMBERS__[self.name] { return m; }

        let mut properties: [&NodeProperty] = [];
        let mut signals: [SignalInfo] = [];
        let mut slots: [SlotInfo] = [];
        let mut all: [ActorMembers] = [];
        for a in self.ancestors() { all ~= [a.ownMembers()]; }
        all ~= [self.ownMembers()];

        for m in all {
            for p in m.properties if !hasProperty(properties, p.name) { properties ~= [p]; }
            for s in m.signals if !hasSignal(signals, s.name) { signals ~= [s]; }
            for s in m.slots if !hasSlot(slots, s.name) { slots ~= [s]; }
        }

        let res = ActorMembers(properties-> properties, signals-> signals, slots-> slots);
        __MEMBERS__[self.name] = res;
        res
    }

    /**
     * @returns: the properties, the signals and the slots the class declares itself
     * */
    pub fn ownMembers(self)-> ActorMembers {
        self._members(alias self.probe())
    }

    pub over schema(self)-> &NodeSchema {
        if let Ok(s) = __SCHEMAS__[self.name] { return s; }

        let properties = self.members().properties;
        let mut groups: [PropertyGroup] = [];
        for p in properties {
            let mut found = false;
            for g in groups if g.name == p.group { found = true; }
            if !found { groups ~= [PropertyGroup(name-> p.group)]; }
        }

        let dmut s = copy NodeSchema(self.name, groups-> groups, properties-> properties);
        __SCHEMAS__[self.name] = alias s;
        s
    }

    pub over signals(self)-> [SignalInfo] {
        self.members().signals
    }

    pub over slots(self)-> [SlotInfo] {
        self.members().slots
    }

    pub over slotOf(self, dmut node: &Node3D, name: [c8])-> (&SlotRef)? {
        if let Ok(s) = self._slotOf(alias node, name) { return s?; }
        for a in self.ancestors() {
            if let Ok(s) = a.slotOf(alias node, name) { return s?; }
        }

        none
    }

    pub over connect(self, dmut node: &Node3D, signal: [c8], slot: &SlotRef, dmut box: &SlotEmitter)-> bool {
        if self._connect(alias node, signal, slot, alias box) { return true; }
        for a in self.ancestors() {
            if a.connect(alias node, signal, slot, alias box) { return true; }
        }

        false
    }

}

/**
 * What is read from the actor classes registered
 * */
pub mod ActorClass {

    /**
     * Drop the probes, the members and the schemas read from the actor classes, read again from the classes registered
     * the next time they are asked: a class unregistered is gone (see unregisterActorClass), the members of a class
     * holding those of the classes it is over, and its probe is of its code, which goes with the library declaring it
     * */
    pub fn forgetMembers() {
        __PROBES__ = copy [];
        __MEMBERS__ = copy [];
        __SCHEMAS__ = copy [];
    }

}

/**
 * The probes of the actor classes, by their names
 * */
lazy dmut __PROBES__: [[c8] => &Node3D] = copy [];

/**
 * The members of the actor classes, by their names
 * */
lazy dmut __MEMBERS__: [[c8] => ActorMembers] = copy [];

/**
 * The schemas of the actor classes, by their names
 * */
lazy dmut __SCHEMAS__: [[c8] => &NodeSchema] = copy [];

/**
 * The root the probes hang from, in no scene
 * */
class ProbeRoot over Node {

    pub self ()
        with super::root("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

fn hasProperty(properties: [&NodeProperty], name: [c8])-> bool {
    for p in properties if p.name == name { return true; }
    false
}

fn hasSignal(signals: [SignalInfo], name: [c8])-> bool {
    for s in signals if s.name == name { return true; }
    false
}

fn hasSlot(slots: [SlotInfo], name: [c8])-> bool {
    for s in slots if s.name == name { return true; }
    false
}
