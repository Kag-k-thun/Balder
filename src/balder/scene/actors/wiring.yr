in wiring;

use balder::core::application::signal;
use balder::scene::actors::{node_classes, unknown_actor};
use balder::scene::node;
use balder::scene::node::node3D;

use std::uuid;

/**
 * Connect the signals of the actors under nodes, the nodes of a scene file just built, to the slots of the nodes of a
 * tree their connections name (see Node3D.connections)
 * @params:
 *    - nodes: the nodes built, the actors among them and under them connected
 *    - root: the root of the tree holding the nodes their connections name, by their ids
 *    - box: the mailbox emitting the slots, the one of the scene (see Scene::getSlotEmitter)
 * @returns: why the connections not made were not, a message each: a node of no actor class (an unknown one), a node
 * not in the tree, a slot the node does not have, or a slot not taking the payload of its signal
 * */
pub fn connectActors(dmut nodes: [&Node3D], dmut root: &Node, dmut box: &SlotEmitter)-> [[c8]] {
    let dmut byId: [Uuid => &Node3D] = copy [];
    let dmut all: [&Node] = [];
    for dmut n in alias root:.getAllNodes(ref all) {
        if let dmut d: &Node3D = alias n { byId[d.guid] = alias d; }
    }

    let mut errors: [[c8]] = [];
    for dmut top in alias nodes {
        let dmut under: [&Node] = [];
        for dmut n in alias top:.getAllNodes(ref under) {
            if let dmut source: &Node3D = alias n {
                errors ~= connectNode(alias source, alias byId, alias box);
            }
        }
    }

    errors
}

/**
 * Connect the signals of an actor to the slots its connections name
 * @returns: why the connections not made were not
 * */
fn connectNode(dmut source: &Node3D, dmut byId: [Uuid => &Node3D], dmut box: &SlotEmitter)-> [[c8]] {
    if source.connections.len == 0us { return []; }

    let what = source.name.toStr();
    let cls = if let Ok(c) = actorClassOf(source) { c } else {
        if let u: &UnknownActor = source {
            return copy [f"${what}: its class '${u.className}' is unknown, its connections are kept but not made"];
        }

        return copy [f"${what}: not an actor, its connections are not made"];
    };

    let mut errors: [[c8]] = [];
    for c in source.connections {
        let dmut target = if let Ok(dmut t) = alias byId[c.target] { alias t } else {
            errors ~= [f"${what}: ${c.signal} is connected to #${c.target}, no node of the scene"];
            continue;
        };

        let targetClass = if let Ok(t) = actorClassOf(target) { t } else {
            errors ~= [f"${what}: ${c.signal} is connected to ${target.name.toStr()}, which has no slot"];
            continue;
        };

        let slot = if let Ok(s) = targetClass.slotOf(alias target, c.slot) { s } else {
            errors ~= [f"${what}: ${c.signal} is connected to ${target.name.toStr()}, which has no slot '${c.slot}'"];
            continue;
        };

        if !cls.connect(alias source, c.signal, slot, alias box) {
            errors ~= [f"${what}: ${c.signal} cannot be connected to the slot '${c.slot}' of ${target.name.toStr()}, which does not take its payload"];
        }
    }

    errors
}
