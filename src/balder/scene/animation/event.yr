in event;

/**
 * Something happening at a time of a clip, a footstep..., signalled by the players of the clip each time they cross it
 * (see AnimationClip.addEvent)
 * */
@data
pub record AnimationEvent {

    // The time of the event in the clip, in seconds
    let time: f32;

    // What happens at that time, "footstep"...
    let name: [c8];
}
