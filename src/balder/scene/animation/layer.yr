in layer;

use balder::scene::animation::{clip, clip_state, event, joint_mask, joint_pose, skeleton};

/**
 * A layer of an animation player: the clips it plays, the clip played last (its current clip) fading in as the others
 * fade out, blended into one pose put over the layers below it, on the joints of its mask and by its weight
 * @info:
 *    - an override layer replaces the pose below it (an upper body playing over the walk of the legs); an additive
 *      layer adds to it the motion of its clips from their first pose (a breath, a flinch)
 *    - only the current clip signals its events and its end, the clips fading out being silent, so that a cross-fade
 *      between two walks does not double the footsteps
 * */
@final
pub class AnimationLayer {

    // The clips played, the current one last, the others fading out
    let dmut _states: [ClipState] = [];

    // The weight of each joint in the layer, none for every joint fully
    let _mask: (JointMask)?;

    // The part the layer takes in the pose, in [0, 1]
    let mut _weight: f32;

    // True when the layer adds the motion of its clips to the pose below it, false when it replaces that pose
    let _additive: bool;

    // True when the current clip fades out too, the layer stopping
    let mut _stopping: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * An empty layer, playing no clip
     * @params:
     *    - mask: the weight of each joint in the layer, none for every joint fully
     *    - weight: the part the layer takes in the pose, in [0, 1]
     *    - additive: true for the layer to add the motion of its clips to the pose below it
     * */
    pub self (mask: (JointMask)? = none, weight: f32 = 1.0f, additive: bool = false)
        with _mask = mask
        , _weight = weight
        , _additive = additive
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the weight of each joint in the layer, none for every joint fully
     * */
    @field
    pub fn mask(self)-> (JointMask)? {
        self._mask
    }

    /**
     * @returns: the part the layer takes in the pose, in [0, 1]
     * */
    @field
    pub fn weight(self)-> f32 {
        self._weight
    }

    /**
     * Change the part the layer takes in the pose, held in [0, 1]
     * */
    @field
    pub fn weight(mut self, weight: f32) {
        self._weight = if weight < 0.0f { 0.0f } else if weight > 1.0f { 1.0f } else { weight };
    }

    /**
     * @returns: true iif the layer adds the motion of its clips to the pose below it
     * */
    @field
    pub fn additive(self)-> bool {
        self._additive
    }

    /**
     * @returns: the clips the layer plays, the current one last, with their times and their weights
     * */
    @field
    pub fn states(self)-> [ClipState] {
        self._states
    }

    /**
     * @returns: the clip played last, fading in or faded in, none when the layer plays nothing or stops
     * */
    @field
    pub fn current(self)-> (ClipState)? {
        if self._stopping || self._states.len == 0us {
            return none;
        }

        (self._states[$ - 1us])?
    }

    /**
     * @returns: true iif the layer plays a clip, its current one or one fading out
     * */
    @field
    pub fn playing(self)-> bool {
        self._states.len != 0us
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PLAYBACK          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Play a clip from its start (from its end when played backwards), the clip becoming the current one, fading in
     * over a time as the clips played before it fade out over the same time, the weights of all summing to the same
     * @params:
     *    - clip: the clip played
     *    - looping: true for the clip to start again at its end, false to hold its last pose
     *    - speed: the speed of the clip, negative to play it backwards
     *    - fade: the time of the cross-fade, in seconds, 0 to replace the clips played at once
     * */
    pub fn play(mut self, clip: &AnimationClip, looping: bool = true, speed: f32 = 1.0f, fade: f32 = 0.0f) {
        let start = if speed < 0.0f { clip.duration } else { 0.0f };
        if fade <= 0.0f {
            self._states = copy [ClipState(clip, time-> start, speed-> speed, looping-> looping)];
        } else {
            self:.fadeOut(fade);
            self._states ~= [ClipState(clip, time-> start, speed-> speed, looping-> looping, weight-> 0.0f,
                                       fade-> 1.0f / fade)];
        }

        self._stopping = false;
    }

    /**
     * Stop the clips of the layer, fading them out over a time, the layer playing nothing once they faded out
     * @params:
     *    - fade: the time of the fade, in seconds, 0 to stop at once
     * */
    pub fn stop(mut self, fade: f32 = 0.0f) {
        if fade <= 0.0f {
            self._states = [];
        } else {
            self:.fadeOut(fade);
        }

        self._stopping = true;
    }

    /**
     * Move the current clip to a time, wrapped in the clip when it loops, held in it otherwise, no event being crossed;
     * nothing is done when the layer has no current clip
     * @params:
     *    - time: the time in the clip, in seconds
     * */
    pub fn seek(mut self, time: f32) {
        if self.current.hasValue {
            let mut state = self._states[$ - 1us];
            state:.place(time);
            self._states[$ - 1us] = state;
        }
    }

    /**
     * Change the speed of the current clip, negative to play it backwards; nothing is done when the layer has no
     * current clip
     * */
    pub fn speed(mut self, speed: f32) {
        if self.current.hasValue {
            self._states[$ - 1us].speed = speed;
        }
    }

    /**
     * Move the clips of the layer along a time elapsed, at their speeds, their weights along their fades, the clips
     * faded out leaving the layer; only the current clip signals the events it crosses and its end
     * @params:
     *    - seconds: the time elapsed, in seconds
     *    - crossed: called with each event the current clip crosses
     *    - ended: called with the current clip when, played once, it reaches its end
     * */
    pub fn advance(mut self, seconds: f32, crossed: dg (AnimationEvent)-> void, ended: dg (&AnimationClip)-> void) {
        if self._states.len == 0us { return; }

        let hasCurrent = self.current.hasValue;
        let last = self._states.len - 1us;
        let mut faded = 0us;
        for i in 0us .. self._states.len {
            // the states are records, written back by index
            let mut state = self._states[i];
            if hasCurrent && i == last {
                if state:.advance(seconds, crossed) {
                    ended(state.clip);
                }
            } else {
                state:.place(state.time + seconds * state.speed);
            }

            state:.fadeAlong(seconds);
            self._states[i] = state;
            if state.fadingOut && state.weight <= 0.0f {
                faded += 1us;
            }
        }

        // the clips faded out leave the layer, which allocates only at the end of a fade
        if faded != 0us {
            let dmut kept: [ClipState] = [];
            for state in self._states {
                if !(state.fadingOut && state.weight <= 0.0f) {
                    kept ~= [state];
                }
            }

            self._states = alias kept;
        }
    }

    /**
     * Write the pose of the layer in a buffer, the poses of its clips blended by their weights, allocating nothing; the
     * pose of an additive layer is the motion of its clips from their first pose (see JointPose.difference)
     * @params:
     *    - skeleton: the skeleton moved
     *    - pose: the buffer of the pose of the layer, a pose for each joint of the skeleton
     *    - sample: a buffer of the same size, the pose of each clip sampled in it
     *    - reference: a buffer of the same size, the first pose of each clip of an additive layer sampled in it
     * @returns: the part the clips take in the pose, the sum of their weights held in [0, 1], 0 when the layer plays
     * nothing (the buffer left as it was)
     * */
    pub fn poseInto(self, skeleton: &Skeleton, dmut pose: [JointPose], dmut sample: [JointPose], dmut reference: [JointPose])-> f32 {
        let mut total = 0.0f;
        for state in self._states {
            if state.weight > 0.0f {
                state.clip.sampleInto(skeleton, state.time, alias sample);
                if self._additive {
                    state.clip.sampleInto(skeleton, 0.0f, alias reference);
                    for j in 0us .. sample.len {
                        sample[j] = sample[j].difference(reference[j]);
                    }
                }

                // each clip blended by its part of the weights so far, so the pose is their weighted mean
                total += state.weight;
                if total == state.weight {
                    for j in 0us .. sample.len {
                        pose[j] = sample[j];
                    }
                } else {
                    let w = state.weight / total;
                    for j in 0us .. sample.len {
                        pose[j] = pose[j].blended(sample[j], w);
                    }
                }
            }
        }

        if total > 1.0f { 1.0f } else { total }
    }

    /**
     * Fade out every clip of the layer over a time, from their weight to 0, a clip of no weight leaving the layer at
     * the next advance
     * @params:
     *    - fade: the time of the fade, in seconds, positive
     * */
    fn fadeOut(mut self, fade: f32) {
        for i in 0us .. self._states.len {
            let mut state = self._states[i];
            state.fade = if state.weight > 0.0f { -state.weight / fade } else { -1.0f };
            self._states[i] = state;
        }
    }

}
