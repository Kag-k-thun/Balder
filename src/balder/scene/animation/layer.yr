in layer;

use balder::scene::animation::{event, joint_mask, joint_pose, motion, motion_state, parameters, skeleton};

/**
 * A layer of an animation player: the motions it plays (clips, blend spaces), the motion played last (its current motion)
 * fading in as the others fade out, blended into one pose put over the layers below it, on the joints of its mask and by
 * its weight
 * @info:
 *    - an override layer replaces the pose below it (an upper body playing over the walk of the legs); an additive
 *      layer adds to it the motion of its clips from their first pose (a breath, a flinch)
 *    - only the current motion signals its events and its end, the motions fading out being silent, so that a
 *      cross-fade between two walks does not double the footsteps
 * */
@final
pub class AnimationLayer {

    // The motions played, the current one last, the others fading out
    let dmut _states: [MotionState] = [];

    // The weight of each joint in the layer, none for every joint fully
    let _mask: (JointMask)?;

    // The part the layer takes in the pose, in [0, 1]
    let mut _weight: f32;

    // True when the layer adds the motion of its clips to the pose below it, false when it replaces that pose
    let _additive: bool;

    // True when the current motion fades out too, the layer stopping
    let mut _stopping: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * An empty layer, playing no motion
     * @params:
     *    - mask: the weight of each joint in the layer, none for every joint fully
     *    - weight: the part the layer takes in the pose, in [0, 1]
     *    - additive: true for the layer to add the motion of its clips to the pose below it
     * */
    pub self (mask: (JointMask)? = none, weight: f32 = 1.0f, additive: bool = false)
        with _mask = mask
        , _weight = weight
        , _additive = additive
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the weight of each joint in the layer, none for every joint fully
     * */
    @field
    pub fn mask(self)-> (JointMask)? {
        self._mask
    }

    /**
     * @returns: the part the layer takes in the pose, in [0, 1]
     * */
    @field
    pub fn weight(self)-> f32 {
        self._weight
    }

    /**
     * Change the part the layer takes in the pose, held in [0, 1]
     * */
    @field
    pub fn weight(mut self, weight: f32) {
        self._weight = if weight < 0.0f { 0.0f } else if weight > 1.0f { 1.0f } else { weight };
    }

    /**
     * @returns: true iif the layer adds the motion of its clips to the pose below it
     * */
    @field
    pub fn additive(self)-> bool {
        self._additive
    }

    /**
     * @returns: the motions the layer plays, the current one last, with their times and their weights
     * */
    @field
    pub fn states(self)-> [MotionState] {
        self._states
    }

    /**
     * @returns: the motion played last, fading in or faded in, none when the layer plays nothing or stops
     * */
    @field
    pub fn current(self)-> (MotionState)? {
        if self._stopping || self._states.len == 0us {
            return none;
        }

        (self._states[$ - 1us])?
    }

    /**
     * @returns: true iif the layer plays a motion, its current one or one fading out
     * */
    @field
    pub fn playing(self)-> bool {
        self._states.len != 0us
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PLAYBACK          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Play a motion from its start (from its end when played backwards), the motion becoming the current one, fading in
     * over a time as the motions played before it fade out over the same time, the weights of all summing to the same
     * @params:
     *    - motion: the motion played, a clip or a blend space
     *    - parameters: the parameters of the player
     *    - looping: true for the motion to start again at its end, false to hold its last pose
     *    - speed: the speed of the motion, negative to play it backwards
     *    - fade: the time of the cross-fade, in seconds, 0 to replace the motions played at once
     * */
    pub fn play(mut self, motion: &AnimationMotion, parameters: &AnimationParameters, looping: bool = true,
                speed: f32 = 1.0f, fade: f32 = 0.0f) {
        self:.start(motion, parameters, looping, speed, fade);
    }

    /**
     * Stop the motions of the layer, fading them out over a time, the layer playing nothing once they faded out
     * @params:
     *    - fade: the time of the fade, in seconds, 0 to stop at once
     * */
    pub fn stop(mut self, fade: f32 = 0.0f) {
        if fade <= 0.0f {
            self._states = [];
        } else {
            self:.fadeOut(fade);
        }

        self._stopping = true;
    }

    /**
     * Move the current motion to a time, wrapped in the motion when it loops, held in it otherwise, no event being
     * crossed; nothing is done when the layer has no current motion
     * @params:
     *    - time: the time in the motion, in seconds
     * */
    pub fn seek(mut self, time: f32) {
        if self.current.hasValue {
            let mut state = self._states[$ - 1us];
            state:.place(time);
            self._states[$ - 1us] = state;
        }
    }

    /**
     * Change the speed of the current motion, negative to play it backwards; nothing is done when the layer has no
     * current motion
     * */
    pub fn speed(mut self, speed: f32) {
        if self.current.hasValue {
            self._states[$ - 1us].speed = speed;
        }
    }

    /**
     * Move the motions of the layer along a time elapsed, at their speeds, their weights along their fades, the motions
     * faded out leaving the layer; only the current motion signals the events it crosses and its end
     * @params:
     *    - seconds: the time elapsed, in seconds
     *    - parameters: the parameters of the player, the lengths of the blend spaces read again from them
     *    - crossed: called with each event the current motion crosses
     *    - ended: called with the current motion when, played once, it reaches its end
     * */
    pub fn advance(mut self, seconds: f32, parameters: &AnimationParameters, crossed: dg (AnimationEvent)-> void,
                   ended: dg (&AnimationMotion)-> void) {
        if self._states.len == 0us { return; }

        let hasCurrent = self.current.hasValue;
        let last = self._states.len - 1us;
        let mut faded = 0us;
        for i in 0us .. self._states.len {
            // the states are records, written back by index
            let mut state = self._states[i];
            state:.refresh(parameters);
            if hasCurrent && i == last {
                if state:.advance(seconds, crossed) {
                    ended(state.motion);
                }
            } else {
                state:.place(state.time + seconds * state.speed);
            }

            state:.fadeAlong(seconds);
            self._states[i] = state;
            if state.fadingOut && state.weight <= 0.0f {
                faded += 1us;
            }
        }

        // the motions faded out leave the layer, which allocates only at the end of a fade
        if faded != 0us {
            let dmut kept: [MotionState] = [];
            for state in self._states {
                if !(state.fadingOut && state.weight <= 0.0f) {
                    kept ~= [state];
                }
            }

            self._states = alias kept;
        }
    }

    /**
     * Write the pose of the layer in a buffer, the poses of its motions blended by their weights, allocating nothing; the
     * pose of an additive layer is the motion of its clips from their first pose (see JointPose.difference)
     * @params:
     *    - skeleton: the skeleton moved
     *    - parameters: the parameters of the player, placing its blend spaces between their clips
     *    - pose: the buffer of the pose of the layer, a pose for each joint of the skeleton
     *    - sample: a buffer of the same size, the pose of each motion sampled in it
     *    - scratch: a buffer of the same size, the clips of a blend space sampled in it
     *    - reference: a buffer of the same size, the first pose of each motion of an additive layer sampled in it
     * @returns: the part the motions take in the pose, the sum of their weights held in [0, 1], 0 when the layer plays
     * nothing (the buffer left as it was)
     * */
    pub fn poseInto(self, skeleton: &Skeleton, parameters: &AnimationParameters, dmut pose: [JointPose],
                    dmut sample: [JointPose], dmut scratch: [JointPose], dmut reference: [JointPose])-> f32 {
        let mut total = 0.0f;
        for state in self._states {
            if state.weight > 0.0f {
                state.motion.sampleMotionInto(skeleton, state.time, parameters, alias sample, alias scratch);
                if self._additive {
                    state.motion.sampleMotionInto(skeleton, 0.0f, parameters, alias reference, alias scratch);
                    for j in 0us .. sample.len {
                        sample[j] = sample[j].difference(reference[j]);
                    }
                }

                // each motion blended by its part of the weights so far, so the pose is their weighted mean
                total += state.weight;
                if total == state.weight {
                    for j in 0us .. sample.len {
                        pose[j] = sample[j];
                    }
                } else {
                    let w = state.weight / total;
                    for j in 0us .. sample.len {
                        pose[j] = pose[j].blended(sample[j], w);
                    }
                }
            }
        }

        if total > 1.0f { 1.0f } else { total }
    }

    /**
     * Play a motion, the current one fading in as the others fade out (see play)
     * */
    fn start(mut self, motion: &AnimationMotion, parameters: &AnimationParameters, looping: bool, speed: f32, fade: f32) {
        let duration = motion.motionDuration(parameters);
        let begin = if speed < 0.0f { duration } else { 0.0f };
        if fade <= 0.0f {
            self._states = copy [MotionState(motion, parameters, time-> begin, speed-> speed, looping-> looping)];
        } else {
            self:.fadeOut(fade);
            self._states ~= [MotionState(motion, parameters, time-> begin, speed-> speed, looping-> looping,
                                         weight-> 0.0f, fade-> 1.0f / fade)];
        }

        self._stopping = false;
    }

    /**
     * Fade out every motion of the layer over a time, from their weight to 0, a motion of no weight leaving the layer at
     * the next advance
     * @params:
     *    - fade: the time of the fade, in seconds, positive
     * */
    fn fadeOut(mut self, fade: f32) {
        for i in 0us .. self._states.len {
            let mut state = self._states[i];
            state.fade = if state.weight > 0.0f { -state.weight / fade } else { -1.0f };
            self._states[i] = state;
        }
    }

}
