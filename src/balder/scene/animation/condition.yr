in condition;

use balder::scene::animation::{condition_kind, parameters};

/**
 * A condition a transition of a state machine waits for, on a parameter the actor sets (see AnimationParameters): a
 * number above or below a threshold, a flag true or false, a trigger set
 * @example:
 * ```
 * AnimationCondition::above("speed", 0.1f)
 * AnimationCondition::isFalse("grounded")
 * AnimationCondition::triggered("jump")
 * ```
 * */
pub record AnimationCondition {

    // What the parameter is compared to
    pub let kind: AnimationConditionKind;

    // The name of the parameter
    pub let parameter: [c8];

    // The threshold of a number, unused by the flags and the triggers
    pub let threshold: f32;

    /**
     * @params:
     *    - kind: what the parameter is compared to
     *    - parameter: the name of the parameter
     *    - threshold: the threshold of a number
     * */
    pub self (kind: AnimationConditionKind, parameter: [c8], threshold: f32 = 0.0f)
        with kind = kind
        , parameter = parameter
        , threshold = threshold
    {}

    /**
     * The condition of a number above a threshold, strictly
     * */
    pub self above(parameter: [c8], threshold: f32)
        with kind = AnimationConditionKind::ABOVE
        , parameter = parameter
        , threshold = threshold
    {}

    /**
     * The condition of a number below a threshold, strictly
     * */
    pub self below(parameter: [c8], threshold: f32)
        with kind = AnimationConditionKind::BELOW
        , parameter = parameter
        , threshold = threshold
    {}

    /**
     * The condition of a flag set to true
     * */
    pub self isTrue(parameter: [c8])
        with kind = AnimationConditionKind::TRUE
        , parameter = parameter
        , threshold = 0.0f
    {}

    /**
     * The condition of a flag set to false, or never set
     * */
    pub self isFalse(parameter: [c8])
        with kind = AnimationConditionKind::FALSE
        , parameter = parameter
        , threshold = 0.0f
    {}

    /**
     * The condition of a trigger set, consumed by the transition it fires
     * */
    pub self triggered(parameter: [c8])
        with kind = AnimationConditionKind::TRIGGERED
        , parameter = parameter
        , threshold = 0.0f
    {}

    /**
     * @returns: true iif the parameters of the player meet the condition
     * */
    pub fn holds(self, parameters: &AnimationParameters)-> bool {
        match self.kind {
            AnimationConditionKind::ABOVE => { parameters.value(self.parameter) > self.threshold }
            AnimationConditionKind::BELOW => { parameters.value(self.parameter) < self.threshold }
            AnimationConditionKind::TRUE  => { parameters.flag(self.parameter) }
            AnimationConditionKind::FALSE => { !parameters.flag(self.parameter) }
            _                             => { parameters.triggered(self.parameter) }
        }
    }

}
