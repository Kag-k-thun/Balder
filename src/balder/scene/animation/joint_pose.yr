in joint_pose;

use balder::math::{matrix, quaternion, vector};

/**
 * The transformation of a joint relative to its parent: a scale, then a rotation, then a translation
 * */
pub record JointPose {

    pub let mut translation: vec3;

    pub let mut rotation: Quaternion;

    pub let mut scale: vec3;

    /**
     * The identity transformation by default
     * */
    pub self (translation: vec3 = vec3(), rotation: Quaternion = Quaternion(), scale: vec3 = makeVec3(1.0f, 1.0f, 1.0f))
        with translation = translation
        , rotation = rotation
        , scale = scale
    {}

    /**
     * The pose of a matrix, its translation, its rotation and its scale along the axes of the joint
     * @info: a matrix shearing its axes loses its shear; a matrix mirroring them gets a negative scale along x
     * @params:
     *    - m: the matrix, a scale, then a rotation, then a translation
     * */
    pub self fromMatrix(m: mat4)
        with translation = makeVec3(m.a4, m.b4, m.c4)
        , rotation = Quaternion()
        , scale = makeVec3(1.0f, 1.0f, 1.0f)
    {
        let cx = makeVec3(m.a1, m.b1, m.c1), cy = makeVec3(m.a2, m.b2, m.c2), cz = makeVec3(m.a3, m.b3, m.c3);
        let mut sx = cx.length();
        let sy = cy.length(), sz = cz.length();
        if cx.dot(cy.cross(cz)) < 0.0f {
            sx = -sx;
        }

        self.scale = makeVec3(sx, sy, sz);

        // the axes of a scale of zero give no direction, the rotation reading them as they are
        let dx = if sx == 0.0f { 1.0f } else { sx };
        let dy = if sy == 0.0f { 1.0f } else { sy };
        let dz = if sz == 0.0f { 1.0f } else { sz };
        self.rotation = Quaternion::fromRotation(mat4(a1-> m.a1 / dx, a2-> m.a2 / dy, a3-> m.a3 / dz,
                                                      b1-> m.b1 / dx, b2-> m.b2 / dy, b3-> m.b3 / dz,
                                                      c1-> m.c1 / dx, c2-> m.c2 / dy, c3-> m.c3 / dz));
    }

    /**
     * @returns: the matrix of the transformation, translation * rotation * scale
     * */
    pub fn matrix(self)-> mat4 {
        math::utils::translation(self.translation) * self.rotation.matrix() * math::utils::scaling(self.scale)
    }

    /**
     * @returns: the pose between self (w = 0) and another pose (w = 1) of the same joint, the translations and scales
     * interpolated linearly, the rotations along the shortest path (nlerp)
     * @params:
     *    - other: the pose at w = 1
     *    - w: the weight of the other pose, in [0, 1]
     * */
    pub fn blended(self, ref other: JointPose, w: f32)-> JointPose {
        JointPose(translation-> self.translation * (1.0f - w) + other.translation * w,
                  rotation-> self.rotation.nlerp(other.rotation, w),
                  scale-> self.scale * (1.0f - w) + other.scale * w)
    }

    /**
     * @returns: the delta taking a reference pose to this one, in the frame of the joint, so that
     * reference.added(delta, 1) is this pose again: the translation moved, the rotation turned after the one of the
     * reference, and the scale divided by the one of the reference
     * @info: an axis the reference scales to zero gives no ratio, the delta leaving it as it is (1)
     * @params:
     *    - reference: the pose the delta starts from, the first pose of an additive clip or the rest pose
     * */
    pub fn difference(self, ref reference: JointPose)-> JointPose {
        let s = self.scale, r = reference.scale;
        let scale = makeVec3(if r.x == 0.0f { 1.0f } else { s.x / r.x },
                             if r.y == 0.0f { 1.0f } else { s.y / r.y },
                             if r.z == 0.0f { 1.0f } else { s.z / r.z });

        JointPose(translation-> self.translation - reference.translation,
                  rotation-> reference.rotation.conjugate() * self.rotation,
                  scale-> scale)
    }

    /**
     * @returns: the pose with a part of a delta added on top of it (see difference), none of it at w = 0 and all of it at
     * w = 1
     * @params:
     *    - delta: the delta added, the difference of a pose and its reference
     *    - w: the part of the delta added, in [0, 1]
     * */
    pub fn added(self, ref delta: JointPose, w: f32)-> JointPose {
        JointPose(translation-> self.translation + delta.translation * w,
                  rotation-> self.rotation * Quaternion().nlerp(delta.rotation, w),
                  scale-> self.scale * ((delta.scale - 1.0f) * w + 1.0f))
    }

}
