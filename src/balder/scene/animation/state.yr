in state;

use balder::scene::animation::motion;

/**
 * A state of a state machine, the motion a layer plays while the machine is in it (see AnimationStateMachine.addState)
 * */
pub record AnimationState {

    // The name of the state, unique in its machine
    pub let name: [c8];

    // The motion played, a clip or a blend space
    pub let motion: &AnimationMotion;

    // True for the motion to start again at its end, false to hold its last pose
    pub let looping: bool;

    // The speed of the motion, negative to play it backwards
    pub let speed: f32;

    /**
     * @params:
     *    - name: the name of the state
     *    - motion: the motion played
     *    - looping: true for the motion to loop
     *    - speed: the speed of the motion
     * */
    pub self (name: [c8], motion: &AnimationMotion, looping: bool, speed: f32)
        with name = name
        , motion = motion
        , looping = looping
        , speed = speed
    {}

}
