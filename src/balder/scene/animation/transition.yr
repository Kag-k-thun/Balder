in transition;

use balder::scene::animation::{condition, condition_kind, motion_state, parameters};

/**
 * A transition of a state machine, from a state (or from any state) to another, cross-fading their motions over a time
 * when its conditions are met (see AnimationStateMachine.addTransition)
 * */
pub record AnimationTransition {

    // The index of the state the transition leaves, none for a transition from any state
    pub let from: (usize)?;

    // The index of the state the transition enters
    pub let to: usize;

    // The conditions on the parameters of the player, all met for the transition to fire
    pub let conditions: [AnimationCondition];

    // The time of the cross-fade, in seconds, 0 to enter the state at once
    pub let fade: f32;

    // How much of the motion of the state left must be played for the transition to fire, 1 for the whole motion (see
    // MotionState.played), none for the transition to fire whenever its conditions are met
    pub let exitTime: (f32)?;

    /**
     * @params:
     *    - from: the index of the state left, none for any state
     *    - to: the index of the state entered
     *    - conditions: the conditions on the parameters of the player
     *    - fade: the time of the cross-fade, in seconds
     *    - exitTime: how much of the motion of the state left must be played, none for no wait
     * */
    pub self (from: (usize)?, to: usize, conditions: [AnimationCondition], fade: f32, exitTime: (f32)?)
        with from = from
        , to = to
        , conditions = conditions
        , fade = fade
        , exitTime = exitTime
    {}

    /**
     * @returns: true iif the transition fires at an advance of the motion of the state it leaves: its conditions are met
     * and, when it has an exit time, the motion reaches it at this advance (a motion played once at or past it, the
     * motion of a loop crossing it in one of its loops, 0.5 at the half of each loop)
     * @params:
     *    - state: the motion of the state left, advanced
     *    - before: how much of the motion was played before the advance (see MotionState.played)
     *    - parameters: the parameters of the player
     * */
    pub fn fires(self, state: MotionState, before: f32, parameters: &AnimationParameters)-> bool {
        if let Ok(exit) = self.exitTime {
            if state.played < exit { return false; }
            if state.looping && before >= exit {
                // the loops played past the exit time, truncated, grow when it is crossed again
                if cast!u64(state.played - exit) == cast!u64(before - exit) { return false; }
            }
        }

        for c in self.conditions {
            if !c.holds(parameters) { return false; }
        }

        true
    }

    /**
     * Consume the triggers of the conditions of the transition, as it fires
     * */
    pub fn consumeTriggers(self, dmut parameters: &AnimationParameters) {
        for c in self.conditions {
            if c.kind == AnimationConditionKind::TRIGGERED {
                parameters:.consume(c.parameter);
            }
        }
    }

}
