in player;

use balder::core::error;
use balder::core::application::signal;
use balder::scene::animation::{clip, event, joint_mask, joint_pose, layer, skeleton};

use std::conv;

use ::std::time;

/**
 * Plays the clips of a skeleton in layers: each layer plays a clip at a time, in a loop or once, at a speed, cross-fading
 * from one clip to the next, the layers put one over the other on the joints of their masks (an upper body over the
 * walk of the legs, a breath added to both); the pose of the skeleton is sampled again at each advance for a model to
 * be moved to it (see SolidObjectModel.pose), and the events the current clips cross are signalled (see events), and
 * the end of those played once (see finished)
 * @info: the layer 0 replaces the rest pose of the skeleton, on every joint, and cannot be removed; the methods taking
 * a layer act on it by default
 * @example:
 * ```
 * let dmut player = copy AnimationPlayer(skeleton);
 * player:.events():.connect(self.box, &self:.onAnimationEvent);
 * player:.play(library:.find("res:/models/fox/Fox.gltf", "Walk"));
 *
 * // the upper body looks around as the legs walk
 * let upper = player:.addLayer(mask-> (JointMask::fromJoint(skeleton, "b_Spine01_02"))?);
 * player:.play(library:.find("res:/models/fox/Fox.gltf", "Survey"), fade-> 0.3f, layer-> upper);
 *
 * // at each tick
 * player:.advance(delta);
 * fox:.pose(player.poses);
 * ```
 * */
@final
pub class AnimationPlayer {

    // The skeleton the player moves
    let _skeleton: &Skeleton;

    // The layers, the layer 0 at the bottom, each put over the ones before it
    let dmut _layers: [&AnimationLayer];

    // The pose of each joint of the skeleton relative to its parent, sampled again in place at each advance
    let dmut _poses: [JointPose];

    // The buffers of the pose of a layer, of a clip of a layer, and of the first pose of a clip of an additive layer,
    // the size of the skeleton, sampled in place
    let dmut _layerPose: [JointPose];
    let dmut _sample: [JointPose];
    let dmut _reference: [JointPose];

    // True when the player holds its clips at their times
    let mut _paused: bool = false;

    // The events of the clips crossed by the time of the player (see AnimationClip.addEvent)
    let dmut _events: &Signal!{AnimationEvent} = copy Signal!{AnimationEvent} ();

    // The clips played once that reached their end
    let dmut _finished: &Signal!{&AnimationClip} = copy Signal!{&AnimationClip} ();

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A stopped player of one layer, the skeleton at its rest pose
     * @params:
     *    - skeleton: the skeleton moved, the clips played finding their joints in it by their names
     * */
    pub self (skeleton: &Skeleton)
        with _skeleton = skeleton
        , _layers = copy [copy AnimationLayer()]
        , _poses = copy skeleton.rest
        , _layerPose = copy skeleton.rest
        , _sample = copy skeleton.rest
        , _reference = copy skeleton.rest
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the skeleton the player moves
     * */
    @field
    pub fn skeleton(self)-> &Skeleton {
        self._skeleton
    }

    /**
     * @returns: the signal of the events crossed by the current clips of the layers, in the order they cross them (see
     * ClipState.advance), the listeners called on the thread of their slot emitter
     * */
    pub fn events(mut self)-> dmut &Signal!{AnimationEvent} {
        alias self._events
    }

    /**
     * @returns: the signal of the current clips played once reaching their end (their start when played backwards),
     * once each time they reach it, the clip holding its last pose
     * */
    pub fn finished(mut self)-> dmut &Signal!{&AnimationClip} {
        alias self._finished
    }

    /**
     * @returns: the pose of each joint of the skeleton relative to its parent, the layers put one over the other at the
     * times of their clips, the rest pose when nothing plays
     * */
    @field
    pub fn poses(self)-> [JointPose] {
        self._poses
    }

    /**
     * @returns: the layers, the layer 0 at the bottom, with their clips (see AnimationLayer.current)
     * */
    @field
    pub fn layers(self)-> [&AnimationLayer] {
        self._layers
    }

    /**
     * @returns: true iif a layer plays a clip, paused or not
     * */
    @field
    pub fn playing(self)-> bool {
        for l in self._layers {
            if l.playing { return true; }
        }

        false
    }

    /**
     * @returns: true iif the player holds its clips at their times
     * */
    @field
    pub fn paused(self)-> bool {
        self._paused
    }

    /**
     * Hold the clips at their times, or move them along again
     * */
    @field
    pub fn paused(mut self, paused: bool) {
        self._paused = paused;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          LAYERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a layer over the others, playing nothing yet
     * @params:
     *    - mask: the weight of each joint in the layer, none for every joint fully
     *    - weight: the part the layer takes in the pose, in [0, 1]
     *    - additive: true for the layer to add the motion of its clips from their first pose to the pose below it,
     *      false to replace it
     * @returns: the index of the layer
     * @throws:
     *    - BalderError: when the mask does not weigh the joints of the skeleton of the player
     * */
    pub fn addLayer(mut self, mask: (JointMask)? = none, weight: f32 = 1.0f, additive: bool = false)-> usize
        throws BalderError
    {
        if let Ok(m) = mask {
            if m.len != self._skeleton.len {
                throw copy BalderError("The mask of a layer weighs " ~ m.len.to![c8]() ~ " joints, the skeleton has "
                                       ~ self._skeleton.len.to![c8]());
            }
        }

        self._layers ~= [copy AnimationLayer(mask-> mask, weight-> weight, additive-> additive)];
        self._layers.len - 1us
    }

    /**
     * Change the part a layer takes in the pose, held in [0, 1]
     * @params:
     *    - weight: the part of the layer, 0 for the layer to leave the pose as it is below it
     *    - layer: the index of the layer
     * */
    pub fn layerWeight(mut self, weight: f32, layer: usize = 0us) {
        self._layers[layer].weight = weight;
        self:.sample();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PLAYBACK          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Play a clip on a layer from its start (from its end when played backwards), cross-fading from the clips the layer
     * played; the player is no longer paused
     * @params:
     *    - clip: the clip played, its joints found in the skeleton by their names
     *    - looping: true for the clip to start again at its end, false to hold its last pose
     *    - speed: the speed of the clip, negative to play it backwards
     *    - fade: the time of the cross-fade, in seconds, 0 to replace the clips of the layer at once
     *    - layer: the index of the layer
     * */
    pub fn play(mut self, clip: &AnimationClip, looping: bool = true, speed: f32 = 1.0f, fade: f32 = 0.0f, layer: usize = 0us) {
        self._layers[layer]:.play(clip, looping-> looping, speed-> speed, fade-> fade);
        self._paused = false;
        self:.sample();
    }

    /**
     * Stop the clips of a layer, fading them out, the pose below the layer coming back as they fade (the rest pose for
     * the layer 0)
     * @params:
     *    - fade: the time of the fade, in seconds, 0 to stop at once
     *    - layer: the index of the layer
     * */
    pub fn stop(mut self, fade: f32 = 0.0f, layer: usize = 0us) {
        self._layers[layer]:.stop(fade-> fade);
        self:.sample();
    }

    /**
     * Move the current clip of a layer to a time, wrapped in the clip when it loops, held in it otherwise, no event
     * being crossed; nothing is done when the layer has no current clip
     * @params:
     *    - time: the time in the clip, in seconds
     *    - layer: the index of the layer
     * */
    pub fn seek(mut self, time: f32, layer: usize = 0us) {
        self._layers[layer]:.seek(time);
        self:.sample();
    }

    /**
     * Change the speed of the current clip of a layer, negative to play it backwards; nothing is done when the layer has
     * no current clip (play takes the speed of the next clip)
     * @params:
     *    - speed: the speed of the clip
     *    - layer: the index of the layer
     * */
    pub fn speed(mut self, speed: f32, layer: usize = 0us) {
        self._layers[layer]:.speed(speed);
    }

    /**
     * Move the clips of the layers along a time elapsed, at their speeds, along their fades, signal the events the
     * current clips cross and the end of those played once, and sample the pose of the skeleton at their new times,
     * allocating nothing but the signals emitted and at the end of a fade; nothing is done when the player is paused
     * @params:
     *    - delta: the time elapsed since the last advance
     * */
    pub fn advance(mut self, delta: Duration) {
        if self._paused { return; }

        let seconds = cast!f32(delta.allMicros) / 1000000.0f;
        for dmut l in alias self._layers {
            l:.advance(seconds, &self:.onEvent, &self:.onFinished);
        }

        self:.sample();
    }

    /**
     * Sample the pose of the skeleton, in place: the rest pose, then each layer over it, on the joints of its mask, by
     * its weight and the weights of its clips
     * */
    fn sample(mut self) {
        let rest = self._skeleton.rest;
        for j in 0us .. self._poses.len {
            self._poses[j] = rest[j];
        }

        for l in self._layers {
            let part = l.weight * l.poseInto(self._skeleton, alias self._layerPose, alias self._sample, alias self._reference);
            if part > 0.0f {
                let mut weights: [f32] = [];
                if let Ok(mask) = l.mask {
                    weights = mask.weights;
                }

                for j in 0us .. self._poses.len {
                    let w = if weights.len == 0us { part } else { part * weights[j] };
                    if w > 0.0f {
                        if l.additive {
                            self._poses[j] = self._poses[j].added(self._layerPose[j], w);
                        } else {
                            self._poses[j] = self._poses[j].blended(self._layerPose[j], w);
                        }
                    }
                }
            }
        }
    }

    /**
     * Signal an event crossed by the current clip of a layer
     * */
    fn onEvent(mut self, event: AnimationEvent) {
        self._events:.emit(event);
    }

    /**
     * Signal the end of the current clip of a layer, played once
     * */
    fn onFinished(mut self, clip: &AnimationClip) {
        self._finished:.emit(clip);
    }

}
