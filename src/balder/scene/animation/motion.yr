in motion;

use balder::scene::animation::{clip, joint_pose, parameters, skeleton};

/**
 * What a layer of an animation player plays (see AnimationLayer): a clip, or a blend space mixing several clips by the
 * parameters of the player (see BlendSpace1D, BlendSpace2D)
 * @info: a motion is an asset, shared by all who play it; what changes as it plays (its time, its fade) is held by its
 * MotionState
 * */
@abstract
pub class AnimationMotion {

    prot self () {}

    /**
     * @returns: the length of the motion, in seconds, at the parameters of the player (a blend space lasting as long as
     * the mean of its clips by their weights)
     * */
    pub fn motionDuration(self, parameters: &AnimationParameters)-> f32;

    /**
     * @returns: the clip whose events the motion signals at the parameters of the player, the clip itself, or the clip of
     * a blend space weighing the most, its events played at the times of the motion
     * */
    pub fn leadingClip(self, parameters: &AnimationParameters)-> &AnimationClip;

    /**
     * Write the pose of each joint of a skeleton at a time of the motion in a buffer, allocating nothing
     * @params:
     *    - skeleton: the skeleton moved
     *    - time: the time in the motion, in seconds, in [0, motionDuration]
     *    - parameters: the parameters of the player
     *    - poses: the buffer, a pose for each joint of the skeleton
     *    - scratch: a buffer of the same size, the poses of the clips of a blend space sampled in it
     * */
    pub fn sampleMotionInto(self, skeleton: &Skeleton, time: f32, parameters: &AnimationParameters, dmut poses: [JointPose],
                            dmut scratch: [JointPose]);

}
