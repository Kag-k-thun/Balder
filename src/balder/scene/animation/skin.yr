in skin;

use balder::core::error;
use balder::math::matrix;
use balder::scene::animation::{skeleton, utils};

use ::assimp::mesh;

/**
 * The joints moving the vertices of a mesh, each vertex giving four indices in them and their weights (MeshArray.bones
 * and MeshArray.weights)
 * @info: a vertex at a pose of the skeleton is the sum of its bind position moved by the matrix of each of its joints
 * (jointMatrices) times its weight
 * */
pub record Skin {

    // The joint of the skeleton for each index a vertex gives
    pub let joints: [usize];

    // For each joint, the inverse of its transformation in the model at the bind pose: it takes a vertex of the mesh,
    // as placed in the model, in the space of the joint
    pub let inverseBinds: [mat4];

    /**
     * @params:
     *    - joints: the joint of the skeleton for each index a vertex gives
     *    - inverseBinds: the inverse of the transformation of each joint in the model at the bind pose
     * */
    pub self (joints: [usize] = [], inverseBinds: [mat4] = [])
        with joints = joints
        , inverseBinds = inverseBinds
    {}

    /**
     * The skin of a mesh imported by assimp, its bones joints of a skeleton
     * @params:
     *    - mesh: the mesh, its bones named after the joints of the skeleton
     *    - skeleton: the skeleton of the scene of the mesh
     *    - placement: the transformation placing the vertices of the mesh in the model, applied to them when loaded
     * @throws:
     *    - BalderError: when a bone of the mesh is not a joint of the skeleton
     * */
    pub self (mesh: *aiMesh, skeleton: &Skeleton, placement: mat4)
        with joints = (unsafe { readSkinJoints(mesh, skeleton) })
        , inverseBinds = (unsafe { readInverseBinds(mesh, placement) })
        throws BalderError
    {}

    /**
     * @returns: the matrix moving the vertices from their bind position for each joint of the skin
     * @params:
     *    - globals: the transformation of each joint of the skeleton in the model (see Skeleton.globalMatrices)
     * */
    pub fn jointMatrices(self, globals: [mat4])-> [mat4] {
        let dmut matrices = copy [mat4(); self.joints.len];
        for i, j in self.joints {
            matrices[i] = globals[j] * self.inverseBinds[i];
        }

        matrices
    }

}
