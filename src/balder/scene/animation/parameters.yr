in parameters;

/**
 * The values an actor sets for its animation to follow: the numbers the blend spaces place their clips by (a speed, a
 * direction...), the flags and the triggers the transitions of the state machines wait for (see AnimationCondition)
 * @info:
 *    - a parameter never set is 0, a flag never set is false
 *    - a trigger is a flag consumed by the transition it fires, so one press of a key fires one jump; it stays set until
 *      a transition consumes it (see consume) or it is reset
 * @example:
 * ```
 * let dmut parameters = player:.parameters();
 * parameters:.value("speed", velocity.length());
 * parameters:.flag("grounded", controller.grounded);
 * if jumped { parameters:.trigger("jump"); }
 * ```
 * */
@final
pub class AnimationParameters {

    // The numbers set, by name
    let dmut _values: [[c8] => f32] = copy [];

    // The flags set, by name
    let dmut _flags: [[c8] => bool] = copy [];

    // The triggers set and not consumed yet
    let dmut _triggers: [[c8] => bool] = copy [];

    pub self () {}

    /**
     * @returns: the number of a name, 0 when it was never set
     * */
    pub fn value(self, name: [c8])-> f32 {
        if let Ok(v) = self._values[name] {
            return v;
        }

        0.0f
    }

    /**
     * Set the number of a name
     * */
    pub fn value(mut self, name: [c8], value: f32) {
        self._values[name] = value;
    }

    /**
     * @returns: the flag of a name, false when it was never set
     * */
    pub fn flag(self, name: [c8])-> bool {
        if let Ok(v) = self._flags[name] {
            return v;
        }

        false
    }

    /**
     * Set the flag of a name
     * */
    pub fn flag(mut self, name: [c8], value: bool) {
        self._flags[name] = value;
    }

    /**
     * Set a trigger, until the transition it fires consumes it
     * */
    pub fn trigger(mut self, name: [c8]) {
        self._triggers[name] = true;
    }

    /**
     * @returns: true iif a trigger is set and not consumed yet
     * */
    pub fn triggered(self, name: [c8])-> bool {
        self._triggers[name].hasValue
    }

    /**
     * Consume a trigger, or reset it before a transition fires; nothing is done when it is not set
     * */
    pub fn consume(mut self, name: [c8]) {
        if self._triggers[name].hasValue {
            self._triggers:.remove(name);
        }
    }

}
