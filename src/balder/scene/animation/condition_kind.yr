in condition_kind;

/**
 * What a condition of a transition compares a parameter of the player to (see AnimationCondition)
 * */
pub enum AnimationConditionKind: u8
// A number above a threshold, strictly
| ABOVE     = 0
// A number below a threshold, strictly
| BELOW     = 1
// A flag set to true
| TRUE      = 2
// A flag set to false, or never set
| FALSE     = 3
// A trigger set, consumed by the transition it fires
| TRIGGERED = 4;
