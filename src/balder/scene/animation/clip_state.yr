in clip_state;

use balder::scene::animation::{clip, event};

/**
 * A clip being played, where it is in the clip and how it moves along it (see AnimationPlayer)
 * */
pub record ClipState {

    // The clip played
    pub let clip: &AnimationClip;

    // The time in the clip, in seconds, in [0, duration] (see advance)
    pub let mut time: f32;

    // The speed the time moves at, 1 for the speed of the clip, negative to play it backwards
    pub let mut speed: f32;

    // True when the clip starts again at its end (at its start when played backwards)
    pub let looping: bool;

    // The part the clip takes in the pose of its layer, in [0, 1], against the other clips of the layer (see
    // AnimationLayer.poseInto)
    pub let mut weight: f32;

    // The change of the weight a second, positive while the clip fades in, negative while it fades out, 0 once faded
    pub let mut fade: f32;

    /**
     * @params:
     *    - clip: the clip played
     *    - time: the time in the clip, in seconds
     *    - speed: the speed the time moves at, negative to play the clip backwards
     *    - looping: true for the clip to start again at its end
     *    - weight: the part the clip takes in the pose of its layer, in [0, 1]
     *    - fade: the change of the weight a second, positive to fade the clip in, negative to fade it out
     * */
    pub self (clip: &AnimationClip, time: f32 = 0.0f, speed: f32 = 1.0f, looping: bool = true, weight: f32 = 1.0f,
              fade: f32 = 0.0f)
        with clip = clip
        , time = time
        , speed = speed
        , looping = looping
        , weight = weight
        , fade = fade
    {}

    /**
     * @returns: true iif the clip fades out, leaving its layer once its weight reaches 0
     * */
    @field
    pub fn fadingOut(self)-> bool {
        self.fade < 0.0f
    }

    /**
     * Change the weight of the clip along its fade, the weight held in [0, 1], the fade ending at 1 (faded in)
     * @params:
     *    - seconds: the time elapsed, in seconds
     * */
    pub fn fadeAlong(mut self, seconds: f32) {
        if self.fade == 0.0f { return; }

        self.weight += self.fade * seconds;
        if self.weight >= 1.0f {
            self.weight = 1.0f;
            self.fade = 0.0f;
        } else if self.weight < 0.0f {
            self.weight = 0.0f;
        }
    }

    /**
     * Move the time to a time of the clip, wrapped in [0, duration) when the clip loops, held in [0, duration]
     * otherwise, a clip of no duration staying at 0; no event is crossed
     * @params:
     *    - time: the time in the clip, in seconds
     * */
    pub fn place(mut self, time: f32) {
        let duration = self.clip.duration;
        if duration <= 0.0f {
            self.time = 0.0f;
        } else if self.looping {
            // % keeps the sign of the time, so a time below 0 wraps to the end of the clip
            let wrapped = time % duration;
            self.time = if wrapped < 0.0f { wrapped + duration } else { wrapped };
        } else if time < 0.0f {
            self.time = 0.0f;
        } else if time > duration {
            self.time = duration;
        } else {
            self.time = time;
        }
    }

    /**
     * Move the time along the clip at the speed of the state, signalling each event of the clip it crosses, in the order
     * it crosses them: forward from t0 to t1 the events in [t0, t1), backward those in (t1, t0], so an event at the
     * bound of two advances is crossed by one of them only
     * @info:
     *    - in a loop, the time wraps at the end of the clip (forward, staying in [0, duration)) or at its start
     *      (backward, staying in (0, duration]); the loops a long advance covers whole are skipped, their events not
     *      signalled
     *    - played once, the time stops at the end of the clip (its start backward), the event at that end crossed by the
     *      advance reaching it, and by none after
     *    - a clip of no duration stays at 0, crossing nothing
     * @params:
     *    - seconds: the time elapsed, in seconds
     *    - crossed: called with each event crossed
     * @returns: true iif the clip, played once, reached its end at this advance (not at an earlier one)
     * */
    pub fn advance(mut self, seconds: f32, crossed: dg (AnimationEvent)-> void)-> bool {
        let duration = self.clip.duration;
        if duration <= 0.0f {
            self.time = 0.0f;
            return false;
        }

        let distance = seconds * self.speed;
        if distance > 0.0f {
            self:.forward(distance, duration, crossed)
        } else if distance < 0.0f {
            self:.backward(-distance, duration, crossed)
        } else {
            false
        }
    }

    /**
     * Move the time forward along the clip (see advance)
     * @params:
     *    - distance: the time to move by, in seconds, positive
     *    - duration: the length of the clip, positive
     *    - crossed: called with each event crossed
     * @returns: true iif the clip, played once, reached its end at this advance
     * */
    fn forward(mut self, distance: f32, duration: f32, crossed: dg (AnimationEvent)-> void)-> bool {
        let from = self.time;
        if !self.looping {
            if from >= duration { return false; }

            let to = from + distance;
            if to < duration {
                self.crossForward(from, to, false, crossed);
                self.time = to;
                return false;
            }

            self.crossForward(from, duration, true, crossed);
            self.time = duration;
            return true;
        }

        let left = if distance > duration { distance % duration } else { distance };
        let to = from + left;
        if to < duration {
            self.crossForward(from, to, false, crossed);
            self.time = to;
        } else {
            // the end of the clip is crossed, the time wrapping to its start
            self.crossForward(from, duration, false, crossed);
            self.crossForward(0.0f, to - duration, false, crossed);
            self.time = to - duration;
        }

        false
    }

    /**
     * Move the time backward along the clip (see advance)
     * @params:
     *    - distance: the time to move back by, in seconds, positive
     *    - duration: the length of the clip, positive
     *    - crossed: called with each event crossed
     * @returns: true iif the clip, played once, reached its start at this advance
     * */
    fn backward(mut self, distance: f32, duration: f32, crossed: dg (AnimationEvent)-> void)-> bool {
        let from = self.time;
        if !self.looping {
            if from <= 0.0f { return false; }

            let to = from - distance;
            if to > 0.0f {
                self.crossBackward(from, to, false, crossed);
                self.time = to;
                return false;
            }

            self.crossBackward(from, 0.0f, true, crossed);
            self.time = 0.0f;
            return true;
        }

        let left = if distance > duration { distance % duration } else { distance };
        let to = from - left;
        if to > 0.0f {
            self.crossBackward(from, to, false, crossed);
            self.time = to;
        } else {
            // the start of the clip is crossed, the time wrapping to its end
            self.crossBackward(from, 0.0f, true, crossed);
            self.crossBackward(duration, to + duration, false, crossed);
            self.time = to + duration;
        }

        false
    }

    /**
     * Signal the events of the clip in [from, to), or in [from, to] when closed, in the order of their times
     * */
    fn crossForward(self, from: f32, to: f32, closed: bool, crossed: dg (AnimationEvent)-> void) {
        for e in self.clip.events {
            if e.time >= from && (e.time < to || (closed && e.time == to)) {
                crossed(e);
            }
        }
    }

    /**
     * Signal the events of the clip in (to, from], or in [to, from] when closed, from the latest to the earliest
     * */
    fn crossBackward(self, from: f32, to: f32, closed: bool, crossed: dg (AnimationEvent)-> void) {
        let events = self.clip.events;
        for i in 0us .. events.len {
            let e = events[events.len - 1us - i];
            if e.time <= from && (e.time > to || (closed && e.time == to)) {
                crossed(e);
            }
        }
    }

}
