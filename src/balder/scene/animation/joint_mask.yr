in joint_mask;

use balder::core::error;
use balder::scene::animation::skeleton;

/**
 * A weight for each joint of a skeleton, the part a layer of animation takes of the pose of each joint (see
 * JointPose.blended): 1 for the joints of an upper body played over a walk, 0 for the legs keeping the walk
 * @info: a mask is built for one skeleton, its weights indexed as its joints
 * */
pub record JointMask {

    // The weight of each joint, in [0, 1]
    let mut _weights: [f32];

    /**
     * @params:
     *    - weights: the weight of each joint of the skeleton, in [0, 1]
     * */
    pub self (weights: [f32])
        with _weights = weights
    {}

    /**
     * The mask of a joint and of every joint below it, the other joints weighing 0: the spine for an upper body
     * @params:
     *    - skeleton: the skeleton masked
     *    - root: the name of the highest joint of the mask
     *    - weight: the weight of the joints of the mask, in [0, 1]
     * @throws:
     *    - BalderError: when the skeleton has no joint of that name
     * */
    pub self fromJoint(skeleton: &Skeleton, root: [c8], weight: f32 = 1.0f)
        with _weights = []
        throws BalderError
    {
        if let Ok(r) = skeleton.find(root) {
            // a parent comes before its children, so a joint is in the mask when its parent is
            let dmut inside = copy [false; skeleton.len];
            let dmut weights = copy [0.0f; skeleton.len];
            for i, p in skeleton.parents {
                if i == r {
                    inside[i] = true;
                } else if let Ok(parent) = p {
                    inside[i] = inside[parent];
                }

                if inside[i] {
                    weights[i] = weight;
                }
            }

            self._weights = weights;
        } else {
            throw copy BalderError("The skeleton has no joint " ~ root);
        }
    }

    /**
     * @returns: the weight of each joint, in [0, 1]
     * */
    @field
    pub fn weights(self)-> [f32] {
        self._weights
    }

    /**
     * @returns: the number of joints the mask weighs, those of its skeleton
     * */
    @field
    pub fn len(self)-> usize {
        self._weights.len
    }

}
