in skeleton;

use balder::core::error;
use balder::math::matrix;
use balder::scene::animation::{joint_pose, utils};

use ::assimp::scene;

/**
 * The joints of a skinned model, each placed relative to its parent, a parent before its children
 * @info: a skeleton is shared by the models drawing the same file, and by the clips moving it, which find its joints
 * by their names
 * */
@final
pub class Skeleton {

    // The names of the joints
    let mut _names: [[c8]];

    // The parent of each joint, before it, none for a root
    let mut _parents: [(usize)?];

    // The pose of each joint relative to its parent when no clip moves it
    let mut _rest: [JointPose];

    // The transformation placing the roots in the model
    let _placement: mat4;

    // The index of each joint by its name
    let dmut _indices: [[c8] => usize] = copy [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - names: the names of the joints
     *    - parents: the parent of each joint, before it, none for a root
     *    - rest: the pose of each joint relative to its parent when no clip moves it
     *    - placement: the transformation placing the roots in the model
     * @throws:
     *    - BalderError: when the arrays differ in length, or a joint comes before its parent
     * */
    pub self (names: [[c8]], parents: [(usize)?], rest: [JointPose], placement: mat4 = mat4())
        with _names = names
        , _parents = parents
        , _rest = rest
        , _placement = placement
        throws BalderError
    {
        if parents.len != names.len || rest.len != names.len {
            throw copy BalderError("A skeleton needs a parent and a rest pose for each joint");
        }

        for i, p in parents {
            if let Ok(parent) = p {
                if parent >= i {
                    throw copy BalderError("The joint " ~ names[i] ~ " comes before its parent");
                }
            }

            self._indices[names[i]] = i;
        }
    }

    /**
     * The skeleton of a scene imported by assimp: the nodes its meshes name as bones, and the nodes above them
     * @params:
     *    - scene: the scene, its meshes keeping their bones (not pre-transformed)
     *    - placement: the transformation placing the root node of the scene in the model
     * */
    pub self (scene: *aiScene, placement: mat4)
        with _names = []
        , _parents = []
        , _rest = []
        , _placement = placement
    {
        let (names, parents, rest) = unsafe { readJoints(scene) };
        self._names = names;
        self._parents = parents;
        self._rest = rest;
        for i, n in names {
            self._indices[n] = i;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of joints
     * */
    @field
    pub fn len(self)-> usize {
        self._names.len
    }

    /**
     * @returns: the names of the joints
     * */
    @field
    pub fn names(self)-> [[c8]] {
        self._names
    }

    /**
     * @returns: the parent of each joint, before it, none for a root
     * */
    @field
    pub fn parents(self)-> [(usize)?] {
        self._parents
    }

    /**
     * @returns: the pose of each joint relative to its parent when no clip moves it
     * */
    @field
    pub fn rest(self)-> [JointPose] {
        self._rest
    }

    /**
     * @returns: the transformation placing the roots in the model
     * */
    @field
    pub fn placement(self)-> mat4 {
        self._placement
    }

    /**
     * @returns: the index of the joint of a name, none when the skeleton has none
     * */
    pub fn find(self, name: [c8])-> (usize)? {
        if let Ok(i) = self._indices[name] {
            return (i)?;
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          TRANSFORMS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the transformation of each joint in the model, for a pose of the skeleton
     * @params:
     *    - poses: the pose of each joint relative to its parent (see AnimationClip.sample)
     * */
    pub fn globalMatrices(self, poses: [JointPose])-> [mat4] {
        let dmut globals = copy [mat4(); self._names.len];
        self.globalMatricesInto(poses, alias globals);
        globals
    }

    /**
     * Write the transformation of each joint in the model, for a pose of the skeleton, in a buffer (see globalMatrices),
     * allocating nothing
     * @params:
     *    - poses: the pose of each joint relative to its parent
     *    - globals: the buffer, a matrix for each joint
     * */
    pub fn globalMatricesInto(self, poses: [JointPose], dmut globals: [mat4]) {
        for i, p in self._parents {
            let local = poses[i].matrix();
            globals[i] = if let Ok(parent) = p {
                globals[parent] * local
            } else {
                self._placement * local
            };
        }
    }

    /**
     * @returns: the transformation of each joint in the model at the rest pose
     * */
    pub fn restMatrices(self)-> [mat4] {
        self.globalMatrices(self._rest)
    }

}
