in joint_channel;

use balder::math::{quaternion, vector};
use balder::scene::animation::{joint_pose, track, utils};

use ::assimp::_;

/**
 * The keys of a joint along a clip, the joint named to be found in any skeleton having it
 * */
pub record JointChannel {

    // The name of the joint the channel moves
    pub let joint: [c8];

    // The keys of the translation of the joint, none leaving the one of the pose sampled
    pub let translation: Track!{vec3};

    // The keys of the rotation of the joint, none leaving the one of the pose sampled
    pub let rotation: Track!{Quaternion};

    // The keys of the scale of the joint, none leaving the one of the pose sampled
    pub let scale: Track!{vec3};

    /**
     * @params:
     *    - joint: the name of the joint moved
     *    - translation, rotation, scale: the keys of each component, empty to leave it as it is
     * */
    pub self (joint: [c8],
              translation: Track!{vec3} = Track!{vec3}(),
              rotation: Track!{Quaternion} = Track!{Quaternion}(),
              scale: Track!{vec3} = Track!{vec3}())
        with joint = joint
        , translation = translation
        , rotation = rotation
        , scale = scale
    {}

    /**
     * The channel of an animation imported by assimp, its keys timed in seconds
     * @params:
     *    - ticksPerSecond: the rate of the times of the keys, the ticks of the animation
     * */
    pub self (channel: *aiNodeAnim, ticksPerSecond: f64)
        with joint = (unsafe { toName(channel.nodeName()) })
        , translation = (unsafe { readVectorTrack(channel.positionKeys(), channel.numPositionKeys(), ticksPerSecond) })
        , rotation = (unsafe { readRotationTrack(channel.rotationKeys(), channel.numRotationKeys(), ticksPerSecond) })
        , scale = (unsafe { readVectorTrack(channel.scalingKeys(), channel.numScalingKeys(), ticksPerSecond) })
    {}

    /**
     * @returns: the pose of the joint at a time, the components the channel has no key for taken from another pose
     * @params:
     *    - time: the time in the clip, in seconds
     *    - pose: the pose giving the components without keys, the rest pose of the joint
     * */
    pub fn sample(self, time: f32, pose: JointPose)-> JointPose {
        let mut result = pose;
        if !self.translation.isEmpty {
            result.translation = self.translation.sample(time);
        }

        if !self.rotation.isEmpty {
            result.rotation = self.rotation.sample(time);
        }

        if !self.scale.isEmpty {
            result.scale = self.scale.sample(time);
        }

        result
    }

}
