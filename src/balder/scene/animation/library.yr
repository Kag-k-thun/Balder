in library;

use balder::core::error;
use balder::scene::animation::{clip, utils};

use std::conv;

use ::assimp::_;

/**
 * The clips of the files of a project, each file read once, its clips shared by all who ask for them
 * @example:
 * ```
 * let dmut library = copy AnimationLibrary();
 * let walk = library:.find("res:/models/fox/Fox.gltf", "Walk");
 * if let Ok(skeleton) = fox.skeleton {
 *     let joints = skeleton.globalMatrices(walk.sample(skeleton, 0.25f));
 * }
 * ```
 * */
@final
pub class AnimationLibrary {

    // The clips of the files read, by the absolute path of the file
    let dmut _files: [[c8] => [&AnimationClip]] = copy [];

    pub self () {}

    /**
     * @returns: the clips of a file, read the first time it is asked for
     * @params:
     *    - path: the project path of the file (see projectPath), any file assimp reads (glTF, FBX...)
     * @throws:
     *    - BalderError: when the file cannot be read
     * */
    pub fn load(mut self, path: [c8])-> [&AnimationClip]
        throws BalderError
    {
        let filePath = balder::utils::path::projectPath(path).toStr();
        if let Ok(clips) = self._files[filePath] {
            return clips;
        }

        let dmut clips = self.readFile(filePath);
        self._files[filePath] = alias clips;
        clips
    }

    /**
     * @returns: the clip of a name in a file, the file read the first time it is asked for
     * @params:
     *    - path: the project path of the file (see projectPath)
     *    - name: the name of the clip in the file
     * @throws:
     *    - BalderError: when the file cannot be read, or has no clip of that name
     * */
    pub fn find(mut self, path: [c8], name: [c8])-> &AnimationClip
        throws BalderError
    {
        for c in self:.load(path) {
            if c.name == name {
                return c;
            }
        }

        throw copy BalderError("The file " ~ path ~ " has no clip " ~ name);
    }

    /**
     * @returns: the clips of the animations of a file
     * @params:
     *    - filePath: the absolute path of the file
     * */
    fn readFile(self, filePath: [c8])-> dmut [&AnimationClip]
        throws BalderError
    {
        unsafe {
            // the axes of the clips are converted as those of the models (see SolidObjectModel.fromFile)
            let sceneAI = aiImportFile(filePath.toStringZ(), aiPostProcessSteps::ConvertToLeftHanded);
            if sceneAI == null {
                throw copy BalderError("Failed to load the clips of the file " ~ filePath);
            }

            {
                readClips(sceneAI)
            } exit {
                aiReleaseImport(sceneAI);
            }
        }
    }

}
