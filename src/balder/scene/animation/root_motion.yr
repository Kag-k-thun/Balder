in root_motion;

use balder::math::vector;

/**
 * How a clip moves the model playing it, taken out of the root of its skeleton so that the clip plays in place (see
 * AnimationClip.extractRootMotion): the actor moves the model at that velocity and turns it at that rate, its feet
 * staying on the ground
 * */
@data
pub record RootMotion {

    // The velocity of the root, in the space of the model (scaled with it), in units a second
    pub let velocity: vec3 = vec3();

    // The turn of the root about the y axis of the model, in radians a second, as a rotation about y of that angle turns
    pub let turn: f32 = 0.0f;

}
