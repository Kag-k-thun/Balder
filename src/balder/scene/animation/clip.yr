in clip;

use balder::scene::animation::{joint_channel, joint_pose, skeleton, utils};

use ::assimp::_;

/**
 * An animation of a skeleton, the keys of its joints along a time
 * @info: a clip is an asset: read once from its file by an AnimationLibrary, it is shared by the skeletons it moves, and
 * finds their joints by their names, moving the skeleton of any model whose joints have them
 * */
@final
pub class AnimationClip {

    // The name of the clip in its file
    pub let name: [c8];

    // The length of the clip, in seconds
    pub let duration: f32;

    // The keys of the joints the clip moves
    pub let channels: [JointChannel];

    /**
     * @params:
     *    - name: the name of the clip
     *    - duration: the length of the clip, in seconds
     *    - channels: the keys of the joints the clip moves
     * */
    pub self (name: [c8], duration: f32, channels: [JointChannel])
        with name = name
        , duration = duration
        , channels = channels
    {}

    /**
     * The clip of an animation imported by assimp, its keys timed in seconds
     * */
    pub self (anim: *aiAnimation)
        with name = (unsafe { toName(anim.name()) })
        , duration = (unsafe { cast!f32(anim.duration() / tickRate(anim)) })
        , channels = (unsafe { readChannels(anim) })
    {}

    /**
     * @returns: the pose of each joint of a skeleton relative to its parent at a time of the clip, the joints the clip
     * does not move keeping their rest pose
     * @params:
     *    - skeleton: the skeleton moved
     *    - time: the time in the clip, in seconds, the first keys holding before it starts and the last ones after it ends
     * */
    pub fn sample(self, skeleton: &Skeleton, time: f32)-> [JointPose] {
        let dmut poses = copy skeleton.rest;
        for c in self.channels {
            if let Ok(j) = skeleton.find(c.joint) {
                poses[j] = c.sample(time, poses[j]);
            }
        }

        poses
    }

}
