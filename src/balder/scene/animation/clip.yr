in clip;

use balder::math::bounds;
use balder::scene::animation::{joint_channel, joint_pose, skeleton, skin, utils};

use std::algorithm::sorting;

use ::assimp::_;

/**
 * The fewest poses a second the box of a clip is the box of (see AnimationClip.bounds)
 * */
def BOUNDS_RATE = 30.0f;

/**
 * An animation of a skeleton, the keys of its joints along a time
 * @info: a clip is an asset: read once from its file by an AnimationLibrary, it is shared by the skeletons it moves, and
 * finds their joints by their names, moving the skeleton of any model whose joints have them
 * */
@final
pub class AnimationClip {

    // The name of the clip in its file
    pub let name: [c8];

    // The length of the clip, in seconds
    pub let duration: f32;

    // The keys of the joints the clip moves
    pub let channels: [JointChannel];

    /**
     * @params:
     *    - name: the name of the clip
     *    - duration: the length of the clip, in seconds
     *    - channels: the keys of the joints the clip moves
     * */
    pub self (name: [c8], duration: f32, channels: [JointChannel])
        with name = name
        , duration = duration
        , channels = channels
    {}

    /**
     * The clip of an animation imported by assimp, its keys timed in seconds
     * */
    pub self (anim: *aiAnimation)
        with name = (unsafe { toName(anim.name()) })
        , duration = (unsafe { cast!f32(anim.duration() / tickRate(anim)) })
        , channels = (unsafe { readChannels(anim) })
    {}

    /**
     * @returns: the pose of each joint of a skeleton relative to its parent at a time of the clip, the joints the clip
     * does not move keeping their rest pose
     * @params:
     *    - skeleton: the skeleton moved
     *    - time: the time in the clip, in seconds, the first keys holding before it starts and the last ones after it ends
     * */
    pub fn sample(self, skeleton: &Skeleton, time: f32)-> [JointPose] {
        let dmut poses = copy skeleton.rest;
        self.sampleInto(skeleton, time, alias poses);
        poses
    }

    /**
     * Write the pose of each joint of a skeleton at a time of the clip in a buffer (see sample), allocating nothing, for a
     * model sampling the clip at each tick
     * @params:
     *    - skeleton: the skeleton moved
     *    - time: the time in the clip, in seconds
     *    - poses: the buffer, a pose for each joint of the skeleton
     * */
    pub fn sampleInto(self, skeleton: &Skeleton, time: f32, dmut poses: [JointPose]) {
        let rest = skeleton.rest;
        for i in 0us .. poses.len {
            poses[i] = rest[i];
        }

        for c in self.channels {
            if let Ok(j) = skeleton.find(c.joint) {
                poses[j] = c.sample(time, poses[j]);
            }
        }
    }

    /**
     * @returns: a box enclosing the vertices of a skin at every pose of the clip, in the model, so a model playing the
     * clip is culled with a box that does not change while it plays it: the boxes of the poses at each key of the clip,
     * and at least BOUNDS_RATE times a second, merged
     * @info: a pose between two samples is taken within their boxes, the rotations turning little between them
     * @params:
     *    - skeleton: the skeleton moved
     *    - skin: the skin of a mesh of the model, its joints those of the skeleton
     * */
    pub fn bounds(self, skeleton: &Skeleton, skin: Skin)-> Aabb {
        let mut box = Aabb();
        for t in self.sampleTimes() {
            box = box.merged(skin.poseBounds(skeleton.globalMatrices(self.sample(skeleton, t))));
        }

        box
    }

    /**
     * @returns: the times the box of the clip samples, growing, each once: BOUNDS_RATE times a second from its start to
     * its end, and the times of its keys (the channels of a file often key the same times)
     * */
    fn sampleTimes(self)-> [f32] {
        let steps = cast!u32(self.duration * BOUNDS_RATE) + 1u32;
        let dmut times: [f32] = [];
        for k in 0u32 .. steps + 1u32 {
            times ~= [self.duration * cast!f32(k) / cast!f32(steps)];
        }

        for c in self.channels {
            times ~= c.translation.times;
            times ~= c.rotation.times;
            times ~= c.scale.times;
        }

        sort(alias times, |x, y| => { x < y });

        let dmut unique: [f32] = [];
        for t in times {
            if unique.len == 0us || t > unique[$ - 1us] {
                unique ~= [t];
            }
        }

        unique
    }

}
