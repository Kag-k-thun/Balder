in track;

use balder::math::quaternion;

/**
 * The keys of one component of a joint along a clip, its translation, its rotation or its scale
 * @info: a value between two keys goes linearly from one to the other (spherically for a rotation), or holds until the
 * next key when the track is stepped
 * */
pub record Track {T} {

    // The times of the keys, in seconds, growing
    pub let times: [f32];

    // The values at the keys
    pub let values: [T];

    // True when the value of a key holds until the next key
    pub let stepped: bool;

    /**
     * @params:
     *    - times: the times of the keys, in seconds, growing
     *    - values: the value at each time
     *    - stepped: true for the value of a key to hold until the next key
     * */
    pub self (times: [f32] = [], values: [T] = [], stepped: bool = false)
        with times = times
        , values = values
        , stepped = stepped
    {}

    /**
     * @returns: true iif the track has no key, leaving its component as it is
     * */
    @field
    pub fn isEmpty(self)-> bool {
        self.times.len == 0us
    }

    /**
     * @returns: the value at a time, the value of the first key before it and of the last key after it
     * @assume: the track is not empty
     * */
    pub fn sample(self, time: f32)-> T {
        let last = self.times.len - 1us;
        if time <= self.times[0us] {
            return self.values[0us];
        }

        if time >= self.times[last] {
            return self.values[last];
        }

        // times[before] <= time < times[after], after = before + 1
        let mut before = 0us, mut after = last;
        while after - before > 1us {
            let middle = (before + after) / 2us;
            if self.times[middle] <= time {
                before = middle;
            } else {
                after = middle;
            }
        }

        if self.stepped {
            return self.values[before];
        }

        let t = (time - self.times[before]) / (self.times[after] - self.times[before]);
        cte if (T::typeid == Quaternion::typeid) {
            self.values[before].slerp(self.values[after], t)
        } else {
            self.values[before] + (self.values[after] - self.values[before]) * t
        }
    }

}
