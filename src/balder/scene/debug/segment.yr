in segment;

use balder::math::vector;

use std::algorithm::comparison;

/**
 * A segment of the world drawn over the image of a scene, laid out as the Segment struct of the debug lines shader
 * (std430, 32 bytes)
 * */
pub record DebugSegment {

    // The start of the segment, in the world
    pub let a: vec3;

    // The colour of the segment, encoded in sRGB, and its opacity, a byte each from red in the lowest byte
    pub let color: u32;

    // The end of the segment, in the world
    pub let b: vec3;

    // How the segment is drawn where the scene hides it, a DebugDepth
    pub let depth: u32;

    /**
     * @params:
     *    - a, b: the ends of the segment, in the world
     *    - color: its colour, encoded in sRGB, and its opacity
     *    - depth: how it is drawn where the scene hides it
     * */
    pub self (a: vec3, b: vec3, color: vec4, depth: DebugDepth = DebugDepth::SEE_THROUGH)
        with a = a
        , color = packColor(color)
        , b = b
        , depth = depth
    {}

    /**
     * @returns: true iif the segment is the same as another one
     * */
    pub fn isSame(self, other: DebugSegment)-> bool {
        self.a == other.a && self.b == other.b && self.color == other.color && self.depth == other.depth
    }

}

/**
 * @returns: a colour and its opacity, each in [0, 1], packed a byte each from red in the lowest byte (unpackUnorm4x8 of
 * the shaders)
 * */
fn packColor(c: vec4)-> u32 {
    let r = toByte(c.x), g = toByte(c.y), b = toByte(c.z), a = toByte(c.w);
    r | (g << 8u32) | (b << 16u32) | (a << 24u32)
}

/**
 * @returns: a component in [0, 1] as a byte
 * */
fn toByte(x: f32)-> u32 {
    cast!u32(comparison::clamp(x, 0.0f, 1.0f) * 255.0f + 0.5f)
}
