in lines;

use balder::math::{bounds, matrix, vector};

use std::math;

/**
 * The number of segments of a whole circle
 * */
def CIRCLE_SIDES = 24us;

/**
 * The length of the head of an arrow, over the length of the arrow
 * */
def ARROW_HEAD = 0.2f;

/**
 * The segments of the outlines of shapes of the world, drawn over the image of a scene (see Scene::setDebugLines): a
 * line, a box, a sphere, a capsule, an arrow, a frustum...
 * @info: each shape is made of the segments of its outline, of the depth mode of the lines when it is added (see depth);
 * the segments are kept until the lines are cleared
 * */
pub class DebugLines {

    // The segments of the shapes added, in their order
    let dmut _segments: [DebugSegment] = [];

    // How the next segments are drawn where the scene hides them
    let mut _depth: DebugDepth;

    /**
     * @params:
     *    - depth: how the segments are drawn where the scene hides them
     * */
    pub self (depth: DebugDepth = DebugDepth::SEE_THROUGH)
        with _depth = depth
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the segments of the shapes added, in their order
     * */
    @field
    pub fn segments(self)-> [DebugSegment] {
        self._segments
    }

    /**
     * @returns: the number of segments
     * */
    @field
    pub fn len(self)-> usize {
        self._segments.len
    }

    /**
     * @returns: how the next segments are drawn where the scene hides them
     * */
    @field
    pub fn depth(self)-> DebugDepth {
        self._depth
    }

    /**
     * Draw the next segments by another depth mode, those added before keeping theirs
     * */
    @field
    pub fn depth(mut self, depth: DebugDepth) {
        self._depth = depth;
    }

    /**
     * Remove every segment
     * */
    pub fn clear(mut self) {
        self._segments = [];
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SHAPES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A segment from a point to another
     * @params:
     *    - color: the colour, encoded in sRGB, and its opacity
     * */
    pub fn line(mut self, a: vec3, b: vec3, color: vec4) {
        self._segments ~= [DebugSegment(a, b, color, depth-> self._depth)];
    }

    /**
     * The segments joining points one after the other, the last one joined to the first when the polygon is closed
     * */
    pub fn polygon(mut self, points: [vec3], color: vec4, closed: bool = true) {
        if points.len < 2us { return; }

        for i in 1us .. points.len {
            self:.line(points[i - 1us], points[i], color);
        }

        if closed && points.len > 2us {
            self:.line(points[points.len - 1us], points[0], color);
        }
    }

    /**
     * The twelve edges of a box of the world, nothing for an empty box
     * */
    pub fn box(mut self, box: Aabb, color: vec4) {
        if box.isEmpty { return; }

        let h = box.extent;
        self:.orientedBox(box.center, makeVec3(h.x, 0.0f, 0.0f), makeVec3(0.0f, h.y, 0.0f), makeVec3(0.0f, 0.0f, h.z), color);
    }

    /**
     * The twelve edges of a box turned, scaled or sheared
     * @params:
     *    - centre: the centre of the box
     *    - u, v, w: the half sides of the box along its three edges, from its centre to the centres of three of its faces
     * */
    pub fn orientedBox(mut self, centre: vec3, u: vec3, v: vec3, w: vec3, color: vec4) {
        for su in [-1.0f, 1.0f] {
            for sv in [-1.0f, 1.0f] {
                let base = centre + u * su + v * sv;
                self:.line(base - w, base + w, color);
            }

            for sw in [-1.0f, 1.0f] {
                let base = centre + u * su + w * sw;
                self:.line(base - v, base + v, color);
            }
        }

        for sv in [-1.0f, 1.0f] {
            for sw in [-1.0f, 1.0f] {
                let base = centre + v * sv + w * sw;
                self:.line(base - u, base + u, color);
            }
        }
    }

    /**
     * A circle about a point, in the plane across a normal
     * @params:
     *    - sides: the number of segments of the circle
     * */
    pub fn circle(mut self, centre: vec3, normal: vec3, radius: f32, color: vec4, sides: usize = CIRCLE_SIDES) {
        let (x, y) = basisAcross(normal);
        self:.ellipse(centre, x * radius, y * radius, 0.0f, cast!f32(math::TAU), sides, color);
    }

    /**
     * A sphere, its three circles across the axes of the world
     * */
    pub fn sphere(mut self, centre: vec3, radius: f32, color: vec4) {
        let x = makeVec3(radius, 0.0f, 0.0f), y = makeVec3(0.0f, radius, 0.0f), z = makeVec3(0.0f, 0.0f, radius);
        self:.ellipse(centre, x, y, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
        self:.ellipse(centre, y, z, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
        self:.ellipse(centre, z, x, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
    }

    /**
     * A capsule, a segment grown by a radius: the circles at its two ends, four lines along it, and the half circles of
     * its caps; a sphere when its ends are the same
     * */
    pub fn capsule(mut self, a: vec3, b: vec3, radius: f32, color: vec4) {
        let axis = b - a;
        if axis.length() <= 1.0e-6f {
            self:.sphere(a, radius, color);
            return;
        }

        let n = axis.normalized();
        let (x, y) = basisAcross(n);
        let rx = x * radius, ry = y * radius, rn = n * radius;
        self:.ellipse(a, rx, ry, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
        self:.ellipse(b, rx, ry, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
        for side in [rx, -rx, ry, -ry] {
            self:.line(a + side, b + side, color);
        }

        let half = CIRCLE_SIDES / 2us;
        self:.ellipse(b, rx, rn, 0.0f, cast!f32(math::PI), half, color);
        self:.ellipse(b, ry, rn, 0.0f, cast!f32(math::PI), half, color);
        self:.ellipse(a, rx, -rn, 0.0f, cast!f32(math::PI), half, color);
        self:.ellipse(a, ry, -rn, 0.0f, cast!f32(math::PI), half, color);
    }

    /**
     * A cylinder: its two caps and four lines along its side
     * @params:
     *    - centre: the centre of the cylinder
     *    - u, w: its two radii, across its axis
     *    - v: its half height, from its centre to the centre of a cap
     * */
    pub fn cylinder(mut self, centre: vec3, u: vec3, v: vec3, w: vec3, color: vec4) {
        self:.ellipse(centre + v, u, w, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
        self:.ellipse(centre - v, u, w, 0.0f, cast!f32(math::TAU), CIRCLE_SIDES, color);
        for side in [u, -u, w, -w] {
            self:.line(centre + side - v, centre + side + v, color);
        }
    }

    /**
     * An arrow from a point to another, its head four segments at its end
     * */
    pub fn arrow(mut self, from: vec3, to: vec3, color: vec4) {
        self:.line(from, to, color);

        let along = to - from;
        let len = along.length();
        if len <= 1.0e-6f { return; }

        let n = along / len;
        let (x, y) = basisAcross(n);
        let head = len * ARROW_HEAD;
        let base = to - n * head;
        for side in [x, -x, y, -y] {
            self:.line(to, base + side * (head / 2.0f), color);
        }
    }

    /**
     * A cross on a point, a segment along each axis of the world
     * @params:
     *    - size: the length of each segment
     * */
    pub fn cross(mut self, point: vec3, size: f32, color: vec4) {
        let h = size / 2.0f;
        self:.line(point - makeVec3(h, 0.0f, 0.0f), point + makeVec3(h, 0.0f, 0.0f), color);
        self:.line(point - makeVec3(0.0f, h, 0.0f), point + makeVec3(0.0f, h, 0.0f), color);
        self:.line(point - makeVec3(0.0f, 0.0f, h), point + makeVec3(0.0f, 0.0f, h), color);
    }

    /**
     * The twelve edges of the volume a camera sees, between the depths 0 and 1 of its projection
     * @params:
     *    - viewProj: the view-projection of the camera (see Camera::viewProj)
     * */
    pub fn frustum(mut self, viewProj: mat4, color: vec4) {
        let inverse = viewProj.inversed();
        let mut near: [vec3] = [];
        let mut far: [vec3] = [];
        for corner in [makeVec2(-1.0f, -1.0f), makeVec2(1.0f, -1.0f), makeVec2(1.0f, 1.0f), makeVec2(-1.0f, 1.0f)] {
            near ~= [unproject(inverse, corner, 0.0f)];
            far ~= [unproject(inverse, corner, 1.0f)];
        }

        self:.polygon(near, color);
        self:.polygon(far, color);
        for i in 0us .. 4us {
            self:.line(near[i], far[i], color);
        }
    }

    /**
     * An arc of an ellipse, the points centre + x cos(t) + y sin(t) for t from an angle to another
     * @params:
     *    - sides: the number of segments of the arc
     * */
    fn ellipse(mut self, centre: vec3, x: vec3, y: vec3, from: f32, to: f32, sides: usize, color: vec4) {
        let mut last = centre + x * math::cos(from) + y * math::sin(from);
        for i in 1us .. sides + 1us {
            let t = from + (to - from) * cast!f32(cast!u64(i)) / cast!f32(cast!u64(sides));
            let p = centre + x * math::cos(t) + y * math::sin(t);
            self:.line(last, p, color);
            last = p;
        }
    }

}

/**
 * @returns: two unit vectors across a direction and across each other
 * */
fn basisAcross(normal: vec3)-> (vec3, vec3) {
    let n = normal.normalized();
    let other = if math::abs(n.x) < 0.9f { makeVec3(1.0f, 0.0f, 0.0f) } else { makeVec3(0.0f, 1.0f, 0.0f) };
    let x = n.cross(other).normalized();
    (x, n.cross(x))
}

/**
 * @returns: the point of the world a point of normalized device coordinates and a depth of a projection come from
 * */
fn unproject(inverse: mat4, ndc: vec2, depth: f32)-> vec3 {
    let p = inverse * makeVec4(ndc, depth, 1.0f);
    p.xyz / p.w
}
