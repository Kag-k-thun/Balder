in depth;

/**
 * How a debug segment is drawn where the scene hides it, tested against the depth of the g-buffer
 * */
pub enum DebugDepth : u32
| HIDDEN      = 0u32  // the parts behind the scene are not drawn
| SEE_THROUGH = 1u32  // the parts behind the scene are drawn faded (see DebugLinesEffect::hiddenOpacity)
| ON_TOP      = 2u32; // the whole segment is drawn over the scene
