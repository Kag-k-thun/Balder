in mode;

/**
 * What the handles of a gizmo change in the nodes it moves
 * */
pub enum GizmoMode : u32
| TRANSLATE = 0u32 // arrows along the axes and squares in the planes between them, moving the nodes
| ROTATE    = 1u32 // rings about the axes and about the view, turning the nodes about their origin
| SCALE     = 2u32; // boxes at the end of the axes and one in the centre, scaling the nodes about their origin
