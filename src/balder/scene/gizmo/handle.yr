in handle;

/**
 * A handle of a gizmo, what its mode makes of it (see GizmoMode)
 * */
pub enum GizmoHandle : u32
| NONE   = 0u32 // no handle
| X      = 1u32 // the arrow, the ring or the box of the X axis
| Y      = 2u32 // the arrow, the ring or the box of the Y axis
| Z      = 3u32 // the arrow, the ring or the box of the Z axis
| YZ     = 4u32 // the square in the plane of the Y and Z axes, across the X axis
| ZX     = 5u32 // the square in the plane of the Z and X axes, across the Y axis
| XY     = 6u32 // the square in the plane of the X and Y axes, across the Z axis
| VIEW   = 7u32 // the ring about the axis of the view
| CENTRE = 8u32; // the box in the centre, scaling along every axis
