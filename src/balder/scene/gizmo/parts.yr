in parts;

use balder::math::vector;
use balder::scene::gizmo::handle;
use balder::scene::node::node3D::transform;
use balder::scene::utils::post::gizmo::shape;

/**
 * The smallest factor a drag scales a node by
 * */
pub def MIN_FACTOR = 0.01f;

/**
 * @returns: the handle of an axis of the gizmo, X for 0, Y for 1 and Z for 2
 * */
pub fn axisHandle(i: usize)-> GizmoHandle {
    if i == 0us { GizmoHandle::X } else if i == 1us { GizmoHandle::Y } else { GizmoHandle::Z }
}

/**
 * @returns: the handle of the plane across an axis of the gizmo, YZ for 0, ZX for 1 and XY for 2
 * */
pub fn planeHandle(i: usize)-> GizmoHandle {
    if i == 0us { GizmoHandle::YZ } else if i == 1us { GizmoHandle::ZX } else { GizmoHandle::XY }
}

/**
 * @returns: true iif a handle is the one of an axis
 * */
pub fn isAxis(h: GizmoHandle)-> bool {
    h == GizmoHandle::X || h == GizmoHandle::Y || h == GizmoHandle::Z
}

/**
 * @returns: the place of the axis of a handle, or of the axis its plane is across
 * */
pub fn indexOf(h: GizmoHandle)-> usize {
    if h == GizmoHandle::X || h == GizmoHandle::YZ { 0us } else if h == GizmoHandle::Y || h == GizmoHandle::ZX { 1us } else { 2us }
}

/**
 * @returns: a factor of scale, MIN_FACTOR at least
 * */
pub fn factorOf(f: f32)-> f32 {
    if f < MIN_FACTOR { MIN_FACTOR } else { f }
}

/**
 * @returns: true iif two transforms are the same
 * */
pub fn sameTransform(a: NodeTransform, b: NodeTransform)-> bool {
    a.position == b.position && a.rotation == b.rotation && a.scale == b.scale
}

/**
 * @returns: the colour of an axis, encoded in sRGB, yellow when highlighted
 * */
pub fn colorOf(i: usize, lit: bool, alpha: f32)-> vec4 {
    if lit { return makeVec4(1.0f, 0.82f, 0.18f, alpha); }
    if i == 0us { makeVec4(0.94f, 0.26f, 0.31f, alpha) } else if i == 1us { makeVec4(0.52f, 0.83f, 0.15f, alpha) } else { makeVec4(0.24f, 0.52f, 0.98f, alpha) }
}

/**
 * @returns: the colour of the handles of no axis (the ring about the view, the centre), yellow when highlighted
 * */
pub fn neutralColor(lit: bool)-> vec4 {
    if lit { makeVec4(1.0f, 0.82f, 0.18f, 1.0f) } else { makeVec4(0.88f, 0.88f, 0.88f, 1.0f) }
}

/**
 * @returns: the two triangles of a square box facing the eye, centred on a point of the image
 * @params:
 *    - half: the half side of the box, in texels
 * */
pub fn boxShapes(centre: vec2, half: f32, color: vec4)-> [GizmoShape] {
    let a = centre + makeVec2(-half, -half), b = centre + makeVec2(half, -half);
    let c = centre + makeVec2(half, half), d = centre + makeVec2(-half, half);

    copy [GizmoShape(a, b, c, color), GizmoShape(a, c, d, color)]
}
