in snap;

use balder::scene::gizmo::mode;

/**
 * The steps a gizmo snaps its changes to, and the kinds of changes snapped
 * without the snapping modifier
 *
 * @info: a kind switched on (translating, rotating, scaling) snaps unless the
 * modifier (Ctrl, or Command) is held, a kind switched off only while it is
 * held (see snaps); a face of a volume moves by the step of the translation
 *
 * */
@data
pub record GizmoSnap {

    // The step of a translation along each axis it follows, in world units
    pub let mut translation: f32 = 0.5f;

    // The step of a rotation, in radian (15°)
    pub let mut angle: f32 = 0.2617994f;

    // The step of the factor a scale is multiplied by
    pub let mut scale: f32 = 0.25f;

    // True to snap the translations without the modifier, the faces of the volumes
    pub let mut translating: bool = false;

    // True to snap the rotations without the modifier
    pub let mut rotating: bool = false;

    // True to snap the scales without the modifier
    pub let mut scaling: bool = false;
}


@companion
pub mod GizmoSnap {

    /**
     * @returns: true iff a drag snaps its change: its kind switched on and the
     * modifier not held, or its kind switched off and the modifier held
     *
     * @params:
     *    - mode: what the handles of the gizmo change
     *    - face: true for the drag of a face of a volume, snapped as a translation
     *    - modifier: true while the snapping modifier is held
     * */
    pub fn snaps(snap: GizmoSnap, mode: GizmoMode, face: bool, modifier: bool)-> bool {
        let on = if face || mode == GizmoMode::TRANSLATE {
            snap.translating
        } else if mode == GizmoMode::ROTATE {
            snap.rotating
        } else {
            snap.scaling
        };

        on != modifier
    }

}
