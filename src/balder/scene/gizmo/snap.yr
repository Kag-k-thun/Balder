in snap;

/**
 * The steps a gizmo snaps its changes to while the snapping modifier is held
 * */
@data
pub record GizmoSnap {

    // The step of a translation along each axis it follows, in world units
    pub let mut translation: f32 = 0.5f;

    // The step of a rotation, in radian (15°)
    pub let mut angle: f32 = 0.2617994f;

    // The step of the factor a scale is multiplied by
    pub let mut scale: f32 = 0.1f;

}
