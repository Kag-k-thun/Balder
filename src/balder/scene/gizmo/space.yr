in space;

/**
 * The axes a gizmo translates and rotates the nodes along
 * @info: the scale of a node acts along its own axes (see Node3D::parentTransformation), so a gizmo scales along them
 * whatever its space
 * */
pub enum GizmoSpace : u32
| WORLD = 0u32  // the axes of the world
| LOCAL = 1u32; // the axes of the node the gizmo stands on, rotated with it
