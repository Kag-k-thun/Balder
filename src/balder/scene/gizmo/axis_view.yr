in axis_view;

use balder::math::vector;

/**
 * The views along the axes of the world, each named after the side of the scene the eye stands on, looking at the point
 * it turns around
 * @info: the image mirrors X (see Camera::computeView): seen from the front, +X is on the left of the image, so the
 * right view shows the side that is on the left of the front view
 * */
pub enum AxisView : u32
| TOP    = 0u32  // the eye on +Y, looking down, -Z toward the top of the image
| BOTTOM = 1u32  // the eye on -Y, looking up, +Z toward the top of the image
| FRONT  = 2u32  // the eye on +Z, the front of a model (glTF faces +Z)
| BACK   = 3u32  // the eye on -Z
| RIGHT  = 4u32  // the eye on +X
| LEFT   = 5u32; // the eye on -X

/**
 * The axis views in the order of the ends of an orientation gizmo: the positive end of each axis, then its negative end
 * */
pub def AXIS_VIEWS = [AxisView::RIGHT, AxisView::LEFT, AxisView::TOP, AxisView::BOTTOM, AxisView::FRONT, AxisView::BACK];

/**
 * @returns: the direction from the point looked at to the eye of an axis view, of unit length
 * */
pub fn sideOf(view: AxisView)-> vec3 {
    match view {
        AxisView::TOP    => { makeVec3(0.0f, 1.0f, 0.0f) }
        AxisView::BOTTOM => { makeVec3(0.0f, -1.0f, 0.0f) }
        AxisView::FRONT  => { makeVec3(0.0f, 0.0f, 1.0f) }
        AxisView::BACK   => { makeVec3(0.0f, 0.0f, -1.0f) }
        AxisView::RIGHT  => { makeVec3(1.0f, 0.0f, 0.0f) }
        _                => { makeVec3(-1.0f, 0.0f, 0.0f) }
    }
}

/**
 * @returns: the axis view from the other side of the point looked at
 * */
pub fn oppositeOf(view: AxisView)-> AxisView {
    match view {
        AxisView::TOP    => { AxisView::BOTTOM }
        AxisView::BOTTOM => { AxisView::TOP }
        AxisView::FRONT  => { AxisView::BACK }
        AxisView::BACK   => { AxisView::FRONT }
        AxisView::RIGHT  => { AxisView::LEFT }
        _                => { AxisView::RIGHT }
    }
}

/**
 * @returns: the axis of the world an axis view looks along: 0 for X, 1 for Y, 2 for Z
 * */
pub fn axisOf(view: AxisView)-> usize {
    if view == AxisView::RIGHT || view == AxisView::LEFT { return 0us; }
    if view == AxisView::TOP || view == AxisView::BOTTOM { return 1us; }
    2us
}

/**
 * @returns: true iif the eye of an axis view stands on the positive side of its axis
 * */
pub fn isPositive(view: AxisView)-> bool {
    view == AxisView::TOP || view == AxisView::FRONT || view == AxisView::RIGHT
}

/**
 * @returns: the name of an axis view, as the menus and the viewport tell it
 * */
pub fn nameOf(view: AxisView)-> [c8] {
    match view {
        AxisView::TOP    => { "Top" }
        AxisView::BOTTOM => { "Bottom" }
        AxisView::FRONT  => { "Front" }
        AxisView::BACK   => { "Back" }
        AxisView::RIGHT  => { "Right" }
        _                => { "Left" }
    }
}

/**
 * @returns: the key of the numpad giving an axis view, the opposite side with Ctrl
 * */
pub fn keyOf(view: AxisView)-> [c8] {
    match view {
        AxisView::TOP    => { "7" }
        AxisView::BOTTOM => { "Ctrl+7" }
        AxisView::FRONT  => { "1" }
        AxisView::BACK   => { "Ctrl+1" }
        AxisView::RIGHT  => { "3" }
        _                => { "Ctrl+3" }
    }
}
