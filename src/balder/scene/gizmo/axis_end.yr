in axis_end;

use balder::math::vector;
use balder::scene::gizmo::axis_view;

/**
 * An end of an axis of the world on an orientation gizmo (see ViewGizmo): the view a click on it gives, where the
 * camera sees it from the centre of the gizmo, and how much it points toward the eye
 * */
@data
pub record AxisEnd {

    // The axis view a click on the end gives, the eye standing on the side of the end
    pub let view: AxisView = AxisView::FRONT;

    // The end from the centre of the gizmo, in pixels on screen, y going down
    pub let offset: vec2 = vec2();

    // How much the end points toward the eye, from -1 (away from it) to 1 (at it)
    pub let toward: f32 = 0.0f;
}
