in frame;

use balder::math::vector;

/**
 * Where a gizmo stands in the world: its centre, its axes and the length of its handles there, and the direction of the
 * eye from its centre
 * */
@data
pub record GizmoFrame {

    // The centre of the gizmo, the origin of the node it stands on
    pub let mut centre: vec3 = vec3();

    // The unit axes of the gizmo, orthogonal to each other
    pub let mut axisX: vec3 = makeVec3(1.0f, 0.0f, 0.0f);
    pub let mut axisY: vec3 = makeVec3(0.0f, 1.0f, 0.0f);
    pub let mut axisZ: vec3 = makeVec3(0.0f, 0.0f, 1.0f);

    // The length of an axis of the gizmo in world units, its handles keeping a size on the image wherever it is
    pub let mut size: f32 = 1.0f;

    // The unit direction from the centre toward the eye, the axis of the view
    pub let mut toEye: vec3 = makeVec3(0.0f, 0.0f, 1.0f);

    /**
     * @returns: the axis of a place, X for 0, Y for 1 and Z for 2
     * */
    pub fn axis(self, i: usize)-> vec3 {
        if i == 0us { self.axisX } else if i == 1us { self.axisY } else { self.axisZ }
    }

}
