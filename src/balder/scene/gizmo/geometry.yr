in geometry;

use balder::math::{bounds, matrix, vector};

use std::math;

/**
 * @returns: the closest distance between a ray and a segment, and the distance along the ray of the point of the ray
 * closest to it
 * */
pub fn raySegment(ray: Ray, a: vec3, b: vec3)-> (f32, f32) {
    let span = b - a;
    let w = ray.origin - a;
    let de = ray.direction.dot(span);
    let ee = span.dot(span);
    let dw = ray.direction.dot(w);
    let ew = span.dot(w);

    // the place on the segment closest to the line of the ray, then the point of the ray closest to it
    let denom = ee - de * de;
    let mut u = if ee <= 1.0e-12f || denom <= 1.0e-9f * ee { 0.0f } else { clamped((ew - dw * de) / denom, 0.0f, 1.0f) };
    let mut t = u * de - dw;
    if t < 0.0f {
        t = 0.0f;
    }

    if ee > 1.0e-12f {
        u = clamped((ew + t * de) / ee, 0.0f, 1.0f);
    }

    (ray.at(t).distance(a + span * u), t)
}

/**
 * @returns: the distance from the origin of a line along its axis of the point of the line closest to a ray, none when
 * the ray runs along the line
 * @params:
 *    - axis: the unit direction of the line
 * */
pub fn alongAxis(ray: Ray, origin: vec3, axis: vec3)-> (f32)? {
    let w = ray.origin - origin;
    let de = ray.direction.dot(axis);
    let denom = 1.0f - de * de;
    if denom < 1.0e-4f { return none; }

    ((axis.dot(w) - ray.direction.dot(w) * de) / denom)?
}

/**
 * @returns: the distance along a ray at which it crosses a plane, negative when the plane is behind its origin, none when
 * the ray runs along the plane
 * @params:
 *    - point: a point of the plane
 *    - normal: the unit normal of the plane
 * */
pub fn crossPlane(ray: Ray, point: vec3, normal: vec3)-> (f32)? {
    let dn = ray.direction.dot(normal);
    if math::abs(dn) < 1.0e-6f { return none; }

    ((point - ray.origin).dot(normal) / dn)?
}

/**
 * @returns: the vectors made unit and orthogonal to each other in their order (Gram-Schmidt), the axis of the world of
 * its place standing in for one of no length
 * */
pub fn orthonormal(a: vec3, b: vec3, c: vec3)-> (vec3, vec3, vec3) {
    let x = unitOr(a, makeVec3(1.0f, 0.0f, 0.0f));
    let y = unitOr(b - x * b.dot(x), unitOr(makeVec3(0.0f, 1.0f, 0.0f) - x * x.y, makeVec3(0.0f, 0.0f, 1.0f)));
    let rest = c - x * c.dot(x) - y * c.dot(y);

    (x, y, unitOr(rest, x.cross(y)))
}

/**
 * @returns: the angle in radian turning a vector into another about an axis, positive counterclockwise seen from the
 * axis, from -π to π
 * */
pub fn signedAngle(from: vec3, to: vec3, axis: vec3)-> f32 {
    math::atan2(axis.dot(from.cross(to)), from.dot(to))
}

/**
 * @returns: a value rounded to the closest multiple of a step, the value itself when the step is not positive
 * */
pub fn snapped(value: f32, step: f32)-> f32 {
    if step <= 0.0f { return value; }

    math::round(value / step) * step
}

/**
 * @returns: a direction transformed by the 3x3 part of a matrix, its translation left out
 * */
pub fn direction(m: mat4, v: vec3)-> vec3 {
    (m * makeVec4(v, 0.0f)).xyz
}

/**
 * @returns: the translation of a matrix, where it takes the origin
 * */
pub fn origin(m: mat4)-> vec3 {
    makeVec3(m.a4, m.b4, m.c4)
}

/**
 * @returns: a value kept between two bounds
 * */
pub fn clamped(v: f32, low: f32, high: f32)-> f32 {
    if v < low { low } else if v > high { high } else { v }
}

/**
 * @returns: a vector made unit, another one when it has no length
 * */
fn unitOr(v: vec3, fallback: vec3)-> vec3 {
    let len = v.length();
    if len < 1.0e-6f { fallback } else { v / len }
}
