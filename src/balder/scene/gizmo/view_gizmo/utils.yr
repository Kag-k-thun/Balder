in utils;

use balder::math::vector;
use balder::scene::gizmo::axis_view;
use balder::scene::utils::post::gizmo::shape;

// The disc of the gizmo, the reach of the ends of the axes from its centre, the radii of the positive ends and of the
// hollow ones, and the room between the disc and the corner of the image, in pixels on screen
pub def DISC_RADIUS   = 40.0f;
pub def ARM           = 27.0f;
pub def END_RADIUS    = 9.0f;
pub def BACK_RADIUS   = 7.0f;
pub def CORNER_MARGIN = 12.0f;

// The width of a shaft, the half size of a letter and the width of its strokes, in pixels on screen
pub def SHAFT  = 2.0f;
pub def LETTER = 3.5f;
pub def STROKE = 1.6f;

// The colours of the gizmo, in sRGB: the disc and its rim under the cursor, the ground of a hollow end, the ink of the
// letters, and the tint the shapes are placed with
pub def DISC   = makeVec4(0.086f, 0.106f, 0.133f, 0.45f);
pub def RIM    = makeVec4(0.22f, 0.545f, 0.992f, 0.6f);
pub def HOLLOW = makeVec4(0.086f, 0.106f, 0.133f, 1.0f);
pub def INK    = makeVec4(0.051f, 0.067f, 0.09f, 1.0f);
pub def WHITE  = makeVec4(1.0f, 1.0f, 1.0f, 1.0f);

/**
 * Where the gizmo of a view stands in the image of its scene: the centre of its disc, in texels from the top left
 * corner, and the texels a pixel on screen covers along x and along y
 * */
pub record Corner {

    pub let centre: vec2;
    pub let scale: vec2;

    /**
     * The top right corner of the image of a scene shown at its aspect (see Scene::setAspect), a texel a pixel before
     * the scene is laid out
     * */
    pub self (scene: &Scene)
        with self(scaleOf(scene), cast!f32(scene.width))
    {}

    pub self (scale: vec2, width: f32)
        with centre = makeVec2(width - (CORNER_MARGIN + DISC_RADIUS) * scale.x, (CORNER_MARGIN + DISC_RADIUS) * scale.y)
        , scale = scale
    {}
}

/**
 * @returns: the texels of the image of a scene a pixel on screen covers along x and along y
 * */
pub fn scaleOf(scene: &Scene)-> vec2 {
    if scene.aspectWidth == 0u32 || scene.aspectHeight == 0u32 { return makeVec2(1.0f, 1.0f); }

    makeVec2(cast!f32(scene.width) / cast!f32(scene.aspectWidth), cast!f32(scene.height) / cast!f32(scene.aspectHeight))
}

/**
 * @returns: the colour of the axis of an axis view, those of the handles of the transform gizmo (see parts.yr): X red,
 * Y green, Z blue
 * */
pub fn colorOf(view: AxisView)-> vec4 {
    let i = axisOf(view);
    if i == 0us { return makeVec4(0.94f, 0.26f, 0.31f, 1.0f); }
    if i == 1us { return makeVec4(0.52f, 0.83f, 0.15f, 1.0f); }
    makeVec4(0.24f, 0.52f, 0.98f, 1.0f)
}

/**
 * @returns: the strokes of the letter of the axis of an end, X, Y or Z, about a point, in pixels on screen
 * */
pub fn letterOf(view: AxisView, at: vec2)-> [GizmoShape] {
    let a = at + makeVec2(-LETTER, -LETTER);
    let b = at + makeVec2(LETTER, -LETTER);
    let c = at + makeVec2(-LETTER, LETTER);
    let d = at + makeVec2(LETTER, LETTER);

    let i = axisOf(view);
    if i == 0us {
        return copy [GizmoShape(a, d, STROKE, INK), GizmoShape(c, b, STROKE, INK)];
    }

    if i == 1us {
        return copy [GizmoShape(a, at, STROKE, INK), GizmoShape(b, at, STROKE, INK),
                     GizmoShape(at, at + makeVec2(0.0f, LETTER), STROKE, INK)];
    }

    copy [GizmoShape(a, b, STROKE, INK), GizmoShape(b, c, STROKE, INK), GizmoShape(c, d, STROKE, INK)]
}
