in view;

use balder::math::{bounds, matrix, vector};
use balder::scene::node::node3D::camera;

/**
 * The narrowest a texel is on screen, against its height
 * */
def MIN_TEXEL_ASPECT = 0.001f;

/**
 * How a camera sees a scene into its image, for a gizmo: the texels the points of the world are seen at, the rays
 * through the texels and the texels a length covers
 * */
pub record GizmoView {

    // The camera of the scene
    let _camera: &Camera;

    // The projection multiplied by the view of the camera, from world space to clip space
    pub let viewProj: mat4;

    // The size of the image of the scene, in texels
    pub let width: f32;
    pub let height: f32;

    // The width of a texel on screen over its height, the image being scaled to the size of the scene on screen
    pub let texelAspect: f32;

    /**
     * @params:
     *    - width, height: the size of the image the camera draws, in texels
     *    - texelAspect: the width of a texel on screen over its height, 1 for an image shown at its own aspect
     * */
    pub self (camera: &Camera, width: u32, height: u32, texelAspect: f32 = 1.0f)
        with _camera = camera
        , viewProj = camera.viewProj
        , width = cast!f32(width)
        , height = cast!f32(height)
        , texelAspect = (if texelAspect > MIN_TEXEL_ASPECT { texelAspect } else { MIN_TEXEL_ASPECT })
    {}

    /**
     * @returns: the camera seeing the scene
     * */
    @field
    pub fn camera(self)-> &Camera {
        self._camera
    }

    /**
     * @returns: the point of the image a point of the world is seen at, in texels from its top left corner, none when it
     * is behind the camera
     * */
    pub fn project(self, p: vec3)-> (vec2)? {
        let clip = self.viewProj * makeVec4(p, 1.0f);
        if clip.w <= 1.0e-6f { return none; }

        self.texelOf(clip)?
    }

    /**
     * @returns: the points of the image the ends of a segment of the world are seen at, the segment cut at the near plane
     * of the camera when it crosses it, none when it is in front of that plane whole
     * */
    pub fn projectSegment(self, a: vec3, b: vec3)-> (vec2, vec2)? {
        let ca = self.viewProj * makeVec4(a, 1.0f), cb = self.viewProj * makeVec4(b, 1.0f);

        // the distances to the near plane, z = -w in clip space, positive on the side the camera sees
        let da = ca.z + ca.w, db = cb.z + cb.w;
        if da < 0.0f && db < 0.0f { return none; }

        let start = if da < 0.0f { ca + (cb - ca) * (da / (da - db)) } else { ca };
        let end = if db < 0.0f { ca + (cb - ca) * (da / (da - db)) } else { cb };
        if start.w <= 1.0e-6f || end.w <= 1.0e-6f { return none; }

        (self.texelOf(start), self.texelOf(end))?
    }

    /**
     * @returns: the depth of a point of the world in front of the camera, its w in clip space (the distance along the
     * axis of a perspective camera), larger farther from the eye
     * */
    pub fn depth(self, p: vec3)-> f32 {
        (self.viewProj * makeVec4(p, 1.0f)).w
    }

    /**
     * @returns: the ray the camera sees through a point of the image, in texels from its top left corner
     * */
    pub fn ray(self, pixel: vec2)-> Ray {
        Ray(self.viewProj, makeVec2(2.0f * pixel.x / self.width - 1.0f, 2.0f * pixel.y / self.height - 1.0f))
    }

    /**
     * @returns: the number of texels of the height of the image a world unit covers at a point (see Camera::screenSize)
     * */
    pub fn texelsPerUnit(self, p: vec3)-> f32 {
        self._camera.screenSize(p, 1.0f) * self.height
    }

    /**
     * @returns: the point of the image a point of clip space in front of the camera is seen at, in texels from its top
     * left corner
     * */
    fn texelOf(self, clip: vec4)-> vec2 {
        let ndc = clip.xy / clip.w;
        makeVec2((ndc.x + 1.0f) / 2.0f * self.width, (ndc.y + 1.0f) / 2.0f * self.height)
    }

}

/**
 * @returns: how the camera of a scene sees it into the texture it renders, shown at the size of the scene on screen,
 * none without a camera or before the scene is configured
 * */
pub fn viewOf(dmut scene: &Scene)-> (GizmoView)? {
    if scene.width == 0u32 || scene.height == 0u32 { return none; }

    let mut texelAspect = 1.0f;
    if scene.aspectWidth != 0u32 && scene.aspectHeight != 0u32 {
        let shown = cast!f32(scene.aspectWidth) / cast!f32(scene.aspectHeight);
        texelAspect = shown / (cast!f32(scene.width) / cast!f32(scene.height));
    }

    atomic scene {
        if let Ok(cam) = scene:.getCamera() {
            GizmoView(cam, scene.width, scene.height, texelAspect-> texelAspect)?
        } else {
            none
        }
    }
}
