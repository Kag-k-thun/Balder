in debug;

mod ::depth;
mod ::lines;
mod ::segment;

pub def DebugDepth: depth::DebugDepth;
pub def DebugLines: lines::DebugLines;
pub def DebugSegment: segment::DebugSegment;

/**
 * The number of segments drawn over the image of a scene at most, the segments past it dropped (MAX_SEGMENTS of the
 * debug lines shader)
 * */
pub def MAX_DEBUG_SEGMENTS = 65536us;
