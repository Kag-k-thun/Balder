/**
 * The properties of the node classes, each declared once by its class: its name, the kind of its values, its default,
 * how to read it from a node and how to give it to one, its group and when it applies (see NodeSchema)
 * @info: a class declares its schema beside it (`Light::schema()`); the scene files read and write the entries of a node
 * from the schema of its kind (see NodeDescription), the editor builds the rows of its inspector from it and changes a
 * property of any node through one command
 * */
in property;

pub mod ::choice;
pub mod ::choice_property;
pub mod ::condition;
pub mod ::group;
pub mod ::kind;
pub mod ::node_property;
pub mod ::node_schema;
pub mod ::range;
pub mod ::typed_property;
pub mod ::value;
