in volume_edit;

use balder::scene::node::node3D::{transform, volume, volume_shape};

/**
 * A change of the shape of a volume and of its transform, from those it had to others: the faces of a volume dragged by
 * the gizmo, its centre following a face moved on its own (see VolumeShape::movedFace), applied and reverted as a whole,
 * so it can be undone
 * */
pub record VolumeEdit {

    // The volume changed
    let dmut _node: &Volume3D;

    // The shape of the volume before the edit, and after it
    pub let before: VolumeShape;
    pub let after: VolumeShape;

    // The transform of the volume before the edit, and after it
    pub let placedBefore: NodeTransform;
    pub let placedAfter: NodeTransform;

    /**
     * An edit of a volume from the shape and the transform it has now
     * @params:
     *    - after: the shape the edit gives the volume
     *    - placedAfter: the transform the edit gives the volume
     * */
    pub self (dmut node: &Volume3D, after: VolumeShape, placedAfter: NodeTransform)
        with _node = alias node
        , before = node.shape
        , after = after
        , placedBefore = NodeTransform(node)
        , placedAfter = placedAfter
    {}

    /**
     * @params:
     *    - before, placedBefore: the shape and the transform the volume had before the edit, given back by revert
     *    - after, placedAfter: the shape and the transform the edit gives the volume
     * */
    pub self (dmut node: &Volume3D, before: VolumeShape, after: VolumeShape, placedBefore: NodeTransform, placedAfter: NodeTransform)
        with _node = alias node
        , before = before
        , after = after
        , placedBefore = placedBefore
        , placedAfter = placedAfter
    {}

    /**
     * @returns: the volume changed
     * */
    @field
    pub fn node(self)-> &Volume3D {
        self._node
    }

    /**
     * @returns: the edit of the volume from its shape and its transform before this edit to others, the edits following
     * this one being merged into one (the steps of a field of an editor)
     * */
    pub fn extendedTo(mut self, after: VolumeShape, placedAfter: NodeTransform)-> dmut VolumeEdit {
        VolumeEdit(alias self._node, self.before, after, self.placedBefore, placedAfter)
    }

    /**
     * @returns: true iif the edit changes the volume
     * */
    pub fn changes(self)-> bool {
        let a = self.placedBefore, b = self.placedAfter;
        self.before != self.after || a.position != b.position || a.rotation != b.rotation || a.scale != b.scale
    }

    /**
     * Give the volume its shape and its transform after the edit
     * */
    pub fn apply(mut self) {
        self._node.shape = self.after;
        self.placedAfter.applyTo(alias self._node);
    }

    /**
     * Give the volume back its shape and its transform before the edit
     * */
    pub fn revert(mut self) {
        self._node.shape = self.before;
        self.placedBefore.applyTo(alias self._node);
    }

}
