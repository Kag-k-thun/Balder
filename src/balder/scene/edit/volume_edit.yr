in volume_edit;

use balder::scene::node::node3D;
use balder::scene::node::node3D::{body, body_shape, transform, volume, volume_shape};

/**
 * A change of the shape of a volume, or of the collider of a body, and of its transform, from those it had to others:
 * the faces of a volume or of a collider dragged by the gizmo, its centre following a face moved on its own (see
 * BodyShape::movedFace), applied and reverted as a whole, so it can be undone
 * @info: the node is a volume, or a body of a box, a sphere, a capsule or a cylinder (see VolumeEdit::shapeOf); the
 * shapes are those of a body, a volume taking the box, the sphere or the capsule of the same sizes (see
 * BodyShape::toVolume)
 * */
pub record VolumeEdit {

    // The volume or the body changed
    let dmut _node: &Node3D;

    // The shape of the node before the edit, and after it
    pub let before: BodyShape;
    pub let after: BodyShape;

    // The transform of the node before the edit, and after it
    pub let placedBefore: NodeTransform;
    pub let placedAfter: NodeTransform;

    /**
     * An edit of a volume from the shape and the transform it has now
     * @params:
     *    - after: the shape the edit gives the volume
     *    - placedAfter: the transform the edit gives the volume
     * */
    pub self (dmut node: &Volume3D, after: VolumeShape, placedAfter: NodeTransform)
        with _node = alias node
        , before = BodyShape(node.shape)
        , after = BodyShape(after)
        , placedBefore = NodeTransform(node)
        , placedAfter = placedAfter
    {}

    /**
     * An edit of the collider of a body from the shape and the transform it has now
     * @params:
     *    - after: the shape the edit gives the body, a box, a sphere, a capsule or a cylinder
     *    - placedAfter: the transform the edit gives the body
     * */
    pub self (dmut node: &PhysicsBody3D, after: BodyShape, placedAfter: NodeTransform)
        with _node = alias node
        , before = node.described ?? BodyShape()
        , after = after
        , placedBefore = NodeTransform(node)
        , placedAfter = placedAfter
    {}

    /**
     * @params:
     *    - node: a volume or a body
     *    - before, placedBefore: the shape and the transform the node had before the edit, given back by revert
     *    - after, placedAfter: the shape and the transform the edit gives the node
     * */
    pub self (dmut node: &Node3D, before: BodyShape, after: BodyShape, placedBefore: NodeTransform, placedAfter: NodeTransform)
        with _node = alias node
        , before = before
        , after = after
        , placedBefore = placedBefore
        , placedAfter = placedAfter
    {}

    /**
     * @returns: the volume or the body changed
     * */
    @field
    pub fn node(self)-> &Node3D {
        self._node
    }

    /**
     * @returns: the edit of the node from its shape and its transform before this edit to others, the edits following
     * this one being merged into one (the steps of a field of an editor)
     * */
    pub fn extendedTo(mut self, after: BodyShape, placedAfter: NodeTransform)-> dmut VolumeEdit {
        VolumeEdit(alias self._node, self.before, after, self.placedBefore, placedAfter)
    }

    /**
     * @returns: true iif the edit changes the node
     * */
    pub fn changes(self)-> bool {
        let a = self.placedBefore, b = self.placedAfter;
        self.before != self.after || a.position != b.position || a.rotation != b.rotation || a.scale != b.scale
    }

    /**
     * Give the node its shape and its transform after the edit
     * */
    pub fn apply(mut self) {
        giveShape(alias self._node, self.after);
        self.placedAfter.applyTo(alias self._node);
    }

    /**
     * Give the node back its shape and its transform before the edit
     * */
    pub fn revert(mut self) {
        giveShape(alias self._node, self.before);
        self.placedBefore.applyTo(alias self._node);
    }

}

/**
 * The nodes whose shapes the edits change
 * */
pub mod VolumeEdit {

    /**
     * @returns: the shape of a node whose faces an editor drags: a volume, or a body described by a box, a sphere, a
     * capsule or a cylinder; none for the other nodes
     * */
    pub fn shapeOf(node: &Node3D)-> (BodyShape)? {
        if let v: &Volume3D = node { return BodyShape(v.shape)?; }
        if let b: &PhysicsBody3D = node {
            if let Ok(d) = b.described && d.hasFaces { return d?; }
        }

        none
    }

}

/**
 * Give a volume or a body a shape, its collider built from it
 * */
fn giveShape(dmut node: &Node3D, shape: BodyShape) {
    if let dmut v: &Volume3D = alias node {
        v.shape = shape.toVolume();
    } else if let dmut b: &PhysicsBody3D = alias node {
        if let Ok(c) = shape.collider() {
            b:.setDescribedShape(c, shape?);
        }
    }
}
