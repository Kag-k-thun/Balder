in property_edit;

use balder::scene::node::node3D;
use balder::scene::property::{node_property, value};

/**
 * A change of a property of a node (see NodeProperty), from the value it had to another one, applied and reverted as a
 * whole, so it can be undone: an edit of any field of the inspector of an editor
 * */
pub record PropertyEdit {

    // The node changed
    let dmut _node: &Node3D;

    // The property changed
    pub let property: &NodeProperty;

    // The value of the property before the edit
    pub let before: PropertyValue;

    // The value of the property after the edit
    pub let after: PropertyValue;

    /**
     * An edit of a property of a node from the value it has now
     * @params:
     *    - after: the value the edit gives the property
     * */
    pub self (dmut node: &Node3D, property: &NodeProperty, after: PropertyValue)
        with _node = alias node
        , property = property
        , before = property.get(alias node)
        , after = after
    {}

    /**
     * @params:
     *    - before: the value the property had before the edit, given back by revert
     *    - after: the value the edit gives the property
     * */
    pub self (dmut node: &Node3D, property: &NodeProperty, before: PropertyValue, after: PropertyValue)
        with _node = alias node
        , property = property
        , before = before
        , after = after
    {}

    /**
     * @returns: the node changed
     * */
    @field
    pub fn node(self)-> &Node3D {
        self._node
    }

    /**
     * @returns: the edit of the property from its value before this edit to another one, the edits following this one
     * being merged into one (the steps of a field of an editor)
     * @params:
     *    - after: the value the property gets after the edits following this one
     * */
    pub fn extendedTo(mut self, after: PropertyValue)-> dmut PropertyEdit {
        PropertyEdit(alias self._node, self.property, self.before, after)
    }

    /**
     * @returns: why the node refuses the value after the edit (see NodeProperty::check), empty when it takes it
     * */
    pub fn check(self)-> [c8] {
        self.property.check(self._node, self.after)
    }

    /**
     * Give the property of the node its value after the edit
     * */
    pub fn apply(mut self) {
        self.property.set(alias self._node, self.after);
    }

    /**
     * Give the property of the node back its value before the edit
     * */
    pub fn revert(mut self) {
        self.property.set(alias self._node, self.before);
    }

}
