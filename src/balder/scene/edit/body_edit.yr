in body_edit;

use balder::scene::physics;
use balder::scene::node::node3D::{body, body_shape};

/**
 * A change of the settings and of the shape of a body, from those it had to others, applied and reverted as a whole, so
 * it can be undone
 * @info: the collider of each shape is built before the edit (see PhysicsBody3D::colliderOf), the edit giving it to the
 * body with the shape it is described by, never reading a model again
 * */
pub record BodyEdit {

    // The body changed
    let dmut _node: &PhysicsBody3D;

    // The settings of the body before the edit, and after it
    pub let settingsBefore: BodySettings;
    pub let settingsAfter: BodySettings;

    // The shape the body is described by before the edit, and after it
    pub let shapeBefore: (BodyShape)?;
    pub let shapeAfter: (BodyShape)?;

    // The collider of the body before the edit, and after it, built from the shapes
    pub let colliderBefore: ColliderShape;
    pub let colliderAfter: ColliderShape;

    /**
     * An edit of a body from the settings and the shape it has now
     * @params:
     *    - settings: the settings the edit gives the body
     *    - shape: the shape the edit describes the body by
     *    - collider: the collider of that shape (see PhysicsBody3D::colliderOf)
     * */
    pub self (dmut node: &PhysicsBody3D, settings: BodySettings, shape: (BodyShape)?, collider: ColliderShape)
        with _node = alias node
        , settingsBefore = node.settings
        , settingsAfter = settings
        , shapeBefore = node.described
        , shapeAfter = shape
        , colliderBefore = node.shape
        , colliderAfter = collider
    {}

    /**
     * An edit of a body from the state another edit found it in to the one it gives
     * */
    self (dmut node: &PhysicsBody3D, from: BodyEdit, to: BodyEdit)
        with _node = alias node
        , settingsBefore = from.settingsBefore
        , settingsAfter = to.settingsAfter
        , shapeBefore = from.shapeBefore
        , shapeAfter = to.shapeAfter
        , colliderBefore = from.colliderBefore
        , colliderAfter = to.colliderAfter
    {}

    /**
     * @returns: the body changed
     * */
    @field
    pub fn node(self)-> &PhysicsBody3D {
        self._node
    }

    /**
     * @returns: the edit of the body from its state before this edit to the state after another edit of it
     * */
    pub fn extendedTo(mut self, next: BodyEdit)-> dmut BodyEdit {
        BodyEdit(alias self._node, self, next)
    }

    /**
     * Give the body its settings and its shape after the edit
     * */
    pub fn apply(mut self) {
        self._node.settings = self.settingsAfter;
        self._node:.setDescribedShape(self.colliderAfter, self.shapeAfter);
    }

    /**
     * Give the body back its settings and its shape before the edit
     * */
    pub fn revert(mut self) {
        self._node.settings = self.settingsBefore;
        self._node:.setDescribedShape(self.colliderBefore, self.shapeBefore);
    }

}
