in node;

pub mod ::node2D;
pub mod ::node3D;
pub mod ::root;

use balder::core::dispose;

use std::fs;

use ::std::time;

// The place of a child past the other children of its parent, the last one (see Node::attach and moveUnder)
pub def LAST_PLACE = usize::max;

lazy dmut __NODE_UID__ = copy [0us];
fn getUID()-> usize {
    atomic {
        __NODE_UID__[0] += 1us;
        __NODE_UID__[0]
    }
}

/**
 * Base
 * */
@abstract
pub class Node {

    // The uniq id of the visual instance in the scene
    let mut _uid: usize;

    // The name of the node
    let mut _name: Path;

    prot { // Tree
        // The scene in which the node can be found
        let dmut _parent: (&Node)? = none;

        // The children of the node, by their name
        let dmut _childs: [[c8] => &Node] = copy [];

        // The children of the node, in their order (the order of the nodes in a scene file, the outline of an editor)
        let dmut _order: [&Node] = [];
    }

    prv { // Tick

        // True when the scene ticks the node (see onTick)
        let mut _ticked: bool = false;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Ctor for a root node
     * */
    prot self root(name: [c8])
        with _uid = getUID()
        , _name = Path(name)
    {}

    /**
     * Create a node and put it in an existing tree
     * @params:
     *    - name: the name of the node
     *    - parents: the parent to which the node is attached
     * */
    pub self (name: [c8], dmut parent: &Node)
        with _uid = getUID()
        , _name = Path(name)
        , _parent = (alias parent)?
    {
        parent:.addChild(name, alias self);
        self:.onTreeEnter(alias self);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==============================          ATTACHING/DETACHING          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a child node in the trees of node, at a place among the children, a child of the same name being disposed
     * @params:
     *    - at: the place of the child among the children, past them for the last one
     * */
    fn addChild(mut self, name: [c8], dmut node: &Node, at: usize = LAST_PLACE) {
        if let Ok(dmut old) = alias self._childs[name] {
            old:.dispose();
        }

        node._name = self._name.push(name);
        node._parent = (alias self)?;

        self._childs[name] = alias node;
        self:.insertInOrder(alias node, at);
    }

    /**
     * Remove a direct child in the node
     * */
    fn removeChild(mut self, name: [c8]) {
        if let Ok(c) = self._childs[name] {
            self:.removeFromOrder(c.uid);
        }

        self._childs:.remove(name);
    }

    /**
     * Put a child at a place among the children in their order
     * @params:
     *    - at: the place of the child, past the children for the last one
     * */
    fn insertInOrder(mut self, dmut node: &Node, at: usize) {
        let place = if at > self._order.len { self._order.len } else { at };
        let dmut order: [&Node] = [];
        for i, dmut c in alias self._order {
            if i == place { order ~= [alias node]; }
            order ~= [alias c];
        }

        if place == self._order.len { order ~= [alias node]; }
        self._order = alias order;
    }

    /**
     * Take a child out of the children in their order
     * @params:
     *    - uid: the uniq id of the child
     * */
    fn removeFromOrder(mut self, uid: usize) {
        let dmut order: [&Node] = [];
        for dmut c in alias self._order if c.uid != uid {
            order ~= [alias c];
        }

        self._order = alias order;
    }

    /**
     * Attach a node detached from its tree (see dispose) under a parent, under its name, at a place among the children
     * of the parent, the node and the nodes under it entering the scene of the parent, parents first
     * @params:
     *    - at: the place of the node among the children of the parent, LAST_PLACE past them
     * @returns: true iif the node is attached, false when it has a parent already or when a child of the parent has its
     * name
     * @info: an editor undoing the removal of a node attaches it again under the parent it had, at the place it had
     * */
    pub fn attach(mut self, dmut parent: &Node, at: usize)-> bool {
        if self._parent.hasValue { return false; }

        let name = self._name.file();
        if parent._childs[name].hasValue { return false; }

        parent:.addChild(name, alias self, at-> at);
        self:.renameChildren();
        self:.enterTree();
        true
    }

    /**
     * Move the node under a parent, at a place among its children, or to another place among its siblings, the node and
     * the nodes under it keeping their places in the scene: they do not leave it, nor enter it again, when the parent is
     * in the tree of the node, only their transformations following (see onMoved)
     * @params:
     *    - parent: the new parent, the parent of the node to change its place among its siblings
     *    - at: the place of the node among the children of the parent once moved, the other children counted,
     *          LAST_PLACE past them
     * @returns: true iif the node is moved, false when it has no parent (see attach), when the parent is the node or one
     * of the nodes under it, or when another child of the parent has its name
     * */
    pub fn moveUnder(mut self, dmut parent: &Node, at: usize)-> bool {
        let dmut from = if let Ok(dmut p) = alias self._parent { alias p } else { return false; };
        if parent.uid == self._uid || parent.isUnder(self) { return false; }

        let name = self._name.file();
        if let Ok(c) = parent._childs[name] && c.uid != self._uid { return false; }

        if from.uid == parent.uid {
            parent:.removeFromOrder(self._uid);
            parent:.insertInOrder(alias self, at);
            return true;
        }

        if from:.getRoot() !is parent:.getRoot() {
            // another tree: the node leaves the scene of the one, and enters the scene of the other
            self:.dispose();
            return self:.attach(alias parent, at-> at);
        }

        from:.removeChild(name);
        parent:.addChild(name, alias self, at-> at);
        self:.renameChildren();
        self:.onMoved(alias from);
        true
    }

    /**
     * @returns: true iif the node is under another one, the other being one of its ancestors
     * */
    pub fn isUnder(self, node: &Node)-> bool {
        let mut parent = self._parent;
        while let Ok(p) = parent {
            if p.uid == node.uid { return true; }
            parent = p._parent;
        }

        false
    }

    /**
     * Rename the node among the children of its parent, its path and the paths of the nodes under it following
     * @params:
     *    - name: the new name, neither empty nor holding a '/'
     * @returns: true iif the node has the name, false when the name is not valid or names another child of the parent
     * */
    pub fn rename(mut self, name: [c8])-> bool {
        if !isValidName(name) { return false; }

        let old = self._name.file();
        if name == old { return true; }

        if let Ok(dmut p) = alias self._parent {
            if p._childs[name].hasValue { return false; }

            p._childs:.remove(old);
            p._childs[name] = alias self;
            self._name = p._name.push(name);
        } else {
            self._name = Path(name);
        }

        self:.renameChildren();
        true
    }

    /**
     * Give the nodes under the node the paths under its own, after it was renamed
     * */
    fn renameChildren(mut self) {
        for name, dmut c in alias self._childs {
            c._name = self._name.push(name);
            c:.renameChildren();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          UPDATE SIGNALS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Method called when the node enters the scene
     * */
    pub fn onEnter(mut self, dmut scene: &Scene);

    /**
     * Method called when the node exits the scene
     * @info: the scene passed as argument is the same as the one passed in the previous onEnter
     * */
    pub fn onExit(mut self, dmut scene: &Scene);

    /**
     * Method called at each tick of the scene on the nodes it ticks (see ticked), each of them once, the others not
     * ticked
     * */
    pub fn onTick(mut self, _: Duration) {}

    /**
     * Method called when the node was moved under another parent of its tree (see moveUnder), the node and the nodes
     * under it staying in the scene, a 3D node computing its transformation again under the new parent
     * @params:
     *    - from: the parent the node was under
     * */
    prot fn onMoved(mut self, dmut _: &Node) {}

    /**
     * Propagate the entry of a node to scene
     * */
    fn onTreeEnter(mut self, dmut who: &Node) {
        if let Ok(dmut parent) = alias self._parent {
            parent:.onTreeEnter(alias who);
        }
    }

    /**
     * Propagate the entry of the node then of the nodes under it to the scene, the node being attached again (see
     * attach)
     * */
    fn enterTree(mut self) {
        self:.onTreeEnter(alias self);
        for dmut c in alias self._order {
            c:.enterTree();
        }
    }

    /**
     * Propagate the exit of a node to scene
     * */
    fn onTreeExit(mut self, dmut who: &Node) {
        if let Ok(dmut parent) = alias self._parent {
            parent:.onTreeExit(alias who);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          FINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find a child in the node tree
     * */
    pub fn find(mut self, name: Path)-> dmut (&Node)? {
        return self:.getChild(name.parts());
    }

    /**
     * Find a child in the node tree
     * */
    fn getChild(mut self, name: [[c8]])-> dmut (&Node)? {
        if name.len == 0 { return (alias self)?; }
        if let Ok(dmut c) = alias self._childs[name[0]] {
            return c:.getChild(name[1 .. $]);
        }

        none
    }

    /**
     * @returns: the children of the node, by their name
     * */
    pub fn getChilds(mut self)-> dmut [[c8] => &Node] {
        alias self._childs
    }

    /**
     * @returns: the children of the node, in their order: the order they were attached in, or the places they were
     * given (see attach), the order of the nodes in a scene file
     * */
    pub fn getChildrenInOrder(mut self)-> dmut [&Node] {
        alias self._order
    }

    /**
     * Traverse the tree and return the list of nodes that can be found within it, parents first, the children in their
     * order
     * */
    pub fn getAllNodes(mut self, ref dmut list: [&Node])-> dmut [&Node] {
        list ~= [alias self];
        for dmut c in alias self._order {
            c:.getAllNodes(ref list);
        }

        alias list
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          ITERATION          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the parent of the node
     * */
    pub fn getParent(mut self)-> dmut (&Node)? {
        alias self._parent
    }

    /**
     * @returns: the name of the node
     * */
    @field
    pub fn name(self)-> Path {
        self._name
    }

    @field
    pub fn uid(self)-> usize {
        self._uid
    }

    /**
     * @returns: the place of the node among the children of its parent, in their order, 0 for a node without a parent
     * */
    @field
    pub fn index(self)-> usize {
        if let Ok(p) = self._parent {
            for i, c in p._order {
                if c.uid == self._uid { return i; }
            }
        }

        0us
    }

    /**
     * @returns: true iif the scene ticks the node, calling onTick at each of its ticks
     * */
    @field
    pub fn ticked(self)-> bool {
        self._ticked
    }

    /**
     * Make the scene tick the node or not, a node overriding onTick asking for its ticks
     * @info: a node not ticked costs nothing at the ticks of the scene
     * */
    @field
    pub fn ticked(mut self, ticked: bool) {
        if ticked == self._ticked { return; }

        self._ticked = ticked;
        if let Ok(dmut scene) = alias self:.getScene() {
            scene:.onNodeTicked(alias self);
        }
    }

    /**
     * @returns: the top of the tree of the node, the node itself when it has no parent
     * */
    pub fn getRoot(mut self)-> dmut &Node {
        if let Ok(dmut p) = alias self._parent {
            return alias p:.getRoot();
        }

        alias self
    }

    /**
     * @returns: the scene to which the node is attached
     * */
    pub fn getScene(mut self)-> dmut (&Scene)? {
        if let Ok(dmut p) = alias self._parent {
            return alias p:.getScene();
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        /**
         * Detach the node from its parent, the node and the nodes under it leaving the scene
         * @info: the node keeps the nodes under it, and can be attached again under a parent (see attach)
         * */
        pub over dispose(mut self) {
            if let Ok(dmut p) = alias self._parent {
                p:.removeChild(self._name.file());
                self:.onTreeExit(alias self);
                self._parent = none;
            }
        }
    }
}

/**
 * @returns: true iif a node can be named so: a name not empty, holding no '/', the separator of the paths of the nodes
 * */
pub fn isValidName(name: [c8])-> bool {
    if name.len == 0us { return false; }
    for c in name {
        if c == '/'c8 { return false; }
    }

    true
}
