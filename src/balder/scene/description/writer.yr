in writer;

use balder::math::{utils, vector};
use balder::scene::asset::material_asset;
use balder::scene::description::{node_description, reader};
use balder::scene::property::{kind, node_property, value};

use std::{conv, stream, uuid};
use std::algorithm::sorting;

/**
 * Writer of the descriptions of the nodes of a scene into a scene file (see SceneDescription for the format)
 * @info:
 * =====
 * The file is the same each time the same nodes are written, so it diffs well under version control: the assets in the
 * order of their paths, each keyed by the name of its file; the materials local to the file in the order of their names
 * then of their ids, their entries holding the defaults left out; the nodes parents first, in the order of the descriptions
 * among their siblings; the entries of a node in the order of the schema of its kind, those that do not apply (see
 * NodeProperty.condition) and those holding the default of the schema left out; each number the shortest decimal that
 * reads back the same float (the angles, in degrees, the same radians).
 * ====
 * */
pub record SceneWriter {

    // The nodes under the root, in order, each with the nodes under it
    let _nodes: [NodeDescription];

    // The materials local to the file, which the nodes name
    let _materials: [&MaterialAsset];

    /**
     * @params:
     *    - nodes: the nodes under the root, in order
     *    - materials: the materials local to the file
     * */
    pub self (nodes: [NodeDescription], materials: [&MaterialAsset] = [])
        with _nodes = nodes
        , _materials = materials
    {}

    /**
     * @returns: the content of the scene file of the nodes
     * @info: a node of a nil id is given a new one, written in the file
     * */
    pub fn write(self)-> [c8] {
        let assets = SceneWriter::assets(self._nodes);
        let dmut out = copy StringStream();
        out:.write(f"scene ${SCENE_VERSION};\n");
        if assets.len != 0us {
            out:.write("\n");
            for a in assets {
                out:.write(f"asset ${a._1} ${a._2} ${SceneWriter::quoted(a._0)};\n");
            }
        }

        for m in SceneWriter::sortedMaterials(self._materials) {
            SceneWriter::writeMaterial(alias out, m);
        }

        for n in self._nodes {
            SceneWriter::writeNode(alias out, n, none, assets);
        }

        out[]
    }

}

/**
 * The writing of the nodes and of their values
 * */
@companion
mod SceneWriter {

    /**
     * Write the block of a node, then the blocks of the nodes under it
     * @params:
     *    - parent: the id of its parent, none under the root
     *    - assets: the keys of the files of the assets (see assets)
     * */
    pub fn writeNode(dmut out: &StringStream, n: NodeDescription, parent: (Uuid)?, assets: [([c8], [c8], [c8])]) {
        let id = if n.id.isNil() { v4() } else { n.id };

        out:.write(f"\nnode #${id} ${n.typeName()} ${SceneWriter::quoted(n.name)} {\n");
        if let Ok(p) = parent {
            SceneWriter::entry(alias out, "parent", f"#${p}");
        }

        for p in n.schema().properties if n.applies(p) {
            let v = n.value(p.name);
            if p.kind == PropertyKind::ASSET {
                if v.text.len != 0us {
                    SceneWriter::entry(alias out, p.name, SceneWriter::reference(v.text, assets));
                }
            } else if p.kind == PropertyKind::ASSETS {
                if v.texts.len != 0us {
                    let refs = copy [SceneWriter::reference(t, assets) for t in v.texts];
                    SceneWriter::entry(alias out, p.name, SceneWriter::joined(refs));
                }
            } else if !(v == p.defaultValue) {
                SceneWriter::entry(alias out, p.name, SceneWriter::valueOf(p, v));
            }
        }

        for e in n.entries {
            SceneWriter::entry(alias out, e._0, e._1);
        }

        for signal in SceneWriter::signalsOf(n) {
            let mut targets = "";
            for c in n.connections if c.signal == signal {
                targets = (if targets.len == 0us { "" } else { targets ~ " " }) ~ f"#${c.target} ${c.slot}";
            }

            SceneWriter::entry(alias out, "on-" ~ signal, targets);
        }

        out:.write("}\n");
        for c in n.children {
            SceneWriter::writeNode(alias out, c, (id)?, assets);
        }
    }

    /**
     * Write the block of a material local to the file, its entries holding their defaults left out
     * */
    pub fn writeMaterial(dmut out: &StringStream, m: &MaterialAsset) {
        let id = m.path[MaterialAsset::LOCAL_PREFIX.len .. $];
        out:.write(f"\nmaterial #${id} ${SceneWriter::quoted(m.name)} {\n");

        let defaults = copy MaterialAsset("", "");
        for e in MaterialAsset::entries() {
            let v = m.value(e._0);
            if v == defaults.value(e._0) { continue; }

            let text = match e._1 {
                PropertyKind::COLOR  => { SceneWriter::vector(v.vector) }
                PropertyKind::NUMBER => { SceneWriter::number(v.number) }
                _                    => { SceneWriter::quoted(v.text) }
            };

            SceneWriter::entry(alias out, e._0, text);
        }

        out:.write("}\n");
    }

    /**
     * @returns: materials in the order of their names, then of their paths
     * */
    pub fn sortedMaterials(materials: [&MaterialAsset])-> [&MaterialAsset] {
        let mut res: [&MaterialAsset] = [];
        for m in materials {
            let mut placed: [&MaterialAsset] = [];
            let mut inserted = false;
            for o in res {
                if !inserted && (m.name < o.name || (m.name == o.name && m.path < o.path)) {
                    placed ~= [m];
                    inserted = true;
                }

                placed ~= [o];
            }

            if !inserted { placed ~= [m]; }
            res = placed;
        }

        res
    }

    /**
     * @returns: what an entry writes for the path of an asset: `@<key>` for an asset of the file, `#<uuid>` for a
     * material local to it, none for an empty path
     * */
    pub fn reference(path: [c8], assets: [([c8], [c8], [c8])])-> [c8] {
        if path.len == 0us { return "none"; }
        if MaterialAsset::isLocalPath(path) { return "#" ~ path[MaterialAsset::LOCAL_PREFIX.len .. $]; }
        for a in assets if a._0 == path { return "@" ~ a._1; }
        "none"
    }

    /**
     * @returns: texts separated by spaces
     * */
    pub fn joined(texts: [[c8]])-> [c8] {
        let mut res = "";
        for i, t in texts {
            res = res ~ (if i == 0us { "" } else { " " }) ~ t;
        }

        res
    }

    /**
     * @returns: the signals of the connections of a node, each once, in the order of the connections
     * */
    pub fn signalsOf(n: NodeDescription)-> [[c8]] {
        let mut signals: [[c8]] = [];
        for c in n.connections {
            let mut found = false;
            for s in signals if s == c.signal { found = true; }
            if !found { signals ~= [c.signal]; }
        }

        signals
    }

    /**
     * @returns: the text of the value of an entry of a property, the angles of a property in degrees written in degrees
     * */
    pub fn valueOf(p: &NodeProperty, v: PropertyValue)-> [c8] {
        match p.kind {
            PropertyKind::NUMBER => { return if p.degrees { SceneWriter::angle(v.number) } else { SceneWriter::number(v.number) }; }
            PropertyKind::VECTOR | PropertyKind::COLOR => {
                if !p.degrees { return SceneWriter::vector(v.vector); }

                let r = v.vector;
                return SceneWriter::angle(r.x) ~ " " ~ SceneWriter::angle(r.y) ~ " " ~ SceneWriter::angle(r.z);
            }
            PropertyKind::BOOL   => { return SceneWriter::boolean(v.flag); }
            PropertyKind::STRING => { return SceneWriter::quoted(v.text); }
            PropertyKind::TEXTS  => { return SceneWriter::strings(v.texts); }
            PropertyKind::NODE   => { return f"#${v.node}"; }
            PropertyKind::COUNT  => { return f"${v.bits}"; }
            PropertyKind::LAYERS => { return SceneWriter::layers(v.bits); }
            _ => {}
        }

        v.text
    }

    /**
     * Write an entry of a node, `name: value;`
     * */
    pub fn entry(dmut out: &StringStream, name: [c8], value: [c8]) {
        out:.write(f"    ${name}: ${value};\n");
    }

    /**
     * @returns: the assets of nodes and of the nodes under them (their properties of the kind ASSET and ASSETS that
     * apply: the mesh and the materials of a mesh node, the model of a hull or a mesh), the materials local to the file
     * aside, each once, in the order of their paths, with the key of each and its kind: the key is the name of the file,
     * without its directory and its extension, made a valid name, followed by the index of a material embedded in a
     * model file, then by the first free number when another asset before it took it
     * @returns: the path, the key and the kind of each asset
     * */
    pub fn assets(nodes: [NodeDescription])-> [([c8], [c8], [c8])] {
        let found = SceneWriter::assetPaths(nodes, []);
        let mut keyed: [([c8], [c8], [c8])] = [];
        for p in sort(copy [f._0 for f in found]) {
            let mut kind = "mesh";
            for f in found if f._0 == p { kind = f._1; }

            let base = SceneWriter::keyOf(p);
            let mut key = base;
            let mut i = 2us;
            while SceneWriter::isTaken(keyed, key) {
                key = f"${base}_${i}";
                i += 1us;
            }

            keyed = keyed ~ [(p, key, kind)];
        }

        keyed
    }

    /**
     * @returns: the paths of the assets of nodes and of the nodes under them, with their kinds, each once, added to those
     * found already, the materials local to the file left out
     * */
    pub fn assetPaths(nodes: [NodeDescription], found: [([c8], [c8])])-> [([c8], [c8])] {
        let mut res = found;
        for n in nodes {
            for p in n.schema().properties if n.applies(p) {
                let kind = if p.asset.len == 0us { "mesh" } else { p.asset };
                if p.kind == PropertyKind::ASSET {
                    res = SceneWriter::withPath(res, n.value(p.name).text, kind);
                } else if p.kind == PropertyKind::ASSETS {
                    for t in n.value(p.name).texts {
                        res = SceneWriter::withPath(res, t, kind);
                    }
                }
            }

            res = SceneWriter::assetPaths(n.children, res);
        }

        res
    }

    /**
     * @returns: paths of assets and a path of an asset added once, an empty path and the path of a material local to the
     * file left out
     * */
    pub fn withPath(found: [([c8], [c8])], path: [c8], kind: [c8])-> [([c8], [c8])] {
        if path.len == 0us || MaterialAsset::isLocalPath(path) { return found; }
        for f in found if f._0 == path { return found; }
        found ~ [(path, kind)]
    }

    /**
     * @returns: true iif a key is the key of an asset already
     * */
    pub fn isTaken(keyed: [([c8], [c8], [c8])], key: [c8])-> bool {
        for a in keyed if a._1 == key { return true; }
        false
    }

    /**
     * @returns: the key of the asset of a file, its name without its directory and its extension, each character a name
     * cannot hold replaced by a '_', starting with a letter or a '_'
     * */
    pub fn keyOf(path: [c8])-> [c8] {
        if let Ok(embedded) = MaterialAsset::modelOf(path) {
            return f"${SceneWriter::keyOf(embedded._0)}_${embedded._1}";
        }

        let mut start = 0us, mut end = path.len;
        for i, c in path {
            if c == '/' { start = i + 1us; }
        }

        for i in start .. path.len {
            if path[i] == '.' && i > start { end = i; }
        }

        let dmut key = copy StringStream();
        for i in start .. end {
            let c = path[i];
            let isLetter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
            if isLetter || (c >= '0' && c <= '9') || c == '_' || (c == '-' && i > start) {
                key:.write(c);
            } else {
                key:.write('_');
            }
        }

        let k = key[];
        if k.len == 0us { return "asset"; }

        let first = k[0];
        if (first >= 'a' && first <= 'z') || (first >= 'A' && first <= 'Z') || first == '_' { k } else { "_" ~ k }
    }

    /**
     * @returns: a text between double quotes, its quotes, backslashes, line breaks and tabs escaped
     * */
    pub fn quoted(text: [c8])-> [c8] {
        let dmut s = copy StringStream();
        s:.write('"');
        for c in text {
            match c {
                '"'  => { s:.write("\\\""); }
                '\\' => { s:.write("\\\\"); }
                '\n' => { s:.write("\\n"); }
                '\t' => { s:.write("\\t"); }
                _    => { s:.write(c); }
            }
        }

        s:.write('"');
        s[]
    }

    /**
     * @returns: true or false
     * */
    pub fn boolean(b: bool)-> [c8] {
        if b { "true" } else { "false" }
    }

    /**
     * @returns: the three numbers of a vector
     * */
    pub fn vector(v: vec3)-> [c8] {
        SceneWriter::number(v.x) ~ " " ~ SceneWriter::number(v.y) ~ " " ~ SceneWriter::number(v.z)
    }

    /**
     * @returns: the shortest decimal reading back a number, without exponent
     * */
    pub fn number(f: f32)-> [c8] {
        SceneWriter::shortest(f, f, isAngle-> false)
    }

    /**
     * @returns: the shortest decimal of an angle in degrees reading back an angle in radian
     * */
    pub fn angle(r: f32)-> [c8] {
        SceneWriter::shortest(degree(r), r, isAngle-> true)
    }

    /**
     * @returns: the decimal of the fewest digits of a value that reads back a target, the value in radian of an angle
     * in degrees, or the decimal of the most digits when none does
     * @params:
     *    - value: the value written
     *    - target: the value it reads back as
     *    - isAngle: true when the value is in degrees and the target in radian
     * */
    pub fn shortest(value: f32, target: f32, isAngle: bool)-> [c8] {
        if target == 0.0f { return "0"; }

        let mut text = "0";
        for p in 0u32 .. 48u32 {
            text = SceneWriter::trimmed(std::conv::to!{[c8]} (value, prec-> p));
            let read = {
                std::conv::to!{f32} (text)
            } catch {
                _ => { continue; }
            };

            if (if isAngle { radian(read) } else { read }) == target { return text; }
        }

        text
    }

    /**
     * @returns: a decimal without the zeros ending its fractional part, nor the '.' left alone
     * */
    pub fn trimmed(text: [c8])-> [c8] {
        let mut dot = false;
        for c in text if c == '.' { dot = true; }
        if !dot { return text; }

        let mut end = text.len;
        while end > 0us && text[end - 1us] == '0' { end -= 1us; }
        if end > 0us && text[end - 1us] == '.' { end -= 1us; }

        let t = text[0us .. end];
        if t == "-0" { "0" } else { t }
    }

    /**
     * @returns: texts between double quotes, separated by spaces
     * */
    pub fn strings(texts: [[c8]])-> [c8] {
        let dmut s = copy StringStream();
        for i, t in texts {
            if i != 0us { s:.write(" "); }
            s:.write(SceneWriter::quoted(t));
        }

        s[]
    }

    /**
     * @returns: the numbers of the layers of bits, from the lowest, separated by spaces, or none
     * */
    pub fn layers(bits: u32)-> [c8] {
        if bits == 0u32 { return "none"; }

        let dmut s = copy StringStream();
        for i in 0u32 .. 32u32 if (bits & (1u32 << i)) != 0u32 {
            if s[].len != 0us { s:.write(" "); }
            s:.write(f"${i}");
        }

        s[]
    }

}
