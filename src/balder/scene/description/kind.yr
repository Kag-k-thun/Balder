in kind;

/**
 * The kinds of the nodes a scene file describes, by the name of their 'type' entry
 * */
pub enum NodeKind : u32
| GROUP  = 0u32
| MODEL  = 1u32
| CUBE   = 2u32
| SPHERE = 3u32
| PLANE  = 4u32
| LIGHT  = 5u32;

/**
 * @returns: the name of a kind of node, as the 'type' entry of a scene file writes it
 * */
pub fn kindName(kind: NodeKind)-> [c8] {
    match kind {
        NodeKind::GROUP  => { "group" }
        NodeKind::MODEL  => { "model" }
        NodeKind::CUBE   => { "cube" }
        NodeKind::SPHERE => { "sphere" }
        NodeKind::PLANE  => { "plane" }
        _                => { "light" }
    }
}

/**
 * @returns: the kind of node a 'type' entry of a scene file names, none for a name of no kind
 * */
pub fn kindNamed(name: [c8])-> (NodeKind)? {
    match name {
        "group"  => { return NodeKind::GROUP?; }
        "model"  => { return NodeKind::MODEL?; }
        "cube"   => { return NodeKind::CUBE?; }
        "sphere" => { return NodeKind::SPHERE?; }
        "plane"  => { return NodeKind::PLANE?; }
        "light"  => { return NodeKind::LIGHT?; }
        _        => { return none; }
    }
}
