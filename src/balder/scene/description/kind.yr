in kind;

use balder::core::error;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{body, body_shape, camera, character, empty, light, marker, path, path_point, solid, volume};
use balder::scene::node::node3D::visual::{_, material::_};
use balder::scene::property::node_schema;

/**
 * The kinds of the nodes a scene file describes, by the name of their 'type' entry
 * */
pub enum NodeKind : u32
| EMPTY      = 0u32
| MODEL      = 1u32
| CUBE       = 2u32
| SPHERE     = 3u32
| PLANE      = 4u32
| LIGHT      = 5u32
| MARKER     = 6u32
| PATH       = 7u32
| PATH_POINT = 8u32
| VOLUME     = 9u32
| BODY       = 10u32
| CHARACTER  = 11u32
| CAMERA     = 12u32;

/**
 * The names of the kinds of nodes, as a scene file writes them
 * */
enum KindNames
| EMPTY      = ("empty", NodeKind::EMPTY)
| MODEL      = ("model", NodeKind::MODEL)
| CUBE       = ("cube", NodeKind::CUBE)
| SPHERE     = ("sphere", NodeKind::SPHERE)
| PLANE      = ("plane", NodeKind::PLANE)
| LIGHT      = ("light", NodeKind::LIGHT)
| MARKER     = ("marker", NodeKind::MARKER)
| PATH       = ("path", NodeKind::PATH)
| PATH_POINT = ("path-point", NodeKind::PATH_POINT)
| VOLUME     = ("volume", NodeKind::VOLUME)
| BODY       = ("body", NodeKind::BODY)
| CHARACTER  = ("character", NodeKind::CHARACTER)
| CAMERA     = ("camera", NodeKind::CAMERA);

/**
 * @returns: the name of a kind of node, as the 'type' entry of a scene file writes it
 * */
pub fn kindName(kind: NodeKind)-> [c8] {
    cte for k in KindNames::__members__ {
        if k._1 == kind { return k._0; }
    }

    "empty"
}

/**
 * @returns: the kind of node a 'type' entry of a scene file names, none for a name of no kind
 * */
pub fn kindNamed(name: [c8])-> (NodeKind)? {
    cte for k in KindNames::__members__ {
        if k._0 == name { return k._1?; }
    }

    none
}

/**
 * @returns: the kind of a node of a scene, as a scene file describes it
 * @throws:
 *    - &BalderError: if no scene file describes the node: a mesh given its vertices (not made of a primitive, see
 *                    MeshGeometry.primitive), a body of a shape given as a collider (see PhysicsBody3D::described), a node
 *                    of another class
 * */
pub fn kindOf(node: &Node3D)-> NodeKind
    throws BalderError
{
    match node {
        _: &Light            => { NodeKind::LIGHT }
        _: &SolidObjectModel => { NodeKind::MODEL }
        _: &Marker3D         => { NodeKind::MARKER }
        _: &Path3D           => { NodeKind::PATH }
        _: &PathPoint3D      => { NodeKind::PATH_POINT }
        _: &Volume3D         => { NodeKind::VOLUME }
        _: &CharacterBody3D  => { NodeKind::CHARACTER }
        b: &PhysicsBody3D    => {
            if !b.described.hasValue {
                throw copy BalderError(f"${node.name.toStr()}: a body of a shape given as a collider, which no scene file describes");
            }

            NodeKind::BODY
        }
        _: &Empty3D          => { NodeKind::EMPTY }
        _: &Camera           => { NodeKind::CAMERA }
        m: &IndexedMesh3D    => {
            match m.primitive {
                Primitive::CUBE   => { NodeKind::CUBE }
                Primitive::SPHERE => { NodeKind::SPHERE }
                Primitive::PLANE  => { NodeKind::PLANE }
                _ => {
                    throw copy BalderError(f"${node.name.toStr()}: a mesh given its vertices, which no scene file describes");
                }
            }
        }
        _ => {
            throw copy BalderError(f"${node.name.toStr()}: a node of a kind no scene file describes");
        }
    }
}

/**
 * @returns: the schema of the nodes of a kind, the properties its entries give
 * */
pub fn schemaOf(kind: NodeKind)-> &NodeSchema {
    match kind {
        NodeKind::MODEL      => { SolidObjectModel::schema() }
        NodeKind::CUBE       => { IndexedMesh3D::schema() }
        NodeKind::SPHERE     => { IndexedMesh3D::schema() }
        NodeKind::PLANE      => { IndexedMesh3D::schema() }
        NodeKind::LIGHT      => { Light::schema() }
        NodeKind::MARKER     => { Marker3D::schema() }
        NodeKind::PATH       => { Path3D::schema() }
        NodeKind::PATH_POINT => { PathPoint3D::schema() }
        NodeKind::VOLUME     => { Volume3D::schema() }
        NodeKind::BODY       => { PhysicsBody3D::schema() }
        NodeKind::CHARACTER  => { CharacterBody3D::schema() }
        NodeKind::CAMERA     => { Camera::schema() }
        _                    => { Empty3D::schema() }
    }
}

/**
 * @returns: the schema of the class of a node, the transform only for a node of a class declaring none
 * */
pub fn schemaOfNode(node: &Node3D)-> &NodeSchema {
    match node {
        _: &Light            => { Light::schema() }
        _: &SolidObjectModel => { SolidObjectModel::schema() }
        _: &Marker3D         => { Marker3D::schema() }
        _: &Path3D           => { Path3D::schema() }
        _: &PathPoint3D      => { PathPoint3D::schema() }
        _: &Volume3D         => { Volume3D::schema() }
        _: &CharacterBody3D  => { CharacterBody3D::schema() }
        _: &PhysicsBody3D    => { PhysicsBody3D::schema() }
        _: &Empty3D          => { Empty3D::schema() }
        _: &Camera           => { Camera::schema() }
        _: &IndexedMesh3D    => { IndexedMesh3D::schema() }
        _                    => { copy NodeSchema("node") }
    }
}

/**
 * @returns: the schemas of the classes of the nodes a scene file describes, each once, in the order of the kinds
 * */
pub fn schemas()-> [&NodeSchema] {
    copy [Empty3D::schema(), SolidObjectModel::schema(), IndexedMesh3D::schema(), Light::schema(), Marker3D::schema(),
          Path3D::schema(), PathPoint3D::schema(), Volume3D::schema(), PhysicsBody3D::schema(), CharacterBody3D::schema(),
          Camera::schema()]
}

/**
 * @returns: the name of a kind of shape of a body, as the entry shape of a scene file writes it
 * */
pub fn shapeName(kind: BodyShapeKind)-> [c8] {
    match kind {
        BodyShapeKind::SPHERE   => { "sphere" }
        BodyShapeKind::CAPSULE  => { "capsule" }
        BodyShapeKind::CYLINDER => { "cylinder" }
        BodyShapeKind::PLANE    => { "plane" }
        BodyShapeKind::HULL     => { "hull" }
        BodyShapeKind::MESH     => { "mesh" }
        BodyShapeKind::COMPOUND => { "compound" }
        _                       => { "box" }
    }
}

/**
 * @returns: the kind of shape of a body the entry shape of a scene file names, a box for a name of no kind
 * */
pub fn shapeNamed(name: [c8])-> BodyShapeKind {
    cte for k in BodyShapeKind::__members__ {
        if shapeName(k) == name { return k; }
    }

    BodyShapeKind::BOX
}
