in kind;

use balder::core::error;
use balder::scene::actors::{node_classes, unknown_actor};
use balder::scene::node::node3D;
use balder::scene::node::node3D::{body, body_shape, camera, character, empty, light, marker, mesh_instance, path, path_point, visual::_, volume};
use balder::scene::property::node_schema;

/**
 * The kinds of the nodes a scene file describes, by the name of their 'type' entry
 * */
pub enum NodeKind : u32
| EMPTY      = 0u32
| MESH       = 1u32 // a node drawing a mesh asset (see MeshInstance3D)
| LIGHT      = 5u32
| MARKER     = 6u32
| PATH       = 7u32
| PATH_POINT = 8u32
| VOLUME     = 9u32
| BODY       = 10u32
| CHARACTER  = 11u32
| CAMERA     = 12u32
| ACTOR      = 13u32; // a node of an actor class (see ActorClass), its type the name of the class

/**
 * The names of the kinds of nodes, as a scene file writes them
 * */
enum KindNames
| EMPTY      = ("empty", NodeKind::EMPTY)
| MESH       = ("mesh", NodeKind::MESH)
| LIGHT      = ("light", NodeKind::LIGHT)
| MARKER     = ("marker", NodeKind::MARKER)
| PATH       = ("path", NodeKind::PATH)
| PATH_POINT = ("path-point", NodeKind::PATH_POINT)
| VOLUME     = ("volume", NodeKind::VOLUME)
| BODY       = ("body", NodeKind::BODY)
| CHARACTER  = ("character", NodeKind::CHARACTER)
| CAMERA     = ("camera", NodeKind::CAMERA);

/**
 * The kinds of the nodes of the scene files of version 1 that are no longer kinds, a mesh node drawing the mesh they drew,
 * each with the mesh asset a mesh node of it draws
 * */
enum FormerKinds
| MODEL  = ("model", "the mesh of its model file")
| CUBE   = ("cube", "the mesh engine:/meshes/cube")
| SPHERE = ("sphere", "the mesh engine:/meshes/sphere")
| PLANE  = ("plane", "the mesh engine:/meshes/plane");

/**
 * @returns: why a kind of the scene files of version 1 no longer is one, telling the mesh node replacing it, none for
 * any other name
 * */
pub fn formerKind(name: [c8])-> ([c8])? {
    cte for k in FormerKinds::__members__ {
        if k._0 == name {
            return (f"'${k._0}' is no longer a kind of node: a mesh node draws ${k._1}")?;
        }
    }

    none
}

/**
 * @returns: the name of a kind of node, as the 'type' entry of a scene file writes it
 * */
pub fn kindName(kind: NodeKind)-> [c8] {
    cte for k in KindNames::__members__ {
        if k._1 == kind { return k._0; }
    }

    "empty"
}

/**
 * @returns: the kind of node a 'type' entry of a scene file names, none for a name of no kind
 * */
pub fn kindNamed(name: [c8])-> (NodeKind)? {
    cte for k in KindNames::__members__ {
        if k._0 == name { return k._1?; }
    }

    none
}

/**
 * @returns: the kind of a node of a scene, as a scene file describes it, ACTOR for a node of an actor class or of a class
 * the program does not know (see UnknownActor)
 * @throws:
 *    - &BalderError: if no scene file describes the node: a mesh given its vertices (an IndexedMesh3D, not drawing a
 *                    mesh asset), a body of a shape given as a collider (see PhysicsBody3D::described), a node of another
 *                    class
 * */
pub fn kindOf(node: &Node3D)-> NodeKind
    throws BalderError
{
    if let _: &UnknownActor = node { return NodeKind::ACTOR; }
    if actorClassOf(node).hasValue { return NodeKind::ACTOR; }

    match node {
        _: &Light            => { NodeKind::LIGHT }
        _: &MeshInstance3D   => { NodeKind::MESH }
        _: &Marker3D         => { NodeKind::MARKER }
        _: &Path3D           => { NodeKind::PATH }
        _: &PathPoint3D      => { NodeKind::PATH_POINT }
        _: &Volume3D         => { NodeKind::VOLUME }
        _: &CharacterBody3D  => { NodeKind::CHARACTER }
        b: &PhysicsBody3D    => {
            if !b.described.hasValue {
                throw copy BalderError(f"${node.name.toStr()}: a body of a shape given as a collider, which no scene file describes");
            }

            NodeKind::BODY
        }
        _: &Empty3D          => { NodeKind::EMPTY }
        _: &Camera           => { NodeKind::CAMERA }
        _: &IndexedMesh3D    => {
            throw copy BalderError(f"${node.name.toStr()}: a mesh given its vertices, which no scene file describes");
        }
        _ => {
            throw copy BalderError(f"${node.name.toStr()}: a node of a kind no scene file describes");
        }
    }
}

/**
 * @returns: the schema of the nodes of a kind, the properties its entries give
 * */
pub fn schemaOf(kind: NodeKind)-> &NodeSchema {
    match kind {
        NodeKind::MESH       => { MeshInstance3D::schema() }
        NodeKind::LIGHT      => { Light::schema() }
        NodeKind::MARKER     => { Marker3D::schema() }
        NodeKind::PATH       => { Path3D::schema() }
        NodeKind::PATH_POINT => { PathPoint3D::schema() }
        NodeKind::VOLUME     => { Volume3D::schema() }
        NodeKind::BODY       => { PhysicsBody3D::schema() }
        NodeKind::CHARACTER  => { CharacterBody3D::schema() }
        NodeKind::CAMERA     => { Camera::schema() }
        _                    => { Empty3D::schema() }
    }
}

/**
 * @returns: the schema of the nodes of a kind and of a class, an actor class for the kind ACTOR, the transform only for an
 * actor class the program does not know
 * */
pub fn schemaOfClass(kind: NodeKind, className: [c8])-> &NodeSchema {
    if kind != NodeKind::ACTOR { return schemaOf(kind); }
    if let Ok(c) = actorClass(className) { return c.schema(); }
    copy NodeSchema(className)
}

/**
 * @returns: the type of the nodes of a kind and of a class in the scene files, the name of the actor class for the kind
 * ACTOR
 * */
pub fn typeName(kind: NodeKind, className: [c8])-> [c8] {
    if kind == NodeKind::ACTOR { className } else { kindName(kind) }
}

/**
 * @returns: the schema of the class of a node, the transform only for a node of a class declaring none
 * */
pub fn schemaOfNode(node: &Node3D)-> &NodeSchema {
    if let u: &UnknownActor = node { return copy NodeSchema(u.className); }
    if let Ok(c) = actorClassOf(node) { return c.schema(); }

    match node {
        _: &Light            => { Light::schema() }
        _: &MeshInstance3D   => { MeshInstance3D::schema() }
        _: &Marker3D         => { Marker3D::schema() }
        _: &Path3D           => { Path3D::schema() }
        _: &PathPoint3D      => { PathPoint3D::schema() }
        _: &Volume3D         => { Volume3D::schema() }
        _: &CharacterBody3D  => { CharacterBody3D::schema() }
        _: &PhysicsBody3D    => { PhysicsBody3D::schema() }
        _: &Empty3D          => { Empty3D::schema() }
        _: &Camera           => { Camera::schema() }
        _                    => { copy NodeSchema("node") }
    }
}

/**
 * @returns: the schemas of the classes of the nodes a scene file describes, each once, in the order of the kinds, then
 * those of the actor classes in the order of their registration
 * */
pub fn schemas()-> [&NodeSchema] {
    let mut res = copy [Empty3D::schema(), MeshInstance3D::schema(), Light::schema(),
                        Marker3D::schema(), Path3D::schema(), PathPoint3D::schema(), Volume3D::schema(),
                        PhysicsBody3D::schema(), CharacterBody3D::schema(), Camera::schema()];
    for c in actorClasses() { res ~= [c.schema()]; }
    res
}

/**
 * @returns: the name of a kind of shape of a body, as the entry shape of a scene file writes it
 * */
pub fn shapeName(kind: BodyShapeKind)-> [c8] {
    match kind {
        BodyShapeKind::SPHERE   => { "sphere" }
        BodyShapeKind::CAPSULE  => { "capsule" }
        BodyShapeKind::CYLINDER => { "cylinder" }
        BodyShapeKind::PLANE    => { "plane" }
        BodyShapeKind::HULL     => { "hull" }
        BodyShapeKind::MESH     => { "mesh" }
        BodyShapeKind::COMPOUND => { "compound" }
        _                       => { "box" }
    }
}

/**
 * @returns: the kind of shape of a body the entry shape of a scene file names, a box for a name of no kind
 * */
pub fn shapeNamed(name: [c8])-> BodyShapeKind {
    cte for k in BodyShapeKind::__members__ {
        if shapeName(k) == name { return k; }
    }

    BodyShapeKind::BOX
}
