in kind;

/**
 * The kinds of the nodes a scene file describes, by the name of their 'type' entry
 * */
pub enum NodeKind : u32
| EMPTY      = 0u32
| MODEL      = 1u32
| CUBE       = 2u32
| SPHERE     = 3u32
| PLANE      = 4u32
| LIGHT      = 5u32
| MARKER     = 6u32
| PATH       = 7u32
| PATH_POINT = 8u32
| VOLUME     = 9u32;

/**
 * The names of the kinds of nodes, as a scene file writes them
 * */
enum KindNames
| EMPTY      = ("empty", NodeKind::EMPTY)
| MODEL      = ("model", NodeKind::MODEL)
| CUBE       = ("cube", NodeKind::CUBE)
| SPHERE     = ("sphere", NodeKind::SPHERE)
| PLANE      = ("plane", NodeKind::PLANE)
| LIGHT      = ("light", NodeKind::LIGHT)
| MARKER     = ("marker", NodeKind::MARKER)
| PATH       = ("path", NodeKind::PATH)
| PATH_POINT = ("path-point", NodeKind::PATH_POINT)
| VOLUME     = ("volume", NodeKind::VOLUME);

/**
 * @returns: the name of a kind of node, as the 'type' entry of a scene file writes it
 * */
pub fn kindName(kind: NodeKind)-> [c8] {
    cte for k in KindNames::__members__ {
        if k._1 == kind { return k._0; }
    }

    "empty"
}

/**
 * @returns: the kind of node a 'type' entry of a scene file names, none for a name of no kind
 * */
pub fn kindNamed(name: [c8])-> (NodeKind)? {
    cte for k in KindNames::__members__ {
        if k._0 == name { return k._1?; }
    }

    none
}
