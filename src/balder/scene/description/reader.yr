in reader;

use balder::math::{utils, vector};
use balder::scene::node;
use balder::scene::actors::{node_classes, node_connection};
use balder::scene::description::{kind, node_description};
use balder::scene::property::{choice, kind, node_property, node_schema, value};
use balder::utils::{syntax, types};

use std::{conv, syntax, uuid};

/**
 * The version of the scene files this Balder reads and writes, the number of their 'scene' statement
 * */
pub def SCENE_VERSION = 1u32;

/**
 * Reader of a scene file into the descriptions of its nodes (see SceneDescription for the format)
 * @info:
 * =====
 * ```
 * file  = "scene" number ";" { asset | node } ;
 * asset = "asset" key "model" string ";" ;
 * node  = "node" "#" uuid kind string "{" { entry } "}" ;
 * entry = name ":" value { value } ";" ;
 * value = number | name | "#" uuid | "@" key ;
 * ```
 * The kind of a node is a kind of Balder or the type of an actor class (see ActorClass), whose entries are its
 * properties and the connections of its signals, `on-<signal>: #<id> <slot> { #<id> <slot> } ;`. A node of a type no
 * class has is an actor of a class the program does not know (see UnknownActor): its transform is read, its other
 * entries kept as their text.
 * The blocks of the nodes are flat, each naming its parent by its id: they are put under their parents once every block
 * is read, in the order of the file among their siblings, so a block may come before the block of its parent. The
 * entries of a node are the properties of the schema of its kind (see schemaOf). The reader checks that the ids are
 * distinct, that each parent and asset exists, that no node is under itself, that each entry is a property of the kind
 * of its node, is given once and has values of its kind, that a node gives the properties it requires and no asset it
 * does not read, and that one node at most has a unique property true (the active camera).
 * A lenient reader keeps of an actor of a class the program knows only what its class declares: an entry it has no
 * property for, a signal it does not have, a connection to a slot its target does not have or that does not take the
 * payload of the signal are dropped, each told (see dropped), rather than refused; the editor reads its scene that way
 * when it loads the library of the game again, its classes changed.
 * ====
 * */
pub record SceneReader {

    // The scanner of the file
    let dmut _scanner: &Scanner;

    // True iif what the class of an actor does not declare is dropped rather than refused
    let _lenient: bool;

    // What a lenient reader dropped, in the order of the file
    let mut _dropped: [[c8]];

    /**
     * @params:
     *    - content: the content of the scene file
     *    - lenient: drop what the class of an actor does not declare rather than refuse it
     * */
    pub self (content: [c8], lenient: bool = false)
        with _scanner = copy Scanner(content)
        , _lenient = lenient
        , _dropped = []
    {}

    /**
     * @returns: what a lenient reader dropped, an entry, a signal or a connection each, `door 'gate' has no entry 'speed'`
     * */
    @field
    pub fn dropped(self)-> [[c8]] {
        self._dropped
    }

    /**
     * Read the whole content
     * @returns: the nodes under the root, in the order of the file, each with the nodes under it
     * */
    pub fn read(mut self)-> [NodeDescription]
        throws SyntaxError
    {
        self:.readHeader();

        let mut nodes: [FlatNode] = [];
        let mut assets: [Asset] = [];
        loop {
            let tok = self._scanner:.next();
            if tok.kind == TokenKind::EOF { break; }

            if tok.kind == TokenKind::IDENT && tok.text == "node" {
                nodes = nodes ~ [self:.readNode(tok)];
            } else if tok.kind == TokenKind::IDENT && tok.text == "asset" {
                let asset = self:.readAsset();
                for a in assets if a.key == asset.key {
                    throw copy SyntaxError(f"asset '${a.key}' declared twice", tok.line, tok.col);
                }

                assets = assets ~ [asset];
            } else {
                throw self._scanner.expected(tok, "a node or an asset");
            }
        }

        SceneReader::checkUnique(nodes);
        if self._lenient {
            let (kept, dropped) = SceneReader::withoutBrokenConnections(nodes);
            nodes = kept;
            self._dropped ~= dropped;
        }

        SceneReader::checkConnections(nodes);
        SceneReader::assemble(SceneReader::resolveAssets(nodes, assets))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          STATEMENTS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read the statement opening the file, `scene 1;`, the version of its format
     * */
    fn readHeader(mut self)
        throws SyntaxError
    {
        let tok = self._scanner:.next();
        if tok.kind != TokenKind::IDENT || tok.text != "scene" {
            throw self._scanner.expected(tok, f"'scene ${SCENE_VERSION};' opening the scene file");
        }

        let version = self._scanner:.next();
        if version.kind != TokenKind::NUMBER || version.unit != "" || version.text != f"${SCENE_VERSION}" {
            throw copy SyntaxError(f"version '${self._scanner.source(version.start, version.end)}' of the scene file, this Balder reading version ${SCENE_VERSION}",
                                   version.line, version.col);
        }

        self._scanner:.expect(";");
    }

    /**
     * Read the declaration of an asset after its keyword, `asset table model "res:/models/table.glb";`
     * */
    fn readAsset(mut self)-> Asset
        throws SyntaxError
    {
        let key = self._scanner:.next();
        if key.kind != TokenKind::IDENT {
            throw self._scanner.expected(key, "the key of the asset");
        }

        let kind = self._scanner:.next();
        if kind.kind != TokenKind::IDENT || kind.text != "model" {
            throw self._scanner.expected(kind, "the kind of the asset, model");
        }

        let path = self._scanner:.next();
        if path.kind != TokenKind::STRING || path.text.len == 0us {
            throw self._scanner.expected(path, "the path of the file of the asset");
        }

        self._scanner:.expect(";");
        Asset(key.text, path.text)
    }

    /**
     * Read the block of a node after its keyword, `node #<id> <kind> "<name>" { <entries> }`
     * @params:
     *    - at: the keyword, where the node is
     * */
    fn readNode(mut self, at: Token)-> FlatNode
        throws SyntaxError
    {
        let id = self.readId(self._scanner:.next(), "the id of the node, #<uuid>");

        let kindTok = self._scanner:.next();
        if kindTok.kind != TokenKind::IDENT {
            throw self._scanner.expected(kindTok, "the kind of the node, empty, model, cube, sphere, plane, light, marker, path, path-point, volume, body, character, camera, or the type of an actor class");
        }

        let nameTok = self._scanner:.next();
        if nameTok.kind != TokenKind::STRING {
            throw self._scanner.expected(nameTok, "the name of the node, between quotes");
        }

        if !isValidName(nameTok.text) {
            throw copy SyntaxError(f"node name '${nameTok.text}', empty or holding a '/'", nameTok.line, nameTok.col);
        }

        let mut d = if let Ok(k) = kindNamed(kindTok.text) { NodeDescription(nameTok.text, k) } else {
            NodeDescription::actor(nameTok.text, kindTok.text)
        };
        d.id = id;

        let schema = d.schema();
        let mut node = FlatNode(d, at.line, at.col);
        let mut given: [[c8]] = [];
        self._scanner:.expect("{");
        loop {
            let tok = self._scanner:.next();
            if tok.kind == TokenKind::DELIM && tok.text == "}" { break; }
            if tok.kind != TokenKind::IDENT {
                throw self._scanner.expected(tok, "an entry of the node or '}'");
            }

            for g in given if g == tok.text {
                throw copy SyntaxError(f"entry '${tok.text}' given twice", tok.line, tok.col);
            }

            given = given ~ [tok.text];
            self._scanner:.expect(":");
            let values = self:.readValues();
            self:.readEntry(ref node, schema, tok, values);
        }

        SceneReader::checkGiven(node, schema, given);
        node
    }

    /**
     * @returns: the tokens of the value of an entry, up to the ';' closing it, consumed
     * */
    fn readValues(mut self)-> [Token]
        throws SyntaxError
    {
        let mut values: [Token] = [];
        loop {
            let tok = self._scanner:.next();
            if tok.kind == TokenKind::DELIM && tok.text == ";" { break; }
            if tok.kind == TokenKind::EOF || tok.kind == TokenKind::DELIM {
                throw self._scanner.expected(tok, "a value or ';'");
            }

            values = values ~ [tok];
        }

        values
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ENTRIES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read an entry of a node, its parent or a property of the schema of its kind
     * @params:
     *    - schema: the schema of the kind of the node
     *    - key: the name of the entry
     *    - values: the tokens of its value
     * */
    fn readEntry(mut self, ref mut node: FlatNode, schema: &NodeSchema, key: Token, values: [Token])
        throws SyntaxError
    {
        if key.text == "parent" {
            node.parent = (self.readId(self.single(key, values), "the id of the parent, #<uuid>"))?;
            return;
        }

        let d = node.description;
        if d.kind == NodeKind::ACTOR && key.text.len > 3us && key.text[0us .. 3us] == "on-" {
            self:.readConnections(ref node, key, values);
            return;
        }

        let p = if let Ok(p) = schema.property(key.text) { p } else {
            if d.kind == NodeKind::ACTOR && !actorClass(d.className).hasValue && values.len != 0us {
                node.description.entries ~= [(key.text, self._scanner.source(values[0].start, values[$ - 1us].end))];
                return;
            }

            if self._lenient && d.kind == NodeKind::ACTOR {
                self._dropped ~= [self.foreign(node, key).msg];
                return;
            }

            throw self.foreign(node, key);
        };
        if p.kind == PropertyKind::ASSET {
            node.assets ~= [(p.name, self.asset(key, values))];
        } else {
            node.description:.set(p.name, self.readValue(p, key, values));
        }
    }

    /**
     * Read the connections of a signal of an actor, `on-pressed: #<id> open #<id> unlock;`, a signal its class has (any
     * signal for a class the program does not know)
     * */
    fn readConnections(mut self, ref mut node: FlatNode, key: Token, values: [Token])
        throws SyntaxError
    {
        let d = node.description;
        let signal = key.text[3us .. $];
        if let Ok(c) = actorClass(d.className) {
            if !c.signal(signal).hasValue {
                let msg = f"${d.typeName()} '${d.name}' has no signal '${signal}'";
                if self._lenient {
                    self._dropped ~= [msg];
                    return;
                }

                throw copy SyntaxError(msg, key.line, key.col);
            }
        }

        if values.len == 0us || values.len % 2us != 0us {
            throw copy SyntaxError(f"${key.text} must be the nodes and the slots it is connected to, #<uuid> <slot>", key.line, key.col);
        }

        for i in 0us .. values.len / 2us {
            let target = self.readId(values[2us * i], f"${key.text}, the id of a node, #<uuid>");
            let slot = values[2us * i + 1us];
            if slot.kind != TokenKind::IDENT {
                throw self._scanner.expected(slot, f"the name of a slot of the node #${target}");
            }

            node.description.connections ~= [NodeConnection(signal-> signal, target-> target, slot-> slot.text)];
            node.connectedAt ~= [(slot.line, slot.col)];
        }
    }

    /**
     * @returns: the value of an entry of a property, of the kind of the property, the angles of a property in degrees
     * read in radians
     * */
    fn readValue(self, p: &NodeProperty, key: Token, values: [Token])-> PropertyValue
        throws SyntaxError
    {
        match p.kind {
            PropertyKind::NUMBER => {
                let n = self.number(key, values);
                return PropertyValue::number(if p.degrees { radian(n) } else { n });
            }
            PropertyKind::VECTOR => { return PropertyValue::vector(self.angles(p, self.vector(key, values))); }
            PropertyKind::COLOR  => { return PropertyValue::color(self.vector(key, values)); }
            PropertyKind::BOOL   => { return PropertyValue::flag(self.boolean(key, values)); }
            PropertyKind::CHOICE => { return PropertyValue::choice(self.choice(p, key, values)); }
            PropertyKind::STRING => { return PropertyValue::text(self.string(key, values)); }
            PropertyKind::TEXTS  => { return PropertyValue::texts(self.strings(key, values)); }
            PropertyKind::NODE   => { return PropertyValue::node(self.readId(self.single(key, values), f"${key.text}, the id of a node, #<uuid>")); }
            PropertyKind::COUNT  => { return PropertyValue::count(self.count(key, values)); }
            PropertyKind::LAYERS => { return PropertyValue::layers(self.layers(key, values)); }
            _ => {}
        }

        PropertyValue::asset(self.asset(key, values))
    }

    /**
     * @returns: a vector, its components read in radians when the property holds angles in degrees
     * */
    fn angles(self, p: &NodeProperty, v: vec3)-> vec3 {
        if p.degrees { makeVec3(radian(v.x), radian(v.y), radian(v.z)) } else { v }
    }

    /**
     * @returns: the error of an entry the kind of a node does not have
     * */
    fn foreign(self, node: FlatNode, key: Token)-> &SyntaxError {
        copy SyntaxError(f"${node.description.typeName()} '${node.description.name}' has no entry '${key.text}'",
                         key.line, key.col)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          VALUES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the id of a token '#<uuid>'
     * @params:
     *    - what: what the id is, with its article, for the error
     * */
    fn readId(self, tok: Token, what: [c8])-> Uuid
        throws SyntaxError
    {
        if tok.kind == TokenKind::HASH {
            {
                let id = std::uuid::to!{Uuid} (tok.text);
                if !id.isNil() { return id; }
            } catch {
                _ => {}
            }
        }

        throw self._scanner.expected(tok, what);
    }

    /**
     * @returns: the one token of the value of an entry
     * */
    fn single(self, key: Token, values: [Token])-> Token
        throws SyntaxError
    {
        if values.len != 1us {
            throw copy SyntaxError(f"${key.text} takes one value", key.line, key.col);
        }

        values[0]
    }

    /**
     * @returns: the key of the asset of an entry, @<key>
     * */
    fn asset(self, key: Token, values: [Token])-> [c8]
        throws SyntaxError
    {
        let tok = self.single(key, values);
        if tok.kind != TokenKind::DIRECTIVE {
            throw copy SyntaxError(f"${key.text} must be an asset, @<key>", tok.line, tok.col);
        }

        tok.text
    }

    /**
     * @returns: the number of a token
     * */
    fn toNumber(self, key: Token, tok: Token)-> f32
        throws SyntaxError
    {
        if tok.kind == TokenKind::NUMBER && tok.unit == "" {
            {
                return std::conv::to!{f32} (tok.text);
            } catch {
                _ => {}
            }
        }

        throw copy SyntaxError(f"${key.text} must be a number, found '${self._scanner.source(tok.start, tok.end)}'", tok.line, tok.col);
    }

    /**
     * @returns: the value of an entry of one number
     * */
    fn number(self, key: Token, values: [Token])-> f32
        throws SyntaxError
    {
        self.toNumber(key, self.single(key, values))
    }

    /**
     * @returns: the value of an entry of one whole number, 0 or more
     * */
    fn count(self, key: Token, values: [Token])-> u32
        throws SyntaxError
    {
        let tok = self.single(key, values);
        let n = self.toNumber(key, tok);
        if n < 0.0f || n != cast!f32(cast!u32(n)) {
            throw copy SyntaxError(f"${key.text} must be a whole number, 0 or more", tok.line, tok.col);
        }

        cast!u32(n)
    }

    /**
     * @returns: the bits of the layers of an entry, the numbers of the layers from 0 to 31, or none
     * */
    fn layers(self, key: Token, values: [Token])-> u32
        throws SyntaxError
    {
        if values.len == 1us && values[0].kind == TokenKind::IDENT && values[0].text == "none" { return 0u32; }
        if values.len == 0us {
            throw copy SyntaxError(f"${key.text} must be the numbers of layers, 0 to 31, or none", key.line, key.col);
        }

        let mut bits = 0u32;
        for tok in values {
            let n = if tok.kind == TokenKind::NUMBER { self.toNumber(key, tok) } else { -1.0f };
            if n < 0.0f || n > 31.0f || n != cast!f32(cast!u32(n)) {
                throw copy SyntaxError(f"${key.text} must be the numbers of layers, 0 to 31, or none", tok.line, tok.col);
            }

            bits = bits | (1u32 << cast!u32(n));
        }

        bits
    }

    /**
     * @returns: the value of an entry of three numbers
     * */
    fn vector(self, key: Token, values: [Token])-> vec3
        throws SyntaxError
    {
        if values.len != 3us {
            throw copy SyntaxError(f"${key.text} must be three numbers", key.line, key.col);
        }

        makeVec3(self.toNumber(key, values[0]), self.toNumber(key, values[1]), self.toNumber(key, values[2]))
    }

    /**
     * @returns: the value of an entry of true or false
     * */
    fn boolean(self, key: Token, values: [Token])-> bool
        throws SyntaxError
    {
        let tok = self.single(key, values);
        if tok.kind == TokenKind::IDENT {
            match tok.text {
                "true"  => { return true; }
                "false" => { return false; }
            }
        }

        throw copy SyntaxError(f"${key.text} must be true or false", tok.line, tok.col);
    }

    /**
     * @returns: the name of the choice of an entry, one of the choices of its property
     * */
    fn choice(self, p: &NodeProperty, key: Token, values: [Token])-> [c8]
        throws SyntaxError
    {
        let tok = self.single(key, values);
        if tok.kind == TokenKind::IDENT && p.choiceIndex(tok.text).hasValue {
            return tok.text;
        }

        throw copy SyntaxError(f"${key.text} must be ${SceneReader::alternatives(p.choices)}", tok.line, tok.col);
    }

    /**
     * @returns: the value of an entry of one string
     * */
    fn string(self, key: Token, values: [Token])-> [c8]
        throws SyntaxError
    {
        let tok = self.single(key, values);
        if tok.kind != TokenKind::STRING {
            throw copy SyntaxError(f"${key.text} must be a string", tok.line, tok.col);
        }

        tok.text
    }

    /**
     * @returns: the values of an entry of strings, none of them empty
     * */
    fn strings(self, key: Token, values: [Token])-> [[c8]]
        throws SyntaxError
    {
        let mut texts: [[c8]] = [];
        for tok in values {
            if tok.kind != TokenKind::STRING || tok.text.len == 0us {
                throw copy SyntaxError(f"${key.text} must be strings, none of them empty", tok.line, tok.col);
            }

            texts ~= [tok.text];
        }

        texts
    }

}

/**
 * A node as its block of a scene file gives it, before the nodes are put under their parents
 * */
record FlatNode {

    // The node, without its children
    pub let mut description: NodeDescription;

    // The id of its parent, none for a node under the root
    pub let mut parent: (Uuid)?;

    // The properties of the kind ASSET the block gives, each with the key of the asset it names
    pub let mut assets: [([c8], [c8])];

    // The place of the block, quoted in the errors
    pub let mut line: usize;
    pub let mut col: usize;

    // The place of the slot of each connection of the description, quoted in the errors
    pub let mut connectedAt: [(usize, usize)];

    pub self (description: NodeDescription, line: usize, col: usize)
        with description = description
        , parent = none
        , assets = []
        , line = line
        , col = col
        , connectedAt = []
    {}

}

/**
 * An asset of a scene file, a file its nodes name by its key
 * */
record Asset {

    // The key the nodes name it by, after a '@'
    pub let key: [c8];

    // The project path of the file
    pub let path: [c8];

    pub self (key: [c8], path: [c8])
        with key = key
        , path = path
    {}

}

/**
 * The assembly of the nodes a SceneReader read, once every block of the file is read
 * */
@companion
mod SceneReader {

    /**
     * Check that a node gives the properties its kind requires while they apply, and no asset it does not read
     * @params:
     *    - schema: the schema of the kind of the node
     *    - given: the names of the entries of its block
     * @throws:
     *    - &SyntaxError: at the block, if it lacks a property its kind requires (the file of a model), or gives an asset
     *                    it does not read (the model of a body of a box)
     * */
    pub fn checkGiven(node: FlatNode, schema: &NodeSchema, given: [[c8]])
        throws SyntaxError
    {
        let d = node.description;
        let what = f"${d.typeName()} '${d.name}'";
        for p in schema.properties {
            let mut isGiven = false;
            for g in given if g == p.name { isGiven = true; }

            let applies = d.applies(p);
            let shaped = if let Ok(c) = p.condition { f" of ${SceneReader::article(d.value(c.property).text)} ${c.property}" } else { "" };
            if p.required && applies && !isGiven {
                throw copy SyntaxError(f"${what}${shaped} without a ${p.name}", node.line, node.col);
            }

            if p.kind == PropertyKind::ASSET && isGiven && !applies {
                if let Ok(c) = p.condition {
                    throw copy SyntaxError(f"${what}${shaped} given a ${p.name}, which only ${SceneReader::either(c.choices)} reads",
                                           node.line, node.col);
                }
            }
        }
    }

    /**
     * @returns: the nodes, each property of the kind ASSET given the path of the asset it names
     * @throws:
     *    - &SyntaxError: if a node names an asset not declared
     * */
    pub fn resolveAssets(nodes: [FlatNode], assets: [Asset])-> [FlatNode]
        throws SyntaxError
    {
        let mut resolved: [FlatNode] = [];
        for n in nodes {
            let mut r = n;
            for named in n.assets {
                let mut found = false;
                for a in assets if a.key == named._1 {
                    r.description:.set(named._0, PropertyValue::asset(a.path));
                    found = true;
                }

                if !found {
                    throw copy SyntaxError(f"${n.description.typeName()} '${n.description.name}' names the asset '${named._1}', not declared", n.line, n.col);
                }
            }

            resolved = resolved ~ [r];
        }

        resolved
    }

    /**
     * Check that one node at most of each kind has each of its unique properties true: one active camera
     * @throws:
     *    - &SyntaxError: at the second node having one
     * */
    pub fn checkUnique(nodes: [FlatNode])
        throws SyntaxError
    {
        let dmut first: [[c8] => [c8]] = copy [];
        for n in nodes {
            let kind = n.description.typeName();
            for p in n.description.schema().properties if p.unique && n.description.value(p.name).flag {
                let key = f"${kind} ${p.name}";
                if let Ok(other) = first[key] {
                    throw copy SyntaxError(f"${kind} '${n.description.name}' is ${p.name}, and so is ${kind} '${other}': one ${kind} of a scene at most is ${p.name}",
                                           n.line, n.col);
                }

                first[key] = dcopy n.description.name;
            }
        }
    }

    /**
     * Check that the connections of the actors name nodes of the file, by slots they have taking the payloads of their
     * signals; a node of a class the program does not know is taken to have every slot, and its signals every payload
     * @throws:
     *    - &SyntaxError: at the slot of the first connection naming a node not in the file, a slot its node does not
     *                    have, or a slot not taking the payload of its signal
     * */
    pub fn checkConnections(nodes: [FlatNode])
        throws SyntaxError
    {
        let index = SceneReader::indexOf(nodes);
        for n in nodes {
            for i in 0us .. n.description.connections.len {
                if let Ok(err) = SceneReader::connectionError(nodes, index, n, i) { throw err; }
            }
        }
    }

    /**
     * @returns: the nodes without their connections that checkConnections refuses, and what was dropped, a connection
     * each, for a lenient reader
     * */
    pub fn withoutBrokenConnections(nodes: [FlatNode])-> ([FlatNode], [[c8]]) {
        let index = SceneReader::indexOf(nodes);
        let mut res: [FlatNode] = [];
        let mut dropped: [[c8]] = [];
        for n in nodes {
            let mut kept = n;
            kept.description.connections = [];
            kept.connectedAt = [];
            for i, c in n.description.connections {
                if let Ok(err) = SceneReader::connectionError(nodes, index, n, i) {
                    dropped ~= [err.msg];
                } else {
                    kept.description.connections ~= [c];
                    kept.connectedAt ~= [n.connectedAt[i]];
                }
            }

            res ~= [kept];
        }

        (res, dropped)
    }

    /**
     * @returns: the indexes of the nodes by their ids
     * */
    pub fn indexOf(nodes: [FlatNode])-> [Uuid => usize] {
        let dmut index: [Uuid => usize] = copy [];
        for i, n in nodes { index[n.description.id] = i; }
        index
    }

    /**
     * @returns: why a connection of a node is refused (see checkConnections), at its slot, none when it is not
     * @params:
     *    - index: the indexes of the nodes by their ids
     *    - i: the index of the connection among those of the node
     * */
    pub fn connectionError(nodes: [FlatNode], index: [Uuid => usize], n: FlatNode, i: usize)-> (&SyntaxError)? {
        let d = n.description;
        let c = d.connections[i];
        let at = n.connectedAt[i];
        let what = f"${d.typeName()} '${d.name}'";
        let t = if let Ok(j) = index[c.target] { nodes[j].description } else {
            return (copy SyntaxError(f"${what} connects ${c.signal} to #${c.target}, no node of the file", at._0, at._1))?;
        };

        let target = f"${t.typeName()} '${t.name}'";
        if t.kind != NodeKind::ACTOR {
            return (copy SyntaxError(f"${what} connects ${c.signal} to ${target}, which has no slot", at._0, at._1))?;
        }

        if let Ok(tc) = actorClass(t.className) {
            let slot = if let Ok(s) = tc.slot(c.slot) { s } else {
                return (copy SyntaxError(f"${what} connects ${c.signal} to ${target}, which has no slot '${c.slot}'", at._0, at._1))?;
            };

            if let Ok(sc) = actorClass(d.className) {
                if let Ok(signal) = sc.signal(c.signal) {
                    if !sameTypes(signal.payload, slot.params) {
                        return (copy SyntaxError(f"${what} connects ${c.signal}, which gives ${signature(signal.payload)}, to the slot '${c.slot}' of ${target}, which takes ${signature(slot.params)}",
                                                 at._0, at._1))?;
                    }
                }
            }
        }

        none
    }

    /**
     * Put each node under its parent
     * @returns: the nodes under the root, in the order of the file, each with the nodes under it in that order
     * @throws:
     *    - &SyntaxError: if two nodes have the same id, a node names a parent that is not in the file, or a node is under
     *                    itself
     * */
    pub fn assemble(nodes: [FlatNode])-> [NodeDescription]
        throws SyntaxError
    {
        let dmut index: [Uuid => usize] = copy [];
        for i, n in nodes {
            if index[n.description.id].hasValue {
                throw copy SyntaxError(f"id #${n.description.id} given to two nodes", n.line, n.col);
            }

            index[n.description.id] = i;
        }

        let dmut children: [usize => [usize]] = copy [];
        let mut roots: [usize] = [];
        for i, n in nodes {
            if let Ok(p) = n.parent {
                if let Ok(j) = index[p] {
                    children[j] = SceneReader::under(children, j) ~ [i];
                } else {
                    throw copy SyntaxError(f"${n.description.typeName()} '${n.description.name}' is under #${p}, no node of the file", n.line, n.col);
                }
            } else {
                roots = roots ~ [i];
            }
        }

        let mut placed = 0us;
        let mut tree: [NodeDescription] = [];
        for r in roots {
            tree = tree ~ [SceneReader::build(nodes, children, r, ref placed)];
        }

        if placed != nodes.len {
            for i, n in nodes if !SceneReader::isPlaced(children, roots, i) {
                throw copy SyntaxError(f"${n.description.typeName()} '${n.description.name}' is under itself", n.line, n.col);
            }
        }

        tree
    }

    /**
     * @returns: the description of a node with the nodes under it
     * @params:
     *    - placed: the number of nodes put in the tree, increased by those of this one
     * */
    pub fn build(nodes: [FlatNode], children: [usize => [usize]], i: usize, ref mut placed: usize)-> NodeDescription {
        placed += 1us;
        let mut d = nodes[i].description;
        let mut under: [NodeDescription] = [];
        for c in SceneReader::under(children, i) {
            under = under ~ [SceneReader::build(nodes, children, c, ref placed)];
        }

        d.children = under;
        d
    }

    /**
     * @returns: the indices of the nodes under a node, in the order of the file
     * */
    pub fn under(children: [usize => [usize]], i: usize)-> [usize] {
        if let Ok(c) = children[i] { c } else { [] }
    }

    /**
     * @returns: true iif a node is a root or under one
     * */
    pub fn isPlaced(children: [usize => [usize]], roots: [usize], i: usize)-> bool {
        let mut stack = roots;
        while stack.len != 0us {
            let top = stack[$ - 1us];
            stack = stack[0us .. $ - 1us];
            if top == i { return true; }
            stack = stack ~ SceneReader::under(children, top);
        }

        false
    }

    /**
     * @returns: the names of choices, the last after an "or": `direction, point or spot`
     * */
    pub fn alternatives(choices: [Choice])-> [c8] {
        let mut text = "";
        for i, c in choices {
            let sep = if i == 0us { "" } else if i + 1us == choices.len { " or " } else { ", " };
            text = text ~ sep ~ c.name;
        }

        text
    }

    /**
     * @returns: names after their article, the last after an "or": `a hull or a mesh`
     * */
    pub fn either(names: [[c8]])-> [c8] {
        let mut text = "";
        for i, n in names {
            let sep = if i == 0us { "" } else if i + 1us == names.len { " or " } else { ", " };
            text = text ~ sep ~ SceneReader::article(n);
        }

        text
    }

    /**
     * @returns: a name after its article, `a box`, `an orthographic`
     * */
    pub fn article(name: [c8])-> [c8] {
        if name.len != 0us {
            match name[0] {
                'a' | 'e' | 'i' | 'o' | 'u' => { return "an " ~ name; }
            }
        }

        "a " ~ name
    }
}
