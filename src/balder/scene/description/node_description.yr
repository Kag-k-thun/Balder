in node_description;

use balder::core::error;
use balder::scene::physics;
use balder::scene::actors::{node_classes, node_connection, unknown_actor};
use balder::scene::asset::assets;
use balder::scene::description::kind;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{body, body_shape, camera, character, empty, light, marker, mesh_instance, path, path_point, volume};
use balder::scene::property::{node_property, node_schema, value};

use std::uuid;

/**
 * A node of a scene, as a scene file describes it: its id, its kind, its name, the values of the properties of its kind,
 * and the nodes under it
 * @info:
 * =====
 * A node is a block of a scene file, naming its parent by its id (see SceneDescription for the file), each entry the
 * value of a property of the schema of its kind (see schemaOf, NodeSchema):
 * ```
 * node #3f2a9c41-1b2c-4d3e-8f00-6a5b4c3d2e1f mesh "top" {
 *     parent: #9c41e2a0-51be-4c2d-9e3f-0a1b2c3d4e5f;   // none for a node under the root
 *     position: 0 1 0;                                 // in the space of the parent
 *     rotation: 0 90 0;                                // in degrees, along the X, the Y and the Z axes
 *     scale: 1 1 1;
 *     mesh: @cube;                                     // the mesh asset drawn
 *     materials: #5d1e0c2a-7b3f-4a9e-8c21-0f6e5d4c3b2a; // the material of each part, none for the part's own
 * }
 * ```
 * The kind is empty, mesh, light, marker, path, path-point, volume, body, character or camera, or the type of an actor
 * class (see ActorClass), whose entries are its properties and the connections of its signals, `on-pressed: #<id> open;`.
 * Every node reads parent, then the properties of its schema: every one its transform (position, rotation, scale), a
 * mesh its mesh (required), its materials, lods and shadows (MeshInstance3D::schema), a light, a marker, a path, a
 * volume, a body, a character and a camera theirs (Light::schema...). A description holds a
 * value for every property of its kind, the default of the schema until it is given another one.
 * ====
 * */
pub record NodeDescription {

    // The id of the node in the scene files (see Node3D.guid), nil for a node the scene files do not know yet, which
    // keeps the id it is created with
    pub let mut id: Uuid = Uuid::nil();

    // The name of the node, among the children of its parent
    pub let mut name: [c8];

    // What the node is
    pub let mut kind: NodeKind;

    // The actor class of a node of the kind ACTOR, its type in the scene files, empty for the other kinds
    pub let mut className: [c8] = "";

    // The connections of the signals of an actor to the slots of other nodes (see NodeConnection)
    pub let mut connections: [NodeConnection] = [];

    // The entries of an actor of a class the program does not know, other than its transform and its connections, their
    // names and the text of their values, written back as they are (see UnknownActor)
    pub let mut entries: [([c8], [c8])] = [];

    // The value of each property of the schema of the kind, by its name, in the order of the schema
    let mut _values: [([c8], PropertyValue)] = [];

    // The nodes under the node, in order
    pub let mut children: [NodeDescription] = [];

    /**
     * A node of a kind, at the origin of its parent, its properties holding the defaults of its schema
     * */
    pub self (name: [c8], kind: NodeKind)
        with name = name
        , kind = kind
    {
        for p in schemaOf(kind).properties {
            self._values ~= [(p.name, p.defaultValue)];
        }
    }

    /**
     * A node of an actor class, at the origin of its parent, its properties holding the defaults of the schema of the
     * class (see ActorClass), its transform only for a class the program does not know
     * @params:
     *    - className: the name of the class, the type of the node in the scene files
     * */
    pub self actor(name: [c8], className: [c8])
        with name = name
        , kind = NodeKind::ACTOR
        , className = className
    {
        for p in schemaOfClass(NodeKind::ACTOR, className).properties {
            self._values ~= [(p.name, p.defaultValue)];
        }
    }

    /**
     * The description of a node of a scene, and of the nodes under it, as a scene file saves it, each property read
     * from the node (see NodeProperty::get)
     * @info: the nodes named __…__ are left out (see isReservedName), the meshes drawing the parts of a mesh node among
     * them; the nodes under a node are in their order (see Node::getChildrenInOrder), the order a scene file builds them
     * in
     * @throws:
     *    - &BalderError: if no scene file describes the node, or a node under it (see kindOf)
     * */
    pub self (dmut node: &Node3D)
        with id = node.guid
        , name = node.name.file()
        , kind = NodeKind::EMPTY
        throws BalderError
    {
        self.kind = kindOf(node);
        if let u: &UnknownActor = node {
            self.className = u.className;
            self.entries = u.entries;
        } else if let Ok(c) = actorClassOf(node) {
            self.className = c.name;
        }

        self.connections = node.connections;
        for p in self.schema().properties {
            self._values ~= [(p.name, p.get(alias node))];
        }

        for dmut c in alias node:.getChildrenInOrder() if !isReservedName(c.name.file()) {
            if let dmut n: &Node3D = alias c {
                self.children = self.children ~ [NodeDescription(alias n)];
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          VALUES          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the schema of the kind of the node
     * */
    pub fn schema(self)-> &NodeSchema {
        schemaOfClass(self.kind, self.className)
    }

    /**
     * @returns: the type of the node in the scene files, the name of its kind, or of its class for an actor
     * */
    pub fn typeName(self)-> [c8] {
        typeName(self.kind, self.className)
    }

    /**
     * @returns: the value of a property of the node, the number 0 for a name no property of its kind has
     * */
    pub fn value(self, name: [c8])-> PropertyValue {
        for v in self._values if v._0 == name { return v._1; }
        PropertyValue()
    }

    /**
     * Give a property of the node a value
     * @params:
     *    - name: the name of a property of the schema of its kind
     *    - value: a value of the kind of the property
     * */
    pub fn set(mut self, name: [c8], value: PropertyValue) {
        let mut values: [([c8], PropertyValue)] = [];
        let mut found = false;
        for v in self._values {
            if v._0 == name {
                values ~= [(name, value)];
                found = true;
            } else {
                values ~= [v];
            }
        }

        if !found { values ~= [(name, value)]; }
        self._values = values;
    }

    /**
     * @returns: true iif a property applies to the node, the property it depends on having one of its choices (see
     * NodeProperty.condition)
     * */
    pub fn applies(self, p: &NodeProperty)-> bool {
        if let Ok(c) = p.condition {
            return NodeSchema::holds(c, self.value(c.property));
        }

        true
    }

    /**
     * @returns: true iif two descriptions are of the same id, name and kind, their properties hold the same values, and
     * the nodes under them are the same
     * */
    pub fn opEquals(self, other: NodeDescription)-> bool {
        if self.id.opCmp(other.id) != 0 || self.name != other.name || self.kind != other.kind { return false; }
        if self.className != other.className || !sameConnections(self.connections, other.connections) || !sameEntries(self.entries, other.entries) { return false; }
        if self._values.len != other._values.len || self.children.len != other.children.len { return false; }
        for v in self._values {
            if !(other.value(v._0) == v._1) { return false; }
        }

        for i, c in self.children {
            if !(c == other.children[i]) { return false; }
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BUILD          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the node under a parent, give it the values of the properties a node takes once created (see
     * NodeProperty::settable), then create the nodes under it, the node taking the id of the description unless it is
     * nil
     * @returns: the node created
     * @info: a body of a hull or a mesh reads its model, a body of a compound takes the volumes under it once they are
     * built (see PhysicsBody3D::reshape); an active camera becomes the active camera of the scene of the parent
     * @throws:
     *    - &BalderError: if the mesh or a material of a mesh node cannot be loaded, or a compound has no volume under its
     *                    body
     * */
    pub fn build(self, dmut parent: &Node)-> dmut &Node3D
        throws BalderError
    {
        let dmut node = alias self.create(alias parent);
        for p in self.schema().properties if p.settable() {
            p.set(alias node, self.value(p.name));
        }

        if !self.id.isNil() {
            node.guid = self.id;
        }

        node.connections = self.connections;

        for c in self.children {
            c.build(alias node);
        }

        if self.kind == NodeKind::BODY {
            let shape = self.bodyShape();
            if !shape.isPrimitive {
                if let dmut b: &PhysicsBody3D = alias node {
                    b:.reshape(shape);
                }
            }
        }

        alias node
    }

    /**
     * @returns: the node of the kind of the description, under a parent, given the values of the properties a node
     * takes at its creation only, its own nodes not created yet
     * */
    fn create(self, dmut parent: &Node)-> dmut &Node3D
        throws BalderError
    {
        match self.kind {
            NodeKind::MESH => {
                return copy MeshInstance3D(self.name, alias parent,
                                           alias Assets::mesh(self.value("mesh").text, lods-> self.value("lods").flag),
                                           materials-> MeshInstance3D::materialsOf(self.value("materials").texts),
                                           shadow-> self.value("shadows").flag);
            }
            NodeKind::LIGHT      => { return copy Light(self.name, alias parent, castShadow-> self.value("shadows").flag); }
            NodeKind::MARKER     => { return copy Marker3D(self.name, alias parent); }
            NodeKind::PATH       => { return copy Path3D(self.name, alias parent); }
            NodeKind::PATH_POINT => { return copy PathPoint3D(self.name, alias parent); }
            NodeKind::VOLUME     => { return copy Volume3D(self.name, alias parent); }
            NodeKind::BODY       => { return alias self.createBody(alias parent); }
            NodeKind::CHARACTER  => {
                return copy CharacterBody3D(self.name, alias parent, radius-> self.value("radius").number,
                                            height-> self.value("height").number);
            }
            NodeKind::CAMERA => {
                if self.value("projection").text == "orthographic" {
                    return copy OrthoCamera(self.name, alias parent);
                }

                return copy PerspectiveCamera(self.name, alias parent);
            }
            NodeKind::ACTOR => {
                if let Ok(c) = actorClass(self.className) {
                    return alias c.create(self.name, alias parent);
                }

                return copy UnknownActor(self.name, alias parent, self.className, self.entries);
            }
            _ => {}
        }

        copy Empty3D(self.name, alias parent)
    }

    /**
     * @returns: the shape of a body its properties give
     * */
    fn bodyShape(self)-> BodyShape {
        BodyShape(shapeNamed(self.value("shape").text), self.value("size").vector, self.value("radius").number,
                  self.value("height").number, model-> self.value("model").text)
    }

    /**
     * @returns: a body of the shape of the description, under a parent, a hull, a mesh and a compound reshaped once the
     * nodes under the body are built (see build)
     * */
    fn createBody(self, dmut parent: &Node)-> dmut &Node3D {
        let shape = self.bodyShape();
        let collider = if let Ok(c) = shape.collider() { c } else { ColliderShape() };
        let dmut b = copy PhysicsBody3D(self.name, alias parent, shape-> collider);
        if shape.isPrimitive {
            // the sizes of the description kept, those of its kind only being read
            b:.setDescribedShape(collider, shape?);
        }

        alias b
    }

}

/**
 * @returns: true iif two lists of connections are the same, in the same order
 * */
fn sameConnections(a: [NodeConnection], b: [NodeConnection])-> bool {
    if a.len != b.len { return false; }
    for i, c in a {
        if c.signal != b[i].signal || c.slot != b[i].slot || c.target.opCmp(b[i].target) != 0 { return false; }
    }

    true
}

/**
 * @returns: true iif two lists of entries kept as their text are the same, in the same order
 * */
fn sameEntries(a: [([c8], [c8])], b: [([c8], [c8])])-> bool {
    if a.len != b.len { return false; }
    for i, e in a {
        if e._0 != b[i]._0 || e._1 != b[i]._1 { return false; }
    }

    true
}
