in node_description;

use balder::core::error;
use balder::math::vector;
use balder::scene::description::kind;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{empty, light, solid};
use balder::scene::node::node3D::visual::{_, material::_};

use std::uuid;

/**
 * A node of a scene, as a scene file describes it: its id, its kind, its name, its transform, what its kind draws or
 * shines, and the nodes under it
 * @info:
 * =====
 * A node is a block of a scene file, naming its parent by its id (see SceneDescription for the file):
 * ```
 * node #3f2a9c41-1b2c-4d3e-8f00-6a5b4c3d2e1f cube "top" {
 *     parent: #9c41e2a0-51be-4c2d-9e3f-0a1b2c3d4e5f;   // none for a node under the root
 *     position: 0 1 0;                                 // in the space of the parent
 *     rotation: 0 90 0;                                // in degrees, along the X, the Y and the Z axes
 *     scale: 1 1 1;
 *     color: 0.5 0.3 0.1;                              // the base colour of a cube, a sphere or a plane
 *     roughness: 0.6;
 *     metallic: 0;
 * }
 * ```
 * The kind is empty, model, cube, sphere, plane or light. Every node reads parent, position, rotation and scale; a
 * model reads file (an asset of the file, @<key>, required) and lods (true or false); a cube, a sphere and a plane
 * read color, roughness and metallic; a light reads light (direction, point or spot), color, intensity, direction,
 * range, inner-angle, outer-angle (in degrees) and shadows. Every entry is optional, an entry absent keeping the
 * default of the description.
 * ====
 * */
pub record NodeDescription {

    // The id of the node in the scene files (see Node3D.guid), nil for a node the scene files do not know yet, which
    // keeps the id it is created with
    pub let mut id: Uuid = Uuid::nil();

    // The name of the node, among the children of its parent
    pub let mut name: [c8];

    // What the node is
    pub let mut kind: NodeKind;

    // The position of the node, in the space of its parent
    pub let mut position: vec3 = vec3();

    // The angles of the rotation of the node along the X, the Y and the Z axes, in radian
    pub let mut rotation: vec3 = vec3();

    // The scale of the node along its own axes
    pub let mut scale: vec3 = makeVec3(1.0f, 1.0f, 1.0f);

    // The project path of the file of a model
    pub let mut file: [c8] = "";

    // True to build the levels of detail of the meshes of a model
    pub let mut lods: bool = true;

    // The material of a cube, a sphere or a plane
    pub let mut material: MaterialConfig = MaterialConfig();

    // The type of a light
    pub let mut light: LightType = LightType::DIRECTION;

    // The colour of a light
    pub let mut color: vec3 = makeVec3(1.0f, 1.0f, 1.0f);

    // The power of a light (see Light::intensity)
    pub let mut intensity: f32 = 1.0f;

    // The direction a direction or a spot light shines along
    pub let mut direction: vec3 = makeVec3(0.0f, -1.0f, 0.0f);

    // The distance at which the light of a point or a spot light fades out
    pub let mut range: f32 = 10.0f;

    // The angles between the axis of the cone of a spot light and the edges of its full light and of its light, in
    // degrees
    pub let mut innerAngle: f32 = 20.0f;
    pub let mut outerAngle: f32 = 30.0f;

    // True when a light casts shadows
    pub let mut shadows: bool = false;

    // The nodes under the node, in order
    pub let mut children: [NodeDescription] = [];

    /**
     * A node of a kind, at the origin of its parent, of the defaults of its kind
     * */
    pub self (name: [c8], kind: NodeKind)
        with name = name
        , kind = kind
    {}

    /**
     * The description of a node of a scene, and of the nodes under it, as a scene file saves it
     * @info: the nodes named __…__ are left out (see isReservedName), and so are the meshes of a model, which its file
     * gives; the nodes under a node are in their order (see Node::getChildrenInOrder), the order a scene file builds them
     * in
     * @params:
     *    - node: an empty, a model, a cube, a sphere or a plane (a mesh made of a primitive, see MeshGeometry.primitive),
     *            or a light
     * @throws:
     *    - &BalderError: if the node, or a node under it, is of none of these kinds
     * */
    pub self (dmut node: &Node3D)
        with id = node.guid
        , name = node.name.file()
        , kind = NodeKind::EMPTY
        , position = node.position
        , rotation = node.rotation
        , scale = node.scale
        throws BalderError
    {
        match node {
            l: &Light => {
                self.kind = NodeKind::LIGHT;
                self.light = l.type;
                self.color = l.color;
                self.intensity = l.intensity;
                self.direction = l.direction;
                self.range = l.range;
                self.innerAngle = l.innerAngle;
                self.outerAngle = l.outerAngle;
                self.shadows = l.castShadow;
            }
            m: &SolidObjectModel => {
                self.kind = NodeKind::MODEL;
                self.file = m.file;
                self.lods = m.lods;
                return;
            }
            _: &Empty3D => {}
            _ => {
                if let dmut mesh: &IndexedMesh3D = alias node {
                    self.kind = match mesh.mesh.primitive {
                        Primitive::CUBE   => { NodeKind::CUBE }
                        Primitive::SPHERE => { NodeKind::SPHERE }
                        Primitive::PLANE  => { NodeKind::PLANE }
                        _ => {
                            throw copy BalderError(f"${node.name.toStr()}: a mesh given its vertices, which no scene file describes");
                        }
                    };

                    self.material = mesh.material.config;
                } else {
                    throw copy BalderError(f"${node.name.toStr()}: a node of a kind no scene file describes");
                }
            }
        }

        for dmut c in alias node:.getChildrenInOrder() if !isReservedName(c.name.file()) {
            if let dmut n: &Node3D = alias c {
                self.children = self.children ~ [NodeDescription(alias n)];
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BUILD          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the node under a parent, then the nodes under it, the node taking the id of the description unless it is nil
     * @returns: the node created
     * @throws:
     *    - &BalderError: if the file of a model cannot be loaded
     * */
    pub fn build(self, dmut parent: &Node)-> dmut &Node3D
        throws BalderError
    {
        let dmut node = alias self.create(alias parent);
        node:.setTransform(self.position, self.rotation, self.scale);
        if !self.id.isNil() {
            node.guid = self.id;
        }

        for c in self.children {
            c.build(alias node);
        }

        alias node
    }

    /**
     * @returns: the node of the kind of the description, under a parent, its own nodes not created yet
     * */
    fn create(self, dmut parent: &Node)-> dmut &Node3D
        throws BalderError
    {
        if self.kind == NodeKind::EMPTY {
            return copy Empty3D(self.name, alias parent);
        }

        if self.kind == NodeKind::MODEL {
            return copy SolidObjectModel::fromFile(self.name, alias parent, self.file, lods-> self.lods);
        }

        if self.kind == NodeKind::CUBE {
            return alias self.createMesh(alias parent, Primitive::CUBE, cubeMesh());
        }

        if self.kind == NodeKind::SPHERE {
            return alias self.createMesh(alias parent, Primitive::SPHERE, sphereMesh());
        }

        if self.kind == NodeKind::PLANE {
            return alias self.createMesh(alias parent, Primitive::PLANE, planeMesh());
        }

        let dmut l = copy Light(self.name, alias parent, castShadow-> self.shadows);
        l.type = self.light;
        l.color = self.color;
        l.intensity = self.intensity;
        l.direction = self.direction;
        l.range = self.range;
        l.innerAngle = self.innerAngle;
        l.outerAngle = self.outerAngle;
        alias l
    }

    /**
     * @returns: a mesh drawing a primitive with the material of the description, under a parent
     * */
    fn createMesh(self, dmut parent: &Node, primitive: Primitive, mesh: (MeshArray, [u32]))-> dmut &Node3D
        throws BalderError
    {
        let dmut material = copy ConstantMaterial(self.material);
        copy IndexedMesh3D(self.name, alias parent, LodChain(mesh._1), mesh._0, alias material, primitive-> primitive)
    }

}

/**
 * @returns: true iif a name is of the form __…__, reserved for the nodes of the tools (the camera of the editor, its
 * gizmo...), which the scene files leave out
 * */
pub fn isReservedName(name: [c8])-> bool {
    name.len >= 4us && name[0us .. 2us] == "__" && name[$ - 2us .. $] == "__"
}
