in node_description;

use balder::core::error;
use balder::math::{curve, vector};
use balder::scene::physics;
use balder::scene::description::kind;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{body, body_shape, character, empty, light, marker, path, path_point, solid, volume, volume_shape};
use balder::scene::node::node3D::visual::{_, material::_};

use std::uuid;

/**
 * The radius and the height of the capsule of a character a description gives by default (see CharacterBody3D)
 * */
pub def CHARACTER_RADIUS = 0.4f;
pub def CHARACTER_HEIGHT = 1.8f;

/**
 * A node of a scene, as a scene file describes it: its id, its kind, its name, its transform, what its kind draws or
 * shines, and the nodes under it
 * @info:
 * =====
 * A node is a block of a scene file, naming its parent by its id (see SceneDescription for the file):
 * ```
 * node #3f2a9c41-1b2c-4d3e-8f00-6a5b4c3d2e1f cube "top" {
 *     parent: #9c41e2a0-51be-4c2d-9e3f-0a1b2c3d4e5f;   // none for a node under the root
 *     position: 0 1 0;                                 // in the space of the parent
 *     rotation: 0 90 0;                                // in degrees, along the X, the Y and the Z axes
 *     scale: 1 1 1;
 *     color: 0.5 0.3 0.1;                              // the base colour of a cube, a sphere or a plane
 *     roughness: 0.6;
 *     metallic: 0;
 * }
 * ```
 * The kind is empty, model, cube, sphere, plane, light, marker, path, path-point or volume. Every node reads parent,
 * position, rotation and scale; a model reads file (an asset of the file, @<key>, required) and lods (true or false);
 * a cube, a sphere and a plane read color, roughness and metallic; a light reads light (direction, point or spot),
 * color, intensity, direction, range, inner-angle, outer-angle (in degrees) and shadows; a marker reads purpose
 * (generic, spawn, waypoint or socket) and tags (strings); a path reads curve (catmull-rom or bezier) and closed (true
 * or false), its points being the path-point nodes under it; a volume reads shape (box, sphere or capsule), size (of a
 * box), radius (of a sphere or a capsule) and height (of a capsule); a body reads shape (box, sphere, capsule, cylinder,
 * plane, hull, mesh or compound), size, radius, height, model (the asset of the model of a hull or a mesh, @<key>,
 * required by them), motion (static, kinematic or dynamic), mass, friction, rolling-friction, spinning-friction,
 * restitution, linear-damping, angular-damping, can-sleep, bullet, trigger, layer and mask (the numbers of the layers,
 * 0 to 31, or none); a character reads radius, height, up, slope-limit (in degrees), step-offset, snap-distance, skin,
 * coyote-time, push-mass, max-slides, depenetrations, layer and mask. Every entry is optional, an entry absent keeping
 * the default of the description.
 * ====
 * */
pub record NodeDescription {

    // The id of the node in the scene files (see Node3D.guid), nil for a node the scene files do not know yet, which
    // keeps the id it is created with
    pub let mut id: Uuid = Uuid::nil();

    // The name of the node, among the children of its parent
    pub let mut name: [c8];

    // What the node is
    pub let mut kind: NodeKind;

    // The position of the node, in the space of its parent
    pub let mut position: vec3 = vec3();

    // The angles of the rotation of the node along the X, the Y and the Z axes, in radian
    pub let mut rotation: vec3 = vec3();

    // The scale of the node along its own axes
    pub let mut scale: vec3 = makeVec3(1.0f, 1.0f, 1.0f);

    // The project path of the file of a model
    pub let mut file: [c8] = "";

    // True to build the levels of detail of the meshes of a model
    pub let mut lods: bool = true;

    // The material of a cube, a sphere or a plane
    pub let mut material: MaterialConfig = MaterialConfig();

    // The type of a light
    pub let mut light: LightType = LightType::DIRECTION;

    // The colour of a light
    pub let mut color: vec3 = makeVec3(1.0f, 1.0f, 1.0f);

    // The power of a light (see Light::intensity)
    pub let mut intensity: f32 = 1.0f;

    // The direction a direction or a spot light shines along
    pub let mut direction: vec3 = makeVec3(0.0f, -1.0f, 0.0f);

    // The distance at which the light of a point or a spot light fades out
    pub let mut range: f32 = 10.0f;

    // The angles between the axis of the cone of a spot light and the edges of its full light and of its light, in
    // degrees
    pub let mut innerAngle: f32 = 20.0f;
    pub let mut outerAngle: f32 = 30.0f;

    // True when a light casts shadows
    pub let mut shadows: bool = false;

    // What a marker marks
    pub let mut purpose: MarkerPurpose = MarkerPurpose::GENERIC;

    // The tags a marker is looked up by
    pub let mut tags: [[c8]] = [];

    // How the curve of a path goes from a point to the next
    pub let mut curve: CurveKind = CurveKind::CATMULL_ROM;

    // True when the curve of a path goes back from its last point to its first
    pub let mut closed: bool = false;

    // The shape of a volume
    pub let mut volume: VolumeShape = VolumeShape();

    // The shape of a body, the capsule of a character
    pub let mut shape: BodyShape = BodyShape();

    // How a body takes part in the physics of its scene, the layers and the mask of a character
    pub let mut body: BodySettings = BodySettings();

    // How a character moves
    pub let mut character: CharacterSettings = CharacterSettings();

    // The nodes under the node, in order
    pub let mut children: [NodeDescription] = [];

    /**
     * A node of a kind, at the origin of its parent, of the defaults of its kind
     * */
    pub self (name: [c8], kind: NodeKind)
        with name = name
        , kind = kind
    {
        if kind == NodeKind::CHARACTER {
            self.shape = BodyShape(BodyShapeKind::CAPSULE, BodyShape().size, CHARACTER_RADIUS, CHARACTER_HEIGHT);
        }
    }

    /**
     * The description of a node of a scene, and of the nodes under it, as a scene file saves it
     * @info: the nodes named __…__ are left out (see isReservedName), and so are the meshes of a model, which its file
     * gives; the nodes under a node are in their order (see Node::getChildrenInOrder), the order a scene file builds them
     * in
     * @params:
     *    - node: an empty, a model, a cube, a sphere or a plane (a mesh made of a primitive, see MeshGeometry.primitive),
     *            a light, a marker, a path, a point of a path, a volume, a body or a character
     * @throws:
     *    - &BalderError: if the node, or a node under it, is of none of these kinds, or is a body of a shape no
     *                    description gives (see PhysicsBody3D::described)
     * */
    pub self (dmut node: &Node3D)
        with id = node.guid
        , name = node.name.file()
        , kind = NodeKind::EMPTY
        , position = node.position
        , rotation = node.rotation
        , scale = node.scale
        throws BalderError
    {
        match node {
            l: &Light => {
                self.kind = NodeKind::LIGHT;
                self.light = l.type;
                self.color = l.color;
                self.intensity = l.intensity;
                self.direction = l.direction;
                self.range = l.range;
                self.innerAngle = l.innerAngle;
                self.outerAngle = l.outerAngle;
                self.shadows = l.castShadow;
            }
            m: &SolidObjectModel => {
                self.kind = NodeKind::MODEL;
                self.file = m.file;
                self.lods = m.lods;
                return;
            }
            m: &Marker3D => {
                self.kind = NodeKind::MARKER;
                self.purpose = m.purpose;
                self.tags = m.tags;
            }
            p: &Path3D => {
                self.kind = NodeKind::PATH;
                self.curve = p.curveKind;
                self.closed = p.closed;
            }
            _: &PathPoint3D => {
                self.kind = NodeKind::PATH_POINT;
            }
            v: &Volume3D => {
                self.kind = NodeKind::VOLUME;
                self.volume = v.shape;
            }
            c: &CharacterBody3D => {
                self.kind = NodeKind::CHARACTER;
                self.shape = BodyShape(BodyShapeKind::CAPSULE, BodyShape().size, c.shape.radius, c.shape.height);
                // a character reads its layers only, its body always kinematic
                self.body = BodySettings(layer-> c.settings.layer, mask-> c.settings.mask);
                self.character = c.controller.settings;
            }
            b: &PhysicsBody3D => {
                self.kind = NodeKind::BODY;
                self.body = b.settings;
                if let Ok(d) = b.described {
                    self.shape = d;
                } else {
                    throw copy BalderError(f"${node.name.toStr()}: a body of a shape given as a collider, which no scene file describes");
                }
            }
            _: &Empty3D => {}
            _ => {
                if let dmut mesh: &IndexedMesh3D = alias node {
                    self.kind = match mesh.mesh.primitive {
                        Primitive::CUBE   => { NodeKind::CUBE }
                        Primitive::SPHERE => { NodeKind::SPHERE }
                        Primitive::PLANE  => { NodeKind::PLANE }
                        _ => {
                            throw copy BalderError(f"${node.name.toStr()}: a mesh given its vertices, which no scene file describes");
                        }
                    };

                    self.material = mesh.material.config;
                } else {
                    throw copy BalderError(f"${node.name.toStr()}: a node of a kind no scene file describes");
                }
            }
        }

        for dmut c in alias node:.getChildrenInOrder() if !isReservedName(c.name.file()) {
            if let dmut n: &Node3D = alias c {
                self.children = self.children ~ [NodeDescription(alias n)];
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          BUILD          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the node under a parent, then the nodes under it, the node taking the id of the description unless it is nil
     * @returns: the node created
     * @info: a body of a hull or a mesh reads its model, a body of a compound takes the volumes under it once they are
     * built (see PhysicsBody3D::reshape)
     * @throws:
     *    - &BalderError: if the file of a model cannot be loaded, or a compound has no volume under its body
     * */
    pub fn build(self, dmut parent: &Node)-> dmut &Node3D
        throws BalderError
    {
        let dmut node = alias self.create(alias parent);
        node:.setTransform(self.position, self.rotation, self.scale);
        if !self.id.isNil() {
            node.guid = self.id;
        }

        for c in self.children {
            c.build(alias node);
        }

        if self.kind == NodeKind::BODY && !self.shape.isPrimitive {
            if let dmut b: &PhysicsBody3D = alias node {
                b:.reshape(self.shape);
            }
        }

        alias node
    }

    /**
     * @returns: the node of the kind of the description, under a parent, its own nodes not created yet
     * */
    fn create(self, dmut parent: &Node)-> dmut &Node3D
        throws BalderError
    {
        if self.kind == NodeKind::EMPTY {
            return copy Empty3D(self.name, alias parent);
        }

        if self.kind == NodeKind::MODEL {
            return copy SolidObjectModel::fromFile(self.name, alias parent, self.file, lods-> self.lods);
        }

        if self.kind == NodeKind::CUBE {
            return alias self.createMesh(alias parent, Primitive::CUBE, cubeMesh());
        }

        if self.kind == NodeKind::SPHERE {
            return alias self.createMesh(alias parent, Primitive::SPHERE, sphereMesh());
        }

        if self.kind == NodeKind::PLANE {
            return alias self.createMesh(alias parent, Primitive::PLANE, planeMesh());
        }

        if self.kind == NodeKind::MARKER {
            let dmut m = copy Marker3D(self.name, alias parent, purpose-> self.purpose);
            m.tags = self.tags;
            return alias m;
        }

        if self.kind == NodeKind::PATH {
            return copy Path3D(self.name, alias parent, curveKind-> self.curve, closed-> self.closed);
        }

        if self.kind == NodeKind::PATH_POINT {
            return copy PathPoint3D(self.name, alias parent);
        }

        if self.kind == NodeKind::VOLUME {
            return copy Volume3D(self.name, alias parent, shape-> self.volume);
        }

        if self.kind == NodeKind::BODY {
            let collider = if let Ok(c) = self.shape.collider() { c } else { ColliderShape() };
            let dmut b = copy PhysicsBody3D(self.name, alias parent, shape-> collider, settings-> self.body);
            if self.shape.isPrimitive {
                // the sizes of the description kept, those of its kind only being read
                b:.setDescribedShape(collider, self.shape?);
            }

            return alias b;
        }

        if self.kind == NodeKind::CHARACTER {
            return copy CharacterBody3D(self.name, alias parent, radius-> self.shape.radius, height-> self.shape.height,
                                        settings-> self.character, body-> self.body);
        }

        let dmut l = copy Light(self.name, alias parent, castShadow-> self.shadows);
        l.type = self.light;
        l.color = self.color;
        l.intensity = self.intensity;
        l.direction = self.direction;
        l.range = self.range;
        l.innerAngle = self.innerAngle;
        l.outerAngle = self.outerAngle;
        alias l
    }

    /**
     * @returns: a mesh drawing a primitive with the material of the description, under a parent
     * */
    fn createMesh(self, dmut parent: &Node, primitive: Primitive, mesh: (MeshArray, [u32]))-> dmut &Node3D
        throws BalderError
    {
        let dmut material = copy ConstantMaterial(self.material);
        copy IndexedMesh3D(self.name, alias parent, LodChain(mesh._1), mesh._0, alias material, primitive-> primitive)
    }

}

/**
 * @returns: true iif a name is of the form __…__, reserved for the nodes of the tools (the camera of the editor, its
 * gizmo...), which the scene files leave out
 * */
pub fn isReservedName(name: [c8])-> bool {
    name.len >= 4us && name[0us .. 2us] == "__" && name[$ - 2us .. $] == "__"
}
