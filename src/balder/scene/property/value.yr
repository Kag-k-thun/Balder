in value;

use balder::math::vector;
use balder::scene::property::kind;

use std::uuid;

/**
 * A value of a property of a node, of one of the kinds of PropertyKind, the field of its kind holding it: what a scene
 * file gives, what a node has, and what a change of the inspector goes from and to
 * */
pub record PropertyValue {

    // The kind of the value, telling the field holding it
    pub let kind: PropertyKind;

    // The value of a number
    pub let number: f32;

    // The value of a vector or a colour
    pub let vector: vec3;

    // The value of a boolean
    pub let flag: bool;

    // The value of a count, the bits of the layers
    pub let bits: u32;

    // The value of a text, the name of a choice, the project path of an asset
    pub let text: [c8];

    // The values of texts
    pub let texts: [[c8]];

    // The id of a node
    pub let node: Uuid;

    /**
     * The number 0
     * */
    pub self ()
        with self(PropertyKind::NUMBER, 0.0f, vec3(), false, 0u32, "", [], Uuid::nil())
    {}

    pub self number(value: f32)
        with self(PropertyKind::NUMBER, value, vec3(), false, 0u32, "", [], Uuid::nil())
    {}

    pub self vector(value: vec3)
        with self(PropertyKind::VECTOR, 0.0f, value, false, 0u32, "", [], Uuid::nil())
    {}

    pub self color(value: vec3)
        with self(PropertyKind::COLOR, 0.0f, value, false, 0u32, "", [], Uuid::nil())
    {}

    pub self flag(value: bool)
        with self(PropertyKind::BOOL, 0.0f, vec3(), value, 0u32, "", [], Uuid::nil())
    {}

    /**
     * @params:
     *    - name: the name of the choice, as the scene files write it
     * */
    pub self choice(name: [c8])
        with self(PropertyKind::CHOICE, 0.0f, vec3(), false, 0u32, name, [], Uuid::nil())
    {}

    pub self text(value: [c8])
        with self(PropertyKind::STRING, 0.0f, vec3(), false, 0u32, value, [], Uuid::nil())
    {}

    pub self texts(values: [[c8]])
        with self(PropertyKind::TEXTS, 0.0f, vec3(), false, 0u32, "", values, Uuid::nil())
    {}

    /**
     * @params:
     *    - path: the project path of the file, empty for none
     * */
    pub self asset(path: [c8])
        with self(PropertyKind::ASSET, 0.0f, vec3(), false, 0u32, path, [], Uuid::nil())
    {}

    pub self node(id: Uuid)
        with self(PropertyKind::NODE, 0.0f, vec3(), false, 0u32, "", [], id)
    {}

    pub self count(value: u32)
        with self(PropertyKind::COUNT, 0.0f, vec3(), false, value, "", [], Uuid::nil())
    {}

    /**
     * @params:
     *    - bits: one bit by layer, the lowest the layer 0
     * */
    pub self layers(bits: u32)
        with self(PropertyKind::LAYERS, 0.0f, vec3(), false, bits, "", [], Uuid::nil())
    {}

    self (kind: PropertyKind, number: f32, vector: vec3, flag: bool, bits: u32, text: [c8], texts: [[c8]], node: Uuid)
        with kind = kind
        , number = number
        , vector = vector
        , flag = flag
        , bits = bits
        , text = text
        , texts = texts
        , node = node
    {}

    /**
     * @returns: true iif the two values are of the same kind, and their fields of that kind hold the same
     * */
    pub fn opEquals(self, other: PropertyValue)-> bool {
        if self.kind != other.kind { return false; }
        match self.kind {
            PropertyKind::NUMBER => { self.number == other.number }
            PropertyKind::VECTOR | PropertyKind::COLOR => { self.vector == other.vector }
            PropertyKind::BOOL => { self.flag == other.flag }
            PropertyKind::TEXTS => { self.texts == other.texts }
            PropertyKind::NODE => { self.node.opCmp(other.node) == 0 }
            PropertyKind::COUNT | PropertyKind::LAYERS => { self.bits == other.bits }
            _ => { self.text == other.text }
        }
    }

}
