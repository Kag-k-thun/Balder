in choice_property;

use balder::scene::node::node3D;
use balder::scene::property::{choice, condition, kind, node_property, range, value};

/**
 * A property of the nodes of a class N whose values are the members of an enum E, each a choice of a name and a label:
 * `ChoiceProperty!{&Light, LightType}("light", LightType::DIRECTION, copy [("point", "Point", LightType::POINT), …], …)`
 * */
@final
pub class ChoiceProperty {N, E} over NodeProperty {

    // The choices, their names, their labels and their members, in the order of the inspector
    let _table: [([c8], [c8], E)];

    let _get: dg (dmut N)-> E;

    let _set: (dg (dmut N, E)-> void)?;

    let _check: (dg (N, E)-> [c8])?;

    /**
     * @params:
     *    - name: the name of the entry of the scene files
     *    - default: the member of a node a scene file gives none
     *    - table: the choices, the name of each in the scene files, its label in the inspector and its member
     *    - get: the member of a node
     *    - set: gives a member to a node, none for a property given at the creation of a node
     *    - check: why a node refuses a member, empty when it takes it, none when it takes them all
     *    - label: the label of the row of the inspector
     *    - group: the section of the inspector holding the row
     *    - when: when the property applies, none when it always does
     * */
    pub self (name: [c8], default: E, table: [([c8], [c8], E)], get: dg (dmut N)-> E,
              set: (dg (dmut N, E)-> void)? = none,
              check: (dg (N, E)-> [c8])? = none,
              label: [c8] = "",
              group: [c8] = "",
              when: (Condition)? = none)
        with super(name, PropertyKind::CHOICE, label, group, PropertyValue::choice(nameOf!{E} (table, default)),
                   NumberRange(), choicesOf!{E} (table), when, false, false, false)
        , _table = table
        , _get = get
        , _set = set
        , _check = check
    {}

    pub over isOf(self, node: &Node3D)-> bool {
        cte if (N::typeid == (&Node3D)::typeid) {
            node;
            return true;
        } else {
            if let _: N = node { return true; }
            return false;
        }
    }

    pub over get(self, dmut node: &Node3D)-> PropertyValue {
        cte if (N::typeid == (&Node3D)::typeid) {
            return PropertyValue::choice(nameOf!{E} (self._table, self._get(alias node)));
        } else {
            if let dmut n: N = alias node { return PropertyValue::choice(nameOf!{E} (self._table, self._get(alias n))); }
            return self.defaultValue;
        }
    }

    pub over settable(self)-> bool {
        self._set.hasValue
    }

    pub over set(self, dmut node: &Node3D, value: PropertyValue) {
        let s = if let Ok(s) = self._set { s } else { return; };
        let member = if let Ok(m) = memberOf!{E} (self._table, value.text) { m } else { return; };
        cte if (N::typeid == (&Node3D)::typeid) {
            s(alias node, member);
        } else {
            if let dmut n: N = alias node { s(alias n, member); }
        }
    }

    pub over check(self, node: &Node3D, value: PropertyValue)-> [c8] {
        let member = if let Ok(m) = memberOf!{E} (self._table, value.text) { m } else {
            return f"${value.text} is not a choice of ${self.name}";
        };

        if let Ok(c) = self._check {
            cte if (N::typeid == (&Node3D)::typeid) {
                return c(node, member);
            } else {
                if let n: N = node { return c(n, member); }
            }
        }

        ""
    }

    /**
     * @returns: the member of a choice, none for a name of no choice
     * */
    pub fn member(self, name: [c8])-> (E)? {
        memberOf!{E} (self._table, name)
    }

}

/**
 * @returns: the name of the choice of a member, the name of the first choice for a member of none
 * */
pub fn nameOf {E} (table: [([c8], [c8], E)], member: E)-> [c8] {
    for c in table if c._2 == member { return c._0; }
    if table.len != 0us { table[0]._0 } else { "" }
}

/**
 * @returns: the member of the choice of a name, none for a name of no choice
 * */
pub fn memberOf {E} (table: [([c8], [c8], E)], name: [c8])-> (E)? {
    for c in table if c._0 == name { return c._2?; }
    none
}

/**
 * @returns: the names and the labels of the choices
 * */
pub fn choicesOf {E} (table: [([c8], [c8], E)])-> [Choice] {
    let mut choices: [Choice] = [];
    for c in table {
        choices ~= [Choice(name-> c._0, label-> c._1)];
    }

    choices
}
