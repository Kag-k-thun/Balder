in choice;

/**
 * A choice of a property of the kind CHOICE: its name, as the scene files write it, and its label, as the inspector
 * shows it
 * */
@data
pub record Choice {

    // The name of the choice in the scene files ("spot")
    pub let name: [c8] = "";

    // The label of the choice in the inspector ("Spot")
    pub let label: [c8] = "";
}
