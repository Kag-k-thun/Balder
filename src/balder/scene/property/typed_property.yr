in typed_property;

use balder::math::vector;
use balder::scene::node::node3D;
use balder::scene::property::{condition, kind, node_property, range, value};

use std::uuid;

/**
 * A property of the nodes of a class N whose values are T (f32, vec3, bool, u32, [c8], [[c8]] or Uuid), read by a getter
 * and given by a setter: `Property!{&Light, f32}("intensity", 1.0f, |dmut l| => l.intensity, set-> …)`
 * @info: the kind of the property follows from T (a number, a vector, a boolean, a count, a text, texts, a node), unless
 * given: a vec3 holds a colour, a u32 the bits of layers, a [c8] the path of an asset, a [[c8]] the paths of assets
 * */
@final
pub class Property {N, T} over NodeProperty {

    let _get: dg (dmut N)-> T;

    let _set: (dg (dmut N, T)-> void)?;

    let _check: (dg (N, T)-> [c8])?;

    /**
     * @params:
     *    - name: the name of the entry of the scene files
     *    - default: the value of a node a scene file gives none
     *    - get: the value of a node
     *    - set: gives a value to a node, none for a property given at the creation of a node
     *    - check: why a node refuses a value, empty when it takes it, none when it takes them all
     *    - kind: what the values are, by default what T holds
     *    - label: the label of the row of the inspector
     *    - group: the section of the inspector holding the row
     *    - range: the numbers the inspector lets a number or a vector take
     *    - when: when the property applies, none when it always does
     *    - degrees: true for angles in radians, given in degrees by the scene files and the inspector
     *    - required: true when a node needs the property in a scene file while it applies
     *    - unique: true when one node of a scene file at most has the property true
     *    - asset: the kind of the assets a property of the kind ASSET or ASSETS names, `mesh` or `material`
     * */
    pub self (name: [c8], default: T, get: dg (dmut N)-> T,
              set: (dg (dmut N, T)-> void)? = none,
              check: (dg (N, T)-> [c8])? = none,
              kind: PropertyKind = kindOf!{T} (),
              label: [c8] = "",
              group: [c8] = "",
              range: NumberRange = NumberRange(),
              when: (Condition)? = none,
              degrees: bool = false,
              required: bool = false,
              unique: bool = false,
              asset: [c8] = "")
        with super(name, kind, label, group, toValue!{T} (kind, default), range, [], when, degrees, required, unique,
                   asset-> asset)
        , _get = get
        , _set = set
        , _check = check
    {}

    pub over isOf(self, node: &Node3D)-> bool {
        cte if (N::typeid == (&Node3D)::typeid) {
            node;
            return true;
        } else {
            if let _: N = node { return true; }
            return false;
        }
    }

    pub over get(self, dmut node: &Node3D)-> PropertyValue {
        cte if (N::typeid == (&Node3D)::typeid) {
            return toValue!{T} (self.kind, self._get(alias node));
        } else {
            if let dmut n: N = alias node { return toValue!{T} (self.kind, self._get(alias n)); }
            return self.defaultValue;
        }
    }

    pub over settable(self)-> bool {
        self._set.hasValue
    }

    pub over set(self, dmut node: &Node3D, value: PropertyValue) {
        if let Ok(s) = self._set {
            cte if (N::typeid == (&Node3D)::typeid) {
                s(alias node, fromValue!{T} (value));
            } else {
                if let dmut n: N = alias node { s(alias n, fromValue!{T} (value)); }
            }
        }
    }

    pub over check(self, node: &Node3D, value: PropertyValue)-> [c8] {
        if let Ok(c) = self._check {
            cte if (N::typeid == (&Node3D)::typeid) {
                return c(node, fromValue!{T} (value));
            } else {
                if let n: N = node { return c(n, fromValue!{T} (value)); }
            }
        }

        ""
    }

}

/**
 * @returns: the kind of the properties of values T, unless they say otherwise
 * */
pub fn kindOf {T of f32} ()-> PropertyKind { PropertyKind::NUMBER }
pub fn kindOf {T of vec3} ()-> PropertyKind { PropertyKind::VECTOR }
pub fn kindOf {T of bool} ()-> PropertyKind { PropertyKind::BOOL }
pub fn kindOf {T of u32} ()-> PropertyKind { PropertyKind::COUNT }
pub fn kindOf {T of [c8]} ()-> PropertyKind { PropertyKind::STRING }
pub fn kindOf {T of [[c8]]} ()-> PropertyKind { PropertyKind::TEXTS }
pub fn kindOf {T of Uuid} ()-> PropertyKind { PropertyKind::NODE }

/**
 * @returns: the value of a property of a kind holding a T
 * */
pub fn toValue {T of f32} (_: PropertyKind, v: f32)-> PropertyValue {
    PropertyValue::number(v)
}

pub fn toValue {T of vec3} (kind: PropertyKind, v: vec3)-> PropertyValue {
    if kind == PropertyKind::COLOR { PropertyValue::color(v) } else { PropertyValue::vector(v) }
}

pub fn toValue {T of bool} (_: PropertyKind, v: bool)-> PropertyValue {
    PropertyValue::flag(v)
}

pub fn toValue {T of u32} (kind: PropertyKind, v: u32)-> PropertyValue {
    if kind == PropertyKind::LAYERS { PropertyValue::layers(v) } else { PropertyValue::count(v) }
}

pub fn toValue {T of [c8]} (kind: PropertyKind, v: [c8])-> PropertyValue {
    if kind == PropertyKind::ASSET { PropertyValue::asset(v) } else { PropertyValue::text(v) }
}

pub fn toValue {T of [[c8]]} (kind: PropertyKind, v: [[c8]])-> PropertyValue {
    if kind == PropertyKind::ASSETS { PropertyValue::assets(v) } else { PropertyValue::texts(v) }
}

pub fn toValue {T of Uuid} (_: PropertyKind, v: Uuid)-> PropertyValue {
    PropertyValue::node(v)
}

/**
 * @returns: the T a value holds
 * */
pub fn fromValue {T of f32} (v: PropertyValue)-> f32 { v.number }
pub fn fromValue {T of vec3} (v: PropertyValue)-> vec3 { v.vector }
pub fn fromValue {T of bool} (v: PropertyValue)-> bool { v.flag }
pub fn fromValue {T of u32} (v: PropertyValue)-> u32 { v.bits }
pub fn fromValue {T of [c8]} (v: PropertyValue)-> [c8] { v.text }
pub fn fromValue {T of [[c8]]} (v: PropertyValue)-> [[c8]] { v.texts }
pub fn fromValue {T of Uuid} (v: PropertyValue)-> Uuid { v.node }
