in kind;

/**
 * What the values of a property are, which tells how a scene file writes them and how the inspector edits them
 * */
pub enum PropertyKind : u32
| NUMBER = 0u32   // a number, between the bounds of its range
| VECTOR = 1u32   // three numbers, the X, the Y and the Z of a vector
| COLOR  = 2u32   // three numbers, the red, the green and the blue of a linear colour
| BOOL   = 3u32   // true or false
| CHOICE = 4u32   // one of the choices of the property, by its name
| STRING = 5u32   // a text
| TEXTS  = 6u32   // texts, none of them empty
| ASSET  = 7u32   // the path of an asset, a mesh or a material, an asset of the scene file
| NODE   = 8u32   // the id of another node of the scene (see Node3D.guid)
| COUNT  = 9u32   // a whole number, 0 or more
| LAYERS = 10u32  // the bits of the 32 collision layers
| ASSETS = 11u32; // the paths of assets, one per slot (the materials of the parts of a mesh), empty for a slot of none
