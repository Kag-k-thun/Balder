in node_property;

use balder::scene::node::node3D;
use balder::scene::property::{choice, condition, kind, range, value};

/**
 * A property of the nodes of a class, declared once in the schema of the class (see NodeSchema): the entry of a scene
 * file, the row of the inspector and what the editor changes and undoes
 * @info: a property without a setter is given at the creation of a node (the file of a model, the projection of a
 * camera) and read from it, the editor showing it without changing it unless it changes it its own way
 * */
@abstract
pub class NodeProperty {

    // The name of the entry of a scene file, `inner-angle`
    pub let name: [c8];

    // What the values of the property are
    pub let kind: PropertyKind;

    // The label of the row of the inspector, `Inner angle (degrees)`
    pub let label: [c8];

    // The group of the property, the section of the inspector holding its row
    pub let group: [c8];

    // The value of a node the scene file gives none, written by no scene file
    pub let defaultValue: PropertyValue;

    // The numbers the inspector lets a number or the components of a vector take
    pub let range: NumberRange;

    // The choices of a property of the kind CHOICE, in the order of the inspector
    pub let choices: [Choice];

    // When the property applies, none when it always does
    pub let condition: (Condition)?;

    // True when the property holds angles in radians, the scene files and the inspector giving them in degrees
    pub let degrees: bool;

    // True when a node of a scene file needs the property while it applies (the file of a model)
    pub let required: bool;

    // True when one node of a scene file at most has the property true (the active camera)
    pub let unique: bool;

    prot self (name: [c8], kind: PropertyKind, label: [c8], group: [c8], defaultValue: PropertyValue, range: NumberRange,
               choices: [Choice], condition: (Condition)?, degrees: bool, required: bool, unique: bool)
        with name = name
        , kind = kind
        , label = label
        , group = group
        , defaultValue = defaultValue
        , range = range
        , choices = choices
        , condition = condition
        , degrees = degrees
        , required = required
        , unique = unique
    {}

    /**
     * @returns: the key of the property among the properties of every schema, its group then its name: the properties
     * of two classes of the same key are the same property, shared by the nodes of both classes
     * */
    pub fn key(self)-> [c8] {
        self.group ~ "/" ~ self.name
    }

    /**
     * @returns: the place of a choice among the choices of the property, none for a name of no choice
     * */
    pub fn choiceIndex(self, name: [c8])-> (usize)? {
        for i, c in self.choices if c.name == name { return i?; }
        none
    }

    /**
     * @returns: true iif the node is of the class of the property
     * */
    pub fn isOf(self, node: &Node3D)-> bool;

    /**
     * @returns: the value of the property of a node, the default for a node of another class
     * */
    pub fn get(self, dmut node: &Node3D)-> PropertyValue;

    /**
     * @returns: true iif the property is given to a node once it is created
     * */
    pub fn settable(self)-> bool;

    /**
     * Give a value to the property of a node, a node of another class or a property without setter keeping its own
     * @params:
     *    - value: a value of the kind of the property, accepted by check
     * */
    pub fn set(self, dmut node: &Node3D, value: PropertyValue);

    /**
     * @returns: why the property of a node refuses a value (a light along a null direction), empty when it takes it
     * */
    pub fn check(self, node: &Node3D, value: PropertyValue)-> [c8];

}
