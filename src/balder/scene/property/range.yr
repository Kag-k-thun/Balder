in range;

/**
 * The numbers the inspector lets a number or the components of a vector take, and how it steps through them
 * */
@data
pub record NumberRange {

    // The lowest and the highest numbers
    pub let min: f32 = -10000.0f;
    pub let max: f32 = 10000.0f;

    // The step of the arrows of a field
    pub let step: f32 = 0.01f;

    // The number of decimals a field shows
    pub let decimals: u32 = 2u32;
}
