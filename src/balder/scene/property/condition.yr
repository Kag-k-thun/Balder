in condition;

/**
 * When a property applies: while another property of the node, of the kind CHOICE, has one of some choices (the cone
 * of a light while its type is spot)
 * @info: a scene file writes the entries of a node that apply only, and the inspector shows the rows of those
 * */
@data
pub record Condition {

    // The name of the property of the node it depends on
    pub let property: [c8] = "";

    // The names of the choices of that property it applies with
    pub let choices: [[c8]] = [];
}
