in node_schema;

use balder::math::vector;
use balder::scene::node::node3D;
use balder::scene::property::{condition, group, node_property, range, typed_property, value};

/**
 * The properties of the nodes of a class, declared once beside the class, `Light::schema()`, as the widgets have their
 * WidgetSchema: the scene files read and write the entries of a node from it (see NodeDescription), the editor builds
 * the rows of its inspector from it and changes any property through one command
 * @info:
 * =====
 * Every schema starts with the transform of a Node3D (position, rotation in degrees, scale, of the group Transform),
 * then the properties of its class, in the order a scene file writes them:
 * ```
 * NodeSchema("light", groups-> copy [PropertyGroup(name-> "Light")], properties-> copy [
 *     copy Property!{&Light, f32}("intensity", 1.0f, |dmut l| => l.intensity, set-> (|dmut l, v| => { l.intensity = v; })?,
 *                                 label-> "Intensity", group-> "Light", range-> NumberRange(min-> 0.0f, max-> 100000.0f)),
 *     …
 * ])
 * ```
 * ====
 * */
pub class NodeSchema {

    // The name of a node of the class, in the messages of the editor ("light")
    pub let noun: [c8];

    // The groups of the properties, in the order of the inspector
    pub let groups: [PropertyGroup];

    // The properties, the transform first
    pub let properties: [&NodeProperty];

    /**
     * @params:
     *    - noun: the name of a node of the class, in the messages of the editor
     *    - groups: the groups of the properties of the class, after the transform
     *    - properties: the properties of the class, after the transform, in the order a scene file writes them
     * */
    pub self (noun: [c8], groups: [PropertyGroup] = [], properties: [&NodeProperty] = [])
        with noun = noun
        , groups = copy [PropertyGroup(name-> NodeSchema::TRANSFORM)] ~ groups
        , properties = NodeSchema::transform() ~ properties
    {}

    /**
     * @returns: the property of a name, none when the class has none
     * */
    pub fn property(self, name: [c8])-> (&NodeProperty)? {
        for p in self.properties if p.name == name { return p?; }
        none
    }

    /**
     * @returns: the property of a key (see NodeProperty::key), none when the class has none
     * */
    pub fn propertyOfKey(self, key: [c8])-> (&NodeProperty)? {
        for p in self.properties if p.key() == key { return p?; }
        none
    }

    /**
     * @returns: true iif a property applies to a node, the property it depends on having one of its choices
     * */
    pub fn applies(self, p: &NodeProperty, dmut node: &Node3D)-> bool {
        if let Ok(c) = p.condition {
            if let Ok(on) = self.property(c.property) {
                return NodeSchema::holds(c, on.get(alias node));
            }
        }

        true
    }

}

/**
 * The transform every schema starts with
 * */
pub mod NodeSchema {

    /**
     * The group of the transform
     * */
    pub def TRANSFORM = "Transform";

    /**
     * @returns: true iif the value of the property a condition depends on is one of its choices
     * */
    pub fn holds(c: Condition, v: PropertyValue)-> bool {
        for name in c.choices if name == v.text { return true; }
        false
    }

    /**
     * @returns: the position, the rotation (in radians, given in degrees) and the scale of a node, in the space of its
     * parent
     * */
    pub fn transform()-> [&NodeProperty] {
        copy [copy Property!{&Node3D, vec3}("position", vec3(), |dmut n| => n.position,
                                            set-> (|dmut n, v| => { n.position = v; })?,
                                            label-> "Position", group-> TRANSFORM,
                                            range-> NumberRange(min-> -10000.0f, max-> 10000.0f, step-> 0.01f, decimals-> 2u32)),
              copy Property!{&Node3D, vec3}("rotation", vec3(), |dmut n| => n.rotation,
                                            set-> (|dmut n, v| => { n.rotation = v; })?,
                                            label-> "Rotation (degrees)", group-> TRANSFORM, degrees-> true,
                                            range-> NumberRange(min-> -720.0f, max-> 720.0f, step-> 0.1f, decimals-> 1u32)),
              copy Property!{&Node3D, vec3}("scale", makeVec3(1.0f, 1.0f, 1.0f), |dmut n| => n.scale,
                                            set-> (|dmut n, v| => { n.scale = v; })?,
                                            label-> "Scale", group-> TRANSFORM,
                                            range-> NumberRange(min-> -1000.0f, max-> 1000.0f, step-> 0.01f, decimals-> 2u32))]
    }

}
