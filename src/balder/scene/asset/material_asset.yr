in material_asset;

mod ::utils;

use balder::core::error;
use balder::scene::node::node3D::visual::material::_;
use balder::scene::property::{kind, value};
use balder::utils::path;

use std::{fs, uuid};

/**
 * The entries of a material, in the .material files and the blocks of the materials of the scene files, by their names
 * and the kinds of their values: its factors (see MaterialConfig), then the paths of its maps (see MaterialMaps)
 * */
enum MaterialEntries
| BASE_COLOR             = ("base-color", PropertyKind::COLOR)
| EMISSIVE               = ("emissive", PropertyKind::COLOR)
| METALLIC               = ("metallic", PropertyKind::NUMBER)
| ROUGHNESS              = ("roughness", PropertyKind::NUMBER)
| SPECULAR               = ("specular", PropertyKind::NUMBER)
| OCCLUSION              = ("occlusion", PropertyKind::NUMBER)
| NORMAL_STRENGTH        = ("normal-strength", PropertyKind::NUMBER)
| EMISSIVE_STRENGTH      = ("emissive-strength", PropertyKind::NUMBER)
| TILING_U               = ("tiling-u", PropertyKind::NUMBER)
| TILING_V               = ("tiling-v", PropertyKind::NUMBER)
| OFFSET_U               = ("offset-u", PropertyKind::NUMBER)
| OFFSET_V               = ("offset-v", PropertyKind::NUMBER)
| BASE_COLOR_MAP         = ("base-color-map", PropertyKind::ASSET)
| METALLIC_ROUGHNESS_MAP = ("metallic-roughness-map", PropertyKind::ASSET)
| NORMAL_MAP             = ("normal-map", PropertyKind::ASSET)
| OCCLUSION_MAP          = ("occlusion-map", PropertyKind::ASSET)
| EMISSIVE_MAP           = ("emissive-map", PropertyKind::ASSET);

/**
 * A material as an asset, the factors and the maps of a surface shared by every mesh drawing with it: read from a
 * .material file, embedded in a model file, or local to a scene file; each draw takes a material of its own from it
 * (see instance)
 * @info: the path of an asset names it in the cache of the assets (see Assets) and in the scene files: the project path
 * of its .material file, `res:/models/crate.glb#0` for the first material of a model file (see
 * MaterialAsset::embeddedPath), `local:<uuid>` for a material local to a scene file (see MaterialAsset::local)
 * @example:
 * ```
 * let brick = Assets::material("res:/materials/brick.material");
 * let dmut wall = copy MeshInstance3D("wall", alias root, Assets::mesh(MeshAsset::CUBE), materials-> copy [(brick)?]);
 * ```
 * */
pub class MaterialAsset {

    // The path naming the asset, in the cache of the assets and in the scene files
    let _path: [c8];

    // The name of the material, shown to the user: the name of its file, of the material in its model file, or the one
    // its scene file gives it
    let _name: [c8];

    // The factors of the surface
    let _config: MaterialConfig;

    // The paths of the maps of the surface, empty for the maps it has not
    let _maps: MaterialMaps;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - path: the path naming the asset (see the class)
     *    - name: the name of the material, shown to the user
     *    - config: its factors
     *    - maps: the paths of its maps, empty for those it has not
     * */
    pub self (path: [c8], name: [c8], config: MaterialConfig = MaterialConfig(), maps: MaterialMaps = MaterialMaps())
        with _path = path
        , _name = name
        , _config = config
        , _maps = maps
    {}

    /**
     * A material of the values of its entries (see MaterialAsset::entries), the others holding their defaults
     * @params:
     *    - values: the values of entries, by their names, of the kinds of the entries
     * */
    pub self fromValues(path: [c8], name: [c8], values: [([c8], PropertyValue)])
        with self(path, name, config-> utils::configOf(values), maps-> utils::mapsOf(values))
    {}

    /**
     * A material local to a scene file, written in a block of the file rather than in a file of its own
     * @params:
     *    - id: the id of the material in its scene file, its path being `local:<id>`
     *    - name: the name the scene file gives it
     *    - values: the values of its entries, by their names
     * */
    pub self local(id: Uuid, name: [c8], values: [([c8], PropertyValue)] = [])
        with self(MaterialAsset::LOCAL_PREFIX ~ f"${id}", name, config-> utils::configOf(values), maps-> utils::mapsOf(values))
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the path naming the asset, in the cache of the assets and in the scene files
     * */
    @field
    pub fn path(self)-> [c8] {
        self._path
    }

    /**
     * @returns: the name of the material, shown to the user
     * */
    @field
    pub fn name(self)-> [c8] {
        self._name
    }

    /**
     * @returns: the factors of the surface
     * */
    @field
    pub fn config(self)-> MaterialConfig {
        self._config
    }

    /**
     * @returns: the paths of the maps of the surface, empty for the maps it has not
     * */
    @field
    pub fn maps(self)-> MaterialMaps {
        self._maps
    }

    /**
     * @returns: true iif the material is local to a scene file (see MaterialAsset::local)
     * */
    @field
    pub fn isLocal(self)-> bool {
        MaterialAsset::isLocalPath(self._path)
    }

    /**
     * @returns: true iif the material is embedded in a model file (see MaterialAsset::embeddedPath)
     * */
    @field
    pub fn isEmbedded(self)-> bool {
        MaterialAsset::modelOf(self._path).hasValue
    }

    /**
     * @returns: the value of an entry of the material (see MaterialAsset::entries), the number 0 for a name of no entry
     * */
    pub fn value(self, name: [c8])-> PropertyValue {
        utils::valueOf(self._config, self._maps, name)
    }

    /**
     * @returns: the values of the entries of the material, in the order of MaterialAsset::entries
     * */
    pub fn values(self)-> [([c8], PropertyValue)] {
        copy [(e._0, self.value(e._0)) for e in MaterialAsset::entries()]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: a material of the factors and the maps of the asset, detached, to draw one mesh with: a metallic/roughness
     * material when it has maps other than its base colour, a material of its base colour texture when it has only
     * this one, a constant material when it has none or the mesh has no texture coordinates
     * @params:
     *    - textured: true when the vertices of the mesh have texture coordinates
     * @throws: BalderError when the configuration of the shader of the material cannot be loaded
     * */
    pub fn instance(self, textured: bool)-> dmut &Material
        throws BalderError
    {
        let maps = self._maps;
        if !textured {
            return copy ConstantMaterial(self._config);
        }

        if maps.metallicRoughness != "" || maps.normal != "" || maps.occlusion != "" || maps.emissive != "" {
            return copy MetallicRoughnessMaterial(maps, self._config);
        }

        if maps.baseColor != "" {
            return copy DiffuseTextureMaterial(maps.baseColor, self._config);
        }

        copy ConstantMaterial(self._config)
    }

    /**
     * Write the material in a .material file (see MaterialAsset::read), the maps it has not left out
     * @params:
     *    - path: the project path of the file
     * @throws: BalderError when the file cannot be written
     * */
    pub fn save(self, path: [c8])
        throws BalderError
    {
        let text = utils::textOf(self.values());
        {
            writeFile(projectPath(path), text);
        } catch {
            err => {
                throw copy BalderError(f"Failed to write the material ${path}: ${err}");
            }
        }
    }

}

/**
 * The paths and the entries of the materials
 * */
pub mod MaterialAsset {

    /**
     * The extension of the files of the materials
     * */
    pub def EXTENSION = ".material";

    /**
     * The prefix of the paths of the materials local to a scene file, followed by their id
     * */
    pub def LOCAL_PREFIX = "local:";

    /**
     * The path of the default material, built in rather than read: a white dielectric, fully rough, the material of the
     * built-in meshes and of the parts of a model file naming none
     * */
    pub def DEFAULT = "engine:/materials/default";

    /**
     * @returns: the material of a .material file, a toml giving the values of its entries (see entries):
     * ```
     * # A material of Balder, its factors and the paths of its maps (see MaterialAsset)
     * version = 1
     * base-color = [0.8, 0.3, 0.2]
     * roughness = 0.6
     * base-color-map = "res:/textures/brick.png"
     * ```
     * @params:
     *    - path: the project path of the file, the name of the material being the name of the file
     * @throws: BalderError when the file cannot be read, is not a toml, is of another version, or holds an entry of the
     * wrong type, or one a material does not have
     * */
    pub fn read(path: [c8])-> dmut &MaterialAsset
        throws BalderError
    {
        copy MaterialAsset::fromValues(path, utils::nameOfFile(path), utils::read(path))
    }

    /**
     * @returns: the path of a material embedded in a model file, `res:/models/crate.glb#0` for its first one
     * @params:
     *    - model: the project path of the model file
     *    - index: the index of the material among the materials of the file
     * */
    pub fn embeddedPath(model: [c8], index: usize)-> [c8] {
        f"${model}#${index}"
    }

    /**
     * @returns: the model file and the index of a material embedded in it, none for the path of a material that is not
     * (see embeddedPath)
     * */
    pub fn modelOf(path: [c8])-> ([c8], usize)? {
        if MaterialAsset::isLocalPath(path) { return none; }

        for j in 0us .. path.len {
            let i = path.len - 1us - j;
            if path[i] == '#' {
                let index = path[i + 1us .. $];
                if index.len == 0us { return none; }
                for c in index if c < '0' || c > '9' { return none; }
                return (path[0us .. i], std::conv::to!{usize} (index))?;
            }
        }

        none
    }

    /**
     * @returns: true iif a path names a material local to a scene file (see local)
     * */
    pub fn isLocalPath(path: [c8])-> bool {
        path.len > LOCAL_PREFIX.len && path[0us .. LOCAL_PREFIX.len] == LOCAL_PREFIX
    }

    /**
     * @returns: the entries of a material, by their names and the kinds of their values (a colour, a number, the path of
     * a map), in the order the files write them
     * */
    pub fn entries()-> [([c8], PropertyKind)] {
        let mut res: [([c8], PropertyKind)] = [];
        cte for e in MaterialEntries::__members__ {
            res ~= [(e._0, e._1)];
        }

        res
    }

    /**
     * @returns: the kind of the values of an entry of a material, none for a name of no entry
     * */
    pub fn entryKind(name: [c8])-> (PropertyKind)? {
        cte for e in MaterialEntries::__members__ {
            if e._0 == name { return e._1?; }
        }

        none
    }

}
