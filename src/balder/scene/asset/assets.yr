in assets;

use balder::core::error;
use balder::scene::asset::{material_asset, mesh_asset};
use balder::scene::node::node3D::visual::primitive;

/**
 * The mesh assets loaded, by their paths and whether their levels of detail were built (see keyOf)
 * */
lazy dmut __MESHES__: [[c8] => &MeshAsset] = copy [];

/**
 * The material assets loaded or registered, by their paths
 * */
lazy dmut __MATERIALS__: [[c8] => &MaterialAsset] = copy [];

/**
 * The cache of the assets, each loaded once by its path and shared by every node using it
 * @example:
 * ```
 * let crate = Assets::mesh("res:/models/crate.glb");
 * let painted = Assets::material("res:/materials/painted_wood.material");
 * let dmut a = copy MeshInstance3D("crate", alias root, crate);
 * let dmut b = copy MeshInstance3D("painted-crate", alias root, crate, materials-> copy [(painted)?]);
 * ```
 * */
pub mod Assets {

    /**
     * @returns: the mesh asset of a path, loaded once: a built-in mesh (MeshAsset::CUBE...), or the mesh of a model file
     * (see MeshAsset::read)
     * @info: a mesh whose geometry released its vertices once placed in a scene (see MeshAsset.isReleased) is loaded
     * again, a mesh drawing it elsewhere needing them
     * @params:
     *    - path: the path of the asset
     *    - lods: true to build the levels of detail of the parts of a model file, the meshes of both cached apart
     * @throws: BalderError when the model file cannot be read
     * */
    pub fn mesh(path: [c8], lods: bool = true)-> dmut &MeshAsset
        throws BalderError
    {
        let key = Assets::keyOf(path, lods);
        let dmut cached = atomic { alias __MESHES__[key] };
        if let Ok(dmut m) = alias cached {
            if !m.isReleased { return alias m; }
        }

        let primitive = MeshAsset::primitiveOf(path);
        let dmut loaded = if primitive != Primitive::NONE { MeshAsset::builtin(primitive) } else { MeshAsset::read(path, lods-> lods) };
        atomic { __MESHES__[key] = alias loaded; }
        alias loaded
    }

    /**
     * @returns: the material asset of a path, loaded once: the default material (MaterialAsset::DEFAULT), a material
     * embedded in a model file (the mesh of the file loaded, its levels of detail built), a material registered (see register), or the material of
     * a .material file (see MaterialAsset::read)
     * @throws: BalderError when the file cannot be read, a model file has no material of the index of the path, or the
     * path names a material local to a scene file that was not read
     * */
    pub fn material(path: [c8])-> &MaterialAsset
        throws BalderError
    {
        let cached = atomic { __MATERIALS__[path] };
        if let Ok(m) = cached { return m; }

        if path == MaterialAsset::DEFAULT {
            return Assets::register(copy MaterialAsset(path, "default"));
        }

        if let Ok(embedded) = MaterialAsset::modelOf(path) {
            // the model registers its materials as it is read
            Assets::mesh(embedded._0, lods-> true);
            let read = atomic { __MATERIALS__[path] };
            if let Ok(m) = read { return m; }

            throw copy BalderError(f"The model ${embedded._0} has no material ${embedded._1}");
        }

        if MaterialAsset::isLocalPath(path) {
            throw copy BalderError(f"The material ${path} is local to a scene file not read");
        }

        Assets::register(MaterialAsset::read(path))
    }

    /**
     * @returns: the material of a path in the cache, none when it holds none, nothing being loaded
     * */
    pub fn cachedMaterial(path: [c8])-> dmut (&MaterialAsset)? {
        atomic { alias __MATERIALS__[path] }
    }

    /**
     * Put a material in the cache under its path, replacing the one it held: a material local to a scene file, read
     * with it, a material embedded in a model file, read with the file (see MeshAsset::read), or a material made by the
     * program
     * @returns: the material
     * */
    pub fn register(dmut material: &MaterialAsset)-> &MaterialAsset {
        atomic { __MATERIALS__[material.path] = alias material; }
        material
    }

    /**
     * Drop the assets of a path from the cache, loaded again when asked next; the nodes using them keep them
     * @params:
     *    - path: the path of a mesh (both of its levels of detail) or of a material
     * */
    pub fn forget(path: [c8]) {
        atomic {
            __MESHES__:.remove(Assets::keyOf(path, true));
            __MESHES__:.remove(Assets::keyOf(path, false));
            __MATERIALS__:.remove(path);
        }
    }

    /**
     * Drop every asset from the cache; the nodes using them keep them
     * */
    pub fn clear() {
        atomic {
            __MESHES__ = copy [];
            __MATERIALS__ = copy [];
        }
    }

    /**
     * @returns: the key of a mesh in the cache, its path and whether its levels of detail are built, the path alone for a
     * built-in mesh, which has none
     * */
    pub fn keyOf(path: [c8], lods: bool)-> [c8] {
        if MeshAsset::primitiveOf(path) != Primitive::NONE { return path; }

        let suffix = if lods { "|lods" } else { "" };
        path ~ suffix
    }

}
