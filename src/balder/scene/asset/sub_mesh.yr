in sub_mesh;

use balder::scene::asset::material_asset;
use balder::scene::node::node3D::visual::mesh;

/**
 * A part of a mesh asset drawn with one material, the geometry of the meshes of a model file sharing a material (see
 * MeshAsset)
 * */
@data
pub record SubMesh {

    // The name of the part, the name of its mesh in the model file, or of the primitive
    pub let name: [c8];

    // The vertices and the levels of detail of the part, shared by every mesh drawing it
    pub let dmut geometry: &MeshGeometry;

    // The material the part is drawn with unless a mesh drawing it gives another (see MeshInstance3D.materials)
    pub let material: &MaterialAsset;

    // True when the vertices of the part have texture coordinates, which the maps of a material need (see
    // MaterialAsset.instance)
    pub let textured: bool = false;

}
