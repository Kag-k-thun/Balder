in skinned_instance;

/**
 * The place of a skinned instance in the skinning of its shader (see GroupSkinning): its bind vertices and their weights,
 * shared with the instances of the same geometry, its vertices drawn and its joints, written for it by the skin pass, and
 * its clusters, culled with the box of its poses
 * */
@data
pub record SkinnedInstance {

    // The first bind vertex of the instance in the geometry pool of its shader
    pub let source: u32 = 0u32;

    // The number of vertices of the instance
    pub let nbVertices: u32 = 0u32;

    // The weights of the first bind vertex of the instance in the weights of its shader
    pub let firstWeight: u32 = 0u32;

    // The first vertex of the instance in the vertices drawn (see SkinnedVertices), the vertex offset of its draws
    pub let target: u32 = 0u32;

    // The first joint of the instance in the joints of its shader
    pub let firstJoint: u32 = 0u32;

    // The number of joints of the instance, those of its skin
    pub let nbJoints: u32 = 0u32;

    // The first cluster of the instance in the clusters of its shader, its own, placed at its vertices drawn
    pub let firstCluster: u32 = 0u32;

    // The number of clusters of the instance, those of its geometry
    pub let nbClusters: u32 = 0u32;
}
