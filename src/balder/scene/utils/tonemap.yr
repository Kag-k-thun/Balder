in tonemap;

pub mod ::operator;

use balder::utils;
use balder::core::{_, application::_};
use balder::core::config::shader;
use balder::core::config::shader::_;
use balder::core::driver::pipeline;
use balder::core::shader::{_, buffers::_};
use balder::scene::node::node3D::camera;
use balder::scene::utils::tonemap::operator;

use ::vulkan::core;

/**
 * The size of the uniform buffer of the tone mapping, its operator (the ToneMap block of the shader)
 * */
def TONE_MAP_SIZE = 16us;

/**
 * The record holding the data needed for the tonemap pass of the scene: the light the composition wrote exposed by the
 * camera, tone mapped, then encoded in sRGB into the output of the scene, the image its widget shows
 * */
pub record ToneMapRenderScene {

    let dmut _output : (&RefCount!{&Texture})? = none;
    let dmut _shader : (&RefCount!{&Shader})? = none;
    let dmut _set : (&DescriptorSet)? = none;
    let dmut _computeShader : (&ComputeShader)? = none;

    // The operator of the tone mapping, read by the shader
    let dmut _ubo : (&UniformBufferObject)? = none;

    // The window of the scene
    let dmut _window : (&Window)? = none;

    // The name of the output in the render graph, and of the light the composition wrote
    let mut _outputName : [c8] = "";
    let mut _radiance : [c8] = "";

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CONFIGURE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the output of the scene, read by the screen
     * @info: the output is written in sRGB through a unorm view, the screen sampling it through an sRGB view decoding it,
     * so the framebuffer encodes it once
     * @params:
     *    - outputName: the name of the output in the render graph
     *    - radiance: the name of the image the composition writes in the render graph
     *    - op: the operator of the tone mapping (see setOperator)
     * */
    pub fn configure (mut self,
                      outputName : [c8],
                      radiance : [c8],
                      dmut win : &Window,
                      width : u32,
                      height : u32,
                      op : ToneMap)
        throws BalderError
    {
        let dmut device = alias win:.getVulkanDevice ();

        let dmut ubo = copy UniformBufferObject (alias device, TONE_MAP_SIZE);
        ubo:.setData (0us, cast!u32 (op));
        self._ubo = (alias ubo)?;

        let dmut output = copy OutputTexture (alias device,
                                              VkFormat::VK_FORMAT_R8G8B8A8_UNORM,
                                              width,
                                              height,
                                              forStorage-> true,
                                              sampledFormat-> (VkFormat::VK_FORMAT_R8G8B8A8_SRGB)?);
        self._output = (alias win:.insertResource (alias output))?;

        let dmut shader = win:.loadResource!{&ComputeShader} (DefaultShaders::TONEMAP_3D);
        self._shader = (alias shader)?;

        if let Ok (dmut c : &ComputeShader) = (alias shader:.get ())? {
            self._computeShader = (alias c)?;
        }

        {
            let dmut set = shader:.get ():.allocateDescriptorSet (DescriptorContext::GLOBAL);
            self._set = (alias set)?;
            set:.setUniform (UniformNames::TONE_MAP, ubo);
            set:.setStorageTexture ("output", output);
        } catch {
            err => {
                log::error #("Scene", "Malformed tone mapping textures", err);
                throw copy BalderError ("Failed to configure tonemap pass");
            }
        }

        let dmut pipeline = win:.getVulkanPipeline ();
        pipeline:.importImage (outputName, alias output);
        pipeline:.readOnScreen (outputName);

        self._window = (alias win)?;
        self._outputName = outputName;
        self._radiance = radiance;
    }

    /**
     * Change the operator of the tone mapping, read by the next frames without recording them again
     * */
    pub fn setOperator (mut self, op : ToneMap) {
        if let Ok (dmut ubo) = alias self._ubo {
            ubo:.setData (0us, cast!u32 (op));
        }
    }

    /**
     * Read the exposure of a camera, the next frames reading it when it changes
     * */
    pub fn setCamera (mut self, dmut cam : &Camera) {
        if let Ok (dmut set) = alias self._set {
            if let Ok (dmut ubo) = alias cam:.getUBO () {
                set:.setUniform (UniformNames::CAMERA, ubo);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the texture holding the result of the tonemap pass, the output of the scene
     * */
    @field
    pub fn output (mut self)-> dmut &RefCount!{&Texture} {
        if let Ok (dmut out) = alias self._output {
            return alias out;
        }

        log::error #("ToneMapRenderScene", "Problem of configuration");
        panic;
    }

    /**
     * @returns: the group size of the compute shader used for the tone mapping
     * */
    @field
    pub fn groupSizes (self)-> [u32 ; 3] {
        if let Ok (sh) = self._computeShader {
            return sh.getGroupSizes ();
        }

        log::error #("ToneMapRenderScene", "Problem of configuration");
        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select the compute shader, and descriptor set to be used for the next command dispatch
     * */
    pub fn select (mut self, frame : u32, cmd : VkCommandBuffer) {
        let dmut set = (if let Ok (dmut s) = alias self._set {
            alias s
        } else {
            log::error #("ToneMapRenderScene", "Descriptor set malformed");
            return;
        });

        // a transient image of the render graph, changing when it is compiled again
        if let Ok (dmut win) = alias self._window {
            if let Ok (t) = win:.getVulkanPipeline ():.getTexture (self._radiance) {
                set:.setTexture ("radiance", t, frame-> cast!i32 (frame));
            } else {
                log::error #("ToneMapRenderScene", "The image", self._radiance, "is not allocated");
            }
        }

        set.select (frame, cmd);
        if let Ok (dmut sh) = alias self._computeShader {
            sh.select (cmd);
        } else {
            log::error #("ToneMapRenderScene", "Problem of configuration");
            panic;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        /**
         * Remove the output from the render graph, the descriptor set and the uniform buffer being retired with the
         * frames using them
         * */
        pub over dispose (mut self) {
            if let Ok (dmut win) = alias self._window {
                let dmut pipeline = win:.getVulkanPipeline ();
                pipeline:.stopReadingOnScreen (self._outputName);
                pipeline:.removeResource (self._outputName);

                if let Ok (dmut s) = alias self._set {
                    win:.retire (alias s);
                }

                if let Ok (dmut ubo) = alias self._ubo {
                    win:.retire (alias ubo);
                }
            }

            if let Ok (dmut output) = alias self._output {
                output:.dispose ();
            }

            if let Ok (dmut shader) = alias self._shader {
                shader:.dispose ();
            }

            self._output = none;
            self._shader = none;
            self._computeShader = none;
            self._set = none;
            self._ubo = none;
            self._window = none;
        }
    }
}
