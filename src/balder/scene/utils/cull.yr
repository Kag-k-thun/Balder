in cull;

use balder::core::{_, application::_};
use balder::core::config::shader::_;
use balder::core::shader::{_, buffers::_};
use balder::scene::utils::pyramid;

use ::vulkan::core;

/**
 * The cull pass of a scene drawing its instances culled on the GPU: the cull shader, and the descriptor set of the
 * camera it culls the instances with and of the depth pyramid it culls the occluded ones with (the descriptor sets of the
 * batches belong to their shader group)
 * */
@final
pub class CullPass {

    // The cull shader
    let dmut _shader: &RefCount!{&Shader};

    // The descriptor set of the camera
    let dmut _camera: &DescriptorSet;

    /**
     * @params:
     *    - shader: the cull shader, loaded (DefaultShaders::CULL_3D)
     * */
    pub self (dmut shader: &RefCount!{&Shader})
        with _shader = alias shader
        , _camera = shader:.get():.allocateDescriptorSet(DescriptorContext::CAMERA)
        throws BalderError
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the cull shader
     * */
    pub fn getShader(mut self)-> dmut &ComputeShader
        throws BalderError
    {
        if let Ok(dmut c: &ComputeShader) = (alias self._shader:.get())? {
            return alias c;
        }

        throw copy BalderError("The cull shader is not a compute shader");
    }

    /**
     * Set the camera the instances are culled with
     * */
    pub fn setCamera(mut self, ubo: &UniformBufferObject) {
        self._camera:.setUniform(UniformNames::CAMERA, ubo);
    }

    /**
     * Set the depth pyramid the occluded instances are culled with, bound whether they are culled or not
     * */
    pub fn setPyramid(mut self, pyramid: &DepthPyramid) {
        for f in 0u32 .. cast!u32(self._camera:.getSetHandles().len) {
            self._camera:.setBuffer(UniformNames::PYRAMID, pyramid.getBuffer(f), f);
        }
    }

    /**
     * Bind the cull shader and the descriptor set of the camera, before the descriptor sets of the batches
     * */
    pub fn select(self, frame: u32, cmd: VkCommandBuffer)
        throws BalderError
    {
        self._shader.get().select(cmd);
        self._camera.select(frame, cmd);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Retire the resources of the pass
     * @params:
     *    - window: the window retiring the resources, the recordings in use still culling with them
     * */
    pub fn retire(mut self, dmut window: &Window) {
        window:.retire(alias self._camera);
        self._shader:.dispose();
    }
}
