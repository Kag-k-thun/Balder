in compose;

use balder::utils;
use balder::core::{_, application::_};
use balder::core::config::shader;
use balder::core::config::shader::_;
use balder::core::driver::{graph, pipeline, subpass};
use balder::core::shader::{_, buffers::_};
use balder::math::vector;
use balder::scene::node::node3D::camera;
use balder::scene::utils::{cascade, deferred, shader};

use ::vulkan::core;

/**
 * The size of the uniform buffer of the ambient light, its colour (the Ambient block of the shader)
 * */
def AMBIENT_SIZE = 16us;

/**
 * The textures of the compose shader the images of the g-buffer are bound to, in the order of the attachments of the
 * deferred
 * */
enum GBufferBindings : [c8]
| NORMALS     = "normals"
| ALBEDO      = "albedo"
| MATERIAL_ID = "materialID"
| SURFACE     = "surface"
| EMISSIVE    = "emissive"
| DEPTH       = "depth";

/**
 * The format of the light the composition writes, linear and unbounded, read by the post-process chain of the scene
 * */
def RADIANCE_FORMAT = VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT;

/**
 * The record holding the data needed for the compose pass of the scene
 * */
pub record ComposeRenderScene {
    
    let dmut _shader : (&RefCount!{&Shader})? = none;    
    let dmut _set : (&DescriptorSet)? = none;

    let dmut _pass : (&ComputeSubpass)? = none;
    let dmut _computeShader : (&ComputeShader)? = none;

    // The ambient light of the scene, read by the composition
    let dmut _ambient : (&UniformBufferObject)? = none;

    // The window of the scene
    let dmut _window : (&Window)? = none;

    // The name of the subpass in the render graph, and of the light the composition writes
    let mut _passName : [c8] = "";
    let mut _radiance : [c8] = "";

    // The images of the g-buffer the composition reads, by their name in the render graph, in the order of the
    // attachments of the deferred
    let mut _gbuffer : [[c8]] = [];
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CONFIGURE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Declare the light the composition writes in the render graph, a float image read by the post-process chain, and
     * register the subpass computing it
     * @params:
     *    - passName: the name of the subpass in the render graph
     *    - radiance: the name of the light the composition writes in the render graph
     *    - defer: the g-buffer, its images read by the composition
     *    - shadow: the cascades of the shadow map, read by the composition
     *    - ambient: the ambient light of the scene (see setAmbient)
     * */
    pub fn configure (mut self,
                      passName : [c8],
                      radiance : [c8],
                      dmut win : &Window,
                      width : u32,
                      height : u32,
                      defer : DeferredRenderScene,
                      shadow : &UniformBufferObject,
                      ambient : vec3)
        throws BalderError
    {
        let dmut device = alias win:.getVulkanDevice ();

        let dmut ambientUbo = copy UniformBufferObject (alias device, AMBIENT_SIZE);
        ambientUbo:.setData (0us, ambient);
        self._ambient = (alias ambientUbo)?;

        let dmut pass = copy ComputeSubpass (alias device, passName, width, height, 1);
        self._pass = (alias pass)?;
        
        let dmut shader = win:.loadResource!{&ComputeShader} (DefaultShaders::COMPOSE_3D);
        self._shader = (alias shader)?;
        
        if let Ok (dmut c : &ComputeShader) = (alias shader:.get ())? {
            self._computeShader = (alias c)?;
        }

        {
            let dmut set = shader:.get ():.allocateDescriptorSet (DescriptorContext::GLOBAL);
            self._set = (alias set)?;            
            set:.setUniform (UniformNames::SHADOW, shadow);
            set:.setUniform (UniformNames::AMBIENT, ambientUbo);
        } catch {
            err => {
                log::error #("Scene", "Malformed deferred textures", err);
                throw copy BalderError ("Failed to configure compose pass");
            }
        }

        let dmut pipeline = win:.getVulkanPipeline ();
        pipeline:.createImage (radiance, ImageDesc (format-> RADIANCE_FORMAT, width-> width, height-> height, storage-> true));
        pipeline:.registerSubPass (passName, alias pass);

        self._window = (alias win)?;
        self._passName = passName;
        self._radiance = radiance;
        self._gbuffer = defer.shaded;
    }

    /**
     * Change the ambient light of the scene, the colour of the light reaching every point from all around, added once to
     * each pixel times the colour of its surface
     * */
    pub fn setAmbient (mut self, color : vec3) {
        if let Ok (dmut ubo) = alias self._ambient {
            ubo:.setData (0us, color);
        }
    }

    pub fn setCamera (mut self, dmut cam : &Camera) {
        if let Ok (dmut set) = alias self._set {
            if let Ok (dmut ubo) = alias cam:.getUBO () {
                set:.setUniform (UniformNames::CAMERA, ubo);
            }
        } 
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the subpass of the composition, recording the passes of the post-process chain after it
     * */
    @field
    pub fn subpass (mut self)-> dmut &ComputeSubpass {
        if let Ok (dmut pass) = alias self._pass {
            return alias pass;
        }

        log::error #("ComposeRenderScene", "Problem of configuration");
        panic;
    }

    /**
     * @returns: the group size of the compute shader used for composition
     * */
    @field
    pub fn groupSizes (self)-> [u32 ; 3] {
        if let Ok (sh) = self._computeShader {
            return sh.getGroupSizes ();
        }

        log::error #("ComposeRenderScene", "Problem of configuration");
        panic;        
    }
                                        
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select the compute shader, and descriptor set to be used for the next command dispatch
     * @params:
     *    - shadow: the shadow map, its atlas read when a light casts shadows
     * */
    pub fn select (mut self,
                   frame : u32,
                   ref shaderAssoc : ShaderNodeScene,
                   ref shadow : CascadeShadowScene,
                   cmd : VkCommandBuffer)
    {
        let dmut set = (if let Ok (dmut s) = alias self._set {
            alias s
        } else {
            log::error #("ComposeRenderScene", "Descriptor set malformed");
            return;
        });

        self.setStorage (frame, alias set, UniformNames::MATERIAL, shaderAssoc.materials.getSBO ());
        self.setStorage (frame, alias set, UniformNames::DIRECTION_LIGHT, shaderAssoc.directionLights.getSBO ());
        self.setStorage (frame, alias set, UniformNames::POINT_LIGHT, shaderAssoc.pointLights.getSBO ());
        self.setStorage (frame, alias set, UniformNames::SPOT_LIGHT, shaderAssoc.spotLights.getSBO ());

        // the images of the render graph, its transient images changing when it is compiled again
        if let Ok (dmut win) = alias self._window {
            let dmut pipeline = win:.getVulkanPipeline ();
            for i, binding in GBufferBindings::__members__ {
                self.bindImage (alias set, alias pipeline, frame, binding, self._gbuffer [i]);
            }

            // the depth stands in for the shadow map while no light casts shadows (it is never read then)
            let shadowMap = if shadow.atlas != "" { shadow.atlas } else { self._gbuffer [$ - 1] };
            self.bindImage (alias set, alias pipeline, frame, "shadowMap", shadowMap);

            if let Ok (t) = pipeline:.getTexture (self._radiance) {
                set:.setStorageTexture ("output", t, frame-> cast!i32 (frame));
            } else {
                log::error #("ComposeRenderScene", "The image", self._radiance, "is not allocated");
            }
        }
        
        set.select (frame, cmd);        
        if let Ok (dmut sh) = alias self._computeShader {
            sh.select (cmd);            
        } else {
            log::error #("ComposeRenderScene", "Problem of configuration");
            panic;
        }                
    }    

    /**
     * Bind an image of the render graph in the descriptor set of a frame
     * @params:
     *    - binding: the name of the texture in the shader
     *    - image: the name of the image in the render graph
     * */
    fn bindImage (self, dmut set : &DescriptorSet, dmut pipeline : &VulkanPipeline, frame : u32, binding : [c8], image : [c8]) {
        if let Ok (t) = pipeline:.getTexture (image) {
            set:.setTexture (binding, t, frame-> cast!i32 (frame));
        } else {
            log::error #("ComposeRenderScene", "The image", image, "is not allocated");
        }
    }

    /**
     * Set a storage buffer in the descriptor set
     * */
    fn setStorage (self, frame : u32, dmut set : &DescriptorSet, kind : [c8], sboO : (&StorageBufferObject)?) {                        
        if let Ok (sbo) = sboO {            
            set:.setBuffer (kind, sbo, frame-> cast!i32 (frame));                        
        } else { 
            log::error #("ComposeRenderScene", "Missing SBO in compose pass");            
        }
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    impl Disposable {

        /**
         * Remove the subpass and the light it writes from the render graph, the subpass and the descriptor set being
         * retired with the frames using them
         * */
        pub over dispose (mut self) {            
            if let Ok (dmut win) = alias self._window {
                let dmut pipeline = win:.getVulkanPipeline ();
                pipeline:.removeSubPass (self._passName);
                pipeline:.removeResource (self._radiance);

                if let Ok (dmut pass) = alias self._pass {
                    win:.retire (alias pass);
                }

                if let Ok (dmut s) = alias self._set {
                    win:.retire (alias s);
                }

                if let Ok (dmut ubo) = alias self._ambient {
                    win:.retire (alias ubo);
                }
            }

            if let Ok (dmut shader) = alias self._shader {
                shader:.dispose ();
            }

            self._pass = none;
            self._shader = none;
            self._computeShader = none;
            self._set = none;
            self._ambient = none;
            self._window = none;
        }
    }
}
