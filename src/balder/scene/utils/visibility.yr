in visibility;

use balder::math::{bounds, matrix};
use balder::scene::node::node3D::visual;

/**
 * An instance of the visibility, with the last culling that saw it
 * */
@final
class Seen {

    // The instance
    pub let dmut node : &VisualInstance3D;

    // The number of the last culling done by update that saw the instance, 0 when none did
    pub let mut stamp : usize = 0us;

    pub self (dmut node : &VisualInstance3D)
        with node = alias node
    {}
}

/**
 * The visual instances of a scene in a bounding volume hierarchy of their world boxes, and those seen by the camera
 * @info: an instance the camera does not see is culled, its draws drawing nothing; the instances seen are found again
 * only when the view of the camera changed or an instance moved, entered or left the scene
 * */
pub record VisibilityScene {

    // The world boxes of the instances, by uniq id
    let dmut _index : &Bvh = copy Bvh ();

    // The instances, with the last culling that saw them
    let dmut _nodes : [usize => &Seen] = copy [];

    // The instances moved since their boxes were last refit
    let dmut _moved : [usize => &VisualInstance3D] = copy [];

    // The instances seen by the camera, the other ones being culled, and their entries in the same order, the first
    // _visibleLen of the buffers; the buffers the next culling fills, swapped with them, the buffers being kept from a
    // culling to the next
    let dmut _visible : [&VisualInstance3D] = [];
    let dmut _visibleSeen : [&Seen] = [];
    let mut _visibleLen : usize = 0us;
    let dmut _nextVisible : [&VisualInstance3D] = [];
    let dmut _nextSeen : [&Seen] = [];

    // The ids of the instances the last culling by update saw, kept from a culling to the next
    let dmut _ids : [usize] = [];

    prv { // View of the last culling

        // The projection by the view of the camera
        let mut _viewProj : mat4 = mat4 ();

        // The height of the view, in pixels
        let mut _height : f32 = 0.0f;

        // The size on screen under which an instance is culled, in pixels
        let mut _minPixels : f32 = 0.0f;

        // True when the instances changed since the last culling
        let mut _dirty : bool = true;

        // The counters of the last culling
        let mut _stats : CullStats = CullStats ();

        // The number of cullings done by update
        let mut _updates : usize = 0us;

        // The stamp of the instances in the visible ones (see Seen)
        let mut _stamp : usize = 1us;

        // The number of times an instance moved, entered or left
        let mut _changes : usize = 0us;
    }

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of instances
     * */
    @field
    pub fn len (self)-> usize {
        self._nodes.len
    }

    /**
     * @returns: the counters of the last culling of the instances by the camera
     * */
    @field
    pub fn stats (self)-> CullStats {
        self._stats
    }

    /**
     * @returns: the number of cullings done by update, the instances seen changing only when it changes
     * */
    @field
    pub fn updates (self)-> usize {
        self._updates
    }

    /**
     * @returns: the number of times an instance moved, entered or left, the instances seen through a view changing only
     * when it changes
     * */
    @field
    pub fn changes (self)-> usize {
        self._changes
    }

    /**
     * @returns: the box enclosing the instances in world space, their boxes refit first
     * */
    pub fn bounds (mut self)-> Aabb {
        self:.refit ();
        self._index.bounds
    }

    /**
     * @returns: the instances seen by the camera at the last culling
     * */
    pub fn getVisible (mut self)-> dmut [&VisualInstance3D] {
        alias self._visible [0us .. self._visibleLen]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT/REMOVE          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert an instance, seen until a culling finds it is not unless it is already culled
     * */
    pub fn insert (mut self, dmut node : &VisualInstance3D) {
        if node.uid in self._nodes {
            self:.forgetVisible (node.uid);
        }

        self._index:.insert (node.uid, node:.ownBounds ());
        let dmut seen = copy Seen (alias node);
        self._nodes [node.uid] = alias seen;
        self._moved:.remove (node.uid);

        if !node.culled {
            seen.stamp = self._stamp;
            self:.setVisible (self._visibleLen, alias seen);
            self._visibleLen += 1us;
        }

        self._dirty = true;
        self._changes += 1us;
    }

    /**
     * Remove an instance
     * */
    pub fn remove (mut self, node : &VisualInstance3D) {
        if node.uid !in self._nodes { return; }

        self:.forgetVisible (node.uid);
        self._index:.remove (node.uid);
        self._nodes:.remove (node.uid);
        self._moved:.remove (node.uid);
        self._dirty = true;
        self._changes += 1us;
    }

    /**
     * Mark the box of an instance to be refit before the next culling
     * @info: does nothing when the instance was not inserted
     * */
    pub fn moved (mut self, dmut node : &VisualInstance3D) {
        if node.uid !in self._nodes { return; }

        self._moved [node.uid] = alias node;
        self._dirty = true;
        self._changes += 1us;
    }

    /**
     * Remove every instance, without drawing the culled ones again
     * */
    pub fn clear (mut self) {
        self._index:.clear ();
        self._nodes = copy [];
        self._moved = copy [];
        self._visible = [];
        self._visibleSeen = [];
        self._visibleLen = 0us;
        self._nextVisible = [];
        self._nextSeen = [];
        self._stats = CullStats ();
        self._dirty = true;
        self._changes += 1us;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CULLING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Refit the boxes of the instances moved, the hierarchy being rebuilt when the refits degraded it
     * */
    pub fn refit (mut self) {
        for uid, dmut n in alias self._moved {
            self._index:.update (uid, n:.ownBounds ());
        }

        self._moved = copy [];
        if self._index.isDegraded {
            self._index:.rebuild ();
        }
    }

    /**
     * Find the instances seen through a view, culling none of them (the view of a light...)
     * @params:
     *    - view: the view
     *    - minPixels: the size on screen in pixels under which an instance is not seen
     * @returns:
     *    - .0: the uniq ids of the instances seen
     *    - .1: the counters of the culling
     * */
    pub fn cull (mut self, view : ViewVolume, minPixels : f32)-> ([usize], CullStats) {
        self:.refit ();
        self._index.cull (view, minPixels)
    }

    /**
     * Find the instance a ray hits first, the boxes of the instances moved refit first
     * @info: the ray goes down the hierarchy of the world boxes, the instances whose box it enters telling where it hits
     * them (the triangles of a mesh...), and the boxes it enters past the closest hit skipped
     * @returns: the instance, none when the ray misses every instance
     * */
    pub fn raycast (mut self, ray : Ray)-> dmut (&VisualInstance3D)? {
        self:.refit ();

        let dmut nodes = alias self._nodes;
        let found = self._index.raycast (ray, copy |uid : usize, _ : f32| {
            if let Ok (dmut n) = alias nodes [uid] {
                if let Ok (distance) = n.node:.raycast (ray) { distance } else { f32::max }
            } else {
                f32::max
            }
        });

        if let Ok (hit) = found {
            if let Ok (dmut n) = alias self._nodes [hit.id] {
                return (alias n.node)?;
            }
        }

        none
    }

    /**
     * Draw again every instance, none being culled until the next update (the instances are culled elsewhere, on the
     * GPU...), which culls them whatever the view
     * @returns: true iif the draws of an instance changed and the commands have to be recorded again to draw them
     * */
    pub fn showAll (mut self)-> bool {
        let mut redraw = false;
        let mut n = 0us;
        for _, dmut s in alias self._nodes {
            s.stamp = self._stamp;
            self:.setVisible (n, alias s);
            n += 1us;
            if s.node.culled {
                if s.node:.setCulled (false) { redraw = true; }
            }
        }

        self._visibleLen = n;
        self._dirty = true;
        redraw
    }

    /**
     * Cull the instances the camera does not see and draw again the ones it sees, when its view or the instances
     * changed since the last update
     * @params:
     *    - viewProj: the projection by the view of the camera
     *    - height: the height of the view, in pixels
     *    - minPixels: the size on screen in pixels under which an instance is culled
     * @returns: true iif the draws of an instance changed and the commands have to be recorded again to draw them
     * */
    pub fn update (mut self, viewProj : mat4, height : f32, minPixels : f32)-> bool {
        if !self._dirty && viewProj == self._viewProj && height == self._height && minPixels == self._minPixels {
            return false;
        }

        self:.refit ();
        if self._ids.len < self._nodes.len {
            self._ids = copy [0us; 2us * self._nodes.len];
        }

        let stats = self._index.cull (ViewVolume (viewProj, height), minPixels, alias self._ids);
        self._viewProj = viewProj;
        self._height = height;
        self._minPixels = minPixels;
        self._stats = stats;
        self._dirty = false;
        self._updates += 1us;

        // the instances seen get the stamp of the culling, those seen by the last one keeping theirs being culled
        let previous = self._stamp;
        let stamp = previous + 1us;
        let mut redraw = false;
        let mut n = 0us;
        for i in 0us .. stats.visible {
            if let Ok (dmut s) = alias self._nodes [self._ids [i]] {
                if s.stamp != previous {
                    if s.node:.setCulled (false) { redraw = true; }
                }

                s.stamp = stamp;
                self:.setNext (n, alias s);
                n += 1us;
            }
        }

        for i in 0us .. self._visibleLen {
            let dmut s = alias self._visibleSeen [i];
            if s.stamp != stamp {
                if s.node:.setCulled (true) { redraw = true; }
            }
        }

        // the buffers of the instances seen swapped, those of the last culling filled by the next one
        let dmut visible = alias self._visible;
        let dmut visibleSeen = alias self._visibleSeen;
        self._visible = alias self._nextVisible;
        self._visibleSeen = alias self._nextSeen;
        self._nextVisible = alias visible;
        self._nextSeen = alias visibleSeen;
        self._visibleLen = n;

        self._stamp = stamp;
        redraw
    }

    /**
     * Remove an instance from the instances seen, when it is one of them, the others keeping their order
     * */
    fn forgetVisible (mut self, uid : usize) {
        let mut n = 0us;
        for i in 0us .. self._visibleLen {
            if self._visibleSeen [i].node.uid != uid {
                if n != i {
                    self._visible [n] = alias self._visible [i];
                    self._visibleSeen [n] = alias self._visibleSeen [i];
                }

                n += 1us;
            }
        }

        self._visibleLen = n;
    }

    /**
     * Write an instance at a place of the instances seen, after the last one or over one of them
     * */
    fn setVisible (mut self, place : usize, dmut s : &Seen) {
        if place < self._visibleSeen.len {
            self._visible [place] = alias s.node;
            self._visibleSeen [place] = alias s;
        } else {
            self._visible ~= [alias s.node];
            self._visibleSeen ~= [alias s];
        }
    }

    /**
     * Write an instance at a place of the instances the culling being done sees, after the last one or over one of them
     * */
    fn setNext (mut self, place : usize, dmut s : &Seen) {
        if place < self._nextSeen.len {
            self._nextVisible [place] = alias s.node;
            self._nextSeen [place] = alias s;
        } else {
            self._nextVisible ~= [alias s.node];
            self._nextSeen ~= [alias s];
        }
    }

}
