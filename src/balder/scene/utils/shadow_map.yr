in shadow_map;

/**
 * The shadow maps of a scene, each drawing the casters of shadows in views of its own (see ShadowCasters)
 * */
pub enum ShadowMap : u32
// The cascades of the direction light casting shadows
| CASCADES = 0
// The faces of the point lights and the cones of the spot lights casting shadows, in the tiles of an atlas
| LOCAL    = 1;
