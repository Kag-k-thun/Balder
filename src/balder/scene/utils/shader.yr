in shader;

use balder::utils;
use balder::core::{_, driver::_};
use balder::core::application::window;
use balder::core::config::shader;
use balder::core::shader;
use balder::core::shader::buffers::_;
use balder::math::{bounds, matrix, vector};
use balder::scene::node::node3D::camera;
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::{material, mesh};
use balder::scene::utils::{batch, cull, draw_stats, material, pyramid, visibility};
use balder::scene::utils::light;
use balder::scene::utils::light::{direction, point, spot};

use std::time::dur;

use ::vulkan::core;



/**
 * The shader collection holding information about loaded shaders and materials
 * */
pub record ShaderNodeScene {

    // The window drawning the scene
    let dmut _window : (&Window)? = none;

    // The draws of the drawable nodes by shader name
    let dmut _groups : [[c8] => &ShaderGroup] = copy [];

    // The drawable nodes
    let dmut _nodes : [usize => &VisualInstance3D] = copy [];

    // The drawable nodes in a hierarchy of their world boxes, and those seen by the camera
    let dmut _visibility : VisibilityScene = VisibilityScene ();

    // The array containing the list of materials used by the drawable nodes
    let dmut _materials : &MaterialArray = copy MaterialArray ();

    prv { // Camera

        let mut _cam : (&UniformBufferObject)? = none;
        
    }

    prv { // Culling on the GPU

        // True when the drawable nodes are culled on the GPU, by a cull pass before the render pass of the deferred
        let mut _gpuCulling : bool = false;

        // The cull pass, loaded when the nodes are first culled on the GPU
        let dmut _cull : (&CullPass)? = none;

        // True when the nodes hidden behind those the last frame saw are culled too, in a second phase of the cull pass
        // testing them against the depth pyramid of the nodes drawn by the first phase
        let mut _occlusionCulling : bool = false;

        // The depth pyramid of the deferred, loaded with the cull pass
        let dmut _pyramid : (&DepthPyramid)? = none;

    }

    prv { // Sorting

        // The eye the draws were last sorted from
        let mut _sortedEye : vec3 = vec3 ();

        // The culling of the visibility the draws were last sorted after
        let mut _sortedUpdate : usize = 0us;

    }
    
    prv { // lights
    
        // The direction lights of the scene, as the composition reads them
        let dmut _directionLights : &LightArray!{DirectionLightContent} = copy LightArray!{DirectionLightContent} ();

        // The point lights of the scene, as the composition reads them
        let dmut _pointLights : &LightArray!{PointLightContent} = copy LightArray!{PointLightContent} ();

        // The spot lights of the scene, as the composition reads them
        let dmut _spotLights : &LightArray!{SpotLightContent} = copy LightArray!{SpotLightContent} ();
        
    }

    prv { // Shadows

        // The subpass of the shadow map when a light casts shadows, the shaders drawing their casters in it
        let dmut _shadowPass : (&DrawSubpass)? = none;

        // The buffer holding the camera of each cascade of the shadow map, the view of the light, and their offsets
        let mut _shadowCameras : (&UniformBufferObject)? = none;
        let mut _shadowOffsets : [usize] = [];

    }

    prv { // Deferred
        
        // The name of the depth of the deferred in the render graph of the window, reduced into the depth pyramid
        let mut _depth : [c8] = "";
                
        // The subpass of the deferred
        let dmut _subpass : (&DrawSubpass)? = none;
       
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - depth: the name of the depth of the deferred in the render graph of the window
     *    - subPass: the subpass of the deferred, the shaders drawing in it
     * */
    pub fn configure (mut self, dmut win : &Window, depth : [c8], dmut subPass : &DrawSubpass)
        throws BalderError
    {
        self:.dispose ();

        self._materials:.configure (alias win);
        self._directionLights:.configure (alias win);
        self._spotLights:.configure (alias win);
        self._pointLights:.configure (alias win);
                
        self._window = (alias win)?;        
        self._depth = depth;
        self._subpass = (alias subPass)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the camera used in the shaders
     * */
    pub fn setCamera (mut self, dmut cam : &Camera) {
        if let Ok (dmut ubo) = alias cam:.getUBO () {
            for _, dmut g in alias self._groups {
                g:.setCamera (ubo);
            }

            if let Ok (dmut c) = alias self._cull {
                c:.setCamera (ubo);
            }

            self._cam = (ubo)?;
        }
    }    
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the counters of the last culling of the drawable nodes by the camera, the number of nodes only when they
     * are culled on the GPU (see drawStats for what it draws)
     * */
    @field
    pub fn cullStats (self)-> CullStats {
        if self._gpuCulling {
            let mut stats = CullStats ();
            stats.considered = self._nodes.len;
            return stats;
        }

        self._visibility.stats
    }

    /**
     * @returns: true iif the drawable nodes are culled on the GPU
     * */
    @field
    pub fn gpuCulling (self)-> bool {
        self._gpuCulling
    }

    /**
     * @returns: true iif the drawable nodes hidden behind others are culled, when they are culled on the GPU
     * */
    @field
    pub fn occlusionCulling (self)-> bool {
        self._occlusionCulling
    }

    /**
     * @returns: the counters of the draws of the drawable nodes, at the last build of their commands
     * */
    @field
    pub fn drawStats (self)-> DrawStats {
        let mut stats = DrawStats ();
        for _, g in self._groups {
            let s = g.drawStats ();
            stats.multiDraws += s.multiDraws;
            stats.commands += s.commands;
            stats.instances += s.instances;
        }

        stats
    }

    /**
     * @returns: the material array of the shader associations
     * */
    @field
    pub fn materials (mut self)-> dmut &MaterialArray {
        alias self._materials
    }    

    /**
     * @returns: the array containing spot light information in the composition pass
     * */
    @field
    pub fn spotLights (mut self)-> dmut &LightArray!{SpotLightContent} {
        alias self._spotLights
    }

    /**
     * @returns: the array containing point light information in the composition pass
     * */
    @field
    pub fn pointLights (mut self)-> dmut &LightArray!{PointLightContent} {
        alias self._pointLights
    }

    /**
     * @returns: the array containing direction light information in the composition pass
     * */
    @field
    pub fn directionLights (mut self)-> dmut &LightArray!{DirectionLightContent} {
        alias self._directionLights
    }

    /**
     * @returns: the material array of the shader associations
     * */
    @field
    pub fn materials (self)-> &MaterialArray {
        self._materials
    }    

    /**
     * @returns: the array containing spot light information in the composition pass
     * */
    @field
    pub fn spotLights (self)-> &LightArray!{SpotLightContent} {
        self._spotLights
    }

    /**
     * @returns: the array containing point light information in the composition pass
     * */
    @field
    pub fn pointLights (self)-> &LightArray!{PointLightContent} {
        self._pointLights
    }

    /**
     * @returns: the array containing direction light information in the composition pass
     * */
    @field
    pub fn directionLights (self)-> &LightArray!{DirectionLightContent} {
        self._directionLights
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Place a drawable node in the draws of the shader of its material, the shader being loaded by its first node
     * @params:
     *    - material: the material of the node, attached
     *    - node: the node
     *    - mesh: the geometry of the node, placed once in the pool of the shader for the nodes drawing it
     * @returns: the place of the node in the draws, to retire after release
     * */
    pub fn register (mut self, dmut material : &Material, dmut node : &VisualInstance3D, mesh : &MeshGeometry)-> dmut &SceneDraws
        throws BalderError
    {
        let shCfg = material.shaderConfig;
        if shCfg.name !in self._groups {
            if let Ok (dmut win) = alias self._window {
                if let Ok (dmut sub) = alias self._subpass {
                    let dmut shader = win:.loadResource!{&RasterShader} (shCfg.name,
                                                                         shCfg,
                                                                         sub.getRenderPass (),
                                                                         sub.getDimension ()._0,
                                                                         sub.getDimension ()._1,
                                                                         sub.getColorCount ());

                    let dmut g = copy ShaderGroup (alias shader, shCfg);
                    if let Ok (cam) = self._cam {
                        g:.setCamera (cam);
                    }

                    if self._gpuCulling {
                        if let Ok (dmut c) = alias self._cull {
                            let dmut cullShader = alias c:.getShader ();
                            g:.setCulling (alias win, (alias cullShader)?);
                        }
                    }

                    self:.castGroupShadows (alias g);
                    self._groups [shCfg.name] = alias g;
                }
            }
        }

        if let Ok (dmut g) = alias self._groups [shCfg.name] {
            let dmut draws = g:.register (alias material, alias node, mesh);
            self._nodes [node.uid] = alias node;
            self._visibility:.insert (alias node);
            return alias draws;
        }

        throw copy BalderError ("Scene not configured");
    }

    /**
     * Remove a drawable node from the draws of the shader of its material, the shader being released with its last
     * node
     * */
    pub fn release (mut self, material : &Material, node : &VisualInstance3D) {
        self._nodes:.remove (node.uid);
        self._visibility:.remove (node);

        let name = material.shaderConfig.name;
        if let Ok (dmut win) = alias self._window {
            if let Ok (dmut g) = alias self._groups [name] {
                g:.release (alias win, material, node);
                if g.isEmpty () {
                    g:.retire (alias win);
                    self._groups:.remove (name);
                }
            }
        }
    }

    /**
     * Mark a drawable node moved, its box to be refit before the next culling
     * */
    pub fn onMoved (mut self, dmut node : &VisualInstance3D) {
        self._visibility:.moved (alias node);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          VISIBILITY          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Cull the drawable nodes the camera does not see, and draw again those it sees, unless they are culled on the GPU
     * @params:
     *    - viewProj: the projection by the view of the camera
     *    - height: the height of the view, in pixels
     *    - threshold: the size on screen under which a node is culled, in pixels
     * @returns: true iif the draws of a node changed and the commands have to be recorded again to draw them
     * */
    pub fn cull (mut self, viewProj : mat4, height : f32, threshold : f32)-> bool {
        if self._gpuCulling { return false; }

        self._visibility:.update (viewProj, height, threshold)
    }

    /**
     * Cull the drawable nodes on the GPU, by a cull pass recorded before the render pass of the deferred, or on the CPU,
     * through the hierarchy of their boxes (the reference of the GPU, and its fallback)
     * @info: the GPU culls the nodes when the device has multi-draw and the drawIndirectCount feature only, the CPU
     * culling them otherwise; the CPU selects the levels of detail of every node while the GPU culls them
     * @params:
     *    - culling: true to cull the nodes on the GPU
     * @returns: true iif the culling changed and the commands have to be recorded again
     * */
    pub fn setGpuCulling (mut self, culling : bool)-> bool {
        let dmut win = if let Ok (dmut w) = alias self._window { alias w } else { return false; };

        let device = win:.getVulkanDevice ();
        let supported = device.isMultiDraw () && device.isDrawIndirectCount ();
        if culling && !supported {
            log::warn #("Scene", "The device cannot cull on the GPU (multi-draw and drawIndirectCount), culling on the CPU");
        }

        let enabled = culling && supported;
        if enabled == self._gpuCulling { return false; }

        if enabled && !self._cull.hasValue {
            {
                let dmut shader = win:.loadResource!{&ComputeShader} (DefaultShaders::CULL_3D);
                let dmut c = copy CullPass (alias shader);
                if let Ok (cam) = self._cam {
                    c:.setCamera (cam);
                }

                let dmut p = self:.loadPyramid (alias win);
                c:.setPyramid (p);

                self._cull = (alias c)?;
                self._pyramid = (alias p)?;
            } catch {
                err => {
                    log::error #("Scene", "Failed to load the cull pass, culling on the CPU", err);
                    return false;
                }
            }
        }

        let dmut cullShader : (&ComputeShader)? = none;
        if enabled {
            if let Ok (dmut c) = alias self._cull {
                {
                    let dmut sh = c:.getShader ();
                    cullShader = (alias sh)?;
                } catch {
                    err => {
                        log::error #("Scene", "Failed to load the cull pass, culling on the CPU", err);
                        return false;
                    }
                }
            }
        }

        self._gpuCulling = enabled;
        for _, dmut g in alias self._groups {
            g:.setCulling (alias win, alias cullShader);
        }

        // the culled nodes are drawn again, the CPU culling them again from the next update when the GPU stops
        self._visibility:.showAll ();
        true
    }

    /**
     * Cull the drawable nodes hidden behind others too, when they are culled on the GPU: the cull pass draws the nodes
     * the last frame saw first, reduces their depth into a depth pyramid, then draws those of the other nodes it finds in
     * front of that depth
     * @params:
     *    - culling: true to cull the hidden nodes
     * @returns: true iif the commands have to be recorded again (the nodes are culled on the GPU)
     * */
    pub fn setOcclusionCulling (mut self, culling : bool)-> bool {
        if culling == self._occlusionCulling { return false; }

        self._occlusionCulling = culling;
        self._gpuCulling
    }

    /**
     * Find the drawable nodes seen through a view other than the camera's, culling none of them
     * @params:
     *    - view: the view (of a light...)
     *    - threshold: the size on screen under which a node is not seen, in pixels
     * @returns: the uniq ids of the nodes seen, and the counters of the culling
     * */
    pub fn findVisible (mut self, view : ViewVolume, threshold : f32)-> ([usize], CullStats) {
        self._visibility:.cull (view, threshold)
    }

    /**
     * Sort the draws of the drawable nodes seen front to back, from their distance to the eye, when the eye moved or the
     * nodes seen changed since the last sort, so the closest occluders write their depth first
     * @params:
     *    - eye: the position of the camera
     * */
    pub fn sort (mut self, eye : vec3) {
        // the cull pass writes the commands in no particular order
        if self._gpuCulling { return; }

        let update = self._visibility.updates;
        if eye == self._sortedEye && update == self._sortedUpdate { return; }

        self._sortedEye = eye;
        self._sortedUpdate = update;
        for _, dmut g in alias self._groups {
            g:.sort (eye);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SHADOWS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Draw the drawable nodes casting shadows in the cascades of a shadow map, those of the shaders loaded later too,
     * the cascades seeing none of them until they are culled (see cullShadows)
     * @params:
     *    - pass: the subpass of the shadow map
     *    - cameras: the buffer holding the camera of each cascade, the view of the light
     *    - offsets: the offset of the camera of each cascade in the buffer
     * */
    pub fn castShadows (mut self, dmut pass : &DrawSubpass, cameras : &UniformBufferObject, offsets : [usize]) {
        self._shadowPass = (alias pass)?;
        self._shadowCameras = cameras?;
        self._shadowOffsets = offsets;
        for _, dmut g in alias self._groups {
            self:.castGroupShadows (alias g);
        }
    }

    /**
     * Stop drawing the drawable nodes in a shadow map
     * */
    pub fn stopShadows (mut self) {
        if let Ok (dmut win) = alias self._window {
            for _, dmut g in alias self._groups {
                g:.stopShadows (alias win);
            }
        }

        self._shadowPass = none;
        self._shadowCameras = none;
        self._shadowOffsets = [];
    }

    /**
     * @returns: the box enclosing the drawable nodes in world space
     * */
    pub fn casterBounds (mut self)-> Aabb {
        self._visibility:.bounds ()
    }

    /**
     * @returns: the number of times a drawable node moved, entered or left, the nodes seen through a view changing only
     * when it changes
     * */
    pub fn visibilityChanges (self)-> usize {
        self._visibility.changes
    }

    /**
     * Draw in each cascade of the shadow map the nodes casting shadows it sees, and none of the others
     * @params:
     *    - volumes: the volume each cascade sees
     *    - threshold: the size under which a cascade does not draw a node, in texels of the cascade
     * @returns: true iif the commands have to be recorded again to draw them (the device has no multi-draw)
     * */
    pub fn cullShadows (mut self, volumes : [ViewVolume], threshold : f32)-> bool {
        let mut redraw = false;
        for i, v in volumes {
            let (seen, _) = self._visibility:.cull (v, threshold);
            for _, dmut g in alias self._groups {
                if g:.seeShadows (i, seen) { redraw = true; }
            }
        }

        redraw
    }

    /**
     * Lay out the draws of the nodes casting shadows for the recording of a frame of the shadow map
     * */
    pub fn layoutShadows (mut self, frame : u32) {
        for _, dmut g in alias self._groups {
            g:.layoutShadows (frame);
        }
    }

    /**
     * Record the draws of the nodes casting shadows a cascade sees, one multi-draw per shader
     * @assume: the draws of the frame are laid out (see layoutShadows), the viewport is the one of the cascade
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording of the shadow map
     *    - cascade: the index of the cascade
     * */
    pub fn drawShadows (mut self, frame : u32, dmut cmd : &IndexedDrawCommandAllocator, cascade : usize) {
        for name, dmut g in alias self._groups {
            {
                g:.drawShadows (frame, alias cmd, cascade);
            } catch {
                err => {
                    log::error #("Scene", "Failed to draw the shadows of the nodes of the shader", name, err);
                }
            }
        }
    }

    /**
     * Draw the nodes of a shader casting shadows in the shadow map, when a light casts shadows
     * */
    fn castGroupShadows (mut self, dmut g : &ShaderGroup) {
        if let Ok (dmut win) = alias self._window {
            if let Ok (dmut pass) = alias self._shadowPass {
                if let Ok (cameras) = self._shadowCameras {
                    {
                        let (w, h) = pass.getDimension ();
                        g:.castShadows (alias win, pass.getRenderPass (), w, h, cameras, self._shadowOffsets);
                    } catch {
                        err => {
                            log::error #("Scene", "Failed to draw the shadows of the shader", err);
                        }
                    }
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          LEVELS OF DETAIL          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select the levels of detail of the drawable nodes seen by the camera, and advance their cross-fades
     * @info: a culled node keeps its level and its cross-fade until it is seen again
     * @params:
     *    - camera: the camera of the scene
     *    - height: the height of the view, in pixels
     *    - threshold: the largest error to draw, in pixels
     *    - delta: the time since the last selection
     * @returns: true iif the draws of a node changed and the commands have to be recorded again to draw them
     * */
    pub fn selectLods (mut self, camera : &Camera, height : f32, threshold : f32, delta : Duration)-> bool {
        let mut changed = false;
        for _, dmut v in alias self._visibility:.getVisible () {
            if v:.selectLod (camera, height, threshold, delta) { changed = true; }
        }

        changed
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iif the nodes are culled on the GPU, in a cull pass writing their commands before they are drawn
     * */
    pub fn cullsOnGpu (self)-> bool {
        self._gpuCulling && self._cull.hasValue
    }

    /**
     * @returns: true iif the nodes hidden behind those the last frame saw are culled, in a second phase of the cull pass
     * testing them against the depth pyramid of the nodes the first phase drew
     * */
    pub fn cullsOccluded (self)-> bool {
        self.cullsOnGpu () && self.pyramidLevels () != 0u32
    }

    /**
     * Lay out the draws of the nodes for the recording of a frame, before the passes of the deferred are recorded
     * */
    pub fn prepare (mut self, frame : u32) {
        for _, dmut g in alias self._groups {
            g:.layout (frame);
        }
    }

    /**
     * Record a phase of the cull passes of the nodes culled on the GPU, writing the commands the draws of the phase read
     * @info: the counters are cleared by the first phase, and read back for the CPU by the last one
     * @params:
     *    - frame: the frame being recorded
     *    - pass: the subpass of the deferred, being recorded outside of its render pass
     *    - width: the width of the view, in pixels
     *    - height: the height of the view, in pixels
     *    - threshold: the size on screen under which a node is culled, in pixels
     *    - late: false for the first phase, true for the second one, testing the nodes against the depth pyramid
     * */
    pub fn recordCull (mut self, frame : u32, dmut pass : &DrawSubpass, width : f32, height : f32, threshold : f32, late : bool) {
        if !self._gpuCulling { return; }

        let levels = self.pyramidLevels ();
        if let Ok (dmut cull) = alias self._cull {
            let dmut cmd = copy CullCommandAllocator (alias pass);
            {
                if !late {
                    for _, dmut g in alias self._groups {
                        g:.clearCounters (alias cmd);
                    }

                    cmd:.afterClear ();
                }

                cull.select (frame, cmd.getCommandBuffer ());
                for _, dmut g in alias self._groups {
                    g:.cull (frame, alias cmd, late, width, height, threshold, levels);
                }

                cmd:.afterCull ();
                for _, dmut g in alias self._groups {
                    g:.writeCommands (frame, alias cmd, late);
                }

                // the counters are complete once the last phase wrote its commands
                if late || levels == 0u32 {
                    self:.readBack (alias cmd);
                }
            } catch {
                err => {
                    log::error #("Scene", "Failed to record the cull passes", err);
                }
            }
        }
    }

    /**
     * Record the reduction of the depth of the deferred into the depth pyramid, once the first phase of the draws wrote
     * it
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command buffer of the deferred, outside of its render pass
     * */
    pub fn recordPyramid (mut self, frame : u32, cmd : VkCommandBuffer) {
        if let Ok (dmut win) = alias self._window {
            if let Ok (dmut p) = alias self._pyramid {
                if let Ok (depth) = win:.getVulkanPipeline ():.getTexture (self._depth) {
                    {
                        p:.build (frame, cmd, depth);
                    } catch {
                        err => {
                            log::error #("Scene", "Failed to record the depth pyramid", err);
                        }
                    }
                }
            }
        }
    }

    /**
     * Record the draws of the nodes, one multi-draw per shader and material key: the depth of every node first, written
     * by the depth prepass of the shaders having one, then the nodes, each pixel being shaded by its closest fragment
     * @assume: the draws of the frame are laid out, see prepare
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording
     *    - late: false for the draws of the first phase of the cull passes (every draw when the nodes are culled on the
     *            CPU), true for those of the second one
     * */
    pub fn drawGroups (mut self, frame : u32, dmut cmd : &IndexedDrawCommandAllocator, late : bool) {
        for name, dmut g in alias self._groups {
            {
                g:.drawDepth (frame, alias cmd, late);
            } catch {
                err => {
                    log::error #("Scene", "Failed to draw the depth of the nodes of the shader", name, err);
                }
            }
        }

        for name, dmut g in alias self._groups {
            {
                g:.draw (frame, alias cmd, late);
            } catch {
                err => {
                    log::error #("Scene", "Failed to draw the nodes of the shader", name, err);
                }
            }
        }
    }

    /**
     * Record the copy of the counters of the cull passes for the CPU, once their commands are written
     * */
    fn readBack (mut self, dmut cmd : &CullCommandAllocator) {
        cmd:.beforeReadBack ();
        for _, dmut g in alias self._groups {
            g:.readBack (alias cmd);
        }

        cmd:.afterReadBack ();
    }

    /**
     * @returns: the number of levels of the depth pyramid the hidden nodes are tested against, 0 when they are not culled
     * */
    fn pyramidLevels (self)-> u32 {
        if !self._occlusionCulling { return 0u32; }
        if let Ok (p) = self._pyramid {
            return p.getLevelCount ();
        }

        0u32
    }

    /**
     * Load the depth pyramid of the depth of the deferred
     * */
    fn loadPyramid (mut self, dmut win : &Window)-> dmut &DepthPyramid
        throws BalderError
    {
        if let Ok (sub) = self._subpass {
            let dmut shader = win:.loadResource!{&ComputeShader} (DefaultShaders::PYRAMID_3D);
            let (w, h) = sub.getDimension ();
            return copy DepthPyramid (alias shader, w, h);
        }

        throw copy BalderError ("The deferred has no depth to build a depth pyramid from");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self._nodes = copy [];
            self._visibility:.clear ();

            if let Ok (dmut win) = alias self._window {
                for _, dmut g in alias self._groups {
                    g:.retire (alias win);
                }

                if let Ok (dmut c) = alias self._cull {
                    c:.retire (alias win);
                }

                if let Ok (dmut p) = alias self._pyramid {
                    p:.retire (alias win);
                }
            }

            self._groups = copy [];
            self._shadowPass = none;
            self._shadowCameras = none;
            self._shadowOffsets = [];
            self._cull = none;
            self._pyramid = none;
            self._gpuCulling = false;
            self._materials:.dispose ();
            self._directionLights:.dispose ();
            self._spotLights:.dispose ();
            self._pointLights:.dispose ();
        }
    }
    
}
