in shader;

use balder::utils;
use balder::core::{_, driver::_};
use balder::core::application::window;
use balder::core::shader::{_, buffers::_};
use balder::math::{bounds, matrix, vector};
use balder::scene::node::node3D::camera;
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::{material, mesh};
use balder::scene::utils::{batch, light, material, visibility};

use std::time::dur;



/**
 * The shader collection holding information about loaded shaders and materials
 * */
pub record ShaderNodeScene {

    // The window drawning the scene
    let dmut _window : (&Window)? = none;

    // The draws of the drawable nodes by shader name
    let dmut _groups : [[c8] => &ShaderGroup] = copy [];

    // The drawable nodes
    let dmut _nodes : [usize => &VisualInstance3D] = copy [];

    // The drawable nodes in a hierarchy of their world boxes, and those seen by the camera
    let dmut _visibility : VisibilityScene = VisibilityScene ();

    // The list of drawable nodes that casts shadows
    let dmut _shadowMeshes : [usize => &VisualInstance3D] = copy [];    

    // The array containing the list of materials used by the drawable nodes
    let dmut _materials : &MaterialArray = copy MaterialArray ();

    prv { // Camera

        let mut _cam : (&UniformBufferObject)? = none;
        
    }

    prv { // Sorting

        // The eye the draws were last sorted from
        let mut _sortedEye : vec3 = vec3 ();

        // The culling of the visibility the draws were last sorted after
        let mut _sortedUpdate : usize = 0us;

    }
    
    prv { // lights
    
        // The array containing the list of lights in the scene
        let dmut _directionLights : &LightArray = copy LightArray ();

        // The array containing the list of lights in the scene
        let dmut _pointLights : &LightArray = copy LightArray ();

        // The array containing the list of lights in the scene
        let dmut _spotLights : &LightArray = copy LightArray ();
        
    }

    prv { // Deferred
        
        // The output texture of deferred (to created shaders)
        let mut _outputTextures : [&OutputTexture] = [];
                
        // The subpass of the deferred
        let dmut _subpass : (&DrawSubpass)? = none;
       
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn configure (mut self, dmut win : &Window, outTex : [&OutputTexture], dmut subPass : &DrawSubpass)
        throws BalderError
    {
        self:.dispose ();

        self._materials:.configure (alias win);
        self._directionLights:.configure (alias win);
        self._spotLights:.configure (alias win);
        self._pointLights:.configure (alias win);
                
        self._window = (alias win)?;        
        self._outputTextures = outTex;
        self._subpass = (alias subPass)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the camera used in the shaders
     * */
    pub fn setCamera (mut self, dmut cam : &Camera) {
        if let Ok (dmut ubo) = alias cam:.getUBO () {
            for _, dmut g in alias self._groups {
                g:.setCamera (ubo);
            }

            self._cam = (ubo)?;
        }
    }    
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the counters of the last culling of the drawable nodes by the camera
     * */
    @field
    pub fn cullStats (self)-> CullStats {
        self._visibility.stats
    }

    /**
     * @returns: the material array of the shader associations
     * */
    @field
    pub fn materials (mut self)-> dmut &MaterialArray {
        alias self._materials
    }    

    /**
     * @returns: the array containing spot light information in the composition pass
     * */
    @field
    pub fn spotLights (mut self)-> dmut &LightArray {
        alias self._spotLights
    }

    /**
     * @returns: the array containing point light information in the composition pass
     * */
    @field
    pub fn pointLights (mut self)-> dmut &LightArray {
        alias self._pointLights
    }

    /**
     * @returns: the array containing point light information in the composition pass
     * */
    @field
    pub fn directionLights (mut self)-> dmut &LightArray {
        alias self._directionLights
    }

    /**
     * @returns: the material array of the shader associations
     * */
    @field
    pub fn materials (self)-> &MaterialArray {
        self._materials
    }    

    /**
     * @returns: the array containing spot light information in the composition pass
     * */
    @field
    pub fn spotLights (self)-> &LightArray {
        self._spotLights
    }

    /**
     * @returns: the array containing point light information in the composition pass
     * */
    @field
    pub fn pointLights (self)-> &LightArray {
        self._pointLights
    }

    /**
     * @returns: the array containing point light information in the composition pass
     * */
    @field
    pub fn directionLights (self)-> &LightArray {
        self._directionLights
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Place a drawable node in the draws of the shader of its material, the shader being loaded by its first node
     * @params:
     *    - material: the material of the node, attached
     *    - node: the node
     *    - mesh: the geometry of the node, placed once in the pool of the shader for the nodes drawing it
     * @returns: the place of the node in the draws, to retire after release
     * */
    pub fn register (mut self, dmut material : &Material, dmut node : &VisualInstance3D, mesh : &MeshGeometry)-> dmut &SceneDraws
        throws BalderError
    {
        let shCfg = material.shaderConfig;
        if shCfg.name !in self._groups {
            if let Ok (dmut win) = alias self._window {
                if let Ok (dmut sub) = alias self._subpass {
                    let dmut shader = win:.loadResource!{&RasterShader} (shCfg.name,
                                                                         shCfg,
                                                                         sub.getRenderPass (),
                                                                         sub.getDimension ()._0,
                                                                         sub.getDimension ()._1,
                                                                         self._outputTextures);

                    let dmut g = copy ShaderGroup (alias shader, shCfg);
                    if let Ok (cam) = self._cam {
                        g:.setCamera (cam);
                    }

                    self._groups [shCfg.name] = alias g;
                }
            }
        }

        if let Ok (dmut g) = alias self._groups [shCfg.name] {
            let dmut draws = g:.register (alias material, alias node, mesh);
            self._nodes [node.uid] = alias node;
            self._visibility:.insert (alias node);
            return alias draws;
        }

        throw copy BalderError ("Scene not configured");
    }

    /**
     * Remove a drawable node from the draws of the shader of its material, the shader being released with its last
     * node
     * */
    pub fn release (mut self, material : &Material, node : &VisualInstance3D) {
        self._nodes:.remove (node.uid);
        self._visibility:.remove (node);

        let name = material.shaderConfig.name;
        if let Ok (dmut win) = alias self._window {
            if let Ok (dmut g) = alias self._groups [name] {
                g:.release (alias win, material, node);
                if g.isEmpty () {
                    g:.retire (alias win);
                    self._groups:.remove (name);
                }
            }
        }
    }

    /**
     * Mark a drawable node moved, its box to be refit before the next culling
     * */
    pub fn onMoved (mut self, dmut node : &VisualInstance3D) {
        self._visibility:.moved (alias node);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          VISIBILITY          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Cull the drawable nodes the camera does not see, and draw again those it sees
     * @params:
     *    - viewProj: the projection by the view of the camera
     *    - height: the height of the view, in pixels
     *    - threshold: the size on screen under which a node is culled, in pixels
     * @returns: true iif the draws of a node changed and the commands have to be recorded again to draw them
     * */
    pub fn cull (mut self, viewProj : mat4, height : f32, threshold : f32)-> bool {
        self._visibility:.update (viewProj, height, threshold)
    }

    /**
     * Find the drawable nodes seen through a view other than the camera's, culling none of them
     * @params:
     *    - view: the view (of a light...)
     *    - threshold: the size on screen under which a node is not seen, in pixels
     * @returns: the uniq ids of the nodes seen, and the counters of the culling
     * */
    pub fn findVisible (mut self, view : ViewVolume, threshold : f32)-> ([usize], CullStats) {
        self._visibility:.cull (view, threshold)
    }

    /**
     * Sort the draws of the drawable nodes seen front to back, from their distance to the eye, when the eye moved or the
     * nodes seen changed since the last sort, so the closest occluders write their depth first
     * @params:
     *    - eye: the position of the camera
     * */
    pub fn sort (mut self, eye : vec3) {
        let update = self._visibility.updates;
        if eye == self._sortedEye && update == self._sortedUpdate { return; }

        self._sortedEye = eye;
        self._sortedUpdate = update;
        for _, dmut g in alias self._groups {
            g:.sort (eye);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          LEVELS OF DETAIL          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select the levels of detail of the drawable nodes seen by the camera, and advance their cross-fades
     * @info: a culled node keeps its level and its cross-fade until it is seen again
     * @params:
     *    - camera: the camera of the scene
     *    - height: the height of the view, in pixels
     *    - threshold: the largest error to draw, in pixels
     *    - delta: the time since the last selection
     * @returns: true iif the draws of a node changed and the commands have to be recorded again to draw them
     * */
    pub fn selectLods (mut self, camera : &Camera, height : f32, threshold : f32, delta : Duration)-> bool {
        let mut changed = false;
        for _, dmut v in alias self._visibility:.getVisible () {
            if v:.selectLod (camera, height, threshold, delta) { changed = true; }
        }

        changed
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Record the draws of the nodes, one multi-draw per shader and material key: the depth of every node first, written
     * by the depth prepass of the shaders having one, then the nodes, each pixel being shaded by its closest fragment
     * */
    pub fn draw (mut self, frame : u32, dmut cmd : &IndexedDrawCommandAllocator) {
        for _, dmut g in alias self._groups {
            g:.layout (frame);
        }

        for name, dmut g in alias self._groups {
            {
                g:.drawDepth (frame, alias cmd);
            } catch {
                err => {
                    log::error #("Scene", "Failed to draw the depth of the nodes of the shader", name, err);
                }
            }
        }

        for name, dmut g in alias self._groups {
            {
                g:.draw (frame, alias cmd);
            } catch {
                err => {
                    log::error #("Scene", "Failed to draw the nodes of the shader", name, err);
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self._nodes = copy [];
            self._visibility:.clear ();

            if let Ok (dmut win) = alias self._window {
                for _, dmut g in alias self._groups {
                    g:.retire (alias win);
                }
            }

            self._groups = copy [];
            self._materials:.dispose ();
            self._directionLights:.dispose ();
            self._spotLights:.dispose ();
            self._pointLights:.dispose ();
        }
    }
    
}
