in frame_motion;

use balder::scene::node::node3D::camera;
use balder::scene::utils::motion;

/**
 * The motion trackers of the shaders of a scene and its camera, advanced at the submission of each frame (see
 * MotionTracker::advanceFrame and Camera::advanceFrame) under their own locks, without the lock of the scene: the
 * rendering thread submitting a frame does not wait for the tick culling the scene
 * */
@final
pub class FrameMotion {

    // The motion trackers, by name of the shader of their objects
    let dmut _trackers: [[c8] => &MotionTracker] = copy [];

    // The camera of the scene
    let dmut _camera: (&Camera)? = none;

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Advance the motion tracker of the objects of a shader at the submission of each frame
     * @params:
     *    - shader: the name of the shader
     *    - tracker: the motion tracker of its objects
     * */
    pub fn track(mut self, shader: [c8], dmut tracker: &MotionTracker) {
        atomic self {
            self._trackers[shader] = alias tracker;
        }
    }

    /**
     * Stop advancing the motion tracker of a shader, released with its last object
     * */
    pub fn forget(mut self, shader: [c8]) {
        atomic self {
            self._trackers:.remove(shader);
        }
    }

    /**
     * Advance the camera of the scene at the submission of each frame, the one before it no longer
     * */
    pub fn setCamera(mut self, dmut cam: &Camera) {
        atomic self {
            self._camera = (alias cam)?;
        }
    }

    /**
     * Forget the trackers and the camera
     * */
    pub fn clear(mut self) {
        atomic self {
            self._trackers = copy [];
            self._camera = none;
        }
    }

    /**
     * Write the worlds the last frame drew in the slots of the objects moving, and the projection by the view the last
     * frame drew with in the camera, for the frame being submitted
     * @info: the trackers and the camera are advanced outside the lock of the motion, under their own
     * */
    pub fn advanceFrame(mut self) {
        let dmut trackers = atomic self {
            let dmut list: [&MotionTracker] = [];
            for _, dmut t in alias self._trackers {
                list ~= [alias t];
            }

            alias list
        };

        let dmut camera = atomic self {
            alias self._camera
        };

        for dmut t in alias trackers {
            t:.advanceFrame();
        }

        if let Ok(dmut cam) = alias camera {
            cam:.advanceFrame();
        }
    }
}
