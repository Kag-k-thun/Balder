in view;

use balder::math::matrix;

/**
 * A view of the shadow of a point or a spot light, a face of the cube around a point light or the cone of a spot light,
 * seen from the light through a perspective projection
 * */
@data
pub record ShadowView {

    // The projection by the view of the light, from world space to the clip space of the view, its depth in [0, 1]
    // growing away from the light
    pub let viewProj: mat4 = mat4();

    // The size of a texel of the view at a depth of one unit in front of the light, in world units, the size of a texel
    // growing with the depth
    pub let texel: f32 = 0.0f;

}
