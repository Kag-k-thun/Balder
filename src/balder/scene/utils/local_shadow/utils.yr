in utils;

use balder::math::{bounds, matrix, vector};
use balder::scene::node::node3D::light;
use balder::scene::utils::local_shadow::views;

use ::etc::c::memory;

/**
 * @returns: the sphere enclosing the light of a point or a spot light, its range around it, or its cone
 * */
pub fn lightBounds(light: &Light)-> Sphere {
    if light.type == LightType::SPOT {
        return spotBounds(light.worldPosition, light.worldDirection, light.outerAngle, light.range);
    }

    Sphere(light.worldPosition, light.range)
}

/**
 * @returns: true iif two lists of projections are the same
 * */
pub fn sameViews(a: [mat4], b: [mat4])-> bool {
    if a.len != b.len { return false; }
    for i, v in a {
        if v != b[i] { return false; }
    }

    true
}

/**
 * Write a value in the content of a buffer
 * @params:
 *    - content: the content
 *    - offset: the offset in bytes of the value
 *    - value: the value
 * */
pub fn put {U} (dmut content: [u8], offset: usize, value: U) {
    memcpy(cast!{*void} (content.ptr + offset), cast!{*void} (&value), U::size);
}
