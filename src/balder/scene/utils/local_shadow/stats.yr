in stats;

use std::time::dur;

/**
 * The counters of the shadows of the point and spot lights of a scene, at the last tick of the scene
 * */
@data
pub record ShadowStats {

    // The point and spot lights casting shadows
    pub let mut casters: u32 = 0u32;

    // The lights shadowed by the frames, those seen by the camera with a tile in the atlas
    pub let mut lights: u32 = 0u32;

    // The views drawn in the atlas, six for a point light, one for a spot light
    pub let mut views: u32 = 0u32;

    // The texels of the atlas covered by the tiles of the views
    pub let mut texels: u64 = 0u64;

    // The time the GPU took to draw the atlas at the last submission measured
    pub let mut time: Duration = dur::micros(0u64);

}
