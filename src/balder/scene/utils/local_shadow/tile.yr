in tile;

/**
 * A square tile of the atlas of the shadows of the point and spot lights, in texels of the atlas from its top left
 * corner
 * */
@data
pub record ShadowTile {

    // The column and the row of the top left texel of the tile
    pub let x: u32 = 0u32;
    pub let y: u32 = 0u32;

    // The number of texels on a side of the tile, 0 for no tile
    pub let side: u32 = 0u32;

}
