in layout;

/**
 * The layout of the levels of a depth pyramid (a hierarchical depth buffer) in a storage buffer, one float per texel
 * @info: the level k (from 1) of a depth of 'width' by 'height' texels holds ceil (width / 2^k) by ceil (height / 2^k)
 * texels, each the largest depth of the 2x2 texels of the level k - 1 it covers (the depth itself for k = 1, clamped at
 * its edges), so the texel (x, y) of the depth is covered by the texel (x >> k, y >> k) of the level k
 * @info: the levels follow each other from the level 1, row by row, the last level holding a single texel; the level 0,
 * the depth itself, is not copied
 * */

/**
 * @returns: the number of levels of the pyramid of a depth of 'width' by 'height' texels, the last one holding a single
 * texel, 1 at least
 * */
pub fn levelCount(width: u32, height: u32)-> u32 {
    let mut count = 1u32;
    while levelWidth(width, count) > 1u32 || levelHeight(height, count) > 1u32 {
        count += 1u32;
    }

    count
}

/**
 * @returns: the number of texels on a row of the level 'level' (from 1) of the pyramid of a depth 'width' texels wide
 * */
pub fn levelWidth(width: u32, level: u32)-> u32 {
    halve(width, level)
}

/**
 * @returns: the number of rows of the level 'level' (from 1) of the pyramid of a depth 'height' texels high
 * */
pub fn levelHeight(height: u32, level: u32)-> u32 {
    halve(height, level)
}

/**
 * @returns: the index of the first texel of the level 'level' (from 1) of the pyramid of a depth of 'width' by 'height'
 * texels
 * */
pub fn levelOffset(width: u32, height: u32, level: u32)-> u32 {
    let mut offset = 0u32;
    for k in 1u32 .. level {
        offset += levelWidth(width, k) * levelHeight(height, k);
    }

    offset
}

/**
 * @returns: the number of texels of the levels of the pyramid of a depth of 'width' by 'height' texels
 * */
pub fn pyramidSize(width: u32, height: u32)-> u32 {
    levelOffset(width, height, levelCount(width, height) + 1u32)
}

/**
 * @returns: the level (from 1) of the pyramid of a depth of 'width' by 'height' texels whose texels covering the rect
 * [x0, x1] x [y0, y1] of texels of the depth are 2x2 at most, the last level when the rect is larger
 * @info: the test of the cull pass, the rect of a box being occluded when its closest depth lies behind the largest depth
 * of these texels
 * */
pub fn levelOf(width: u32, height: u32, x0: u32, y0: u32, x1: u32, y1: u32)-> u32 {
    let extent = if x1 - x0 > y1 - y0 { x1 - x0 + 1u32 } else { y1 - y0 + 1u32 };

    let mut level = 1u32;
    while (1u32 << level) < extent {
        level += 1u32;
    }

    let last = levelCount(width, height);
    if level > last { last } else { level }
}

/**
 * @returns: ceil (size / 2^level), 1 at least
 * */
fn halve(size: u32, level: u32)-> u32 {
    let mut s = size;
    for _ in 0u32 .. level {
        s = (s + 1u32) / 2u32;
    }

    if s == 0u32 { 1u32 } else { s }
}
