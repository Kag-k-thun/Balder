in spot;

use balder::math::{utils, vector};
use balder::scene::node::node3D::light;

use std::math;
use std::algorithm::comparison;

/**
 * The smallest difference between the cosines of the edges of the cone of a spot light, the light fading out between
 * them even when the angles are the same
 * */
def CONE_EPSILON = 0.0001f;

/**
 * A spot light as the composition reads it (the SpotLight of the shader, std430)
 * */
pub record SpotLightContent {

    // The position of the light, in world space
    pub let position: vec3;

    // The distance from the light at which its light fades out
    pub let range: f32;

    // The unit direction the light shines along, in world space
    pub let direction: vec3;

    // The intensity of the light, scaling its colour, the illuminance of a surface facing it at a distance d being
    // divided by d²
    pub let intensity: f32;

    pub let color: vec3;

    // The cosines of the angles between the axis of the cone and the edges of its full light and of its light, the
    // inner one greater than the outer one
    pub let cosInner: f32;
    pub let cosOuter: f32;

    pub let padd1: f32 = 0.0f;
    pub let padd2: f32 = 0.0f;
    pub let padd3: f32 = 0.0f;

    /**
     * The spot light the composition reads for a light
     * @info: the angles of the cone are clamped to a quarter turn, the full light being inside the light
     * */
    pub self (light: &Light)
        with position = light.worldPosition
        , range = light.range
        , direction = light.worldDirection
        , intensity = light.intensity
        , color = light.color
        , cosOuter = math::cos(utils::radian(clamp(light.outerAngle, 0.0f, 90.0f)))
        , cosInner = max(math::cos(utils::radian(clamp(light.innerAngle, 0.0f, 90.0f))), self.cosOuter + CONE_EPSILON)
    {}
}
