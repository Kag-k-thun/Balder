in direction;

use balder::math::vector;
use balder::scene::node::node3D::light;

/**
 * A direction light as the composition reads it (the DirectionLight of the shader, std430)
 * */
pub record DirectionLightContent {

    // The unit direction the light shines along, in world space
    pub let direction: vec3;

    // The illuminance of a surface facing the light, scaling its colour
    pub let intensity: f32;

    pub let color: vec3;
    pub let padd: f32 = 0.0f;

    /**
     * The direction light the composition reads for a light
     * */
    pub self (light: &Light)
        with direction = light.worldDirection
        , intensity = light.intensity
        , color = light.color
    {}
}
