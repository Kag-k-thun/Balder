in point;

use balder::math::vector;
use balder::scene::node::node3D::light;

/**
 * A point light as the composition reads it (the PointLight of the shader, std430)
 * */
pub record PointLightContent {

    // The position of the light, in world space
    pub let position: vec3;

    // The distance from the light at which its light fades out
    pub let range: f32;

    pub let color: vec3;

    // The intensity of the light, scaling its colour, the illuminance of a surface facing it at a distance d being
    // divided by d²
    pub let intensity: f32;

    /**
     * The point light the composition reads for a light
     * */
    pub self (light: &Light)
        with position = light.worldPosition
        , range = light.range
        , color = light.color
        , intensity = light.intensity
    {}
}
