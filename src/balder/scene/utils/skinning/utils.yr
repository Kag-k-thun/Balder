in utils;

use balder::core::config::shader::_;

/**
 * @returns: the number of floats of a vertex read by the shader 'cfg'
 * */
pub fn vertexStride(cfg: &RasterShaderConfig)-> u32 {
    let mut size = 0u32;
    for _, e in cfg.entries {
        size += e._1;
    }

    size / 4u32
}

/**
 * @returns: the offset in floats of an entry in a vertex read by the shader 'cfg', the entries following each other in
 * the order of VertexEntry, negative when the vertices have no such entry
 * */
pub fn floatOffset(cfg: &RasterShaderConfig, entry: VertexEntry)-> i32 {
    let mut offset = 0u32;
    for e in VertexEntry::__members__ {
        if let Ok((_, size)) = cfg.entries[e] {
            if e == entry { return cast!i32(offset / 4u32); }
            offset += size;
        }
    }

    return -1;
}
