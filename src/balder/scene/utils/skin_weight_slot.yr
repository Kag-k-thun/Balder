in skin_weight_slot;

use balder::math::vector;

/**
 * The size of the slot of a bind vertex in the weights of the skinned geometries of a shader, a SkinWeightSlot laid out
 * as std430 aligns it
 * */
pub def SKIN_WEIGHT_STRIDE = 32us;

/**
 * The four joints moving a bind vertex and their weights, as the skin pass reads them (see skinning.comp)
 * */
@data
pub record SkinWeightSlot {

    // The weight of each joint, summing to one, all zero for a vertex no joint moves
    pub let weights: vec4 = vec4();

    // The index of each joint in the joints of the skin
    pub let joint0: u32 = 0u32;
    pub let joint1: u32 = 0u32;
    pub let joint2: u32 = 0u32;
    pub let joint3: u32 = 0u32;

    /**
     * The slot of a vertex of a mesh (see MeshArray.bones and MeshArray.weights)
     * @params:
     *    - bones: the indices of the joints in the skin
     *    - weights: their weights
     * */
    pub self (bones: vec4, weights: vec4)
        with weights = weights
        , joint0 = cast!u32(bones.x)
        , joint1 = cast!u32(bones.y)
        , joint2 = cast!u32(bones.z)
        , joint3 = cast!u32(bones.w)
    {}
}
