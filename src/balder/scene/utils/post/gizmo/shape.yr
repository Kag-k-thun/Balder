in shape;

use balder::math::vector;

use std::algorithm::comparison;

/**
 * The kinds of the shapes the gizmo effect draws
 * */
pub enum GizmoShapeKind : u32
| SEGMENT  = 0u32 // a segment of a width, its ends rounded
| TRIANGLE = 1u32 // a filled triangle
| RING     = 2u32; // a circle of a width

/**
 * A shape drawn over the image of a scene by the gizmo effect, in texels of the image from its top left corner, laid out
 * as the Shape block of its shader (std140, 48 bytes)
 * @info: the image is shown at the aspect of the scene on screen, its texels wider or narrower than high: the widths and
 * the radii are in heights of a texel, a ring being round on screen when the square enclosing it is as wide on screen
 * as it is high (see placed)
 * */
pub record GizmoShape {

    // The first point of the shape, the start of a segment, a corner of a triangle or the centre of a ring
    pub let p0: vec2;

    // The second point of the shape, the end of a segment, a corner of a triangle or the smallest corner of the square
    // enclosing a ring
    pub let p1: vec2;

    // The third corner of a triangle or the largest corner of the square enclosing a ring, unused by a segment
    pub let p2: vec2;

    // The half width of a segment or of a ring, in heights of a texel, unused by a triangle
    pub let width: f32;

    // The kind of the shape, a GizmoShapeKind
    pub let kind: u32;

    // The colour of the shape, encoded in sRGB, and its opacity
    pub let color: vec4;

    /**
     * A segment from a point to another, of a width, its ends rounded (a point when they are the same)
     * @params:
     *    - width: the width of the segment, in texels
     * */
    pub self (from: vec2, to: vec2, width: f32, color: vec4)
        with p0 = from
        , p1 = to
        , p2 = to
        , width = width / 2.0f
        , kind = GizmoShapeKind::SEGMENT
        , color = color
    {}

    /**
     * A filled triangle, its corners in any order
     * */
    pub self (a: vec2, b: vec2, c: vec2, color: vec4)
        with p0 = a
        , p1 = b
        , p2 = c
        , width = 0.0f
        , kind = GizmoShapeKind::TRIANGLE
        , color = color
    {}

    /**
     * A circle about a point, of a width, a disc of the width when its radius is 0
     * @params:
     *    - radius: the radius of the circle, in heights of a texel, to the middle of its width
     *    - width: the width of the circle, in heights of a texel
     * */
    pub self ring(centre: vec2, radius: f32, width: f32, color: vec4)
        with p0 = centre
        , p1 = centre - makeVec2(radius, radius)
        , p2 = centre + makeVec2(radius, radius)
        , width = width / 2.0f
        , kind = GizmoShapeKind::RING
        , color = color
    {}

    /**
     * A shape of each field given
     * */
    prv self fields(p0: vec2, p1: vec2, p2: vec2, width: f32, kind: u32, color: vec4)
        with p0 = p0
        , p1 = p1
        , p2 = p2
        , width = width
        , kind = kind
        , color = color
    {}

    /**
     * @returns: the radius of a ring, to the middle of its width, half the height of the square enclosing it
     * */
    @field
    pub fn radius(self)-> f32 {
        (self.p2.y - self.p1.y) / 2.0f
    }

    /**
     * @returns: the shape scaled about the origin then moved, its colour multiplied by a tint
     * @params:
     *    - centre: where the origin of the shape goes, in texels
     *    - scale: the texels a unit of the shape covers along x and along y, its widths scaled as along y; the scale of
     *             y divided by the aspect of the texels along x keeps the shape as it is on screen
     *    - tint: the colour the colour of the shape is multiplied by, its opacity too
     * */
    pub fn placed(self, centre: vec2, scale: vec2, tint: vec4)-> GizmoShape {
        GizmoShape::fields(centre + self.p0 * scale, centre + self.p1 * scale, centre + self.p2 * scale, self.width * scale.y,
                           self.kind, self.color * tint)
    }

    /**
     * @returns: the smallest corner of the box enclosing the shape, its width included
     * */
    pub fn lowCorner(self)-> vec2 {
        makeVec2(min(min(self.p0.x, self.p1.x), self.p2.x) - self.width,
                 min(min(self.p0.y, self.p1.y), self.p2.y) - self.width)
    }

    /**
     * @returns: the largest corner of the box enclosing the shape, its width included
     * */
    pub fn highCorner(self)-> vec2 {
        makeVec2(max(max(self.p0.x, self.p1.x), self.p2.x) + self.width,
                 max(max(self.p0.y, self.p1.y), self.p2.y) + self.width)
    }

    pub fn opEquals(self, other: GizmoShape)-> bool {
        self.p0 == other.p0 && self.p1 == other.p1 && self.p2 == other.p2 && self.width == other.width &&
            self.kind == other.kind && self.color == other.color
    }

}
