in utils;

use balder::scene::utils::post::gizmo::shape;

/**
 * @returns: true iif two lists hold the same shapes in the same order
 * */
pub fn sameShapes(a: [GizmoShape], b: [GizmoShape])-> bool {
    if a.len != b.len { return false; }
    for i in 0us .. a.len {
        if a[i] != b[i] { return false; }
    }

    true
}
