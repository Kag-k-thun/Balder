in description;

/**
 * An effect of a post-process chain as a scene description writes it: the kind of the effect, created by a PostRegistry
 * with its parameters, its numbers and its texts, and whether it runs
 * */
@data
pub record PostDescription {

    // The kind of the effect, the name it is registered under, naming the effect too
    pub let kind : [c8] = "";

    // The numbers among the parameters of the effect, in the order its kind takes them, the missing ones taking their
    // default
    pub let params : [f32] = [];

    // The texts among the parameters of the effect (the path of a LUT), in the order its kind takes them, the missing
    // ones taking their default
    pub let texts : [[c8]] = [];

    // False to add the effect skipped, until it is enabled
    pub let enabled : bool = true;

}
