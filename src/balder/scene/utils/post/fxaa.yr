in fxaa;

use balder::core::config::shader;
use balder::core::shader::buffers::ubo;
use balder::scene::utils::post::{effect, space};

/**
 * The size of the parameters of the anti-aliasing, its share of sub-pixel smoothing and its two thresholds (the params
 * block of the shader)
 * */
def FXAA_SIZE = 16us;

/**
 * The anti-aliasing of the screen by FXAA 3.11 (Timothy Lottes), its quality version, preset 12: in display space, the
 * luma of the colours tone mapped finding the edges, each texel on an edge blended with its neighbour across it by its
 * distance to the ends of the edge
 * @info: the effect reads the colours of the screen only, so it smooths the edges of everything drawn, the edges of the
 * textures and the text included; run it after the effects changing the colours (a grading)
 * */
@final
pub class FxaaEffect over PostEffect {

    // The share of the sub-pixel aliasing removed
    let mut _subpix : f32;

    // The contrast a texel needs with its neighbours to be on an edge, relative to the brightest of them
    let mut _edgeThreshold : f32;

    // The contrast under which the dark texels are never on an edge
    let mut _edgeThresholdMin : f32;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - name: the name of the effect in its chain
     *    - subpix: the share of the sub-pixel aliasing removed, from 0 (sharper) to 1 (softer)
     *    - edgeThreshold: the contrast a texel needs with its neighbours to be on an edge, relative to the brightest of
     *                     them, from 0.063 (slow, smooths more) to 0.333 (fast, smooths less)
     *    - edgeThresholdMin: the contrast under which the dark texels are never on an edge, from 0.0312 to 0.0833
     * */
    pub self (name : [c8] = "fxaa", subpix : f32 = 0.75f, edgeThreshold : f32 = 0.166f, edgeThresholdMin : f32 = 0.0833f)
        with super (name, PostSpace::DISPLAY, DefaultShaders::FXAA_3D, paramsSize-> FXAA_SIZE)
        , _subpix = subpix
        , _edgeThreshold = edgeThreshold
        , _edgeThresholdMin = edgeThresholdMin
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          PARAMETERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the share of the sub-pixel aliasing removed
     * */
    @field
    pub fn subpix (self)-> f32 {
        self._subpix
    }

    /**
     * Set the share of the sub-pixel aliasing removed, from 0 (sharper) to 1 (softer)
     * */
    @field
    pub fn subpix (mut self, subpix : f32) {
        self._subpix = subpix;
        self:.updateParams ();
    }

    /**
     * @returns: the contrast a texel needs with its neighbours to be on an edge
     * */
    @field
    pub fn edgeThreshold (self)-> f32 {
        self._edgeThreshold
    }

    /**
     * Set the contrast a texel needs with its neighbours to be on an edge, relative to the brightest of them
     * */
    @field
    pub fn edgeThreshold (mut self, threshold : f32) {
        self._edgeThreshold = threshold;
        self:.updateParams ();
    }

    /**
     * @returns: the contrast under which the dark texels are never on an edge
     * */
    @field
    pub fn edgeThresholdMin (self)-> f32 {
        self._edgeThresholdMin
    }

    /**
     * Set the contrast under which the dark texels are never on an edge
     * */
    @field
    pub fn edgeThresholdMin (mut self, threshold : f32) {
        self._edgeThresholdMin = threshold;
        self:.updateParams ();
    }

    prot over writeParams (self, dmut ubo : &UniformBufferObject) {
        ubo:.setData (0us, self._subpix);
        ubo:.setData (4us, self._edgeThreshold);
        ubo:.setData (8us, self._edgeThresholdMin);
    }
}
