in lut;

use balder::utils;
use balder::core::{_, application::_};
use balder::core::config::shader;
use balder::core::shader::{_, texture};
use balder::core::shader::buffers::ubo;
use balder::scene::utils::post::{effect, pass, space};

/**
 * The size of the parameters of the grading, its contribution (the params block of the shader)
 * */
def LUT_SIZE = 16us;

/**
 * The texture of the shader of the grading holding the lookup table
 * */
def LUT_TEXTURE = "lut";

/**
 * The lookup table shipped with Balder, leaving the colours as they are: the table an image editor grades
 * */
pub def NEUTRAL_LUT = "res:/lut/neutral.png";

/**
 * A colour grading through a lookup table, in display space: each colour of the screen, encoded in sRGB, replaced by the
 * colour the table holds for it, interpolated between its entries
 * @info: the table is a 3D texture of N³ entries loaded from a strip of N slices side by side, N² pixels wide and N tall
 * (see Texture3D), a 1024 × 32 image for 32³ entries; a table is made by grading a screenshot holding the neutral table
 * (NEUTRAL_LUT, written by tools/lut.py) in an image editor, then cutting the table out of it
 * */
@final
pub class LutEffect over PostEffect {

    // The file of the lookup table
    let _path : [c8];

    // The share of the colour graded in the colour written
    let mut _contribution : f32;

    // The lookup table, loaded with the effect
    let dmut _lut : (&RefCount!{&Texture})? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - name: the name of the effect in its chain
     *    - path: the file of the lookup table, a strip of slices
     *    - contribution: the share of the colour graded in the colour written, from 0 (none) to 1
     * */
    pub self (name : [c8] = "lut", path : [c8] = NEUTRAL_LUT, contribution : f32 = 1.0f)
        with super (name, PostSpace::DISPLAY, DefaultShaders::LUT_3D, paramsSize-> LUT_SIZE)
        , _path = path
        , _contribution = contribution
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CONFIGURE          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Load the compute shader of the grading, and its lookup table
     * */
    pub over configure (mut self, dmut win : &Window)
        throws BalderError
    {
        self.__super__:.configure (alias win);

        let dmut lut = win:.loadResource!{&Texture3D} (self._path);
        self._lut = (alias lut)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          PARAMETERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the file of the lookup table
     * */
    @field
    pub fn path (self)-> [c8] {
        self._path
    }

    /**
     * @returns: the share of the colour graded in the colour written
     * */
    @field
    pub fn contribution (self)-> f32 {
        self._contribution
    }

    /**
     * Set the share of the colour graded in the colour written, from 0 (none) to 1
     * */
    @field
    pub fn contribution (mut self, contribution : f32) {
        self._contribution = contribution;
        self:.updateParams ();
    }

    prot over writeParams (self, dmut ubo : &UniformBufferObject) {
        ubo:.setData (0us, self._contribution);
    }

    prot over bindTextures (self, dmut set : &DescriptorSet, _ : PostPass, frame : i32) {
        if let Ok (lut) = self._lut {
            {
                set:.setTexture (LUT_TEXTURE, lut.get (), frame-> frame);
            } catch {
                err => {
                    log::error #("LutEffect", "The lookup table is not loaded", self._path, err);
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        /**
         * Release the lookup table with the shader of the grading
         * */
        pub over dispose (mut self) {
            if let Ok (dmut lut) = alias self._lut {
                if let Ok (dmut win) = alias self._window {
                    win:.retire (alias lut);
                } else {
                    lut:.dispose ();
                }
            }

            self._lut = none;
            self.__super__:.dispose ();
        }
    }
}
