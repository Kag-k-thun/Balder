in plan;

use balder::scene::utils::post::{effect, sources, space, stage};

/**
 * The stages of a post-process chain, in the order of their passes: the effects in HDR space, then the tone mapping,
 * then the effects in display space, each reading the image the stage before it wrote, the first one the light the
 * composition wrote, and the last one writing the output of the scene
 * */
pub record PostPlan {

    // The stages, in the order of their passes
    pub let stages : [PostStage] = [];

    /**
     * A plan without stages, the chain of a scene not configured
     * */
    pub self () {}

    /**
     * @params:
     *    - effects: the effects of the chain that run, in their order in the chain, those running first in their space
     *               (see PostEffect::runsFirst) placed before the others of their space
     *    - tonemap: the tone mapping, reading the light and writing the colours of the screen
     *    - sources: the names of the images around the chain
     * */
    pub self (effects : [&PostEffect], tonemap : &PostEffect, sources : PostSources)
        with stages = planStages (effects, tonemap, sources)
    {}

    /**
     * @returns: the names of the passes, in their order
     * */
    pub fn passes (self)-> [[c8]] {
        let mut result : [[c8]] = [];
        for s in self.stages {
            result = result ~ [s.pass];
        }

        result
    }

}

/**
 * @returns: the stages of a chain (see PostPlan)
 * */
fn planStages (effects : [&PostEffect], tonemap : &PostEffect, sources : PostSources)-> [PostStage] {
    let hdr = inSpace (effects, PostSpace::HDR);
    let toneMapped = hdr.len;
    let order = hdr ~ [tonemap] ~ inSpace (effects, PostSpace::DISPLAY);

    let mut result : [PostStage] = [];
    let mut input = sources.radiance;
    for i, e in order {
        let last = i + 1us == order.len;
        let base = "post_" ~ e.name;
        let output = if last { sources.output } else { base ~ "_out_" ~ sources.scene };

        let mut reads : [[c8]] = [];
        for r in e.reads {
            reads = reads ~ [sources.image (r)];
        }

        result = result ~ [PostStage (effect-> e.name,
                                      pass-> base ~ "_" ~ sources.scene,
                                      input-> input,
                                      output-> output,
                                      reads-> reads,
                                      space-> if i < toneMapped { PostSpace::HDR } else { PostSpace::DISPLAY },
                                      last-> last)];
        input = output;
    }

    result
}

/**
 * @returns: the effects of a space in the order they run, those running first (see PostEffect::runsFirst) before the
 * others, each keeping its order among them
 * */
fn inSpace (effects : [&PostEffect], space : PostSpace)-> [&PostEffect] {
    let mut first : [&PostEffect] = [];
    let mut rest : [&PostEffect] = [];
    for e in effects if e.space == space {
        if e.runsFirst {
            first = first ~ [e];
        } else {
            rest = rest ~ [e];
        }
    }

    first ~ rest
}
