in input;

/**
 * The images of the g-buffer a post effect reads besides the image the pass before it wrote, each bound to the texture
 * of its shader named as its value
 * */
pub enum PostInput : [c8]
| DEPTH   = "depth"    // the depth of the g-buffer, the positions rebuilt from it
| NORMALS = "normals"; // the normals of the g-buffer, folded on an octahedron
