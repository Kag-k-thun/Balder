in sources;

use balder::scene::utils::post::input;

/**
 * The names in the render graph of the images around the post-process chain of a scene: the light the composition
 * writes, read by its first pass, the output of the scene, written by its last pass, and the images of the g-buffer its
 * effects read
 * */
@data
pub record PostSources {

    // The name of the scene, suffixing the names of the passes and the images of the chain
    pub let scene : [c8] = "";

    // The name of the subpass recording the passes of the chain
    pub let submission : [c8] = "";

    // The light the composition writes
    pub let radiance : [c8] = "";

    // The output of the scene, read by the screen
    pub let output : [c8] = "";

    // The depth of the g-buffer
    pub let depth : [c8] = "";

    // The normals of the g-buffer
    pub let normals : [c8] = "";

    /**
     * @returns: the name of an image of the g-buffer in the render graph
     * */
    pub fn image (self, input : PostInput)-> [c8] {
        match input {
            PostInput::DEPTH => { self.depth }
            _                => { self.normals }
        }
    }

}
