in space;

/**
 * The space of the colours a post effect reads and writes, its place in a post-process chain: before the tone mapping
 * or after it
 * */
pub enum PostSpace : u32
| HDR     = 0u32  // the light the camera sees, linear and unbounded, in float images (bloom, depth of field)
| DISPLAY = 1u32; // the colours of the screen, encoded in sRGB, in 8 bits images (FXAA, a LUT grading)
