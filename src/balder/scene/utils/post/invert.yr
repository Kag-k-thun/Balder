in invert;

use balder::core::config::shader;
use balder::scene::utils::post::{effect, space};

/**
 * The inversion of the colours of the screen, in display space, the plainest effect of a chain
 * */
@final
pub class InvertEffect over PostEffect {

    /**
     * @params:
     *    - name: the name of the effect in its chain
     * */
    pub self (name : [c8] = "invert")
        with super (name, PostSpace::DISPLAY, DefaultShaders::INVERT_3D)
    {}
}
