in pass;

use balder::core::driver::graph;

/**
 * A pass of a post effect, one dispatch of one of its shaders declared in the render graph: the images it samples, each
 * bound to a texture of the shader, and the image it writes, bound to its storage texture `output`
 * @info: an effect runs one pass by default, reading the image the stage before it wrote and writing the image the stage
 * after it reads; an effect of several passes (a bloom) writes images of its own between them, transient images of the
 * render graph
 * */
@data
pub record PostPass {

    // The name of the effect running the pass
    pub let effect : [c8] = "";

    // The name of the pass in the render graph
    pub let name : [c8] = "";

    // The place of the pass among the passes of its effect, selecting its descriptor set
    pub let index : usize = 0us;

    // The shader dispatched, its place among the shaders of the effect
    pub let shader : usize = 0us;

    // The level of the pass, pushed to the shaders taking one (the mip of a bloom)
    pub let level : u32 = 0u32;

    // The textures of the shader the pass binds, each to the image of the render graph at the same place in images
    pub let textures : [[c8]] = [];

    // The images of the render graph the pass samples
    pub let images : [[c8]] = [];

    // The image the pass writes
    pub let output : [c8] = "";

    // The description of the image the pass writes, its size the size of the dispatch
    pub let image : ImageDesc = ImageDesc ();

    // True iif the image written is imported in the render graph (the output of the scene), created there otherwise
    pub let imported : bool = false;

    /**
     * @returns: the uses of the pass: the images it samples, and the image it writes stored
     * */
    pub fn uses (self)-> [ResourceUse] {
        let mut result : [ResourceUse] = [];
        for i in self.images {
            result = result ~ [ResourceUse (resource-> i, usage-> Usage::SAMPLED_COMPUTE)];
        }

        result ~ [ResourceUse (resource-> self.output, usage-> Usage::STORAGE_WRITE)]
    }

    /**
     * @returns: the compute pass in the render graph
     * @params:
     *    - submission: the subpass recording it
     *    - recording: the recording of its dispatch
     * */
    pub fn toPass (self, submission : [c8], recording : (dg ()-> void)?)-> GraphPass {
        GraphPass (name-> self.name,
                   submission-> submission,
                   kind-> PassKind::COMPUTE,
                   uses-> self.uses (),
                   recording-> recording)
    }

}
