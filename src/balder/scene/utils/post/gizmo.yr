in gizmo;

pub mod ::shape;
mod ::utils;

use balder::core::config::shader;
use balder::core::shader::buffers::ubo;
use balder::math::vector;
use balder::scene::utils::post::{effect, space};
use balder::scene::utils::post::gizmo::shape;

use std::algorithm::comparison;

/**
 * The number of shapes the gizmo effect draws at most (MAX_SHAPES of its shader)
 * */
pub def MAX_GIZMO_SHAPES = 256us;

/**
 * The offset of the shapes in the parameters of the effect, after the box they cover and their number
 * */
def SHAPES_OFFSET = 32us;

/**
 * The size of the parameters of the effect, the box the shapes cover, their number and the shapes (the params block of
 * the shader)
 * */
def GIZMO_SIZE = SHAPES_OFFSET + MAX_GIZMO_SHAPES * 48us;

/**
 * The drawing of a gizmo over the image of a scene, in display space after the other effects (see
 * PostEffect::runsLast): the image is copied, and the shapes of the gizmo blended over it in their order, their edges
 * smoothed, testing no depth
 * @info: the shapes are written in the parameters of the effect, the frames drawing them without being recorded again;
 * the texels outside the box they cover are only copied
 * */
@final
pub class GizmoEffect over PostEffect {

    // The shapes drawn, in their order, MAX_GIZMO_SHAPES at most
    let mut _shapes: [GizmoShape] = [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - name: the name of the effect in its chain
     * */
    pub self (name: [c8] = "gizmo")
        with super(name, PostSpace::DISPLAY, DefaultShaders::GIZMO_3D, paramsSize-> GIZMO_SIZE, runsLast-> true)
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          PARAMETERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the shapes drawn, in their order
     * */
    @field
    pub fn shapes(self)-> [GizmoShape] {
        self._shapes
    }

    /**
     * Draw other shapes, the first ones drawn under the next ones, from the next frame
     * @info: nothing is written when the shapes are those drawn already, so the frames are not requested again; the
     * shapes past MAX_GIZMO_SHAPES are not drawn
     * */
    pub fn setShapes(mut self, shapes: [GizmoShape]) {
        let kept = if shapes.len > MAX_GIZMO_SHAPES { shapes[0us .. MAX_GIZMO_SHAPES] } else { shapes };
        if utils::sameShapes(kept, self._shapes) { return; }

        self._shapes = kept;
        self:.updateParams();
    }

    /**
     * @returns: the box of texels the shapes cover, its smallest corner included and its largest one excluded, from
     * the top left corner of the image (x, y, x, y), an empty box when there are no shapes
     * */
    pub fn area(self)-> ivec4 {
        if self._shapes.len == 0us { return ivec4(); }

        let mut low = self._shapes[0].lowCorner();
        let mut high = self._shapes[0].highCorner();
        for s in self._shapes {
            let l = s.lowCorner(), h = s.highCorner();
            low = makeVec2(min(low.x, l.x), min(low.y, l.y));
            high = makeVec2(max(high.x, h.x), max(high.y, h.y));
        }

        // the smoothed edges reach a texel past the shapes
        makeVec4(cast!i32(low.x) - 2, cast!i32(low.y) - 2, cast!i32(high.x) + 2, cast!i32(high.y) + 2)
    }

    prot over writeParams(self, dmut ubo: &UniformBufferObject) {
        ubo:.setData(0us, self.area());
        ubo:.setData(16us, cast!u32(self._shapes.len));
        if self._shapes.len != 0us {
            ubo:.setData(SHAPES_OFFSET, self._shapes);
        }
    }

}
