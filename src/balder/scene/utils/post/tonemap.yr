in tonemap;

pub mod ::operator;

use balder::core::config::shader;
use balder::core::shader::buffers::ubo;
use balder::scene::utils::post::{effect, space};
use balder::scene::utils::post::tonemap::operator;

/**
 * The size of the parameters of the tone mapping, its operator (the params block of the shader)
 * */
def TONE_MAP_SIZE = 16us;

/**
 * The tone mapping of a post-process chain, between its effects in HDR space and those in display space: the light the
 * composition wrote exposed by the camera, tone mapped, then encoded in sRGB
 * @info: the colours are written in sRGB through a unorm view, the screen sampling the output of the scene through an
 * sRGB view decoding them, so the framebuffer encodes them once
 * */
@final
pub class ToneMapEffect over PostEffect {

    // The operator of the tone mapping
    let mut _op : ToneMap;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - op: the operator of the tone mapping (see toneMap)
     * */
    pub self (op : ToneMap = ToneMap::AGX)
        with super ("tonemap", PostSpace::HDR, DefaultShaders::TONEMAP_3D, paramsSize-> TONE_MAP_SIZE, readsCamera-> true)
        , _op = op
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          OPERATOR          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the operator of the tone mapping
     * */
    @field
    pub fn toneMap (self)-> ToneMap {
        self._op
    }

    /**
     * Change the operator of the tone mapping, read by the next frames without recording them again
     * */
    @field
    pub fn toneMap (mut self, op : ToneMap) {
        self._op = op;
        self:.updateParams ();
    }

    prot over writeParams (self, dmut ubo : &UniformBufferObject) {
        ubo:.setData (0us, cast!u32 (self._op));
    }
}
