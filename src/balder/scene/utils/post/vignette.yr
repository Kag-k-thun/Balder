in vignette;

use balder::core::config::shader;
use balder::core::shader::buffers::_;
use balder::scene::utils::post::{effect, space};

/**
 * The size of the parameters of the vignette, its intensity, its radius and its softness (the params block of the
 * shader)
 * */
def VIGNETTE_SIZE = 16us;

/**
 * A vignette, in HDR space: the light falling toward the edges of the image, as through a lens
 * */
@final
pub class VignetteEffect over PostEffect {

    // The share of the light lost in the corners
    let mut _intensity : f32;

    // The distance from the centre where the light starts to fall
    let mut _radius : f32;

    // The distance over which the light falls, from the radius
    let mut _softness : f32;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - name: the name of the effect in its chain
     *    - intensity: the share of the light lost in the corners, from 0 (none) to 1 (black corners)
     *    - radius: the distance from the centre where the light starts to fall, 1 being a corner
     *    - softness: the distance over which the light falls, from the radius
     * */
    pub self (name : [c8] = "vignette", intensity : f32 = 0.5f, radius : f32 = 0.4f, softness : f32 = 0.6f)
        with super (name, PostSpace::HDR, DefaultShaders::VIGNETTE_3D, paramsSize-> VIGNETTE_SIZE)
        , _intensity = intensity
        , _radius = radius
        , _softness = softness
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          PARAMETERS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the share of the light lost in the corners
     * */
    @field
    pub fn intensity (self)-> f32 {
        self._intensity
    }

    /**
     * Set the share of the light lost in the corners, from 0 (none) to 1 (black corners)
     * */
    @field
    pub fn intensity (mut self, intensity : f32) {
        self._intensity = intensity;
        self:.updateParams ();
    }

    /**
     * @returns: the distance from the centre where the light starts to fall
     * */
    @field
    pub fn radius (self)-> f32 {
        self._radius
    }

    /**
     * Set the distance from the centre where the light starts to fall, 1 being a corner
     * */
    @field
    pub fn radius (mut self, radius : f32) {
        self._radius = radius;
        self:.updateParams ();
    }

    /**
     * @returns: the distance over which the light falls, from the radius
     * */
    @field
    pub fn softness (self)-> f32 {
        self._softness
    }

    /**
     * Set the distance over which the light falls, from the radius
     * */
    @field
    pub fn softness (mut self, softness : f32) {
        self._softness = softness;
        self:.updateParams ();
    }

    prot over writeParams (self, dmut ubo : &UniformBufferObject) {
        ubo:.setData (0us, self._intensity);
        ubo:.setData (4us, self._radius);
        ubo:.setData (8us, self._softness);
    }
}
