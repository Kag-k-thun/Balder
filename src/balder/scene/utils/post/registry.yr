in registry;

use balder::scene::utils::post::{description, effect, invert, vignette};

/**
 * The registry of the kinds of post effects a scene description can name, mapping the name of a kind to the function
 * creating its effects from their parameters
 * @info: the registry starts with the effects of Balder, `vignette (intensity, radius, softness)` and `invert`, and an
 * application registers its own
 * */
@final
pub class PostRegistry {

    // The functions creating the effects of each kind, by name
    let dmut _factories : [[c8] => dg ([f32])-> dmut &PostEffect] = copy [];

    /**
     * Create a registry knowing the effects of Balder
     * */
    pub self () {
        self:.register ("vignette", |p|-> dmut &PostEffect => copy VignetteEffect (intensity-> param (p, 0us, 0.5f),
                                                                                    radius-> param (p, 1us, 0.4f),
                                                                                    softness-> param (p, 2us, 0.6f)));
        self:.register ("invert", |_|-> dmut &PostEffect => copy InvertEffect ());
    }

    /**
     * Register a kind of effects, replacing the kind registered under the same name
     * @params:
     *    - kind: the name of the kind, naming the effects it creates
     *    - factory: the function creating an effect of the kind from its parameters, named kind
     * */
    pub fn register (mut self, kind : [c8], factory : dg ([f32])-> dmut &PostEffect) {
        self._factories [kind] = factory;
    }

    /**
     * @returns: the effect of a description, none if its kind is not registered
     * */
    pub fn create (self, desc : PostDescription)-> dmut (&PostEffect)? {
        if let Ok (factory) = self._factories [desc.kind] {
            return (alias factory (desc.params))?;
        }

        none
    }

    /**
     * @returns: true iif a kind of effects is registered under name
     * */
    pub fn has (self, kind : [c8])-> bool {
        self._factories [kind].hasValue
    }
}

/**
 * @returns: the parameter at index i, or its default when there are fewer parameters
 * */
fn param (params : [f32], i : usize, default : f32)-> f32 {
    if i < params.len { params [i] } else { default }
}
