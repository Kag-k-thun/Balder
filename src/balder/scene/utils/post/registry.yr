in registry;

use balder::scene::utils::post::{bloom, description, effect, fxaa, invert, lut, taa, vignette};

/**
 * The registry of the kinds of post effects a scene description can name, mapping the name of a kind to the function
 * creating its effects from their description
 * @info: the registry starts with the effects of Balder, `vignette (intensity, radius, softness)`, `invert`,
 * `fxaa (subpix, edgeThreshold, edgeThresholdMin)`, `bloom (threshold, knee, intensity, radius, levels)`,
 * `lut ("path", contribution)` and `taa (blend, clip, sharpness)`, and an application registers its own
 * */
@final
pub class PostRegistry {

    // The functions creating the effects of each kind from their description, by name
    let dmut _factories : [[c8] => dg (PostDescription)-> dmut &PostEffect] = copy [];

    /**
     * Create a registry knowing the effects of Balder
     * */
    pub self () {
        self:.register ("vignette", |d|-> dmut &PostEffect => copy VignetteEffect (intensity-> param (d, 0us, 0.5f),
                                                                                    radius-> param (d, 1us, 0.4f),
                                                                                    softness-> param (d, 2us, 0.6f)));
        self:.register ("invert", |_|-> dmut &PostEffect => copy InvertEffect ());
        self:.register ("fxaa", |d|-> dmut &PostEffect => copy FxaaEffect (subpix-> param (d, 0us, 0.75f),
                                                                            edgeThreshold-> param (d, 1us, 0.166f),
                                                                            edgeThresholdMin-> param (d, 2us, 0.0833f)));
        self:.register ("bloom", |d|-> dmut &PostEffect => copy BloomEffect (threshold-> param (d, 0us, 1.0f),
                                                                              knee-> param (d, 1us, 0.5f),
                                                                              intensity-> param (d, 2us, 0.05f),
                                                                              radius-> param (d, 3us, 1.0f),
                                                                              levels-> cast!u32 (param (d, 4us, 6.0f))));
        self:.register ("lut", |d|-> dmut &PostEffect => copy LutEffect (path-> text (d, 0us, NEUTRAL_LUT),
                                                                          contribution-> param (d, 0us, 1.0f)));
        self:.register ("taa", |d|-> dmut &PostEffect => copy TaaEffect (blend-> param (d, 0us, 0.1f),
                                                                          clip-> param (d, 1us, 1.0f),
                                                                          sharpness-> param (d, 2us, 0.25f)));
    }

    /**
     * Register a kind of effects, replacing the kind registered under the same name
     * @params:
     *    - kind: the name of the kind, naming the effects it creates
     *    - factory: the function creating an effect of the kind from its description, named kind
     * */
    pub fn register (mut self, kind : [c8], factory : dg (PostDescription)-> dmut &PostEffect) {
        self._factories [kind] = factory;
    }

    /**
     * @returns: the effect of a description, none if its kind is not registered
     * */
    pub fn create (self, desc : PostDescription)-> dmut (&PostEffect)? {
        if let Ok (factory) = self._factories [desc.kind] {
            return (alias factory (desc))?;
        }

        none
    }

    /**
     * @returns: true iif a kind of effects is registered under name
     * */
    pub fn has (self, kind : [c8])-> bool {
        self._factories [kind].hasValue
    }
}

/**
 * @returns: the number at index i among the parameters of a description, or its default when there are fewer numbers
 * */
pub fn param (desc : PostDescription, i : usize, default : f32)-> f32 {
    if i < desc.params.len { desc.params [i] } else { default }
}

/**
 * @returns: the text at index i among the parameters of a description, or its default when there are fewer texts
 * */
pub fn text (desc : PostDescription, i : usize, default : [c8])-> [c8] {
    if i < desc.texts.len { desc.texts [i] } else { default }
}
