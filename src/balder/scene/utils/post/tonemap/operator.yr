in operator;

/**
 * The operators of the tone mapping of a scene, mapping the light its camera sees, as bright as its lights make it, into
 * the colours of a screen, from 0 to 1
 * */
pub enum ToneMap : u32
| NONE = 0u32  // the light clipped to 1, every colour brighter than white turning white
| ACES = 1u32  // the filmic curve of ACES (the RRT and the ODT of the Academy Color Encoding System, fitted by Hill)
| AGX  = 2u32; // the curve of AgX (Sobotka, fitted by Wrensch), the brightest colours desaturated toward white
