in stage;

use balder::core::driver::graph;
use balder::scene::utils::post::space;

use ::vulkan::core;

/**
 * A stage of a post-process chain, an effect declared as a pass of the render graph: the image it reads, written by the
 * pass before it, and the image it writes, read by the pass after it
 * */
@data
pub record PostStage {

    // The name of the effect
    pub let effect : [c8] = "";

    // The name of the pass in the render graph
    pub let pass : [c8] = "";

    // The image the pass reads, the light the composition wrote for the first one
    pub let input : [c8] = "";

    // The image the pass writes, the output of the scene for the last one
    pub let output : [c8] = "";

    // The images of the g-buffer the pass reads, in the order of the reads of the effect
    pub let reads : [[c8]] = [];

    // The space of the colours of the image the pass writes, display after the tone mapping
    pub let space : PostSpace = PostSpace::HDR;

    // True iif the pass is the last one of the chain, writing the output of the scene, imported in the render graph
    pub let last : bool = false;

    /**
     * @returns: the description of the image the pass writes, a float image in HDR space, an 8 bits one in display space
     * holding colours encoded in sRGB
     * @assume: the pass is not the last one, its output being imported
     * */
    pub fn image (self, width : u32, height : u32)-> ImageDesc {
        let format = if self.space == PostSpace::HDR {
            VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT
        } else {
            VkFormat::VK_FORMAT_R8G8B8A8_UNORM
        };

        ImageDesc (format-> format, width-> width, height-> height, storage-> true)
    }

    /**
     * @returns: the uses of the pass: the image it reads and those of the g-buffer sampled, the image it writes stored
     * */
    pub fn uses (self)-> [ResourceUse] {
        let mut result : [ResourceUse] = copy [ResourceUse (resource-> self.input, usage-> Usage::SAMPLED_COMPUTE)];
        for r in self.reads {
            result = result ~ [ResourceUse (resource-> r, usage-> Usage::SAMPLED_COMPUTE)];
        }

        result ~ [ResourceUse (resource-> self.output, usage-> Usage::STORAGE_WRITE)]
    }

    /**
     * @returns: the compute pass of the stage in the render graph
     * @params:
     *    - submission: the subpass recording it
     *    - recording: the recording of its dispatch
     * */
    pub fn toPass (self, submission : [c8], recording : (dg ()-> void)?)-> GraphPass {
        GraphPass (name-> self.pass,
                   submission-> submission,
                   kind-> PassKind::COMPUTE,
                   uses-> self.uses (),
                   recording-> recording)
    }

}
