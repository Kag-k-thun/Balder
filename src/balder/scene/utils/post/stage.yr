in stage;

use balder::core::driver::graph;
use balder::scene::utils::post::space;

use ::vulkan::core;

/**
 * A stage of a post-process chain, an effect between the stage before it and the stage after it: the image it reads,
 * written by the stage before it, and the image it writes, read by the stage after it, the effect declaring the passes
 * of the stage in the render graph (see PostEffect::passes)
 * */
@data
pub record PostStage {

    // The name of the effect
    pub let effect : [c8] = "";

    // The name of the pass in the render graph, prefixing the names of the passes and the images of an effect of several
    pub let pass : [c8] = "";

    // The image the stage reads, the light the composition wrote for the first one
    pub let input : [c8] = "";

    // The image the stage writes, the output of the scene for the last one
    pub let output : [c8] = "";

    // The images of the g-buffer the stage reads, in the order of the reads of the effect
    pub let reads : [[c8]] = [];

    // The space of the colours of the image the stage writes, display after the tone mapping
    pub let space : PostSpace = PostSpace::HDR;

    // True iif the stage is the last one of the chain, writing the output of the scene, imported in the render graph
    pub let last : bool = false;

    /**
     * @returns: the description of the image the stage writes, a float image in HDR space, an 8 bits one in display
     * space holding colours encoded in sRGB, the output of the scene for the last stage
     * */
    pub fn image (self, width : u32, height : u32)-> ImageDesc {
        let format = if self.space == PostSpace::HDR {
            VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT
        } else {
            VkFormat::VK_FORMAT_R8G8B8A8_UNORM
        };

        ImageDesc (format-> format, width-> width, height-> height, storage-> true)
    }

}
