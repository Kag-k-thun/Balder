in tree;

use balder::utils;
use balder::core::dispose;
use balder::scene::node;
use balder::scene::node::node3D::camera;
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::material;


/**
 * The node tree of the scene
 * */
pub record NodeTreeScene {

    // The contect of the tree
    let dmut _scene : (&Scene)? = none;

    // THe root node of the tree
    let dmut _rootNode : (&Node)? = none;

    // The list of nodes contained in the tree
    let dmut _nodes : [usize => &Node] = copy [];

    // The nodes of the tree the scene ticks (see Node::ticked)
    let dmut _ticked : [usize => &Node] = copy [];

    // The cameras of the tree, in the order they entered it
    let dmut _cameras : [&Camera] = [];

    // The camera the scene is drawn through, unless a view camera draws it in its place
    let dmut _active : (&Camera)? = none;

    // The camera drawing the scene in place of the active one (the camera of an editor), none to draw through the
    // active one
    let dmut _view : (&Camera)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Configure the tree
     * */
    pub fn configure (mut self, dmut scene : &Scene) {
        self:.dispose ();
        
        self._scene = (alias scene)?;
        
        self._rootNode = (copy root::RootNode (alias self:.getScene ()))?;        
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the root node of the scene
     * */
    @field
    pub fn rootNode (mut self)-> dmut &Node {
        if let Ok (dmut r) = alias self._rootNode { 
            return alias r;
        }

        let dmut res = copy root::RootNode (alias self:.getScene ());
        self._rootNode = (alias res)?;

        alias res
    }

    /**
     * @returns: the camera the scene is drawn through, the view camera when there is one, the active camera otherwise
     * */
    @field
    pub fn camera (mut self)-> dmut (&Camera)? {
        if let Ok (dmut v) = alias self._view { return (alias v)?; }
        alias self._active
    }

    /**
     * @returns: the camera the scene is drawn through, the view camera when there is one, the active camera otherwise
     * */
    @field
    pub fn camera (self)-> (&Camera)? {
        if let Ok (v) = self._view { return v?; }
        self._active
    }

    /**
     * @returns: the cameras of the tree, in the order they entered it
     * */
    @field
    pub fn cameras (mut self)-> dmut [&Camera] {
        alias self._cameras
    }

    /**
     * @returns: the active camera of the scene, none when it has no camera
     * */
    @field
    pub fn active (mut self)-> dmut (&Camera)? {
        alias self._active
    }

    /**
     * @returns: the camera drawing the scene in place of the active one, none when the active one draws it
     * */
    @field
    pub fn view (mut self)-> dmut (&Camera)? {
        alias self._view
    }

    
    /**
     * @returns: the scene to which the tree is attached
     * */
    pub fn getScene (mut self)-> dmut &Scene {
        if let Ok (dmut c) = alias self._scene {
            return alias c;
        }

        log::error #("NodeTreeScene", "Get scene in tree that is attached to nothing");
        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT/REMOVE          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Record a node in the tree, without calling its hooks: the scene enters it once its lock is released (see
     * Scene::registerNode)
     * @returns: the node recorded before under the uid of the node, to exit
     * */
    pub fn register (mut self, dmut node : &Node)-> dmut (&Node)? {
        let dmut old = alias self._nodes [node.uid];

        self._nodes [node.uid] = alias node;
        if node.ticked {
            self._ticked [node.uid] = alias node;
        }

        alias old
    }

    /**
     * Forget a node of the tree, without calling its hooks: the scene exits it once its lock is released (see
     * Scene::removeNode); a camera is forgotten among the cameras too (see removeCamera)
     * @returns: true iif the node is to exit, a node of the tree
     * */
    pub fn remove (mut self, node : &Node)-> bool {
        if node.uid !in self._nodes { return false; }

        self._nodes:.remove (node.uid);
        self._ticked:.remove (node.uid);

        if let ca : &Camera = node {
            self:.removeCamera (ca);
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CAMERA          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a camera entering the tree to its cameras, the active camera when the scene has none, unless it is the camera
     * of a tool (named __…__, see isReservedName), which draws the scene only when it is made the view camera or the
     * active one
     * @returns: true iif the camera draws the scene from now on, the scene to give it to the passes drawing it
     * */
    pub fn addCamera (mut self, dmut cam : &Camera)-> bool {
        for c in self._cameras if c is cam { return false; }

        self._cameras ~= [alias cam];
        if !self._active.hasValue && !isReservedName (cam.name.file ()) {
            self._active = (alias cam)?;
            return !self._view.hasValue;
        }

        false
    }

    /**
     * Forget a camera leaving the tree: when it was the view camera, the active camera draws again; when it was the
     * active camera, the first of the other cameras that is not the camera of a tool becomes active, the scene having
     * no active camera when there is none
     * @returns: true iif another camera draws the scene, or none does anymore
     * */
    pub fn removeCamera (mut self, cam : &Camera)-> bool {
        let wasDrawn = if let Ok (c) = self.camera { c is cam } else { false };

        let dmut kept : [&Camera] = [];
        for dmut c in alias self._cameras if c !is cam {
            kept ~= [alias c];
        }

        self._cameras = alias kept;
        if let Ok (v) = self._view && v is cam {
            self._view = none;
        }

        if let Ok (a) = self._active && a is cam {
            self._active = none;
            for dmut c in alias self._cameras if !isReservedName (c.name.file ()) {
                self._active = (alias c)?;
                break;
            }
        }

        wasDrawn
    }

    /**
     * Make a camera of the tree the active camera of the scene, a camera not in the tree changing nothing
     * @returns: true iif the camera draws the scene from now on and did not before, no view camera drawing it instead
     * */
    pub fn setActive (mut self, dmut cam : &Camera)-> bool {
        if !self:.holds (cam) { return false; }

        let drawn = if let Ok (c) = self.camera { c is cam } else { false };
        self._active = (alias cam)?;

        !drawn && !self._view.hasValue
    }

    /**
     * Draw the scene through a camera of the tree in place of the active one, or through the active one again (none), a
     * camera not in the tree changing nothing
     * @returns: true iif another camera draws the scene from now on
     * */
    pub fn setView (mut self, dmut cam : (&Camera)?)-> bool {
        let before = if let Ok (c) = self.camera { c.uid } else { 0us };
        if let Ok (c) = cam {
            if !self:.holds (c) { return false; }
        }

        self._view = alias cam;
        let after = if let Ok (c) = self.camera { c.uid } else { 0us };

        before != after
    }

    /**
     * @returns: true iif a camera is one of the cameras of the tree
     * */
    fn holds (mut self, cam : &Camera)-> bool {
        for c in self._cameras if c is cam { return true; }
        false
    }

    /**
     * Exit the cameras of the tree, before the other nodes, the scene disposed
     * */
    fn onRemoveCameras (mut self) {
        if let Ok (dmut scene) = alias self._scene {
            let dmut cameras = alias self._cameras;
            self._cameras = [];
            self._active = none;
            self._view = none;

            for dmut cam in alias cameras {
                self._nodes:.remove (cam.uid);
                cam:.onExit (alias scene);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TICKS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Tick a node of the tree at each tick of the scene, or stop ticking it, following Node::ticked
     * @info: does nothing when the node is not in the tree
     * */
    pub fn onNodeTicked (mut self, dmut node : &Node) {
        if node.uid !in self._nodes { return; }

        if node.ticked {
            self._ticked [node.uid] = alias node;
        } else {
            self._ticked:.remove (node.uid);
        }
    }

    /**
     * @returns: the nodes ticked by the scene (see Node::ticked), to tick outside the lock of the scene
     * */
    pub fn getTicked (mut self)-> dmut [&Node] {
        let dmut ticked : [&Node] = [];
        for _, dmut n in alias self._ticked {
            ticked ~= [alias n];
        }

        alias ticked
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self:.onRemoveCameras ();
            for _, dmut n in alias self._nodes {
                n:.onExit (alias self:.getScene ());
            }
            self._nodes = copy [];            
            self._ticked = copy [];
            
            if let Ok (dmut r) = alias self._rootNode {
                r:.dispose ();
                self._rootNode = none;
            }
            
        }
    }
    
}
