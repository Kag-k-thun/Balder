in tree;

use balder::utils;
use balder::core::dispose;
use balder::scene::node;
use balder::scene::node::node3D::camera;
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::material;


/**
 * The node tree of the scene
 * */
pub record NodeTreeScene {

    // The contect of the tree
    let dmut _scene : (&Scene)? = none;

    // THe root node of the tree
    let dmut _rootNode : (&Node)? = none;

    // The list of nodes contained in the tree
    let dmut _nodes : [usize => &Node] = copy [];

    // The nodes of the tree the scene ticks (see Node::ticked)
    let dmut _ticked : [usize => &Node] = copy [];

    // The camera node of the tree
    let dmut _camera : (&Camera)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Configure the tree
     * */
    pub fn configure (mut self, dmut scene : &Scene) {
        self:.dispose ();
        
        self._scene = (alias scene)?;
        
        self._rootNode = (copy root::RootNode (alias self:.getScene ()))?;        
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the root node of the scene
     * */
    @field
    pub fn rootNode (mut self)-> dmut &Node {
        if let Ok (dmut r) = alias self._rootNode { 
            return alias r;
        }

        let dmut res = copy root::RootNode (alias self:.getScene ());
        self._rootNode = (alias res)?;

        alias res
    }

    /**
     * @returns: the camera in the tree (if any)
     * */
    @field
    pub fn camera (mut self)-> dmut (&Camera)? {
        alias self._camera
    }

    /**
     * @returns: the camera in the tree (if any)
     * */
    @field
    pub fn camera (self)-> (&Camera)? {
        self._camera
    }

    
    /**
     * @returns: the scene to which the tree is attached
     * */
    pub fn getScene (mut self)-> dmut &Scene {
        if let Ok (dmut c) = alias self._scene {
            return alias c;
        }

        log::error #("NodeTreeScene", "Get scene in tree that is attached to nothing");
        panic;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INSERT/REMOVE          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    /**
     * Record a node in the tree, without calling its hooks: the scene enters it once its lock is released (see
     * Scene::registerNode)
     * @returns: the node recorded before under the uid of the node, to exit
     * */
    pub fn register (mut self, dmut node : &Node)-> dmut (&Node)? {
        let dmut old = alias self._nodes [node.uid];

        self._nodes [node.uid] = alias node;
        if node.ticked {
            self._ticked [node.uid] = alias node;
        }

        alias old
    }

    /**
     * Forget a node of the tree, without calling its hooks: the scene exits it once its lock is released (see
     * Scene::removeNode)
     * @returns: true iif the node is to exit, a node of the tree that is not a camera, or the camera of the scene
     * */
    pub fn remove (mut self, node : &Node)-> bool {
        if node.uid !in self._nodes { return false; }

        self._nodes:.remove (node.uid);
        self._ticked:.remove (node.uid);

        if let ca : &Camera = node {
            if let Ok (ica) = self._camera && ica is ca {
                self._camera = none;
                return true;
            }

            return false;
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CAMERA          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Make a camera entering the tree the camera of the scene, unless the scene has another one
     * @returns: true iif the camera is the camera of the scene, the scene to give it to the passes drawing it
     * */
    pub fn setCamera (mut self, dmut cam : &Camera)-> bool {
        if let Ok (ica) = self._camera && ica !is cam {
            log::error #("Scene", "scene has multiple cameras");
            return false;
        }

        self._camera = (alias cam)?;
        true
    }

    /**
     * Remove the camera of the scene
     * */
    fn onRemoveCamera (mut self) {
        if let Ok (dmut scene) = alias self._scene {                    
        
            if let Ok (dmut cam) = alias self._camera {
                self._nodes:.remove (cam.uid);
                
                self._camera = none;            
                cam:.onExit (alias scene);            
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TICKS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Tick a node of the tree at each tick of the scene, or stop ticking it, following Node::ticked
     * @info: does nothing when the node is not in the tree
     * */
    pub fn onNodeTicked (mut self, dmut node : &Node) {
        if node.uid !in self._nodes { return; }

        if node.ticked {
            self._ticked [node.uid] = alias node;
        } else {
            self._ticked:.remove (node.uid);
        }
    }

    /**
     * @returns: the nodes ticked by the scene (see Node::ticked), to tick outside the lock of the scene
     * */
    pub fn getTicked (mut self)-> dmut [&Node] {
        let dmut ticked : [&Node] = [];
        for _, dmut n in alias self._ticked {
            ticked ~= [alias n];
        }

        alias ticked
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {
        pub over dispose (mut self) {
            self:.onRemoveCamera ();
            for _, dmut n in alias self._nodes {
                n:.onExit (alias self:.getScene ());
            }
            self._nodes = copy [];            
            self._ticked = copy [];
            
            if let Ok (dmut r) = alias self._rootNode {
                r:.dispose ();
                self._rootNode = none;
            }
            
        }
    }
    
}
