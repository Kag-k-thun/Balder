in draw_stats;

/**
 * The counters of the draws of the instances of a scene, at the last build of their commands
 * @info: the passes drawing the instances (the depth prepass, the G-buffer pass) each draw them all
 * */
@data
pub record DrawStats {

    // The multi-draw indirect calls, one per shader and material key drawing something
    pub let mut multiDraws: usize = 0us;

    // The instanced commands drawing something, one per range of geometry drawn by a multi-draw
    pub let mut commands: usize = 0us;

    // The instances drawn by the commands
    pub let mut instances: usize = 0us;

}
