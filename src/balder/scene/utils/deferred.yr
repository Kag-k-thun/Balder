in deferred;

use balder::utils;
use balder::core::_;
use balder::core::application::window;
use balder::core::driver::{graph, subpass};

use ::vulkan::core;

/**
 * The g-buffer of a scene: the images its deferred pass draws, owned by the render graph of the window for the frame
 * they last, and the subpass drawing them
 * */
pub record DeferredRenderScene {

    // The names of the images in the render graph, in the order of the attachments of the subpass (the positions are
    // not drawn, the composition rebuilds them from the depth): the normals, the base colour and the occlusion, the
    // material, the metalness and the roughness, the emissive colour, and the depth; the texels of the maps of the
    // materials, multiplying their factors in the composition
    let mut _normals : [c8] = "";
    let mut _albedo : [c8] = "";
    let mut _materialID : [c8] = "";
    let mut _surface : [c8] = "";
    let mut _emissive : [c8] = "";
    let mut _depth : [c8] = "";

    // The name of the subpass in the render graph
    let mut _passName : [c8] = "";

    let dmut _window : (&Window)? = none;
    let dmut _pass : (&DrawSubpass)? = none;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */
    
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Declare the images of the g-buffer in the render graph of a window, and register the subpass drawing them
     * @params:
     *    - passName: the name of the subpass
     *    - scene: the name of the scene, suffixing the names of the images
     * */
    pub fn configure (mut self, passName : [c8], scene : [c8], dmut win : &Window, width : u32, height : u32)
        throws BalderError
    {
        let dmut device = win:.getVulkanDevice ();
        // the normals are folded on an octahedron, two channels
        let descs = copy [ImageDesc (format-> VkFormat::VK_FORMAT_R16G16_SFLOAT, width-> width, height-> height),
                          ImageDesc (format-> VkFormat::VK_FORMAT_R8G8B8A8_UNORM, width-> width, height-> height),
                          ImageDesc (format-> VkFormat::VK_FORMAT_R32_UINT, width-> width, height-> height),
                          ImageDesc (format-> VkFormat::VK_FORMAT_R8G8_UNORM, width-> width, height-> height),
                          ImageDesc (format-> VkFormat::VK_FORMAT_R8G8B8A8_UNORM, width-> width, height-> height),
                          ImageDesc (format-> device.getDepthFormat (), width-> width, height-> height, depth-> true)];

        self._normals = "gbuffer_normals_" ~ scene;
        self._albedo = "gbuffer_albedo_" ~ scene;
        self._materialID = "gbuffer_material_" ~ scene;
        self._surface = "gbuffer_surface_" ~ scene;
        self._emissive = "gbuffer_emissive_" ~ scene;
        self._depth = "gbuffer_depth_" ~ scene;
        self._passName = passName;

        let dmut pipeline = win:.getVulkanPipeline ();
        for i, name in self.attachments {
            pipeline:.createImage (name, descs [i]);
        }

        let dmut pass = copy DrawSubpass::toImages (alias device, passName, width, height, descs);
        pipeline:.registerSubPass (passName, alias pass);

        self._pass = (alias pass)?;
        self._window = (alias win)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the name of the normals in the render graph
     * */
    @field
    pub fn normals (self)-> [c8] {
        self._normals
    }

    /**
     * @returns: the name of the albedo in the render graph
     * */
    @field
    pub fn albedo (self)-> [c8] {
        self._albedo
    }

    /**
     * @returns: the name of the material ids in the render graph
     * */
    @field
    pub fn materialID (self)-> [c8] {
        self._materialID
    }

    /**
     * @returns: the name of the metalness and the roughness in the render graph
     * */
    @field
    pub fn surface (self)-> [c8] {
        self._surface
    }

    /**
     * @returns: the name of the emissive colour in the render graph
     * */
    @field
    pub fn emissive (self)-> [c8] {
        self._emissive
    }

    /**
     * @returns: the name of the depth in the render graph
     * */
    @field
    pub fn depth (self)-> [c8] {
        self._depth
    }

    /**
     * @returns: the names of the images of the g-buffer, in the order of the attachments of the subpass
     * */
    @field
    pub fn attachments (self)-> [[c8]] {
        copy [self._normals, self._albedo, self._materialID, self._surface, self._emissive, self._depth]
    }

    /**
     * @returns: the subpass of the deferred
     * */
    @field
    pub fn subpass (mut self)-> dmut &DrawSubpass {
        if let Ok (dmut pass) = alias self._pass {
            return alias pass;
        }
        
        log::error #("DeferredRenderScene", "Problem of configuration");
        panic;        
    }
    
    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        /**
         * Remove the subpass and the images from the render graph, the subpass being retired with the frames drawing it
         * */
        pub over dispose (mut self) {
            if let Ok (dmut win) = alias self._window {
                let dmut pipeline = win:.getVulkanPipeline ();
                pipeline:.removeSubPass (self._passName);
                for name in self.attachments {
                    pipeline:.removeResource (name);
                }

                if let Ok (dmut pass) = alias self._pass {
                    win:.retire (alias pass);
                }
            }

            self._pass = none;
            self._window = none;
        }
    }
}
