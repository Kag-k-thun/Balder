in batch;

use balder::core::{_, application::_};
use balder::core::config::shader::_;
use balder::core::driver::cmd_alloc;
use balder::core::shader::{_, buffers::_};
use balder::math::{matrix, vector};
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::{material, mesh};
use balder::scene::utils::{casters, draw_stats, motion};
use balder::utils::log;

use ::vulkan::core;

/**
 * The size of the slot of an object in the storage buffer of the 3D shaders: its world (mat4), the progress of its
 * cross-fade (f32), its material (u32), its world box (two vec4) and its world in the frame before (mat4), laid out as
 * std430 aligns them
 * */
pub def OBJECT_STRIDE = 176us;

/**
 * The offset of the world of an object in its slot
 * */
pub def OBJECT_WORLD = 0us;

/**
 * The offset of the progress of the cross-fade of an object in its slot
 * */
pub def OBJECT_FADE = 64us;

/**
 * The offset of the material of an object in its slot
 * */
pub def OBJECT_MATERIAL = 68us;

/**
 * The offset of the center of the world box of an object in its slot (vec4, w unused), read by the cull pass
 * */
pub def OBJECT_BOX_CENTER = 80us;

/**
 * The offset of the half size along each axis of the world box of an object in its slot (vec4, w unused), negative
 * when the box is empty
 * */
pub def OBJECT_BOX_EXTENT = 96us;

/**
 * The offset of the world the frame before drew an object with in its slot, the g-buffer writing the motion of the
 * object between the two (see MotionTracker)
 * */
pub def OBJECT_PREV_WORLD = 112us;

/**
 * The geometry of a mesh placed in the pool of a shader, shared by the instances drawing it
 * */
@final
class SharedGeometry {

    // The range of the geometry in the pool
    pub let dmut range: &GeometryRange;

    // The number of instances drawing the geometry, the range being given back to the pool with the last one
    let mut _users: usize = 1us;

    /**
     * @params:
     *    - range: the range placed for a first instance
     * */
    pub self (dmut range: &GeometryRange)
        with range = alias range
    {}

    /**
     * @returns: true iif the range was given back to the pool
     * */
    pub fn isFreed(self)-> bool {
        atomic self {
            self._users == 0us
        }
    }

    /**
     * Count one more instance drawing the geometry
     * @returns: false when the range was already given back to the pool, the instance having to place the geometry again
     * */
    pub fn acquire(mut self)-> bool {
        atomic self {
            if self._users == 0us { return false; }

            self._users += 1us;
            return true;
        }
    }

    /**
     * Count one instance less drawing the geometry, the range being given back to the pool with the last one
     * @warning: through a retire, the recordings in use may still draw the geometry
     * */
    pub fn release(mut self) {
        atomic self {
            if self._users == 0us { return; }

            self._users -= 1us;
            if self._users == 0us {
                self.range:.dispose();
            }
        }
    }
}

/**
 * The place of a visual instance in the draws of the scene: its geometry in the pool of its shader, its slot in the
 * objects of its shader, and the batch of its material its draws are laid out in
 * */
@final
pub class SceneDraws {

    // The objects of the shader
    let dmut _objects: &ObjectStorage;

    // The worlds of the frame before of the objects of the shader
    let dmut _motion: &MotionTracker;

    // The batch the draws are laid out in
    let dmut _batch: &InstanceBatch;

    // The geometry of the instance, shared with the instances of the same mesh
    let dmut _geometry: &SharedGeometry;

    // The casters of shadows of the shader
    let dmut _casters: &ShadowCasters;

    // The slot of the instance in the objects of the shader
    pub let slot: u32;

    // True when the draws modified in place are drawn without recording them again
    let _inPlace: bool;

    // True once the slot and the geometry were given back
    let mut _freed: bool = false;

    pub self (dmut objects: &ObjectStorage,
              dmut motion: &MotionTracker,
              dmut batch: &InstanceBatch,
              dmut geometry: &SharedGeometry,
              dmut casters: &ShadowCasters,
              slot: u32,
              inPlace: bool)
        with _objects = alias objects
        , _motion = alias motion
        , _batch = alias batch
        , _geometry = alias geometry
        , _casters = alias casters
        , slot = slot
        , _inPlace = inPlace
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the geometry of the instance in the pool of its shader
     * */
    pub fn getGeometry(self)-> &GeometryRange {
        self._geometry.range
    }

    /**
     * Write a value in the slot of the instance
     * @params:
     *    - offset: the offset of the value in the slot (OBJECT_WORLD...)
     *    - value: the value to write
     * */
    pub fn setObject {U} (mut self, offset: usize, value: U) {
        self._objects:.setData!{U} (self.slot, offset, value);
    }

    /**
     * Place the instance at a world, drawn without motion by the next frame (a new instance)
     * */
    pub fn placeWorld(mut self, world: mat4) {
        self._motion:.place(self.slot, world);
    }

    /**
     * Move the instance to a world, the next frame drawing its motion from the world the last frame drew
     * */
    pub fn setWorld(mut self, world: mat4) {
        self._motion:.moveTo(self.slot, world);
    }

    /**
     * Modify the draws of the instance, as many as it has
     * @params:
     *    - owner: the uniq id of the instance
     *    - draws: the draws of the instance
     * @returns: true iif the recordings have to be done again to draw the modification (the device has no multi-draw)
     * */
    pub fn setDraws(mut self, owner: usize, draws: [InstanceDraw])-> bool {
        self._batch:.update(owner, draws);
        !self._inPlace
    }

    /**
     * Set the draws of the instance in the shadow map, drawn by the cascades seeing it, the instance casting shadows
     * from then on
     * @params:
     *    - owner: the uniq id of the instance
     *    - draws: the draws of the level of detail of the instance, as many each time
     * @returns: true iif the recordings have to be done again to draw the modification (the device has no multi-draw)
     * */
    pub fn setShadowDraws(mut self, owner: usize, draws: [InstanceDraw])-> bool {
        self._casters:.set(owner, draws)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        /**
         * Give back the slot of the instance, and its geometry when no other instance draws it
         * @warning: through a retire, the recordings in use may still draw the instance
         * */
        pub over dispose(mut self) {
            if self._freed { return; }

            self._freed = true;
            self._motion:.forget(self.slot);
            self._objects:.free(self.slot);
            self._geometry:.release();
        }
    }
}

/**
 * The draws of the instances of a shader whose materials share their resources (see Material::getBatchKey)
 * */
@final
class MaterialBatch {

    // The descriptor set binding the objects of the shader and the resources of the materials
    pub let dmut set: &DescriptorSet;

    // The draws of the instances
    pub let dmut draws: &InstanceBatch;

    // The instances
    pub let dmut nodes: [usize => &VisualInstance3D] = copy [];

    // The number of draws laid out by the recording of the current frame
    pub let mut count: u32 = 0u32;

    // The descriptor set of the cull pass of the draws, when they are culled on the GPU
    pub let dmut cullSet: (&DescriptorSet)? = none;

    pub self (dmut set: &DescriptorSet, dmut draws: &InstanceBatch)
        with set = alias set
        , draws = alias draws
    {}
}

/**
 * The visual instances drawn by a shader, the draws of the instances whose materials share their resources being drawn
 * by one multi-draw indirect call, the draws of the same range of their geometry by one instanced command
 * @info: the instances share the vertex and the index buffer of a geometry pool and the storage buffer of their worlds
 * @info: when culled on the GPU, a cull pass writes the commands of each material key before the render pass, drawn by
 * one draw indirect count call
 * */
@final
pub class ShaderGroup {

    // The shader
    let dmut _shader: &RefCount!{&Shader};

    // The descriptor set of the camera
    let dmut _camera: &DescriptorSet;

    // The geometry of the instances
    let dmut _geometry: &GeometryPool;

    // The geometry of the meshes placed in the pool, by uniq id of their mesh
    let dmut _meshes: [usize => &SharedGeometry] = copy [];

    // The worlds, the cross-fades and the materials of the instances
    let dmut _objects: &ObjectStorage;

    // The worlds of the frame before of the instances moving
    let dmut _motion: &MotionTracker;

    // The draws of the instances by material key
    let dmut _batches: [[c8] => &MaterialBatch] = copy [];

    // The cull shader of the scene when the instances are culled on the GPU, none when they are culled on the CPU
    let dmut _cull: (&ComputeShader)? = none;

    // The instances casting shadows, and their draws in the cascades of the shadow map
    let dmut _casters: &ShadowCasters;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - shader: the shader, loaded
     *    - cfg: the configuration of the shader
     *    - objects: the slots of the instances, followed by the motion of those moving
     * */
    prv self (dmut shader: &RefCount!{&Shader}, cfg: &RasterShaderConfig, dmut objects: &ObjectStorage)
        with _shader = alias shader
        , _camera = shader:.get():.allocateDescriptorSet(DescriptorContext::CAMERA)
        , _geometry = copy GeometryPool(alias shader:.get():.getDevice(), vertexStride(cfg))
        , _objects = alias objects
        , _motion = copy MotionTracker(alias objects, OBJECT_WORLD, OBJECT_PREV_WORLD)
        , _casters = copy ShadowCasters(shader:.get():.getDevice().isMultiDraw())
        throws BalderError
    {}

    /**
     * @params:
     *    - shader: the shader, loaded
     *    - cfg: the configuration of the shader
     * */
    pub self (dmut shader: &RefCount!{&Shader}, cfg: &RasterShaderConfig)
        with self(alias shader, cfg, copy ObjectStorage(alias shader:.get():.getDevice(), OBJECT_STRIDE))
        throws BalderError
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          USAGE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iif no instance is drawn by the shader
     * */
    pub fn isEmpty(self)-> bool {
        self._batches.len == 0us
    }

    /**
     * Set the camera the shader draws with
     * */
    pub fn setCamera(mut self, ubo: &UniformBufferObject) {
        self._camera:.setUniform(UniformNames::CAMERA, ubo);
    }

    /**
     * Place a visual instance in the draws of the shader
     * @params:
     *    - material: the material of the instance, attached
     *    - node: the instance
     *    - mesh: the geometry of the instance, placed in the pool unless another instance placed it already
     * @returns: the place of the instance, to retire once it is not drawn anymore, after release
     * */
    pub fn register(mut self,
                    dmut material: &Material,
                    dmut node: &VisualInstance3D,
                    mesh: &MeshGeometry)-> dmut &SceneDraws
        throws BalderError
    {
        let key = material.getBatchKey();
        let dmut batch = if let Ok(dmut b) = alias self._batches[key] {
            alias b
        } else {
            let dmut set = self._shader:.get():.allocateDescriptorSet(DescriptorContext::OBJECT);
            material:.bind(alias set);

            let dmut b = copy MaterialBatch(alias set, copy InstanceBatch(alias self._shader:.get():.getDevice()));
            self:.cullOnGpu(alias b);
            self._batches[key] = alias b;
            alias b
        };

        let dmut geometry = self:.place(mesh, material);
        let slot = {
            self._objects:.alloc()
        } catch {
            err => {
                geometry:.release();
                throw err;
            }
        };

        batch.nodes[node.uid] = alias node;
        copy SceneDraws(alias self._objects,
                        alias self._motion,
                        alias batch.draws,
                        alias geometry,
                        alias self._casters,
                        slot,
                        self._shader:.get():.getDevice().isMultiDraw())
    }

    /**
     * @returns: the geometry of a mesh in the pool, placed unless an instance drawing it placed it already
     * @params:
     *    - mesh: the mesh
     *    - material: the material of the instance, giving the layout of the vertices
     * */
    fn place(mut self, mesh: &MeshGeometry, material: &Material)-> dmut &SharedGeometry
        throws BalderError
    {
        if let Ok(dmut g) = alias self._meshes[mesh.uid] {
            if g:.acquire() { return alias g; }
        }

        // the geometries given back are forgotten
        let dmut alive: [usize => &SharedGeometry] = copy [];
        for uid, dmut g in alias self._meshes {
            if !g.isFreed() { alive[uid] = alias g; }
        }

        let (vertices, indices) = mesh.compact(material);
        let dmut g = copy SharedGeometry(alias self._geometry:.alloc(vertices, indices));
        alive[mesh.uid] = alias g;
        self._meshes = alias alive;

        alias g
    }

    /**
     * @returns: the counters of the draws of the instances, at the last build of their commands
     * */
    pub fn drawStats(self)-> DrawStats {
        let mut stats = DrawStats();
        for _, b in self._batches {
            let (commands, instances) = b.draws.getDrawn();
            if commands != 0u32 { stats.multiDraws += 1us; }

            stats.commands += cast!usize(commands);
            stats.instances += cast!usize(instances);
        }

        stats
    }

    /**
     * Set the distance of the instances seen to the eye, their draws being drawn closest first
     * @params:
     *    - eye: the position of the camera
     * */
    pub fn sort(mut self, eye: vec3) {
        for _, dmut b in alias self._batches {
            for uid, dmut n in alias b.nodes {
                if n.culled { continue; }

                let sphere = n:.boundingSphere();
                b.draws:.setDistance(uid, (sphere.center - eye).length() - sphere.radius);
            }
        }
    }

    /**
     * Write the worlds the last frame drew in the slots of the instances moving, for the frame being submitted (see
     * MotionTracker::advanceFrame)
     * */
    pub fn advanceFrame(mut self) {
        self._motion:.advanceFrame();
    }

    /**
     * Cull the instances on the GPU with a cull shader, or on the CPU, from the next recordings
     * @params:
     *    - window: the window retiring the descriptor sets of the cull pass, when culled on the CPU
     *    - cull: the cull shader of the scene, none to cull on the CPU
     * */
    pub fn setCulling(mut self, dmut window: &Window, dmut cull: (&ComputeShader)?) {
        self._cull = alias cull;
        for key, dmut b in alias self._batches {
            if self._cull.hasValue {
                {
                    self:.cullOnGpu(alias b);
                } catch {
                    err => {
                        log::error #("Scene", "Failed to cull the draws of the material on the GPU", key, err);
                    }
                }
            } else {
                if let Ok(dmut set) = alias b.cullSet {
                    window:.retire(alias set);
                }

                b.cullSet = none;
                b.draws:.setCulled(false);
            }
        }
    }

    /**
     * Remove a visual instance from the draws of the shader
     * @params:
     *    - window: the window retiring the resources of the material batch, when it has no instance anymore
     *    - material: the material of the instance
     *    - node: the instance
     * */
    pub fn release(mut self, dmut window: &Window, material: &Material, node: &VisualInstance3D) {
        self._casters:.remove(node.uid);

        let key = material.getBatchKey();
        if let Ok(dmut b) = alias self._batches[key] {
            b.nodes:.remove(node.uid);
            b.draws:.remove(node.uid);
            if b.nodes.len == 0us {
                window:.retire(alias b.set);
                window:.retire(alias b.draws);
                if let Ok(dmut set) = alias b.cullSet {
                    window:.retire(alias set);
                }

                self._batches:.remove(key);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Lay out the draws of the instances for the recording of a frame, before any of them is recorded
     * @info: laid out before the pool is bound, the buffers bound holding the geometry of every draw laid out
     * @params:
     *    - frame: the frame being recorded
     * */
    pub fn layout(mut self, frame: u32) {
        for key, dmut b in alias self._batches {
            {
                b.draws:.begin(frame);
                for uid, n in b.nodes {
                    b.draws:.add(frame, uid, n.getDraws());
                }

                b.count = b.draws:.end(frame);
                b.set:.setBuffer(UniformNames::OBJECTS, self._objects.getBuffer(), frame);
                if let Ok(words) = b.draws.getWordBuffer(frame) {
                    b.set:.setBuffer(UniformNames::INSTANCES, words, frame);
                }

                if let Ok(dmut set) = alias b.cullSet {
                    self.bindCull(frame, alias set, b.draws);
                }
            } catch {
                err => {
                    log::error #("Scene", "Failed to lay out the draws of the material", key, err);
                    b.count = 0u32;
                }
            }
        }
    }

    /**
     * Record the clear of the counters of the cull passes of the material keys culled on the GPU
     * @assume: the draws of the frame are laid out
     * */
    pub fn clearCounters(mut self, dmut cmd: &CullCommandAllocator) {
        for _, b in self._batches {
            cmd:.clear(b.draws);
        }
    }

    /**
     * Record the cull of the candidates of the material keys culled on the GPU
     * @assume: the counters are cleared, the cull pass of the scene is bound (see CullPass::select); for the late cull,
     * the first commands are drawn and the depth pyramid built
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the cull passes
     *    - late: false for the first cull, true for the second one testing the candidates against the depth pyramid
     *    - width: the width of the view, in pixels
     *    - height: the height of the view, in pixels
     *    - minPixels: the size on screen in pixels under which an instance is culled
     *    - levels: the number of levels of the depth pyramid, 0 when the occluded instances are not culled
     * */
    pub fn cull(mut self,
                frame: u32,
                dmut cmd: &CullCommandAllocator,
                late: bool,
                width: f32,
                height: f32,
                minPixels: f32,
                levels: u32)
    {
        if let Ok(dmut shader) = alias self._cull {
            for _, b in self._batches {
                if let Ok(set) = b.cullSet {
                    set.select(frame, cmd.getCommandBuffer());
                    cmd:.cull(alias shader, b.draws, late, width, height, minPixels, levels);
                }
            }
        }
    }

    /**
     * Record the writing of the commands of the material keys culled on the GPU
     * @assume: the candidates are culled, the cull pass of the scene is bound
     * @params:
     *    - late: false for the commands of the first cull, true for those of the second one
     * */
    pub fn writeCommands(mut self, frame: u32, dmut cmd: &CullCommandAllocator, late: bool) {
        if let Ok(dmut shader) = alias self._cull {
            for _, b in self._batches {
                if let Ok(set) = b.cullSet {
                    set.select(frame, cmd.getCommandBuffer());
                    cmd:.writeCommands(alias shader, b.draws, late);
                }
            }
        }
    }

    /**
     * Record the copy of the counters of the material keys culled on the GPU, read back by the CPU (see drawStats)
     * @assume: the commands are written
     * */
    pub fn readBack(mut self, dmut cmd: &CullCommandAllocator) {
        for _, b in self._batches {
            cmd:.readBack(b.draws);
        }
    }

    /**
     * Record the depth prepass of the instances, one multi-draw per material key, nothing when the shader has no prepass
     * @assume: the draws of the frame are laid out
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording
     *    - late: false for the draws of the first cull, true for those of the second one (the material keys culled on
     *            the GPU only)
     * */
    pub fn drawDepth(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, late: bool)
        throws BalderError
    {
        if let sh: &RasterShader = self._shader:.get() {
            if !sh.hasPrepass() { return; }

            sh.selectPrepass(cmd.getCommandBuffer());
            self:.drawBatches(frame, alias cmd, late);
        }
    }

    /**
     * Record the draws of the instances, one multi-draw per material key
     * @assume: the draws of the frame are laid out, and their depth drawn when the shader has a prepass
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording
     *    - late: false for the draws of the first cull, true for those of the second one (the material keys culled on
     *            the GPU only)
     * */
    pub fn draw(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, late: bool)
        throws BalderError
    {
        self._shader:.get().select(cmd.getCommandBuffer());
        self:.drawBatches(frame, alias cmd, late);
    }

    /**
     * Record the multi-draws of the material keys with the pipeline selected
     * */
    fn drawBatches(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, late: bool) {
        self._camera.select(frame, cmd.getCommandBuffer());
        self._geometry.select(cmd.getCommandBuffer());

        for _, dmut b in alias self._batches {
            if b.count == 0u32 { continue; }

            let culled = b.draws.isCulled(frame);
            if late && !culled { continue; }

            b.set.select(frame, cmd.getCommandBuffer());
            if culled {
                cmd:.drawIndexedCount(b.draws, late);
            } else {
                cmd:.drawIndexed(b.draws, 0u32, b.count);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SHADOW          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Draw the instances casting shadows in the cascades of a shadow map, with the shadow pipeline of the shader (built
     * once, for every shadow map of the same format)
     * @params:
     *    - window: the window retiring the resources of the cascades drawn before
     *    - renderPass: the render pass of the shadow map
     *    - width: the width of the shadow map
     *    - height: the height of the shadow map
     *    - cameras: the buffer holding the view of the light of each cascade
     *    - offsets: the offset of the camera of each cascade in the buffer
     * */
    pub fn castShadows(mut self,
                       dmut window: &Window,
                       renderPass: VkRenderPass,
                       width: u32,
                       height: u32,
                       cameras: &UniformBufferObject,
                       offsets: [usize])
        throws BalderError
    {
        if let dmut sh: &RasterShader = alias self._shader:.get() {
            if !sh.hasShadow() {
                sh:.configureShadow(renderPass, width, height);
            }
        }

        self._casters:.start(alias window, alias self._shader:.get(), cameras, offsets);
    }

    /**
     * Stop drawing the instances in a shadow map
     * @params:
     *    - window: the window retiring the resources of the cascades, the recordings in use still drawing with them
     * */
    pub fn stopShadows(mut self, dmut window: &Window) {
        self._casters:.stop(alias window);
    }

    /**
     * Draw the instances casting shadows a cascade sees, and none of the others
     * @params:
     *    - cascade: the index of the cascade
     *    - seen: the uniq ids of the instances the cascade sees, of the shader or not
     * @returns: true iif the recordings have to be done again to draw them (the device has no multi-draw)
     * */
    pub fn seeShadows(mut self, cascade: usize, seen: [usize])-> bool {
        self._casters:.see(cascade, seen)
    }

    /**
     * Lay out the draws of the instances casting shadows in the cascades, for the recording of a frame of the shadow map
     * */
    pub fn layoutShadows(mut self, frame: u32) {
        self._casters:.layout(frame, self._objects);
    }

    /**
     * Record the draws of the instances casting shadows a cascade sees, with the shadow pipeline of the shader
     * @assume: the draws of the frame are laid out (see layoutShadows), the viewport is the one of the cascade
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording of the shadow map
     *    - cascade: the index of the cascade
     * */
    pub fn drawShadows(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, cascade: usize)
        throws BalderError
    {
        if !self._casters.isCasting() { return; }

        if let sh: &RasterShader = self._shader:.get() {
            if !sh.hasShadow() { return; }

            sh.selectShadow(cmd.getCommandBuffer());
            self._geometry.select(cmd.getCommandBuffer());
            self._casters:.draw(frame, alias cmd, cascade);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CULLING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Cull the draws of a material key on the GPU when the cull shader is set, its descriptor set being allocated
     * */
    fn cullOnGpu(mut self, dmut b: &MaterialBatch)
        throws BalderError
    {
        if let Ok(dmut cull) = alias self._cull {
            if !b.cullSet.hasValue {
                let dmut set = cull:.allocateDescriptorSet(DescriptorContext::OBJECT);
                b.cullSet = (alias set)?;
            }

            b.draws:.setCulled(true);
        }
    }

    /**
     * Bind the buffers the cull pass of a material key reads and writes for a frame
     * @assume: the draws of the frame are laid out
     * */
    fn bindCull(self, frame: u32, dmut set: &DescriptorSet, draws: &InstanceBatch) {
        if !draws.isCulled(frame) { return; }

        set:.setBuffer(UniformNames::OBJECTS, self._objects.getBuffer(), frame);
        for name, buffer in copy [UniformNames::DRAWS => draws.getCandidateBuffer(frame),
                                  UniformNames::TEMPLATES => draws.getTemplateBuffer(frame),
                                  UniformNames::COUNTERS => draws.getCounterBuffer(frame),
                                  UniformNames::COMMANDS => draws.getCulledCommandBuffer(frame),
                                  UniformNames::INSTANCES => draws.getWordBuffer(frame),
                                  UniformNames::VISIBILITY => draws.getVisibilityBuffer(frame)] {
            if let Ok(b) = buffer {
                set:.setBuffer(name, b, frame);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Retire the resources of the shader
     * @params:
     *    - window: the window retiring the resources, the recordings in use still drawing with them
     * */
    pub fn retire(mut self, dmut window: &Window) {
        for _, dmut b in alias self._batches {
            window:.retire(alias b.set);
            window:.retire(alias b.draws);
            if let Ok(dmut set) = alias b.cullSet {
                window:.retire(alias set);
            }
        }

        self._casters:.stop(alias window);
        self._batches = copy [];
        self._meshes = copy [];
        window:.retire(alias self._camera);
        window:.retire(alias self._geometry);
        window:.retire(alias self._objects);
        self._shader:.dispose();
    }
}

/**
 * @returns: the number of floats of a vertex read by the shader 'cfg'
 * */
fn vertexStride(cfg: &RasterShaderConfig)-> u32 {
    let mut size = 0u32;
    for _, e in cfg.entries {
        size += e._1;
    }

    size / 4u32
}
