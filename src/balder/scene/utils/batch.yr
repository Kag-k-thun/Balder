in batch;

use balder::core::{_, application::_};
use balder::core::config::shader::_;
use balder::core::driver::cmd_alloc;
use balder::core::shader::{_, buffers::_};
use balder::math::{bounds, matrix, vector};
use balder::scene::node::node3D::visual;
use balder::scene::node::node3D::visual::{material, mesh};
use balder::scene::utils::{casters, cluster_slot, draw_stats, motion, shadow_map, skinned_instance, skinning};
use balder::utils::{dense_map, log};

use std::algorithm::comparison;

use ::vulkan::core;

/**
 * The size of the slot of an object in the storage buffer of the 3D shaders: its world (mat4), the progress of its
 * cross-fade (f32), its material (u32), its levels of detail (u32), its world box (two vec4) and its world in the frame
 * before (mat4), laid out as std430 aligns them
 * */
pub def OBJECT_STRIDE = 176us;

/**
 * The offset of the world of an object in its slot
 * */
pub def OBJECT_WORLD = 0us;

/**
 * The offset of the progress of the cross-fade of an object in its slot
 * */
pub def OBJECT_FADE = 64us;

/**
 * The offset of the material word of an object in its slot: the index of its material in the composition pass, and
 * OBJECT_OUTLINED when the object is outlined; the g-buffer holds it for each pixel
 * */
pub def OBJECT_MATERIAL = 68us;

/**
 * The bit of the material word of an object set when the object is outlined, the composition drawing an outline around
 * the pixels having it (see the compose shader)
 * */
pub def OBJECT_OUTLINED = 0x80000000u32;

/**
 * The offset of the levels of detail an object draws in its slot: the level drawn alone or fading in, and above
 * OBJECT_LOD_SHIFT the level fading out, the debug view of the levels colouring them (see DebugView::LODS)
 * */
pub def OBJECT_LOD = 72us;

/**
 * The shift of the level fading out in the levels of detail word of an object
 * */
pub def OBJECT_LOD_SHIFT = 16u32;

/**
 * The offset of the center of the world box of an object in its slot (vec4, w unused), read by the cull pass
 * */
pub def OBJECT_BOX_CENTER = 80us;

/**
 * The offset of the half size along each axis of the world box of an object in its slot (vec4, w unused), negative
 * when the box is empty
 * */
pub def OBJECT_BOX_EXTENT = 96us;

/**
 * The offset of the world the frame before drew an object with in its slot, the g-buffer writing the motion of the
 * object between the two (see MotionTracker)
 * */
pub def OBJECT_PREV_WORLD = 112us;

/**
 * The number of meshes placed in the pool of a shader under which the geometries given back are not swept
 * */
def MIN_SWEEP = 16us;

/**
 * The geometry of a mesh placed in the pool of a shader, and its clusters in the clusters of the shader, shared by the
 * instances drawing it
 * */
@final
class SharedGeometry {

    // The range of the geometry in the pool
    pub let dmut range: &GeometryRange;

    // The clusters of the shader
    let dmut _clusters: &ObjectStorage;

    // The slot of the first cluster of the geometry in the clusters of the shader
    pub let firstCluster: u32;

    // The number of clusters of the geometry
    pub let nbClusters: u32;

    // The skinning of the shader holding the weights of the bind vertices of a skinned geometry, none for a rigid one
    let dmut _skinning: (&GroupSkinning)? = none;

    // The weights of the first bind vertex of a skinned geometry in the skinning of the shader
    pub let mut firstWeight: u32 = 0u32;

    // The number of instances drawing the geometry, the range being given back to the pool with the last one
    let mut _users: usize = 1us;

    /**
     * @params:
     *    - range: the range placed for a first instance
     *    - clusters: the clusters of the shader
     *    - firstCluster: the slot of the first cluster of the geometry
     *    - nbClusters: the number of clusters of the geometry, placed from firstCluster
     * */
    pub self (dmut range: &GeometryRange, dmut clusters: &ObjectStorage, firstCluster: u32, nbClusters: u32)
        with range = alias range
        , _clusters = alias clusters
        , firstCluster = firstCluster
        , nbClusters = nbClusters
    {}

    /**
     * The geometry of a skinned mesh, its bind vertices skinned into the vertices of each instance, which have their own
     * clusters
     * @params:
     *    - range: the range placed for a first instance, its bind vertices
     *    - clusters: the clusters of the shader
     *    - skinning: the skinning of the shader
     *    - firstWeight: the weights of the first bind vertex in the skinning (see GroupSkinning.placeWeights)
     * */
    pub self skinned(dmut range: &GeometryRange, dmut clusters: &ObjectStorage, dmut skinning: &GroupSkinning, firstWeight: u32)
        with range = alias range
        , _clusters = alias clusters
        , firstCluster = 0u32
        , nbClusters = 0u32
        , _skinning = (alias skinning)?
        , firstWeight = firstWeight
    {}

    /**
     * @returns: true iif the range was given back to the pool
     * */
    pub fn isFreed(self)-> bool {
        atomic self {
            self._users == 0us
        }
    }

    /**
     * Count one more instance drawing the geometry
     * @returns: false when the range was already given back to the pool, the instance having to place the geometry again
     * */
    pub fn acquire(mut self)-> bool {
        atomic self {
            if self._users == 0us { return false; }

            self._users += 1us;
            return true;
        }
    }

    /**
     * Count one instance less drawing the geometry, the range and the clusters being given back with the last one
     * @warning: through a retire, the recordings in use may still draw the geometry
     * */
    pub fn release(mut self) {
        atomic self {
            if self._users == 0us { return; }

            self._users -= 1us;
            if self._users == 0us {
                self.range:.dispose();
                if self.nbClusters != 0u32 {
                    self._clusters:.free(self.firstCluster, count-> cast!usize(self.nbClusters));
                }

                if let Ok(dmut sk) = alias self._skinning {
                    sk:.freeWeights(self.firstWeight, self.range.nbVertices);
                }
            }
        }
    }
}

/**
 * The place of a visual instance in the draws of the scene: its geometry in the pool of its shader, its slot in the
 * objects of its shader, and the batch of its material its draws are laid out in
 * */
@final
pub class SceneDraws {

    // The objects of the shader
    let dmut _objects: &ObjectStorage;

    // The worlds of the frame before of the objects of the shader
    let dmut _motion: &MotionTracker;

    // The batch the draws are laid out in
    let dmut _batch: &InstanceBatch;

    // The geometry of the instance, shared with the instances of the same mesh
    let dmut _geometry: &SharedGeometry;

    // The casters of shadows of the shader
    let dmut _casters: &ShadowCasters;

    // The slot of the instance in the objects of the shader
    pub let slot: u32;

    // True when the draws modified in place are drawn without recording them again
    let _inPlace: bool;

    // True once the slot and the geometry were given back
    let mut _freed: bool = false;

    // The skinning of the shader and the place of the instance in it, when the instance is skinned
    let dmut _skinning: (&GroupSkinning)? = none;
    let mut _skin: (SkinnedInstance)? = none;

    // The clusters of the shader, the own clusters of a skinned instance among them
    let dmut _clusters: (&ObjectStorage)? = none;

    pub self (dmut objects: &ObjectStorage,
              dmut motion: &MotionTracker,
              dmut batch: &InstanceBatch,
              dmut geometry: &SharedGeometry,
              dmut casters: &ShadowCasters,
              slot: u32,
              inPlace: bool)
        with _objects = alias objects
        , _motion = alias motion
        , _batch = alias batch
        , _geometry = alias geometry
        , _casters = alias casters
        , slot = slot
        , _inPlace = inPlace
    {}

    /**
     * The place of a skinned instance, drawing its own vertices and its own clusters
     * @params:
     *    - skinning: the skinning of the shader
     *    - skin: the place of the instance in the skinning
     *    - clusters: the clusters of the shader, holding those of the instance
     * */
    pub self skinned(dmut objects: &ObjectStorage,
                     dmut motion: &MotionTracker,
                     dmut batch: &InstanceBatch,
                     dmut geometry: &SharedGeometry,
                     dmut casters: &ShadowCasters,
                     slot: u32,
                     inPlace: bool,
                     dmut skinning: &GroupSkinning,
                     skin: SkinnedInstance,
                     dmut clusters: &ObjectStorage)
        with self(alias objects, alias motion, alias batch, alias geometry, alias casters, slot, inPlace)
    {
        self._skinning = (alias skinning)?;
        self._skin = skin?;
        self._clusters = (alias clusters)?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the geometry of the instance in the pool of its shader
     * */
    pub fn getGeometry(self)-> &GeometryRange {
        self._geometry.range
    }

    /**
     * @returns: the first vertex the draws of the instance read: the first vertex of its geometry in the pool, or its own
     * first vertex in the skinned vertices of its shader when it is skinned
     * */
    pub fn getVertexOffset(self)-> u32 {
        if let Ok(skin) = self._skin {
            return skin.target;
        }

        self._geometry.range.vertexOffset
    }

    /**
     * @returns: the slot of the first cluster of the instance in the clusters of its shader, those of its geometry or its
     * own when it is skinned, the clusters of a level of its mesh following it from the first cluster of the level
     * */
    pub fn getFirstCluster(self)-> u32 {
        if let Ok(skin) = self._skin {
            return skin.firstCluster;
        }

        self._geometry.firstCluster
    }

    /**
     * @returns: true iif the instance is skinned, drawing its own vertices
     * */
    pub fn isSkinned(self)-> bool {
        self._skin.hasValue
    }

    /**
     * Place the joints of a skinned instance at a pose, drawn without motion by the next frame
     * @params:
     *    - matrices: the matrix of each joint of its skin (see Skin.jointMatrices)
     * */
    pub fn placeJoints(mut self, matrices: [mat4]) {
        if let Ok(skin) = self._skin {
            if let Ok(dmut sk) = alias self._skinning {
                sk:.placeJoints(skin, matrices);
            }
        }
    }

    /**
     * Move the joints of a skinned instance to a pose, the next frame drawing its motion from the pose the last frame drew
     * @params:
     *    - matrices: the matrix of each joint of its skin (see Skin.jointMatrices)
     * */
    pub fn setJoints(mut self, matrices: [mat4]) {
        if let Ok(skin) = self._skin {
            if let Ok(dmut sk) = alias self._skinning {
                sk:.moveJoints(skin, matrices);
            }
        }
    }

    /**
     * Cull the clusters of a skinned instance with a box enclosing its poses, in the space of the positions of its mesh
     * */
    pub fn setPoseBox(mut self, box: Aabb) {
        if let Ok(skin) = self._skin {
            if let Ok(dmut clusters) = alias self._clusters {
                let count = cast!usize(skin.nbClusters);
                clusters:.fillRun(skin.firstCluster, count, CLUSTER_CENTER, makeVec4(box.center, 0.0f));
                clusters:.fillRun(skin.firstCluster, count, CLUSTER_EXTENT, makeVec4(box.extent, 0.0f));
            }
        }
    }

    /**
     * Write a value in the slot of the instance
     * @params:
     *    - offset: the offset of the value in the slot (OBJECT_WORLD...)
     *    - value: the value to write
     * */
    pub fn setObject {U} (mut self, offset: usize, value: U) {
        self._objects:.setData!{U} (self.slot, offset, value);
    }

    /**
     * Place the instance at a world, drawn without motion by the next frame (a new instance)
     * */
    pub fn placeWorld(mut self, world: mat4) {
        self._motion:.place(self.slot, world);
    }

    /**
     * Move the instance to a world, the next frame drawing its motion from the world the last frame drew
     * */
    pub fn setWorld(mut self, world: mat4) {
        self._motion:.moveTo(self.slot, world);
    }

    /**
     * Modify the draws of the instance, as many as it has
     * @params:
     *    - owner: the uniq id of the instance
     *    - draws: the draws of the instance
     * @returns: true iif the recordings have to be done again to draw the modification (the device has no multi-draw)
     * */
    pub fn setDraws(mut self, owner: usize, draws: [InstanceDraw])-> bool {
        self._batch:.update(owner, draws);
        !self._inPlace
    }

    /**
     * Set the draws of the instance in the shadow maps, drawn by the views seeing it, the instance casting shadows from
     * then on
     * @params:
     *    - owner: the uniq id of the instance
     *    - draws: the draws of the level of detail of the instance, as many each time
     * @returns: true iif the recordings have to be done again to draw the modification (the device has no multi-draw)
     * */
    pub fn setShadowDraws(mut self, owner: usize, draws: [InstanceDraw])-> bool {
        self._casters:.set(owner, draws)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Disposable {

        /**
         * Give back the slot of the instance, and its geometry when no other instance draws it
         * @warning: through a retire, the recordings in use may still draw the instance
         * */
        pub over dispose(mut self) {
            if self._freed { return; }

            self._freed = true;
            self._motion:.forget(self.slot);
            self._objects:.free(self.slot);
            if let Ok(skin) = self._skin {
                if let Ok(dmut sk) = alias self._skinning {
                    sk:.free(skin);
                }

                if let Ok(dmut clusters) = alias self._clusters {
                    if skin.nbClusters != 0u32 {
                        clusters:.free(skin.firstCluster, count-> cast!usize(skin.nbClusters));
                    }
                }
            }

            self._geometry:.release();
        }
    }
}

/**
 * The draws of the instances of a shader whose materials share their resources (see Material::getBatchKey)
 * */
@final
class MaterialBatch {

    // The descriptor set binding the objects of the shader and the resources of the materials
    pub let dmut set: &DescriptorSet;

    // The draws of the instances
    pub let dmut draws: &InstanceBatch;

    // The instances
    pub let dmut nodes: &DenseMap!{usize, dmut &VisualInstance3D} = copy DenseMap!{usize, dmut &VisualInstance3D}();

    // The number of draws laid out by the recording of the current frame
    pub let mut count: u32 = 0u32;

    // The descriptor set of the cull pass of the draws, when they are culled on the GPU
    pub let dmut cullSet: (&DescriptorSet)? = none;

    pub self (dmut set: &DescriptorSet, dmut draws: &InstanceBatch)
        with set = alias set
        , draws = alias draws
    {}
}

/**
 * The visual instances drawn by a shader, the draws of the instances whose materials share their resources being drawn
 * by one multi-draw indirect call, the draws of the same range of their geometry by one instanced command
 * @info: the instances share the vertex and the index buffer of a geometry pool and the storage buffer of their worlds
 * @info: when culled on the GPU, a cull pass writes the commands of each material key before the render pass, drawn by
 * one draw indirect count call
 * */
@final
pub class ShaderGroup {

    // The shader
    let dmut _shader: &RefCount!{&Shader};

    // The configuration of the shader, the layout of its vertices
    let _config: &RasterShaderConfig;

    // The descriptor set of the camera
    let dmut _camera: &DescriptorSet;

    // The geometry of the instances
    let dmut _geometry: &GeometryPool;

    // The geometry of the meshes placed in the pool, by uniq id of their mesh, those given back forgotten by the sweeps
    // of place
    let dmut _meshes: [usize => &SharedGeometry] = copy [];

    // The number of meshes from which place sweeps the geometries given back, twice the geometries alive at the last
    // sweep, so the placements cost a constant time on average
    let mut _sweepAt: usize = MIN_SWEEP;

    // The worlds, the cross-fades and the materials of the instances
    let dmut _objects: &ObjectStorage;

    // The clusters of the geometries placed in the pool, read by the cull pass (see ClusterSlot)
    let dmut _clusters: &ObjectStorage;

    // The worlds of the frame before of the instances moving
    let dmut _motion: &MotionTracker;

    // The draws of the instances by material key
    let dmut _batches: &DenseMap!{[c8], dmut &MaterialBatch} = copy DenseMap!{[c8], dmut &MaterialBatch}();

    // The cull shader of the scene when the instances are culled on the GPU, none when they are culled on the CPU
    let dmut _cull: (&ComputeShader)? = none;

    // The instances casting shadows, and their draws in the views of the shadow maps
    let dmut _casters: &ShadowCasters;

    // The skinning of the instances when the shader draws skinned vertices (the [skin] variant of a shader), none when
    // it draws rigid ones
    let dmut _skinning: (&GroupSkinning)? = none;

    // The instances of a batch seen and their distances to the eye, given to the batch by sort, kept from a sort to the
    // next
    let dmut _sortOwners: [usize] = [];
    let dmut _sortDistances: [f32] = [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          CTOR/DTOR          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - shader: the shader, loaded
     *    - cfg: the configuration of the shader
     *    - objects: the slots of the instances, followed by the motion of those moving
     * */
    prv self (dmut shader: &RefCount!{&Shader}, cfg: &RasterShaderConfig, dmut objects: &ObjectStorage)
        with _shader = alias shader
        , _config = cfg
        , _camera = shader:.get():.allocateDescriptorSet(DescriptorContext::CAMERA)
        , _geometry = copy GeometryPool(alias shader:.get():.getDevice(), vertexStride(cfg))
        , _objects = alias objects
        , _clusters = copy ObjectStorage(alias shader:.get():.getDevice(), CLUSTER_STRIDE)
        , _motion = copy MotionTracker(alias objects, OBJECT_WORLD, OBJECT_PREV_WORLD)
        , _casters = copy ShadowCasters(shader:.get():.getDevice().isMultiDraw())
        throws BalderError
    {}

    /**
     * @params:
     *    - shader: the shader, loaded
     *    - cfg: the configuration of the shader
     * */
    pub self (dmut shader: &RefCount!{&Shader}, cfg: &RasterShaderConfig)
        with self(alias shader, cfg, copy ObjectStorage(alias shader:.get():.getDevice(), OBJECT_STRIDE))
        throws BalderError
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          USAGE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true iif no instance is drawn by the shader
     * */
    pub fn isEmpty(self)-> bool {
        self._batches.len == 0us
    }

    /**
     * Skin the instances of the shader, which draws skinned vertices: the skin pass moves their vertices before they are
     * drawn
     * @assume: no instance is registered yet
     * @params:
     *    - skin: the shader of the skin pass (DefaultShaders::SKINNING_3D)
     * @throws: when the vertices of the shader cannot be skinned (no position of the frame before)
     * */
    pub fn skinWith(mut self, dmut skin: &ComputeShader)
        throws BalderError
    {
        let dmut sk = copy GroupSkinning(alias skin, self._config);
        self._skinning = (alias sk)?;
    }

    /**
     * @returns: true iif the shader draws skinned vertices, skinned by the skin pass
     * */
    pub fn isSkinned(self)-> bool {
        self._skinning.hasValue
    }

    /**
     * @returns: the matrices of the frame before of the joints of the skinned instances moving, none when the shader draws
     * rigid vertices
     * */
    pub fn getJointMotion(mut self)-> dmut (&MotionTracker)? {
        if let Ok(dmut sk) = alias self._skinning {
            return (alias sk:.getMotion())?;
        }

        none
    }

    /**
     * Set the camera the shader draws with
     * */
    pub fn setCamera(mut self, ubo: &UniformBufferObject) {
        self._camera:.setUniform(UniformNames::CAMERA, ubo);
    }

    /**
     * Place a visual instance in the draws of the shader
     * @params:
     *    - material: the material of the instance, attached
     *    - node: the instance
     *    - mesh: the geometry of the instance, placed in the pool unless another instance placed it already
     * @returns: the place of the instance, to retire once it is not drawn anymore, after release
     * */
    pub fn register(mut self,
                    dmut material: &Material,
                    dmut node: &VisualInstance3D,
                    mesh: &MeshGeometry)-> dmut &SceneDraws
        throws BalderError
    {
        let key = material.getBatchKey();
        let dmut batch = if let Ok(dmut b) = alias self._batches:[key] {
            alias b
        } else {
            let dmut set = self._shader:.get():.allocateDescriptorSet(DescriptorContext::OBJECT);
            material:.bind(alias set);

            let dmut b = copy MaterialBatch(alias set, copy InstanceBatch(alias self._shader:.get():.getDevice()));
            self:.cullOnGpu(alias b);
            self._batches[key] = alias b;
            alias b
        };

        let dmut geometry = self:.place(mesh);
        let slot = {
            self._objects:.alloc()
        } catch {
            err => {
                geometry:.release();
                throw err;
            }
        };

        let inPlace = self._shader:.get():.getDevice().isMultiDraw();
        if let Ok(dmut sk) = alias self._skinning {
            let skin = {
                self:.skinInstance(alias sk, node, mesh, geometry)
            } catch {
                err => {
                    self._objects:.free(slot);
                    geometry:.release();
                    throw err;
                }
            };

            batch.nodes[node.uid] = alias node;
            return copy SceneDraws::skinned(alias self._objects,
                                            alias self._motion,
                                            alias batch.draws,
                                            alias geometry,
                                            alias self._casters,
                                            slot,
                                            inPlace,
                                            alias sk,
                                            skin,
                                            alias self._clusters);
        }

        batch.nodes[node.uid] = alias node;
        copy SceneDraws(alias self._objects,
                        alias self._motion,
                        alias batch.draws,
                        alias geometry,
                        alias self._casters,
                        slot,
                        inPlace)
    }

    /**
     * Skin an instance: its own vertices and joints in the skinning of the shader, and its own clusters, placed at its
     * vertices and culled with its box until it sets the box of its poses
     * @params:
     *    - skinning: the skinning of the shader
     *    - node: the instance
     *    - mesh: its geometry, skinned
     *    - geometry: its geometry placed in the pool, its bind vertices and their weights
     * @returns: the place of the instance in the skinning
     * */
    fn skinInstance(mut self, dmut skinning: &GroupSkinning, node: &VisualInstance3D, mesh: &MeshGeometry, geometry: &SharedGeometry)-> SkinnedInstance
        throws BalderError
    {
        let nbJoints = if let Ok(skin) = mesh.skin { cast!u32(skin.joints.len) } else { 0u32 };
        let clusters = mesh.clusters;
        let first = if clusters.len == 0us { 0u32 } else {
            self._clusters:.alloc(count-> clusters.len)
        };

        let instance = {
            skinning:.add(node.uid,
                          geometry.range.vertexOffset,
                          geometry.range.nbVertices,
                          geometry.firstWeight,
                          nbJoints,
                          first,
                          cast!u32(clusters.len))
        } catch {
            err => {
                if clusters.len != 0us {
                    self._clusters:.free(first, count-> clusters.len);
                }

                throw err;
            }
        };

        for i, c in clusters {
            self._clusters:.setData!{ClusterSlot} (first + cast!u32(i), 0us,
                                                   ClusterSlot::skinned(c, geometry.range.firstIndex, instance.target, node.aabb));
        }

        instance
    }

    /**
     * @returns: the geometry of a mesh in the pool, with its clusters (with the weights of its bind vertices when the
     * shader draws skinned vertices, each instance having its own clusters), placed unless an instance drawing it placed
     * it already
     * @params:
     *    - mesh: the mesh
     * */
    fn place(mut self, mesh: &MeshGeometry)-> dmut &SharedGeometry
        throws BalderError
    {
        if let Ok(dmut g) = alias self._meshes[mesh.uid] {
            if g:.acquire() { return alias g; }
        }

        if self._meshes.len >= self._sweepAt {
            self:.sweepMeshes();
        }

        let (vertices, indices) = mesh.compact(self._config);
        let dmut range = self._geometry:.alloc(vertices, indices);

        if let Ok(dmut sk) = alias self._skinning {
            let firstWeight = {
                let (bones, weights) = mesh.skinWeights();
                sk:.placeWeights(bones, weights)
            } catch {
                err => {
                    range:.dispose();
                    throw err;
                }
            };

            let dmut g = copy SharedGeometry::skinned(alias range, alias self._clusters, alias sk, firstWeight);
            self._meshes[mesh.uid] = alias g;
            return alias g;
        }

        let clusters = mesh.clusters;
        let first = if clusters.len == 0us { 0u32 } else {
            {
                self._clusters:.alloc(count-> clusters.len)
            } catch {
                err => {
                    range:.dispose();
                    throw err;
                }
            }
        };

        for i, c in clusters {
            self._clusters:.setData!{ClusterSlot} (first + cast!u32(i), 0us, ClusterSlot(c, range.firstIndex, range.vertexOffset));
        }

        let dmut g = copy SharedGeometry(alias range, alias self._clusters, first, cast!u32(clusters.len));
        self._meshes[mesh.uid] = alias g;

        alias g
    }

    /**
     * Forget the geometries given back to the pool, the next sweep waiting for twice as many meshes as remain
     * */
    fn sweepMeshes(mut self) {
        let dmut alive: [usize => &SharedGeometry] = copy [];
        for uid, dmut g in alias self._meshes {
            if !g.isFreed() { alive[uid] = alias g; }
        }

        self._meshes = alias alive;
        self._sweepAt = max(MIN_SWEEP, 2us * alive.len);
    }

    /**
     * @returns: the counters of the draws of the instances, at the last build of their commands
     * */
    pub fn drawStats(self)-> DrawStats {
        let mut stats = DrawStats();
        for b in self._batches.values {
            let (commands, instances, triangles) = b.draws.getDrawn();
            if commands != 0u32 { stats.multiDraws += 1us; }

            stats.commands += cast!usize(commands);
            stats.instances += cast!usize(instances);
            stats.triangles += cast!usize(triangles);
        }

        stats
    }

    /**
     * Set the distance of the instances seen to the eye, their draws being drawn closest first
     * @params:
     *    - eye: the position of the camera
     * */
    pub fn sort(mut self, eye: vec3) {
        for dmut b in alias self._batches.values {
            if self._sortOwners.len < b.nodes.len {
                self._sortOwners = copy [0us; 2us * b.nodes.len];
                self._sortDistances = copy [0.0f; 2us * b.nodes.len];
            }

            let mut n = 0us;
            for dmut node in alias b.nodes.values {
                if node.culled { continue; }

                let sphere = node:.boundingSphere();
                self._sortOwners[n] = node.uid;
                self._sortDistances[n] = (sphere.center - eye).length() - sphere.radius;
                n += 1us;
            }

            // the distances given under one lock of the batch, the rendering thread building it meanwhile
            b.draws:.setDistances(self._sortOwners[0us .. n], self._sortDistances[0us .. n]);
        }
    }

    /**
     * @returns: the worlds of the frame before of the instances moving, advanced at the submission of each frame (see
     * FrameMotion)
     * */
    pub fn getMotion(mut self)-> dmut &MotionTracker {
        alias self._motion
    }

    /**
     * Cull the instances on the GPU with a cull shader, or on the CPU, from the next recordings
     * @params:
     *    - window: the window retiring the descriptor sets of the cull pass, when culled on the CPU
     *    - cull: the cull shader of the scene, none to cull on the CPU
     * */
    pub fn setCulling(mut self, dmut window: &Window, dmut cull: (&ComputeShader)?) {
        self._cull = alias cull;
        for i, dmut b in alias self._batches.values {
            if self._cull.hasValue {
                {
                    self:.cullOnGpu(alias b);
                } catch {
                    err => {
                        log::error #("Scene", "Failed to cull the draws of the material on the GPU", self._batches.keys[i], err);
                    }
                }
            } else {
                if let Ok(dmut set) = alias b.cullSet {
                    window:.retire(alias set);
                }

                b.cullSet = none;
                b.draws:.setCulled(false);
            }
        }
    }

    /**
     * Remove a visual instance from the draws of the shader
     * @params:
     *    - window: the window retiring the resources of the material batch, when it has no instance anymore
     *    - material: the material of the instance
     *    - node: the instance
     * */
    pub fn release(mut self, dmut window: &Window, material: &Material, node: &VisualInstance3D) {
        self._casters:.remove(node.uid);
        if let Ok(dmut sk) = alias self._skinning {
            sk:.forget(node.uid);
        }

        let key = material.getBatchKey();
        if let Ok(dmut b) = alias self._batches:[key] {
            b.nodes:.remove(node.uid);
            b.draws:.remove(node.uid);
            if b.nodes.len == 0us {
                window:.retire(alias b.set);
                window:.retire(alias b.draws);
                if let Ok(dmut set) = alias b.cullSet {
                    window:.retire(alias set);
                }

                self._batches:.remove(key);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          DRAWING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Lay out the draws of the instances for the recording of a frame, before any of them is recorded
     * @info: laid out before the pool is bound, the buffers bound holding the geometry of every draw laid out
     * @params:
     *    - frame: the frame being recorded
     * */
    pub fn layout(mut self, frame: u32) {
        for i, dmut b in alias self._batches.values {
            {
                b.draws:.begin(frame);
                for n in b.nodes.values {
                    b.draws:.add(frame, n.uid, n.getDraws());
                }

                b.count = b.draws:.end(frame);
                b.set:.setBuffer(UniformNames::OBJECTS, self._objects.getBuffer(), frame);
                if let Ok(words) = b.draws.getWordBuffer(frame) {
                    b.set:.setBuffer(UniformNames::INSTANCES, words, frame);
                }

                if let Ok(dmut set) = alias b.cullSet {
                    self.bindCull(frame, alias set, b.draws);
                }
            } catch {
                err => {
                    log::error #("Scene", "Failed to lay out the draws of the material", self._batches.keys[i], err);
                    b.count = 0u32;
                }
            }
        }
    }

    /**
     * Record the clear of the counters of the cull passes of the material keys culled on the GPU
     * @assume: the draws of the frame are laid out
     * */
    pub fn clearCounters(mut self, dmut cmd: &CullCommandAllocator) {
        for b in self._batches.values {
            cmd:.clear(b.draws);
        }
    }

    /**
     * Record the cull of the objects of the candidates of the material keys culled on the GPU, listing those seen
     * @assume: the counters are cleared, the cull pass of the scene is bound (see CullPass::select)
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the cull passes
     *    - width: the width of the view, in pixels
     *    - height: the height of the view, in pixels
     *    - minPixels: the size on screen in pixels under which an instance is culled
     * */
    pub fn cullObjects(mut self, frame: u32, dmut cmd: &CullCommandAllocator, width: f32, height: f32, minPixels: f32) {
        if let Ok(dmut shader) = alias self._cull {
            for b in self._batches.values {
                if let Ok(set) = b.cullSet {
                    set.select(frame, cmd.getCommandBuffer());
                    cmd:.cullObjects(alias shader, b.draws, width, height, minPixels);
                }
            }
        }
    }

    /**
     * Record the cull of the clusters of the candidates listed by cullObjects, writing the commands of the material keys
     * culled on the GPU
     * @assume: the objects are culled and their list made visible, the cull pass of the scene is bound; for the late
     * cull, the first commands are drawn and the depth pyramid built
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the cull passes
     *    - late: false for the first cull, true for the second one testing the clusters against the depth pyramid
     *    - width: the width of the view, in pixels
     *    - height: the height of the view, in pixels
     *    - levels: the number of levels of the depth pyramid, 0 when the occluded clusters are not culled
     * */
    pub fn cullClusters(mut self, frame: u32, dmut cmd: &CullCommandAllocator, late: bool, width: f32, height: f32, levels: u32) {
        if let Ok(dmut shader) = alias self._cull {
            for b in self._batches.values {
                if let Ok(set) = b.cullSet {
                    set.select(frame, cmd.getCommandBuffer());
                    cmd:.cullClusters(alias shader, b.draws, late, width, height, levels);
                }
            }
        }
    }

    /**
     * Record the copy of the counters of the material keys culled on the GPU, read back by the CPU (see drawStats)
     * @assume: the commands are written
     * */
    pub fn readBack(mut self, dmut cmd: &CullCommandAllocator) {
        for b in self._batches.values {
            cmd:.readBack(b.draws);
        }
    }

    /**
     * Record the depth prepass of the instances, one multi-draw per material key, nothing when the shader has no prepass
     * @assume: the draws of the frame are laid out
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording
     *    - late: false for the draws of the first cull, true for those of the second one (the material keys culled on
     *            the GPU only)
     * */
    pub fn drawDepth(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, late: bool)
        throws BalderError
    {
        if let sh: &RasterShader = self._shader:.get() {
            if !sh.hasPrepass() { return; }

            sh.selectPrepass(cmd.getCommandBuffer());
            self:.drawBatches(frame, alias cmd, late);
        }
    }

    /**
     * Record the draws of the instances, one multi-draw per material key
     * @assume: the draws of the frame are laid out, and their depth drawn when the shader has a prepass
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording
     *    - late: false for the draws of the first cull, true for those of the second one (the material keys culled on
     *            the GPU only)
     * */
    pub fn draw(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, late: bool)
        throws BalderError
    {
        self._shader:.get().select(cmd.getCommandBuffer());
        self:.drawBatches(frame, alias cmd, late);
    }

    /**
     * Record the skinning of the skinned instances of the shader for a frame, nothing when it draws rigid vertices
     * @assume: the skin shader is bound
     * @params:
     *    - frame: the frame being recorded
     *    - cmd: the command buffer of the skin pass
     *    - skin: the skin shader
     * */
    pub fn dispatchSkin(mut self, frame: u32, cmd: VkCommandBuffer, dmut skin: &ComputeShader) {
        if let Ok(dmut sk) = alias self._skinning {
            if let Ok(rest) = self._geometry.getVertexBuffer() {
                sk:.dispatch(frame, cmd, alias skin, rest);
            }
        }
    }

    /**
     * Bind the vertices and the indices the draws of a frame read: those of the pool, the vertices skinned for the frame
     * in place of the vertices of the pool when the shader draws skinned vertices
     * */
    fn selectGeometry(self, frame: u32, cmd: VkCommandBuffer) {
        self._geometry.select(cmd);
        if let Ok(sk) = self._skinning {
            sk.select(frame, cmd);
        }
    }

    /**
     * Record the multi-draws of the material keys with the pipeline selected
     * */
    fn drawBatches(mut self, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, late: bool) {
        self._camera.select(frame, cmd.getCommandBuffer());
        self.selectGeometry(frame, cmd.getCommandBuffer());

        for dmut b in alias self._batches.values {
            if b.count == 0u32 { continue; }

            let culled = b.draws.isCulled(frame);
            if late && !culled { continue; }

            b.set.select(frame, cmd.getCommandBuffer());
            if culled {
                cmd:.drawIndexedCount(b.draws, late);
            } else {
                cmd:.drawIndexed(b.draws, 0u32, b.count);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          SHADOW          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Draw the instances casting shadows in the views of a shadow map, with the shadow pipeline of the shader (built
     * once, for every shadow map of the same format)
     * @params:
     *    - map: the shadow map
     *    - window: the window retiring the resources of the views drawn before
     *    - renderPass: the render pass of the shadow map
     *    - width: the width of the shadow map
     *    - height: the height of the shadow map
     *    - cameras: the buffer holding the view of the light of each view
     *    - offsets: the offset of the camera of each view in the buffer
     * */
    pub fn castShadows(mut self,
                       map: ShadowMap,
                       dmut window: &Window,
                       renderPass: VkRenderPass,
                       width: u32,
                       height: u32,
                       cameras: &UniformBufferObject,
                       offsets: [usize])
        throws BalderError
    {
        if let dmut sh: &RasterShader = alias self._shader:.get() {
            if !sh.hasShadow() {
                sh:.configureShadow(renderPass, width, height);
            }
        }

        self._casters:.start(map, alias window, alias self._shader:.get(), cameras, offsets);
    }

    /**
     * Stop drawing the instances in a shadow map
     * @params:
     *    - map: the shadow map
     *    - window: the window retiring the resources of the views, the recordings in use still drawing with them
     * */
    pub fn stopShadows(mut self, map: ShadowMap, dmut window: &Window) {
        self._casters:.stop(map, alias window);
    }

    /**
     * Draw the instances casting shadows a view of a shadow map sees, and none of the others
     * @params:
     *    - map: the shadow map
     *    - view: the index of the view in the shadow map
     *    - seen: the uniq ids of the instances the view sees, of the shader or not
     * @returns: true iif the recordings have to be done again to draw them (the device has no multi-draw)
     * */
    pub fn seeShadows(mut self, map: ShadowMap, view: usize, seen: [usize])-> bool {
        self._casters:.see(map, view, seen)
    }

    /**
     * Lay out the draws of the instances casting shadows in the views of a shadow map, for the recording of a frame of
     * the shadow map
     * */
    pub fn layoutShadows(mut self, map: ShadowMap, frame: u32) {
        self._casters:.layout(map, frame, self._objects);
    }

    /**
     * Record the draws of the instances casting shadows a view of a shadow map sees, with the shadow pipeline of the
     * shader
     * @assume: the draws of the frame are laid out (see layoutShadows), the viewport is the one of the view
     * @params:
     *    - map: the shadow map
     *    - frame: the frame being recorded
     *    - cmd: the command allocator of the recording of the shadow map
     *    - view: the index of the view in the shadow map
     * */
    pub fn drawShadows(mut self, map: ShadowMap, frame: u32, dmut cmd: &IndexedDrawCommandAllocator, view: usize)
        throws BalderError
    {
        if !self._casters.isCasting(map) { return; }

        if let sh: &RasterShader = self._shader:.get() {
            if !sh.hasShadow() { return; }

            sh.selectShadow(cmd.getCommandBuffer());
            self.selectGeometry(frame, cmd.getCommandBuffer());
            self._casters:.draw(map, frame, alias cmd, view);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          CULLING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Cull the draws of a material key on the GPU when the cull shader is set, its descriptor set being allocated
     * */
    fn cullOnGpu(mut self, dmut b: &MaterialBatch)
        throws BalderError
    {
        if let Ok(dmut cull) = alias self._cull {
            if !b.cullSet.hasValue {
                let dmut set = cull:.allocateDescriptorSet(DescriptorContext::OBJECT);
                b.cullSet = (alias set)?;
            }

            b.draws:.setCulled(true);
        }
    }

    /**
     * Bind the buffers the cull pass of a material key reads and writes for a frame
     * @assume: the draws of the frame are laid out
     * */
    fn bindCull(self, frame: u32, dmut set: &DescriptorSet, draws: &InstanceBatch) {
        if !draws.isCulled(frame) { return; }

        set:.setBuffer(UniformNames::OBJECTS, self._objects.getBuffer(), frame);
        set:.setBuffer(UniformNames::CLUSTERS, self._clusters.getBuffer(), frame);
        for name, buffer in copy [UniformNames::DRAWS => draws.getCandidateBuffer(frame),
                                  UniformNames::COUNTERS => draws.getCounterBuffer(frame),
                                  UniformNames::COMMANDS => draws.getCulledCommandBuffer(frame),
                                  UniformNames::INSTANCES => draws.getWordBuffer(frame),
                                  UniformNames::VISIBILITY => draws.getVisibilityBuffer(frame)] {
            if let Ok(b) = buffer {
                set:.setBuffer(name, b, frame);
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Retire the resources of the shader
     * @params:
     *    - window: the window retiring the resources, the recordings in use still drawing with them
     * */
    pub fn retire(mut self, dmut window: &Window) {
        for dmut b in alias self._batches.values {
            window:.retire(alias b.set);
            window:.retire(alias b.draws);
            if let Ok(dmut set) = alias b.cullSet {
                window:.retire(alias set);
            }
        }

        self._casters:.stopAll(alias window);
        if let Ok(dmut sk) = alias self._skinning {
            sk:.retire(alias window);
            self._skinning = none;
        }

        self._batches:.clear();
        self._meshes = copy [];
        self._sweepAt = MIN_SWEEP;
        window:.retire(alias self._camera);
        window:.retire(alias self._geometry);
        window:.retire(alias self._objects);
        window:.retire(alias self._clusters);
        self._shader:.dispose();
    }
}

/**
 * @returns: the number of floats of a vertex read by the shader 'cfg'
 * */
fn vertexStride(cfg: &RasterShaderConfig)-> u32 {
    let mut size = 0u32;
    for _, e in cfg.entries {
        size += e._1;
    }

    size / 4u32
}
