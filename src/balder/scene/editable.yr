in editable;

use balder::core::application::{signal, window};
use balder::scene::selection;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::visual;

use ::std::time::dur;

/**
 * A scene whose nodes are edited: it selects nodes, outlining the visual instances among them and under them
 * @info: a Scene3D with editable: true renders one; a selectable ScenePicker selects the instances clicked in it, and a
 * SceneGizmo spawns a gizmo moving the nodes selected while there are some. A node removed from the scene leaves the
 * selection, and its meshes keep their triangles to be picked
 * */
pub class EditableScene over Scene {

    // The nodes selected, the visual instances among them and under them being outlined
    let dmut _selection: &Selection = copy Selection();

    // The slots of the changes of the selection, emitted at each tick
    let dmut _slots: &SlotEmitter = copy SlotEmitter();

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a new editable scene (not configured), nothing selected
     * */
    pub self (dmut window: &Window, name: [c8])
        with super(alias window, name)
    {
        self._keepsTriangles = true;
        self._selection:.changed():.connect(alias self._slots, &self:.onSelectionChanged);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SELECTION          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the nodes selected in the scene, the visual instances among them and under them being outlined
     * */
    @field
    pub fn selection(mut self)-> dmut &Selection {
        alias self._selection
    }

    /**
     * @returns: the nodes selected in the scene
     * */
    @field
    pub fn selection(self)-> &Selection {
        self._selection
    }

    /**
     * Detach a node from the rendering scene, and remove it from the selection
     * */
    pub over removeNode(mut self, dmut node: &Node) {
        self.__super__:.removeNode(alias node);
        self._selection:.remove(node);
    }

    /**
     * Follow the changes of the selection, then tick the scene
     * */
    pub over onTick(mut self, delta: Duration) {
        self._slots:.emit();
        self.__super__:.onTick(delta);
    }

    /**
     * Outline the visual instances selected and those under the nodes selected, and stop outlining the others
     * */
    fn onSelectionChanged(mut self) {
        let dmut outlined: [usize => &VisualInstance3D] = copy [];
        for dmut n in alias self._selection.nodes {
            let dmut nodes: [&Node] = [];
            n:.getAllNodes(ref nodes);
            for dmut d in alias nodes if let dmut v: &VisualInstance3D = alias d {
                outlined[v.uid] = alias v;
            }
        }

        self:.outline(alias outlined);
    }

}
