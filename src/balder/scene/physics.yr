in physics;

/**
 * The layer every body is in by default
 * */
pub def DEFAULT_LAYER = 1u32;

/**
 * Every layer: the mask of a body seeing all the others, of a query hitting every body
 * */
pub def ALL_LAYERS = u32::max;

