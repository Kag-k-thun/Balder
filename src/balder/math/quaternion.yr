in quaternion;

use balder::math::{matrix, vector};

use std::math;

/**
 * Two unit quaternions closer than that (their dot product above it) are interpolated linearly, the angle between them
 * being too small for its sine to divide
 * */
def SLERP_LINEAR_DOT = 0.9995f;

/**
 * A quaternion x i + y j + z k + w, a rotation when its length is one: the rotation of an angle a about a unit axis n
 * is (n sin (a / 2), cos (a / 2)), its opposite giving the same rotation
 * */
pub record Quaternion {

    pub let mut x: f32;

    pub let mut y: f32;

    pub let mut z: f32;

    pub let mut w: f32;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The identity rotation by default
     * */
    pub self (x: f32 = 0.0f, y: f32 = 0.0f, z: f32 = 0.0f, w: f32 = 1.0f)
        with x = x
        , y = y
        , z = z
        , w = w
    {}

    /**
     * The rotation of an angle about an axis
     * @params:
     *    - angle: the angle, in radian
     *    - axis: the axis, of any length but zero
     * */
    pub self fromAxisAngle(angle: f32, axis: vec3)
        with x = 0.0f, y = 0.0f, z = 0.0f, w = 1.0f
    {
        let n = axis.normalized() * sin(angle / 2.0f);
        self.x = n.x;
        self.y = n.y;
        self.z = n.z;
        self.w = cos(angle / 2.0f);
    }

    /**
     * The rotation of a matrix, its w positive or zero
     * @params:
     *    - m: the matrix, its 3x3 part orthonormal with a determinant of one
     * */
    pub self fromRotation(m: mat4)
        with x = 0.0f, y = 0.0f, z = 0.0f, w = 1.0f
    {
        // the largest of w, x, y and z is computed from the diagonal, the others dividing by it
        let trace = m.a1 + m.b2 + m.c3;
        if trace > 0.0f {
            let s = sqrt(trace + 1.0f) * 2.0f;
            self.w = s / 4.0f;
            self.x = (m.c2 - m.b3) / s;
            self.y = (m.a3 - m.c1) / s;
            self.z = (m.b1 - m.a2) / s;
        } else if m.a1 > m.b2 && m.a1 > m.c3 {
            let s = sqrt(1.0f + m.a1 - m.b2 - m.c3) * 2.0f;
            self.w = (m.c2 - m.b3) / s;
            self.x = s / 4.0f;
            self.y = (m.a2 + m.b1) / s;
            self.z = (m.a3 + m.c1) / s;
        } else if m.b2 > m.c3 {
            let s = sqrt(1.0f + m.b2 - m.a1 - m.c3) * 2.0f;
            self.w = (m.a3 - m.c1) / s;
            self.x = (m.a2 + m.b1) / s;
            self.y = s / 4.0f;
            self.z = (m.b3 + m.c2) / s;
        } else {
            let s = sqrt(1.0f + m.c3 - m.a1 - m.b2) * 2.0f;
            self.w = (m.b1 - m.a2) / s;
            self.x = (m.a3 + m.c1) / s;
            self.y = (m.b3 + m.c2) / s;
            self.z = s / 4.0f;
        }

        if self.w < 0.0f {
            self.x = -self.x;
            self.y = -self.y;
            self.z = -self.z;
            self.w = -self.w;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          OPERATIONS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the product of two quaternions, the rotation by o then by self
     * */
    pub fn opBinary {"*"} (self, o: Quaternion)-> Quaternion {
        Quaternion(x-> self.w * o.x + self.x * o.w + self.y * o.z - self.z * o.y,
                   y-> self.w * o.y - self.x * o.z + self.y * o.w + self.z * o.x,
                   z-> self.w * o.z + self.x * o.y - self.y * o.x + self.z * o.w,
                   w-> self.w * o.w - self.x * o.x - self.y * o.y - self.z * o.z)
    }

    /**
     * @returns: a vector turned by the rotation
     * */
    pub fn opBinary {"*"} (self, v: vec3)-> vec3 {
        let u = makeVec3(self.x, self.y, self.z);
        let t = u.cross(v) * 2.0f;
        v + t * self.w + u.cross(t)
    }

    /**
     * @returns: the dot product of two quaternions, the cosine of half the angle between two rotations
     * */
    pub fn dot(self, o: Quaternion)-> f32 {
        self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w
    }

    /**
     * @returns: the length of the quaternion
     * */
    pub fn length(self)-> f32 {
        sqrt(self.dot(self))
    }

    /**
     * @returns: the quaternion of length one in the direction of this one, the identity when this one is zero
     * */
    pub fn normalized(self)-> Quaternion {
        let len = self.length();
        if len == 0.0f {
            return Quaternion();
        }

        Quaternion(x-> self.x / len, y-> self.y / len, z-> self.z / len, w-> self.w / len)
    }

    /**
     * @returns: the conjugate of the quaternion, the inverse rotation of a unit quaternion
     * */
    pub fn conjugate(self)-> Quaternion {
        Quaternion(x-> -self.x, y-> -self.y, z-> -self.z, w-> self.w)
    }

    /**
     * @returns: the rotation matrix of a unit quaternion
     * */
    pub fn matrix(self)-> mat4 {
        let xx = self.x * self.x, yy = self.y * self.y, zz = self.z * self.z;
        let xy = self.x * self.y, xz = self.x * self.z, yz = self.y * self.z;
        let wx = self.w * self.x, wy = self.w * self.y, wz = self.w * self.z;

        mat4(a1-> 1.0f - 2.0f * (yy + zz), a2-> 2.0f * (xy - wz), a3-> 2.0f * (xz + wy),
             b1-> 2.0f * (xy + wz), b2-> 1.0f - 2.0f * (xx + zz), b3-> 2.0f * (yz - wx),
             c1-> 2.0f * (xz - wy), c2-> 2.0f * (yz + wx), c3-> 1.0f - 2.0f * (xx + yy))
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          INTERPOLATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the rotation at t between two unit quaternions, turning at a constant speed along the shortest path
     * @params:
     *    - to: the rotation at t = 1
     *    - t: the progress from self (0) to `to` (1)
     * */
    pub fn slerp(self, to: Quaternion, t: f32)-> Quaternion {
        let (end, cosine) = self.shortestEnd(to);
        if cosine > SLERP_LINEAR_DOT {
            return self.lerped(end, t).normalized();
        }

        let angle = acos(cosine);
        let sine = sin(angle);
        let a = sin((1.0f - t) * angle) / sine;
        let b = sin(t * angle) / sine;

        Quaternion(x-> self.x * a + end.x * b,
                   y-> self.y * a + end.y * b,
                   z-> self.z * a + end.z * b,
                   w-> self.w * a + end.w * b)
    }

    /**
     * @returns: the rotation at t between two unit quaternions along the shortest path, interpolated linearly then
     * normalized: cheaper than slerp, its speed not constant (exact at 0, 1/2 and 1)
     * @params:
     *    - to: the rotation at t = 1
     *    - t: the progress from self (0) to `to` (1)
     * */
    pub fn nlerp(self, to: Quaternion, t: f32)-> Quaternion {
        let (end, _) = self.shortestEnd(to);
        self.lerped(end, t).normalized()
    }

    /**
     * @returns:
     *    - 0: `to`, or its opposite when it is closer to self, the same rotation reached along the shortest path
     *    - 1: the dot product of self and the end returned, positive or zero
     * */
    fn shortestEnd(self, to: Quaternion)-> (Quaternion, f32) {
        let cosine = self.dot(to);
        if cosine < 0.0f {
            return (Quaternion(x-> -to.x, y-> -to.y, z-> -to.z, w-> -to.w), -cosine);
        }

        (to, cosine)
    }

    /**
     * @returns: the quaternion at t on the segment from self to `to`, not normalized
     * */
    fn lerped(self, to: Quaternion, t: f32)-> Quaternion {
        Quaternion(x-> self.x + (to.x - self.x) * t,
                   y-> self.y + (to.y - self.y) * t,
                   z-> self.z + (to.z - self.z) * t,
                   w-> self.w + (to.w - self.w) * t)
    }

}
