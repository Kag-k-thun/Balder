in rigid_transform;

use balder::math::{matrix, quaternion, utils, vector};

/**
 * A rotation, then a translation, the placement of a rigid body: composed, inverted and applied without a matrix
 * */
pub record RigidTransform {

    // The translation, applied after the rotation
    pub let mut position: vec3;

    // The rotation, a unit quaternion
    pub let mut rotation: Quaternion;

    /**
     * The identity by default
     * */
    pub self(position: vec3 = vec3(),
             rotation: Quaternion = Quaternion())
        with position = position
        , rotation = rotation
    {}

    /**
     * The rigid part of a transofmration, its scale dropped (see axesRotation)
     *
     * */
    pub self(m: mat4)
        with position = makeVec3(m.a4, m.b4, m.c4)
        , rotation = Quaternion::fromRotation(axesRotation(m))
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          OPERATIONS          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the transform applying o, then self
     * */
    pub fn opBinary{"*"}(self, o: RigidTransform)-> RigidTransform {
        RigidTransform(position-> self.position + self.rotation * o.position,
                       rotation-> (self.rotation * o.rotation).normalized())
    }

    /**
     * @returns: the transform undoing this one
     * */
    pub fn inversed(self)-> RigidTransform {
        let back = self.rotation.conjugate();
        RigidTransform(position-> (back * self.position) * -1.0f,
                       rotation-> back)
    }

    /**
     * @returns: a point moved by this transformation
     * */
    pub fn transformPoint(self, p: vec3)-> vec3 {
        self.rotation * p + self.position
    }

    /**
     * @returns: a direction turned by the transform, not translated
     * */
    pub fn transformDirection(self, dir: vec3)-> vec3 {
        self.rotation * dir
    }

    /**
     * @returns: the matrix of the transform, translation * rotation
     */
    pub fn matrix(self)-> mat4 {
        translation(self.position) * self.rotation.matrix()
    }

    /**
     * @returns: the linear interpolation between self (0) and to (1)
     * @params:
     *    - weight: the weight of the interpolation
     * */
    pub fn interpolated(self, to: RigidTransform, weight: f32)-> RigidTransform {
        RigidTransform(position-> self.position + (to.position - self.position) * weight,
                       rotation-> self.rotation.slerp(to.rotation, weight))
    }
}
