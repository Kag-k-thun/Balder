in inertia;

use balder::math::{matrix, quaternion, vector};

use std::algorithm::comparison;

/**
 * @returns: the moments of inertia of a solid box about its X, Y and Z axes, through it's center
 * @params:
 *   - mass: the mass of the box
 *   - size: the length of its sides along X, Y, Z
 * */
pub fn boxInertia(mass: f32, size: vec3)-> vec3 {
    let k = mass / 12.0f;
    let x2 = size.x * size.x;
    let y2 = size.y * size.y;
    let z2 = size.z * size.z;

    makeVec3(k * (y2 + z2),
             k * (x2 + z2),
             k * (x2 + y2))
}

/**
 * @returns: the moments of inertia of a solid sphere
 * @params:
 *    - mass: the mass of the sphere
 *    - radius: the radius of the sphere
 * */
pub fn sphereInertia(mass: f32, radius: f32)-> vec3 {
    let i = 0.4f * mass * radius * radius;
    makeVec3(i, i, i)
}

/**
 * @returns: the moments of inertia of a solid cynlinder along the Y axis, through its center
 * @params:
 *    - height: the length of the cylinder along Y.
 * */
pub fn cylinderInertia(mass: f32, radius: f32, height: f32)-> vec3 {
    let side = mass * (3.0f * radius * radius + height * height) / 12.0f;
    makeVec3(side, mass * radius * radius / 2.0f, side)
}


/**
 * @returns: the moments of inertia of a solid capsule along the y axis, through its center
 * @params:
 *    - height: the lenght of the capsule along Y, its caps included (see ColliderShape::capsulee
 * @info: the mass splits between the cylinder and the volume, the caps moved from the center
 * */
pub fn capsuleInertia(mass: f32, radius: f32, height: f32)-> vec3 {
    let r2 = radius * radius;
    let h = max(height - 2.0f * radius, 0.0f);

    let cylinder = mass * h / (h + 4.0f * radius / 3.0f);
    let caps = mass - cylinder;

    let axial = cylinder * r2 / 2.0f + caps * 2.0f * r2 / 5.0f;
    let side = cylinder * (h * h / 12.0f + r2 / 4.0f) + caps * (2.0f * r2 / 5.0f + (h * h / 4.0f) + (3.0f * h * radius / 8.0f));

    makeVec3(side, axial, side)
}

/**
 * @returns: the inverse of the moments of inertia, zero for an axis of no moments (a body that never turns about it)
 * */
pub fn inverseMoments(moments: vec3)-> vec3 {
    makeVec3(if moments.x > 0.0f { 1.0f / moments.x } else { 0.0f },
             if moments.y > 0.0f { 1.0f / moments.y } else { 0.0f },
             if moments.z > 0.0f { 1.0f / moments.z } else { 0.0f })
}


/**
 * @returns: the inverse inertia tensor of a body in the world, R diag(inverse) R^T
 * @params:
 *    - rotation: the rotation of the body
 *    - inverse: the inverse of its moments about its own axed (see inverseMoments), zero for a static body
 * */
pub fn worldInverseInertia(rotation: Quaternion, inverse: vec3)-> mat3 {
    let r = rotation.matrix().mat3();
    let d = makeMat3(inverse.x, 0.0f, 0.0f,
                     0.0f, inverse.y, 0.0f,
                     0.0f, 0.0f, inverse.z);

    r * d * r.transposed()
}


/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          TENSORS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * @returns: the tensor of moments about the X, the Y, and the Z axes, without product of inertia
 *
 * */
pub fn diagonalTensor(moments: vec3)-> mat3 {
    makeMat3(moments.x, 0.0f, 0.0f,
             0.0f, moments.y, 0.0f,
             0.0f, 0.0f, moments.z)
}

/**
 * @returns: an inertia tensor turned by a rotation, R I R^T
 *
 * */
pub fn rotatedTensor(tensor: mat3, rotation: Quaternion)-> mat3 {
    let r = rotation.matrix().mat3();
    r * tensor * r.transposed()
}


/**
 * @returns: the inertia tensor of a mass about a point at an offset from its
 * centre (parallel axes), I + m (|d|^2 E - d d^T)
 *
 * @info: a negative mass moves the tensor of a point back to the centre of the mass
 *
 * */
pub fn shiftedTensor(tensor: mat3, mass: f32, offset: vec3)-> mat3 {
    let d = offset;
    let dd = d.dot(d);
    tensor + makeMat3(mass * (dd - d.x * d.x), -mass * d.x * d.y, -mass * d.x * d.z,
                      -mass * d.y * d.x, mass * (dd - d.y * d.y), -mass * d.y * d.z,
                      -mass * d.z * d.x, -mass * d.z * d.y, mass * (dd - d.z * d.z))
}

/**
 * @returns: the inverse inertia tensor of a body in the world, R inverse R^T
 *
 * @params:
 *    - rotation: the rotation of the body
 *    - inverse: the inverse of its tensor about its center of mass, along its own axes, zero foa  body nothing turns
 *
 * */
pub fn worldInverseInertia(rotation: Quaternion, inverse: mat3)-> mat3 {
    rotatedTensor(inverse, rotation)
}
