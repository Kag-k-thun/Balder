in frustum;

use balder::math::{matrix, vector};

use std::math;

/**
 * Where a volume stands relative to a frustum
 * */
pub enum Containment: u8
| OUTSIDE      = 0
| INTERSECTING = 1
| INSIDE       = 2;

/**
 * The volume seen through a projection, bounded by six planes facing its inside
 * @info: the default frustum has no bound and contains everything
 * */
pub record Frustum {

    // The planes bounding the frustum: left, right, bottom, top, near, far
    pub let mut planes: [Plane ; 6] = [Plane() ; 6];

    pub self () {}

    /**
     * Extract the planes of the volume seen through a view and a projection (Gribb–Hartmann)
     * @info: the clip volume is the one of the projections of balder::math::utils, -w <= x, y, z <= w; a point p is
     * inside when every row of the matrix verifies -row4.p <= rowi.p <= row4.p, each side of which is a plane
     * @params:
     *    - viewProj: the projection multiplied by the view, from world space to clip space
     * */
    pub self (viewProj: mat4) {
        let m = viewProj;
        let r1 = makeVec4(m.a1, m.a2, m.a3, m.a4);
        let r2 = makeVec4(m.b1, m.b2, m.b3, m.b4);
        let r3 = makeVec4(m.c1, m.c2, m.c3, m.c4);
        let r4 = makeVec4(m.d1, m.d2, m.d3, m.d4);

        self.planes = [Plane(r4 + r1), Plane(r4 - r1),
                       Plane(r4 + r2), Plane(r4 - r2),
                       Plane(r4 + r3), Plane(r4 - r3)];
    }

    /**
     * @returns: where a sphere stands relative to the frustum, an empty sphere being outside
     * */
    pub fn classify(self, sphere: Sphere)-> Containment {
        if sphere.isEmpty { return Containment::OUTSIDE; }

        let mut result = Containment::INSIDE;
        for p in self.planes {
            let d = p.signedDistance(sphere.center);
            if d < -sphere.radius { return Containment::OUTSIDE; }
            if d < sphere.radius { result = Containment::INTERSECTING; }
        }

        result
    }

    /**
     * @info: conservative, a box outside the frustum next to one of its edges but crossing the planes of both of its
     * faces is said to be intersecting
     * @returns: where a box stands relative to the frustum, an empty box being outside
     * */
    pub fn classify(self, box: Aabb)-> Containment {
        if box.isEmpty { return Containment::OUTSIDE; }

        let c = box.center, e = box.extent;
        let mut result = Containment::INSIDE;
        for p in self.planes {
            let d = p.signedDistance(c);
            let r = math::abs(p.normal.x) * e.x + math::abs(p.normal.y) * e.y + math::abs(p.normal.z) * e.z;
            if d < -r { return Containment::OUTSIDE; }
            if d < r { result = Containment::INTERSECTING; }
        }

        result
    }

    /**
     * @returns: true iif a part of the sphere may be in the frustum
     * */
    pub fn intersects(self, sphere: Sphere)-> bool {
        self.classify(sphere) != Containment::OUTSIDE
    }

    /**
     * @returns: true iif a part of the box may be in the frustum
     * */
    pub fn intersects(self, box: Aabb)-> bool {
        self.classify(box) != Containment::OUTSIDE
    }

}
