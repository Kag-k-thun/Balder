in aabb;

use balder::math::{matrix, vector};

use std::math;
use std::algorithm::comparison;

/**
 * A box whose faces are aligned with the axes
 * @info: an empty box has its minimum above its maximum, so that merging a box into it gives that box
 * */
pub record Aabb {

    // The minimal corner (smallest x, y, z)
    pub let mut min: vec3 = makeVec3(f32::max, f32::max, f32::max);

    // The maximal corner (biggest x, y, z)
    pub let mut max: vec3 = makeVec3(-f32::max, -f32::max, -f32::max);

    /**
     * An empty box
     * */
    pub self () {}

    pub self (min: vec3, max: vec3)
        with min = min
        , max = max
    {}

    /**
     * @returns: true iif the box contains no point
     * */
    @field
    pub fn isEmpty(self)-> bool {
        self.min.x > self.max.x || self.min.y > self.max.y || self.min.z > self.max.z
    }

    /**
     * @returns: the center of the box
     * */
    @field
    pub fn center(self)-> vec3 {
        (self.min + self.max) / 2.0f
    }

    /**
     * @returns: the half of the size of the box along each axis
     * */
    @field
    pub fn extent(self)-> vec3 {
        (self.max - self.min) / 2.0f
    }

    /**
     * @returns: the smallest box enclosing this box and another one
     * */
    pub fn merged(self, other: Aabb)-> Aabb {
        Aabb(makeVec3(comparison::min(self.min.x, other.min.x),
                      comparison::min(self.min.y, other.min.y),
                      comparison::min(self.min.z, other.min.z)),
             makeVec3(comparison::max(self.max.x, other.max.x),
                      comparison::max(self.max.y, other.max.y),
                      comparison::max(self.max.z, other.max.z)))
    }

    /**
     * @info: the center is transformed as a point, the extent by the absolute values of the linear part of the
     * transformation (Arvo), so the box encloses the transformed box without walking its eight corners
     * @returns: the smallest box aligned with the axes enclosing the box once transformed
     * */
    pub fn transformed(self, m: mat4)-> Aabb {
        if self.isEmpty { return self; }

        let c = (m * makeVec4(self.center, 1.0f)).xyz;
        let e = self.extent;
        let r = makeVec3(math::abs(m.a1) * e.x + math::abs(m.a2) * e.y + math::abs(m.a3) * e.z,
                         math::abs(m.b1) * e.x + math::abs(m.b2) * e.y + math::abs(m.b3) * e.z,
                         math::abs(m.c1) * e.x + math::abs(m.c2) * e.y + math::abs(m.c3) * e.z);

        Aabb(c - r, c + r)
    }

    /**
     * @returns: the sphere enclosing the box, empty when the box is
     * */
    @field
    pub fn boundingSphere(self)-> Sphere {
        if self.isEmpty { return Sphere(); }

        Sphere(self.center, self.extent.length())
    }

}
