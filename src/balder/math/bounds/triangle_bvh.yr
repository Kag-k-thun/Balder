in triangle_bvh;

use balder::math::vector;

use std::math;

/**
 * The cosine of the angle between two triangles over which their shared edge
 * is inactive, a contact on it taking the normal of its triangle (5 degrees)
 *
 * */
def ACTIVE_ANGLE = 0.9962f;

/**
 * The size of the grid the positions are welded to, to find the edges shared by
 * triangles whose vertices are split (at seams of the normals or the uvs)
 *
 * */
def WELD = 1.0e-5f;

/**
 * The triangles of a mesh in a bounding volume hierarchy of their boxes, a ray finding the triangle it hits first
 * @info: the hierarchy is built at the first raycast, so a mesh never picked keeps only its positions and its indices
 * */
@final
pub class TriangleBvh {

    // The positions of the vertices
    let _positions: [vec3];

    // The indices of the vertices of the triangles, three by triangle
    let _indices: [u32];

    // The hierarchy of the boxes of the triangles, their ids being their indices, none until the first raycast
    let mut _bvh: (&Bvh)? = none;

    // The active edges of each triangle, a bit by edge (see activeEdges), none until asked
    let mut _active: ([u8])? = none;

    /**
     * @params:
     *    - positions: the positions of the vertices
     *    - indices: the indices of the vertices of the triangles, three by triangle, a last incomplete triangle ignored
     * */
    pub self (positions: [vec3], indices: [u32])
        with _positions = positions
        , _indices = indices
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of triangles
     * */
    @field
    pub fn len(self)-> usize {
        self._indices.len / 3us
    }

    /**
     * @returns: the positions of the vertices
     */
    @field
    pub fn positions(self)-> [vec3] {
        self._positions
    }

    /**
     * @returns: the triangle of index 'index'
     * */
    pub fn getTriangle(self, index: usize)-> Triangle {
        Triangle(self._positions[self._indices[3us * index]],
                 self._positions[self._indices[3us * index + 1us]],
                 self._positions[self._indices[3us * index + 2us]])
    }

    /**
     * @returns: the hierarchy of the boxes of the triangles, their ids being their indices, built at the first call (a
     * collider of the physics building it at once, to query it without changing it)
     * */
    pub fn hierarchy(mut self)-> &Bvh {
        if let Ok(bvh) = self._bvh { return bvh; }

        let dmut boxes = copy [Aabb(); self.len];
        for i in 0us .. self.len {
            boxes[i] = self.getTriangle(i).aabb;
        }

        let bvh = copy Bvh(boxes);
        self._bvh = (bvh)?;
        bvh
    }

    /**
     * @returns: the active edges of each triangle, a bit by edge (1 for ab, 2
     * for bc, 4 for ca): those on the border of the mesh, or between two
     * triangles meeting at more than ACTIVE_ANGLE; computed at the first call
     * (a collider of the physics computing them at once, like the hierarchy)
     *
     * */
    pub fn activeEdges(mut self)-> [u8] {
        if let Ok(a) = self._active { return a; }

        // the vertices welded by position, then the edges by their welded ends, with the first triangle found on them
        let dmut welded: [(i64, i64, i64) => u32] = copy [];
        let dmut ids = copy [0u32; self._positions.len];
        for i in 0us .. self._positions.len {
            let key = gridOf(self._positions[i]);
            if let Ok(id) = welded[key] {
                ids[i] = id;
            } else {
                ids[i] = cast!u32(welded.len);
                welded[key] = ids[i];
            }
        }

        let dmut seen: [u64 => (usize, u8, vec3)] = copy [];
        let dmut active = copy [7u8; self.len];
        for t in 0us .. self.len {
            let tri = self.getTriangle(t);
            let n = (tri.b - tri.a).cross(tri.c - tri.a).normalized();
            for e in 0us .. 3us {
                let from = ids[self._indices[3us * t + e]], to = ids[self._indices[3us * t + (e + 1us) % 3us]];
                let key = if from < to { (cast!u64(from) << 32u64) | cast!u64(to) } else { (cast!u64(to) << 32u64) | cast!u64(from) };
                let bit = cast!u8(1u32 << cast!u32(e));
                if let Ok((other, otherBit, m)) = seen[key] {
                    if n.dot(m) >= ACTIVE_ANGLE {
                        active[t] = cleared(active[t], bit);
                        active[other] = cleared(active[other], otherBit);
                    }
                } else {
                    seen[key] = (t, bit, n);
                }
            }
        }

        self._active = (active)?;
        active
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          RAYCAST          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the triangle a ray hits first, the hierarchy being built at the first call
     * @returns: the triangle hit first, its index as id, none when the ray misses every triangle
     * */
    pub fn raycast(mut self, ray: Ray)-> (RayHit)? {
        let bvh = self:.hierarchy();
        bvh.raycast(ray, copy |index: usize, _: f32| {
            if let Ok(distance) = self.getTriangle(index).intersect(ray) { distance } else { f32::max }
        })
    }

}

/**
 * @returns: the cell of the grid of the welds holding a position
 * */
fn gridOf(p: vec3)-> (i64, i64, i64) {
    (cast!i64(math::round(p.x / WELD)), cast!i64(math::round(p.y / WELD)), cast!i64(math::round(p.z / WELD)))
}

/**
 * @returns: bits with one of them cleared
 * */
fn cleared(bits: u8, bit: u8)-> u8 {
    if (bits & bit) != 0u8 { bits - bit } else { bits }
}
