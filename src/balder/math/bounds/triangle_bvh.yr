in triangle_bvh;

use balder::math::vector;

/**
 * The triangles of a mesh in a bounding volume hierarchy of their boxes, a ray finding the triangle it hits first
 * @info: the hierarchy is built at the first raycast, so a mesh never picked keeps only its positions and its indices
 * */
@final
pub class TriangleBvh {

    // The positions of the vertices
    let _positions: [vec3];

    // The indices of the vertices of the triangles, three by triangle
    let _indices: [u32];

    // The hierarchy of the boxes of the triangles, their ids being their indices, none until the first raycast
    let mut _bvh: (&Bvh)? = none;

    /**
     * @params:
     *    - positions: the positions of the vertices
     *    - indices: the indices of the vertices of the triangles, three by triangle, a last incomplete triangle ignored
     * */
    pub self (positions: [vec3], indices: [u32])
        with _positions = positions
        , _indices = indices
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of triangles
     * */
    @field
    pub fn len(self)-> usize {
        self._indices.len / 3us
    }

    /**
     * @returns: the triangle of index 'index'
     * */
    pub fn getTriangle(self, index: usize)-> Triangle {
        Triangle(self._positions[self._indices[3us * index]],
                 self._positions[self._indices[3us * index + 1us]],
                 self._positions[self._indices[3us * index + 2us]])
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          RAYCAST          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find the triangle a ray hits first, the hierarchy being built at the first call
     * @returns: the triangle hit first, its index as id, none when the ray misses every triangle
     * */
    pub fn raycast(mut self, ray: Ray)-> (RayHit)? {
        let bvh = self:.hierarchy();
        bvh.raycast(ray, copy |index: usize, _: f32| {
            if let Ok(distance) = self.getTriangle(index).intersect(ray) { distance } else { f32::max }
        })
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the hierarchy of the boxes of the triangles, built at the first call
     * */
    fn hierarchy(mut self)-> &Bvh {
        if let Ok(bvh) = self._bvh { return bvh; }

        let dmut boxes = copy [Aabb(); self.len];
        for i in 0us .. self.len {
            boxes[i] = self.getTriangle(i).aabb;
        }

        let bvh = copy Bvh(boxes);
        self._bvh = (bvh)?;
        bvh
    }

}
