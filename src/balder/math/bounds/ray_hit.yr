in ray_hit;

/**
 * The leaf of a hierarchy a ray hits first, entering its box or hitting what the box encloses
 * */
@data
pub record RayHit {

    // The id of the leaf
    pub let mut id: usize = 0us;

    // The distance along the ray at which it hits the leaf, 0 for a box hit that the ray starts inside
    pub let mut distance: f32 = 0.0f;

}
