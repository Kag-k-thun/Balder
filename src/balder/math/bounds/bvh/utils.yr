in utils;

use balder::math::vector;

/**
 * @returns: the area of the faces of a box, 0 when it is empty
 * */
pub fn area(box: Aabb)-> f32 {
    if box.isEmpty { return 0.0f; }

    let d = box.max - box.min;
    2.0f * (d.x * d.y + d.y * d.z + d.z * d.x)
}

/**
 * @returns: the component 'axis' of a vector, 0 for x, 1 for y, 2 for z
 * */
pub fn component(v: vec3, axis: u32)-> f32 {
    if axis == 0u32 { v.x } else if axis == 1u32 { v.y } else { v.z }
}

/**
 * @returns: a box grown by a margin on every side, then stretched along a
 * displacement, on the side it moves toward only
 *
 * */
pub fn enlarged(box: Aabb, margin: f32, displacement: vec3)-> Aabb {
    let grow = makeVec3(margin, margin, margin);
    let mut low = box.min - grow;
    let mut high = box.max + grow;
    if displacement.x < 0.0f {
        low.x += displacement.x;
    } else {
        high.x += displacement.x;
    }

    if displacement.y < 0.0f {
        low.y += displacement.y;
    } else {
        high.y += displacement.y;
    }

    if displacement.z < 0.0f {
        low.z += displacement.z;
    } else {
        high.z += displacement.z;
    }

    Aabb(low, high)
}
