in sphere;

use balder::math::vector;

/**
 * A sphere, empty when its radius is negative
 * */
pub record Sphere {

    pub let mut center: vec3 = vec3();

    pub let mut radius: f32 = -1.0f;

    /**
     * An empty sphere
     * */
    pub self () {}

    pub self (center: vec3, radius: f32)
        with center = center
        , radius = radius
    {}

    /**
     * @returns: true iif the sphere contains no point
     * */
    @field
    pub fn isEmpty(self)-> bool {
        self.radius < 0.0f
    }

}
