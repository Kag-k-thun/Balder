in cull_stats;

/**
 * The counters of a culling of the boxes of a hierarchy
 * @info: the boxes of a node rejected as a whole are counted under the test that rejected it
 * */
@data
pub record CullStats {

    // The boxes in the hierarchy
    pub let mut considered: usize = 0us;

    // The nodes of the hierarchy visited, the cost of the culling
    pub let mut visited: usize = 0us;

    // The boxes outside the frustum
    pub let mut outside: usize = 0us;

    // The boxes in the frustum smaller on screen than the threshold
    pub let mut small: usize = 0us;

    // The boxes seen
    pub let mut visible: usize = 0us;

}
