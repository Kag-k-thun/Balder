in utils;

use std::algorithm::comparison;

/**
 * Narrow the part of a ray inside the slabs crossed so far to the part also inside the slab between two planes
 * perpendicular to an axis
 * @params:
 *    - min: the coordinate of the lower plane along the axis
 *    - max: the coordinate of the upper plane along the axis
 *    - origin: the coordinate of the origin of the ray along the axis
 *    - direction: the coordinate of the direction of the ray along the axis
 *    - near: the distance along the ray at which it enters the slabs, raised to the one at which it enters this slab
 *    - far: the distance along the ray at which it leaves the slabs, lowered to the one at which it leaves this slab
 * @returns: false iif no part of the ray is inside every slab
 * */
pub fn clipSlab(min: f32, max: f32, origin: f32, direction: f32, ref mut near: f32, ref mut far: f32)-> bool {
    // a ray parallel to the slab is inside it everywhere or nowhere
    if direction == 0.0f {
        return origin >= min && origin <= max;
    }

    let enter = (min - origin) / direction;
    let leave = (max - origin) / direction;
    near = comparison::max(near, comparison::min(enter, leave));
    far = comparison::min(far, comparison::max(enter, leave));

    near <= far
}
