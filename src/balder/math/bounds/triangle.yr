in triangle;

use balder::math::vector;

use std::math;
use std::algorithm::comparison;

/**
 * The sine of the angle between a ray and the plane of a triangle under which the ray is in that plane
 * */
def PARALLEL = 1.0e-6f;

/**
 * A triangle of three points
 * */
pub record Triangle {

    pub let mut a: vec3 = vec3();

    pub let mut b: vec3 = vec3();

    pub let mut c: vec3 = vec3();

    pub self (a: vec3, b: vec3, c: vec3)
        with a = a
        , b = b
        , c = c
    {}

    /**
     * @returns: the smallest box aligned with the axes enclosing the triangle
     * */
    @field
    pub fn aabb(self)-> Aabb {
        Aabb(self.a, self.a).merged(Aabb(self.b, self.b)).merged(Aabb(self.c, self.c))
    }

    /**
     * @info: the test of Möller and Trumbore, a ray hitting the triangle by either of its faces, and missing it when it
     * runs in its plane
     * @returns: the distance along a ray at which it hits the triangle, none when it misses it or stops before it
     * */
    pub fn intersect(self, ray: Ray)-> (f32)? {
        let e1 = self.b - self.a;
        let e2 = self.c - self.a;
        let p = ray.direction.cross(e2);
        let det = e1.dot(p);
        if math::abs(det) <= PARALLEL * e1.length() * e2.length() { return none; }

        let inv = 1.0f / det;
        let s = ray.origin - self.a;
        let u = s.dot(p) * inv;
        if u < 0.0f || u > 1.0f { return none; }

        let q = s.cross(e1);
        let v = ray.direction.dot(q) * inv;
        if v < 0.0f || u + v > 1.0f { return none; }

        let distance = e2.dot(q) * inv;
        if distance < 0.0f || distance > ray.length { return none; }

        (distance)?
    }

    /**
     * @info: the test of Akenine-Möller, the triangle and the box being apart when an axis separates them: an axis of
     * the box, the normal of the triangle, or the cross product of an axis of the box and an edge of the triangle
     * @returns: true iif the triangle overlaps a box, touching it included
     * */
    pub fn overlaps(self, box: Aabb)-> bool {
        if !self.aabb.overlaps(box) { return false; }

        let centre = box.center, half = box.extent;
        let a = self.a - centre, b = self.b - centre, c = self.c - centre;
        let normal = (b - a).cross(c - a);
        if math::abs(normal.dot(a)) > self.radiusAlong(half, normal) { return false; }

        let axes = [makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f), makeVec3(0.0f, 0.0f, 1.0f)];
        for edge in [b - a, c - b, a - c] {
            for u in axes {
                let axis = u.cross(edge);
                let pa = axis.dot(a), pb = axis.dot(b), pc = axis.dot(c);
                let r = self.radiusAlong(half, axis);
                if comparison::min(pa, comparison::min(pb, pc)) > r || comparison::max(pa, comparison::max(pb, pc)) < -r {
                    return false;
                }
            }
        }

        true
    }

    /**
     * @returns: the half length of the projection of a box of half sides on an axis
     * */
    fn radiusAlong(self, half: vec3, axis: vec3)-> f32 {
        half.x * math::abs(axis.x) + half.y * math::abs(axis.y) + half.z * math::abs(axis.z)
    }

}
