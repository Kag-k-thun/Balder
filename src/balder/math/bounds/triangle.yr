in triangle;

use balder::math::vector;

use std::math;

/**
 * The sine of the angle between a ray and the plane of a triangle under which the ray is in that plane
 * */
def PARALLEL = 1.0e-6f;

/**
 * A triangle of three points
 * */
pub record Triangle {

    pub let mut a: vec3 = vec3();

    pub let mut b: vec3 = vec3();

    pub let mut c: vec3 = vec3();

    pub self (a: vec3, b: vec3, c: vec3)
        with a = a
        , b = b
        , c = c
    {}

    /**
     * @returns: the smallest box aligned with the axes enclosing the triangle
     * */
    @field
    pub fn aabb(self)-> Aabb {
        Aabb(self.a, self.a).merged(Aabb(self.b, self.b)).merged(Aabb(self.c, self.c))
    }

    /**
     * @info: the test of Möller and Trumbore, a ray hitting the triangle by either of its faces, and missing it when it
     * runs in its plane
     * @returns: the distance along a ray at which it hits the triangle, none when it misses it or stops before it
     * */
    pub fn intersect(self, ray: Ray)-> (f32)? {
        let e1 = self.b - self.a;
        let e2 = self.c - self.a;
        let p = ray.direction.cross(e2);
        let det = e1.dot(p);
        if math::abs(det) <= PARALLEL * e1.length() * e2.length() { return none; }

        let inv = 1.0f / det;
        let s = ray.origin - self.a;
        let u = s.dot(p) * inv;
        if u < 0.0f || u > 1.0f { return none; }

        let q = s.cross(e1);
        let v = ray.direction.dot(q) * inv;
        if v < 0.0f || u + v > 1.0f { return none; }

        let distance = e2.dot(q) * inv;
        if distance < 0.0f || distance > ray.length { return none; }

        (distance)?
    }

}
