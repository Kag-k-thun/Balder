in ray;

use balder::math::{matrix, vector};

/**
 * A segment from an origin along a unit direction, f32::max long for a half line
 * */
pub record Ray {

    // The point the ray starts from
    pub let mut origin: vec3 = vec3();

    // The unit direction of the ray
    pub let mut direction: vec3 = makeVec3(0.0f, 0.0f, -1.0f);

    // The distance from the origin at which the ray stops, f32::max when it does not
    pub let mut length: f32 = f32::max;

    /**
     * @params:
     *    - origin: the point the ray starts from
     *    - direction: the direction of the ray, normalized
     *    - length: the distance from the origin at which the ray stops, f32::max for a half line
     * */
    pub self (origin: vec3, direction: vec3, length: f32 = f32::max)
        with origin = origin
        , direction = direction.normalized()
        , length = length
    {}

    /**
     * The ray seen through a point of the image of a view, from its near plane to its far plane
     * @info: the clip volume is the one of the projections of balder::math::utils, -w <= x, y, z <= w, the near plane at
     * z = -w and the far plane at z = w
     * @params:
     *    - viewProj: the projection multiplied by the view, from world space to clip space
     *    - ndc: the point, in normalized device coordinates, (-1, -1) at the top left corner of the image and (1, 1) at
     *           its bottom right corner
     * */
    pub self (viewProj: mat4, ndc: vec2) {
        let inverse = viewProj.inversed();
        let near = inverse * makeVec4(ndc, -1.0f, 1.0f);
        let far = inverse * makeVec4(ndc, 1.0f, 1.0f);

        let start = near.xyz / near.w;
        let span = far.xyz / far.w - start;

        self.origin = start;
        self.direction = span.normalized();
        self.length = span.length();
    }

    /**
     * @returns: the point of the ray at a distance from its origin
     * */
    pub fn at(self, distance: f32)-> vec3 {
        self.origin + self.direction * distance
    }

}
