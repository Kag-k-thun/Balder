in plane;

use balder::math::vector;

/**
 * A plane splitting the space in two, the points p with normal.dot (p) + distance >= 0 being in front of it
 * @info: the default plane has no normal and an infinite distance, every point is in front of it
 * */
pub record Plane {

    // The unit normal of the plane, pointing to the front
    pub let mut normal: vec3 = vec3();

    // The signed distance from the plane to the origin, along the normal
    pub let mut distance: f32 = f32::max;

    pub self () {}

    /**
     * The plane of the equation a * x + b * y + c * z + d = 0, normalized
     * @params:
     *    - coefficients: (a, b, c, d)
     * */
    pub self (coefficients: vec4)
        with normal = coefficients.xyz / coefficients.xyz.length()
        , distance = coefficients.w / coefficients.xyz.length()
    {}

    /**
     * @returns: the distance from the plane to a point, positive in front of the plane, negative behind it
     * */
    pub fn signedDistance(self, point: vec3)-> f32 {
        self.normal.dot(point) + self.distance
    }

}
