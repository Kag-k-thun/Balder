in path;

use std::fs;

lazy dmut __PROJECT_PATH__ = copy [std::env::currentDir()];

lazy dmut __ENGINE_PATH__ = copy [std::env::currentDir()];

/**
 * Change the working directory of the project
 * */
pub fn setProjectPath(p: Path) {
    __PROJECT_PATH__[0] = p;
}

/**
 * Get the working directory of the project
 * */
pub fn getProjectPath()-> Path {
    __PROJECT_PATH__[0]
}

/**
 * Change the directory of the engine, holding the res/ directory of its own files (its shaders, the files of its
 * dialogs, its fonts...), the current directory by default
 * */
pub fn setEnginePath(p: Path) {
    __ENGINE_PATH__[0] = p;
}

/**
 * Get the directory of the engine, holding the res/ directory of its own files
 * */
pub fn getEnginePath()-> Path {
    __ENGINE_PATH__[0]
}

/**
 * The qualifiers of the paths: res:/ (and images:/, models:/, scenes:/ under it) the files of the project, engine:/ (and
 * shaders:/ under it) the files of the engine, the project and the engine being the same directory unless one of them
 * is moved (a game edited by the editor of Balder)
 * */
pub enum CustomPathQualifiers
| RESSOURCES = Path("res:/")
| ENGINE     = Path("engine:/")
| SHADERS    = Path("shaders:/")
| IMAGES     = Path("images:/")
| MODELS     = Path("models:/")
| SCENES     = Path("scenes:/");

/**
 * Create an absolute path from a path that uses the custom paths qualifier
 * */
pub fn projectPath(p: [c8])-> Path {
    projectPath(Path(p))
}

/**
 * Create an absolute path from a path that uses the custom paths qualifier
 * @example:
 * ```
 * use balder::utils::path;
 *
 * let mut p = projectPath ("res:/objects.toml");
 * println (p.toStr ()); // absolute/path/to/project_dir/res/objects.toml
 * ```
 * */
pub fn projectPath(p: Path)-> Path {
    if CustomPathQualifiers::RESSOURCES.isPrefix(p) {
        return ressourcePath().push(p.removePrefix(CustomPathQualifiers::RESSOURCES));
    }

    if CustomPathQualifiers::ENGINE.isPrefix(p) {
        return engineRessourcePath().push(p.removePrefix(CustomPathQualifiers::ENGINE));
    }

    if CustomPathQualifiers::SHADERS.isPrefix(p) {
        return shaderPath().push(p.removePrefix(CustomPathQualifiers::SHADERS));
    }

    if CustomPathQualifiers::IMAGES.isPrefix(p) {
        return imagePath().push(p.removePrefix(CustomPathQualifiers::IMAGES));
    }

    if CustomPathQualifiers::MODELS.isPrefix(p) {
        return modelPath().push(p.removePrefix(CustomPathQualifiers::MODELS));
    }

    if CustomPathQualifiers::SCENES.isPrefix(p) {
        return scenePath().push(p.removePrefix(CustomPathQualifiers::SCENES));
    }

    p
}

/**
 * @returns: the path to the ressource of the current project
 * */
pub fn ressourcePath()-> Path {
    __PROJECT_PATH__[0].push("res")
}

/**
 * @returns: the path to the files of the engine
 * */
pub fn engineRessourcePath()-> Path {
    __ENGINE_PATH__[0].push("res")
}

/**
 * @returns: the path to the shader files of the engine
 * */
pub fn shaderPath()-> Path {
    __ENGINE_PATH__[0].push("res/shaders")
}

/**
 * @returns: the path to the image files of the current project
 * */
pub fn imagePath()-> Path {
    __PROJECT_PATH__[0].push("res/images")
}

/**
 * @returns: the path to the model files of the current project
 * */
pub fn modelPath()-> Path {
    __PROJECT_PATH__[0].push("res/models")
}

/**
 * @returns: the path to the scene files of the current project
 * */
pub fn scenePath()-> Path {
    __PROJECT_PATH__[0].push("res/scenes")
}

/**
 * @returns: a path under the res/ directory of the project qualified by res:/, the other paths as they are
 * @example:
 * ```
 * use balder::utils::path;
 *
 * setProjectPath (Path ("/home/me/game"));
 * assert (qualifiedPath ("/home/me/game/res/models/crate.glb") == "res:/models/crate.glb");
 * assert (qualifiedPath ("/home/me/models/crate.glb") == "/home/me/models/crate.glb");
 * ```
 * */
pub fn qualifiedPath(p: [c8])-> [c8] {
    let path = Path(p);
    let res = ressourcePath();
    if path.isAbsolute() && res.isPrefix(path) && !path.isPrefix(res) {
        return "res:/" ~ path.removePrefix(res).toStr();
    }

    p
}
