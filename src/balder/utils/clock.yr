in clock;

use std::time::dur;

/**
 * Read a clock into a timespec (seconds, nanoseconds)
 * */
extern (C) fn clock_gettime(clock: i32, ts: *void)-> i32;

// The clock of the CPU time of the calling thread (CLOCK_THREAD_CPUTIME_ID)
def THREAD_CPUTIME_CLOCK = 3;

/**
 * @returns: the CPU time the calling thread used since it started, the time it waited (a lock, a semaphore, the
 * scheduler) not being counted
 * */
pub fn threadCpuTime()-> Duration {
    let mut ts: [i64; 2] = [0i64; 2];
    clock_gettime(THREAD_CPUTIME_CLOCK, cast!{*void} (ts.ptr));

    dur::micros(cast!u64(ts[0] * 1000000i64 + ts[1] / 1000i64))
}
