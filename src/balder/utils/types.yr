in types;

use ::core::types::info;

/**
 * @returns: a list of types between parentheses, for the errors: `([c8], u8)`
 * */
pub fn signature(types: [TypeInfo])-> [c8] {
    let mut result = "(";
    for i, t in types {
        result = (if i == 0us { result } else { result ~ ", " }) ~ t.name;
    }

    result ~ ")"
}

/**
 * @returns: true iif two types are the same, a record being the same as a record of its name
 * @info: the runtime tells two records apart by the addresses of their names, which differ between the packages
 * emitting their types: the record a signal of Balder gives (TreeDrop) and the one a slot of an application takes
 * */
pub fn sameType(a: TypeInfo, b: TypeInfo)-> bool {
    if a == b { return true; }
    if a.typeid != b.typeid || a.size != b.size || a.name != b.name || a.inner.len != b.inner.len { return false; }
    for i, t in a.inner {
        if !sameType(t, b.inner[i]) { return false; }
    }

    true
}

/**
 * @returns: true iif two lists of types are the same, type by type (see sameType)
 * */
pub fn sameTypes(a: [TypeInfo], b: [TypeInfo])-> bool {
    if a.len != b.len { return false; }
    for i, t in a {
        if !sameType(t, b[i]) { return false; }
    }

    true
}

/**
 * @returns: the types of the fields of a tuple type
 * */
pub fn typesOf {TT} ()-> [TypeInfo] {
    let mut result: [TypeInfo] = [];
    cte for i in 0 .. TT::arity {
        result ~= [(__pragma!field_type(TT, i))::typeinfo];
    }

    result
}
