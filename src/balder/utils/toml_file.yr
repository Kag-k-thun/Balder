in toml_file;

use balder::core::error;

use std::{config, fs, stream};

/**
 * @returns: the configuration of a toml file
 * @throws:
 *    - &BalderError: if the file cannot be read, or is not a toml
 * */
pub fn readToml(file: [c8])-> &Config
    throws BalderError
{
    {
        let dmut f = File::open(Path(file));
        let text = f:.readAll();
        f:.close();
        toml::parse(text)
    } catch {
        err => {
            throw copy BalderError(f"${file}: ${err}");
        }
    }
}

/**
 * Write a text file, replacing the one there
 * @throws:
 *    - &BalderError: if the file cannot be written
 * */
pub fn writeFile(file: [c8], text: [c8])
    throws BalderError
{
    {
        let dmut f = File::create(Path(file), write-> true);
        f:.write(text);
        f:.close();
    } catch {
        _: &FsError => {
            throw copy BalderError(f"Not written: ${file}");
        }
    }
}

/**
 * @returns: the string of an entry of a toml table, empty when it is optional and missing
 * @throws:
 *    - &BalderError: if the entry is missing (and not optional), or is not a string
 * */
pub fn stringOf(cfg: &Config, key: [c8], file: [c8], optional: bool = false)-> [c8]
    throws BalderError
{
    if let Ok(value) = cfg[key]? {
        match value {
            Str(value-> s) => { return s; }
            _ => {
                throw copy BalderError(f"${file}: '${key}' must be a string");
            }
        }
    }

    if !optional {
        throw copy BalderError(f"${file}: '${key}' is missing");
    }

    ""
}

/**
 * @returns: the strings of a toml table by their keys
 * @throws:
 *    - &BalderError: if the configuration is not a table, or holds an entry that is not a string
 * */
pub fn stringsOf(cfg: &Config, key: [c8], file: [c8])-> [([c8], [c8])]
    throws BalderError
{
    let mut res: [([c8], [c8])] = [];
    match cfg {
        d: &Dict => {
            for name, value in d[] {
                match value {
                    Str(value-> s) => { res ~= [(name, s)]; }
                    _ => {
                        throw copy BalderError(f"${file}: '${key}.${name}' must be a string");
                    }
                }
            }
        }
        _ => {
            throw copy BalderError(f"${file}: [${key}] must be a table of strings");
        }
    }

    res
}

/**
 * @returns: a text as a basic string of toml, between quotes, its quotes, backslashes and control characters escaped
 * */
pub fn quoted(text: [c8])-> [c8] {
    let dmut s = copy StringStream();
    s:.write('"');
    for c in text {
        match c {
            '"'  => { s:.write("\\\""); }
            '\\' => { s:.write("\\\\"); }
            '\n' => { s:.write("\\n"); }
            '\t' => { s:.write("\\t"); }
            _    => { s:.write(c); }
        }
    }

    s:.write('"');
    s[]
}

/**
 * @returns: a key of a toml table, bare when it is made of letters, digits, '-' and '_', quoted otherwise
 * */
pub fn key(name: [c8])-> [c8] {
    if name.len == 0us { return quoted(name); }
    for c in name {
        let bare = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_';
        if !bare { return quoted(name); }
    }

    name
}
