in implem;

/**
 * A map whose values are kept in a slice, to iterate them without allocating: the iterator of a map is allocated by
 * the runtime at each iteration of a non empty map, which a collection iterated every frame cannot afford.
 * The values are not in insertion order, removing one moving the last in its place.
 * @info: a removed value stays referenced by the buffer until a later insertion takes its place
 * */
@final
pub class IDenseMap {K, V, MUTABLE: bool} {

    cte if MUTABLE {
        // The values, the first _len of the buffer, kept as it grows
        let dmut _values: [V] = [];
    } else {
        let mut _values: [mut V] = [];
    }

    // The key of each value, at the same index
    let mut _keys: [mut K] = [];
    let mut _len: usize = 0us;

    // The index of the value of each key
    let dmut _index: [K => usize] = copy [];

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the number of values
     * */
    @field
    pub fn len(self)-> usize {
        self._len
    }


    /**
     * @returns: the keys, in the order of their values in values
     * @warning: a view of the buffer, valid until the next insertion or removal
     * */
    @field
    pub fn keys(self)-> [K] {
        self._keys[0us .. self._len]
    }

    /**
     * @returns: the values, in the order of their keys in keys
     * @warning: a view of the buffer, valid until the next insertion or removal
     * */
    @field
    pub fn values(self)-> [V] {
        self._values[0us .. self._len]
    }

    /**
     * @returns: true iif the map has a value for the key
     * */
    pub fn opContains(self, key: K)-> bool {
        key in self._index
    }

    /**
     * @returns: the value of the key, if any
     * */
    pub fn opIndex(self, key: K)-> (V)? {
        if let Ok(i) = self._index[key] {
            return (self._values[i])?;
        }

        none
    }

    cte if MUTABLE {
        /**
         * @returns: the value of the key, if any
         * */
        pub fn opIndex(mut self, key: K)-> dmut (V)? {
            if let Ok(i) = self._index[key] {
                return (alias self._values[i])?;
            }

            none
        }

        /**
         * @returns: the values, in the order of their keys in keys
         * @warning: a view of the buffer, valid until the next insertion or removal
         * */
        @field
        pub fn values(mut self)-> dmut [V] {
            alias self._values[0us .. self._len]
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    cte if MUTABLE {
        /**
         * Set the value of a key, replacing the one it had
         * */
        pub fn opIndexAssign(mut self, key: K, dmut value: V) {
            if let Ok(i) = self._index[key] {
                self._values[i] = alias value;
                return;
            }

            if self._len == self._values.len {
                self._values ~= [alias value];
                self._keys ~= [key];
            } else {
                self._values[self._len] = alias value;
                self._keys[self._len] = key;
            }

            self._index[key] = self._len;
            self._len += 1us;
        }

        /**
         * Remove the value of a key, the last value taking its place
         * @returns: true iif the key had a value
         * */
        pub fn remove(mut self, key: K)-> bool {
            if let Ok(i) = self._index[key] {
                let last = self._len - 1us;
                if i != last {
                    self._values[i] = alias self._values[last];
                    self._keys[i] = self._keys[last];
                    self._index[self._keys[i]] = i;
                }

                self._index:.remove(key);
                self._len = last;
                return true;
            }

            false
        }
    } else {
        /**
         * Set the value of a key, replacing the one it had
         * */
        pub fn opIndexAssign(mut self, key: K, value: V) {
            if let Ok(i) = self._index[key] {
                self._values[i] = value;
                return;
            }

            if self._len == self._values.len {
                self._values ~= [value];
                self._keys ~= [key];
            } else {
                self._values[self._len] = value;
                self._keys[self._len] = key;
            }

            self._index[key] = self._len;
            self._len += 1us;
        }

        /**
         * Remove the value of a key, the last value taking its place
         * @returns: true iif the key had a value
         * */
        pub fn remove(mut self, key: K)-> bool {
            if let Ok(i) = self._index[key] {
                let last = self._len - 1us;
                if i != last {
                    self._values[i] = self._values[last];
                    self._keys[i] = self._keys[last];
                    self._index[self._keys[i]] = i;
                }

                self._index:.remove(key);
                self._len = last;
                return true;
            }

            false
        }
    }

    /**
     * Remove every value
     * */
    pub fn clear(mut self) {
        self._values = [];
        self._keys = [];
        self._len = 0us;
        self._index = copy [];
    }
}
