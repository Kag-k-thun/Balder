/**
 * The runtime of the games made with Balder: the library of a game loaded, its scenes played in a window, the main one
 * first; an exported game is this program renamed, next to the files of its game
 * */
in main;

mod ::activity;

use main::activity;
use balder::core::{_, application::_};
use balder::game::{game_library, project};
use balder::utils::{log, path};

use std::{config, config::args, fs, io};

/**
 * The directory of the files of the engine next to the runtime of an exported game, holding res/
 * */
def ENGINE_DIR = "engine";

/**
 * What the command line asks the runtime to play
 * */
@data
record Request {

    // The absolute path of the directory of the project
    let mut directory: [c8] = "";

    // The absolute path of the directory of the engine, holding res/
    let mut engine: [c8] = "";

    // The absolute path of the library of the game, empty for the one of the project (see GameLibrary::ofProject)
    let mut library: [c8] = "";

    // The name of the scene the game starts with, empty for the main scene of the project
    let mut scene: [c8] = "";
}

/**
 * Run a game: the one of the directory of the executable by default, an exported game (project.toml, lib/, res/,
 * engine/), or the project of --project, its library built in it and the engine in the current directory or at
 * --engine-dir
 * */
fn main(args: [[c8]]) {
    let request = if let Ok(r) = readArguments(args) { r } else { return; };

    {
        setEnginePath(Path(request.engine));
        let project = copy Project::open(request.directory);
        let library = if request.library.len != 0us { request.library } else { GameLibrary::ofProject(request.directory) };
        let scene = if request.scene.len != 0us { request.scene } else { project.mainScene };
        if !project.scenePath(scene).hasValue {
            eprintln(f"balder-runtime: ${unknownScene(project, scene)}");
            return;
        }

        // the paths res:/ and the input actions of the game, then its actor classes, before its first scene is built
        project.install();
        GameLibrary::load(library);

        let dmut app = copy Application();
        let dmut game = alias app:.open!{&GameActivity} (project.config());
        game:.play(project, scene);
        app:.run();

        GameLibrary::unload();
    } catch {
        err => {
            log::error #("Game", "The game could not start", err);
        }
    }
}

/**
 * Read the command line, '--project' naming the project to play, '--engine-dir' the directory of the engine, '--library'
 * the library of the game and '--scene' the scene it starts with
 * @returns: what to play, none when the game must not start
 * */
fn readArguments(args: [[c8]])-> (Request)? {
    let parser = (copy ArgumentParser)
        :.help("help", short-> "h", comments-> "print this help and exit")
        :.option!{[c8]} ("project", comments-> "the directory of a project to play (the directory of the executable by default, an exported game)")
        :.option!{[c8]} ("engine-dir", comments-> "the directory of the engine, holding res/ (engine/ next to the executable by default, the current directory with --project)")
        :.option!{[c8]} ("library", comments-> "the library of the game (the one project.toml names by default, else the shared target of the gyllir.toml of the project)")
        :.option!{[c8]} ("scene", comments-> "the name of the scene the game starts with, in the [scenes] of project.toml (its main scene by default)");

    {
        let cfg = parser.parse(args);
        let mut request = Request();
        if let Ok(Str(value-> dir)) = cfg["project"]? {
            request.directory = Path(dir).absolute().toStr();
            request.engine = getEnginePath().toStr();
        } else {
            let exe = readLink(Path("/proc/self/exe"));
            request.directory = exe.parent().toStr();
            request.engine = Path(request.directory).push(ENGINE_DIR).toStr();
        }

        if let Ok(Str(value-> dir)) = cfg["engine-dir"]? {
            request.engine = Path(dir).absolute().toStr();
        }

        if let Ok(Str(value-> library)) = cfg["library"]? {
            request.library = Path(library).absolute().toStr();
        }

        if let Ok(Str(value-> scene)) = cfg["scene"]? {
            request.scene = scene;
        }

        if !Project::isProject(request.directory) {
            eprintln(f"balder-runtime: no game in ${request.directory}, its ${Project::FILE} is missing");
            return none;
        }

        request?
    } catch {
        err: &std::config::args::CommandLineError => {
            eprintln(parser.explain(err, usage-> "balder-runtime"));
            none
        }
        err: &FsError => {
            eprintln(f"balder-runtime: ${err}");
            none
        }
    }
}
