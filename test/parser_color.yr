in parser_color;

use balder::interface::loader::parser;
use balder::math::vector;

use std::syntax::errors;

/**
 * @returns: the values of a content
 * */
fn read(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @returns: true iif two colours are equal, up to the rounding of their channels
 * */
fn near(a: vec4, b: vec4)-> bool {
    let d = a - b;
    for c in [d.x, d.y, d.z, d.w] {
        if c > 0.001f || c < -0.001f { return false; }
    }

    true
}

/**
 * @returns: true iif the decoding of a content as a colour throws a syntax error
 * */
fn rejects(content: [c8])-> bool {
    {
        Color(read(content));
        false
    } catch {
        _: &SyntaxError => { true }
    }
}

/**
 * (content, red, green, blue, alpha, out of 255)
 * */
@parameters ((yield c for c in [("#388bfd", (0x38u32, 0x8bu32, 0xfdu32, 255u32)),
                                ("#fff", (255u32, 255u32, 255u32, 255u32)),
                                ("#fff8", (255u32, 255u32, 255u32, 0x88u32)),
                                ("#388bfd80", (0x38u32, 0x8bu32, 0xfdu32, 0x80u32)),
                                ("#388BFD / 40%", (0x38u32, 0x8bu32, 0xfdu32, 102u32)),
                                ("transparent", (0u32, 0u32, 0u32, 0u32))]))
__test hexadecimal_colours (content: [c8], expected: (u32, u32, u32, u32)) {
    let rgba = Color(read(content)).rgba;
    let e = makeVec4(cast!f32(expected._0), cast!f32(expected._1), cast!f32(expected._2), cast!f32(expected._3)) / 255.0f;
    assert (near(rgba, e));
}

/**
 * (content, red, green, blue, alpha, out of 255)
 * */
@parameters ((yield c for c in [("black", (0u32, 0u32, 0u32, 255u32)),
                                ("white", (255u32, 255u32, 255u32, 255u32)),
                                ("steelblue", (70u32, 130u32, 180u32, 255u32)),
                                ("grey", (128u32, 128u32, 128u32, 255u32)),
                                ("gray", (128u32, 128u32, 128u32, 255u32)),
                                ("rebeccapurple", (0x66u32, 0x33u32, 0x99u32, 255u32)),
                                ("black / 0.6", (0u32, 0u32, 0u32, 153u32))]))
__test named_colours (content: [c8], expected: (u32, u32, u32, u32)) {
    let rgba = Color(read(content)).rgba;
    let e = makeVec4(cast!f32(expected._0), cast!f32(expected._1), cast!f32(expected._2), cast!f32(expected._3)) / 255.0f;
    assert (near(rgba, e));
}

/**
 * (content, red, green, blue, alpha, out of 255)
 * */
@parameters ((yield c for c in [("rgb(56 139 253)", (56u32, 139u32, 253u32, 255u32)),
                                ("rgb(56 139 253 / 40%)", (56u32, 139u32, 253u32, 102u32)),
                                ("rgba(56, 139, 253, 0.4)", (56u32, 139u32, 253u32, 102u32)),
                                ("rgb(100% 0% 20%)", (255u32, 0u32, 51u32, 255u32)),
                                ("rgb(56 139 253) / 0.2", (56u32, 139u32, 253u32, 51u32)),
                                ("hsl(0 100% 50%)", (255u32, 0u32, 0u32, 255u32)),
                                ("hsl(120, 100%, 50%)", (0u32, 255u32, 0u32, 255u32)),
                                ("hsla(240 100% 50% / 0.4)", (0u32, 0u32, 255u32, 102u32)),
                                ("hsl(-120 100% 50%)", (0u32, 0u32, 255u32, 255u32)),
                                ("hsl(0 0% 100%)", (255u32, 255u32, 255u32, 255u32))]))
__test colour_functions (content: [c8], expected: (u32, u32, u32, u32)) {
    let rgba = Color(read(content)).rgba;
    let e = makeVec4(cast!f32(expected._0), cast!f32(expected._1), cast!f32(expected._2), cast!f32(expected._3)) / 255.0f;
    assert (near(rgba, e));
}

@parameters ((yield c for c in ["#38", "#388bfg", "#388bfd8", "#38b8b", "nocolor", "auto", "rgb(1 2)", "rgb(1, 2, 3, 4, 5)",
                                "rgb(256 0 0)", "rgb(0 0 0 / 2)", "rgb(red 0 0)", "hsl(0 120% 50%)", "hsl(red 50% 50%)",
                                "cmyk(0 0 0 0)", "#fff / 2", "#fff / 120%", "#fff / 1px", "12", "\"#fff\""]))
__test invalid_colours (content: [c8]) {
    assert (rejects(content));
}

__test errors_name_the_offending_value {
    let msg = {
        Color(read("12px"));
        ""
    } catch {
        e: &SyntaxError => { e.msg }
    };

    assert (msg == "expected a colour, found '12px'");
}
