in parser_color;

use balder::interface::loader::parser;
use balder::math::vector;
use balder::utils::palette;

use std::syntax::errors;

/**
 * @returns: the values of a content
 * */
fn read(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @returns: true iif two colours are equal, up to the rounding of their channels
 * */
fn near(a: vec4, b: vec4)-> bool {
    let d = a - b;
    for c in [d.x, d.y, d.z, d.w] {
        if c > 0.001f || c < -0.001f { return false; }
    }

    true
}

/**
 * @returns: true iif the decoding of a content as a colour throws a syntax error
 * */
fn rejects(content: [c8])-> bool {
    {
        Color(read(content));
        false
    } catch {
        _: &SyntaxError => { true }
    }
}

/**
 * (content, red, green, blue, alpha, out of 255)
 * */
@parameters ((yield c for c in [("#388bfd", (0x38u32, 0x8bu32, 0xfdu32, 255u32)),
                                ("#fff", (255u32, 255u32, 255u32, 255u32)),
                                ("#388bfd80", (0x38u32, 0x8bu32, 0xfdu32, 0x80u32)),
                                ("#388BFD / 40%", (0x38u32, 0x8bu32, 0xfdu32, 102u32)),
                                ("transparent", (0u32, 0u32, 0u32, 0u32))]))
__test hexadecimal_colours (content: [c8], expected: (u32, u32, u32, u32)) {
    let rgba = Color(read(content)).rgba;
    let e = makeVec4(cast!f32(expected._0), cast!f32(expected._1), cast!f32(expected._2), cast!f32(expected._3)) / 255.0f;
    assert (near(rgba, e));
}

__test palette_colours {
    assert (near(Color(read("grey!10")).rgba, ColorPalette.get("grey", 0.1f)));
    assert (near(Color(read("black")).rgba, ColorPalette.get("black", 0.0f)));

    let faded = Color(read("red!40 / 0.6")).rgba;
    let red = ColorPalette.get("red", 0.4f);
    assert (near(faded, makeVec4(red.x, red.y, red.z, 0.6f)));
}

@parameters ((yield c for c in ["#38", "#388bfg", "#388bfd8", "pink!10", "grey!101", "grey!1.5", "grey!10px",
                                "#fff / 2", "#fff / 120%", "#fff / 1px", "12", "\"#fff\"", "auto"]))
__test invalid_colours (content: [c8]) {
    assert (rejects(content));
}

__test errors_name_the_offending_value {
    let msg = {
        Color(read("12px"));
        ""
    } catch {
        e: &SyntaxError => { e.msg }
    };

    assert (msg == "expected a colour, found '12px'");
}
