in list_rows;

use balder::interface::widget::list::rows;

__test the_rows_shown_include_those_cut {
    // rows of 20 pixels in a view of 100: five rows from the top, six when scrolled to the middle of one
    assert (visibleRows(1000us, 20.0f, 0.0, 100.0f) == (0us, 5us));
    assert (visibleRows(1000us, 20.0f, 30.0, 100.0f) == (1us, 6us));
    assert (visibleRows(1000us, 20.0f, 40.0, 100.0f) == (2us, 5us));
}

__test the_rows_shown_stop_at_the_last_one {
    assert (visibleRows(3us, 20.0f, 0.0, 100.0f) == (0us, 3us));
    assert (visibleRows(1000us, 20.0f, 19900.0, 100.0f) == (995us, 5us));
    assert (visibleRows(0us, 20.0f, 0.0, 100.0f) == (0us, 0us));
    assert (visibleRows(10us, 0.0f, 0.0, 100.0f) == (0us, 0us));
}

__test a_million_rows_are_placed_to_the_pixel {
    let offset = 999990.0 * 24.0 + 1.0;
    assert (visibleRows(1000000us, 24.0f, offset, 48.0f) == (999990us, 3us));
}

__test a_page_is_the_rows_shown_whole {
    assert (fullRows(20.0f, 100.0f) == 5us);
    assert (fullRows(20.0f, 110.0f) == 5us);
    assert (fullRows(20.0f, 10.0f) == 1us);
    assert (fullRows(0.0f, 100.0f) == 1us);
}

__test the_least_scroll_shows_a_row {
    // a row shown stays where it is, a row above is shown at the top, a row below at the bottom
    assert (offsetShowing(3us, 20.0f, 40.0, 100.0f) == 40.0);
    assert (offsetShowing(1us, 20.0f, 40.0, 100.0f) == 20.0);
    assert (offsetShowing(9us, 20.0f, 40.0, 100.0f) == 100.0);

    // a row higher than the view is shown from its top
    assert (offsetShowing(2us, 200.0f, 0.0, 100.0f) == 400.0);
}

__test the_offset_is_kept_within_the_rows {
    assert (clampOffset(100us, 20.0f, 3000.0, 100.0f) == 1900.0);
    assert (clampOffset(100us, 20.0f, -5.0, 100.0f) == 0.0);
    assert (clampOffset(3us, 20.0f, 30.0, 100.0f) == 0.0);
}
