in grid_cells;

use balder::interface::widget::layout::grid;

/**
 * @returns: the cell of a child placed in the next free cell
 * */
fn free()-> ((u32, u32))? {
    none
}

/**
 * @returns: the cell of a child put in a cell
 * */
fn at(col: u32, row: u32)-> ((u32, u32))? {
    ((col, row))?
}

__test children_without_a_cell_fill_the_rows {
    let (cells, cols, rows) = GridLayout::place(copy [free(), free(), free(), free(), free()], 2u32, 0u32);
    assert (cells == [(0u32, 0u32), (1u32, 0u32), (0u32, 1u32), (1u32, 1u32), (0u32, 2u32)]);
    assert (cols == 2u32 && rows == 3u32);
}

__test a_grid_without_columns_has_one {
    let (cells, cols, rows) = GridLayout::place(copy [free(), free()], 0u32, 0u32);
    assert (cells == [(0u32, 0u32), (0u32, 1u32)]);
    assert (cols == 1u32 && rows == 2u32);
}

__test children_with_a_cell_grow_the_grid {
    let (cells, cols, rows) = GridLayout::place(copy [at(2u32, 0u32), at(0u32, 3u32)], 0u32, 0u32);
    assert (cells == [(2u32, 0u32), (0u32, 3u32)]);
    assert (cols == 3u32 && rows == 4u32);
}

__test the_free_cells_skip_those_taken {
    // a child put in (1, 0) after two children placed: they take (0, 0) and (2, 0)
    let (cells, cols, rows) = GridLayout::place(copy [free(), at(1u32, 0u32), free(), free()], 3u32, 0u32);
    assert (cells == [(0u32, 0u32), (1u32, 0u32), (2u32, 0u32), (0u32, 1u32)]);
    assert (cols == 3u32 && rows == 2u32);
}

__test the_gallery_grid {
    // the six cells of the gallery, each put in its cell, then the same grid placed row by row
    let explicit = copy [at(0u32, 0u32), at(1u32, 0u32), at(2u32, 0u32),
                         at(0u32, 1u32), at(1u32, 1u32), at(2u32, 1u32)];
    let (cells, cols, rows) = GridLayout::place(explicit, 0u32, 0u32);
    let placed = copy [free(), free(), free(), free(), free(), free()];
    let (auto, autoCols, autoRows) = GridLayout::place(placed, 3u32, 0u32);

    assert (cells == auto);
    assert (cols == 3u32 && rows == 2u32 && autoCols == 3u32 && autoRows == 2u32);
}

__test the_rows_given_are_kept {
    let (cells, cols, rows) = GridLayout::place(copy [free()], 2u32, 4u32);
    assert (cells == [(0u32, 0u32)]);
    assert (cols == 2u32 && rows == 4u32);
}
