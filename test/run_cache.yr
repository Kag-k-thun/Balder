in run_cache;

use balder::interface::font::{face, runs, shaper};

fn run(width: f32)-> ShapedRun {
    ShapedRun([], width, LineMetrics(10.0f, -3.0f, 14.0f), 12u32, copy [0.0f], copy [0us])
}

fn key(text: [c8])-> RunKey {
    RunKey(1u32, text, 12u32, [])
}

__test finds_what_it_holds {
    let dmut c = copy RunCache();
    assert (!c:.find(key("a")).hasValue);

    c:.insert(key("a"), run(4.0f));
    if let Ok(r) = c:.find(key("a")) {
        assert (r.width == 4.0f);
    } else {
        assert (false);
    }
}

__test keys_tell_apart_chains_sizes_and_features {
    let dmut c = copy RunCache();
    c:.insert(key("a"), run(1.0f));
    assert (!c.contains(RunKey(2u32, "a", 12u32, [])));
    assert (!c.contains(RunKey(1u32, "a", 13u32, [])));
    assert (!c.contains(RunKey(1u32, "a", 12u32, copy ["kern=0"])));
    assert (c.contains(RunKey(1u32, "a", 12u32, [])));
}

__test forgets_the_runs_unused_for_a_generation {
    let dmut c = copy RunCache(capacity-> 2us);
    c:.insert(key("a"), run(1.0f));
    c:.insert(key("b"), run(2.0f));

    // the current generation is full, "a" and "b" move to the previous one
    c:.insert(key("c"), run(3.0f));
    assert (c.len() == 3us);

    // "a" is brought back to the current generation, "b" is left in the previous one
    assert (c:.find(key("a")).hasValue);
    assert (c.len() == 3us);

    // a new generation drops "b"
    c:.insert(key("d"), run(4.0f));
    assert (!c.contains(key("b")));
    assert (c.contains(key("a")) && c.contains(key("c")) && c.contains(key("d")));
}

__test clear_forgets_everything {
    let dmut c = copy RunCache();
    c:.insert(key("a"), run(1.0f));
    c:.clear();
    assert (c.len() == 0us);
}
