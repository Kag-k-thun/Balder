in layout_properties;

use balder::interface::style;
use balder::interface::loader::parser;
use balder::interface::loader::registry;
use balder::interface::loader::registry::error;
use balder::interface::widget::alignement;

use std::syntax::errors;

/**
 * @returns: the style of the first rule of a .style content
 * */
fn decoded(content: [c8])-> &Style
    throws SyntaxError, LoadError
{
    let dmut constants = copy Constants();
    let dmut reader = StyleReader(content);
    let sheet = SheetDecoder(WidgetRegistry(), "test.style").decode(reader:.read(alias constants));
    sheet.rules[0].style
}

/**
 * @returns: the reason the decoding of a .style content is refused, "" when it is decoded
 * */
fn refusal(content: [c8])-> [c8]
    throws SyntaxError
{
    {
        decoded(content);
        ""
    } catch {
        e: &LoadError => { e.reason }
        e: &SyntaxError => { throw e; }
    }
}

/**
 * @returns: the tracks a style gives a grid, empty when it gives none
 * @params:
 *    - name: columns or rows
 * */
fn tracksOf(s: &Style, name: [c8])-> [Track] {
    if let Ok(tracks) = s.getCustom!{[Track]}(name) {
        return tracks;
    }

    []
}

__test the_direction_of_the_linear_layouts_and_the_splitters {
    let row = decoded("LinearLayout.row { direction: row; }");
    assert (row.getCustom!{Direction}("direction") == (Direction::ROW)?);

    let column = decoded("Splitter { direction: column; }");
    assert (column.getCustom!{Direction}("direction") == (Direction::COLUMN)?);

    // a selector naming no type reaches the properties of every type
    assert (decoded(".row { direction: row; }").getCustom!{Direction}("direction") == (Direction::ROW)?);

    // a column when it is not set
    assert (!decoded("LinearLayout { radius: 1; }").getCustom!{Direction}("direction").hasValue);
}

__test the_overflow_of_the_linear_layouts {
    let s = decoded("LinearLayout { overflow: scroll; scroll-speed: 3; }");
    assert (s.getCustom!{Overflow}("overflow") == (Overflow::SCROLL)?);
    assert (s.getCustom!{f32}("scroll-speed") == (3.0f)?);
    assert (decoded("LinearLayout { overflow: hidden; }").getCustom!{Overflow}("overflow") == (Overflow::HIDDEN)?);
}

__test the_tracks_of_the_grids {
    let s = decoded("GridLayout { columns: 1fr 2fr 120; rows: auto 40% min-content max-content; }");
    assert (tracksOf(s, "columns") == [Track(TrackKind::SHARE, 1.0f), Track(TrackKind::SHARE, 2.0f), Track(TrackKind::PIXELS, 120.0f)]);
    assert (tracksOf(s, "rows") == [Track(TrackKind::AUTO, 0.0f), Track(TrackKind::PERCENT, 40.0f), Track(TrackKind::MIN_CONTENT, 0.0f),
                                    Track(TrackKind::MAX_CONTENT, 0.0f)]);
    assert (tracksOf(decoded("GridLayout { columns: 1fr; }"), "columns") == [Track(TrackKind::SHARE, 1.0f)]);
}

__test the_alignment_of_the_popup_of_a_menu_button {
    let s = decoded("MenuButton { popup-align: right top; }");
    assert (s.getCustom!{(XAlign, YAlign)}("popup-align") == ((XAlign::RIGHT, YAlign::TOP))?);
}

__test the_position_in_a_floating_layout {
    let s = decoded("Label.fps { left: 12; top: 40%; }");
    assert (s.left == (true, WidgetSize(pix-> 12u32)) && s.top == (true, WidgetSize(relative-> 0.4f)));
    assert (!decoded("Label { radius: 1; }").left._0);
}

/**
 * (declaration, reason)
 * */
@parameters ((yield c for c in [("LinearLayout { direction: up; }", "property 'direction': expected one of row, column, found 'up'"),
                                ("LinearLayout { overflow: auto; }", "property 'overflow': expected one of hidden, scroll, found 'auto'"),
                                ("LinearLayout { scroll-speed: -1; }", "property 'scroll-speed': expected a number of 0 or more, found '-1'"),
                                ("GridLayout { columns: red; }", "property 'columns': expected a track, found 'red'"),
                                ("GridLayout { rows: 1fr -2; }", "property 'rows': expected a track of 0 or more, found '-2'"),
                                ("MenuButton { popup-align: left; }", "property 'popup-align': expected a horizontal and a vertical alignment, found 'left'"),
                                ("MenuButton { popup-align: bottom left; }", "property 'popup-align': expected one of left, center, right, found 'bottom'"),
                                ("Label { left: auto; }", "property 'left': expected a length, found 'auto'")]))
__test wrong_values (content: [c8], reason: [c8]) {
    assert (refusal(content) == reason);
}

__test the_properties_belong_to_their_types {
    assert (refusal("Box { direction: row; }") == "unknown property 'direction'");
    assert (refusal("LinearLayout { columns: 1fr; }") == "unknown property 'columns'");
    assert (refusal("GridLayout { popup-align: left top; }") == "unknown property 'popup-align'");
    assert (refusal("MenuButton { overflow: scroll; }") == "unknown property 'overflow'");
}

__test a_change_of_a_setting_lays_the_interface_out_again {
    let row = decoded("LinearLayout { direction: row; }");
    let column = decoded("LinearLayout { direction: column; }");
    assert (!row.sameLayout(column) && row.sameLook(column));

    let tracks = decoded("GridLayout { columns: 1fr 1fr; }");
    let others = decoded("GridLayout { columns: 1fr 2fr; }");
    assert (!tracks.sameLayout(others));
    assert (tracks.sameLayout(decoded("GridLayout { columns: 1fr 1fr; }")));

    assert (!decoded("LinearLayout { overflow: scroll; }").sameLayout(decoded("LinearLayout { overflow: hidden; }")));
    assert (!decoded("Label { left: 12; }").sameLayout(decoded("Label { left: 14; }")));

    // the alignment of a popup only moves the next popup opened
    let left = decoded("MenuButton { popup-align: left bottom; }");
    let right = decoded("MenuButton { popup-align: right bottom; }");
    assert (left.sameLayout(right) && !left.sameLook(right));
}

__test a_state_cannot_change_a_setting_of_the_layout {
    assert (refusal("LinearLayout:hover { direction: row; }")
            == "property 'direction' affects the layout, which a rule testing a state cannot change");
    assert (refusal("MenuButton:hover { popup-align: right top; }") == "");
}
