in shelf_packer;

use balder::interface::font::packer;

/**
 * A 64x64 page with a shelf of height 16 at y = 0 and one of height 32 at y = 16, each holding a 10px wide rectangle
 * */
fn twoShelves()-> dmut &ShelfPacker {
    let dmut p = copy ShelfPacker(64u32, 64u32);
    p:.alloc(10u32, 14u32);
    p:.alloc(10u32, 30u32);
    alias p
}

__test shelves_stack_from_top {
    let dmut p = copy ShelfPacker(64u32, 64u32);
    assert (p:.alloc(10u32, 14u32) == (0u32, 0u32)?);
    assert (p:.alloc(10u32, 30u32) == (0u32, 16u32)?);
}

/**
 * (width, height, expected x, expected y), -1 when the page has no room
 * */
@parameters ((yield c for c in [(20u32, 15u32, 10i64, 0i64),    // fits the shelf of 16
                                (20u32, 16u32, 10i64, 0i64),
                                (20u32, 12u32, 0i64, 48i64),    // too much waste in 16: opens a shelf of 12
                                (55u32, 16u32, 0i64, 48i64),    // shelf of 16 too full: opens a new one
                                (20u32, 17u32, 10i64, 16i64),   // 16 free rows only: falls back to the shelf of 32
                                (60u32, 40u32, -1i64, -1i64),
                                (65u32, 1u32, -1i64, -1i64)]))
__test placement (width: u32, height: u32, x: i64, y: i64) {
    let dmut p = twoShelves();
    if let Ok((px, py)) = p:.alloc(width, height) {
        assert (cast!i64(px) == x && cast!i64(py) == y);
    } else {
        assert (x == -1i64);
    }
}

__test freed_span_is_reused {
    let dmut p = twoShelves();
    p:.free(0u32, 0u32, 10u32);
    assert (p:.alloc(10u32, 13u32) == (0u32, 0u32)?);
}

__test closed_shelves_give_rows_back {
    let dmut p = copy ShelfPacker(32u32, 32u32);
    assert (p:.alloc(32u32, 16u32) == (0u32, 0u32)?);
    assert (p:.alloc(32u32, 16u32) == (0u32, 16u32)?);
    assert (p:.alloc(1u32, 1u32) == none);

    p:.free(0u32, 0u32, 32u32);
    p:.free(0u32, 16u32, 32u32);
    assert (p.isEmpty());
    assert (p:.alloc(8u32, 32u32) == (0u32, 0u32)?);
}
