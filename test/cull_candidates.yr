in cull_candidates;

use balder::core::shader::buffers::instance_draw;
use balder::core::shader::buffers::instance_batch::utils;

/**
 * @returns: a draw of 'count' indices from 'first', for the object word 'word'
 * */
fn draw(first: u32, count: u32, word: u32)-> InstanceDraw {
    let mut d = InstanceDraw();
    d.indexCount = count;
    d.firstIndex = first;
    d.word = word;
    d
}

__test no_draw_no_candidate {
    let (commands, words) = groupInstances([]);
    assert (cullCandidates(commands, words, 0us).len == 0us);
}

__test a_candidate_holds_its_word_and_its_command {
    // two ranges: the level 1 holds the closest instance, its command comes first
    let (commands, words) = groupInstances(copy [(5.0f, draw(0u32, 36u32, 4u32)),
                                                 (1.0f, draw(36u32, 12u32, 8u32)),
                                                 (2.0f, draw(0u32, 36u32, 12u32))]);

    let candidates = cullCandidates(commands, words, 3us);
    assert (candidates == [8u32, 0u32, 12u32, 1u32, 4u32, 1u32]);
}

__test the_candidates_past_the_draws_draw_nothing {
    // a culled mesh and the second draw of a mesh out of a cross-fade are laid out, and draw nothing
    let (commands, words) = groupInstances(copy [(1.0f, draw(0u32, 36u32, 4u32)),
                                                 (1.0f, InstanceDraw()),
                                                 (2.0f, InstanceDraw())]);

    let candidates = cullCandidates(commands, words, 3us);
    assert (candidates == [4u32, 0u32, 0u32, NO_COMMAND, 0u32, NO_COMMAND]);
}

__test the_candidates_of_a_command_follow_its_first_instance {
    // the range of each template in the words the pass writes is the range of its candidates
    let (commands, words) = groupInstances(copy [(1.0f, draw(0u32, 36u32, 4u32)),
                                                 (2.0f, draw(36u32, 12u32, 8u32)),
                                                 (3.0f, draw(0u32, 36u32, 12u32)),
                                                 (4.0f, draw(36u32, 12u32, 16u32))]);

    let candidates = cullCandidates(commands, words, 4us);
    for k, c in commands {
        for i in c.firstInstance .. c.firstInstance + c.instanceCount {
            assert (candidates[2u32 * i + 1u32] == cast!u32(k));
        }
    }
}
