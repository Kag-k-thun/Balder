in cull_candidates;

use balder::core::shader::buffers::instance_draw;
use balder::core::shader::buffers::instance_batch::{grouping, utils};

/**
 * @returns: a draw of 'count' indices for the object word 'word', of the clusters [first, first + clusters), of at most
 * 'bound' clusters until laid out again
 * */
fn draw(count: u32, word: u32, first: u32, clusters: u32, bound: u32)-> InstanceDraw {
    let mut d = InstanceDraw();
    d.indexCount = count;
    d.word = word;
    d.firstCluster = first;
    d.clusterCount = clusters;
    d.clusterBound = bound;
    d
}

/**
 * @returns: a draw of nothing, of at most 'bound' clusters until laid out again
 * */
fn empty(bound: u32)-> InstanceDraw {
    let mut d = InstanceDraw();
    d.clusterBound = bound;
    d
}

/**
 * @returns: the candidates of a cull pass of draws laid out, by a new grouping
 * */
fn cullCandidates(draws: [InstanceDraw], count: usize)-> [u32] {
    let dmut grouping = copy DrawGrouping();
    grouping:.candidates(draws, count)
}

__test no_draw_no_candidate {
    assert (cullCandidates([], 0us).len == 0us);
}

__test a_candidate_holds_its_word_and_its_clusters {
    // the level 0 of a mesh of 4 clusters from the cluster 10, then its level 1 of 2 clusters from the cluster 14
    let candidates = cullCandidates(copy [draw(36u32, 4u32, 10u32, 4u32, 4u32), draw(12u32, 8u32, 14u32, 2u32, 4u32)], 2us);
    assert (candidates == [4u32, 10u32, 4u32, 0u32, 8u32, 14u32, 2u32, 4u32]);
}

__test the_visibility_of_a_candidate_follows_the_bounds_before_it {
    // the empty draw of a mesh out of a cross-fade keeps the place of the clusters of a cross-fade
    let candidates = cullCandidates(copy [draw(36u32, 4u32, 0u32, 2u32, 5u32),
                                          empty(5u32),
                                          draw(12u32, 8u32, 7u32, 1u32, 3u32)], 3us);

    assert (candidates[3us] == 0u32);
    assert (candidates[7us] == 5u32);
    assert (candidates[11us] == 10u32);
    assert (clusterCapacity(copy [draw(36u32, 4u32, 0u32, 2u32, 5u32), empty(5u32), draw(12u32, 8u32, 7u32, 1u32, 3u32)]) == 13u32);
}

__test the_draws_of_no_index_cull_no_cluster {
    let candidates = cullCandidates(copy [draw(0u32, 4u32, 3u32, 2u32, 2u32), empty(2u32)], 2us);
    assert (candidates[2us] == 0u32 && candidates[6us] == 0u32);
}

__test the_clusters_of_a_candidate_stay_in_its_bound {
    // a draw modified in place past the bound it was laid out with cannot write over the visibility of the next one
    let candidates = cullCandidates(copy [draw(36u32, 4u32, 0u32, 6u32, 4u32)], 1us);
    assert (candidates[2us] == 4u32);
}

__test the_candidates_past_the_draws_draw_nothing {
    // the objects removed since the layout leave fewer draws than laid out
    let candidates = cullCandidates(copy [draw(36u32, 4u32, 0u32, 2u32, 2u32)], 2us);
    assert (candidates == [4u32, 0u32, 2u32, 0u32, 0u32, 0u32, 0u32, 2u32]);
}
