in tab_order;

use balder::interface::widget::focus;

__test the_tree_order_without_tab_index {
    assert (tabOrder(copy [0, 0, 0]) == copy [0us, 1us, 2us]);
    assert (tabOrder([]).len == 0us);
}

__test the_positive_indices_come_first_by_increasing_index {
    // equal indices keep the order of the tree, the index 0 coming after every positive one
    assert (tabOrder(copy [0, 3, 1, 0, 1, 2]) == copy [2us, 4us, 5us, 1us, 0us, 3us]);
}

__test the_negative_indices_are_left_out {
    assert (tabOrder(copy [0, -1, 0, -3]) == copy [0us, 2us]);
    assert (tabOrder(copy [-1, -1]).len == 0us);
}

__test the_tab_key_moves_to_the_next_widget_and_wraps_around {
    let indices = copy [0, 0, 0];
    assert (nextTabStop(indices, (0us)?, backward-> false) == (1us)?);
    assert (nextTabStop(indices, (2us)?, backward-> false) == (0us)?);
    assert (nextTabStop(indices, (0us)?, backward-> true) == (2us)?);
    assert (nextTabStop(indices, (1us)?, backward-> true) == (0us)?);
}

__test without_focus_the_first_or_the_last_widget_is_focused {
    let indices = copy [0, 2, 0];
    assert (nextTabStop(indices, none, backward-> false) == (1us)?);
    assert (nextTabStop(indices, none, backward-> true) == (2us)?);
}

__test the_tab_key_follows_the_tab_indices {
    let indices = copy [0, 2, 1, 0];
    assert (nextTabStop(indices, (2us)?, backward-> false) == (1us)?);
    assert (nextTabStop(indices, (1us)?, backward-> false) == (0us)?);
    assert (nextTabStop(indices, (3us)?, backward-> false) == (2us)?);
    assert (nextTabStop(indices, (0us)?, backward-> true) == (1us)?);
}

__test a_focused_widget_left_out_stands_where_it_is_in_the_tree {
    // the focused widget at 2 is left out: the Tab key moves on to the next widget of the index 0 after it in the tree
    let indices = copy [0, 1, -1, 0];
    assert (nextTabStop(indices, (2us)?, backward-> false) == (3us)?);
    assert (nextTabStop(indices, (2us)?, backward-> true) == (0us)?);

    // after the last one, it wraps around to the first one in the order
    let last = copy [1, 0, -1];
    assert (nextTabStop(last, (2us)?, backward-> false) == (0us)?);
    assert (nextTabStop(last, (2us)?, backward-> true) == (1us)?);
}

__test no_widget_to_focus {
    assert (!nextTabStop(copy [-1, -1], (0us)?, backward-> false).hasValue);
    assert (!nextTabStop([], none, backward-> true).hasValue);
}
