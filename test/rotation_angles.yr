in rotation_angles;

use balder::math::{matrix, utils, vector};

/**
 * @returns: true iif two matrices are equal, give or take the rounding errors
 * */
fn near(a: mat4, b: mat4)-> bool {
    let d = a - b;
    let cols = [makeVec4(d.a1, d.b1, d.c1, d.d1), makeVec4(d.a2, d.b2, d.c2, d.d2),
                makeVec4(d.a3, d.b3, d.c3, d.d3), makeVec4(d.a4, d.b4, d.c4, d.d4)];
    for c in cols {
        if c.length() > 0.0001f { return false; }
    }

    true
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3)-> bool {
    (a - b).length() < 0.0001f
}

__test the_euler_rotation_turns_along_x_then_y_then_z {
    let angles = makeVec3(0.3f, -0.7f, 1.1f);
    assert (near(eulerRotation(angles), rotationX(0.3f) * rotationY(-0.7f) * rotationZ(1.1f)));
    assert (near(eulerRotation(makeVec3(0.0f, 0.0f, 0.0f)), mat4()));
}

__test the_angles_of_a_rotation_give_it_back {
    let samples = [makeVec3(0.3f, -0.7f, 1.1f), makeVec3(-2.9f, 1.2f, 0.4f), makeVec3(1.5f, 0.0f, -3.0f),
                   makeVec3(0.0f, -1.5f, 0.0f), makeVec3(0.0f, 0.0f, 0.0f)];
    for a in samples {
        // the angles within their range come back as they are
        assert (near(eulerAngles(eulerRotation(a)), a));
    }

    // angles out of their range come back as others making the same rotation
    let wide = makeVec3(4.0f, 2.5f, -5.0f);
    let back = eulerAngles(eulerRotation(wide));
    assert (near(eulerRotation(back), eulerRotation(wide)));
    assert (back.y >= -1.5708f && back.y <= 1.5708f);
}

__test the_gimbal_lock_keeps_the_rotation {
    // y at a quarter turn: x and z turn about the same axis, z is given 0
    let locked = makeVec3(0.4f, 1.5707964f, 0.3f);
    let back = eulerAngles(eulerRotation(locked));
    assert (back.z == 0.0f);
    assert (near(eulerRotation(back), eulerRotation(locked)));

    let below = makeVec3(-0.2f, -1.5707964f, 0.9f);
    assert (near(eulerRotation(eulerAngles(eulerRotation(below))), eulerRotation(below)));
}
