in table_columns;

use balder::interface::widget::table::columns;

__test the_columns_share_the_table_until_set {
    let dmut c = TableColumns(minWidth-> 20.0f);
    c:.layout(4us, 400.0f);
    assert (c.getWidths() == copy [100.0f, 100.0f, 100.0f, 100.0f] && !c.isSet());

    // the share follows the table, never below the minimum width
    c:.layout(4us, 40.0f);
    assert (c.getWidths() == copy [20.0f, 20.0f, 20.0f, 20.0f]);
    c:.layout(0us, 400.0f);
    assert (c.len() == 0us && c.getTotal() == 0.0f);
}

__test the_widths_set_are_kept {
    let dmut c = TableColumns(minWidth-> 20.0f);
    c:.layout(3us, 300.0f);
    c:.setWidth(1us, 150.0f);
    c:.layout(3us, 900.0f);
    assert (c.isSet() && c.getWidths() == copy [100.0f, 150.0f, 100.0f] && c.getTotal() == 350.0f);

    // a column added takes the width of the last one, a column removed is dropped
    c:.layout(4us, 900.0f);
    assert (c.getWidths() == copy [100.0f, 150.0f, 100.0f, 100.0f]);
    c:.layout(2us, 900.0f);
    assert (c.getWidths() == copy [100.0f, 150.0f]);

    // a width below the minimum is the minimum, a column past the last one is left out
    c:.setWidth(0us, 5.0f);
    c:.setWidth(7us, 50.0f);
    assert (c.getWidths() == copy [20.0f, 150.0f]);

    c:.reset();
    c:.layout(2us, 100.0f);
    assert (c.getWidths() == copy [50.0f, 50.0f]);
}

__test the_columns_are_found_from_a_position {
    let dmut c = TableColumns();
    c:.setWidths(copy [100.0f, 50.0f, 80.0f]);
    assert (c.startOf(0us) == 0.0f && c.startOf(2us) == 150.0f && c.startOf(9us) == 230.0f);
    assert (c.columnAt(0.0f) == (0us)? && c.columnAt(120.0f) == (1us)? && c.columnAt(229.0f) == (2us)?);
    assert (!c.columnAt(230.0f).hasValue && !c.columnAt(-1.0f).hasValue);
}

__test the_edges_are_grabbed_near_them {
    let dmut c = TableColumns();
    c:.setWidths(copy [100.0f, 50.0f, 80.0f]);
    assert (c.edgeAt(98.0f, 4.0f) == (0us)? && c.edgeAt(103.0f, 4.0f) == (0us)?);
    assert (c.edgeAt(151.0f, 4.0f) == (1us)? && c.edgeAt(232.0f, 4.0f) == (2us)?);
    assert (!c.edgeAt(120.0f, 4.0f).hasValue && !c.edgeAt(0.0f, 4.0f).hasValue);
}
