in desktop_dpi;

use balder::core::application::desktop;

/**
 * (resource database, dpi)
 * */
@parameters ((yield c for c in [("Xft.dpi:\t192\n", 192.0f),
                                ("Xft.antialias:\t1\nXft.dpi:\t144\nXft.hinting:\t1\n", 144.0f),
                                ("Xft.dpi: 120.5", 120.5f),
                                ("Xft.dpi:\t96\r\n", 96.0f),
                                ("Xft.antialias:\t1\n", 0.0f),
                                ("", 0.0f),
                                ("Xft.dpi:\t\n", 0.0f),
                                ("Xft.dpi:\t0\n", 0.0f),
                                ("Xft.dpi:\t-96\n", 0.0f),
                                ("Xft.dpi:\thigh\n", 0.0f),
                                ("Xft.dpi:\t96 dots\n", 0.0f),
                                ("MyXft.dpi:\t192\n", 0.0f)]))
__test parse_xft_dpi (resources: [c8], expected: f32) {
    assert (parseXftDpi(resources) == expected);
}
