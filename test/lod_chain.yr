in lod_chain;

use balder::math::vector;
use balder::scene::node::node3D::visual::lod::{_, simplify};

use std::math;

/**
 * A flat square of n by n quads in the plane y = 0, of side 1
 * @returns:
 *    - .0: the positions
 *    - .1: the indices
 * */
fn grid(n: u32)-> ([vec3], [u32]) {
    let positions = copy [makeVec3(cast!f32(i % (n + 1u32)) / cast!f32(n), 0.0f, cast!f32(i / (n + 1u32)) / cast!f32(n))
                          for i in 0u32 .. (n + 1u32) * (n + 1u32)];

    let dmut indices = copy [0u32; 6u32 * n * n];
    for y in 0u32 .. n {
        for x in 0u32 .. n {
            let a = y * (n + 1u32) + x, q = (y * n + x) * 6u32;
            indices[q] = a;
            indices[q + 1u32] = a + n + 1u32;
            indices[q + 2u32] = a + 1u32;
            indices[q + 3u32] = a + 1u32;
            indices[q + 4u32] = a + n + 1u32;
            indices[q + 5u32] = a + n + 2u32;
        }
    }

    (positions, indices)
}

/**
 * A sphere of radius 1, of 'rings' rings of 'segments' quads, closed at the poles
 * @params:
 *    - seam: true to duplicate the vertices of the first meridian, as a texture seam does
 * @returns:
 *    - .0: the positions
 *    - .1: the indices
 * */
fn sphere(rings: u32, segments: u32, seam: bool)-> ([vec3], [u32]) {
    let columns = if seam { segments + 1u32 } else { segments };

    // the two poles, then the rings between them
    let dmut positions = copy [makeVec3(0.0f, 1.0f, 0.0f), makeVec3(0.0f, -1.0f, 0.0f)];
    for r in 1u32 .. rings {
        let phi = cast!f32(math::PI) * cast!f32(r) / cast!f32(rings);
        for s in 0u32 .. columns {
            let theta = 2.0f * cast!f32(math::PI) * cast!f32(s % segments) / cast!f32(segments);
            positions ~= [makeVec3(sin(phi) * cos(theta), cos(phi), sin(phi) * sin(theta))];
        }
    }

    let dmut indices: [u32] = [];
    for s in 0u32 .. segments {
        indices ~= [0u32, sphereVertex(columns, segments, 1u32, s + 1u32), sphereVertex(columns, segments, 1u32, s)];
        indices ~= [1u32,
                    sphereVertex(columns, segments, rings - 1u32, s),
                    sphereVertex(columns, segments, rings - 1u32, s + 1u32)];
        for r in 1u32 .. rings - 1u32 {
            let a = sphereVertex(columns, segments, r, s), b = sphereVertex(columns, segments, r, s + 1u32);
            let c = sphereVertex(columns, segments, r + 1u32, s), d = sphereVertex(columns, segments, r + 1u32, s + 1u32);
            indices ~= [a, b, c, b, d, c];
        }
    }

    (positions, indices)
}

/**
 * @returns: the index of the vertex of the sphere on the ring r (from 1), at the segment s
 * */
fn sphereVertex(columns: u32, segments: u32, r: u32, s: u32)-> u32 {
    2u32 + (r - 1u32) * columns + (if columns > segments { s } else { s % segments })
}

/**
 * @returns: true iif no triangle of the indices is degenerate and every index is a vertex
 * */
fn wellFormed(indices: [u32], nbVertices: usize)-> bool {
    if indices.len % 3us != 0us { return false; }
    for t in 0us .. indices.len / 3us {
        let a = indices[t * 3us], b = indices[t * 3us + 1us], c = indices[t * 3us + 2us];
        if a == b || b == c || a == c { return false; }
        if cast!usize(a) >= nbVertices || cast!usize(b) >= nbVertices || cast!usize(c) >= nbVertices { return false; }
    }

    true
}

/**
 * A chain of levels with the given errors, each of one triangle
 * */
fn levelsOf(errors: [f32])-> LodChain {
    let mut chain = LodChain(copy [0u32, 1u32, 2u32]);
    chain.levels = copy [LodLevel(0u32, 3u32, e) for e in errors];
    chain
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          SIMPLIFY          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_flat_grid_simplifies_without_error {
    let (positions, indices) = grid(16u32);
    let (result, error) = simplify::simplify(positions, indices, 0us, 0.01f);

    assert (wellFormed(result, positions.len));
    assert (result.len <= 3us * 8us);
    assert (error < 0.001f);
}

__test a_single_triangle_keeps_its_shape_under_a_tight_error {
    let positions = copy [makeVec3(0.0f, 0.0f, 0.0f), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 0.0f, 1.0f)];
    let (result, error) = simplify::simplify(positions, copy [0u32, 1u32, 2u32], 0us, 0.01f);

    assert (result == [0u32, 1u32, 2u32]);
    assert (error == 0.0f);
}

__test the_degenerate_triangles_are_dropped {
    let positions = copy [makeVec3(0.0f, 0.0f, 0.0f), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 0.0f, 1.0f),
                          makeVec3(1.0f, 0.0f, 0.0f)];
    let (result, _) = simplify::simplify(positions, copy [0u32, 1u32, 2u32, 0u32, 1u32, 3u32], 3us, 0.0f);

    assert (result == [0u32, 1u32, 2u32]);
}

@parameters ((yield s for s in [false, true]))
__test a_sphere_reaches_its_target_with_a_bounded_error (seam: bool) {
    let (positions, indices) = sphere(16u32, 32u32, seam);
    let target = indices.len / 4us;
    let (result, error) = simplify::simplify(positions, indices, target, 0.2f);

    assert (wellFormed(result, positions.len));
    assert (result.len <= target);
    assert (error > 0.0f && error < 0.2f * 2.0f);

    // every remaining vertex is still on the sphere, the simplification only removes vertices
    for i in result {
        assert (math::abs(positions[i].length() - 1.0f) < 0.0001f);
    }
}

__test the_error_limit_stops_the_simplification {
    let (positions, indices) = sphere(16u32, 32u32, false);
    let (loose, looseError) = simplify::simplify(positions, indices, 0us, 0.1f);
    let (tight, tightError) = simplify::simplify(positions, indices, 0us, 0.01f);

    assert (tight.len > loose.len);
    assert (tightError <= 0.01f * 2.0f);
    assert (looseError >= tightError);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          LOD CHAIN          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_chain_follows_its_levels_in_one_index_buffer {
    let (positions, indices) = sphere(32u32, 64u32, true);
    let chain = buildLodChain(positions, indices);

    assert (chain.levels.len > 2us);
    assert (chain.levels[0].firstIndex == 0u32);
    assert (chain.levels[0].count == cast!u32(indices.len));
    assert (chain.levels[0].error == 0.0f);
    assert (chain.indices[0us .. indices.len] == indices);

    for i in 1us .. chain.levels.len {
        let previous = chain.levels[i - 1us], level = chain.levels[i];
        assert (level.firstIndex == previous.firstIndex + previous.count);
        assert (level.count * 4u32 <= previous.count * 3u32);
        assert (level.error >= previous.error);
        assert (wellFormed(chain.indices[level.firstIndex .. level.firstIndex + level.count], positions.len));
    }

    let last = chain.levels[chain.levels.len - 1us];
    assert (cast!usize(last.firstIndex + last.count) == chain.indices.len);
}

__test a_small_mesh_keeps_one_level {
    let (positions, indices) = grid(4u32);
    let chain = buildLodChain(positions, indices);

    assert (chain.levels.len == 1us);
    assert (chain.indices == indices);
}

__test the_vertices_drawing_the_same_data_are_welded {
    // the vertices 0 and 2 draw the same data, the vertex 1 another
    let vertices = copy [0.0f, 1.0f, 2.0f, 3.0f, 0.0f, 1.0f];
    assert (weldVertices(copy [2u32, 1u32, 0u32], vertices, 2us) == [0u32, 1u32, 0u32]);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          SELECTION          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * (unitSize, current level, expected level), for levels of errors 0, 1, 2, 4 and a threshold of 1
 * */
@parameters ((yield c for c in [(100.0f, 0us, 0us),  // every coarser level is too visible
                                (0.35f, 0us, 2us),   // 0.35 and 0.7 are under the hysteresis, 1.4 is over the threshold
                                (0.01f, 0us, 3us),   // far away, the coarsest level
                                (0.9f, 0us, 0us),    // 0.9 is under the threshold, but not under its hysteresis
                                (0.9f, 1us, 1us),    // a level stays while its error is under the threshold
                                (1.1f, 2us, 0us),    // too close for the level drawn, the finest level fitting
                                (0.3f, 3us, 2us),    // 4 * 0.3 is over the threshold: one level finer
                                (0.5f, 9us, 2us)]))  // a level out of the chain starts from the coarsest
__test the_selection_keeps_the_error_under_the_threshold (unitSize: f32, current: usize, expected: usize) {
    let chain = levelsOf(copy [0.0f, 1.0f, 2.0f, 4.0f]);
    assert (chain.select(current, unitSize, 1.0f) == expected);
}

__test a_chain_of_one_level_always_selects_it {
    let chain = levelsOf(copy [0.0f]);
    assert (chain.select(0us, 1000.0f, 1.0f) == 0us);
    assert (chain.select(0us, 0.0f, 1.0f) == 0us);
}
