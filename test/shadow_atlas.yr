in shadow_atlas;

use balder::scene::utils::local_shadow::{atlas, tile};

/**
 * @returns: true iif two tiles share a texel
 * */
fn overlap(a: ShadowTile, b: ShadowTile)-> bool {
    a.x < b.x + b.side && b.x < a.x + a.side && a.y < b.y + b.side && b.y < a.y + a.side
}

__test a_new_tile_is_the_largest_power_of_two_under_the_size_wanted {
    assert (tileSide(300.0f, 0u32, 64u32, 1024u32) == 256u32);
    assert (tileSide(256.0f, 0u32, 64u32, 1024u32) == 256u32);
    assert (tileSide(255.0f, 0u32, 64u32, 1024u32) == 128u32);

    // from the smallest tile to the largest one
    assert (tileSide(3.0f, 0u32, 64u32, 1024u32) == 64u32);
    assert (tileSide(f32::max, 0u32, 64u32, 1024u32) == 1024u32);
}

/**
 * The side of a tile changes only once the size wanted leaves its range by a share of it, so the tiles stay the same
 * while the camera moves a little
 * */
__test a_tile_keeps_its_side_near_its_range {
    // 256 covers [256, 512): it is kept from 256 * 0.8 to 512 * 1.2
    assert (tileSide(210.0f, 256u32, 64u32, 1024u32) == 256u32);
    assert (tileSide(600.0f, 256u32, 64u32, 1024u32) == 256u32);

    assert (tileSide(200.0f, 256u32, 64u32, 1024u32) == 128u32);
    assert (tileSide(620.0f, 256u32, 64u32, 1024u32) == 512u32);

    // the smallest and the largest tiles are kept past their range
    assert (tileSide(1.0f, 64u32, 64u32, 1024u32) == 64u32);
    assert (tileSide(f32::max, 1024u32, 64u32, 1024u32) == 1024u32);
}

__test tiles_that_fit_are_kept {
    let sides = fitTiles(copy [1024u32, 512u32, 256u32], copy [6u32, 1u32, 6u32], 4096u32, 64u32);
    assert (sides == [1024u32, 512u32, 256u32]);
}

/**
 * Tiles too large for the atlas lose texels from the largest, the least important light first among the largest
 * */
__test the_largest_tiles_are_halved_until_they_fit {
    // three point lights of 1024: 18 tiles where 16 fit, the last light halved
    let sides = fitTiles(copy [1024u32, 1024u32, 1024u32], copy [6u32, 6u32, 6u32], 4096u32, 64u32);
    assert (sides == [1024u32, 1024u32, 512u32]);

    let mut area = 0u64;
    for i, s in sides {
        area += cast!u64(s) * cast!u64(s) * 6u64;
    }

    assert (area <= 4096u64 * 4096u64);
}

/**
 * Once every tile is the smallest, the least important lights are left out until the others fit
 * */
__test the_least_important_lights_are_left_out_once_the_tiles_are_the_smallest {
    // an atlas of 4 tiles of 64 holds the spot light in front, not the point light after it
    let sides = fitTiles(copy [64u32, 64u32, 64u32], copy [1u32, 6u32, 1u32], 128u32, 64u32);
    assert (sides == [64u32, 0u32, 0u32]);

    // the lights past the counts are left out
    assert (fitTiles(copy [64u32, 64u32], copy [1u32], 128u32, 64u32) == [64u32, 0u32]);
}

/**
 * The tiles are packed from the top left corner along a Morton curve, the largest first, without overlapping nor
 * leaving the atlas
 * */
__test tiles_are_packed_without_overlapping {
    let sides = copy [256u32, 1024u32, 64u32, 512u32, 64u32, 1024u32, 256u32];
    let tiles = packTiles(sides, 2048u32, 64u32);
    assert (tiles.len == sides.len);

    for i, t in tiles {
        assert (t.side == sides[i]);
        assert (t.x % t.side == 0u32 && t.y % t.side == 0u32);
        assert (t.x + t.side <= 2048u32 && t.y + t.side <= 2048u32);
        for j in i + 1us .. tiles.len {
            assert (!overlap(t, tiles[j]));
        }
    }

    // the first largest tile at the top left, the second one on its right
    assert (tiles[1].x == 0u32 && tiles[1].y == 0u32);
    assert (tiles[5].x == 1024u32 && tiles[5].y == 0u32);
}

/**
 * Tiles covering the whole atlas fill it, and a tile left out by the fitting has no place
 * */
__test tiles_fill_the_atlas_and_none_has_no_place {
    let tiles = packTiles(copy [512u32, 512u32, 512u32, 0u32, 512u32], 1024u32, 64u32);
    assert (tiles[3].side == 0u32);

    let mut covered = 0u32;
    for t in tiles {
        covered += t.side * t.side;
    }

    assert (covered == 1024u32 * 1024u32);
    assert (tiles[4].x == 512u32 && tiles[4].y == 512u32);
}
