// The parts: their own styles, the properties they inherit from their widget, their states and those of their widget

LinearLayout #PARTS .parts {
    PushButton #BUTTON .button "Button";
    CheckBox #CHECK .check "Check" { checked: true; }
    Slider #SLIDER .slider 40 { max: 100; }
    TabLayout #TABS .tabs {
        Label .page "First" { tab: "First"; }
        Label .page "Second" { tab: "Second"; }
    }
    ListView #LIST .list;
    PushButton #ITEM .item "Save" { shortcut: "Ctrl+S"; }
    TreeView #TREE .tree;
}
