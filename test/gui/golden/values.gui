// The values: every property of a Style, the lengths, the sizes and their bounds, and the properties the types register

FloatingLayout #VALUES .values {
    LinearLayout #COLUMN .column {
        Label #TEXT .text "Text";
        Label #HIDDEN .hidden "Hidden";
        Image #PICTURE .picture "test/gui/golden/none.png";
        Separator .rule;
    }
    GridLayout #GRID .grid {
        Box .cell { cell: 0 0; }
        Box .cell { cell: 1 0; }
    }
    MenuButton #MENU .menu "Menu";
    Box #CORNER .corner;
}
