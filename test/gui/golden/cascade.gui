// The cascade: selectors by type, class and id, descendants and children, the specificity and the order of the rules,
// the inherited properties and the states

LinearLayout #ROOT .root {
    Label .title "Title";
    LinearLayout #INNER .inner {
        Label .title "Nested title";
        Label #NOTE .note "Note";
        PushButton #OK .button "OK";
        PushButton .button .flat "Flat";
    }
    Box .fill;
}
