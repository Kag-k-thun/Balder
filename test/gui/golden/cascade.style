// The constants are spliced where they are used, a constant using the ones before it
$ink: #202020;
$accent: steelblue;
$soft: $accent / 40%;
$pad: 6 14;

// The inherited properties, set once on the root, are left out under it while unchanged
LinearLayout.root {
    font-family: "Noto Sans", sans-serif;
    font-size: 14;
    text-color: $ink;
    padding: $pad;
    padding-left: 20;
}

// Every label, then the titles, then the titles under .inner only, then the children of #INNER
Label { text-color: #333; }
Label.title { font-size: 18; }
LinearLayout.inner Label.title { text-color: rgb(56 139 253); }
#INNER > Label { margin: 2 4 6; }

// A type, a class and an id: the id wins whatever the order, a tie goes to the later rule
#NOTE { text-color: red; }
Label.note { text-color: green; }
Label.note { background-color: hsl(120 50% 50%); }
Label.note { background-color: rgba(0, 0, 255, 0.5); }

// One block shared by two selectors, and the states changing what does not move the layout
PushButton.button, Box.fill { background-color: $soft; }
PushButton.button:hover { background-color: $accent; }
PushButton.button:pressed { background-color: #1f6feb; border-color: white; }
PushButton.flat:focus { border-color: $accent; }
PushButton.flat { border: 1 transparent; }
