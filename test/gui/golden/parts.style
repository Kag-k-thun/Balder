LinearLayout.parts { text-color: #101010; font-size: 12; }

// A part inherits the text of its widget, then overrides it
PushButton.button { text-color: navy; }
PushButton.button::label { font-weight: bold; }
PushButton.button:hover::label { text-color: blue; }

// The states of a widget registered by its type, and a part styled while its widget is checked
CheckBox.check::box { border: 1 #808080; radius: 3; }
CheckBox.check:checked::box { background-color: #1f6feb; }
CheckBox.check::mark { color: white; }

Slider.slider::track { background-color: #303030; height: 4; }
Slider.slider::fill { background-color: #3fb950; }
Slider.slider:focus::thumb { shadow: 0 0 0 2 #388bfd; }

// The states of a part: the selected tab, every tab of a hovered layout, a part hovered on its own
TabLayout.tabs::tab { padding: 4 8; background-color: #202020; }
TabLayout.tabs::tab:selected { background-color: #404040; }
TabLayout.tabs::tab:hover { text-color: white; }
TabLayout.tabs:hover::tab { border-color: #606060; }

ListView.list::row:selected { background-color: #1f6feb; }
ListView.list::scrollbar:pressed { color: #808080; }
