// The components: their instances, the arguments they are given, a component used by another, their slots, and the
// sheets they bring along
@import "widgets/card.gui";

LinearLayout #CARDS .cards {
    Card #FIRST "First";
    Card #SECOND "Second" {
        tag: "old";
        Label .body "The body of the second card";
        Badge #EXTRA "extra";
    }
}
