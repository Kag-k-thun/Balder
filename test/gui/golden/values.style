// The position of the floating children, from the sides of the layout
FloatingLayout.values { width: 100%; height: 100%; background-color: #0d1117; }
LinearLayout.column { left: 10; top: 5%; width: 50%; min-width: min-content; max-width: 640; overflow: scroll; scroll-speed: 2.5; }
GridLayout.grid { right: 0; bottom: 0; width: max-content; height: auto; max-height: none; columns: 120 1fr 25% auto; rows: min-content max-content; }
Box.corner { right: 12.25; top: 0; min-height: 3.5; shadow: -2 4 12 1 #00000080; radius: 1 2 3 4; border: 2 black; border-left-width: 4; }

// The text of a label, its alignment and its wrapping
Label.text {
    font-family: "DejaVu Sans Mono", monospace;
    font-weight: 700;
    font-style: italic;
    text-xalign: left;
    text-yalign: bottom;
    text-wrap: wrap;
    margin: 0 8;
    flex: 1;
}

Label.hidden { display: none; }
Image.picture { image-color: #ffffffcc; image-keep-ratio: true; image-fill: false; flex-grow: 2; flex-shrink: 0; flex-basis: 30; }
Separator.rule { direction: row; color: #30363d; }
MenuButton.menu { popup-align: right bottom; }
