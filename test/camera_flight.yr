in camera_flight;

use balder::math::vector;
use balder::scene::node::node3D::camera::flight;

use std::math;

fn near(a: f32, b: f32, epsilon: f32 = 1.0e-4f)-> bool {
    math::abs(a - b) <= epsilon
}

/**
 * @returns: the flight after 'steps' steps of 'seconds' along a direction
 * */
fn flown(flight: CameraFlight, direction: vec3, distance: f32, fast: bool, steps: u32, seconds: f32)-> CameraFlight {
    let mut f = flight;
    for _ in 0u32 .. steps {
        f:.step(direction, distance, fast, seconds);
    }

    f
}

__test the_velocity_eases_toward_the_pace_of_the_distance {
    let mut f = CameraFlight();
    let first = f:.step(makeVec3(1.0f, 0.0f, 0.0f), 10.0f, false, 0.01f);

    // a step closes a share of the gap only, the eye starting slowly
    assert (first.x > 0.0f && first.x < 10.0f * 0.01f);
    assert (first.y == 0.0f && first.z == 0.0f);

    // after a second, the eye flies at a pace of 1: the distance a second
    f = flown(f, makeVec3(1.0f, 0.0f, 0.0f), 10.0f, false, 100u32, 0.01f);
    assert (near(f.velocity.x, 10.0f, epsilon-> 1.0e-2f));
}

__test the_direction_is_normalized {
    let mut f = CameraFlight();
    f = flown(f, makeVec3(3.0f, 0.0f, 4.0f), 2.0f, false, 300u32, 0.01f);
    assert (near(f.velocity.length(), 2.0f, epsilon-> 1.0e-3f));
    assert (near(f.velocity.x, 1.2f, epsilon-> 1.0e-3f) && near(f.velocity.z, 1.6f, epsilon-> 1.0e-3f));
}

__test flying_fast_multiplies_the_speed {
    let mut f = CameraFlight();
    f = flown(f, makeVec3(0.0f, 0.0f, -1.0f), 1.0f, true, 300u32, 0.01f);
    assert (near(f.velocity.z, -FAST_FACTOR, epsilon-> 1.0e-3f));
}

__test the_eye_slows_down_to_a_stop {
    let mut f = CameraFlight();
    f = flown(f, makeVec3(1.0f, 0.0f, 0.0f), 1.0f, false, 100u32, 0.01f);
    assert (f.isMoving());

    // released, the eye glides on a little, then stops for good rather than creeping on
    let glide = f:.step(vec3(), 1.0f, false, 0.01f);
    assert (glide.x > 0.0f);

    f = flown(f, vec3(), 1.0f, false, 300u32, 0.01f);
    assert (!f.isMoving());
    assert (f:.step(vec3(), 1.0f, false, 0.01f).length() == 0.0f);
}

__test a_long_frame_moves_the_eye_no_farther_than_a_short_one {
    let mut a = CameraFlight(), mut b = CameraFlight();
    let long = a:.step(makeVec3(1.0f, 0.0f, 0.0f), 1.0f, false, 5.0f);
    let short = b:.step(makeVec3(1.0f, 0.0f, 0.0f), 1.0f, false, 0.1f);
    assert (near(long.x, short.x));
}

__test the_wheel_changes_the_pace_within_its_bounds {
    let mut f = CameraFlight();
    f:.faster(1);
    assert (near(f.pace, 1.25f));
    f:.faster(-2);
    assert (near(f.pace, 0.8f));

    f:.faster(100);
    assert (f.pace == MAX_PACE);
    f:.faster(-100);
    assert (f.pace == MIN_PACE);
}

__test stopping_drops_the_velocity {
    let mut f = CameraFlight();
    f = flown(f, makeVec3(0.0f, 1.0f, 0.0f), 1.0f, false, 10u32, 0.01f);
    f:.stop();
    assert (!f.isMoving());
}
