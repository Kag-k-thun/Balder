in fixed_steps;

use balder::core::application::fixed_step;

use std::math;
use std::time;

__test a_tick_runs_the_steps_it_covers_and_carries_the_rest {
    // steps of 16 666 us
    let mut steps = FixedStep(60u32);
    assert(steps:.advance(millis(25u64)) == 1u32);
    assert(abs(steps.alpha - 0.5f) < 0.01f);

    // 8 334 left + 10 000
    assert(steps:.advance(millis(10u64)) == 1u32);
    assert(steps:.advance(millis(1u64)) == 0u32);
}

__test a_stall_runs_at_most_the_catch_up_steps_and_drops_the_rest {
    let mut steps = FixedStep(60u32, maxSteps-> 4u32);
    assert(steps:.advance(seconds(1u64)) == 4u32);
    assert(steps.alpha < 1.0f);

    // the dropped time does not come back at the next tick
    assert(steps:.advance(millis(1u64)) == 0u32);
}

__test a_step_lasts_the_inverse_of_its_rate {
    let steps = FixedStep(50u32);
    assert(abs(steps.seconds - 0.02f) < 0.000001f);
}
