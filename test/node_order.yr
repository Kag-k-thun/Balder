in node_order;

use balder::math::{matrix, utils, vector};
use balder::scene::_;
use balder::scene::node;
use balder::scene::node::node3D::group;

use std::fs;

/**
 * A root with no scene, for the nodes of the tests to hang from, keeping the names of the nodes entering its tree
 * */
class Root over Node {

    // The names of the nodes that entered the tree, in order
    let mut _entered: [[c8]] = [];

    pub self ()
        with super::root ("")
    {}

    @field
    pub fn entered(self)-> [[c8]] {
        self._entered
    }

    over onTreeEnter(mut self, dmut who: &Node) {
        self._entered ~= [who.name.file()];
    }

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * @returns: the names of the children of a node, in their order
 * */
fn namesUnder(dmut node: &Node)-> [[c8]] {
    let mut names: [[c8]] = [];
    for c in node:.getChildrenInOrder() {
        names ~= [c.name.file()];
    }

    names
}

/**
 * @returns: true iif two matrices are equal, give or take the rounding errors
 * */
fn near(a: mat4, b: mat4)-> bool {
    let d = a - b;
    let cols = [makeVec4(d.a1, d.b1, d.c1, d.d1), makeVec4(d.a2, d.b2, d.c2, d.d2),
                makeVec4(d.a3, d.b3, d.c3, d.d3), makeVec4(d.a4, d.b4, d.c4, d.d4)];
    for c in cols {
        if c.length() > 0.0001f { return false; }
    }

    true
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          ORDER          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_children_are_in_the_order_they_were_attached {
    let dmut root = copy Root();
    let _zebra_ = copy Group3D("zebra", alias root);
    let _apple_ = copy Group3D("apple", alias root);
    let _mango_ = copy Group3D("mango", alias root);

    assert (namesUnder(alias root) == ["zebra", "apple", "mango"]);
    assert (_zebra_.index == 0us && _apple_.index == 1us && _mango_.index == 2us);
}

__test a_node_attached_at_a_place_goes_before_the_child_there {
    let dmut root = copy Root();
    let _a_ = copy Group3D("a", alias root);
    let _b_ = copy Group3D("b", alias root);
    let dmut c = copy Group3D("c", alias root);

    c:.dispose();
    assert (namesUnder(alias root) == ["a", "b"]);
    assert (c:.attach(alias root, at-> 1us));
    assert (namesUnder(alias root) == ["a", "c", "b"]);

    // past the children, it goes last
    c:.dispose();
    assert (c:.attach(alias root, at-> 42us));
    assert (namesUnder(alias root) == ["a", "b", "c"]);
}

__test a_node_renamed_keeps_its_place {
    let dmut root = copy Root();
    let _a_ = copy Group3D("a", alias root);
    let dmut b = copy Group3D("b", alias root);
    let _c_ = copy Group3D("c", alias root);

    assert (b:.rename("z"));
    assert (namesUnder(alias root) == ["a", "z", "c"]);
}

__test the_nodes_of_a_tree_are_listed_parents_first_in_their_order {
    let dmut root = copy Root();
    let dmut b = copy Group3D("b", alias root);
    let _a_ = copy Group3D("a", alias root);
    let _d_ = copy Group3D("d", alias b);
    let _c_ = copy Group3D("c", alias b);

    let dmut list: [&Node] = [];
    let mut names: [[c8]] = [];
    for n in root:.getAllNodes(ref list) {
        names ~= [n.name.file()];
    }

    assert (names == ["", "b", "d", "c", "a"]);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          MOVES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_node_moved_among_its_siblings_changes_its_place_only {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let _b_ = copy Group3D("b", alias root);
    let _c_ = copy Group3D("c", alias root);

    let before = root.entered.len;
    assert (a:.moveUnder(alias root, at-> 2us));
    assert (namesUnder(alias root) == ["b", "c", "a"]);
    assert (a:.moveUnder(alias root, at-> 1us));
    assert (namesUnder(alias root) == ["b", "a", "c"]);
    assert (a:.moveUnder(alias root, at-> 0us));
    assert (namesUnder(alias root) == ["a", "b", "c"]);

    // the node never left the tree
    assert (root.entered.len == before);
}

__test a_node_moved_under_another_parent_takes_the_nodes_under_it_along {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut group = copy Group3D("group", alias root);
    let _x_ = copy Group3D("x", alias group);
    let c = copy Group3D("c", alias a);

    let before = root.entered.len;
    assert (a:.moveUnder(alias group, at-> 0us));
    assert (namesUnder(alias root) == ["group"]);
    assert (namesUnder(alias group) == ["a", "x"]);
    assert (a.name == Path("group/a") && c.name == Path("group/a/c"));
    assert (root:.find(Path("group/a/c")).hasValue && !root:.find(Path("a")).hasValue);

    // in the same tree, the nodes stay in it, they neither leave nor enter it again
    assert (root.entered.len == before);
}

__test a_node_moved_to_another_tree_enters_it {
    let dmut one = copy Root();
    let dmut other = copy Root();
    let dmut a = copy Group3D("a", alias one);
    let _b_ = copy Group3D("b", alias a);

    assert (a:.moveUnder(alias other, at-> LAST_PLACE));
    assert (namesUnder(alias one) == [] && namesUnder(alias other) == ["a"]);
    assert (other.entered[other.entered.len - 2us .. $] == ["a", "b"]);
}

__test a_node_moves_neither_under_itself_nor_where_a_child_has_its_name {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut b = copy Group3D("b", alias a);
    let dmut group = copy Group3D("group", alias root);
    let _twin_ = copy Group3D("a", alias group);

    assert (!a:.moveUnder(alias a, at-> LAST_PLACE));
    assert (!a:.moveUnder(alias b, at-> LAST_PLACE));
    assert (!a:.moveUnder(alias group, at-> LAST_PLACE));
    assert (namesUnder(alias root) == ["a", "group"] && a.name == Path("a"));

    // detached, it is attached, not moved
    a:.dispose();
    assert (!a:.moveUnder(alias root, at-> LAST_PLACE));
}

__test a_node_is_under_its_ancestors_only {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut b = copy Group3D("b", alias a);
    let dmut c = copy Group3D("c", alias root);

    assert (b.isUnder(a) && b.isUnder(root) && a.isUnder(root));
    assert (!a.isUnder(b) && !a.isUnder(a) && !b.isUnder(c) && !root.isUnder(a));
    assert (b:.getRoot() is root && root:.getRoot() is root);
}

__test a_node_moved_computes_its_transformation_under_its_new_parent {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut group = copy Group3D("group", alias root);
    group:.setTransform(makeVec3(1.0f, 2.0f, 3.0f), makeVec3(0.0f, 0.5f, 0.0f), makeVec3(2.0f, 2.0f, 2.0f));
    a:.setTransform(makeVec3(0.0f, 1.0f, 0.0f), vec3(), makeVec3(1.0f, 1.0f, 1.0f));

    assert (a:.moveUnder(alias group, at-> LAST_PLACE));
    assert (near(a.transformation, group.transformation * translation(makeVec3(0.0f, 1.0f, 0.0f))));
}
