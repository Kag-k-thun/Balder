in parser_size;

use balder::interface::loader::parser;

use std::syntax::errors;

/**
 * @returns: the values of a content
 * */
fn read(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @params:
 *    - kind: the kind the content is decoded as
 * @returns: true iif the decoding of a content throws a syntax error
 * */
fn rejects(content: [c8], kind: [c8])-> bool {
    {
        let v = read(content);
        match kind {
            "length" => { Length(v); }
            "size"   => { Size(v); }
            _        => { Size(v, track-> true); }
        }

        false
    } catch {
        _: &SyntaxError => { true }
    }
}

/**
 * (content, amount, unit)
 * */
@parameters ((yield c for c in [("12", 12.0f, Unit::PX), ("12px", 12.0f, Unit::PX), ("40%", 40.0f, Unit::PERCENT),
                                ("-4", -4.0f, Unit::PX), ("0.5px", 0.5f, Unit::PX)]))
__test lengths (content: [c8], amount: f32, unit: Unit) {
    let l = Length(read(content));
    assert (l.amount == amount && l.unit == unit);
}

@parameters ((yield c for c in ["1fr", "auto", "\"12\"", "12 14"]))
__test invalid_lengths (content: [c8]) {
    assert (rejects(content, "length"));
}

/**
 * (content, sizing)
 * */
@parameters ((yield c for c in [("auto", Sizing::AUTO), ("min-content", Sizing::MIN_CONTENT),
                                ("max-content", Sizing::MAX_CONTENT), ("120", Sizing::LENGTH)]))
__test sizes (content: [c8], sizing: Sizing) {
    assert (Size(read(content)).sizing == sizing);
}

__test the_length_of_a_size {
    let s = Size(read("20%"));
    assert (s.sizing == Sizing::LENGTH && s.length.amount == 20.0f && s.length.unit == Unit::PERCENT);
}

@parameters ((yield c for c in ["1fr", "fit", "none", "#fff"]))
__test invalid_sizes (content: [c8]) {
    assert (rejects(content, "size"));
}

__test tracks_take_shares_of_the_free_space {
    let tracks = read("1fr 2fr 120 auto").toTuple();
    let t0 = Size(tracks[0], track-> true), t1 = Size(tracks[1], track-> true);
    let t2 = Size(tracks[2], track-> true), t3 = Size(tracks[3], track-> true);
    assert (t0.sizing == Sizing::LENGTH && t0.length.unit == Unit::FR && t0.length.amount == 1.0f);
    assert (t1.length.unit == Unit::FR && t1.length.amount == 2.0f);
    assert (t2.length.unit == Unit::PX && t2.length.amount == 120.0f);
    assert (t3.sizing == Sizing::AUTO);
    assert (rejects("row", "track"));
}
