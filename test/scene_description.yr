in scene_description;

use balder::core::error;
use balder::math::{curve, utils, vector};
use balder::scene::{_, description::_};
use balder::scene::node;
use balder::scene::node::node3D::{_, empty, light, marker, path, path_point, volume, volume_shape};
use balder::scene::node::node3D::visual::{_, material::_};

use std::{fs, io, uuid};

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

// The ids of the nodes of the files of the tests
def SUN   = "87b7e0df-348c-4ee2-b5e4-a54c540e02bf";
def TABLE = "30c4fd6c-045e-4f5b-925c-bb8d17b6c935";
def TOP   = "030e69b7-ba92-4e55-bd67-5381a2351926";
def PLATE = "75e8622f-285e-414a-8e93-d82ecee1a614";
def CHAIR = "0c203f1a-b872-4e76-b3e0-0c7c95e00c74";
def STOOL = "5d3c1b2a-9e8f-4a7b-8c6d-5e4f3a2b1c0d";
def SPAWN = "a1b2c3d4-e5f6-4718-9a0b-1c2d3e4f5a6b";
def ROUTE = "b2c3d4e5-f6a7-4829-8b1c-2d3e4f5a6b7c";
def START = "c3d4e5f6-a7b8-493a-9c2d-3e4f5a6b7c8d";
def END   = "d4e5f6a7-b8c9-4a4b-8d3e-4f5a6b7c8d9e";
def PILL  = "e5f6a7b8-c9d0-4b5c-9e4f-5a6b7c8d9e0f";
def ZONE  = "f6a7b8c9-d0e1-4c6d-8f5a-6b7c8d9e0f1a";

/**
 * @returns: true iif two numbers are within a millionth of each other
 * */
fn near(a: f32, b: f32)-> bool {
    (a - b) < 1.0e-5f && (b - a) < 1.0e-5f
}

/**
 * @returns: the message of the error reading a scene file throws, empty when it reads it
 * */
fn errorOf(content: [c8], file: [c8] = "")-> [c8] {
    {
        SceneDescription(content, file-> file);
        ""
    } catch {
        err: &BalderError => { err.msg }
    }
}

/**
 * @returns: true iif a text holds another one
 * */
fn holds(text: [c8], part: [c8])-> bool {
    if part.len > text.len { return false; }
    for i in 0us ... text.len - part.len {
        if text[i .. i + part.len] == part { return true; }
    }

    false
}

/**
 * @returns: the id of a test
 * */
fn id(text: [c8])-> Uuid {
    {
        std::uuid::to!{Uuid} (text)
    } catch {
        _ => { Uuid::nil() }
    }
}

/**
 * @returns: true iif two descriptions are the same, and so are the nodes under them
 * */
fn same(a: NodeDescription, b: NodeDescription)-> bool {
    if a.id.opCmp(b.id) != 0 || a.name != b.name || a.kind != b.kind { return false; }
    if a.position != b.position || a.rotation != b.rotation || a.scale != b.scale { return false; }
    if a.file != b.file || a.lods != b.lods || a.material != b.material { return false; }
    if a.light != b.light || a.color != b.color || a.intensity != b.intensity || a.direction != b.direction { return false; }
    if a.range != b.range || a.innerAngle != b.innerAngle || a.outerAngle != b.outerAngle || a.shadows != b.shadows { return false; }
    if a.purpose != b.purpose || a.tags != b.tags || a.curve != b.curve || a.closed != b.closed || a.volume != b.volume { return false; }
    if a.children.len != b.children.len { return false; }
    for i in 0us .. a.children.len {
        if !same(a.children[i], b.children[i]) { return false; }
    }

    true
}

/**
 * @returns: true iif two lists of descriptions are the same
 * */
fn sameNodes(a: [NodeDescription], b: [NodeDescription])-> bool {
    if a.len != b.len { return false; }
    for i in 0us .. a.len {
        if !same(a[i], b[i]) { return false; }
    }

    true
}

/**
 * @returns: a scene file of a light, and of an empty of a cube and of an empty holding a model, the plate given before
 * its parent
 * */
fn table()-> [c8] {
    "// a table and its light\n"
    ~ "scene 1;\n"
    ~ "\n"
    ~ "asset chair model \"res:/models/chair.glb\";\n"
    ~ "\n"
    ~ "node #" ~ SUN ~ " light \"sun\" {\n"
    ~ "    light: point;\n"
    ~ "    color: 1 0.5 0.25;\n"
    ~ "    intensity: 3;\n"
    ~ "    range: 12.5;\n"
    ~ "    shadows: true;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PLATE ~ " empty \"plate\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TABLE ~ " empty \"table\" {\n"
    ~ "    position: 1 2 3;\n"
    ~ "    rotation: 0 90 0;   /* a quarter turn */\n"
    ~ "    scale: 2 2 2;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TOP ~ " cube \"top\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "    color: 0.5 0.3 0.1;\n"
    ~ "    roughness: 0.25;\n"
    ~ "    metallic: 1;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ CHAIR ~ " model \"chair\" {\n"
    ~ "    parent: #" ~ PLATE ~ ";\n"
    ~ "    position: -0.5 0 0;\n"
    ~ "    file: @chair;\n"
    ~ "    lods: false;\n"
    ~ "}\n"
}

/**
 * @returns: a scene file of a node of every kind, as the writer writes it
 * */
fn everyKind()-> [c8] {
    "scene 1;\n"
    ~ "\n"
    ~ "asset chair model \"res:/models/chair.glb\";\n"
    ~ "asset chair_2 model \"res:/props/chair.obj\";\n"
    ~ "\n"
    ~ "node #" ~ SUN ~ " light \"spot\" {\n"
    ~ "    position: 0 4 0;\n"
    ~ "    light: spot;\n"
    ~ "    color: 1 0.9 0.8;\n"
    ~ "    intensity: 25;\n"
    ~ "    direction: 0.3 -1 0.1;\n"
    ~ "    range: 15;\n"
    ~ "    inner-angle: 12.5;\n"
    ~ "    outer-angle: 40;\n"
    ~ "    shadows: true;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TABLE ~ " empty \"room\" {\n"
    ~ "    rotation: 0 30 -45;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TOP ~ " sphere \"ball\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "    position: 0.1 0.2 0.3;\n"
    ~ "    scale: 0.5 0.5 0.5;\n"
    ~ "    color: 0.2 0.4 0.8;\n"
    ~ "    roughness: 0.2;\n"
    ~ "    metallic: 1;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PLATE ~ " plane \"floor\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "    scale: 20 1 20;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ CHAIR ~ " model \"chair\" {\n"
    ~ "    file: @chair_2;\n"
    ~ "    lods: false;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ STOOL ~ " model \"stool\" {\n"
    ~ "    file: @chair;\n"
    ~ "}\n"
    ~ markedNodes()
}

/**
 * @returns: the blocks of a marker, of a path of two points and of two volumes, as the writer writes them
 * */
fn markedNodes()-> [c8] {
    "\n"
    ~ "node #" ~ SPAWN ~ " marker \"spawn\" {\n"
    ~ "    position: 1 0 -2;\n"
    ~ "    purpose: spawn;\n"
    ~ "    tags: \"player\" \"start\";\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ ROUTE ~ " path \"route\" {\n"
    ~ "    curve: bezier;\n"
    ~ "    closed: true;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ START ~ " path-point \"point\" {\n"
    ~ "    parent: #" ~ ROUTE ~ ";\n"
    ~ "    position: -2 0 0;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ END ~ " path-point \"point_2\" {\n"
    ~ "    parent: #" ~ ROUTE ~ ";\n"
    ~ "    position: 2 0 0;\n"
    ~ "    scale: 1.5 1 1;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PILL ~ " volume \"trigger\" {\n"
    ~ "    shape: capsule;\n"
    ~ "    radius: 0.75;\n"
    ~ "    height: 3;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ ZONE ~ " volume \"zone\" {\n"
    ~ "    size: 4 2 1;\n"
    ~ "}\n"
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          READ          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_scene_file_puts_its_nodes_under_their_parents_in_the_order_of_the_file {
    {
        let nodes = SceneDescription(table()).nodes;
        assert (nodes.len == 2us);
        assert (nodes[0].name == "sun" && nodes[0].kind == NodeKind::LIGHT);
        assert (nodes[1].name == "table" && nodes[1].kind == NodeKind::EMPTY);

        // the plate comes before its parent in the file, and before the top among the nodes under the table
        let children = nodes[1].children;
        assert (children.len == 2us && children[0].name == "plate" && children[1].name == "top");
        assert (children[1].kind == NodeKind::CUBE);
        assert (children[0].children.len == 1us && children[0].children[0].name == "chair");
    } catch {
        _ => { assert (false); }
    }
}

__test the_entries_of_a_node_are_read_the_rotation_in_degrees {
    {
        let nodes = SceneDescription(table()).nodes;
        let sun = nodes[0], table = nodes[1], top = nodes[1].children[1], chair = nodes[1].children[0].children[0];

        assert (sun.light == LightType::POINT && sun.shadows && near(sun.intensity, 3.0f) && near(sun.range, 12.5f));
        assert (near(sun.color.y, 0.5f));

        assert (near(table.position.z, 3.0f) && near(table.scale.x, 2.0f));
        assert (near(table.rotation.y, radian(90.0f)) && near(table.rotation.x, 0.0f));

        assert (near(top.material.baseColor.x, 0.5f) && near(top.material.roughness, 0.25f));
        assert (near(top.material.metallic, 1.0f));

        assert (chair.kind == NodeKind::MODEL && chair.file == "res:/models/chair.glb" && !chair.lods);
        assert (near(chair.position.x, -0.5f));
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_keep_the_ids_of_their_blocks {
    {
        let nodes = SceneDescription(table()).nodes;
        assert (nodes[0].id.opCmp(id(SUN)) == 0 && nodes[1].id.opCmp(id(TABLE)) == 0);
        assert (nodes[1].children[1].id.opCmp(id(TOP)) == 0);
    } catch {
        _ => { assert (false); }
    }
}

__test a_scene_file_without_nodes_describes_an_empty_scene {
    {
        assert (SceneDescription("scene 1;\n").nodes.len == 0us);
        assert (SceneDescription("// nothing yet\nscene 1; /* still nothing */\n").nodes.len == 0us);
    } catch {
        _ => { assert (false); }
    }
}

__test the_errors_of_a_scene_file_tell_where_and_why {
    let head = "scene 1;\n";
    let node = "node #" ~ SUN ~ " ";

    let cases = [
        ("",
         "scene:1:1: expected 'scene 1;'"),
        ("[[node]]\nname = \"a\"\n",
         "scene:1:1: unexpected '[[node]]'"),
        ("scene 2;\n",
         "version '2' of the scene file"),
        (head ~ "camera {}\n",
         "scene:2:1: expected a node or an asset"),
        (head ~ "node #12 cube \"a\" {}\n",
         "expected the id of the node"),
        (head ~ node ~ "cone \"a\" {}\n",
         "the kind of the node"),
        (head ~ node ~ "cube a {}\n",
         "the name of the node"),
        (head ~ node ~ "cube \"a/b\" {}\n",
         "holding a '/'"),
        (head ~ node ~ "cube \"a\" { size: 2; }\n",
         "cube 'a' has no entry 'size'"),
        (head ~ node ~ "cube \"a\" { shadows: true; }\n",
         "cube 'a' has no entry 'shadows'"),
        (head ~ node ~ "light \"a\" { roughness: 1; }\n",
         "light 'a' has no entry 'roughness'"),
        (head ~ node ~ "cube \"a\" { position: 1 2; }\n",
         "position must be three numbers"),
        (head ~ node ~ "cube \"a\" { position: 1 2 x; }\n",
         "position must be a number, found 'x'"),
        (head ~ node ~ "cube \"a\" { position: 1 2 3px; }\n",
         "position must be a number, found '3px'"),
        (head ~ node ~ "cube \"a\" { scale: 1 1 1; scale: 2 2 2; }\n",
         "entry 'scale' given twice"),
        (head ~ node ~ "light \"a\" { light: sun; }\n",
         "light must be direction, point or spot"),
        (head ~ node ~ "light \"a\" { shadows: 1; }\n",
         "shadows must be true or false"),
        (head ~ node ~ "marker \"a\" { purpose: flying; }\n",
         "purpose must be generic, spawn, waypoint or socket"),
        (head ~ node ~ "marker \"a\" { tags: player; }\n",
         "tags must be strings, none of them empty"),
        (head ~ node ~ "marker \"a\" { radius: 1; }\n",
         "marker 'a' has no entry 'radius'"),
        (head ~ node ~ "path \"a\" { curve: spline; }\n",
         "curve must be catmull-rom or bezier"),
        (head ~ node ~ "path-point \"a\" { closed: true; }\n",
         "path-point 'a' has no entry 'closed'"),
        (head ~ node ~ "volume \"a\" { shape: cone; }\n",
         "shape must be box, sphere or capsule"),
        (head ~ node ~ "volume \"a\" { size: 1 2; }\n",
         "size must be three numbers"),
        (head ~ node ~ "model \"a\" {}\n",
         "model 'a' without a file"),
        (head ~ node ~ "model \"a\" { file: \"res:/a.glb\"; }\n",
         "file must be an asset, @<key>"),
        (head ~ node ~ "model \"a\" { file: @a; }\n",
         "names the asset 'a', not declared"),
        (head ~ "asset a model \"x.glb\";\nasset a model \"y.glb\";\n",
         "asset 'a' declared twice"),
        (head ~ node ~ "cube \"a\" {}\n" ~ node ~ "cube \"b\" {}\n",
         "scene:3:1: id #" ~ SUN ~ " given to two nodes"),
        (head ~ node ~ "cube \"a\" { parent: #" ~ TABLE ~ "; }\n",
         "cube 'a' is under #" ~ TABLE ~ ", no node of the file"),
        (head ~ node ~ "empty \"a\" { parent: #" ~ SUN ~ "; }\n",
         "empty 'a' is under itself"),
        (head ~ node ~ "cube \"a\" {\n",
         "scene:3:1: expected an entry of the node or '}'")
    ];

    let mut wrong = 0us;
    for c in cases if !holds(errorOf(c._0), c._1) {
        println("expected '", c._1, "', got '", errorOf(c._0), "'");
        wrong += 1us;
    }

    assert (wrong == 0us);
}

__test the_errors_of_a_scene_file_name_it {
    assert (holds(errorOf("scene 3;\n", file-> "res:/scenes/hall.scene"), "res:/scenes/hall.scene:1:7: version '3'"));
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          BUILD          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_scene_is_built_under_a_node {
    {
        let dmut root = copy Root();
        let s = copy SceneDescription(copy [NodeDescription("lamp", NodeKind::LIGHT), NodeDescription("box", NodeKind::EMPTY)]);
        let dmut built = alias s.build(alias root);

        assert (built.len == 2us);
        assert (root:.find(Path("lamp")).hasValue && root:.find(Path("box")).hasValue);
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_built_take_the_id_the_transform_and_the_light_of_their_description {
    {
        let dmut root = copy Root();
        let content = "scene 1;\n"
            ~ "node #" ~ TABLE ~ " empty \"room\" { position: 0 1 0; }\n"
            ~ "node #" ~ SUN ~ " light \"spot\" {\n"
            ~ "    parent: #" ~ TABLE ~ ";\n"
            ~ "    light: spot;\n"
            ~ "    inner-angle: 10;\n"
            ~ "    outer-angle: 15;\n"
            ~ "    position: 2 0 0;\n"
            ~ "}\n";
        SceneDescription(content).build(alias root);

        let dmut room = alias root:.find(Path("room"));
        if let Ok(dmut s: &Light) = alias root:.find(Path("room/spot")) {
            assert (s.type == LightType::SPOT && near(s.innerAngle, 10.0f) && near(s.outerAngle, 15.0f));
            assert (near(s.position.x, 2.0f) && s.guid.opCmp(id(SUN)) == 0);
        } else {
            assert (false);
        }

        if let Ok(g: &Empty3D) = room {
            assert (near(g.position.y, 1.0f) && g.guid.opCmp(id(TABLE)) == 0);
        } else {
            assert (false);
        }
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_built_take_the_marks_the_curves_and_the_shapes_of_their_description {
    {
        let dmut root = copy Root();
        SceneDescription("scene 1;\n" ~ markedNodes()).build(alias root);

        if let Ok(m: &Marker3D) = root:.find(Path("spawn")) {
            assert (m.purpose == MarkerPurpose::SPAWN && m.tags == ["player", "start"]);
        } else {
            assert (false);
        }

        if let Ok(p: &Path3D) = root:.find(Path("route")) {
            let points = p.points();
            assert (p.curveKind == CurveKind::BEZIER && p.closed && points.len == 2us);
            assert (points[0].name.file() == "point" && near(points[1].scale.x, 1.5f));
        } else {
            assert (false);
        }

        if let Ok(v: &Volume3D) = root:.find(Path("trigger")) {
            let shape = v.shape;
            assert (shape.kind == VolumeKind::CAPSULE && near(shape.radius, 0.75f) && near(shape.height, 3.0f));
        } else {
            assert (false);
        }

        if let Ok(v: &Volume3D) = root:.find(Path("zone")) {
            assert (v.shape.kind == VolumeKind::BOX && v.shape.size == makeVec3(4.0f, 2.0f, 1.0f));
        } else {
            assert (false);
        }
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_markers_the_paths_and_the_volumes_of_a_scene_are_described_as_they_were_built {
    {
        let dmut root = copy Root();
        SceneDescription("scene 1;\n" ~ markedNodes()).build(alias root);
        let back = SceneDescription(alias root);
        assert (sameNodes(back.nodes, SceneDescription("scene 1;\n" ~ markedNodes()).nodes));
    } catch {
        err => { println(err); assert (false); }
    }
}

__test a_node_of_a_nil_id_keeps_the_id_it_is_created_with {
    {
        let dmut root = copy Root();
        let dmut a = alias NodeDescription("a", NodeKind::EMPTY).build(alias root);
        let dmut b = alias NodeDescription("b", NodeKind::EMPTY).build(alias root);
        assert (!a.guid.isNil() && !b.guid.isNil() && a.guid.opCmp(b.guid) != 0);
    } catch {
        _ => { assert (false); }
    }
}

__test a_primitive_is_built_as_a_mesh_of_its_material_and_its_shape {
    {
        let dmut root = copy Root();
        let mut d = NodeDescription("ball", NodeKind::SPHERE);
        d.material.roughness = 0.3f;
        d.scale = makeVec3(2.0f, 2.0f, 2.0f);

        let dmut ball = alias d.build(alias root);
        assert (ball.name.file() == "ball" && near(ball.scale.y, 2.0f));
        if let dmut mesh: &IndexedMesh3D = alias ball {
            assert (mesh.mesh.primitive == Primitive::SPHERE && near(mesh.material.config.roughness, 0.3f));
        } else {
            assert (false);
        }
    } catch {
        _ => { assert (false); }
    }
}

__test a_description_without_ids_builds_nodes_of_new_ids {
    {
        let dmut root = copy Root();
        let content = "scene 1;\nnode #" ~ TABLE ~ " empty \"table\" {}\n";
        SceneDescription(content).withoutIds().build(alias root);
        if let Ok(t: &Empty3D) = root:.find(Path("table")) {
            assert (!t.guid.isNil() && t.guid.opCmp(id(TABLE)) != 0);
        } else {
            assert (false);
        }
    } catch {
        _ => { assert (false); }
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          WRITE          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_scene_written_then_read_back_is_the_same_for_every_kind_of_node {
    {
        for content in [table(), everyKind()] {
            let read = SceneDescription(content);
            let back = SceneDescription(read.content());
            assert (sameNodes(read.nodes, back.nodes));
        }
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_writer_writes_the_entries_in_a_fixed_order_and_leaves_the_defaults_out {
    {
        let content = SceneDescription(everyKind()).content();
        if content != everyKind() { println(content); }
        assert (content == everyKind());
    } catch {
        _ => { assert (false); }
    }
}

__test the_writer_puts_the_parents_first_and_the_assets_in_the_order_of_their_paths {
    {
        let content = SceneDescription(table()).content();
        let expected = "scene 1;\n"
            ~ "\n"
            ~ "asset chair model \"res:/models/chair.glb\";\n"
            ~ "\n"
            ~ "node #" ~ SUN ~ " light \"sun\" {\n"
            ~ "    light: point;\n"
            ~ "    color: 1 0.5 0.25;\n"
            ~ "    intensity: 3;\n"
            ~ "    range: 12.5;\n"
            ~ "    shadows: true;\n"
            ~ "}\n"
            ~ "\n"
            ~ "node #" ~ TABLE ~ " empty \"table\" {\n"
            ~ "    position: 1 2 3;\n"
            ~ "    rotation: 0 90 0;\n"
            ~ "    scale: 2 2 2;\n"
            ~ "}\n"
            ~ "\n"
            ~ "node #" ~ PLATE ~ " empty \"plate\" {\n"
            ~ "    parent: #" ~ TABLE ~ ";\n"
            ~ "}\n"
            ~ "\n"
            ~ "node #" ~ CHAIR ~ " model \"chair\" {\n"
            ~ "    parent: #" ~ PLATE ~ ";\n"
            ~ "    position: -0.5 0 0;\n"
            ~ "    file: @chair;\n"
            ~ "    lods: false;\n"
            ~ "}\n"
            ~ "\n"
            ~ "node #" ~ TOP ~ " cube \"top\" {\n"
            ~ "    parent: #" ~ TABLE ~ ";\n"
            ~ "    color: 0.5 0.3 0.1;\n"
            ~ "    roughness: 0.25;\n"
            ~ "    metallic: 1;\n"
            ~ "}\n";
        if content != expected { println(content); }
        assert (content == expected);
        assert (SceneDescription(content).content() == content);
    } catch {
        _ => { assert (false); }
    }
}

__test the_writer_quotes_the_names_and_gives_ids_to_the_nodes_of_none {
    {
        let mut d = NodeDescription("say \"hi\"", NodeKind::EMPTY);
        d.children = copy [NodeDescription("under", NodeKind::CUBE)];
        let content = copy SceneDescription(copy [d]).content();

        assert (holds(content, " empty \"say \\\"hi\\\"\" {"));
        let back = SceneDescription(content).nodes;
        assert (back.len == 1us && back[0].name == "say \"hi\"" && !back[0].id.isNil());
        assert (back[0].children.len == 1us && back[0].children[0].name == "under");
    } catch {
        _ => { assert (false); }
    }
}

__test the_writer_writes_the_shortest_number_reading_back_the_same {
    {
        let mut d = NodeDescription("a", NodeKind::EMPTY);
        d.position = makeVec3(0.1f, 1.0f / 3.0f, -1024.0f);
        d.rotation = makeVec3(radian(30.0f), radian(-0.5f), radian(1.0f / 7.0f));
        d.scale = makeVec3(1.0e-7f, 123456.789f, -0.0f);

        let content = copy SceneDescription(copy [d]).content();
        assert (holds(content, "position: 0.1 0.33333334 -1024;"));
        assert (holds(content, "rotation: 30 -0.5 "));

        let back = SceneDescription(content).nodes[0];
        assert (back.position == d.position && back.rotation == d.rotation && back.scale.x == d.scale.x && back.scale.y == d.scale.y);
    } catch {
        err => { println(err); assert (false); }
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          DESCRIBE          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_nodes_of_a_scene_are_described_as_they_were_built_in_the_order_they_were_created {
    {
        let content = "scene 1;\n"
            ~ "node #" ~ SUN ~ " light \"sun\" { light: spot; intensity: 4; shadows: true; direction: 0 -1 1; }\n"
            ~ "node #" ~ TABLE ~ " empty \"zebra\" { rotation: 0 45 0; }\n"
            ~ "node #" ~ TOP ~ " cube \"b\" { parent: #" ~ TABLE ~ "; color: 0.5 0.3 0.1; roughness: 0.25; }\n"
            ~ "node #" ~ PLATE ~ " plane \"a\" { parent: #" ~ TABLE ~ "; scale: 3 1 3; }\n";
        let read = SceneDescription(content);

        let dmut root = copy Root();
        read.build(alias root);
        let described = copy SceneDescription(alias root);

        // zebra before sun would be the order of the names, a before b the one of the names under it
        assert (sameNodes(described.nodes, read.nodes));
        assert (described.content() == read.content());
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_nodes_of_a_scene_are_described_in_their_order_once_moved {
    {
        let content = "scene 1;\n"
            ~ "node #" ~ SUN ~ " light \"sun\" { }\n"
            ~ "node #" ~ TABLE ~ " empty \"table\" { }\n"
            ~ "node #" ~ TOP ~ " cube \"top\" { parent: #" ~ TABLE ~ "; }\n"
            ~ "node #" ~ PLATE ~ " plane \"plate\" { parent: #" ~ TABLE ~ "; }\n";
        let dmut root = copy Root();
        SceneDescription(content).build(alias root);

        // the table goes first, the plate before the top
        if let Ok(dmut table) = alias root:.find(Path("table")) {
            table:.moveUnder(alias root, at-> 0us);
            if let Ok(dmut plate) = alias root:.find(Path("table/plate")) {
                plate:.moveUnder(alias table, at-> 0us);
            }
        }

        let described = copy SceneDescription(alias root);
        assert (described.nodes.len == 2us);
        assert (described.nodes[0].name == "table" && described.nodes[1].name == "sun");
        assert (described.nodes[0].children.len == 2us);
        assert (described.nodes[0].children[0].name == "plate" && described.nodes[0].children[1].name == "top");
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_nodes_of_the_tools_are_left_out_of_the_description {
    {
        let dmut root = copy Root();
        NodeDescription("__camera__", NodeKind::EMPTY).build(alias root);
        NodeDescription("cube", NodeKind::CUBE).build(alias root);

        let nodes = (copy SceneDescription(alias root)).nodes;
        assert (nodes.len == 1us && nodes[0].name == "cube");
        assert (isReservedName("__gizmo__") && !isReservedName("__") && !isReservedName("_a_"));
    } catch {
        _ => { assert (false); }
    }
}

/**
 * @returns: the message of the error describing the nodes under a node throws, empty when it describes them
 * */
fn describeErrorOf(dmut root: &Node)-> [c8] {
    {
        SceneDescription(alias root);
        ""
    } catch {
        err: &BalderError => { err.msg }
    }
}

__test a_mesh_given_its_vertices_is_not_described {
    {
        let dmut root = copy Root();
        let (array, indices) = cubeMesh();
        let dmut material = copy ConstantMaterial(MaterialConfig());
        copy IndexedMesh3D("raw", alias root, LodChain(indices), array, alias material);

        assert (holds(describeErrorOf(alias root), "raw: a mesh given its vertices"));
    } catch {
        _ => { assert (false); }
    }
}

__test a_scene_saved_reads_back_from_its_file {
    {
        let dir = tempDirectory(prefix-> "balder-scene-");
        {
            let path = dir.push("table.scene").toStr();
            let s = SceneDescription(table());
            s.save(path);

            let back = SceneDescription::fromFile(path);
            assert (sameNodes(back.nodes, s.nodes));
        } exit {
            {
                removeDir(dir, recursive-> true);
            } catch {
                _ => {}
            }
        }
    } catch {
        err => { println(err); assert (false); }
    }
}
