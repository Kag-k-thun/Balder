in scene_description;

use balder::core::error;
use balder::math::{utils, vector};
use balder::scene::{_, description::_};
use balder::scene::node;
use balder::scene::node::{node3D::_, node3D::group, node3D::light};

use std::fs::path;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * @returns: true iif two numbers are within a millionth of each other
 * */
fn near(a: f32, b: f32)-> bool {
    (a - b) < 1.0e-5f && (b - a) < 1.0e-5f
}

/**
 * @returns: the message of the error reading a scene file throws, empty when it reads it
 * */
fn errorOf(content: [c8])-> [c8] {
    {
        SceneDescription(content);
        ""
    } catch {
        err: &BalderError => { err.msg }
    }
}

/**
 * @returns: true iif a text holds another one
 * */
fn holds(text: [c8], part: [c8])-> bool {
    if part.len > text.len { return false; }
    for i in 0us ... text.len - part.len {
        if text[i .. i + part.len] == part { return true; }
    }

    false
}

/**
 * @returns: a scene file of a light, and a group of a cube and of a group
 * */
fn table()-> [c8] {
    "[[node]]\n"
    ~ "name = \"sun\"\n"
    ~ "type = \"light\"\n"
    ~ "light = \"point\"\n"
    ~ "color = [1, 0.5, 0.25]\n"
    ~ "intensity = 3\n"
    ~ "range = 12.5\n"
    ~ "shadows = true\n"
    ~ "\n"
    ~ "[[node]]\n"
    ~ "name = \"table\"\n"
    ~ "type = \"group\"\n"
    ~ "position = [1, 2, 3]\n"
    ~ "rotation = [0, 90, 0]\n"
    ~ "scale = [2, 2, 2]\n"
    ~ "\n"
    ~ "[[node.children]]\n"
    ~ "name = \"top\"\n"
    ~ "type = \"cube\"\n"
    ~ "color = [0.5, 0.3, 0.1]\n"
    ~ "roughness = 0.25\n"
    ~ "metallic = 1\n"
    ~ "\n"
    ~ "[[node.children]]\n"
    ~ "name = \"plate\"\n"
    ~ "type = \"group\"\n"
}

__test a_scene_file_describes_its_nodes_in_order_with_their_children {
    {
        let nodes = SceneDescription(table()).nodes;
        assert (nodes.len == 2us);
        assert (nodes[0].name == "sun" && nodes[0].kind == NodeKind::LIGHT);
        assert (nodes[1].name == "table" && nodes[1].kind == NodeKind::GROUP);

        let children = nodes[1].children;
        assert (children.len == 2us && children[0].name == "top" && children[1].name == "plate");
        assert (children[0].kind == NodeKind::CUBE);
    } catch {
        _ => { assert (false); }
    }
}

__test the_entries_of_a_node_are_read_the_rotation_in_degrees {
    {
        let nodes = SceneDescription(table()).nodes;
        let sun = nodes[0], table = nodes[1], top = nodes[1].children[0];

        assert (sun.light == LightType::POINT && sun.shadows && near(sun.intensity, 3.0f) && near(sun.range, 12.5f));
        assert (near(sun.color.y, 0.5f));

        assert (near(table.position.z, 3.0f) && near(table.scale.x, 2.0f));
        assert (near(table.rotation.y, radian(90.0f)) && near(table.rotation.x, 0.0f));

        assert (near(top.material.baseColor.x, 0.5f) && near(top.material.roughness, 0.25f));
        assert (near(top.material.metallic, 1.0f));
    } catch {
        _ => { assert (false); }
    }
}

__test a_scene_is_built_under_a_node {
    {
        let dmut root = copy Root();
        let dmut s = copy SceneDescription(copy [NodeDescription("lamp", NodeKind::LIGHT), NodeDescription("box", NodeKind::GROUP)]);
        let dmut built = alias s.build(alias root);

        assert (built.len == 2us);
        assert (root:.find(Path("lamp")).hasValue && root:.find(Path("box")).hasValue);
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_built_take_the_transform_and_the_light_of_their_description {
    {
        let dmut root = copy Root();
        let content = "[[node]]\n"
            ~ "name = \"room\"\n"
            ~ "type = \"group\"\n"
            ~ "position = [0, 1, 0]\n"
            ~ "\n"
            ~ "[[node.children]]\n"
            ~ "name = \"spot\"\n"
            ~ "type = \"light\"\n"
            ~ "light = \"spot\"\n"
            ~ "inner-angle = 10\n"
            ~ "outer-angle = 15\n"
            ~ "position = [2, 0, 0]\n";
        SceneDescription(content).build(alias root);

        let dmut room = alias root:.find(Path("room"));
        assert (room.hasValue);
        if let Ok(dmut s: &Light) = alias root:.find(Path("room/spot")) {
            assert (s.type == LightType::SPOT && near(s.innerAngle, 10.0f) && near(s.outerAngle, 15.0f));
            assert (near(s.position.x, 2.0f));
        } else {
            assert (false);
        }

        if let Ok(g: &Group3D) = room {
            assert (near(g.position.y, 1.0f));
        } else {
            assert (false);
        }
    } catch {
        _ => { assert (false); }
    }
}

__test a_primitive_is_built_as_a_mesh_of_its_material {
    {
        let dmut root = copy Root();
        let mut d = NodeDescription("ball", NodeKind::SPHERE);
        d.material.roughness = 0.3f;
        d.scale = makeVec3(2.0f, 2.0f, 2.0f);

        let dmut ball = alias d.build(alias root);
        assert (ball.name.file() == "ball" && near(ball.scale.y, 2.0f));
    } catch {
        _ => { assert (false); }
    }
}

__test a_scene_file_without_nodes_describes_an_empty_scene {
    {
        assert (SceneDescription("").nodes.len == 0us);
    } catch {
        _ => { assert (false); }
    }
}

__test the_errors_of_a_scene_file_name_the_node_and_the_entry {
    assert (holds(errorOf("[[node]]\ntype = \"cube\"\n"), "must have a name"));
    assert (holds(errorOf("[[node]]\nname = \"a\"\n"), "'a' must have a type"));
    assert (holds(errorOf("[[node]]\nname = \"a\"\ntype = \"cone\"\n"), "has the type 'cone'"));
    assert (holds(errorOf("[[node]]\nname = \"a\"\ntype = \"cube\"\nsize = 2\n"), "unexpected entry size"));
    assert (holds(errorOf("[[node]]\nname = \"a\"\ntype = \"cube\"\nposition = [1, 2]\n"), "position must be an array of three numbers"));
    assert (holds(errorOf("[[node]]\nname = \"a\"\ntype = \"model\"\n"), "a model without a file"));
    assert (holds(errorOf("[[node]]\nname = \"a/b\"\ntype = \"cube\"\n"), "holding a '/'"));
    assert (holds(errorOf("[camera]\nfov = 60\n"), "unexpected entry camera"));
    assert (holds(errorOf("[[node]\n"), "scene: "));
}
