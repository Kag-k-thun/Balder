in bvh;

use balder::math::{bounds, utils, vector};

use std::math;
use std::algorithm::sorting;

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3)-> bool {
    (a - b).length() < 0.0001f
}

/**
 * @returns: the box of side 2 centered on a point
 * */
fn cube(center: vec3)-> Aabb {
    Aabb(center - 1.0f, center + 1.0f)
}

/**
 * @returns: the view of a camera at the origin looking down -z, with a vertical field of view of 90°, a square aspect,
 * seeing from 1 to 20 units in front of it, on 100 pixels of height
 * */
fn perspectiveView()-> ViewVolume {
    let proj = perspective!{f32}(radian(90.0f), 1.0f, 1.0f, 20.0f);
    let view = lookAt!{f32}(vec3(), makeVec3(0.0f, 0.0f, -1.0f), makeVec3(0.0f, 1.0f, 0.0f));

    ViewVolume(proj * view, 100.0f)
}

/**
 * @returns: a pseudo random number in [-range, range), the state moved to the next one
 * */
fn next(ref mut state: u64, range: f32)-> f32 {
    state = (state * 1103515245u64 + 12345u64) % 2147483648u64;
    let unit = cast!f32((state >> 15u64) & 0xffffu64) / 65536.0f;

    (unit * 2.0f - 1.0f) * range
}

/**
 * @returns: n boxes of sides from 0.1 to 2 scattered around the origin, in [-range, range) along each axis
 * */
fn scatter(n: usize, range: f32, seed: u64)-> [Aabb] {
    let mut state = seed;
    let dmut boxes = copy [Aabb(); n];
    for i in 0us .. n {
        let c = makeVec3(next(ref state, range), next(ref state, range), next(ref state, range));
        let h = 0.55f + next(ref state, 0.45f);
        boxes[i] = Aabb(c - h, c + h);
    }

    boxes
}

/**
 * @returns: a hierarchy of boxes, the id of each box being its index
 * */
fn hierarchy(boxes: [Aabb])-> dmut &Bvh {
    let dmut bvh = copy Bvh();
    for i, b in boxes {
        bvh:.insert(i, b);
    }

    alias bvh
}

/**
 * @returns: the indexes of the boxes intersecting the frustum of a view, tested one by one, sorted
 * */
fn bruteForce(boxes: [Aabb], view: ViewVolume)-> [usize] {
    let mut res: [usize] = [];
    for i, b in boxes {
        if view.frustum.intersects(b) {
            res = res ~ [i];
        }
    }

    res
}

/**
 * @returns: true iif the id 'id' is among 'ids'
 * */
fn has(ids: [usize], id: usize)-> bool {
    for i in ids {
        if i == id { return true; }
    }

    false
}

/**
 * @returns: the ids a culling found, sorted
 * */
fn sorted(ids: [usize])-> [usize] {
    let dmut res = copy ids;
    (alias res).sort()
}

/**
 * @returns: the distance at which a ray enters the first of the boxes it enters, tested one by one, f32::max when it
 * misses them all
 * */
fn closestEntry(boxes: [Aabb], ray: Ray)-> f32 {
    let mut best = f32::max;
    for b in boxes {
        if let Ok(d) = b.intersect(ray) {
            if d < best { best = d; }
        }
    }

    best
}

/**
 * @returns: the id of the box a ray enters first in a hierarchy, none when it misses them all
 * */
fn hitId(bvh: &Bvh, ray: Ray)-> (usize)? {
    if let Ok(hit) = bvh.raycast(ray) { (hit.id)? } else { none }
}

/**
 * @returns: the distance at which a ray enters a box, -1 when it misses it
 * */
fn entry(box: Aabb, ray: Ray)-> f32 {
    if let Ok(d) = box.intersect(ray) { d } else { -1.0f }
}

__test an_empty_hierarchy_holds_nothing_and_sees_nothing {
    let bvh = copy Bvh();
    let (ids, stats) = bvh.cull(ViewVolume(), 0.0f);

    assert (bvh.len == 0us);
    assert (bvh.bounds.isEmpty);
    assert (ids.len == 0us);
    assert (stats.considered == 0us && stats.visited == 0us);
}

__test the_bounds_of_a_hierarchy_enclose_its_boxes {
    let dmut bvh = copy Bvh();
    bvh:.insert(1us, cube(makeVec3(-4.0f, 0.0f, 0.0f)));
    bvh:.insert(2us, cube(makeVec3(4.0f, 2.0f, 0.0f)));
    bvh:.insert(3us, cube(makeVec3(0.0f, 0.0f, 7.0f)));

    assert (bvh.len == 3us);
    assert (bvh.contains(2us) && !bvh.contains(4us));
    assert (near(bvh.getBox(2us).center, makeVec3(4.0f, 2.0f, 0.0f)));
    assert (near(bvh.bounds.min, makeVec3(-5.0f, -1.0f, -1.0f)));
    assert (near(bvh.bounds.max, makeVec3(5.0f, 3.0f, 8.0f)));
}

__test inserting_an_id_again_replaces_its_box {
    let dmut bvh = copy Bvh();
    bvh:.insert(1us, cube(makeVec3(-4.0f, 0.0f, 0.0f)));
    bvh:.insert(2us, cube(vec3()));
    bvh:.insert(1us, cube(makeVec3(3.0f, 0.0f, 0.0f)));

    assert (bvh.len == 2us);
    assert (near(bvh.bounds.min, makeVec3(-1.0f, -1.0f, -1.0f)));
    assert (near(bvh.bounds.max, makeVec3(4.0f, 1.0f, 1.0f)));
}

__test a_removed_box_leaves_the_hierarchy_and_its_bounds {
    let dmut bvh = copy Bvh();
    bvh:.insert(1us, cube(makeVec3(-4.0f, 0.0f, 0.0f)));
    bvh:.insert(2us, cube(vec3()));
    bvh:.insert(3us, cube(makeVec3(4.0f, 0.0f, 0.0f)));

    bvh:.remove(3us);
    bvh:.remove(42us);

    assert (bvh.len == 2us);
    assert (!bvh.contains(3us));
    assert (bvh.getBox(3us).isEmpty);
    assert (near(bvh.bounds.max, makeVec3(1.0f, 1.0f, 1.0f)));

    bvh:.remove(1us);
    bvh:.remove(2us);
    assert (bvh.len == 0us && bvh.bounds.isEmpty && bvh.cost == 0.0f);
}

__test a_moved_box_refits_the_bounds {
    let dmut bvh = copy Bvh();
    for i in 0us .. 8us {
        bvh:.insert(i, cube(makeVec3(cast!f32(cast!u64(i)) * 3.0f, 0.0f, 0.0f)));
    }

    bvh:.update(7us, cube(makeVec3(0.0f, 10.0f, 0.0f)));
    assert (near(bvh.bounds.min, makeVec3(-1.0f, -1.0f, -1.0f)));
    assert (near(bvh.bounds.max, makeVec3(19.0f, 11.0f, 1.0f)));

    bvh:.update(99us, cube(makeVec3(100.0f, 0.0f, 0.0f)));
    assert (bvh.len == 8us && near(bvh.bounds.max, makeVec3(19.0f, 11.0f, 1.0f)));
}

__test the_default_view_sees_every_box_but_the_empty_ones {
    let dmut bvh = hierarchy(scatter(50us, 30.0f, 7u64));
    bvh:.insert(100us, Aabb());

    let (ids, stats) = bvh.cull(ViewVolume(), 1.0f);
    assert (ids.len == 50us);
    assert (!has(ids, 100us));
    assert (stats.considered == 51us && stats.visible == 50us && stats.outside == 1us);
}

__test the_culling_sees_the_boxes_intersecting_the_frustum {
    let boxes = scatter(500us, 40.0f, 1u64);
    let bvh = hierarchy(boxes);
    let view = perspectiveView();

    let (ids, stats) = bvh.cull(view, 0.0f);
    let expected = bruteForce(boxes, view);

    assert (expected.len != 0us && expected.len < boxes.len);
    assert (sorted(ids) == expected);
    assert (stats.considered == 500us && stats.visible == expected.len && stats.small == 0us);
    assert (stats.outside + stats.visible == stats.considered);
}

__test the_culling_rejects_whole_branches_outside_the_frustum {
    // a crowd far behind the camera, a few boxes in front of it
    let dmut bvh = copy Bvh();
    let behind = scatter(1000us, 20.0f, 3u64);
    for i, b in behind {
        bvh:.insert(i, b.transformed(translation(makeVec3(0.0f, 0.0f, 100.0f))));
    }

    for i in 0us .. 4us {
        bvh:.insert(1000us + i, cube(makeVec3(cast!f32(cast!u64(i)) * 2.0f - 3.0f, 0.0f, -10.0f)));
    }

    let (ids, stats) = bvh.cull(perspectiveView(), 0.0f);
    assert (sorted(ids) == [1000us, 1001us, 1002us, 1003us]);
    assert (stats.outside == 1000us);
    assert (stats.visited < 100us);
}

__test the_culling_rejects_the_boxes_too_small_on_screen {
    let dmut bvh = copy Bvh();
    bvh:.insert(1us, cube(makeVec3(0.0f, 0.0f, -5.0f)));
    bvh:.insert(2us, Aabb(makeVec3(-0.01f, -0.01f, -15.01f), makeVec3(0.01f, 0.01f, -14.99f)));
    bvh:.insert(3us, cube(makeVec3(0.0f, 0.0f, 50.0f)));

    let (all, _) = bvh.cull(perspectiveView(), 0.0f);
    assert (sorted(all) == [1us, 2us]);

    let (ids, stats) = bvh.cull(perspectiveView(), 1.0f);
    assert (ids == [1us]);
    assert (stats.small == 1us && stats.outside == 1us && stats.visible == 1us);
}

__test the_refits_degrade_the_hierarchy_until_it_is_rebuilt {
    // boxes inserted in a line along x, then scattered in the whole space
    let dmut bvh = copy Bvh();
    for i in 0us .. 200us {
        bvh:.insert(i, cube(makeVec3(cast!f32(cast!u64(i)) * 2.0f, 0.0f, 0.0f)));
    }

    assert (!bvh.isDegraded);

    let boxes = scatter(200us, 40.0f, 11u64);
    for i, b in boxes {
        bvh:.update(i, b);
    }

    assert (bvh.isDegraded);
    let degraded = bvh.cost;

    bvh:.rebuild();
    assert (!bvh.isDegraded);
    assert (bvh.cost < degraded);
    assert (bvh.len == 200us);

    let view = perspectiveView();
    let (ids, _) = bvh.cull(view, 0.0f);
    assert (sorted(ids) == bruteForce(boxes, view));
}

__test the_hierarchy_stays_consistent_through_insertions_and_removals {
    let boxes = scatter(300us, 30.0f, 5u64);
    let dmut bvh = hierarchy(boxes);
    for i in 0us .. 300us {
        if i % 2us == 0us { bvh:.remove(i); }
    }

    // the nodes freed are taken again
    for i in 0us .. 300us {
        if i % 4us == 0us { bvh:.insert(i, boxes[i]); }
    }

    let mut expected: [usize] = [];
    for i in 0us .. 300us {
        if i % 2us == 1us || i % 4us == 0us { expected = expected ~ [i]; }
    }

    let (ids, _) = bvh.cull(ViewVolume(), 0.0f);
    assert (bvh.len == expected.len);
    assert (sorted(ids) == expected);

    let view = perspectiveView();
    let (seen, _) = bvh.cull(view, 0.0f);
    let mut inView: [usize] = [];
    for i in bruteForce(boxes, view) {
        if i % 2us == 1us || i % 4us == 0us { inView = inView ~ [i]; }
    }

    assert (sorted(seen) == inView);
}

__test a_ray_hits_nothing_in_an_empty_hierarchy {
    let bvh = copy Bvh();
    assert (!bvh.raycast(Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f))).hasValue);
}

__test a_ray_hits_the_closest_box_in_front_of_it {
    let dmut bvh = copy Bvh();
    bvh:.insert(3us, cube(makeVec3(0.0f, 0.0f, -15.0f)));
    bvh:.insert(2us, cube(makeVec3(0.0f, 0.0f, -10.0f)));
    bvh:.insert(1us, cube(makeVec3(0.0f, 0.0f, -5.0f)));
    bvh:.insert(4us, cube(makeVec3(0.0f, 0.0f, 5.0f)));
    bvh:.insert(5us, cube(makeVec3(4.0f, 0.0f, -2.0f)));

    let ray = Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f));
    if let Ok(hit) = bvh.raycast(ray) {
        assert (hit.id == 1us);
        assert (hit.distance > 3.999f && hit.distance < 4.001f);
    } else {
        assert (false);
    }

    assert (!bvh.raycast(Ray(makeVec3(0.0f, 5.0f, 0.0f), makeVec3(0.0f, 0.0f, -1.0f))).hasValue);
    assert (!bvh.raycast(Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f), length-> 3.0f)).hasValue);
}

__test a_ray_follows_the_boxes_removed_and_moved {
    let dmut bvh = copy Bvh();
    for i in 0us .. 6us {
        bvh:.insert(i, cube(makeVec3(0.0f, 0.0f, -5.0f - 5.0f * cast!f32(cast!u64(i)))));
    }

    let ray = Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f));
    assert (hitId(bvh, ray) == (0us)?);

    bvh:.remove(0us);
    assert (hitId(bvh, ray) == (1us)?);

    bvh:.update(5us, cube(makeVec3(0.0f, 0.0f, -2.0f)));
    assert (hitId(bvh, ray) == (5us)?);

    bvh:.rebuild();
    assert (hitId(bvh, ray) == (5us)?);
}

__test a_ray_hits_the_box_it_enters_first_among_many {
    let boxes = scatter(400us, 30.0f, 11u64);
    let bvh = hierarchy(boxes);

    let mut state = 17u64;
    let mut hits = 0us;
    for i in 0us .. 200us {
        // every other ray aims at the center of a box, the others at a point among the boxes
        let origin = makeVec3(next(ref state, 60.0f), next(ref state, 60.0f), next(ref state, 60.0f));
        let random = makeVec3(next(ref state, 20.0f), next(ref state, 20.0f), next(ref state, 20.0f));
        let target = if i % 2us == 0us { boxes[i].center } else { random };
        let ray = Ray(origin, target - origin);

        let expected = closestEntry(boxes, ray);
        if let Ok(hit) = bvh.raycast(ray) {
            hits += 1us;
            assert (math::abs(hit.distance - expected) < 0.0001f);
            assert (math::abs(entry(boxes[hit.id], ray) - expected) < 0.0001f);
        } else {
            assert (expected == f32::max);
        }
    }

    assert (hits >= 100us);
}

__test a_hierarchy_built_over_boxes_holds_each_box_at_its_index {
    let boxes = scatter(300us, 30.0f, 23u64);
    let bvh = copy Bvh(boxes);

    assert (bvh.len == boxes.len);
    for i, b in boxes {
        assert (bvh.contains(i));
        assert (near(bvh.getBox(i).min, b.min) && near(bvh.getBox(i).max, b.max));
    }

    let inserted = hierarchy(boxes);
    let mut state = 29u64;
    for _ in 0us .. 100us {
        let origin = makeVec3(next(ref state, 60.0f), next(ref state, 60.0f), next(ref state, 60.0f));
        let target = makeVec3(next(ref state, 20.0f), next(ref state, 20.0f), next(ref state, 20.0f));
        let ray = Ray(origin, target - origin);

        let built = if let Ok(hit) = bvh.raycast(ray) { hit.distance } else { f32::max };
        let expected = if let Ok(hit) = inserted.raycast(ray) { hit.distance } else { f32::max };
        assert (built == expected || math::abs(built - expected) < 0.0001f);
    }
}

__test a_hierarchy_built_over_no_box_is_empty {
    let boxes: [Aabb] = [];
    let bvh = copy Bvh(boxes);

    assert (bvh.len == 0us && bvh.bounds.isEmpty);
    assert (!bvh.raycast(Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f))).hasValue);
}

__test a_ray_hits_the_leaf_whose_content_it_hits_first {
    let dmut bvh = copy Bvh();
    bvh:.insert(0us, Aabb(makeVec3(-5.0f, -5.0f, -8.0f), makeVec3(5.0f, 5.0f, -2.0f)));
    bvh:.insert(1us, cube(makeVec3(0.0f, 0.0f, -5.0f)));
    bvh:.insert(2us, cube(makeVec3(0.0f, 0.0f, -12.0f)));

    let ray = Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f));

    // the box entered first encloses nothing the ray hits
    if let Ok(hit) = bvh.raycast(ray, |id: usize, entry: f32| { if id == 0us { f32::max } else { entry + 0.5f } }) {
        assert (hit.id == 1us);
        assert (math::abs(hit.distance - 4.5f) < 0.001f);
    } else {
        assert (false);
    }

    // the content of a box entered before another is hit past the content of the other
    if let Ok(hit) = bvh.raycast(ray, |id: usize, entry: f32| { if id == 0us { f32::max } else if id == 1us { 15.0f } else { entry } }) {
        assert (hit.id == 2us);
        assert (math::abs(hit.distance - 11.0f) < 0.001f);
    } else {
        assert (false);
    }

    assert (!bvh.raycast(ray, |_: usize, _: f32| { f32::max }).hasValue);
}

__test the_leaves_entered_past_the_closest_hit_are_not_tested {
    let dmut bvh = copy Bvh();
    for i in 0us .. 8us {
        bvh:.insert(i, cube(makeVec3(0.0f, 0.0f, -5.0f - 5.0f * cast!f32(cast!u64(i)))));
    }

    let dmut tested = copy [0us];
    let ray = Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f));
    let hit = bvh.raycast(ray, copy |_: usize, entry: f32| {
        tested[0] += 1us;
        entry
    });

    assert (hit.hasValue);
    assert (tested[0] == 1us);
}
