in grapheme;

use balder::interface::font::grapheme;

__test empty_text {
    assert (boundaries("") == [0us]);
    assert (nextBoundary("", 0us) == 0us);
    assert (previousBoundary("", 0us) == 0us);
}

__test one_grapheme_per_letter {
    assert (boundaries("abc") == [0us, 1us, 2us, 3us]);
}

/**
 * (text, its grapheme boundaries)
 * */
@parameters ((yield c for c in [("e\u{0x301}x", copy [0us, 3us, 4us]),                                   // combining acute accent
                                ("a\u{0x301}\u{0x328}", copy [0us, 5us]),                                // two marks on one base
                                ("\u{0x1F600}a", copy [0us, 4us, 5us]),                                  // four bytes code point
                                ("a\r\nb", copy [0us, 1us, 3us, 4us]),                                   // CR LF
                                ("\u{0x1F1EB}\u{0x1F1F7}\u{0x1F1E9}\u{0x1F1EA}", copy [0us, 8us, 16us]), // two flags
                                ("\u{0x1F1EB}\u{0x1F1F7}\u{0x1F1E9}", copy [0us, 8us, 12us]),            // a flag and a lone indicator
                                ("\u{0x1F469}\u{0x200D}\u{0x1F4BB}", copy [0us, 11us]),                  // emoji ZWJ sequence
                                ("\u{0x1F44D}\u{0x1F3FD}", copy [0us, 8us]),                             // emoji modifier
                                ("\u{0x2764}\u{0xFE0F}x", copy [0us, 6us, 7us]),                         // variation selector
                                ("\u{0x1100}\u{0x1161}\u{0x11A8}\u{0x1100}", copy [0us, 9us, 12us]),     // Hangul jamos
                                ("\u{0xAC00}\u{0x11A8}\u{0xAC01}\u{0x1161}", copy [0us, 6us, 9us, 12us]), // LV T, then LVT V
                                ("a\u{0x200D}b", copy [0us, 4us, 5us]),                                  // ZWJ not after an emoji
                                ("\u{0x301}a", copy [0us, 2us, 3us])]))                                  // mark without a base
__test boundaries_of (text: [c8], expected: [usize]) {
    assert (boundaries(text) == expected);
}

__test steps_over_graphemes {
    let text = "ae\u{0x301}\u{0x1F600}b";
    assert (nextBoundary(text, 0us) == 1us);
    assert (nextBoundary(text, 1us) == 4us);
    assert (nextBoundary(text, 4us) == 8us);
    assert (nextBoundary(text, 8us) == 9us);
    assert (nextBoundary(text, 9us) == 9us);

    assert (previousBoundary(text, 9us) == 8us);
    assert (previousBoundary(text, 8us) == 4us);
    assert (previousBoundary(text, 4us) == 1us);
    assert (previousBoundary(text, 1us) == 0us);
    assert (previousBoundary(text, 0us) == 0us);
}

__test aligns_inside_graphemes_forward {
    let text = "e\u{0x301}\u{0x1F600}";
    assert (alignBoundary(text, 0us) == 0us);
    assert (alignBoundary(text, 1us) == 3us);
    assert (alignBoundary(text, 4us) == 7us);
    assert (alignBoundary(text, 7us) == 7us);
    assert (alignBoundary(text, 20us) == 7us);
}

/**
 * (text, the code point at its byte 0, the number of bytes it takes)
 * */
@parameters ((yield c for c in [("a", 0x61u32, 1us),
                                ("\u{0xE9}", 0xE9u32, 2us),
                                ("\u{0x20AC}", 0x20ACu32, 3us),
                                ("\u{0x1F600}", 0x1F600u32, 4us)]))
__test decodes_code_points (text: [c8], cp: u32, size: usize) {
    assert (codePointAt(text, 0us) == (cp, size));
}

__test invalid_byte_is_a_grapheme_of_its_own {
    let text = "a" ~ [cast!c8(0xFFu8)] ~ "b";
    assert (codePointAt(text, 1us) == (0xFFFDu32, 1us));
    assert (boundaries(text) == [0us, 1us, 2us, 3us]);

    // a lead byte cut from its continuation bytes
    let cut = "\u{0xE9}"[0us .. 1us];
    assert (boundaries(cut) == [0us, 1us]);
}
