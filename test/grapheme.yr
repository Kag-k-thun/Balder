in grapheme;

use balder::interface::font::grapheme;

use std::conv;

fn utf16(text: [c8])-> [c16] {
    text.to![c16]()
}

__test empty_text {
    assert (boundaries(utf16("")) == [0us]);
    assert (nextBoundary(utf16(""), 0us) == 0us);
    assert (previousBoundary(utf16(""), 0us) == 0us);
}

__test one_grapheme_per_letter {
    assert (boundaries(utf16("abc")) == [0us, 1us, 2us, 3us]);
}

/**
 * (text, its grapheme boundaries)
 * */
@parameters ((yield c for c in [("e\u{0x301}x", copy [0us, 2us, 3us]),                                   // combining acute accent
                                ("a\u{0x301}\u{0x328}", copy [0us, 3us]),                                // two marks on one base
                                ("\u{0x1F600}a", copy [0us, 2us, 3us]),                                  // surrogate pair
                                ("a\r\nb", copy [0us, 1us, 3us, 4us]),                                   // CR LF
                                ("\u{0x1F1EB}\u{0x1F1F7}\u{0x1F1E9}\u{0x1F1EA}", copy [0us, 4us, 8us]),  // two flags
                                ("\u{0x1F1EB}\u{0x1F1F7}\u{0x1F1E9}", copy [0us, 4us, 6us]),             // a flag and a lone indicator
                                ("\u{0x1F469}\u{0x200D}\u{0x1F4BB}", copy [0us, 5us]),                   // emoji ZWJ sequence
                                ("\u{0x1F44D}\u{0x1F3FD}", copy [0us, 4us]),                             // emoji modifier
                                ("\u{0x2764}\u{0xFE0F}x", copy [0us, 2us, 3us]),                         // variation selector
                                ("\u{0x1100}\u{0x1161}\u{0x11A8}\u{0x1100}", copy [0us, 3us, 4us]),      // Hangul jamos
                                ("\u{0xAC00}\u{0x11A8}\u{0xAC01}\u{0x1161}", copy [0us, 2us, 3us, 4us]), // LV T, then LVT V
                                ("a\u{0x200D}b", copy [0us, 2us, 3us]),                                  // ZWJ not after an emoji
                                ("\u{0x301}a", copy [0us, 1us, 2us])]))                                  // mark without a base
__test boundaries_of (text: [c8], expected: [usize]) {
    assert (boundaries(utf16(text)) == expected);
}

__test steps_over_graphemes {
    let text = utf16("ae\u{0x301}\u{0x1F600}b");
    assert (nextBoundary(text, 0us) == 1us);
    assert (nextBoundary(text, 1us) == 3us);
    assert (nextBoundary(text, 3us) == 5us);
    assert (nextBoundary(text, 5us) == 6us);
    assert (nextBoundary(text, 6us) == 6us);

    assert (previousBoundary(text, 6us) == 5us);
    assert (previousBoundary(text, 5us) == 3us);
    assert (previousBoundary(text, 3us) == 1us);
    assert (previousBoundary(text, 1us) == 0us);
    assert (previousBoundary(text, 0us) == 0us);
}

__test aligns_inside_graphemes_forward {
    let text = utf16("e\u{0x301}\u{0x1F600}");
    assert (alignBoundary(text, 0us) == 0us);
    assert (alignBoundary(text, 1us) == 2us);
    assert (alignBoundary(text, 3us) == 4us);
    assert (alignBoundary(text, 4us) == 4us);
    assert (alignBoundary(text, 10us) == 4us);
}
