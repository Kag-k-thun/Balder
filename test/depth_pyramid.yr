in depth_pyramid;

use balder::scene::utils::pyramid::layout;

__test a_pyramid_ends_with_a_single_texel {
    assert (levelCount(1u32, 1u32) == 1u32);
    assert (levelCount(2u32, 2u32) == 1u32);
    assert (levelCount(3u32, 2u32) == 2u32);

    // 960x540 ... 2x2, 1x1
    assert (levelCount(1920u32, 1080u32) == 11u32);

    let last = levelCount(1920u32, 1080u32);
    assert (levelWidth(1920u32, last) == 1u32 && levelHeight(1080u32, last) == 1u32);
    assert (levelWidth(1920u32, last - 1u32) == 2u32);
}

__test a_level_halves_the_previous_one_rounded_up {
    assert (levelWidth(5u32, 1u32) == 3u32);
    assert (levelWidth(5u32, 2u32) == 2u32);
    assert (levelWidth(5u32, 3u32) == 1u32);
    assert (levelWidth(5u32, 9u32) == 1u32);
    assert (levelHeight(1u32, 1u32) == 1u32);
}

__test the_levels_follow_each_other {
    assert (levelOffset(4u32, 4u32, 1u32) == 0u32);
    assert (levelOffset(4u32, 4u32, 2u32) == 4u32);
    assert (pyramidSize(4u32, 4u32) == 5u32);

    assert (levelOffset(6u32, 3u32, 2u32) == 6u32);
    assert (levelOffset(6u32, 3u32, 3u32) == 8u32);
    assert (pyramidSize(6u32, 3u32) == 9u32);
}

__test every_texel_of_the_depth_is_covered_by_each_level {
    let width = 37u32, height = 11u32;
    for k in 1u32 .. levelCount(width, height) + 1u32 {
        for x in 0u32 .. width {
            assert ((x >> k) < levelWidth(width, k));
        }

        for y in 0u32 .. height {
            assert ((y >> k) < levelHeight(height, k));
        }
    }
}

__test the_level_of_a_rect_covers_it_with_2x2_texels {
    assert (levelOf(64u32, 64u32, 10u32, 10u32, 10u32, 10u32) == 1u32);
    assert (levelOf(64u32, 64u32, 10u32, 10u32, 13u32, 11u32) == 2u32);
    assert (levelOf(64u32, 64u32, 10u32, 10u32, 14u32, 11u32) == 3u32);

    // larger than the depth, the last level
    assert (levelOf(64u32, 64u32, 0u32, 0u32, 63u32, 63u32) == levelCount(64u32, 64u32));

    let width = 100u32, height = 60u32;
    for x0 in 0u32 .. 20u32 {
        for w in 0u32 .. 40u32 {
            let x1 = x0 + w;
            let level = levelOf(width, height, x0, 5u32, x1, 5u32);
            assert ((x1 >> level) - (x0 >> level) <= 1u32);
        }
    }
}
