in triangle_bvh;

use balder::math::{bounds, vector};

use std::math;

/**
 * @returns: a pseudo random number in [-range, range), the state moved to the next one
 * */
fn next(ref mut state: u64, range: f32)-> f32 {
    state = (state * 1103515245u64 + 12345u64) % 2147483648u64;
    let unit = cast!f32((state >> 15u64) & 0xffffu64) / 65536.0f;

    (unit * 2.0f - 1.0f) * range
}

/**
 * @returns: the positions and the indices of n triangles of sides up to 4 scattered around the origin, in
 * [-range, range) along each axis, three vertices of their own each
 * */
fn scatter(n: usize, range: f32, seed: u64)-> ([vec3], [u32]) {
    let mut state = seed;
    let dmut positions = copy [vec3(); 3us * n];
    let dmut indices = copy [0u32; 3us * n];
    for i in 0us .. n {
        let c = makeVec3(next(ref state, range), next(ref state, range), next(ref state, range));
        for j in 0us .. 3us {
            positions[3us * i + j] = c + makeVec3(next(ref state, 2.0f), next(ref state, 2.0f), next(ref state, 2.0f));
            indices[3us * i + j] = cast!u32(3us * i + j);
        }
    }

    (positions, indices)
}

/**
 * @returns: the distance at which a ray hits the first of the triangles it hits, tested one by one, f32::max when it
 * misses them all
 * */
fn closestHit(triangles: &TriangleBvh, ray: Ray)-> f32 {
    let mut best = f32::max;
    for i in 0us .. triangles.len {
        if let Ok(d) = triangles.getTriangle(i).intersect(ray) {
            if d < best { best = d; }
        }
    }

    best
}

__test the_triangles_are_read_three_indices_at_a_time {
    let positions = copy [vec3(), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f), makeVec3(1.0f, 1.0f, 0.0f)];
    let triangles = copy TriangleBvh(positions, copy [0u32, 1u32, 2u32, 2u32, 1u32, 3u32, 0u32]);

    assert (triangles.len == 2us);
    let t = triangles.getTriangle(1us);
    assert (t.a == positions[2] && t.b == positions[1] && t.c == positions[3]);
}

__test a_ray_hits_the_triangle_it_crosses_first_in_a_mesh {
    // a square of two triangles, in front of another
    let positions = copy [makeVec3(-1.0f, -1.0f, -5.0f), makeVec3(1.0f, -1.0f, -5.0f), makeVec3(1.0f, 1.0f, -5.0f), makeVec3(-1.0f, 1.0f, -5.0f),
                     makeVec3(-1.0f, -1.0f, -9.0f), makeVec3(1.0f, -1.0f, -9.0f), makeVec3(1.0f, 1.0f, -9.0f), makeVec3(-1.0f, 1.0f, -9.0f)];
    let dmut triangles = copy TriangleBvh(positions, copy [0u32, 1u32, 2u32, 0u32, 2u32, 3u32, 4u32, 5u32, 6u32, 4u32, 6u32, 7u32]);

    if let Ok(hit) = triangles:.raycast(Ray(makeVec3(-0.5f, 0.5f, 0.0f), makeVec3(0.0f, 0.0f, -1.0f))) {
        assert (hit.id == 1us);
        assert (math::abs(hit.distance - 5.0f) < 0.001f);
    } else {
        assert (false);
    }

    if let Ok(hit) = triangles:.raycast(Ray(makeVec3(0.5f, -0.5f, -12.0f), makeVec3(0.0f, 0.0f, 1.0f))) {
        assert (hit.id == 2us);
        assert (math::abs(hit.distance - 3.0f) < 0.001f);
    } else {
        assert (false);
    }

    assert (!triangles:.raycast(Ray(makeVec3(1.5f, 0.0f, 0.0f), makeVec3(0.0f, 0.0f, -1.0f))).hasValue);
    assert (!triangles:.raycast(Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f), length-> 4.0f)).hasValue);
}

__test a_ray_hits_the_triangle_it_crosses_first_among_many {
    let (positions, indices) = scatter(500us, 20.0f, 31u64);
    let dmut triangles = copy TriangleBvh(positions, indices);

    let mut state = 37u64;
    let mut hits = 0us;
    for i in 0us .. 200us {
        // every other ray aims at the center of a triangle, the others at a point among the triangles
        let origin = makeVec3(next(ref state, 50.0f), next(ref state, 50.0f), next(ref state, 50.0f));
        let random = makeVec3(next(ref state, 15.0f), next(ref state, 15.0f), next(ref state, 15.0f));
        let t = triangles.getTriangle(i);
        let target = if i % 2us == 0us { (t.a + t.b + t.c) / 3.0f } else { random };
        let ray = Ray(origin, target - origin);

        let expected = closestHit(triangles, ray);
        if let Ok(hit) = triangles:.raycast(ray) {
            hits += 1us;
            assert (math::abs(hit.distance - expected) < 0.0001f);
            if let Ok(d) = triangles.getTriangle(hit.id).intersect(ray) {
                assert (math::abs(d - expected) < 0.0001f);
            } else {
                assert (false);
            }
        } else {
            assert (expected == f32::max);
        }
    }

    assert (hits >= 100us);
}

__test a_mesh_of_no_triangle_is_never_hit {
    let indices: [u32] = [];
    let dmut triangles = copy TriangleBvh(copy [vec3()], indices);

    assert (triangles.len == 0us);
    assert (!triangles:.raycast(Ray(makeVec3(0.0f, 0.0f, 1.0f), makeVec3(0.0f, 0.0f, -1.0f))).hasValue);
}
