in tab_bar;

use balder::interface::loader::registry;
use balder::interface::loader::registry::error;
use balder::interface::widget::tab_bar::bar;
use balder::math::vector;

use integration::utils::loader;

use std::syntax;

/**
 * @returns: the reason the check of a .gui content is refused, "" when it is accepted
 * */
fn refusal(content: [c8])-> [c8]
    throws SyntaxError
{
    let doc = document(content);
    let dmut registry = WidgetRegistry();
    {
        registry:.check(doc, "test.gui");
        ""
    } catch {
        e: &LoadError => { e.reason }
    }
}

__test a_tab_dragged_passes_a_neighbour_once_its_middle_passes_the_middle_of_the_neighbour {
    // three tabs of 100, 60 and 80 pixels from 0
    let lefts = copy [0.0f, 100.0f, 160.0f], widths = copy [100.0f, 60.0f, 80.0f];

    // the first tab, its middle at 50, passes the second one once its middle goes past 130
    assert (TabBar::dragTarget(lefts, widths, 0us, 0.0f) == 0us);
    assert (TabBar::dragTarget(lefts, widths, 0us, 79.0f) == 0us);
    assert (TabBar::dragTarget(lefts, widths, 0us, 81.0f) == 1us);

    // and the third one past 200
    assert (TabBar::dragTarget(lefts, widths, 0us, 149.0f) == 1us);
    assert (TabBar::dragTarget(lefts, widths, 0us, 151.0f) == 2us);
    assert (TabBar::dragTarget(lefts, widths, 0us, 1000.0f) == 2us);
}

__test a_tab_dragged_back_passes_the_tabs_before_it {
    let lefts = copy [0.0f, 100.0f, 160.0f], widths = copy [100.0f, 60.0f, 80.0f];

    // the last tab, its middle at 200, passes the second one under 130, the first one under 50
    assert (TabBar::dragTarget(lefts, widths, 2us, 160.0f) == 2us);
    assert (TabBar::dragTarget(lefts, widths, 2us, 89.0f) == 1us);
    assert (TabBar::dragTarget(lefts, widths, 2us, 9.0f) == 0us);
    assert (TabBar::dragTarget(lefts, widths, 2us, -500.0f) == 0us);
}

__test a_drag_of_no_tab_goes_nowhere {
    assert (TabBar::dragTarget([], [], 0us, 50.0f) == 0us);
    assert (TabBar::dragTarget(copy [0.0f], copy [10.0f], 3us, 50.0f) == 3us);
    assert (TabBar::dragTarget(copy [0.0f, 10.0f], copy [10.0f], 0us, 50.0f) == 0us);
}

__test removing_the_tab_selected_selects_the_one_taking_its_place {
    // 4 tabs, the third selected and removed: the fourth takes its place
    assert (TabBar::selectedAfterRemoval((2us)?, 2us, 3us) == (2us)?);

    // the last one removed: the one before it
    assert (TabBar::selectedAfterRemoval((3us)?, 3us, 3us) == (2us)?);

    // the only one removed: none
    assert (!TabBar::selectedAfterRemoval((0us)?, 0us, 0us).hasValue);
}

__test removing_another_tab_keeps_the_tab_selected {
    // a tab before it removed shifts its index
    assert (TabBar::selectedAfterRemoval((2us)?, 0us, 3us) == (1us)?);

    // a tab after it changes nothing
    assert (TabBar::selectedAfterRemoval((1us)?, 3us, 3us) == (1us)?);

    // nothing selected stays so
    assert (!TabBar::selectedAfterRemoval(none, 1us, 3us).hasValue);
}

__test a_tab_moved_shifts_the_tabs_between_its_places {
    // the tab at 1 moved to 3: the tabs at 2 and 3 shift back
    assert (TabBar::movedIndex(1us, 1us, 3us) == 3us);
    assert (TabBar::movedIndex(2us, 1us, 3us) == 1us);
    assert (TabBar::movedIndex(3us, 1us, 3us) == 2us);
    assert (TabBar::movedIndex(0us, 1us, 3us) == 0us && TabBar::movedIndex(4us, 1us, 3us) == 4us);

    // moved back from 3 to 1: the tabs at 1 and 2 shift forward
    assert (TabBar::movedIndex(3us, 3us, 1us) == 1us);
    assert (TabBar::movedIndex(1us, 3us, 1us) == 2us);
    assert (TabBar::movedIndex(2us, 3us, 1us) == 3us);
    assert (TabBar::movedIndex(0us, 3us, 1us) == 0us && TabBar::movedIndex(4us, 3us, 1us) == 4us);
}

__test a_box_holds_the_positions_from_its_corner_to_before_its_end {
    let at = makeVec2(10.0f, 20.0f), size = makeVec2(30.0f, 10.0f);
    assert (TabBar::contains(at, size, makeVec2(10.0f, 20.0f)));
    assert (TabBar::contains(at, size, makeVec2(39.0f, 29.0f)));
    assert (!TabBar::contains(at, size, makeVec2(40.0f, 25.0f)));
    assert (!TabBar::contains(at, size, makeVec2(20.0f, 19.0f)));
}

__test the_tab_bar_type {
    let registry = WidgetRegistry();
    if let Ok(schema) = registry.get("TabBar") {
        assert (schema.attribute("closable").hasValue && schema.attribute("addable").hasValue);
        assert (schema.attribute("tabs").hasValue);
        assert (schema.parts == ["tab", "icon", "dot", "close", "add"]);
        assert (!schema.children.hasValue);
    } else {
        assert (false);
    }

    assert (refusal("TabBar { tabs: \"main\", \"level_2\"; closable: false; addable: true; }") == "");
    assert (refusal("TabBar { on-select: docs::select; on-close: docs::close; on-move: docs::move; on-add: docs::add; }") == "");
    assert (refusal("TabBar { closable: 3; }") != "");
}
