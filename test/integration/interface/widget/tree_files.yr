in tree_files;

use balder::interface::widget::tree::{file_node, files};

use std::fs;

/**
 * Write the files of a small project in a directory: res/ with its models, its scenes, a hidden directory and a file
 * at its root
 * */
fn writeProject(dir: Path)
    throws FsError
{
    createDir(dir.push("models"));
    createDir(dir.push("scenes"));
    createDir(dir.push("textures"));
    createDir(dir.push(".cache"));
    writeFile(dir.push("models/table.glb"), "glTF");
    writeFile(dir.push("models/crate.obj"), "o crate");
    writeFile(dir.push("models/crate.hulls"), "");
    writeFile(dir.push("scenes/main.scene"), "");
    writeFile(dir.push("scenes/level.scene"), "");
    writeFile(dir.push(".cache/thumb.png"), "");
    writeFile(dir.push("project.toml"), "");
}

/**
 * @returns: the names of some entries, in order
 * */
fn namesOf(nodes: [&FileNode])-> [[c8]] {
    copy [n.name for n in nodes]
}

__test the_directories_come_first_then_the_files_each_by_name {
    let dir = tempDirectory(prefix-> "balder_files_");
    writeProject(dir);

    let tree = readFileTree(dir.toStr());
    assert (namesOf(tree) == ["models", "scenes", "textures", "project.toml"]);
    assert (namesOf(tree[0].children) == ["crate.hulls", "crate.obj", "table.glb"]);
    assert (tree[0].isDirectory && !tree[0].children[0].isDirectory);
    assert (tree[0].children[1].path == dir.push("models/crate.obj").toStr());
    assert (tree[0].children[1].size == 7u64);
    assert (tree[2].children.len == 0us);

    removeDir(dir, recursive-> true);
}

__test the_kinds_keep_their_files_and_every_directory {
    let dir = tempDirectory(prefix-> "balder_files_");
    writeProject(dir);

    let kept = filterFileTree(readFileTree(dir.toStr()), copy ["obj", "GLB", "scene"], "");
    assert (namesOf(kept) == ["models", "scenes", "textures"]);
    assert (namesOf(kept[0].children) == ["crate.obj", "table.glb"]);
    assert (namesOf(kept[1].children) == ["level.scene", "main.scene"]);

    removeDir(dir, recursive-> true);
}

__test a_text_keeps_the_names_holding_it_and_their_directories {
    let dir = tempDirectory(prefix-> "balder_files_");
    writeProject(dir);
    let tree = readFileTree(dir.toStr());

    // whatever the case, the directories holding none dropped
    let crate = filterFileTree(tree, [], "CRA");
    assert (namesOf(crate) == ["models"]);
    assert (namesOf(crate[0].children) == ["crate.hulls", "crate.obj"]);

    // a directory named by the text keeps its files of the kinds
    let scenes = filterFileTree(tree, copy ["scene"], "scen");
    assert (namesOf(scenes) == ["scenes"]);
    assert (namesOf(scenes[0].children) == ["level.scene", "main.scene"]);

    assert (filterFileTree(tree, [], "nothing").len == 0us);

    removeDir(dir, recursive-> true);
}

__test the_model_finds_the_nodes_of_the_files_and_marks_one {
    let dir = tempDirectory(prefix-> "balder_files_");
    writeProject(dir);

    let dmut model = copy FileTreeModel();
    model:.setRoot(dir.toStr());
    model:.setKinds(copy ["obj", "glb", "scene"]);
    assert (model.len([]) == 3us && model.len(copy [0us]) == 2us);
    assert (model.text(copy [1us, 1us]) == "main.scene");

    let main = dir.push("scenes/main.scene").toStr();
    assert (model.nodeOf(main) == (copy [1us, 1us])?);
    assert (!model.nodeOf(dir.push("models/crate.hulls").toStr()).hasValue);
    if let Ok(f) = model.fileAt(copy [0us, 1us]) {
        assert (f.name == "table.glb");
    } else {
        assert (false);
    }

    model:.setMarked(main);
    assert (model.marked(copy [1us, 1us]) && !model.marked(copy [1us, 0us]));
    assert (model.directories() == copy [copy [0us], copy [1us], copy [2us]]);

    // the files read again
    writeFile(dir.push("scenes/arena.scene"), "");
    model:.reload();
    assert (model.nodeOf(main) == (copy [1us, 2us])?);

    removeDir(dir, recursive-> true);
}
