in icon_button;

use balder::interface::widget;
use balder::interface::widget::button::icon;
use balder::interface::widget::layout::tool_group;
use balder::math::vector;

__test an_svg_is_rasterised_at_the_pixels_of_its_quad {
    assert (Widget::rasterSize(makeVec2(16.0f, 16.0f), 1.5f) == (24u32, 24u32));

    // 17.5 pixels round to 18
    assert (Widget::rasterSize(makeVec2(14.0f, 14.0f), 1.25f) == (18u32, 18u32));

    // a quad not laid out yet is rasterised once it is
    assert (Widget::rasterSize(makeVec2(0.0f, 16.0f), 2.0f) == (0u32, 0u32));
}

__test only_svg_images_are_rasterised_at_their_size {
    assert (Widget::isVector("engine:/images/ui/move.svg"));
    assert (!Widget::isVector("res:/textures/crate.png"));
}

__test the_icon_is_the_largest_square_of_the_content_box_on_whole_pixels {
    let (pos, size) = IconButton::iconBox(makeVec2(5.0f, 4.0f), makeVec2(16.0f, 16.0f), 1.0f);
    assert (pos == makeVec2(5.0f, 4.0f) && size == makeVec2(16.0f, 16.0f));

    // a wider content box centres the square
    let (wpos, wsize) = IconButton::iconBox(makeVec2(0.0f, 0.0f), makeVec2(20.0f, 16.0f), 1.0f);
    assert (wpos == makeVec2(2.0f, 0.0f) && wsize == makeVec2(16.0f, 16.0f));

    // at twice the pixels, a corner at 3.3 (6.6 pixels) is drawn from the seventh pixel
    let (spos, _) = IconButton::iconBox(makeVec2(3.3f, 0.0f), makeVec2(16.0f, 16.0f), 2.0f);
    assert (spos.x == 3.5f);
}

__test the_ends_of_a_tool_group_round_their_outer_corners {
    assert (ToolGroup::endsOf(0us, 3us) == (true, false));
    assert (ToolGroup::endsOf(1us, 3us) == (false, false));
    assert (ToolGroup::endsOf(2us, 3us) == (false, true));

    // a group of one button rounds every corner
    assert (ToolGroup::endsOf(0us, 1us) == (true, true));
}
