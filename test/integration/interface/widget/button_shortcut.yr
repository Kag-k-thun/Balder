in button_shortcut;

use balder::interface::widget::button;

__test the_shortcut_of_a_button_takes_the_end_of_its_content_box {
    assert (Button::labelWidth(200.0f, 60.0f) == 140.0f);

    // a button without a shortcut gives its whole content box to its label
    assert (Button::labelWidth(200.0f, 0.0f) == 200.0f);
}

__test a_button_narrower_than_its_shortcut_leaves_its_label_no_room {
    assert (Button::labelWidth(40.0f, 60.0f) == 0.0f);
}
