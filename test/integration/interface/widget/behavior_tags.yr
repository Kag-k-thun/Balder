in behavior_tags;

use balder::core::application::signal;
use balder::interface::loader::parser;
use balder::interface::loader::registry::{behaviors, connection, handler};

use std::syntax;

/**
 * A behavior class of the tests: slots named by their tags or by their methods, with and without parameters, a private
 * one, and a slot registered in its constructor
 * */
#[behavior]
class FormSlots over Behavior {

    // The calls received, in order
    pub let mut calls: [[c8]] = [];

    pub self () {
        self:.slot("form::reset", &self:.onReset);
    }

    #[slot (name-> "submit")]
    pub fn onSubmit(mut self, b: u8) {
        self.calls ~= [std::format::format("submit {}", b)];
    }

    #[slot]
    pub fn onClear(mut self) {
        self.calls ~= ["clear"];
    }

    #[slot]
    fn nameSet(mut self, text: [c8]) {
        self.calls ~= ["name " ~ text];
    }

    pub fn onReset(mut self) {
        self.calls ~= ["reset"];
    }

    // not a slot, not tagged
    pub fn onIgnored(mut self) {
        self.calls ~= ["ignored"];
    }
}

/**
 * A behavior class over another one, replacing one of its slots and adding its own
 * */
#[behavior]
class ShortFormSlots over FormSlots {

    pub self () {}

    #[slot (name-> "submit")]
    pub fn onShortSubmit(mut self, b: u8) {
        self.calls ~= [std::format::format("short submit {}", b)];
    }

    #[slot]
    pub fn onSkip(mut self) {
        self.calls ~= ["skip"];
    }
}

/**
 * A class over a behavior class without the tag, keeping the slots of the other one
 * */
class PlainFormSlots over FormSlots {
    pub self () {}

    #[slot]
    pub fn onUnregistered(mut self) {}
}

/**
 * A behavior class registering by hand the name of one of its tagged slots
 * */
#[behavior]
class OverriddenSlots over Behavior {

    pub let mut calls: [[c8]] = [];

    pub self () {
        self:.slot("go", &self:.onHand);
    }

    #[slot (name-> "go")]
    pub fn onTagged(mut self) {
        self.calls ~= ["tagged"];
    }

    pub fn onHand(mut self) {
        self.calls ~= ["hand"];
    }
}

/**
 * Fire the slot of a behavior named name without payload
 * @returns: false iif there is no such slot, or it takes a payload
 * */
fn fire(b: &Behavior, name: [c8])-> bool
    throws SyntaxError
{
    let args: [&Value] = [];
    if let Ok(h) = b.find(name) {
        if let k: &Connection!{()} = h.bind(args) {
            k.fire();
            return true;
        }
    }

    false
}

/**
 * Fire the slot of a behavior named name with a payload
 * @returns: false iif there is no such slot, or it takes something else than a P
 * */
fn fire {P} (b: &Behavior, name: [c8], payload: P)-> bool
    throws SyntaxError
{
    let args: [&Value] = [];
    if let Ok(h) = b.find(name) {
        if let k: &Connection!{P} = h.bind(args) {
            k.fire(payload);
            return true;
        }
    }

    false
}

__test the_tagged_slots_are_registered_when_the_behavior_is_mounted {
    let dmut root = copy Behavior();
    let dmut form = copy FormSlots();

    // the constructor registers only what it registers by hand
    assert (form.find("form::reset").hasValue && !form.find("submit").hasValue);

    root:.behavior("form", alias form);
    assert (root.find("form::submit").hasValue && root.find("form::on-clear").hasValue);
    assert (root.find("form::name-set").hasValue && root.find("form::form::reset").hasValue);
    assert (!root.find("form::on-submit").hasValue && !root.find("form::on-ignored").hasValue);
    assert (!root.find("form::on-reset").hasValue);

    if let Ok(h) = root.find("form::submit") {
        assert (h.signature() == "(u8)");
    } else {
        assert (false);
    }

    if let Ok(h) = root.find("form::on-clear") {
        assert (h.signature() == "()");
    } else {
        assert (false);
    }

    assert (fire(root, "form::submit", 1u8));
    assert (fire(root, "form::on-clear"));
    assert (fire(root, "form::name-set", "Ada"));
    assert (form.calls == ["submit 1", "clear", "name Ada"]);
}

__test the_tagged_slots_are_registered_once {
    let dmut form = copy FormSlots();
    form:.registerTaggedSlots();
    form:.registerTaggedSlots();

    let dmut root = copy Behavior();
    root:.behavior("form", alias form);

    assert (fire(form, "on-clear"));
    assert (form.calls == ["clear"]);
}

__test a_behavior_class_keeps_the_slots_of_its_parent {
    let dmut form = copy ShortFormSlots();
    form:.registerTaggedSlots();

    assert (form.find("on-clear").hasValue && form.find("name-set").hasValue && form.find("on-skip").hasValue);
    assert (!form.find("on-short-submit").hasValue);

    // its own slot replaces the one of its parent of the same name
    assert (fire(form, "submit", 2u8));
    assert (fire(form, "on-skip"));
    assert (fire(form, "on-clear"));
    assert (form.calls == ["short submit 2", "skip", "clear"]);
}

__test a_class_over_a_behavior_class_without_the_tag_keeps_its_slots {
    let dmut form = copy PlainFormSlots();
    form:.registerTaggedSlots();

    assert (form.find("submit").hasValue && form.find("on-clear").hasValue && form.find("name-set").hasValue);

    // its own methods are not registered without the tag
    assert (!form.find("on-unregistered").hasValue);
}

__test a_tagged_slot_replaces_the_one_of_its_name_registered_by_hand {
    let dmut b = copy OverriddenSlots();
    assert (fire(b, "go"));

    b:.registerTaggedSlots();
    assert (fire(b, "go"));
    assert (b.calls == ["hand", "tagged"]);
}
