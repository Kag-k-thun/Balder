in tree_icons;

use balder::interface::widget::tree::{item, texts};

__test a_node_of_a_text_tree_shows_the_icon_of_its_item {
    let sun = copy TreeItem("sun", icon-> "res:/icons/sun.svg");
    let lights = copy TreeItem("lights", children-> copy [sun], icon-> "res:/icons/folder.svg");
    let model = copy TextTreeModel(items-> copy [lights, copy TreeItem("notes")]);

    assert (model.icon(copy [0us]) == "res:/icons/folder.svg");
    assert (model.icon(copy [0us, 0us]) == "res:/icons/sun.svg");
}

__test a_node_without_an_icon_or_out_of_the_tree_shows_none {
    let model = copy TextTreeModel(items-> copy [copy TreeItem("notes")]);
    assert (model.icon(copy [0us]) == "");
    assert (model.icon(copy [3us]) == "");
}
