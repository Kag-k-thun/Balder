in menu_placement;

use balder::interface::widget::layout::menu;
use balder::math::vector;

__test a_menu_inside_the_layout_stays_where_it_opens {
    assert (fitMenu(makeVec2(10.0f, 20.0f), makeVec2(100.0f, 50.0f), makeVec2(400.0f, 300.0f)) == makeVec2(10.0f, 20.0f));

    // touching the right and the bottom edges
    assert (fitMenu(makeVec2(300.0f, 250.0f), makeVec2(100.0f, 50.0f), makeVec2(400.0f, 300.0f)) == makeVec2(300.0f, 250.0f));
}

__test a_menu_past_the_right_or_the_bottom_edge_moves_back_inside {
    // a menu opened under the cursor near the corner of the window, a submenu on the right of the last column
    assert (fitMenu(makeVec2(350.0f, 280.0f), makeVec2(100.0f, 50.0f), makeVec2(400.0f, 300.0f)) == makeVec2(300.0f, 250.0f));
    assert (fitMenu(makeVec2(380.0f, 20.0f), makeVec2(100.0f, 50.0f), makeVec2(400.0f, 300.0f)) == makeVec2(300.0f, 20.0f));
}

__test a_menu_larger_than_the_layout_keeps_its_top_left_corner_inside {
    assert (fitMenu(makeVec2(50.0f, 50.0f), makeVec2(500.0f, 400.0f), makeVec2(400.0f, 300.0f)) == makeVec2(0.0f, 0.0f));
    assert (fitMenu(makeVec2(-10.0f, -5.0f), makeVec2(100.0f, 50.0f), makeVec2(400.0f, 300.0f)) == makeVec2(0.0f, 0.0f));
}
