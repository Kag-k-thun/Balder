in linear_gap;

use balder::interface::widget::layout::linear;

__test the_gaps_of_a_linear_layout_fall_between_its_children {
    assert (LinearLayout::gaps(4us, 2.0f) == 6.0f);

    // a single child, or none, leaves no gap
    assert (LinearLayout::gaps(1us, 2.0f) == 0.0f);
    assert (LinearLayout::gaps(0us, 2.0f) == 0.0f);
}
