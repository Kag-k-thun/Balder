in tree_marks;

use balder::interface::style;
use balder::interface::widget::marker;
use balder::interface::widget::tree::view;

__test the_marker_of_a_row_is_indented_by_the_level_of_its_node {
    assert (TreeView::markerOffset(0us, 14.0f) == 0.0f);
    assert (TreeView::markerOffset(2us, 14.0f) == 28.0f);
}

__test the_text_of_a_row_follows_its_marker_and_its_icon {
    // a marker of 12 and its margin of 4, an icon of 14 and its margin of 4, a level of 14
    assert (TreeView::textOffset(0us, 14.0f, 16.0f, 18.0f) == 34.0f);
    assert (TreeView::textOffset(1us, 14.0f, 16.0f, 18.0f) == 48.0f);

    // a tree whose style gives the icons no room
    assert (TreeView::textOffset(1us, 14.0f, 16.0f, 0.0f) == 30.0f);
}

__test a_tree_indents_its_levels_by_its_property_or_by_its_markers {
    let dmut style = copy Style();
    assert (TreeView::indentOf(style, 16.0f) == 16.0f);

    TreeView::indent().set(alias style, 14u32);
    assert (TreeView::indentOf(style, 16.0f) == 14.0f);
}

__test a_marker_shows_its_glyph_unless_its_style_has_an_image {
    let dmut style = copy Style();
    assert (FoldMarker::text(false, style) == "▸");
    assert (FoldMarker::text(true, style) == "▾");

    style.backgroundImage = (true, "engine:/images/ui/chevron-right.svg");
    assert (FoldMarker::text(false, style) == "");
    assert (FoldMarker::text(true, style) == "");
}
