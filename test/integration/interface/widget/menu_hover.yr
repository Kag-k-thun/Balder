in menu_hover;

use balder::interface::widget::button::menu;

__test a_button_of_the_bar_opens_its_menu_on_hover_in_menu_mode {
    // a menu of the bar is open: hovering another button of the bar switches to its menu
    assert(MenuButton::opensOnHover(inBar-> true, barMenuOpen-> true, inMenu-> false, onlyHover-> false));
}

__test the_bar_stays_quiet_outside_menu_mode {
    // no menu of the bar open: hovering a button of the bar opens nothing until it is clicked
    assert(!MenuButton::opensOnHover(inBar-> true, barMenuOpen-> false, inMenu-> false, onlyHover-> false));

    // even a button of the bar declaring open-on-hover
    assert(!MenuButton::opensOnHover(inBar-> true, barMenuOpen-> false, inMenu-> false, onlyHover-> true));
}

__test an_item_of_an_open_menu_opens_its_submenu_on_hover {
    // whether or not it declares open-on-hover
    assert(MenuButton::opensOnHover(inBar-> false, barMenuOpen-> true, inMenu-> true, onlyHover-> false));
    assert(MenuButton::opensOnHover(inBar-> false, barMenuOpen-> true, inMenu-> true, onlyHover-> true));
}

__test an_item_of_a_menu_opened_under_the_cursor_opens_its_submenu_on_hover {
    // a menu opened by a key (the Add menu of the editor), no menu of the bar being open
    assert(MenuButton::opensOnHover(inBar-> false, barMenuOpen-> false, inMenu-> true, onlyHover-> false));
}

__test a_button_outside_the_bar_and_the_menus_opens_on_hover_only_when_it_declares_it {
    assert(!MenuButton::opensOnHover(inBar-> false, barMenuOpen-> false, inMenu-> false, onlyHover-> false));
    assert(MenuButton::opensOnHover(inBar-> false, barMenuOpen-> false, inMenu-> false, onlyHover-> true));

    // a menu of the bar open elsewhere changes nothing for it
    assert(!MenuButton::opensOnHover(inBar-> false, barMenuOpen-> true, inMenu-> false, onlyHover-> false));
}
