in dialog_slots;

use balder::core::error;
use balder::interface::dialog;
use balder::interface::dialog::{color, confirm, file, message};
use balder::interface::loader;
use balder::interface::loader::{registry::_, registry::behaviors, registry::error};

use integration::utils::loader;

use std::syntax;

/**
 * @returns: the error of the check of a .gui file of the engine against the slots of a dialog, none when it is accepted
 * */
fn failure(path: [c8], dialog: &Dialog)-> (&LoadError)?
    throws SyntaxError, BalderError
{
    let doc = document(readFile(path));
    {
        let dmut registry = WidgetRegistry();
        registry:.check(doc, path, behavior-> (dialog)?);
        none
    } catch {
        e: &LoadError => { (e)? }
    }
}

/**
 * @returns: true iif the .gui file of a dialog names only the slots the dialog registers from its tagged methods
 * */
fn accepts(path: [c8], dmut dialog: &Dialog)-> bool
    throws SyntaxError, BalderError
{
    dialog:.registerTaggedSlots();
    !failure(path, dialog).hasValue
}

__test the_dialogs_register_the_slots_their_gui_files_name {
    assert (accepts("engine:/dialog/confirm.gui", copy ConfirmDialog("Clear the form?")));
    assert (accepts("engine:/dialog/message.gui", copy MessageDialog("Save the changes?", cancel-> "Cancel")));
    assert (accepts("engine:/dialog/file.gui", copy FileDialog(FileDialogMode::OPEN)));
    assert (accepts("engine:/dialog/color.gui", copy ColorDialog()));
}

__test a_dialog_has_no_slot_before_they_are_registered {
    assert (failure("engine:/dialog/confirm.gui", copy ConfirmDialog("Clear the form?")).hasValue);
}
