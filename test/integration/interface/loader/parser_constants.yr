in parser_constants;

use balder::interface::loader::parser;

use integration::utils::loader;

use std::syntax;

__test constants_are_substituted {
    let dmut scope = copy Constants();
    scope:.define("edge", value("#4a5259"));
    assert (scope.contains("edge"));
    assert (!scope.contains("surface"));

    assert (scope.resolve(value("$edge")).getSource() == "#4a5259");
    assert (sources(scope.resolve(value("2 $edge")).toTuple()) == ["2", "#4a5259"]);
    assert (scope.resolve(value("$edge / 40%")).getSource() == "$edge / 40%");
    match scope.resolve(value("$edge / 40%")) {
        Alpha(base-> b) => { assert (b.getSource() == "#4a5259"); }
        _ => { assert (false); }
    }

    match scope.resolve(value("describe ($edge, 1)")) {
        Call(args-> a) => { assert (sources(a) == ["#4a5259", "1"]); }
        _ => { assert (false); }
    }
}

__test tuples_and_lists_are_spliced {
    let dmut scope = copy Constants();
    scope:.define("pad", value("6 14"));
    scope:.define("mono", value("\"DejaVu Sans Mono\", monospace"));

    assert (sources(scope.resolve(value("$pad")).toTuple()) == ["6", "14"]);
    assert (sources(scope.resolve(value("0 $pad")).toTuple()) == ["0", "6", "14"]);
    assert (sources(scope.resolve(value("\"Noto Sans\", $mono")).toList()) == ["\"Noto Sans\"", "\"DejaVu Sans Mono\"", "monospace"]);
}

__test a_constant_uses_the_ones_defined_before_it {
    let dmut scope = copy Constants();
    scope:.define("narrow", value("500"));
    scope:.define("breakpoint", value("$narrow"));
    scope:.define("narrow", value("320"));
    assert (scope.resolve(value("$breakpoint")).toInteger() == 500);
    assert (scope.resolve(value("$narrow")).toInteger() == 320);
}

__test unknown_constants_are_located_at_their_use {
    let scope = copy Constants();
    let error = {
        scope.resolve(value("2  $edge"));
        none
    } catch {
        e: &SyntaxError => { (e)? }
    };

    if let Ok(e) = error {
        assert (e.msg == "unknown constant '$edge'");
        assert (e.line == 1us && e.col == 4us);
    } else {
        assert (false);
    }
}
