in project_settings;

use balder::core::error;
use balder::game::project;

use std::fs;

/**
 * A project.toml holding every table
 * */
def FULL = "name = \"Test\"\nmain-scene = \"main\"\n\n[scenes]\nmain = \"res:/scenes/main.scene\"\nsecond = \"res:/scenes/second.scene\"\n\n[window]\nname = \"Test window\"\nwidth = 1280\nheight = {relative = 0.5, min = 600}\nresizable = false\n\n[render]\nresolution = [960, 540]\n\n[actions]\njump = [\"key:Space\", \"pad:a\"]\naim = {bindings = [\"mouse:right\", \"pad:lefttrigger+\"], dead-zone = 0.3}\n\n[export]\ninclude = [\"res:/audio\"]\narchive = true\n";

/**
 * @returns: a temporary directory holding a project.toml
 * */
fn projectWith(text: [c8])-> Path
    throws FsError
{
    let dir = tempDirectory(prefix-> "balder_project_");
    writeFile(dir.push(Project::FILE), text);
    dir
}

/**
 * @returns: true if `text` contains `sub`
 * */
fn contains(text: [c8], sub: [c8])-> bool {
    if sub.len > text.len { return false; }
    for i in 0us .. (text.len - sub.len + 1us) {
        if text[i .. i + sub.len] == sub { return true; }
    }

    false
}

__test a_project_reads_its_settings {
    let dir = projectWith(FULL);
    let p = copy Project::open(dir.toStr());
    assert (p.name == "Test" && p.mainScene == "main" && p.scenes.len == 2us);
    assert ((p.scenePath("second") ?? "") == "res:/scenes/second.scene" && !p.scenePath("third").hasValue);
    assert (p.render.resolution._0 == 960u32 && p.render.resolution._1 == 540u32);

    let actions = p.actions;
    assert (actions.len == 2us && actions[0].name == "aim" && actions[1].name == "jump");
    assert (actions[0].bindings.len == 2us && actions[0].deadZone > 0.29f && actions[0].deadZone < 0.31f);
    assert (actions[1].bindings[0].text() == "key:Space" && actions[1].bindings[1].text() == "pad:a");

    let e = p.exportSettings;
    assert (e.include.len == 1us && e.include[0] == "res:/audio" && e.archive);
    removeDir(dir, recursive-> true);
}

__test a_project_written_is_read_back_the_same {
    let dir = projectWith(FULL);
    let first = (copy Project::open(dir.toStr())).content();
    writeFile(dir.push(Project::FILE), first);
    let second = (copy Project::open(dir.toStr())).content();
    removeDir(dir, recursive-> true);

    assert (first == second);
    assert (contains(first, "[actions]") && contains(first, "[export]") && contains(first, "[window]"));
}

__test the_settings_changed_are_written {
    let dir = projectWith(FULL);
    let dmut p = copy Project::open(dir.toStr());
    p.name = "Renamed";
    p.mainScene = "second";
    p.mainScene = "none of its scenes";
    p.save();

    let read = copy Project::open(dir.toStr());
    removeDir(dir, recursive-> true);
    assert (read.name == "Renamed" && read.mainScene == "second");
}

__test a_bad_binding_names_its_action_and_its_file {
    let dir = projectWith("name = \"Test\"\n\n[actions]\njump = [\"key:Nope\"]\n");
    let msg = {
        copy Project::open(dir.toStr());
        ""
    } catch {
        err: &BalderError => { err.msg }
    };

    removeDir(dir, recursive-> true);
    assert (contains(msg, "jump") && contains(msg, "Nope"));
}

__test balder_opens_the_window_of_a_project_toml {
    let dir = projectWith(FULL);
    let p = copy Project::open(dir.toStr());
    let w = p.config().window;
    removeDir(dir, recursive-> true);

    assert (w.name == "Test window" && !w.resizable);
    assert (w.width.resolve(4000u32) == 1280u32 && w.height.resolve(2000u32) == 1000u32);
}
