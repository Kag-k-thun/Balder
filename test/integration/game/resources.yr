in resources;

use balder::game::{project, resource_set};
use balder::scene::physics::convex_decomposition;

use std::fs;

/**
 * The scene of the test project: a crate of a model and a material file, a dynamic body shaped by the hulls of the
 * model, a table of a model missing, and a door of a class no library declares
 * */
def SCENE = "scene 2;\n\n"
    ~ "asset cube mesh \"res:/models/cube/cube.obj\";\n"
    ~ "asset brick material \"res:/materials/brick.material\";\n"
    ~ "asset table mesh \"res:/models/table.glb\";\n\n"
    ~ "node #0b6c0a52-1d7e-4c5c-9a50-3c1e6d0b8a01 mesh \"crate\" {\n    mesh: @cube;\n    materials: @brick;\n}\n\n"
    ~ "node #0b6c0a52-1d7e-4c5c-9a50-3c1e6d0b8a02 body \"rock\" {\n    shape: hull;\n    model: @cube;\n    motion: dynamic;\n}\n\n"
    ~ "node #0b6c0a52-1d7e-4c5c-9a50-3c1e6d0b8a03 empty \"props\" {\n}\n\n"
    ~ "node #0b6c0a52-1d7e-4c5c-9a50-3c1e6d0b8a04 mesh \"table\" {\n    parent: #0b6c0a52-1d7e-4c5c-9a50-3c1e6d0b8a03;\n    mesh: @table;\n}\n\n"
    ~ "node #0b6c0a52-1d7e-4c5c-9a50-3c1e6d0b8a05 door \"door\" {\n}\n";

/**
 * @returns: the directory of a project of the scene above, a copy of the cube of the engine, a material file and its
 * map, and a folder its export ships as it is
 * */
fn testProject()-> Path
    throws FsError
{
    let dir = tempDirectory(prefix-> "balder_resources_");
    writeFile(dir.push(Project::FILE), "name = \"Resources\"\nmain-scene = \"main\"\n\n[scenes]\nmain = \"res:/scenes/main.scene\"\n\n[export]\ninclude = [\"res:/audio\"]\n");
    createDir(dir.push("res/scenes"), recursive-> true);
    writeFile(dir.push("res/scenes/main.scene"), SCENE);
    copyDir(Path("res/models/cube"), dir.push("res/models/cube"), recursive-> true, create-> true);
    createDir(dir.push("res/materials"), recursive-> true);
    writeFile(dir.push("res/materials/brick.material"), "version = 1\nbase-color-map = \"res:/textures/brick.png\"\n");
    createDir(dir.push("res/textures"), recursive-> true);
    writeFile(dir.push("res/textures/brick.png"), "not read");
    createDir(dir.push("res/audio"), recursive-> true);
    writeFile(dir.push("res/audio/theme.ogg"), "not read");
    dir
}

/**
 * @returns: the paths of the files of a set, the files of the runtime left out
 * */
fn projectFiles(set: &ResourceSet)-> [[c8]] {
    let mut res: [[c8]] = [];
    for f in set.files {
        let mut runtime = false;
        for r in ResourceSet::RUNTIME_FILES if r == f._0 { runtime = true; }
        if !runtime { res ~= [f._0]; }
    }

    res
}

__test the_files_of_a_game_are_those_its_scenes_name {
    let dir = testProject();
    let set = copy ResourceSet(copy Project::open(dir.toStr()));
    let files = projectFiles(set);
    removeDir(dir, recursive-> true);

    assert (files == ["res:/audio", "res:/materials/brick.material", "res:/models/cube/cube.mtl",
                      "res:/models/cube/cube.obj", "res:/models/cube/white.png", "res:/scenes/main.scene",
                      "res:/textures/brick.png"]);
    for r in ResourceSet::RUNTIME_FILES { assert (set.holds(r)); }
    assert (set.bodies == ["res:/models/cube/cube.obj"]);
}

__test a_missing_file_and_an_unknown_class_are_errors_on_their_nodes {
    let dir = testProject();
    let set = copy ResourceSet(copy Project::open(dir.toStr()));
    removeDir(dir, recursive-> true);

    let problems = set.problems;
    assert (set.hasErrors && problems.len == 2us);
    assert (problems[0].node == "props/table" && problems[0].scene == "res:/scenes/main.scene");
    assert (problems[1].node == "door");
}

__test the_hulls_saved_are_shipped_up_to_date_until_the_model_changes {
    let dir = testProject();
    let model = dir.push("res/models/cube/cube.obj").toStr();
    assert (!ConvexDecomposition::isUpToDate(model));

    ConvexDecomposition::ofModel(model).save(ConvexDecomposition::fileOf(model));
    assert (ConvexDecomposition::isUpToDate(model));

    let set = copy ResourceSet(copy Project::open(dir.toStr()));
    assert (set.holds("res:/models/cube/cube.hulls"));

    writeFile(Path(model), "# changed\n", append-> true);
    let changed = ConvexDecomposition::isUpToDate(model);
    removeDir(dir, recursive-> true);
    assert (!changed);
}

__test the_files_go_in_the_folder_of_the_export_as_the_runtime_reads_them {
    assert (ResourceSet::exportedPath("/out/game", "res:/models/a.glb") == "/out/game/res/models/a.glb");
    assert (ResourceSet::exportedPath("/out/game", "engine:/fonts") == "/out/game/engine/res/fonts");
    assert (ResourceSet::exportedPath("/out/game", "shaders:/base/3D/pbr.toml") == "/out/game/engine/res/shaders/base/3D/pbr.toml");
}
