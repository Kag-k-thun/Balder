in shader_build;

use balder::core::config::shader;
use balder::game::{process, resource_set, shader_build};

use std::fs;

__test the_gizmo_of_the_editor_is_never_shipped {
    let shipped = ShaderBuild::shipped();
    for s in shipped { assert (s != DefaultShaders::GIZMO_3D); }

    let mut pbr = false;
    for s in shipped if s == DefaultShaders::PBR_3D { pbr = true; }
    assert (pbr);
}

/**
 * Every shader shipped compiles without BALDER_DEBUG, the ends of a varying guarded on one side only failing here
 * @info: skipped where glslc is not installed
 * */
__test every_shader_shipped_compiles_for_release {
    if !isInstalled("glslc") { return; }

    let dir = tempDirectory(prefix-> "balder_shaders_");
    let dmut b = copy ShaderBuild(dir.toStr(), dir.push("shaders.log").toStr());
    b:.compile(ShaderBuild::shipped());

    let pbr = Path(ResourceSet::exportedPath(dir.toStr(), DefaultShaders::PBR_3D));
    let fragment = Path(ResourceSet::exportedPath(dir.toStr(), "shaders:/base/3D/pbr/pbr.frag.spv"));
    let skinned = Path(ResourceSet::exportedPath(dir.toStr(), "shaders:/base/3D/pbr/pbr_skin.vert.spv"));
    let gizmo = Path(ResourceSet::exportedPath(dir.toStr(), DefaultShaders::GIZMO_3D));
    let found = isFile(pbr) && isFile(fragment) && isFile(skinned) && !isFile(gizmo);
    removeDir(dir, recursive-> true);
    assert (found);
}
