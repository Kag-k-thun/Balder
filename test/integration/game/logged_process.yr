in logged_process;

use balder::game::{logged_process, process};

use std::{fs, time};

__test a_program_logged_appends_its_output_and_gives_its_exit_code {
    let dir = tempDirectory(prefix-> "balder_process_");
    let log = dir.push("run.log").toStr();
    writeFile(Path(log), "before\n");

    let code = runLogged("sh", copy ["-c", "echo out; echo err >&2; exit 3"], log);
    let text = readFile(Path(log));
    removeDir(dir, recursive-> true);

    assert (code == 3);
    assert (text == "before\nout\nerr\n");
}

/**
 * A program cancelled stops with the programs it started (gyllir and its compilers), its process group being
 * signalled, not only its pid
 * */
__test a_program_cancelled_stops_with_what_it_started {
    let dir = tempDirectory(prefix-> "balder_process_");
    let log = dir.push("run.log").toStr();
    let child = dir.push("child").toStr();

    // the shell writes the pid of the sleep it started in the background, once it runs
    let dmut p = copy LoggedProcess("sh", copy ["-c", "sleep 30 & echo $! > \"$1\"; wait", "sh", child], log);
    let start = Instant::now();
    while !isFile(Path(child)) && (Instant::now() - start).allMillis < 5000u64 {
        sleep(millis(10u64));
    }

    sleep(millis(50u64));
    let mut pid = "";
    for c in readFile(Path(child)) if c >= '0' && c <= '9' { pid ~= [c]; }
    p:.cancel();
    let code = p:.wait();

    // the sleep, orphaned, is reaped by the init of the session
    let started = Instant::now();
    while isDir(Path("/proc/" ~ pid)) && (Instant::now() - started).allMillis < 2000u64 {
        sleep(millis(10u64));
    }

    let alive = isDir(Path("/proc/" ~ pid));
    let elapsed = (Instant::now() - start).allMillis;
    removeDir(dir, recursive-> true);

    assert (p.isCancelled);
    assert (code == 128 + 15);
    assert (!alive);
    assert (elapsed < 5000u64);
}

/**
 * A program cancelled before the shell starting it wrote its pid is signalled once it did
 * */
__test a_program_cancelled_as_it_starts_stops {
    let dir = tempDirectory(prefix-> "balder_process_");
    let log = dir.push("run.log").toStr();

    let start = Instant::now();
    let dmut p = copy LoggedProcess("sleep", copy ["30"], log);
    p:.cancel();
    let code = p:.wait();
    let elapsed = (Instant::now() - start).allMillis;
    removeDir(dir, recursive-> true);

    assert (p.isCancelled);
    assert (code != 0);
    assert (elapsed < 5000u64);
}
