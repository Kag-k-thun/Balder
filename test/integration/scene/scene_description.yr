def BLUE = "2f3a4b5c-6d7e-4f8a-9b0c-1d2e3f4a5b6c";

/**
 * @returns: the message of the error reading a scene file throws, empty when it reads it
 * */
fn errorOf(content: [c8], file: [c8] = "")-> [c8] {
    {
        SceneDescription(content, file-> file);
        ""
    } catch {
        err: &BalderError => { err.msg }
    }
}

/**
 * @returns: true iif a text holds another one
 * */
fn holds(text: [c8], part: [c8])-> bool {
    if part.len > text.len { return false; }
    for i in 0us ... text.len - part.len {
        if text[i .. i + part.len] == part { return true; }
    }

    false
}

/**
 * @returns: the id of a test
 * */
fn id(text: [c8])-> Uuid {
    {
        std::uuid::to!{Uuid} (text)
    } catch {
        _ => { Uuid::nil() }
    }
}

/**
 * @returns: true iif two lists of descriptions are the same
 * */
fn sameNodes(a: [NodeDescription], b: [NodeDescription])-> bool {
    if a.len != b.len { return false; }
    for i in 0us .. a.len {
        if !(a[i] == b[i]) { return false; }
    }

    true
}

/**
 * @returns: a scene file of a light, and of an empty of a cube of a wood local to the file and of an empty holding a
 * model, the plate given before its parent
 * */
fn table()-> [c8] {
    "// a table and its light\n"
    ~ "scene 2;\n"
    ~ "\n"
    ~ "asset chair mesh \"res:/models/chair.glb\";\n"
    ~ "asset cube mesh \"engine:/meshes/cube\";\n"
    ~ "\n"
    ~ "material #" ~ WOOD ~ " \"wood\" {\n"
    ~ "    base-color: 0.5 0.3 0.1;\n"
    ~ "    metallic: 1;\n"
    ~ "    roughness: 0.25;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ SUN ~ " light \"sun\" {\n"
    ~ "    light: point;\n"
    ~ "    color: 1 0.5 0.25;\n"
    ~ "    intensity: 3;\n"
    ~ "    range: 12.5;\n"
    ~ "    shadows: true;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PLATE ~ " empty \"plate\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TABLE ~ " empty \"table\" {\n"
    ~ "    position: 1 2 3;\n"
    ~ "    rotation: 0 90 0;   /* a quarter turn */\n"
    ~ "    scale: 2 2 2;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TOP ~ " mesh \"top\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "    mesh: @cube;\n"
    ~ "    materials: #" ~ WOOD ~ ";\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ CHAIR ~ " mesh \"chair\" {\n"
    ~ "    parent: #" ~ PLATE ~ ";\n"
    ~ "    position: -0.5 0 0;\n"
    ~ "    mesh: @chair;\n"
    ~ "    lods: false;\n"
    ~ "}\n"
}

/**
 * @returns: a scene file of a node of every kind, as the writer writes it
 * */
fn everyKind()-> [c8] {
    "scene 2;\n"
    ~ "\n"
    ~ "asset plane mesh \"engine:/meshes/plane\";\n"
    ~ "asset sphere mesh \"engine:/meshes/sphere\";\n"
    ~ "asset chair mesh \"res:/models/chair.glb\";\n"
    ~ "asset chair_0 material \"res:/models/chair.glb#0\";\n"
    ~ "asset chair_2 mesh \"res:/props/chair.obj\";\n"
    ~ "\n"
    ~ "material #" ~ BLUE ~ " \"blue\" {\n"
    ~ "    base-color: 0.2 0.4 0.8;\n"
    ~ "    metallic: 1;\n"
    ~ "    roughness: 0.2;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ SUN ~ " light \"spot\" {\n"
    ~ "    position: 0 4 0;\n"
    ~ "    light: spot;\n"
    ~ "    color: 1 0.9 0.8;\n"
    ~ "    intensity: 25;\n"
    ~ "    direction: 0.3 -1 0.1;\n"
    ~ "    range: 15;\n"
    ~ "    inner-angle: 12.5;\n"
    ~ "    outer-angle: 40;\n"
    ~ "    shadows: true;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TABLE ~ " empty \"room\" {\n"
    ~ "    rotation: 0 30 -45;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ TOP ~ " mesh \"ball\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "    position: 0.1 0.2 0.3;\n"
    ~ "    scale: 0.5 0.5 0.5;\n"
    ~ "    mesh: @sphere;\n"
    ~ "    materials: #" ~ BLUE ~ ";\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PLATE ~ " mesh \"floor\" {\n"
    ~ "    parent: #" ~ TABLE ~ ";\n"
    ~ "    scale: 20 1 20;\n"
    ~ "    mesh: @plane;\n"
    ~ "    shadows: false;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ CHAIR ~ " mesh \"chair\" {\n"
    ~ "    mesh: @chair_2;\n"
    ~ "    lods: false;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ STOOL ~ " mesh \"stool\" {\n"
    ~ "    mesh: @chair;\n"
    ~ "    materials: none @chair_0;\n"
    ~ "}\n"
    ~ markedNodes()
}

/**
 * @returns: the blocks of a marker, of a path of two points and of two volumes, as the writer writes them
 * */
fn markedNodes()-> [c8] {
    "\n"
    ~ "node #" ~ SPAWN ~ " marker \"spawn\" {\n"
    ~ "    position: 1 0 -2;\n"
    ~ "    purpose: spawn;\n"
    ~ "    tags: \"player\" \"start\";\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ ROUTE ~ " path \"route\" {\n"
    ~ "    curve: bezier;\n"
    ~ "    closed: true;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ START ~ " path-point \"point\" {\n"
    ~ "    parent: #" ~ ROUTE ~ ";\n"
    ~ "    position: -2 0 0;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ END ~ " path-point \"point_2\" {\n"
    ~ "    parent: #" ~ ROUTE ~ ";\n"
    ~ "    position: 2 0 0;\n"
    ~ "    scale: 1.5 1 1;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PILL ~ " volume \"trigger\" {\n"
    ~ "    shape: capsule;\n"
    ~ "    radius: 0.75;\n"
    ~ "    height: 3;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ ZONE ~ " volume \"zone\" {\n"
    ~ "    size: 4 2 1;\n"
    ~ "}\n"
}

/**
 * @returns: a scene file of bodies of every shape and of a character, as the writer writes it
 * */
fn physicsNodes()-> [c8] {
    "scene 2;\n"
    ~ "\n"
    ~ "asset teapot mesh \"res:/models/teapot/teapot.obj\";\n"
    ~ "\n"
    ~ "node #" ~ CRATE ~ " body \"crate\" {\n"
    ~ "    position: 0 2 0;\n"
    ~ "    size: 2 1 1;\n"
    ~ "    motion: dynamic;\n"
    ~ "    mass: 20;\n"
    ~ "    friction: 0.8;\n"
    ~ "    restitution: 0.25;\n"
    ~ "    can-sleep: false;\n"
    ~ "    layer: 1 3;\n"
    ~ "    mask: 0 1;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ FLOOR ~ " body \"floor\" {\n"
    ~ "    shape: plane;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ PAD ~ " body \"pad\" {\n"
    ~ "    shape: cylinder;\n"
    ~ "    radius: 2;\n"
    ~ "    height: 0.5;\n"
    ~ "    trigger: true;\n"
    ~ "    mask: none;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ HERO ~ " character \"hero\" {\n"
    ~ "    position: 0 0.9 0;\n"
    ~ "    radius: 0.3;\n"
    ~ "    height: 1.6;\n"
    ~ "    slope-limit: 50;\n"
    ~ "    step-offset: 0.4;\n"
    ~ "    max-slides: 6;\n"
    ~ "    layer: 2;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ POT ~ " body \"pot\" {\n"
    ~ "    shape: hull;\n"
    ~ "    model: @teapot;\n"
    ~ "    motion: kinematic;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ BENCH ~ " body \"bench\" {\n"
    ~ "    shape: compound;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ SEAT ~ " volume \"seat\" {\n"
    ~ "    parent: #" ~ BENCH ~ ";\n"
    ~ "    position: 0 0.5 0;\n"
    ~ "    size: 2 0.2 1;\n"
    ~ "}\n"
}

/**
 * @returns: a scene file of a perspective camera on a rig and of the active orthographic camera of a map, as the writer
 * writes it
 * */
fn cameraNodes()-> [c8] {
    "scene 2;\n"
    ~ "\n"
    ~ "node #" ~ RIG ~ " empty \"rig\" {\n"
    ~ "    position: 0 1.5 4;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ EYE ~ " camera \"eye\" {\n"
    ~ "    parent: #" ~ RIG ~ ";\n"
    ~ "    rotation: -15 0 0;\n"
    ~ "    fov: 60;\n"
    ~ "    far: 500;\n"
    ~ "}\n"
    ~ "\n"
    ~ "node #" ~ MAP ~ " camera \"map\" {\n"
    ~ "    position: 0 50 0;\n"
    ~ "    rotation: -90 0 0;\n"
    ~ "    projection: orthographic;\n"
    ~ "    size: 40;\n"
    ~ "    near: 1;\n"
    ~ "    active: true;\n"
    ~ "}\n"
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          READ          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_scene_file_puts_its_nodes_under_their_parents_in_the_order_of_the_file {
    {
        let nodes = SceneDescription(table()).nodes;
        assert (nodes.len == 2us);
        assert (nodes[0].name == "sun" && nodes[0].kind == NodeKind::LIGHT);
        assert (nodes[1].name == "table" && nodes[1].kind == NodeKind::EMPTY);

        // the plate comes before its parent in the file, and before the top among the nodes under the table
        let children = nodes[1].children;
        assert (children.len == 2us && children[0].name == "plate" && children[1].name == "top");
        assert (children[1].kind == NodeKind::MESH);
        assert (children[0].children.len == 1us && children[0].children[0].name == "chair");
    } catch {
        _ => { assert (false); }
    }
}

__test the_entries_of_a_node_are_read_the_rotation_in_degrees {
    {
        let nodes = SceneDescription(table()).nodes;
        let sun = nodes[0], table = nodes[1], top = nodes[1].children[1], chair = nodes[1].children[0].children[0];

        assert (sun.value("light").text == "point" && sun.value("shadows").flag && near(sun.value("intensity").number, 3.0f));
        assert (near(sun.value("range").number, 12.5f));
        assert (near(sun.value("color").vector.y, 0.5f));

        assert (near(table.value("position").vector.z, 3.0f) && near(table.value("scale").vector.x, 2.0f));
        assert (near(table.value("rotation").vector.y, radian(90.0f)) && near(table.value("rotation").vector.x, 0.0f));

        assert (top.value("mesh").text == "engine:/meshes/cube");
        assert (top.value("materials").texts == ["local:" ~ WOOD] && top.value("shadows").flag);

        assert (chair.kind == NodeKind::MESH && chair.value("mesh").text == "res:/models/chair.glb" && !chair.value("lods").flag);
        assert (chair.value("materials").texts.len == 0us);
        assert (near(chair.value("position").vector.x, -0.5f));
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_keep_the_ids_of_their_blocks {
    {
        let nodes = SceneDescription(table()).nodes;
        assert (nodes[0].id.opCmp(id(SUN)) == 0 && nodes[1].id.opCmp(id(TABLE)) == 0);
        assert (nodes[1].children[1].id.opCmp(id(TOP)) == 0);
    } catch {
        _ => { assert (false); }
    }
}

__test a_scene_file_without_nodes_describes_an_empty_scene {
    {
        assert (SceneDescription("scene 2;\n").nodes.len == 0us);
        assert (SceneDescription("// nothing yet\nscene 2; /* still nothing */\n").nodes.len == 0us);
    } catch {
        _ => { assert (false); }
    }
}

__test the_errors_of_a_scene_file_tell_where_and_why {
    let head = "scene 2;\n";
    let node = "node #" ~ SUN ~ " ";
    let material = "material #" ~ WOOD ~ " \"wood\" ";

    let cases = [
        ("",
         "scene:1:1: expected 'scene 2;'"),
        ("[[node]]\nname = \"a\"\n",
         "scene:1:1: unexpected '[[node]]'"),
        ("scene 1;\n",
         "version '1' of the scene file"),
        (head ~ "camera {}\n",
         "scene:2:1: expected a node, an asset or a material"),
        (head ~ node ~ "cube \"a\" {}\n",
         "'cube' is no longer a kind of node: a mesh node draws the mesh engine:/meshes/cube"),
        (head ~ node ~ "model \"a\" {}\n",
         "'model' is no longer a kind of node: a mesh node draws the mesh of its model file"),
        (head ~ "node #12 mesh \"a\" {}\n",
         "expected the id of the node"),
        (head ~ node ~ "\"cone\" \"a\" {}\n",
         "the kind of the node"),
        (head ~ node ~ "empty a {}\n",
         "the name of the node"),
        (head ~ node ~ "empty \"a/b\" {}\n",
         "holding a '/'"),
        (head ~ node ~ "empty \"a\" { size: 2; }\n",
         "empty 'a' has no entry 'size'"),
        (head ~ node ~ "empty \"a\" { shadows: true; }\n",
         "empty 'a' has no entry 'shadows'"),
        (head ~ node ~ "light \"a\" { roughness: 1; }\n",
         "light 'a' has no entry 'roughness'"),
        (head ~ node ~ "empty \"a\" { position: 1 2; }\n",
         "position must be three numbers"),
        (head ~ node ~ "empty \"a\" { position: 1 2 x; }\n",
         "position must be a number, found 'x'"),
        (head ~ node ~ "empty \"a\" { position: 1 2 3px; }\n",
         "position must be a number, found '3px'"),
        (head ~ node ~ "empty \"a\" { scale: 1 1 1; scale: 2 2 2; }\n",
         "entry 'scale' given twice"),
        (head ~ node ~ "light \"a\" { light: sun; }\n",
         "light must be direction, point or spot"),
        (head ~ node ~ "light \"a\" { shadows: 1; }\n",
         "shadows must be true or false"),
        (head ~ node ~ "marker \"a\" { purpose: flying; }\n",
         "purpose must be generic, spawn, waypoint or socket"),
        (head ~ node ~ "marker \"a\" { tags: player; }\n",
         "tags must be strings, none of them empty"),
        (head ~ node ~ "marker \"a\" { radius: 1; }\n",
         "marker 'a' has no entry 'radius'"),
        (head ~ node ~ "path \"a\" { curve: spline; }\n",
         "curve must be catmull-rom or bezier"),
        (head ~ node ~ "path-point \"a\" { closed: true; }\n",
         "path-point 'a' has no entry 'closed'"),
        (head ~ node ~ "volume \"a\" { shape: cone; }\n",
         "shape must be box, sphere or capsule"),
        (head ~ node ~ "volume \"a\" { size: 1 2; }\n",
         "size must be three numbers"),
        (head ~ node ~ "mesh \"a\" {}\n",
         "mesh 'a' without a mesh"),
        (head ~ node ~ "mesh \"a\" { mesh: \"res:/a.glb\"; }\n",
         "mesh must be an asset, @<key>"),
        (head ~ node ~ "mesh \"a\" { mesh: @a; }\n",
         "names the asset 'a', not declared"),
        (head ~ "asset a mesh \"x.glb\";\nasset a mesh \"y.glb\";\n",
         "asset 'a' declared twice"),
        (head ~ "asset a model \"x.glb\";\n",
         "the kind of the asset, mesh or material"),
        (head ~ "asset a material \"a.material\";\n" ~ node ~ "mesh \"a\" { mesh: @a; }\n",
         "mesh 'a' names the material 'a' in its mesh, which reads a mesh"),
        (head ~ "asset a mesh \"a.glb\";\n" ~ node ~ "mesh \"a\" { mesh: @a; materials: @a; }\n",
         "mesh 'a' names the mesh 'a' in its materials, which reads a material"),
        (head ~ "asset a mesh \"a.glb\";\n" ~ node ~ "mesh \"a\" { mesh: @a; materials: #" ~ WOOD ~ "; }\n",
         "mesh 'a' names the material #" ~ WOOD ~ ", not in the file"),
        (head ~ "asset a mesh \"a.glb\";\n" ~ node ~ "mesh \"a\" { mesh: @a; materials: \"red\"; }\n",
         "materials must be assets, @<key>, materials of the file, #<uuid>, or none"),
        (head ~ material ~ "{ color: 1 0 0; }\n",
         "material 'wood' has no entry 'color'"),
        (head ~ material ~ "{ roughness: 1; roughness: 0; }\n",
         "entry 'roughness' given twice"),
        (head ~ material ~ "{ base-color: 1 0; }\n",
         "base-color must be three numbers"),
        (head ~ material ~ "{ normal-map: @normal; }\n",
         "normal-map must be a string"),
        (head ~ material ~ "{}\n" ~ material ~ "{}\n",
         "material " ~ WOOD ~ " declared twice"),
        (head ~ node ~ "empty \"a\" {}\n" ~ node ~ "empty \"b\" {}\n",
         "scene:3:1: id #" ~ SUN ~ " given to two nodes"),
        (head ~ node ~ "empty \"a\" { parent: #" ~ TABLE ~ "; }\n",
         "empty 'a' is under #" ~ TABLE ~ ", no node of the file"),
        (head ~ node ~ "empty \"a\" { parent: #" ~ SUN ~ "; }\n",
         "empty 'a' is under itself"),
        (head ~ node ~ "empty \"a\" {\n",
         "scene:3:1: expected an entry of the node or '}'")
    ];

    let mut wrong = 0us;
    for c in cases if !holds(errorOf(c._0), c._1) {
        println("expected '", c._1, "', got '", errorOf(c._0), "'");
        wrong += 1us;
    }

    assert (wrong == 0us);
}

__test the_errors_of_a_scene_file_name_it {
    assert (holds(errorOf("scene 3;\n", file-> "res:/scenes/hall.scene"), "res:/scenes/hall.scene:1:7: version '3'"));
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          BUILD          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_scene_is_built_under_a_node {
    {
        let dmut root = copy Root();
        let s = copy SceneDescription(copy [NodeDescription("lamp", NodeKind::LIGHT), NodeDescription("box", NodeKind::EMPTY)]);
        let dmut built = alias s.build(alias root);

        assert (built.len == 2us);
        assert (root:.find(Path("lamp")).hasValue && root:.find(Path("box")).hasValue);
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_built_take_the_id_the_transform_and_the_light_of_their_description {
    {
        let dmut root = copy Root();
        let content = "scene 2;\n"
            ~ "node #" ~ TABLE ~ " empty \"room\" { position: 0 1 0; }\n"
            ~ "node #" ~ SUN ~ " light \"spot\" {\n"
            ~ "    parent: #" ~ TABLE ~ ";\n"
            ~ "    light: spot;\n"
            ~ "    inner-angle: 10;\n"
            ~ "    outer-angle: 15;\n"
            ~ "    position: 2 0 0;\n"
            ~ "}\n";
        SceneDescription(content).build(alias root);

        let dmut room = alias root:.find(Path("room"));
        if let Ok(dmut s: &Light) = alias root:.find(Path("room/spot")) {
            assert (s.type == LightType::SPOT && near(s.innerAngle, 10.0f) && near(s.outerAngle, 15.0f));
            assert (near(s.position.x, 2.0f) && s.guid.opCmp(id(SUN)) == 0);
        } else {
            assert (false);
        }

        if let Ok(g: &Empty3D) = room {
            assert (near(g.position.y, 1.0f) && g.guid.opCmp(id(TABLE)) == 0);
        } else {
            assert (false);
        }
    } catch {
        _ => { assert (false); }
    }
}

__test the_nodes_built_take_the_marks_the_curves_and_the_shapes_of_their_description {
    {
        let dmut root = copy Root();
        SceneDescription("scene 2;\n" ~ markedNodes()).build(alias root);

        if let Ok(m: &Marker3D) = root:.find(Path("spawn")) {
            assert (m.purpose == MarkerPurpose::SPAWN && m.tags == ["player", "start"]);
        } else {
            assert (false);
        }

        if let Ok(p: &Path3D) = root:.find(Path("route")) {
            let points = p.points();
            assert (p.curveKind == CurveKind::BEZIER && p.closed && points.len == 2us);
            assert (points[0].name.file() == "point" && near(points[1].scale.x, 1.5f));
        } else {
            assert (false);
        }

        if let Ok(v: &Volume3D) = root:.find(Path("trigger")) {
            let shape = v.shape;
            assert (shape.kind == VolumeKind::CAPSULE && near(shape.radius, 0.75f) && near(shape.height, 3.0f));
        } else {
            assert (false);
        }

        if let Ok(v: &Volume3D) = root:.find(Path("zone")) {
            assert (v.shape.kind == VolumeKind::BOX && v.shape.size == makeVec3(4.0f, 2.0f, 1.0f));
        } else {
            assert (false);
        }
    } catch {
        err => { println(err); assert (false); }
    }
}

