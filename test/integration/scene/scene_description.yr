 */

__test the_bodies_and_the_characters_of_a_scene_file_are_read_with_their_shapes_and_settings {
    {
        let nodes = SceneDescription(physicsNodes()).nodes;
        assert (nodes.len == 6us);

        let crate = nodes[0];
        assert (crate.kind == NodeKind::BODY && crate.value("shape").text == "box" && near(crate.value("size").vector, makeVec3(2.0f, 1.0f, 1.0f)));
        assert (crate.value("motion").text == "dynamic" && near(crate.value("mass").number, 20.0f) && !crate.value("can-sleep").flag);
        assert (crate.value("layer").bits == 10u32 && crate.value("mask").bits == 3u32);

        let pad = nodes[2];
        assert (pad.value("shape").text == "cylinder" && near(pad.value("height").number, 0.5f) && pad.value("trigger").flag);
        assert (pad.value("mask").bits == 0u32);

        let hero = nodes[3];
        assert (hero.kind == NodeKind::CHARACTER && near(hero.value("radius").number, 0.3f) && near(hero.value("height").number, 1.6f));
        assert (near(degree(hero.value("slope-limit").number), 50.0f) && hero.value("max-slides").bits == 6u32);
        assert (hero.value("layer").bits == 4u32);

        let pot = nodes[4];
        assert (pot.value("shape").text == "hull" && pot.value("model").text == "res:/models/teapot/teapot.obj");
        assert (nodes[5].value("shape").text == "compound" && nodes[5].children.len == 1us);
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_bodies_are_written_back_as_they_were_read_their_defaults_left_out {
    {
        let content = SceneDescription(physicsNodes()).content();
        if content != physicsNodes() { println(content); }
        assert (content == physicsNodes());
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_bodies_built_take_their_shapes_their_settings_and_the_volumes_of_a_compound {
    {
        let dmut root = copy Root();
        SceneDescription(physicsNodes()).build(alias root);

        if let Ok(c: &PhysicsBody3D) = root:.find(Path("crate")) {
            assert (c.shape.kind == ColliderKind::BOX && c.settings.motion == BodyMotion::DYNAMIC && c.settings.layer == 10u32);
        } else {
            assert (false);
        }

        if let Ok(h: &CharacterBody3D) = root:.find(Path("hero")) {
            assert (near(h.shape.radius, 0.3f) && h.settings.motion == BodyMotion::KINEMATIC);
            assert (h.controller.settings.maxSlides == 6u32 && near(h.controller.settings.stepOffset, 0.4f));
        } else {
            assert (false);
        }

        if let Ok(p: &PhysicsBody3D) = root:.find(Path("pot")) {
            assert (p.shape.kind == ColliderKind::COMPOUND && p.settings.motion == BodyMotion::KINEMATIC);
        } else {
            assert (false);
        }

        if let Ok(b: &PhysicsBody3D) = root:.find(Path("bench")) {
            // the seat, 0.2 high about y = 0.5
            assert (b.shape.kind == ColliderKind::COMPOUND && near(b.shape.localBox().max, makeVec3(1.0f, 0.6f, 0.5f)));
        } else {
            assert (false);
        }

        let back = SceneDescription(alias root);
        assert (sameNodes(back.nodes, SceneDescription(physicsNodes()).nodes));
    } catch {
        err => { println(err); assert (false); }
    }
}

__test a_body_given_its_collider_by_the_game_is_not_described {
    let dmut root = copy Root();
    let dmut b = copy PhysicsBody3D("b", alias root);
    b.shape = ColliderShape::hull(copy ConvexHull(copy [makeVec3(0.0f, 0.0f, 0.0f), makeVec3(1.0f, 0.0f, 0.0f),
                                                        makeVec3(0.0f, 1.0f, 0.0f), makeVec3(0.0f, 0.0f, 1.0f)]));
    assert (holds(describeErrorOf(alias root), "a body of a shape given as a collider"));
}

__test the_errors_of_the_bodies_of_a_scene_file_tell_where_and_why {
    let open = "scene 2;\nasset pot mesh \"res:/pot.glb\";\n";
    assert (holds(errorOf(open ~ "node #" ~ CRATE ~ " body \"b\" { shape: hull; }"), "body 'b' of a hull shape without a model"));
    assert (holds(errorOf(open ~ "node #" ~ CRATE ~ " body \"b\" { model: @pot; }"), "body 'b' of a box shape given a model"));
    assert (holds(errorOf(open ~ "node #" ~ CRATE ~ " body \"b\" { shape: cone; }"), "shape must be box, sphere, capsule, cylinder, plane, hull, mesh or compound"));
    assert (holds(errorOf(open ~ "node #" ~ CRATE ~ " body \"b\" { layer: 32; }"), "layer must be the numbers of layers, 0 to 31, or none"));
    assert (holds(errorOf(open ~ "node #" ~ CRATE ~ " body \"b\" { motion: flying; }"), "motion must be static, kinematic or dynamic"));
    assert (holds(errorOf(open ~ "node #" ~ HERO ~ " character \"c\" { motion: dynamic; }"), "character 'c' has no entry 'motion'"));
    assert (holds(errorOf(open ~ "node #" ~ HERO ~ " character \"c\" { max-slides: 1.5; }"), "max-slides must be a whole number"));
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          CAMERAS          =====================================
 * ====================================================================================================
