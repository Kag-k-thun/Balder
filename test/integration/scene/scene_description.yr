}

__test a_mesh_node_built_draws_with_the_material_local_to_its_file {
    {
        let dmut root = copy Root();
        let content = "scene 2;\n"
            ~ "asset cube mesh \"engine:/meshes/cube\";\n"
            ~ "material #" ~ WOOD ~ " \"wood\" { base-color: 0.5 0.3 0.1; roughness: 0.25; }\n"
            ~ "node #" ~ TOP ~ " mesh \"top\" { mesh: @cube; materials: #" ~ WOOD ~ "; shadows: false; }\n";
        let read = SceneDescription(content);
        assert (read.materials.len == 1us && read.materials[0us].name == "wood");
        read.build(alias root);

        if let Ok(dmut top: &MeshInstance3D) = alias root:.find(Path("top")) {
            let material = top.materialOf(0us);
            assert (material.isLocal && material.name == "wood" && near(material.config.roughness, 0.25f));
            assert (near(top.draws[0us].material.config.baseColor, makeVec3(0.5f, 0.3f, 0.1f)));
            assert (!top.castShadow && !top.draws[0us].castShadow());
        } else {
            assert (false);
        }
    } catch {
        err => { println(err); assert (false); }
    }
}

__test a_description_without_ids_builds_nodes_of_new_ids {
    {
        let dmut root = copy Root();
        let content = "scene 2;\nnode #" ~ TABLE ~ " empty \"table\" {}\n";
        SceneDescription(content).withoutIds().build(alias root);
        if let Ok(t: &Empty3D) = root:.find(Path("table")) {
            assert (!t.guid.isNil() && t.guid.opCmp(id(TABLE)) != 0);
        } else {
            assert (false);
        }

        // the materials local to the file take new ids, the nodes naming them by those
        let fresh = SceneDescription(table()).withoutIds();
        let path = fresh.materials[0us].path;
        assert (fresh.materials.len == 1us && path != "local:" ~ WOOD && fresh.materials[0us].name == "wood");
        assert (fresh.nodes[1us].children[1us].value("materials").texts == [path]);
    } catch {
        _ => { assert (false); }
    }
}

