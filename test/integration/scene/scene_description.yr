 */

__test the_cameras_of_a_scene_file_are_read_with_their_projections {
    {
        let nodes = SceneDescription(cameraNodes()).nodes;
        assert (nodes.len == 2us && nodes[0].children.len == 1us);

        let eye = nodes[0].children[0];
        assert (eye.kind == NodeKind::CAMERA && eye.value("projection").text == "perspective");
        assert (near(eye.value("fov").number, 60.0f) && near(eye.value("near").number, 0.1f) && near(eye.value("far").number, 500.0f));
        assert (!eye.value("active").flag);

        let map = nodes[1];
        assert (map.value("projection").text == "orthographic" && near(map.value("size").number, 40.0f));
        assert (near(map.value("near").number, 1.0f) && map.value("active").flag);
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_cameras_are_written_back_as_they_were_read_their_defaults_left_out {
    {
        let content = SceneDescription(cameraNodes()).content();
        if content != cameraNodes() { println(content); }
        assert (content == cameraNodes());
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_cameras_built_take_the_class_of_their_projection_and_its_settings {
    {
        let dmut root = copy Root();
        SceneDescription(cameraNodes()).build(alias root);

        if let Ok(dmut eye: &PerspectiveCamera) = alias root:.find(Path("rig/eye")) {
            assert (near(eye.fov, 60.0f) && near(eye.far, 500.0f) && near(eye.near, 0.1f));
            assert (near(eye.eye, makeVec3(0.0f, 1.5f, 4.0f)));
        } else {
            assert (false);
        }

        if let Ok(dmut map: &OrthoCamera) = alias root:.find(Path("map")) {
            assert (near(map.size, 40.0f) && near(map.near, 1.0f) && near(map.far, 100.0f));
        } else {
            assert (false);
        }

        // out of a scene, no camera is active: the description says so
        let back = SceneDescription(alias root).nodes;
        assert (back[0].children[0].kind == NodeKind::CAMERA && back[1].value("projection").text == "orthographic");
        assert (near(back[1].value("size").number, 40.0f) && !back[1].value("active").flag);
    } catch {
        err => { println(err); assert (false); }
    }
}

__test the_errors_of_the_cameras_of_a_scene_file_tell_where_and_why {
    let open = "scene 2;\n";
    let eye = "node #" ~ EYE ~ " camera \"eye\" ";
    let map = "node #" ~ MAP ~ " camera \"map\" ";
    assert (holds(errorOf(open ~ eye ~ "{ projection: fisheye; }"), "projection must be perspective or orthographic"));
    assert (holds(errorOf(open ~ eye ~ "{ radius: 1; }"), "camera 'eye' has no entry 'radius'"));
    assert (holds(errorOf(open ~ eye ~ "{ active: yes; }"), "active must be true or false"));
    assert (holds(errorOf(open ~ "node #" ~ SUN ~ " light \"sun\" { fov: 60; }"), "light 'sun' has no entry 'fov'"));
    assert (holds(errorOf(open ~ eye ~ "{ active: true; }\n" ~ map ~ "{ active: true; }\n"),
                  "scene:3:1: camera 'map' is active, and so is camera 'eye'"));
}
