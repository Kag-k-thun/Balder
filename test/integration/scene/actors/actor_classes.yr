in actor_classes;

use balder::core::application::signal;
use balder::math::vector;
use balder::scene::editable;
use balder::scene::actors::{actor_class, actor_members, node_classes, node_connection, slot_ref, tags, wiring};
use balder::scene::description::kind;
use balder::scene::node::node3D;
use balder::scene::node::node3D::empty;
use balder::scene::property::{kind, value};

use integration::scene::actors::fixtures;
use integration::utils::root;

use std::uuid;

__test the_actor_classes_are_registered_at_the_start {
    let door = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    assert (door.label == "Test door" && door.category == "Tests" && door.kind == NodeKind::ACTOR);

    let switch = if let Ok(c) = actorClass("test-switch") { c } else { assert (false); };
    assert (switch.label == "Switch of the tests");

    let vault = if let Ok(c) = actorClass("test-vault") { c } else { assert (false); };
    assert (vault.category == "Actors");
}

__test an_actor_class_unregistered_is_gone_and_the_members_are_read_again {
    let door = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    assert (door.schema().properties.len == 10us);

    let before = actorClasses().len;
    for _ in 0 .. 2 {
        registerActorClass(copy ActorClass("test-crate", "Test crate", "Tests", &createActor!{&TestCrate}, &isActor!{&TestCrate},
                                           |dmut _| => ActorMembers(),
                                           |dmut _, _| { let found: (&SlotRef)? = none; found },
                                           |dmut _, _, _, dmut _| => false));

        let crate_ = if let Ok(c) = actorClass("test-crate") { c } else { assert (false); };
        assert (actorClasses().len == before + 1us && crate_.schema().noun == "test-crate" && crate_.schema().properties.len == 3us);

        assert (unregisterActorClass("test-crate"));
        assert (actorClasses().len == before && !actorClass("test-crate").hasValue && !nodeClass("test-crate").hasValue);
        assert (!unregisterActorClass("test-crate"));
    }

    // the members of the classes left are read again from their probes
    assert (door.schema().properties.len == 10us && door.slots().len == 3us);
}

__test the_built_in_classes_come_first_among_the_node_classes {
    let classes = nodeClasses();
    assert (classes[0].name == "empty" && classes[1].name == "mesh" && classes[9].name == "camera" && classes[9].kind == NodeKind::CAMERA);

    let light = if let Ok(c) = nodeClass("light") { c } else { assert (false); };
    assert (light.kind == NodeKind::LIGHT && light.schema().noun == "light" && light.signals().len == 0us);
    assert (nodeClass("test-door").hasValue && !nodeClass("door").hasValue && !actorClass("light").hasValue);
}

__test the_exported_fields_are_the_properties_of_the_schema_after_the_transform {
    let door = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    let s = door.schema();
    assert (s.noun == "test-door" && s.properties.len == 10us);
    assert (s.properties[3].name == "speed" && s.properties[4].name == "tint" && s.properties[6].name == "key-count");
    assert (s.properties[7].name == "opening" && s.properties[8].name == "label" && s.properties[9].name == "partner");

    let speed = s.properties[3];
    assert (speed.kind == PropertyKind::NUMBER && speed.label == "Opening speed" && speed.group == "Test door");
    assert (speed.range.min == 0.0f && speed.range.max == 10.0f && speed.range.step == 0.5f && speed.range.decimals == 1u32);
    assert (speed.defaultValue == PropertyValue::number(2.0f) && speed.settable());

    let tint = s.properties[4];
    assert (tint.kind == PropertyKind::COLOR && tint.group == "Look" && tint.label == "Tint");
    assert (tint.defaultValue == PropertyValue::color(makeVec3(1.0f, 0.5f, 0.0f)));

    assert (s.properties[5].kind == PropertyKind::BOOL && s.properties[6].kind == PropertyKind::COUNT);
    assert (s.properties[8].kind == PropertyKind::STRING && s.properties[9].kind == PropertyKind::NODE);
    assert (s.groups.len == 3us && s.groups[1].name == "Test door" && s.groups[2].name == "Look");
}

__test an_exported_enum_is_a_choice_of_its_members_in_kebab_case {
    let door = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    let opening = if let Ok(p) = door.schema().property("opening") { p } else { assert (false); };
    assert (opening.kind == PropertyKind::CHOICE && opening.choices.len == 2us);
    assert (opening.choices[0].name == "swing" && opening.choices[1].name == "slide-up" && opening.choices[1].label == "Slide up");
    assert (opening.defaultValue == PropertyValue::choice("slide-up"));
}

__test the_properties_read_and_write_the_fields_the_private_ones_and_through_a_setter {
    let dmut root = copy Root();
    let dmut door = copy TestDoor("door", alias root);
    let cls = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    let s = cls.schema();

    let speed = if let Ok(p) = s.property("speed") { p } else { assert (false); };
    speed.set(alias door, PropertyValue::number(4.5f));
    assert (door.speed() == 4.5f && speed.get(alias door) == PropertyValue::number(4.5f));

    let label = if let Ok(p) = s.property("label") { p } else { assert (false); };
    label.set(alias door, PropertyValue::text("gate"));
    assert (door.label == "gate" && door.labelSet == 1u32);

    let opening = if let Ok(p) = s.property("opening") { p } else { assert (false); };
    opening.set(alias door, PropertyValue::choice("swing"));
    assert (door.opening == Opening::SWING);
}

__test a_node_is_of_the_furthest_actor_class_it_is_of {
    let dmut root = copy Root();
    let door = copy TestDoor("door", alias root);
    let vault = copy TestVault("vault", alias root);
    let empty = copy Empty3D("empty", alias root);

    let ofDoor = if let Ok(c) = actorClassOf(door) { c.name } else { "" };
    let ofVault = if let Ok(c) = actorClassOf(vault) { c.name } else { "" };
    assert (ofDoor == "test-door" && ofVault == "test-vault" && !actorClassOf(empty).hasValue);
    assert (kindOf(vault) == NodeKind::ACTOR && schemaOfNode(vault).noun == "test-vault");
}

__test a_scene_edited_ticks_the_nodes_of_no_actor_class_only {
    let dmut root = copy Root();
    let door = copy TestDoor("door", alias root);
    let vault = copy TestVault("vault", alias root);
    let empty = copy Empty3D("empty", alias root);

    assert (!EditableScene::ticksEdited(door) && !EditableScene::ticksEdited(vault));
    assert (EditableScene::ticksEdited(empty) && EditableScene::ticksEdited(root));
}

__test an_actor_class_over_another_one_has_its_members_then_its_own {
    let vault = if let Ok(c) = actorClass("test-vault") { c } else { assert (false); };
    let s = vault.schema();
    assert (s.properties.len == 11us && s.properties[3].name == "speed" && s.properties[10].name == "code");
    assert (s.properties[10].group == "Test vault");
    assert (vault.ancestors().len == 1us && vault.ancestors()[0].name == "test-door");

    let slots = vault.slots();
    assert (slots.len == 4us && slots[0].name == "open" && slots[3].name == "alarm");
}

__test the_slots_are_the_tagged_methods_the_private_ones_included {
    let door = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    let slots = door.slots();
    assert (slots.len == 3us && slots[0].name == "open" && slots[1].name == "take-hit" && slots[2].name == "slam");
    assert (slots[0].params.len == 0us && slots[1].params.len == 1us && slots[1].params[0] == f32::typeinfo);
}

__test the_signals_are_the_tagged_fields_and_methods {
    let switch = if let Ok(c) = actorClass("test-switch") { c } else { assert (false); };
    let signals = switch.signals();
    assert (signals.len == 2us && signals[0].name == "pressed" && signals[0].payload.len == 0us);
    assert (signals[1].name == "struck" && signals[1].payload.len == 1us && signals[1].payload[0] == f32::typeinfo);
    assert (switch.schema().properties.len == 3us);
}

__test a_signal_connects_to_a_slot_taking_its_payload {
    let dmut root = copy Root();
    let dmut door = copy TestDoor("door", alias root);
    let dmut switch = copy TestSwitch("switch", alias root);
    let dmut box = copy SlotEmitter();

    let doorClass = if let Ok(c) = actorClass("test-door") { c } else { assert (false); };
    let switchClass = if let Ok(c) = actorClass("test-switch") { c } else { assert (false); };

    let open = if let Ok(s) = doorClass.slotOf(alias door, "open") { s } else { assert (false); };
    let hit = if let Ok(s) = doorClass.slotOf(alias door, "take-hit") { s } else { assert (false); };
    assert (!doorClass.slotOf(alias door, "ring").hasValue);

    assert (switchClass.connect(alias switch, "pressed", open, alias box));
    assert (switchClass.connect(alias switch, "struck", hit, alias box));
    assert (!switchClass.connect(alias switch, "pressed", hit, alias box));
    assert (!switchClass.connect(alias switch, "ring", open, alias box));

    switch.pressed:.emit();
    switch:.struckSignal():.emit(3.0f);
    assert (!door.opened);

    box:.emit();
    assert (door.opened && door.hits == 3.0f);
}

__test the_connections_of_the_actors_built_are_made_among_the_nodes_of_the_tree {
    let dmut root = copy Root();
    let door = copy TestDoor("door", alias root);
    let vault = copy TestVault("vault", alias root);
    let dmut switch = copy TestSwitch("switch", alias root);
    let dmut box = copy SlotEmitter();

    switch.connections = copy [NodeConnection(signal-> "pressed", target-> door.guid, slot-> "open"),
                               NodeConnection(signal-> "pressed", target-> vault.guid, slot-> "alarm"),
                               NodeConnection(signal-> "struck", target-> vault.guid, slot-> "take-hit"),
                               NodeConnection(signal-> "pressed", target-> vault.guid, slot-> "ring"),
                               NodeConnection(signal-> "pressed", target-> v4(), slot-> "open"),
                               NodeConnection(signal-> "struck", target-> door.guid, slot-> "open")];

    let dmut built: [&Node3D] = copy [alias switch];
    let errors = connectActors(alias built, alias root, alias box);
    assert (errors.len == 3us);

    switch.pressed:.emit();
    switch:.struckSignal():.emit(2.0f);
    box:.emit();
    assert (door.opened && vault.alarms == 1u32 && vault.hits == 2.0f && door.hits == 0.0f);
}
