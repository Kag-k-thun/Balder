in fixtures;

use balder::core::application::signal;
use balder::math::vector;
use balder::scene::actors::tags;
use balder::scene::node;
use balder::scene::node::node3D;

use std::uuid;

/**
 * How a door of the tests opens
 * */
pub enum Opening : u32
| SWING = 0u32
| SLIDE_UP = 1u32;

/**
 * A door of the tests: properties of every type, private ones and one given through a method, and slots with and
 * without payload
 * */
#[actor ("test-door", category-> "Tests")]
pub class TestDoor over Node3D {

    #[export (label-> "Opening speed", min-> 0.0f, max-> 10.0f, step-> 0.5f, decimals-> 1u32)]
    let mut _speed: f32 = 2.0f;

    #[export (group-> "Look", color-> true)]
    pub let mut tint: vec3 = makeVec3(1.0f, 0.5f, 0.0f);

    #[export]
    pub let mut locked: bool = false;

    #[export (name-> "key-count")]
    pub let mut keys: u32 = 1u32;

    #[export]
    pub let mut opening: Opening = Opening::SLIDE_UP;

    #[export (set-> "setLabel")]
    pub let mut label: [c8] = "door";

    #[export]
    pub let mut partner: Uuid = Uuid::nil();

    // not a property
    pub let mut opened: bool = false;

    pub let mut hits: f32 = 0.0f;

    pub let mut labelSet: u32 = 0u32;

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

    /**
     * @returns: the speed of the door, a private property
     * */
    pub fn speed(self)-> f32 {
        self._speed
    }

    pub fn setLabel(mut self, label: [c8]) {
        self.label = label;
        self.labelSet += 1u32;
    }

    #[slot]
    pub fn open(mut self) {
        self.opened = true;
    }

    #[slot (name-> "take-hit")]
    pub fn hit(mut self, damage: f32) {
        self.hits += damage;
    }

    #[slot]
    prv fn slam(mut self) {
        self.opened = false;
    }

}

/**
 * A switch of the tests: a signal held by a field, and a signal given by a method with a payload
 * */
#[actor ("test-switch", label-> "Switch of the tests", category-> "Tests")]
pub class TestSwitch over Node3D {

    #[emits]
    pub let dmut pressed: &Signal!{()} = copy Signal!{()}();

    let dmut _struck: &Signal!{f32} = copy Signal!{f32}();

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

    #[emits (name-> "struck")]
    pub fn struckSignal(mut self)-> dmut &Signal!{f32} {
        alias self._struck
    }

}

/**
 * A door over the door of the tests, with a property and a slot of its own
 * */
#[actor ("test-vault")]
pub class TestVault over TestDoor {

    #[export]
    pub let mut code: [c8] = "0000";

    pub let mut alarms: u32 = 0u32;

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    #[slot]
    pub fn alarm(mut self) {
        self.alarms += 1u32;
    }

}

/**
 * A crate of the tests, of no tag: registered and unregistered by hand, as the classes of a library loaded then closed
 * */
pub class TestCrate over Node3D {

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}
