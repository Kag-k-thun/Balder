in joint_nodes;

use balder::core::application::signal;
use balder::math::vector;
use balder::scene::physics;
use balder::scene::node::node3D::{body, joint};

use integration::utils::{physics, root};

use std::time;

/**
 * Counts the times the joint it listens to breaks
 * */
class Breaks {

    pub let mut count: u32 = 0u32;

    pub self () {}

    pub fn onBroken(mut self) {
        self.count += 1u32;
    }
}

/**
 * @returns: a dynamic sphere two metres under the origin, under the hook, of a mass
 * */
fn weight(dmut root: &Root, name: [c8], mass: f32 = 1.0f)-> dmut &PhysicsBody3D {
    let dmut b = copy PhysicsBody3D(name, alias root, shape-> ColliderShape::sphere(0.2f),
                                    settings-> BodySettings(motion-> BodyMotion::DYNAMIC, mass-> mass));
    b.position = makeVec3(0.0f, -2.0f, 0.0f);
    alias b
}

/**
 * @returns: the handle of a body in the world, u32::max outside it
 * */
fn handleOf(b: &PhysicsBody3D)-> u32 {
    if let Ok(h) = b.handle { h } else { u32::max }
}

__test a_joint_waits_for_its_two_bodies_and_the_next_tick_and_is_made_where_it_is_placed {
    let dmut root = copy Root();
    let dmut hook = copy PhysicsBody3D("hook", alias root, shape-> cube());
    let dmut ball = weight(alias root, "ball");
    let dmut j = copy Joint3D("rope", alias root, hook, ball);
    let dmut physics = copy ScenePhysics();

    // the joint enters the scene before the ball, and is placed afterwards
    physics:.register(alias hook);
    physics:.registerJoint(alias j);
    physics:.advance(millis(1u64));
    assert(!j.handle.hasValue && physics.world.jointCount == 0us);

    physics:.register(alias ball);
    j.position = makeVec3(0.0f, -1.5f, 0.0f);
    assert(!j.handle.hasValue);
    physics:.advance(millis(1u64));
    assert(j.handle.hasValue && physics.world.jointCount == 1us);

    // its frame is the origin of the node, on both bodies
    if let Ok(h) = j.handle {
        let (fa, fb) = physics.world.jointFrames(h);
        assert((fa.position - fb.position).length() < 1.0e-5f && (fa.position - makeVec3(0.0f, -1.5f, 0.0f)).length() < 1.0e-5f);
        assert(physics.world.getJoint(h).a == handleOf(hook) && physics.world.getJoint(h).b == handleOf(ball));
    }

    // registered again, it stays alone in the world
    physics:.registerJoint(alias j);
    assert(physics.world.jointCount == 1us);

    physics:.removeJoint(alias j);
    assert(!j.handle.hasValue && physics.world.jointCount == 0us);
}

__test a_body_leaving_takes_its_joint_out_until_it_is_back {
    let dmut root = copy Root();
    let dmut hook = copy PhysicsBody3D("hook", alias root, shape-> cube());
    let dmut ball = weight(alias root, "ball");
    let dmut j = copy Joint3D("rope", alias root, hook, ball);
    let dmut physics = copy ScenePhysics();
    physics:.register(alias hook);
    physics:.register(alias ball);
    physics:.registerJoint(alias j);
    physics:.advance(millis(1u64));
    assert(j.handle.hasValue);

    physics:.remove(alias ball);
    assert(!j.handle.hasValue && physics.world.jointCount == 0us);

    physics:.register(alias ball);
    physics:.advance(millis(1u64));
    assert(j.handle.hasValue && physics.world.jointCount == 1us);
}

__test a_node_holds_its_bodies_by_its_settings_and_tells_when_it_breaks {
    let dmut root = copy Root();
    let dmut hook = copy PhysicsBody3D("hook", alias root, shape-> cube());
    let dmut ball = weight(alias root, "ball", mass-> 10.0f);
    let dmut j = copy Joint3D("rope", alias root, hook, ball, settings-> JointSettings(breakForce-> 500.0f));
    j.position = makeVec3(0.0f, -1.5f, 0.0f);

    let dmut box = copy SlotEmitter();
    let dmut breaks = copy Breaks();
    j:.broken():.connect(alias box, &breaks:.onBroken);

    let dmut physics = copy ScenePhysics();
    physics:.register(alias hook);
    physics:.register(alias ball);
    physics:.registerJoint(alias j);

    // the joint holds the 98 N of the weight
    for _ in 0 .. 30 { physics:.advance(millis(17u64)); }
    box:.emit();
    assert(breaks.count == 0u32 && !physics.isJointBroken(j));
    assert(ball.position.y > -2.05f);

    // a weaker joint breaks at the next tick, the weight falling though it was about to sleep, held still until then
    j.settings = JointSettings(breakForce-> 50.0f);
    physics:.jointChanged(j);
    for _ in 0 .. 30 { physics:.advance(millis(17u64)); }
    box:.emit();
    assert(breaks.count == 1u32 && physics.isJointBroken(j));
    assert(ball.position.y < -2.5f);
}
