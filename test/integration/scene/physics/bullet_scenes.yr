in bullet_scenes;

use balder::math::{matrix, quaternion, utils, vector};
use balder::scene::physics;

use integration::utils::{compare, physics};

use std::math;

/**
 * The duration of a step, at 60 steps a second
 * */
def DT = 1.0f / 60.0f;

/**
 * @returns: the settings of a dynamic body of no damping, a bullet or not
 * */
fn moving(bullet: bool = true)-> BodySettings {
    BodySettings(motion-> BodyMotion::DYNAMIC, linearDamping-> 0.0f, angularDamping-> 0.0f, bullet-> bullet)
}

/**
 * @returns: a world without gravity
 * */
fn weightless()-> dmut &PhysicsWorld {
    let dmut world = copy PhysicsWorld();
    world.gravity = vec3();
    alias world
}

/**
 * @returns: a wall 2 cm thick and 40 m wide across X, its face toward the origin at x = 1.49
 * */
fn wallOf(dmut world: &PhysicsWorld, motion: BodyMotion = BodyMotion::STATIC)-> u32 {
    world:.add(ColliderShape::box(makeVec3(0.02f, 40.0f, 40.0f)), translation(makeVec3(1.5f, 0.0f, 0.0f)),
               settings-> BodySettings(motion-> motion))
}

/**
 * Step a world for a duration
 * */
fn run(dmut world: &PhysicsWorld, seconds: f32) {
    for _ in 0 .. cast!i32(seconds / DT + 0.5f) { world:.step(DT); }
}

__test a_plank_spinning_toward_a_thin_wall_as_a_bullet_does_not_pass_it {
    // a plank 2 m long and 2 cm thick, thrown at 50 m/s spinning at 50 rad/s about three axes from twelve angles: as a
    // body that is not a bullet, a few of them pass through, sinking into the wall past its middle
    for k in 0 .. 12 {
        for axis in [makeVec3(0.0f, 1.0f, 0.0f), makeVec3(0.0f, 0.0f, 1.0f), makeVec3(0.0f, 0.7071f, 0.7071f)] {
            let dmut world = weightless();
            wallOf(alias world);
            let phase = Quaternion::fromAxisAngle(cast!f32(k) * 0.26f, axis);
            let plank = world:.add(ColliderShape::box(makeVec3(2.0f, 0.02f, 0.2f)), phase.matrix(), settings-> moving());
            world:.setVelocity(plank, makeVec3(50.0f, 0.0f, 0.0f), axis * 50.0f);

            for _ in 0 .. 60 {
                world:.step(DT);
                assert (world.getState(plank).pose.position.x < 1.49f);
            }
        }
    }
}

__test a_ball_grazing_a_corner_as_a_bullet_keeps_its_speed {
    // a ball of radius 0.1 at 50 m/s passing 1 and 5 cm over the edge of a box; as a body that is not a bullet, the
    // speculative points of the edge, 0.85 m ahead, nearly stop it
    for gap in [0.01f, 0.05f] {
        let dmut world = weightless();
        world:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(0.0f, -0.5f, 0.0f)));
        let ball = world:.add(ColliderShape::sphere(0.1f), translation(makeVec3(-3.0f, 0.1f + gap, 0.0f)),
                              settings-> moving());
        world:.setVelocity(ball, makeVec3(50.0f, 0.0f, 0.0f), vec3());

        run(alias world, 0.2f);
        let s = world.getState(ball);
        assert (near(s.linearVelocity, makeVec3(50.0f, 0.0f, 0.0f), tolerance-> 0.001f));
        assert (near(s.pose.position, makeVec3(7.0f, 0.1f + gap, 0.0f), tolerance-> 0.01f));
    }
}

__test a_ball_thrown_at_a_thin_wall_as_a_bullet_stops_against_it {
    // at 100 m/s, 1.7 m a step, from 0.5 and 1.2 m away, against a static and a kinematic wall
    for motion in [BodyMotion::STATIC, BodyMotion::KINEMATIC] {
        for start in [0.5f, 1.2f] {
            let dmut world = weightless();
            wallOf(alias world, motion-> motion);
            let ball = world:.add(ColliderShape::sphere(0.1f), translation(makeVec3(1.39f - start, 0.0f, 0.0f)),
                                  settings-> moving());
            world:.setVelocity(ball, makeVec3(100.0f, 0.0f, 0.0f), vec3());

            run(alias world, 0.5f);
            let s = world.getState(ball);
            assert (s.pose.position.x < 1.391f && s.pose.position.x > 1.3f);
            assert (math::abs(s.linearVelocity.x) < 0.1f);
        }
    }
}

__test a_ball_thrown_at_a_thin_wall_as_a_bullet_bounces_back_by_its_restitution {
    let dmut world = weightless();
    wallOf(alias world);
    let mut settings = moving();
    settings.restitution = 1.0f;
    let ball = world:.add(ColliderShape::sphere(0.1f), mat4(), settings-> settings);
    world:.setVelocity(ball, makeVec3(100.0f, 0.0f, 0.0f), vec3());

    run(alias world, 0.2f);
    let s = world.getState(ball);
    assert (s.pose.position.x < 0.0f && s.linearVelocity.x < -90.0f);
}

__test a_bullet_passes_through_a_trigger_and_what_its_mask_does_not_see {
    let dmut world = weightless();
    world:.add(ColliderShape::box(makeVec3(0.02f, 4.0f, 4.0f)), translation(makeVec3(1.5f, 0.0f, 0.0f)),
               settings-> BodySettings(trigger-> true));
    world:.add(ColliderShape::box(makeVec3(0.02f, 4.0f, 4.0f)), translation(makeVec3(3.0f, 0.0f, 0.0f)),
               settings-> BodySettings(layer-> 2u32, mask-> 2u32));

    let mut settings = moving();
    settings.mask = 1u32;
    let ball = world:.add(ColliderShape::sphere(0.1f), mat4(), settings-> settings);
    world:.setVelocity(ball, makeVec3(100.0f, 0.0f, 0.0f), vec3());

    run(alias world, 0.1f);
    assert (near(world.getState(ball).pose.position.x, 10.0f, tolerance-> 0.01f));
}

__test a_bullet_rolls_on_a_floor_and_slides_along_a_mesh_without_being_held {
    // a ball rolling at 4 m/s on a plane, and a box sliding at 4 m/s on a mesh of two triangles, both bullets
    let dmut world = copy PhysicsWorld();
    world:.add(ColliderShape::plane(), mat4(), settings-> BodySettings(friction-> 0.0f));
    let mut settings = moving();
    settings.friction = 0.0f;
    let ball = world:.add(ColliderShape::sphere(0.5f), translation(makeVec3(0.0f, 0.5f, 0.0f)), settings-> settings);
    world:.setVelocity(ball, makeVec3(4.0f, 0.0f, 0.0f), makeVec3(0.0f, 0.0f, -8.0f));

    world:.add(ColliderShape::mesh(floorMesh()), translation(makeVec3(0.0f, 0.0f, 20.0f)) * scaling(makeVec3(20.0f, 1.0f, 20.0f)),
               settings-> BodySettings(friction-> 0.0f));
    let box = world:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(-4.0f, 0.5f, 20.0f)),
                         settings-> settings);
    world:.setVelocity(box, makeVec3(4.0f, 0.0f, 0.0f), vec3());

    run(alias world, 1.0f);
    let b = world.getState(ball);
    assert (near(b.pose.position, makeVec3(4.0f, 0.5f, 0.0f), tolerance-> 0.05f) && near(b.linearVelocity.x, 4.0f, tolerance-> 0.01f));

    let s = world.getState(box);
    assert (near(s.pose.position, makeVec3(0.0f, 0.5f, 20.0f), tolerance-> 0.1f) && near(s.linearVelocity.x, 4.0f, tolerance-> 0.01f));
}

__test a_bullet_falling_on_a_thin_floor_lands_and_rests_on_it {
    let dmut world = copy PhysicsWorld();
    world:.add(ColliderShape::box(makeVec3(10.0f, 0.02f, 10.0f)), translation(makeVec3(0.0f, -0.01f, 0.0f)));
    let crate = world:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(0.0f, 5.0f, 0.0f)),
                           settings-> BodySettings(motion-> BodyMotion::DYNAMIC, bullet-> true));
    world:.setVelocity(crate, makeVec3(0.0f, -100.0f, 0.0f), vec3());

    run(alias world, 3.0f);
    let s = world.getState(crate);
    assert (near(s.pose.position.y, 0.5f, tolerance-> 0.01f) && !s.awake);
}


__test a_slow_bullet_is_not_advanced_and_moves_as_a_body_that_is_not_one {
    // a crate of side 1 sliding at 5 m/s and turning slowly, 8 cm a step, less than half its half side, into a wall: as
    // a bullet it is left to its speculative points, which cover its speed as those of any other body
    let mut ends: [vec3] = [];
    for bullet in [false, true] {
        let dmut world = copy PhysicsWorld();
        world:.add(ColliderShape::plane(), mat4(), settings-> BodySettings(friction-> 0.0f));
        wallOf(alias world);
        let crate = world:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(-2.0f, 0.5f, 0.0f)),
                               settings-> BodySettings(motion-> BodyMotion::DYNAMIC, friction-> 0.0f, bullet-> bullet));
        world:.setVelocity(crate, makeVec3(5.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));

        run(alias world, 1.5f);
        ends ~= [world.getState(crate).pose.position];
    }

    // against the wall, its corner turned toward it
    assert (ends[0].x > 0.5f && ends[0].x < 1.0f && near(ends[0], ends[1], tolerance-> 1.0e-6f));
}
