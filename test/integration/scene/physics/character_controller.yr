in character_controller;

use balder::math::{quaternion, utils, vector};
use balder::scene::physics;

use integration::utils::{compare, physics};

use std::math;

__test a_shape_sunk_into_a_body_gets_out_against_the_normal_by_the_depth {
    let world = groundWorld();
    let contacts = world.penetrations(ColliderShape::sphere(1.0f), translation(makeVec3(0.0f, 0.8f, 0.0f)));
    assert(contacts.len == 1us && contacts[0].body == 0u32);
    assert(near(contacts[0].depth, 0.2f, tolerance-> 0.002f));
    assert(near(contacts[0].normal, makeVec3(0.0f, -1.0f, 0.0f), tolerance-> 0.002f));

    assert(world.penetrations(ColliderShape::sphere(1.0f), translation(makeVec3(0.0f, 1.1f, 0.0f))).len == 0us);
    assert(world.penetrations(ColliderShape::sphere(1.0f), translation(makeVec3(0.0f, 0.8f, 0.0f)),
                              filter-> QueryFilter(exclude-> copy [0u32])).len == 0us);
}

__test a_character_falls_onto_the_floor_and_stops_a_skin_above_it {
    let dmut world = groundWorld();
    let h = character(alias world, makeVec3(0.0f, 3.0f, 0.0f));
    let dmut c = copy CharacterController();
    assert(!c.onFloor);

    let v = tick(alias world, alias c, h, makeVec3(0.0f, -10.0f, 0.0f), seconds-> 0.5f);
    assert(near(centreOf(world, h), makeVec3(0.0f, CHARACTER_STANDING, 0.0f), tolerance-> 0.005f));
    assert(c.onFloor && near(c.floorNormal, makeVec3(0.0f, 1.0f, 0.0f), tolerance-> 0.01f));
    assert(c.sinceFloor == 0.0f);
    if let Ok(b) = c.floorBody { assert(b == 0u32); } else { assert(false); }
    assert(near(v, vec3(), tolerance-> 0.001f));
}

__test a_character_sunk_into_the_floor_is_pushed_out_of_it {
    let dmut world = groundWorld();
    let h = character(alias world, makeVec3(0.0f, 0.7f, 0.0f));
    let dmut c = copy CharacterController();

    tick(alias world, alias c, h, vec3());
    assert(near(centreOf(world, h).y, CHARACTER_STANDING, tolerance-> 0.005f) && c.onFloor);
}

__test a_character_walks_on_the_floor_and_slides_along_a_wall {
    let dmut world = groundWorld();
    world:.add(ColliderShape::box(makeVec3(1.0f, 4.0f, 20.0f)), translation(makeVec3(2.5f, 2.0f, 0.0f)));
    let h = character(alias world, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, vec3());

    let v = tick(alias world, alias c, h, makeVec3(4.0f, 0.0f, 4.0f), seconds-> 1.0f);
    let p = centreOf(world, h);
    assert(near(p.x, 2.0f - CHARACTER_RADIUS - 0.01f, tolerance-> 0.01f) && near(p.y, CHARACTER_STANDING, tolerance-> 0.005f));
    assert(p.z > 3.9f && p.z < 4.01f);
    assert(c.onWall && c.onFloor && !c.onCeiling);
    assert(near(v, makeVec3(0.0f, 0.0f, 4.0f), tolerance-> 0.01f));
}

__test a_character_steps_onto_a_low_ledge_but_not_onto_a_high_one {
    let dmut world = groundWorld();
    world:.add(ColliderShape::box(makeVec3(4.0f, 0.2f, 20.0f)), translation(makeVec3(3.5f, 0.1f, 0.0f)));
    world:.add(ColliderShape::box(makeVec3(4.0f, 0.5f, 20.0f)), translation(makeVec3(-3.5f, 0.25f, 0.0f)));

    let low = character(alias world, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, low, vec3());
    tick(alias world, alias c, low, makeVec3(2.0f, 0.0f, 0.0f), seconds-> 1.0f);
    assert(near(centreOf(world, low), makeVec3(2.0f, CHARACTER_STANDING + 0.2f, 0.0f), tolerance-> 0.01f) && c.onFloor);

    world:.remove(low);
    let high = character(alias world, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut d = copy CharacterController();
    tick(alias world, alias d, high, vec3());
    tick(alias world, alias d, high, makeVec3(-2.0f, 0.0f, 0.0f), seconds-> 1.0f);
    let p = centreOf(world, high);
    assert(p.x > -1.5f + CHARACTER_RADIUS - 0.05f && near(p.y, CHARACTER_STANDING, tolerance-> 0.005f) && d.onWall);

    // without a step offset the low ledge stops the character
    let dmut e = copy CharacterController(settings-> CharacterSettings(stepOffset-> 0.0f));
    world:.setTransform(high, translation(makeVec3(0.0f, CHARACTER_STANDING, 0.0f)));
    tick(alias world, alias e, high, vec3());
    tick(alias world, alias e, high, makeVec3(2.0f, 0.0f, 0.0f), seconds-> 1.0f);
    assert(centreOf(world, high).x < 1.5f);
}

__test a_character_stands_still_on_a_gentle_slope_and_slides_down_a_steep_one {
    let dmut world = copy PhysicsWorld();
    slope(alias world, 20.0f);
    let h = character(alias world, makeVec3(0.0f, 1.5f, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, makeVec3(0.0f, -5.0f, 0.0f), seconds-> 0.2f);
    assert(c.onFloor);

    let rest = centreOf(world, h);
    fall(alias world, alias c, h, 40);
    assert(near(centreOf(world, h), rest, tolerance-> 0.01f) && c.onFloor);

    let dmut steep = copy PhysicsWorld();
    slope(alias steep, 60.0f);
    let s = character(alias steep, makeVec3(0.0f, 1.5f, 0.0f));
    let dmut d = copy CharacterController();
    let start = centreOf(steep, s);
    fall(alias steep, alias d, s, 20);
    let p = centreOf(steep, s);
    assert(p.x < start.x - 0.2f && p.y < start.y - 0.2f && !d.onFloor && d.onWall);
}

__test a_character_walks_up_a_gentle_slope_but_not_up_a_steep_one {
    let dmut world = groundWorld();
    let q = Quaternion::fromAxisAngle(cast!f32(math::PI) * 20.0f / 180.0f, makeVec3(0.0f, 0.0f, 1.0f));
    world:.add(ColliderShape::box(makeVec3(10.0f, 1.0f, 20.0f)), translation(makeVec3(6.0f, 0.0f, 0.0f)) * q.matrix());
    let h = character(alias world, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, vec3());
    fall(alias world, alias c, h, 60, walk-> makeVec3(2.0f, 0.0f, 0.0f));
    let p = centreOf(world, h);
    assert(p.x > 4.0f && p.y > CHARACTER_STANDING + 0.4f && c.onFloor);

    let dmut steep = groundWorld();
    let r = Quaternion::fromAxisAngle(cast!f32(math::PI) * 60.0f / 180.0f, makeVec3(0.0f, 0.0f, 1.0f));
    steep:.add(ColliderShape::box(makeVec3(10.0f, 1.0f, 20.0f)), translation(makeVec3(4.0f, 0.0f, 0.0f)) * r.matrix());
    let s = character(alias steep, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut d = copy CharacterController();
    tick(alias steep, alias d, s, vec3());
    fall(alias steep, alias d, s, 60, walk-> makeVec3(2.0f, 0.0f, 0.0f));
    assert(centreOf(steep, s).y < CHARACTER_STANDING + 0.35f && d.onFloor);
}

__test a_character_walking_down_a_slope_keeps_to_the_ground_within_the_snap_distance {
    let dmut world = copy PhysicsWorld();
    slope(alias world, 20.0f);
    let h = character(alias world, makeVec3(0.0f, 1.5f, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, makeVec3(0.0f, -5.0f, 0.0f), seconds-> 0.2f);
    for _ in 0 .. 10 {
        tick(alias world, alias c, h, makeVec3(-6.0f, 0.0f, 0.0f));
        assert(c.onFloor);
    }

    let dmut d = copy CharacterController(settings-> CharacterSettings(snapDistance-> 0.0f));
    world:.setTransform(h, translation(makeVec3(0.0f, 1.5f, 0.0f)));
    tick(alias world, alias d, h, makeVec3(0.0f, -5.0f, 0.0f), seconds-> 0.2f);
    assert(d.onFloor);
    tick(alias world, alias d, h, makeVec3(-6.0f, 0.0f, 0.0f));
    assert(!d.onFloor);
}

__test a_character_can_jump_a_little_after_it_walked_off_a_ledge {
    let dmut world = copy PhysicsWorld();
    world:.add(ColliderShape::box(makeVec3(10.0f, 1.0f, 10.0f)), translation(makeVec3(-5.0f, -0.5f, 0.0f)));
    let h = character(alias world, makeVec3(-1.0f, CHARACTER_STANDING, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, vec3());
    assert(c.onFloor && c.canJump);

    c:.jumped();
    assert(!c.canJump);
    tick(alias world, alias c, h, vec3());
    assert(c.canJump);

    let mut ticks = 0;
    while c.onFloor && ticks < 40 {
        fall(alias world, alias c, h, 1, walk-> makeVec3(2.0f, 0.0f, 0.0f));
        ticks += 1;
    }

    assert(!c.onFloor && c.canJump && near(c.sinceFloor, TICK));
    fall(alias world, alias c, h, 3, walk-> makeVec3(2.0f, 0.0f, 0.0f));
    assert(!c.canJump);
}

__test a_character_pushes_a_dynamic_body_without_being_pushed {
    let dmut world = groundWorld();
    let crate = world:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(1.5f, 0.5f, 0.0f)),
                           settings-> BodySettings(motion-> BodyMotion::DYNAMIC, mass-> 10.0f));
    let h = character(alias world, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, vec3());

    let v = tick(alias world, alias c, h, makeVec3(2.0f, 0.0f, 0.0f), seconds-> 0.5f);
    assert(near(v.x, 0.0f, tolerance-> 0.01f));

    // the speed of the character times the mass of the crate, lighter than pushMass, on the crate
    let pushed = world.getState(crate).linearVelocity;
    assert(pushed.x > 1.5f && pushed.x < 2.5f);

    let at = centreOf(world, h);
    world:.step(1.0f / 60.0f);
    assert(near(centreOf(world, h), at));
    assert(world.getState(crate).pose.position.x > 1.5f);

    // a body heavier than pushMass takes the momentum of pushMass only
    let dmut heavy = groundWorld();
    let rock = heavy:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(1.5f, 0.5f, 0.0f)),
                          settings-> BodySettings(motion-> BodyMotion::DYNAMIC, mass-> 400.0f));
    let k = character(alias heavy, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut d = copy CharacterController();
    tick(alias heavy, alias d, k, vec3());
    tick(alias heavy, alias d, k, makeVec3(2.0f, 0.0f, 0.0f), seconds-> 0.5f);
    assert(near(heavy.getState(rock).linearVelocity.x, 2.0f * 40.0f / 400.0f, tolerance-> 0.05f));
}

__test a_body_walked_into_tick_after_tick_moves_at_the_speed_of_the_character_not_faster {
    let dmut world = groundWorld();
    let crate = world:.add(ColliderShape::box(makeVec3(1.0f, 1.0f, 1.0f)), translation(makeVec3(1.5f, 0.5f, 0.0f)),
                           settings-> BodySettings(motion-> BodyMotion::DYNAMIC, mass-> 10.0f, friction-> 0.0f));
    let h = character(alias world, makeVec3(0.0f, CHARACTER_STANDING, 0.0f));
    let dmut c = copy CharacterController();
    tick(alias world, alias c, h, vec3());

    // the character walks into the crate for a second, the world stepped after each move
    let mut fastest = 0.0f;
    for _ in 0 .. 60 {
        tick(alias world, alias c, h, makeVec3(2.0f, 0.0f, 0.0f));
        world:.step(TICK);
        let x = world.getState(crate).linearVelocity.x;
        if x > fastest { fastest = x; }
    }

    assert(fastest > 1.5f && fastest < 2.2f);
}
