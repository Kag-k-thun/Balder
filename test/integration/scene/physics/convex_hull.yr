in convex_hull;


use balder::core::error;
use balder::math::{inertia, vector};
use balder::scene::physics;

use integration::utils::compare;

use std::math;

/**
 * @returns: the corners of a cube of a half side, centred on a point
 * */
fn corners(half: f32, centre: vec3 = vec3())-> [vec3] {
    let mut result: [vec3] = [];
    for x in [-half, half] { for y in [-half, half] { for z in [-half, half] {
        result ~= [centre + makeVec3(x, y, z)];
    }}}

    result
}

__test the_hull_of_a_cube_and_points_inside_keeps_its_corners_only {
    let points = corners(1.0f) ~ [vec3(), makeVec3(0.5f, -0.2f, 0.1f), makeVec3(-0.9f, 0.9f, 0.0f)];
    let hull = copy ConvexHull(points);
    assert(hull.vertices.len == 8us && hull.faces.len == 12us);
}

__test every_point_is_behind_every_face_of_its_hull {
    // points on a sphere and inside it, in no order
    let mut points: [vec3] = [];
    for i in 0 .. 300 {
        let a = cast!f32(i) * 2.399963f, z = 1.0f - cast!f32(i % 150) / 75.0f;
        let r = math::sqrt(1.0f - z * z) * (if i % 2 == 0 { 1.0f } else { 0.6f });
        points ~= [makeVec3(math::cos(a) * r, z, math::sin(a) * r)];
    }

    let hull = copy ConvexHull(points);
    for f in hull.faces {
        assert(near(f.normal.length(), 1.0f));
        for p in points { assert(f.normal.dot(p) - f.offset < 0.0001f); }
    }
}

__test the_hull_of_a_cube_has_its_volume_its_centroid_and_its_inertia {
    // a cube of side 2 around (1, 2, 3): a volume of 8, and at a density of 1 the moments of a box of 8 kg
    let hull = copy ConvexHull(corners(1.0f, centre-> makeVec3(1.0f, 2.0f, 3.0f)));
    let expected = boxInertia(8.0f, makeVec3(2.0f, 2.0f, 2.0f));
    assert(near(hull.volume, 8.0f));
    assert((hull.centroid - makeVec3(1.0f, 2.0f, 3.0f)).length() < 0.0001f);
    assert(near(hull.unitInertia.a1, expected.x) && near(hull.unitInertia.b2, expected.y) && near(hull.unitInertia.c3, expected.z));
    assert(near(hull.unitInertia.b1, 0.0f) && near(hull.unitInertia.c1, 0.0f));
}

__test points_on_a_plane_make_no_hull {
    let thrown = {
        copy ConvexHull(copy [makeVec3(0.0f, 0.0f, 0.0f),
                              makeVec3(1.0f, 0.0f, 0.0f),
                              makeVec3(0.0f, 0.0f, 1.0f),
                              makeVec3(1.0f, 0.0f, 1.0f),
                              makeVec3(0.5f, 0.0f, 0.5f)]);
        false
    } catch {
        _: &BalderError => { true }
    };

    assert(thrown);
}

__test a_hull_scaled_by_a_mirror_keeps_its_faces_pointing_out {
    let hull = (copy ConvexHull(corners(1.0f))).scaled(makeVec3(-2.0f, 1.0f, 1.0f));
    assert(near(hull.volume, 16.0f));
    for f in hull.faces { assert(f.offset > 0.0f); }
}
