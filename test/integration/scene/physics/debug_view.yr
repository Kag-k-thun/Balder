in debug_view;

use balder::math::{bounds, matrix, utils, vector};
use balder::scene::debug;
use balder::scene::physics;
use balder::scene::physics::debug_view;

use integration::utils::physics;

/**
 * @returns: the segments of the debug view of a world, of categories
 * */
fn drawn(world: &PhysicsWorld, categories: u32)-> [DebugSegment] {
    let dmut lines = copy DebugLines();
    debug_view::drawWorld(alias lines, world, categories);
    lines.segments
}

/**
 * @returns: the number of segments of a colour
 * */
fn countOf(segments: [DebugSegment], color: u32)-> usize {
    let mut n = 0us;
    for s in segments if s.color == color { n += 1us; }
    n
}

/**
 * @returns: a colour packed as a segment holds it
 * */
fn packed(c: vec4)-> u32 {
    DebugSegment(vec3(), vec3(), c).color
}

__test the_debug_view_draws_the_categories_asked_only {
    let dmut world = copy PhysicsWorld();
    world:.add(cube(), mat4());
    world:.add(cube(), translation(makeVec3(5.0f, 0.0f, 0.0f)));

    assert(drawn(world, PhysicsDebug::NONE).len == 0us);

    // the twelve edges of each box, then the twelve edges of each of their bounds
    assert(drawn(world, PhysicsDebug::SHAPES).len == 24us);
    assert(drawn(world, PhysicsDebug::BOXES).len == 24us);
    assert(drawn(world, PhysicsDebug::SHAPES | PhysicsDebug::BOXES).len == 48us);

    // no pair of static bodies touches, but the hierarchy holds their two leaves under a root
    assert(drawn(world, PhysicsDebug::CONTACTS).len == 0us);
    assert(drawn(world, PhysicsDebug::BROADPHASE).len == 36us);
}

__test the_colliders_are_coloured_by_the_motion_and_the_sleep_of_their_bodies {
    let dmut world = copy PhysicsWorld();
    world:.add(ColliderShape::plane(), mat4());
    let crate = world:.add(cube(), translation(makeVec3(0.0f, 1.0f, 0.0f)), settings-> BodySettings(motion-> BodyMotion::DYNAMIC));
    world:.add(cube(), translation(makeVec3(5.0f, 3.0f, 0.0f)), settings-> BodySettings(motion-> BodyMotion::KINEMATIC));
    world:.add(cube(), translation(makeVec3(-5.0f, 3.0f, 0.0f)), settings-> BodySettings(trigger-> true));

    let awake = drawn(world, PhysicsDebug::SHAPES);
    assert(countOf(awake, packed(makeVec4(1.0f, 0.6f, 0.1f, 1.0f))) == 12us);
    assert(countOf(awake, packed(makeVec4(0.3f, 0.6f, 1.0f, 1.0f))) == 12us);
    assert(countOf(awake, packed(makeVec4(1.0f, 0.9f, 0.2f, 1.0f))) == 12us);

    // the plane is a grid and the arrow of its normal
    assert(countOf(awake, packed(makeVec4(0.6f, 0.6f, 0.6f, 1.0f))) == 2us * 11us + 5us);

    for _ in 0 .. 240 { world:.step(1.0f / 60.0f); }
    assert(!world.getState(crate).awake);
    assert(countOf(drawn(world, PhysicsDebug::SHAPES), packed(makeVec4(0.3f, 0.75f, 0.45f, 1.0f))) == 12us);

    // the box resting on the plane touches it by its lower corners, each a cross and the arrow of its normal
    let contacts = drawn(world, PhysicsDebug::CONTACTS);
    assert(countOf(contacts, packed(makeVec4(1.0f, 0.15f, 0.15f, 1.0f))) >= 4us * 3us);
    assert(countOf(contacts, packed(makeVec4(1.0f, 1.0f, 0.3f, 1.0f))) == 5us * countOf(contacts, packed(makeVec4(1.0f, 0.15f, 0.15f, 1.0f))) / 3us);
}

__test the_settings_of_a_body_out_of_a_world_give_the_colours_of_the_debug_view {
    assert(debug_view::colorOfSettings(BodySettings()) == makeVec4(0.6f, 0.6f, 0.6f, 1.0f));
    assert(debug_view::colorOfSettings(BodySettings(motion-> BodyMotion::KINEMATIC)) == makeVec4(0.3f, 0.6f, 1.0f, 1.0f));
    assert(debug_view::colorOfSettings(BodySettings(motion-> BodyMotion::DYNAMIC)) == makeVec4(1.0f, 0.6f, 0.1f, 1.0f));
    assert(debug_view::colorOfSettings(BodySettings(motion-> BodyMotion::DYNAMIC, trigger-> true)) == makeVec4(1.0f, 0.9f, 0.2f, 1.0f));
}

__test the_hierarchy_of_the_bodies_is_given_a_parent_before_its_children {
    let dmut world = copy PhysicsWorld();
    for i in 0 .. 5 {
        world:.add(cube(), translation(makeVec3(cast!f32(i) * 4.0f, 0.0f, 0.0f)));
    }

    let nodes = world.hierarchy.nodeBoxes();
    assert(nodes.len == 9us);

    let (root, depth, leaf) = nodes[0];
    assert(depth == 0u32 && !leaf && root.contains(world.hierarchy.bounds));

    let mut leaves = 0us;
    let mut roots = 0us;
    for n in nodes {
        let (box, d, l) = n;
        assert(root.contains(box));
        if l { leaves += 1us; }
        if d == 0u32 { roots += 1us; }
    }

    assert(leaves == 5us && roots == 1us);
    let empty = copy Bvh();
    assert(empty.nodeBoxes().len == 0us);
}

__test the_joints_are_drawn_by_their_anchors_their_arms_and_the_axes_of_the_hinges {
    let dmut world = copy PhysicsWorld();
    let post = world:.add(cube(), mat4());
    let ball = world:.add(ColliderShape::sphere(0.5f), translation(makeVec3(0.0f, -3.0f, 0.0f)),
                          settings-> BodySettings(motion-> BodyMotion::DYNAMIC));
    let door = world:.add(cube(), translation(makeVec3(4.0f, 0.0f, 0.0f)), settings-> BodySettings(motion-> BodyMotion::DYNAMIC));
    world:.addJoint(post, ball, frameAt(makeVec3(0.0f, -1.0f, 0.0f)));
    let hinge = world:.addJoint(post, door, frameAt(makeVec3(2.0f, 0.0f, 0.0f), axis-> makeVec3(0.0f, 1.0f, 0.0f)),
                                settings-> JointSettings(kind-> JointKind::HINGE));

    // two arms and two crosses of three segments by joint, and the arrow of the axis of the hinge
    let joints = drawn(world, PhysicsDebug::JOINTS);
    assert(countOf(joints, packed(makeVec4(0.95f, 0.35f, 0.8f, 1.0f))) == 2us * (2us + 2us * 3us));
    assert(countOf(joints, packed(makeVec4(1.0f, 0.75f, 0.95f, 1.0f))) == 5us);
    assert(joints.len == 21us);
    assert(drawn(world, PhysicsDebug::SHAPES | PhysicsDebug::CONTACTS | PhysicsDebug::BOXES | PhysicsDebug::BROADPHASE).len + joints.len == drawn(world, PhysicsDebug::ALL).len);

    world:.removeJoint(hinge);
    assert(drawn(world, PhysicsDebug::JOINTS).len == 8us);
}
