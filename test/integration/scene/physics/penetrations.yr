in penetrations;

use balder::math::{bounds, quaternion, utils, vector};
use balder::scene::physics;
use balder::scene::physics::gjk;
use balder::scene::physics::narrow::primitives;

use integration::utils::compare;

use std::math;

/**
 * @returns: the convex box of side 2 at a position, turned
 * */
fn boxAt(at: vec3, q: Quaternion = Quaternion())-> Convex {
    Collider(ColliderShape::box(makeVec3(2.0f, 2.0f, 2.0f)), translation(at) * q.matrix()).convex()
}

__test two_boxes_overlap_along_the_axis_they_overlap_the_least {
    if let Ok(p) = gjk::penetration(boxAt(vec3()), boxAt(makeVec3(1.9f, 0.5f, 0.0f))) {
        assert(near(p.depth, 0.1f, tolerance-> 0.001f) && near(p.normal, makeVec3(1.0f, 0.0f, 0.0f), tolerance-> 0.001f));
        assert(near(p.pointA.x, 1.0f, tolerance-> 0.001f) && near(p.pointB.x, 0.9f, tolerance-> 0.001f));
    } else { assert(false); }

    assert(!gjk::penetration(boxAt(vec3()), boxAt(makeVec3(2.1f, 0.0f, 0.0f))).hasValue);
}

__test a_turned_box_sunk_by_its_corner_overlaps_by_the_depth_of_the_corner {
    // its lowest corner sqrt (2) under its centre, the centre 2.3 above the other's: 0.114 deep
    let q = Quaternion::fromAxisAngle(cast!f32(math::PI) / 4.0f, makeVec3(0.0f, 0.0f, 1.0f));
    if let Ok(p) = gjk::penetration(boxAt(vec3()), boxAt(makeVec3(0.0f, 2.3f, 0.0f), q-> q)) {
        assert(near(p.depth, 2.0f - 2.3f + math::sqrt(2.0f) - 1.0f, tolerance-> 0.002f));
        assert(near(p.normal, makeVec3(0.0f, 1.0f, 0.0f), tolerance-> 0.002f));
    } else { assert(false); }
}

__test faces_exactly_flush_touch_without_depth {
    if let Ok(p) = gjk::penetration(boxAt(vec3()), boxAt(makeVec3(2.0f, 0.0f, 0.0f))) {
        assert(near(p.depth, 0.0f, tolerance-> 0.0005f));
    } else { assert(false); }
}

__test a_box_inside_another_leaves_by_its_closest_face {
    let small = Convex::box(makeVec3(0.0f, 0.7f, 0.0f), makeVec3(0.1f, 0.0f, 0.0f), makeVec3(0.0f, 0.1f, 0.0f),
                            makeVec3(0.0f, 0.0f, 0.1f));
    if let Ok(p) = gjk::penetration(boxAt(vec3()), small) {
        assert(near(p.depth, 0.4f, tolerance-> 0.001f) && near(p.normal, makeVec3(0.0f, 1.0f, 0.0f), tolerance-> 0.001f));
    } else { assert(false); }
}

__test two_spheres_whose_cores_are_apart_overlap_by_their_radii_less_their_distance {
    if let Ok(p) = gjk::penetration(Convex::sphere(vec3(), 1.0f), Convex::sphere(makeVec3(0.0f, 1.5f, 0.0f), 1.0f)) {
        assert(near(p.depth, 0.5f) && near(p.normal, makeVec3(0.0f, 1.0f, 0.0f)));
        assert(near(p.pointA, makeVec3(0.0f, 1.0f, 0.0f)) && near(p.pointB, makeVec3(0.0f, 0.5f, 0.0f)));
    } else { assert(false); }
}

__test two_spheres_apart_make_a_speculative_point_only_within_the_distance {
    assert(!primitives::spheres(vec3(), 1.0f, makeVec3(2.05f, 0.0f, 0.0f), 1.0f, 0.02f).hasValue);
    if let Ok(m) = primitives::spheres(vec3(), 1.0f, makeVec3(2.01f, 0.0f, 0.0f), 1.0f, 0.02f) {
        assert(m.points.len == 1us && near(m.points[0].depth, -0.01f) && !m.touching);
        assert(near(m.normal, makeVec3(1.0f, 0.0f, 0.0f)));
    } else { assert(false); }
}

__test a_sphere_touches_a_capsule_at_the_closest_point_of_its_segment {
    if let Ok(m) = primitives::sphereCapsule(makeVec3(2.6f, 0.3f, 0.0f), 0.5f, makeVec3(-2.0f, 0.0f, 0.0f),
                                             makeVec3(2.0f, 0.0f, 0.0f), 0.5f, 0.02f) {
        let d = makeVec3(-0.6f, -0.3f, 0.0f);
        assert(near(m.normal, d.normalized()) && near(m.points[0].depth, 1.0f - d.length()));
    } else { assert(false); }
}

__test two_crossed_capsules_touch_at_the_closest_points_of_their_segments {
    if let Ok(m) = primitives::capsules(makeVec3(-2.0f, 0.0f, 0.0f), makeVec3(2.0f, 0.0f, 0.0f), 0.5f,
                                        makeVec3(0.5f, 0.9f, -2.0f), makeVec3(0.5f, 0.9f, 2.0f), 0.5f, 0.02f) {
        assert(m.points.len == 1us && near(m.normal, makeVec3(0.0f, 1.0f, 0.0f)) && near(m.points[0].depth, 0.1f));
        assert(near(m.points[0].localA, makeVec3(0.5f, 0.5f, 0.0f)) && near(m.points[0].localB, makeVec3(0.5f, 0.4f, 0.0f)));
    } else { assert(false); }

    // past the end of the first segment: its end against the closest point of the second
    if let Ok(m) = primitives::capsules(makeVec3(-2.0f, 0.0f, 0.0f), makeVec3(2.0f, 0.0f, 0.0f), 0.5f,
                                        makeVec3(2.3f, 0.9f, -2.0f), makeVec3(2.3f, 0.9f, 2.0f), 0.5f, 0.02f) {
        let d = makeVec3(0.3f, 0.9f, 0.0f);
        assert(near(m.normal, d.normalized()) && near(m.points[0].depth, 1.0f - d.length()));
    } else { assert(false); }
}

__test a_capsule_lying_on_another_touches_at_the_two_ends_of_their_overlap {
    if let Ok(m) = primitives::capsules(makeVec3(-2.0f, 0.0f, 0.0f), makeVec3(2.0f, 0.0f, 0.0f), 0.5f,
                                        makeVec3(-1.0f, 0.9f, 0.0f), makeVec3(5.0f, 0.9f, 0.0f), 0.5f, 0.02f) {
        assert(m.points.len == 2us && near(m.normal, makeVec3(0.0f, 1.0f, 0.0f)));
        assert(near(m.points[0].depth, 0.1f) && near(m.points[1].depth, 0.1f));
        assert(near(m.points[0].localA.x, -1.0f) && near(m.points[1].localA.x, 2.0f));
    } else { assert(false); }
}

__test a_sphere_in_a_box_leaves_by_its_closest_face_and_outside_by_its_closest_point {
    let b = boxAt(vec3());
    if let Ok(m) = primitives::sphereBox(makeVec3(0.0f, 0.8f, 0.0f), 0.5f, b.a, b.u, b.v, b.w, 0.02f) {
        assert(near(m.normal, makeVec3(0.0f, 1.0f, 0.0f)) && near(m.points[0].depth, 0.7f));
    } else { assert(false); }

    if let Ok(m) = primitives::sphereBox(makeVec3(1.3f, 1.4f, 0.0f), 0.6f, b.a, b.u, b.v, b.w, 0.02f) {
        assert(near(m.normal, makeVec3(0.6f, 0.8f, 0.0f)) && near(m.points[0].depth, 0.1f));
        assert(near(m.points[0].localA, makeVec3(1.0f, 1.0f, 0.0f)));
    } else { assert(false); }
}

__test a_capsule_lying_on_a_plane_touches_at_its_two_ends_a_sphere_at_one_point {
    let ground = Plane(makeVec4(0.0f, 1.0f, 0.0f, 0.0f));
    if let Ok(m) = primitives::capsulePlane(ground, makeVec3(-1.0f, 0.49f, 0.0f), makeVec3(1.0f, 0.49f, 0.0f), 0.5f, 0.02f) {
        assert(m.points.len == 2us && near(m.points[0].depth, 0.01f) && near(m.points[1].depth, 0.01f));
        assert(near(m.points[0].localA, makeVec3(-1.0f, 0.0f, 0.0f)) && near(m.points[0].localB, makeVec3(-1.0f, -0.01f, 0.0f)));
    } else { assert(false); }

    if let Ok(m) = primitives::capsulePlane(ground, makeVec3(0.0f, 0.49f, 0.0f), makeVec3(0.0f, 0.49f, 0.0f), 0.5f, 0.02f) {
        assert(m.points.len == 1us);
    } else { assert(false); }

    assert(!primitives::capsulePlane(ground, makeVec3(0.0f, 0.6f, 0.0f), makeVec3(0.0f, 0.6f, 0.0f), 0.5f, 0.02f).hasValue);
}
