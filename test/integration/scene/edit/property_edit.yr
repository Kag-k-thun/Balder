in property_edit;

use balder::math::vector;
use balder::scene::edit::property_edit;
use balder::scene::node::node3D::light;
use balder::scene::property::value;

use integration::utils::{compare, root};

__test an_edit_of_a_property_gives_its_value_then_gives_the_one_before_back {
    let dmut root = copy Root();
    let dmut l = copy Light("lamp", alias root);
    let intensity = if let Ok(p) = Light::schema().property("intensity") { p } else { assert (false); };

    let mut edit = PropertyEdit(alias l, intensity, PropertyValue::number(5.0f));
    assert (edit.before == PropertyValue::number(1.0f) && edit.check().len == 0us);

    edit:.apply();
    assert (near(l.intensity, 5.0f));
    edit:.revert();
    assert (near(l.intensity, 1.0f));
}

__test an_edit_extended_goes_from_its_value_before_to_the_value_after_the_next_one {
    let dmut root = copy Root();
    let dmut l = copy Light("lamp", alias root);
    let range = if let Ok(p) = Light::schema().property("range") { p } else { assert (false); };

    let mut first = PropertyEdit(alias l, range, PropertyValue::number(12.0f));
    first:.apply();
    let second = PropertyEdit(alias l, range, PropertyValue::number(14.0f));

    let mut merged = first:.extendedTo(second.after);
    assert (merged.before == PropertyValue::number(10.0f) && merged.after == PropertyValue::number(14.0f));
    merged:.apply();
    assert (near(l.range, 14.0f));
    merged:.revert();
    assert (near(l.range, 10.0f));
}

__test an_edit_tells_why_its_node_refuses_its_value {
    let dmut root = copy Root();
    let dmut l = copy Light("lamp", alias root);
    let direction = if let Ok(p) = Light::schema().property("direction") { p } else { assert (false); };
    assert (PropertyEdit(alias l, direction, PropertyValue::vector(vec3())).check().len != 0us);
}
