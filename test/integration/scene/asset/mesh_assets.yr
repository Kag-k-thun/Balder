in mesh_assets;

use balder::core::error;
use balder::math::vector;
use balder::scene::asset::{assets, material_asset, mesh_asset};
use balder::scene::node::node3D::visual::primitive;

use integration::utils::compare;

use std::{io, uuid};

// A model of the resources of the engine, one mesh of one material
def CUBE_MODEL = "res:/models/cube/cube.obj";

__test a_built_in_mesh_is_one_part_of_the_default_material_shared_by_every_node {
    {
        let cube = Assets::mesh(MeshAsset::CUBE);
        assert (cube.primitive == Primitive::CUBE && cube.subMeshes.len == 1us && cube.materials.len == 0us);
        assert (cube.subMeshes[0us].material.path == MaterialAsset::DEFAULT && !cube.subMeshes[0us].textured);
        assert (near(cube.aabb.min, makeVec3(-0.5f, 0.0f, -0.5f)) && near(cube.aabb.max, makeVec3(0.5f, 1.0f, 0.5f)));

        // a built-in mesh has no levels of detail to build, both asking for the same
        assert (Assets::mesh(MeshAsset::CUBE) is cube && Assets::mesh(MeshAsset::CUBE, lods-> false) is cube);
        assert (MeshAsset::primitiveOf(MeshAsset::PLANE) == Primitive::PLANE && MeshAsset::pathOf(Primitive::SPHERE) == MeshAsset::SPHERE);
        assert (MeshAsset::primitiveOf(CUBE_MODEL) == Primitive::NONE);
    } catch {
        err => { println(err); assert (false); }
    }
}

__test a_model_file_is_a_mesh_of_its_parts_drawn_by_default_with_its_materials {
    {
        let model = Assets::mesh(CUBE_MODEL, lods-> false);
        assert (model.path == CUBE_MODEL && !model.lods && model.primitive == Primitive::NONE);
        assert (model.subMeshes.len == 1us && !model.skeleton.hasValue);
        assert (near(model.aabb.min, makeVec3(-0.5f, 0.0f, -0.5f)) && near(model.aabb.max, makeVec3(0.5f, 1.0f, 0.5f)));

        // the materials of the file are embedded in the asset, each named by the file and its index
        assert (model.materials.len != 0us);
        for i, m in model.materials {
            assert (m.isEmbedded && m.path == MaterialAsset::embeddedPath(CUBE_MODEL, i) && m.name.len != 0us);
        }

        let part = model.subMeshes[0us];
        let mut found = false;
        for m in model.materials if m is part.material { found = true; }
        assert (found);

        // an embedded material is found by its path, the model loaded
        assert (Assets::material(part.material.path) is part.material);

        // the levels of detail make a mesh of their own
        assert (!(Assets::mesh(CUBE_MODEL, lods-> true) is model) && Assets::mesh(CUBE_MODEL, lods-> false) is model);
    } catch {
        err => { println(err); assert (false); }
    }
}

__test a_material_is_registered_found_by_its_path_and_forgotten {
    {
        let default = Assets::material(MaterialAsset::DEFAULT);
        assert (default.path == MaterialAsset::DEFAULT && Assets::material(MaterialAsset::DEFAULT) is default);

        let local = Assets::register(copy MaterialAsset::local(v4(), "red"));
        assert (Assets::material(local.path) is local);

        Assets::forget(local.path);
        let thrown = {
            Assets::material(local.path);
            false
        } catch {
            _: &BalderError => { true }
        };

        assert (thrown);
    } catch {
        err => { println(err); assert (false); }
    }
}

__test a_missing_asset_is_an_error {
    let mesh = {
        Assets::mesh("res:/models/none.glb");
        false
    } catch {
        _: &BalderError => { true }
    };

    let embedded = {
        Assets::material(MaterialAsset::embeddedPath(CUBE_MODEL, 99us));
        false
    } catch {
        _: &BalderError => { true }
    };

    let file = {
        Assets::material("res:/materials/none.material");
        false
    } catch {
        _: &BalderError => { true }
    };

    assert (mesh && embedded && file);
}

__test the_hulls_and_the_triangles_of_a_mesh_are_those_of_its_parts {
    {
        let model = Assets::mesh(CUBE_MODEL, lods-> false);
        assert (model.triangles().len == 12us);
        assert (near(model.hulls().localBox().max, makeVec3(0.5f, 1.0f, 0.5f)));
    } catch {
        err => { println(err); assert (false); }
    }
}
