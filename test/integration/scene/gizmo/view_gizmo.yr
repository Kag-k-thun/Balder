in view_gizmo;

use balder::math::vector;
use balder::scene::gizmo::{axis_view, view_gizmo};

// The axes of a camera on +Z looking at the origin, its top along +Y (see facing)
def X = makeVec3(1.0f, 0.0f, 0.0f);
def Y = makeVec3(0.0f, 1.0f, 0.0f);
def Z = makeVec3(0.0f, 0.0f, 1.0f);

__test seen_from_the_front_x_is_on_the_left_y_up_and_z_at_the_eye {
    for e in ViewGizmo::endsOf(X, Y, Z) {
        if e.view == AxisView::RIGHT { assert (e.offset.x < 0.0f && e.offset.y == 0.0f); }
        if e.view == AxisView::TOP { assert (e.offset.y < 0.0f && e.offset.x == 0.0f); }
        if e.view == AxisView::FRONT { assert (e.offset.length() < 1.0e-4f && e.toward > 0.99f); }
        if e.view == AxisView::BACK { assert (e.toward < -0.99f); }
    }
}

__test the_end_at_the_eye_is_picked_over_the_one_behind_it {
    let picked = ViewGizmo::endUnder(ViewGizmo::endsOf(X, Y, Z), vec2());
    if let Ok(v) = picked { assert (v == AxisView::FRONT); } else { assert (false); }
}

__test the_hollow_end_of_x_gives_the_left_view {
    // +X is drawn on the left of the centre, so -X is on its right
    let picked = ViewGizmo::endUnder(ViewGizmo::endsOf(X, Y, Z), makeVec2(27.0f, 0.0f));
    if let Ok(v) = picked { assert (v == AxisView::LEFT); } else { assert (false); }
}

__test off_the_ends_nothing_is_picked {
    assert (!ViewGizmo::endUnder(ViewGizmo::endsOf(X, Y, Z), makeVec2(18.0f, 18.0f)).hasValue);
}

__test seen_from_above_z_goes_down_the_image {
    // a camera on +Y, its top toward -Z (see facing): +Z is at the bottom of the image, Y at the eye
    for e in ViewGizmo::endsOf(X, makeVec3(0.0f, 0.0f, -1.0f), Y) {
        if e.view == AxisView::FRONT { assert (e.offset.y > 0.0f); }
        if e.view == AxisView::TOP { assert (e.toward > 0.99f); }
    }
}

__test each_axis_view_faces_its_opposite_and_names_its_key {
    for v in AXIS_VIEWS {
        assert (oppositeOf(oppositeOf(v)) == v);
        assert ((sideOf(v) + sideOf(oppositeOf(v))).length() < 1.0e-6f);
        assert (isPositive(v) != isPositive(oppositeOf(v)));
    }

    assert (keyOf(AxisView::TOP) == "7" && keyOf(AxisView::BACK) == "Ctrl+1" && nameOf(AxisView::RIGHT) == "Right");
}
