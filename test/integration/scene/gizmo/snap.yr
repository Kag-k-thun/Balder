in snap;

use balder::scene::gizmo::{mode, snap};

__test a_kind_switched_off_snaps_only_with_the_modifier {
    let s = GizmoSnap();
    assert (!GizmoSnap::snaps(s, GizmoMode::TRANSLATE, false, false));
    assert (GizmoSnap::snaps(s, GizmoMode::TRANSLATE, false, true));
    assert (GizmoSnap::snaps(s, GizmoMode::ROTATE, false, true));
}

__test a_kind_switched_on_snaps_without_the_modifier_and_moves_freely_with_it {
    let s = GizmoSnap(rotating-> true);
    assert (GizmoSnap::snaps(s, GizmoMode::ROTATE, false, false));
    assert (!GizmoSnap::snaps(s, GizmoMode::ROTATE, false, true));

    // the other kinds keep the modifier
    assert (!GizmoSnap::snaps(s, GizmoMode::TRANSLATE, false, false));
    assert (!GizmoSnap::snaps(s, GizmoMode::SCALE, false, false));
}

__test a_face_of_a_volume_snaps_as_a_translation_whatever_the_mode {
    let s = GizmoSnap(translating-> true);
    assert (GizmoSnap::snaps(s, GizmoMode::SCALE, true, false));
    assert (!GizmoSnap::snaps(s, GizmoMode::SCALE, false, false));
}

__test the_steps_are_half_a_metre_fifteen_degrees_and_a_quarter {
    let s = GizmoSnap();
    assert (s.translation == 0.5f && s.scale == 0.25f);
    assert (s.angle > 0.2617f && s.angle < 0.2618f);
}
