in node_properties;

use balder::math::vector;
use balder::scene::actors::node_classes;
use balder::scene::description::{kind, node_description};
use balder::scene::node::node3D::{body, camera, empty, light, marker};
use balder::scene::property::{kind, node_schema, value};

use integration::utils::{compare, root};

__test a_schema_starts_with_the_transform_then_the_properties_of_its_class {
    let schema = Light::schema();
    assert (schema.properties.len > 3us);
    assert (schema.properties[0].name == "position" && schema.properties[1].name == "rotation");
    assert (schema.properties[2].name == "scale" && schema.properties[3].name == "light");
    assert (schema.groups[0].name == NodeSchema::TRANSFORM && schema.groups[1].name == Light::GROUP);

    if let Ok(p) = schema.property("inner-angle") {
        assert (p.key() == "Light/inner-angle" && p.kind == PropertyKind::NUMBER && p.group == Light::GROUP);
    } else {
        assert (false);
    }

    assert (!schema.property("roughness").hasValue);
    assert (schema.propertyOfKey("Transform/position").hasValue);
}

__test a_property_reads_and_gives_the_value_of_a_node {
    let dmut root = copy Root();
    let dmut l = copy Light("lamp", alias root);
    let schema = Light::schema();
    let intensity = if let Ok(p) = schema.property("intensity") { p } else { assert (false); };

    l.intensity = 3.0f;
    assert (intensity.get(alias l) == PropertyValue::number(3.0f));

    intensity.set(alias l, PropertyValue::number(7.5f));
    assert (near(l.intensity, 7.5f) && intensity.settable());
}

__test a_choice_property_gives_the_member_of_its_name {
    let dmut root = copy Root();
    let dmut l = copy Light("lamp", alias root);
    let type = if let Ok(p) = Light::schema().property("light") { p } else { assert (false); };

    assert (type.get(alias l) == PropertyValue::choice("direction"));
    type.set(alias l, PropertyValue::choice("spot"));
    assert (l.type == LightType::SPOT && type.choiceIndex("spot") == (2us)?);

    // a name of no choice is refused and changes nothing
    assert (type.check(l, PropertyValue::choice("sun")).len != 0us);
    type.set(alias l, PropertyValue::choice("sun"));
    assert (l.type == LightType::SPOT);
}

__test a_property_applies_while_the_choice_it_depends_on_holds {
    let dmut root = copy Root();
    let dmut l = copy Light("lamp", alias root);
    let schema = Light::schema();
    let cone = if let Ok(p) = schema.property("inner-angle") { p } else { assert (false); };
    let range = if let Ok(p) = schema.property("range") { p } else { assert (false); };

    assert (!schema.applies(cone, alias l) && !schema.applies(range, alias l));
    l.type = LightType::POINT;
    assert (!schema.applies(cone, alias l) && schema.applies(range, alias l));
    l.type = LightType::SPOT;
    assert (schema.applies(cone, alias l) && schema.applies(range, alias l));
}

__test a_property_refuses_the_values_its_class_refuses {
    let dmut root = copy Root();
    let l = copy Light("lamp", alias root);
    let direction = if let Ok(p) = Light::schema().property("direction") { p } else { assert (false); };
    assert (direction.check(l, PropertyValue::vector(vec3())).len != 0us);
    assert (direction.check(l, PropertyValue::vector(makeVec3(0.0f, 0.0f, -1.0f))).len == 0us);

    let cam = copy PerspectiveCamera("cam", alias root);
    let far = if let Ok(p) = Camera::schema().property("far") { p } else { assert (false); };
    assert (far.check(cam, PropertyValue::number(cam.near / 2.0f)).len != 0us);
    assert (far.check(cam, PropertyValue::number(cam.near * 2.0f)).len == 0us);
}

__test a_property_of_another_class_leaves_a_node_as_it_is {
    let dmut root = copy Root();
    let dmut e = copy Empty3D("e", alias root);
    let intensity = if let Ok(p) = Light::schema().property("intensity") { p } else { assert (false); };

    assert (!intensity.isOf(e) && intensity.get(alias e) == intensity.defaultValue);
    intensity.set(alias e, PropertyValue::number(2.0f));

    let position = Light::schema().properties[0];
    assert (position.isOf(e));
    position.set(alias e, PropertyValue::vector(makeVec3(1.0f, 2.0f, 3.0f)));
    assert (near(e.position, makeVec3(1.0f, 2.0f, 3.0f)));
}

__test a_property_given_at_the_creation_of_a_node_has_no_setter {
    let model = if let Ok(p) = PhysicsBody3D::schema().property("model") { p } else { assert (false); };
    assert (!model.settable() && model.required && model.kind == PropertyKind::ASSET && model.asset == "mesh");

    let active = if let Ok(p) = Camera::schema().property("active") { p } else { assert (false); };
    assert (active.settable() && active.unique);
}

__test the_values_of_two_kinds_differ_and_those_of_one_kind_compare_their_field {
    assert (PropertyValue::number(1.0f) == PropertyValue::number(1.0f));
    assert (!(PropertyValue::number(1.0f) == PropertyValue::number(2.0f)));
    assert (!(PropertyValue::vector(makeVec3(1.0f, 0.0f, 0.0f)) == PropertyValue::color(makeVec3(1.0f, 0.0f, 0.0f))));
    assert (PropertyValue::texts(copy ["a", "b"]) == PropertyValue::texts(copy ["a", "b"]));
    assert (!(PropertyValue::layers(3u32) == PropertyValue::count(3u32)));
    assert (!(PropertyValue::choice("box") == PropertyValue::asset("box")));
}

__test a_description_holds_the_defaults_of_its_schema_until_it_is_given_values {
    let mut d = NodeDescription("lamp", NodeKind::LIGHT);
    assert (d.value("intensity") == PropertyValue::number(1.0f) && d.value("light") == PropertyValue::choice("direction"));

    let cone = if let Ok(p) = d.schema().property("outer-angle") { p } else { assert (false); };
    assert (!d.applies(cone));

    d:.set("light", PropertyValue::choice("spot"));
    d:.set("intensity", PropertyValue::number(4.0f));
    assert (d.applies(cone) && d.value("intensity") == PropertyValue::number(4.0f));

    let mut other = NodeDescription("lamp", NodeKind::LIGHT);
    assert (!(other == d));
    other:.set("intensity", PropertyValue::number(4.0f));
    other:.set("light", PropertyValue::choice("spot"));
    assert (other == d);
}

__test the_schema_of_a_node_follows_its_class {
    let dmut root = copy Root();
    let b = copy PhysicsBody3D("b", alias root);
    let m = copy Marker3D("m", alias root);
    let e = copy Empty3D("e", alias root);
    assert (schemaOfNode(b).noun == "body" && schemaOfNode(m).noun == "marker" && schemaOfNode(e).noun == "empty");
    assert (schemas().len == 10us + actorClasses().len);
}
