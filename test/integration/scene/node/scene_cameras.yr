in scene_cameras;

use balder::{math::_, math::utils};
use balder::scene::node::node3D::{camera, empty};
use balder::scene::utils::tree;

use integration::utils::{compare, root};

use std::math;

__test a_camera_turned_toward_a_point_sees_it_as_look_at_does {
    let dmut root = copy Root();
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(3.0f, 4.0f, 5.0f);
    cam.target = makeVec3(0.0f, 1.0f, 0.0f);

    let view = lookAt!{f32} (makeVec3(3.0f, 4.0f, 5.0f), makeVec3(0.0f, 1.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    assert (near(cam.viewProj, cam.proj * view));
    assert (near(cam.eye, makeVec3(3.0f, 4.0f, 5.0f)));
    assert (near(cam.target, makeVec3(0.0f, 1.0f, 0.0f)));
}

__test a_camera_keeps_its_rotation_when_it_moves {
    let dmut root = copy Root();
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(0.0f, 0.0f, 10.0f);
    cam.target = makeVec3(0.0f, 0.0f, 0.0f);

    // moved aside, it looks along -z still, the point it looks at moving with it
    cam.position = makeVec3(2.0f, 0.0f, 10.0f);
    let view = lookAt!{f32} (makeVec3(2.0f, 0.0f, 10.0f), makeVec3(2.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    assert (near(cam.viewProj, cam.proj * view));
    assert (near(cam.target, makeVec3(2.0f, 0.0f, 0.0f)));
}

__test a_camera_looks_along_the_minus_z_of_its_node_its_top_along_y {
    let dmut root = copy Root();
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(1.0f, 2.0f, 3.0f);
    cam.rotation = vec3();

    let view = lookAt!{f32} (makeVec3(1.0f, 2.0f, 3.0f), makeVec3(1.0f, 2.0f, 2.0f), makeVec3(0.0f, 1.0f, 0.0f));
    assert (near(cam.viewProj, cam.proj * view));

    // a quarter turn around Y looks along -x
    cam.rotation = makeVec3(0.0f, radian(90.0f), 0.0f);
    let turned = lookAt!{f32} (makeVec3(1.0f, 2.0f, 3.0f), makeVec3(0.0f, 2.0f, 3.0f), makeVec3(0.0f, 1.0f, 0.0f));
    assert (near(cam.viewProj, cam.proj * turned));
}

__test a_camera_follows_the_transform_of_its_parent_its_scale_aside {
    let dmut root = copy Root();
    let dmut rig = copy Empty3D("rig", alias root);
    let dmut cam = copy PerspectiveCamera("cam", alias rig);
    cam.position = makeVec3(0.0f, 1.0f, 0.0f);
    cam.rotation = vec3();

    rig:.setTransform(makeVec3(5.0f, 0.0f, 0.0f), makeVec3(0.0f, radian(90.0f), 0.0f), makeVec3(2.0f, 2.0f, 2.0f));

    // the rig doubles the height of the camera and turns it toward -x
    assert (near(cam.eye, makeVec3(5.0f, 2.0f, 0.0f)));
    let view = lookAt!{f32} (makeVec3(5.0f, 2.0f, 0.0f), makeVec3(4.0f, 2.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    assert (near(cam.viewProj, cam.proj * view));
}

__test a_camera_looking_straight_down_has_its_top_toward_minus_z {
    let dmut root = copy Root();
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(0.0f, 10.0f, 0.0f);
    cam.target = vec3();

    let view = lookAt!{f32} (makeVec3(0.0f, 10.0f, 0.0f), vec3(), makeVec3(0.0f, 0.0f, -1.0f));
    assert (near(cam.viewProj, cam.proj * view));
}

__test an_orthographic_camera_sees_a_view_of_its_size {
    let dmut root = copy Root();
    let dmut cam = copy OrthoCamera("cam", alias root);
    cam.aspect = 2.0f;
    cam.size = 4.0f;
    cam.position = makeVec3(0.0f, 0.0f, 10.0f);
    cam.target = vec3();

    assert (cam.projection() == CameraProjection::ORTHOGRAPHIC);
    assert (near(cam.screenSize(vec3(), 1.0f), 0.25f));
    assert (near(cam.screenSize(makeVec3(0.0f, 0.0f, -50.0f), 1.0f), 0.25f));

    // the corners of the view, the width twice the height
    let top = cam.viewProj * makeVec4(4.0f, 2.0f, 0.0f, 1.0f);
    assert (near(math::abs(top.x / top.w), 1.0f) && near(math::abs(top.y / top.w), 1.0f));
}

__test the_first_camera_of_a_tree_is_active_the_cameras_of_the_tools_aside {
    let dmut root = copy Root();
    let dmut tool = copy PerspectiveCamera("__editor_camera__", alias root);
    let dmut first = copy PerspectiveCamera("first", alias root);
    let dmut second = copy OrthoCamera("second", alias root);

    let dmut tree = NodeTreeScene();
    assert (!tree:.addCamera(alias tool));
    assert (!tree.camera.hasValue);

    assert (tree:.addCamera(alias first));
    assert (!tree:.addCamera(alias second));
    assert (tree.cameras.len == 3us);
    if let Ok(dmut a) = alias tree.active { assert (a is first); } else { assert (false); }
    if let Ok(c) = tree.camera { assert (c is first); } else { assert (false); }
}

__test a_camera_made_active_draws_the_scene_unless_a_view_camera_does {
    let dmut root = copy Root();
    let dmut tool = copy PerspectiveCamera("__editor_camera__", alias root);
    let dmut first = copy PerspectiveCamera("first", alias root);
    let dmut second = copy PerspectiveCamera("second", alias root);

    let dmut tree = NodeTreeScene();
    tree:.addCamera(alias tool);
    tree:.addCamera(alias first);
    tree:.addCamera(alias second);

    assert (tree:.setActive(alias second));
    assert (!tree:.setActive(alias second));
    if let Ok(c) = tree.camera { assert (c is second); } else { assert (false); }

    // the view camera draws the scene, the active one staying active
    assert (tree:.setView((alias tool)?));
    if let Ok(c) = tree.camera { assert (c is tool); } else { assert (false); }
    assert (!tree:.setActive(alias first));
    if let Ok(dmut a) = alias tree.active { assert (a is first); } else { assert (false); }
    if let Ok(c) = tree.camera { assert (c is tool); } else { assert (false); }

    // without the view camera, the active one draws again
    assert (tree:.setView(none));
    if let Ok(c) = tree.camera { assert (c is first); } else { assert (false); }
}

__test a_camera_outside_the_tree_is_made_neither_active_nor_the_view {
    let dmut root = copy Root();
    let dmut first = copy PerspectiveCamera("first", alias root);
    let dmut stranger = copy PerspectiveCamera("stranger", alias root);

    let dmut tree = NodeTreeScene();
    tree:.addCamera(alias first);

    assert (!tree:.setActive(alias stranger));
    assert (!tree:.setView((alias stranger)?));
    if let Ok(c) = tree.camera { assert (c is first); } else { assert (false); }
}

__test the_active_camera_leaving_hands_over_to_the_first_other_camera {
    let dmut root = copy Root();
    let dmut tool = copy PerspectiveCamera("__editor_camera__", alias root);
    let dmut first = copy PerspectiveCamera("first", alias root);
    let dmut second = copy PerspectiveCamera("second", alias root);

    let dmut tree = NodeTreeScene();
    tree:.addCamera(alias tool);
    tree:.addCamera(alias first);
    tree:.addCamera(alias second);

    assert (tree:.removeCamera(first));
    if let Ok(dmut a) = alias tree.active { assert (a is second); } else { assert (false); }

    // the camera of the tool is never made active on its own
    assert (tree:.removeCamera(second));
    assert (!(alias tree.active).hasValue);
    assert (tree.cameras.len == 1us);
}

__test the_view_camera_leaving_hands_back_to_the_active_one {
    let dmut root = copy Root();
    let dmut first = copy PerspectiveCamera("first", alias root);
    let dmut second = copy PerspectiveCamera("second", alias root);

    let dmut tree = NodeTreeScene();
    tree:.addCamera(alias first);
    tree:.addCamera(alias second);
    tree:.setView((alias second)?);

    assert (tree:.removeCamera(second));
    assert (!(alias tree.view).hasValue);
    if let Ok(c) = tree.camera { assert (c is first); } else { assert (false); }

    // a camera drawing nothing leaves without changing what draws
    let dmut third = copy PerspectiveCamera("third", alias root);
    tree:.addCamera(alias third);
    assert (!tree:.removeCamera(third));
}
