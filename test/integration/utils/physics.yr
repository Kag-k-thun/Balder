in physics;

use balder::math::{bounds, vector};
use balder::scene::physics;

/**
 * @returns: a box of side 2
 * */
pub fn cube()-> ColliderShape {
    ColliderShape::box(makeVec3(2.0f, 2.0f, 2.0f))
}

/**
 * @returns: a floor of two triangles, the square of side 2 centred on the origin in the plane y = 0
 * */
pub fn floorMesh()-> dmut &TriangleBvh {
    let positions = copy [makeVec3(-1.0f, 0.0f, -1.0f), makeVec3(1.0f, 0.0f, -1.0f), makeVec3(1.0f, 0.0f, 1.0f),
                          makeVec3(-1.0f, 0.0f, 1.0f)];
    copy TriangleBvh(positions, copy [0u32, 1u32, 2u32, 0u32, 2u32, 3u32])
}

/**
 * @returns: the distance at which a ray hits a collider, -1 when it misses it
 * */
pub fn distanceOf(collider: Collider, ray: Ray)-> f32 {
    if let Ok(hit) = collider.raycast(ray) { hit.distance } else { -1.0f }
}
