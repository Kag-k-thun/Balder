in random;

/**
 * Advance a linear congruential generator, so that the tests draw the same numbers at each run
 * @params:
 *    - state: the state of the generator, advanced
 *    - range: the half width of the drawn interval
 * @returns: a number in [-range, range]
 * */
pub fn next(ref mut state: u64, range: f32)-> f32 {
    state = (state * 1103515245u64 + 12345u64) % 2147483648u64;
    let unit = cast!f32((state >> 15u64) & 0xffffu64) / 65536.0f;

    (unit * 2.0f - 1.0f) * range
}
