in bounds;

use balder::math::{bounds, matrix, vector};

/**
 * @returns: the box of side 2 centered on a point
 * */
pub fn cube(center: vec3)-> Aabb {
    Aabb(center - 1.0f, center + 1.0f)
}

/**
 * @returns: the distance at which a ray enters a box, -1 when it misses it
 * */
pub fn entry(box: Aabb, ray: Ray)-> f32 {
    if let Ok(d) = box.intersect(ray) { d } else { -1.0f }
}

/**
 * @returns: the normalized device coordinates of a point of the world seen by a projection
 * */
pub fn project(viewProj: mat4, point: vec3)-> vec3 {
    let clip = viewProj * makeVec4(point, 1.0f);
    clip.xyz / clip.w
}
