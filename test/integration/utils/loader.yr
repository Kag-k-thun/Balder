in loader;

use balder::interface::loader::parser;

use std::syntax;

/**
 * @returns: the first value of a content
 * */
pub fn value(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @returns: the document of a .gui content
 * */
pub fn document(content: [c8])-> Document
    throws SyntaxError
{
    let dmut reader = GuiReader(content);
    reader:.read()
}

/**
 * @returns: the source of each value of a slice
 * */
pub fn sources(values: [&Value])-> [[c8]] {
    let mut result: [[c8]] = [];
    for v in values {
        result = result ~ [v.getSource()];
    }

    result
}
