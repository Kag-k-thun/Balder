in camera;

use balder::math::vector;
use balder::scene::node;
use balder::scene::node::node3D::camera;

/**
 * @returns: a perspective camera on +z, 10 units away from the origin it looks at
 * */
pub fn cameraOf(dmut root: &Node)-> dmut &Camera {
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(0.0f, 0.0f, 10.0f);
    cam.target = makeVec3(0.0f, 0.0f, 0.0f);

    alias cam
}
