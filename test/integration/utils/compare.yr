in compare;

use balder::math::{matrix, vector};

use std::math;

/**
 * @returns: true iif two numbers are equal, give or take the rounding errors
 * */
pub fn near(a: f32, b: f32, tolerance: f32 = 0.0001f)-> bool {
    math::abs(a - b) < tolerance
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
pub fn near(a: vec3, b: vec3, tolerance: f32 = 0.0001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
pub fn near(a: vec4, b: vec4, tolerance: f32 = 0.0001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: true iif two matrices are equal, give or take the rounding errors, the sum of their differences being
 * under the tolerance
 * */
pub fn near(a: mat3, b: mat3, tolerance: f32 = 0.0001f)-> bool {
    let d = a - b;
    let res = math::abs(d.a1) + math::abs(d.b1) + math::abs(d.c1)
        + math::abs(d.a2) + math::abs(d.b2) + math::abs(d.c2)
        + math::abs(d.a3) + math::abs(d.b3) + math::abs(d.c3);

    res < tolerance
}

/**
 * @returns: true iif two matrices are equal, give or take the rounding errors, each of their columns being under the
 * tolerance
 * */
pub fn near(a: mat4, b: mat4, tolerance: f32 = 0.0001f)-> bool {
    let d = a - b;
    let cols = [makeVec4(d.a1, d.b1, d.c1, d.d1), makeVec4(d.a2, d.b2, d.c2, d.d2),
                makeVec4(d.a3, d.b3, d.c3, d.d3), makeVec4(d.a4, d.b4, d.c4, d.d4)];
    for c in cols {
        if c.length() > tolerance { return false; }
    }

    true
}
