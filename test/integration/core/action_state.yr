in action_state;

use balder::core::application::input::{action, action_state, binding, input_devices};

// The keys of the test, by their SDL scancodes (F13 to F15), which no other test presses, and a gamepad of its own
def JUMP_KEY = 104u32;
def RUN_KEY = 105u32;
def OTHER_KEY = 106u32;
def PAD = 9001u32;
def LEFT_Y = 1u32;

/**
 * The actions of the program and the devices are those of the whole program: one test drives them, tick after tick
 * */
__test the_actions_read_the_devices_tick_after_tick {
    setInputActions(copy [InputAction(name-> "test-jump", bindings-> copy [InputBinding(InputDevice::KEY, JUMP_KEY)]),
                          InputAction(name-> "test-run", bindings-> copy [InputBinding(InputDevice::KEY, RUN_KEY)]),
                          InputAction(name-> "test-forward", bindings-> copy [InputBinding(InputDevice::PAD_AXIS, LEFT_Y, positive-> false)],
                                      deadZone-> 0.2f)]);

    let dmut devices = alias inputDevices();
    let dmut a = copy ActionState();
    let dmut b = copy ActionState();
    a:.sample();
    b:.sample();

    // a key held reads as held, and as pressed at its first tick only
    devices:.keyDown(RUN_KEY);
    a:.sample();
    assert (a:.held("test-run") && a:.pressed("test-run"));
    a:.sample();
    assert (a:.held("test-run") && !a:.pressed("test-run"));
    devices:.keyUp(RUN_KEY);
    a:.sample();
    assert (!a:.held("test-run") && a:.released("test-run"));

    // a tap between two ticks reads as pressed and released, not held
    devices:.keyDown(JUMP_KEY);
    devices:.keyUp(JUMP_KEY);
    a:.sample();
    assert (a:.pressed("test-jump") && a:.released("test-jump") && !a:.held("test-jump"));

    // two states read the same press, each at its own tick
    b:.sample();
    assert (b:.pressed("test-jump"));
    a:.sample();
    assert (!a:.pressed("test-jump"));

    // an axis under its dead zone reads 0, past it rescaled, its crossing a press
    devices:.padAxis(PAD, LEFT_Y, -3000i16);
    a:.sample();
    assert (a:.strength("test-forward") == 0.0f && !a:.held("test-forward"));
    devices:.padAxis(PAD, LEFT_Y, -32768i16);
    a:.sample();
    assert (a:.pressed("test-forward") && a:.strength("test-forward") == 1.0f);
    assert (a:.axis("test-run", "test-forward") == 1.0f);
    devices:.padAxis(PAD, LEFT_Y, 0i16);
    a:.sample();
    assert (a:.released("test-forward"));

    // a scene without the focus reads nothing, and the keys typed meanwhile are no press once it has it again
    devices:.keyDown(OTHER_KEY);
    devices:.keyDown(RUN_KEY);
    a:.sampleIdle();
    assert (!a:.held("test-run") && !a:.pressed("test-run"));
    devices:.keyUp(RUN_KEY);
    a:.sampleIdle();
    a:.sample();
    assert (!a:.pressed("test-run") && !a:.held("test-run"));

    // an unknown action reads as never acted
    assert (!a:.held("test-nothing") && !a:.pressed("test-nothing") && a:.strength("test-nothing") == 0.0f);

    devices:.keyUp(OTHER_KEY);
    devices:.closePad(PAD);
    setInputActions([]);
}
