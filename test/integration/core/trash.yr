in trash;

use balder::utils::trash;

use std::fs;

__test a_file_trashed_goes_to_the_files_of_the_trash_its_information_beside {
    let dir = tempDirectory(prefix-> "balder_trash_");
    let trashDir = dir.push("Trash").toStr();
    let file = dir.push("crate.obj");
    writeFile(file, "o crate");

    let moved = moveToTrash(file.toStr(), trash-> trashDir);
    assert (!exists(file));
    assert (moved == dir.push("Trash/files/crate.obj").toStr());
    assert (readFile(Path(moved)) == "o crate");

    let info = readFile(dir.push("Trash/info/crate.obj.trashinfo"));
    assert (info.len > 0us);
    let head = "[Trash Info]\nPath=" ~ file.toStr() ~ "\nDeletionDate=";
    assert (info[0us .. head.len] == head);

    // a second file of that name takes another one
    writeFile(file, "o box");
    let second = moveToTrash(file.toStr(), trash-> trashDir);
    assert (second == dir.push("Trash/files/crate_2.obj").toStr());
    assert (exists(dir.push("Trash/info/crate_2.obj.trashinfo")));

    removeDir(dir, recursive-> true);
}

__test a_directory_is_trashed_with_its_files {
    let dir = tempDirectory(prefix-> "balder_trash_");
    createDir(dir.push("models"));
    writeFile(dir.push("models/table.glb"), "glTF");

    let moved = moveToTrash(dir.push("models").toStr(), trash-> dir.push("Trash").toStr());
    assert (!exists(dir.push("models")));
    assert (isFile(Path(moved).push("table.glb")));

    removeDir(dir, recursive-> true);
}

__test the_path_of_the_information_is_written_as_a_url_writes_it {
    assert (percentEncoded("/home/me/res/crate.obj") == "/home/me/res/crate.obj");
    assert (percentEncoded("/res/my crate#1.obj") == "/res/my%20crate%231.obj");
    assert (trashInfo("/a b", "2026-11-27T18:04:11") == "[Trash Info]\nPath=/a%20b\nDeletionDate=2026-11-27T18:04:11\n");
}
