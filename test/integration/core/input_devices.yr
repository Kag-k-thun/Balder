in input_devices;

use balder::core::application::input::{binding, device_state, input_devices};

// A key and a gamepad button of the tests, by their SDL codes: Space, the south button, the left stick
def KEY = 44u32;
def BUTTON = 0u32;
def LEFT_Y = 1u32;

__test a_key_down_is_held_until_it_goes_up {
    let dmut d = copy InputDevices();
    let key = InputBinding(InputDevice::KEY, KEY);
    d:.keyDown(KEY);
    assert (d:.snapshot().isHeld(key) && d:.snapshot().downs(key) == 1u32);

    d:.keyUp(KEY);
    assert (!d:.snapshot().isHeld(key) && d:.snapshot().ups(key) == 1u32);
}

__test a_key_repeated_is_one_down {
    let dmut d = copy InputDevices();
    d:.keyDown(KEY);
    d:.keyDown(KEY);
    d:.keyUp(KEY);
    d:.keyUp(KEY);
    let key = InputBinding(InputDevice::KEY, KEY);
    assert (d:.snapshot().downs(key) == 1u32 && d:.snapshot().ups(key) == 1u32);
}

__test a_button_held_by_two_gamepads_is_held_until_both_release_it {
    let dmut d = copy InputDevices();
    let b = InputBinding(InputDevice::PAD_BUTTON, BUTTON);
    d:.padButton(1u32, BUTTON, true);
    d:.padButton(2u32, BUTTON, true);
    d:.padButton(1u32, BUTTON, false);
    assert (d:.snapshot().isHeld(b));

    d:.padButton(2u32, BUTTON, false);
    assert (!d:.snapshot().isHeld(b));
}

__test a_gamepad_removed_releases_what_it_held {
    let dmut d = copy InputDevices();
    let b = InputBinding(InputDevice::PAD_BUTTON, BUTTON);
    let up = InputBinding(InputDevice::PAD_AXIS, LEFT_Y, positive-> false);
    d:.padButton(3u32, BUTTON, true);
    d:.padAxis(3u32, LEFT_Y, -32768i16);
    assert (d:.snapshot().isHeld(b) && d:.snapshot().strength(up) == 1.0f);

    d:.closePad(3u32);
    assert (!d:.snapshot().isHeld(b) && d:.snapshot().strength(up) == 0.0f);
}

__test an_axis_splits_into_its_halves_the_furthest_gamepad_read {
    let dmut d = copy InputDevices();
    let down = InputBinding(InputDevice::PAD_AXIS, LEFT_Y, positive-> true);
    let up = InputBinding(InputDevice::PAD_AXIS, LEFT_Y, positive-> false);
    d:.padAxis(1u32, LEFT_Y, 16384i16);
    d:.padAxis(2u32, LEFT_Y, 32767i16);
    assert (d:.snapshot().strength(down) == 1.0f && d:.snapshot().strength(up) == 0.0f);

    d:.padAxis(2u32, LEFT_Y, 0i16);
    let half = d:.snapshot().strength(down);
    assert (half > 0.49f && half < 0.51f);
}

__test releasing_everything_releases_the_keys_the_buttons_and_the_axes {
    let dmut d = copy InputDevices();
    d:.keyDown(KEY);
    d:.buttonDown(1u32);
    d:.padButton(4u32, BUTTON, true);
    d:.padAxis(4u32, LEFT_Y, 32767i16);
    d:.releaseAll();

    let s = d:.snapshot();
    assert (!s.isHeld(InputBinding(InputDevice::KEY, KEY)) && !s.isHeld(InputBinding(InputDevice::MOUSE, 1u32)));
    assert (!s.isHeld(InputBinding(InputDevice::PAD_BUTTON, BUTTON)));
    assert (s.strength(InputBinding(InputDevice::PAD_AXIS, LEFT_Y)) == 0.0f);
}
