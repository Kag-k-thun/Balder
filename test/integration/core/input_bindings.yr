in input_bindings;

use balder::core::error;
use balder::core::application::input::binding;

/**
 * @returns: true if `text` contains `sub`
 * */
fn contains(text: [c8], sub: [c8])-> bool {
    if sub.len > text.len { return false; }
    for i in 0us .. (text.len - sub.len + 1us) {
        if text[i .. i + sub.len] == sub { return true; }
    }

    false
}

/**
 * @returns: the message of the error reading a binding, empty when it is read
 * */
fn errorOf(text: [c8], action: [c8])-> [c8] {
    {
        InputBinding::parse(text, action);
        ""
    } catch {
        err: &BalderError => { err.msg }
    }
}

@parameters ((yield t for t in ["key:Space", "key:W", "key:Left Shift", "key:Keypad +", "mouse:left", "mouse:x2",
                                "pad:a", "pad:start", "pad:dpup", "pad:lefty-", "pad:rightx+", "pad:righttrigger+"]))
__test a_binding_read_is_written_back_as_it_was (text: [c8]) {
    assert (InputBinding::parse(text, "act").text() == text);
}

__test the_names_of_the_keys_ignore_their_case {
    assert (InputBinding::parse("key:left shift", "run").text() == "key:Left Shift");
}

__test a_gamepad_name_is_a_button_before_an_axis {
    let b = InputBinding::parse("pad:a", "jump");
    assert (b.device == InputDevice::PAD_BUTTON);

    let a = InputBinding::parse("pad:leftx-", "left");
    assert (a.device == InputDevice::PAD_AXIS && !a.positive);
}

@parameters ((yield t for t in [("space", "expected device:name"), ("key:Lshift", "unknown key"),
                                ("mouse:fourth", "unknown mouse button"), ("pad:lefty", "an axis needs + or -"),
                                ("pad:nothing+", "unknown gamepad input"), ("joystick:a", "unknown device")]))
__test a_bad_binding_names_its_action (case: ([c8], [c8])) {
    let msg = errorOf(case._0, "forward");
    assert (contains(msg, case._1) && contains(msg, "\"forward\""));
}
