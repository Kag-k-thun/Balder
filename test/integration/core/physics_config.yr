in physics_config;

use balder::core::error;
use balder::core::config::physics;
use balder::math::vector;

use std::config::toml;

/**
 * The [physics] table written in `text`
 * */
fn physics(text: [c8])-> PhysicsConfig
    throws BalderError
{
    {
        PhysicsConfig(toml::parse(text))
    } catch {
        b: &BalderError => throw b;
        _ => throw copy BalderError("Malformed test configuration " ~ text);
    }
}

/**
 * @returns: true if reading the [physics] table written in `text` throws a BalderError
 * */
fn rejects(text: [c8])-> bool {
    {
        physics(text);
        false
    } catch {
        _: &BalderError => {
            true
        }
    }
}

__test the_defaults_fall_at_the_gravity_of_the_earth_in_four_sub_steps {
    for cfg in [physics(""), PhysicsConfig()] {
        assert (cfg.gravity == makeVec3(0.0f, -9.81f, 0.0f));
        assert (cfg.substeps == 4u32 && cfg.iterations == 2u32);
        assert (cfg.contactHertz == 60.0f && cfg.contactDamping == 10.0f && cfg.maxCorrection == 2.0f);
        assert (cfg.bounceThreshold == 1.0f);
        assert (cfg.sleepLinear == 0.05f && cfg.sleepAngular == 0.05f && cfg.sleepTime == 0.5f);
    }
}

__test the_settings_written_are_read {
    let cfg = physics("gravity = [0.0, -1.62, 0]\nsubsteps = 2\niterations = 10\ncontact-hertz = 30\ncontact-damping = 1\n"
                      ~ "max-correction = 3\nbounce-threshold = 0.5\nsleep-linear = 0.1\nsleep-angular = 0.2\n"
                      ~ "sleep-time = 1.5");
    assert (cfg.gravity == makeVec3(0.0f, -1.62f, 0.0f));
    assert (cfg.substeps == 2u32 && cfg.iterations == 10u32);
    assert (cfg.contactHertz == 30.0f && cfg.contactDamping == 1.0f && cfg.maxCorrection == 3.0f);
    assert (cfg.bounceThreshold == 0.5f);
    assert (cfg.sleepLinear == 0.1f && cfg.sleepAngular == 0.2f && cfg.sleepTime == 1.5f);
}

__test the_settings_out_of_their_bounds_are_rejected {
    assert (rejects("gravity = [0.0, -9.81]"));
    assert (rejects("gravity = \"down\""));
    assert (rejects("substeps = 0"));
    assert (rejects("substeps = 17"));
    assert (rejects("iterations = 0"));
    assert (rejects("iterations = 2.5"));
    assert (rejects("contact-hertz = 0"));
    assert (rejects("contact-damping = -1"));
    assert (rejects("sleep-time = \"long\""));
}
