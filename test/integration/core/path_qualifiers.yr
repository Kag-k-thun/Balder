in path_qualifiers;

use balder::utils::path;

use std::fs;

__test res_names_the_project_and_engine_and_shaders_name_the_engine {
    assert (projectPath("res:/models/crate.glb") == getProjectPath().push("res/models/crate.glb"));
    assert (projectPath("engine:/dialog/file.gui") == getEnginePath().push("res/dialog/file.gui"));
    assert (projectPath("shaders:/base/3D/pbr.toml") == getEnginePath().push("res/shaders/base/3D/pbr.toml"));
    assert (projectPath("/abs/path.toml") == Path("/abs/path.toml"));
}

__test a_path_under_the_res_of_the_project_is_qualified_the_others_kept {
    let inside = getProjectPath().push("res/models/crate/crate.glb").toStr();
    assert (qualifiedPath(inside) == "res:/models/crate/crate.glb");

    assert (qualifiedPath(getProjectPath().push("res").toStr()) == getProjectPath().push("res").toStr());
    assert (qualifiedPath("/elsewhere/crate.glb") == "/elsewhere/crate.glb");
    assert (qualifiedPath("res:/models/crate.glb") == "res:/models/crate.glb");
    assert (qualifiedPath("models/crate.glb") == "models/crate.glb");
}
