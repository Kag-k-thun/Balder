in style_conditions;

use balder::interface::loader::parser;
use balder::interface::style;
use balder::interface::style::conditions;
use balder::math::vector;

use std::syntax::errors;

/**
 * @returns: the condition of a content
 * */
fn read(content: [c8])-> &Condition
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ConditionReader(alias scanner, copy Constants());
    reader:.read()
}

/**
 * @returns: the variables of a window of 800 by 600 at a scale of 1.5, in an application in the mode edit, compact
 * and with 3 pages
 * */
fn variables()-> &StyleVariables {
    let dmut v = copy StyleVariables();
    v:.set("window.width", VariableValue(800.0));
    v:.set("window.height", VariableValue(600.0));
    v:.set("window.scale", VariableValue(1.5));
    v:.set("app.mode", VariableValue("edit"));
    v:.set("app.compact", VariableValue(true));
    v:.set("app.pages", VariableValue(3.0));
    v
}

/**
 * @returns: true iif a condition holds in the variables, the space available being 400 by 300
 * */
fn holdsIn(content: [c8])-> bool
    throws SyntaxError
{
    holds(read(content), ConditionScope(variables(), available-> (makeVec2(400.0f, 300.0f))?))
}

__test the_numbers_compare_to_numbers_and_lengths_in_px {
    assert (holdsIn("window.width < 900"));
    assert (!holdsIn("window.width < 800"));
    assert (holdsIn("window.width <= 800px"));
    assert (holdsIn("window.width >= 800 and window.width > 799.5"));
    assert (holdsIn("window.scale == 1.5"));
    assert (!holdsIn("window.scale != 1.5"));
    assert (holdsIn("app.pages > 2"));
}

__test width_and_height_are_the_space_available {
    assert (holdsIn("width == 400 and height == 300"));
    assert (!holdsIn("width >= 500"));

    // outside a layout, they are not set
    assert (!holds(read("width < 500"), ConditionScope(variables())));
    assert (holds(read("not (width < 500)"), ConditionScope(variables())));
}

__test the_strings_compare_to_keywords_and_strings {
    assert (holdsIn("app.mode == edit"));
    assert (holdsIn("app.mode == \"edit\""));
    assert (holdsIn("app.mode != view"));
    assert (!holdsIn("app.mode == view"));

    // values of another kind never compare
    assert (!holdsIn("app.mode == 3"));
    assert (!holdsIn("app.pages == three"));
}

__test a_variable_alone_tests_a_boolean {
    assert (holdsIn("app.compact"));
    assert (holdsIn("app.compact == true"));
    assert (!holdsIn("app.compact == false"));
    assert (holdsIn("app.pages"));
    assert (holdsIn("app.mode"));
    assert (!holdsIn("not app.compact"));
}

__test a_variable_never_set_makes_its_test_false {
    assert (!holdsIn("app.missing"));
    assert (!holdsIn("app.missing == edit"));
    assert (!holdsIn("app.missing != edit"));
    assert (!holdsIn("window.dpi > 0"));
    assert (holdsIn("not app.missing"));

    // a scope without variables holds nothing
    assert (!holds(read("window.width < 900"), ConditionScope()));
}

__test and_binds_tighter_than_or {
    assert (holdsIn("app.compact and app.mode == edit"));
    assert (!holdsIn("app.compact and app.mode == view"));
    assert (holdsIn("app.mode == view or app.compact"));
    assert (holdsIn("app.mode == view and app.missing or width < 500"));
    assert (!holdsIn("app.mode == view and (app.missing or width < 500)"));
}

__test a_condition_reads_each_variable_once {
    assert (reads(read("width < 500")) == copy ["width"]);
    assert (reads(read("not (window.width < 800 or app.mode == edit) and window.width > 10"))
            == copy ["window.width", "app.mode"]);
}

__test the_variables_tell_when_their_value_changes {
    let dmut v = copy StyleVariables();
    assert (v:.set("app.mode", VariableValue("edit")));
    assert (!v:.set("app.mode", VariableValue("edit")));
    assert (v:.set("app.mode", VariableValue(true)));
    assert (v.get("app.missing").hasValue == false);
}

__test the_known_variables {
    assert (isKnown("width") && isKnown("height") && isKnown("window.dpi") && isKnown("app.mode"));
    assert (!isKnown("theme") && !isKnown("app.") && !isKnown("window.size"));
    assert (isNumeric("window.density") && !isNumeric("app.pages"));
}
