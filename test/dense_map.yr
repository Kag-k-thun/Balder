in dense_map;

use balder::utils::dense_map;

/**
 * A value of the maps of the tests, a class as the values of the maps of Balder
 * */
class Counter {
    pub let mut count: i32 = 0;

    pub self (count: i32)
        with count = count
    {}

    pub fn bump(mut self) {
        self.count += 1;
    }
}

/**
 * A map of the keys 1, 2 and 3 to counters of 10, 20 and 30
 * */
fn three()-> dmut &DenseMap!{usize, &Counter} {
    let dmut map = copy DenseMap!{usize, &Counter}();
    map:.insert(1us, copy Counter(10));
    map:.insert(2us, copy Counter(20));
    map:.insert(3us, copy Counter(30));
    alias map
}

/**
 * @returns: the count of the value of a key, -1 when it has none
 * */
fn countOf(map: &DenseMap!{usize, &Counter}, key: usize)-> i32 {
    if let Ok(c) = map.find(key) { c.count } else { -1 }
}

__test insert_and_find {
    let map = three();
    assert (map.len == 3us);
    assert (map.contains(2us));
    assert (!map.contains(4us));
    assert (countOf(map, 1us) == 10 && countOf(map, 2us) == 20 && countOf(map, 3us) == 30);
    assert (countOf(map, 4us) == -1);
}

__test insert_replaces_the_value_of_a_key {
    let dmut map = three();
    map:.insert(2us, copy Counter(25));
    assert (map.len == 3us);
    assert (countOf(map, 2us) == 25);
}

/**
 * The key removed from the map of three()
 * */
@parameters ((yield k for k in [1us, 2us, 3us]))
__test remove_keeps_the_other_keys (key: usize) {
    let dmut map = three();
    assert (map:.remove(key));
    assert (!map:.remove(key));
    assert (map.len == 2us);
    assert (!map.contains(key));
    assert (countOf(map, key) == -1);

    for k in 1us .. 4us if k != key {
        assert (countOf(map, k) == cast!i32(k) * 10);
    }
}

__test keys_and_values_are_aligned {
    let dmut map = three();
    map:.remove(1us);
    map:.insert(4us, copy Counter(40));

    let keys = map.keys();
    let values = map.values();
    assert (keys.len == 3us && values.len == 3us);
    for i in 0us .. keys.len {
        assert (values[i].count == cast!i32(keys[i]) * 10);
    }
}

__test values_are_the_stored_instances {
    let dmut map = three();
    for dmut c in alias map:.values() {
        c:.bump();
    }

    if let Ok(dmut c) = alias map:.find(3us) {
        c:.bump();
    }

    assert (countOf(map, 1us) == 11 && countOf(map, 2us) == 21 && countOf(map, 3us) == 32);
}

__test removed_slots_are_reused {
    let dmut map = three();
    map:.remove(3us);
    map:.remove(1us);
    map:.insert(5us, copy Counter(50));
    map:.insert(6us, copy Counter(60));

    assert (map.len == 3us);
    assert (countOf(map, 2us) == 20 && countOf(map, 5us) == 50 && countOf(map, 6us) == 60);
    assert (map.values().len == 3us);
}

__test clear_empties_the_map {
    let dmut map = three();
    map:.clear();
    assert (map.len == 0us);
    assert (map.values().len == 0us && map.keys().len == 0us);
    assert (!map.contains(1us));

    map:.insert(1us, copy Counter(1));
    assert (map.len == 1us && countOf(map, 1us) == 1);
}

__test string_keys {
    let dmut map = copy DenseMap!{[c8], &Counter}();
    map:.insert("a", copy Counter(1));
    map:.insert("b", copy Counter(2));
    map:.remove("a");

    assert (map.keys() == copy ["b"]);
    if let Ok(c) = map.find("b") {
        assert (c.count == 2);
    } else {
        assert (false);
    }
}
