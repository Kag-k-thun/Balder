in list_selection;

use balder::interface::widget::list::selection;

use ::sdl3::keycode;

__test a_click_selects_the_row_alone {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    assert (s:.click(3us, SDL_KMOD_NONE));
    assert (s:.click(5us, SDL_KMOD_NONE));
    assert (s.getSelected() == copy [5us] && s.getCurrent() == (5us)?);

    // clicking the row selected alone changes nothing, and a row past the list is ignored
    assert (!s:.click(5us, SDL_KMOD_NONE));
    assert (!s:.click(10us, SDL_KMOD_NONE) && s.getSelected() == copy [5us]);
}

__test ctrl_toggles_a_row_of_a_multiple_list {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    s:.click(2us, SDL_KMOD_NONE);
    assert (s:.click(6us, SDL_KMOD_CTRL));
    assert (s:.click(4us, SDL_KMOD_LCTRL));
    assert (s.getSelected() == copy [2us, 4us, 6us]);

    assert (s:.click(4us, SDL_KMOD_CTRL));
    assert (s.getSelected() == copy [2us, 6us] && s.getCurrent() == (4us)?);

    // Command toggles as Ctrl does
    assert (s:.click(3us, SDL_KMOD_GUI) && s.getSelected() == copy [2us, 3us, 6us]);
}

__test shift_selects_the_rows_from_the_anchor {
    let dmut s = ListSelection(count-> 20us, multiple-> true);
    s:.click(5us, SDL_KMOD_NONE);
    assert (s:.click(8us, SDL_KMOD_SHIFT));
    assert (s.getSelected() == copy [5us, 6us, 7us, 8us]);

    // the anchor stays on the row clicked last without Shift, above or below it
    assert (s:.click(3us, SDL_KMOD_SHIFT));
    assert (s.getSelected() == copy [3us, 4us, 5us] && s.getCurrent() == (3us)?);

    // Ctrl-Shift adds the rows from the anchor, the anchor moving to the row toggled last
    s:.click(12us, SDL_KMOD_CTRL);
    assert (s:.click(14us, SDL_KMOD_CTRL | SDL_KMOD_SHIFT));
    assert (s.getSelected() == copy [3us, 4us, 5us, 12us, 13us, 14us]);
    assert (s.getRanges() == copy [(3us, 6us), (12us, 15us)]);
}

__test shift_without_anchor_selects_the_row_alone {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    assert (s:.click(4us, SDL_KMOD_SHIFT));
    assert (s.getSelected() == copy [4us]);
}

__test a_single_list_selects_one_row {
    let dmut s = ListSelection(count-> 10us);
    s:.click(2us, SDL_KMOD_NONE);
    assert (s:.click(7us, SDL_KMOD_SHIFT) && s.getSelected() == copy [7us]);
    assert (s:.click(3us, SDL_KMOD_CTRL) && s.getSelected() == copy [3us]);

    // Ctrl unselects the selected row
    assert (s:.click(3us, SDL_KMOD_CTRL) && s.getSelected().len == 0us);
}

__test the_ranges_merge_and_split {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    s:.click(1us, SDL_KMOD_NONE);
    s:.click(3us, SDL_KMOD_CTRL);
    assert (s.getRanges() == copy [(1us, 2us), (3us, 4us)]);

    // the row between them joins them, and unselecting it splits them again
    s:.click(2us, SDL_KMOD_CTRL);
    assert (s.getRanges() == copy [(1us, 4us)]);
    s:.click(2us, SDL_KMOD_CTRL);
    assert (s.getRanges() == copy [(1us, 2us), (3us, 4us)]);
}

__test the_arrows_move_the_current_row_and_select_it {
    let dmut s = ListSelection(count-> 10us, multiple-> true);

    // without current row, the first press goes to the first selected row, the first row when none is
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_NONE, 4us) == (true)?);
    assert (s.getSelected() == copy [0us]);

    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_NONE, 4us) == (true)?);
    assert (s:.pressKey(SDLK_UP, SDL_KMOD_NONE, 4us) == (true)?);
    assert (s:.pressKey(SDLK_UP, SDL_KMOD_NONE, 4us) == (false)?);
    assert (s.getSelected() == copy [0us]);

    assert (s:.pressKey(SDLK_PAGEDOWN, SDL_KMOD_NONE, 4us) == (true)? && s.getCurrent() == (4us)?);
    assert (s:.pressKey(SDLK_END, SDL_KMOD_NONE, 4us) == (true)? && s.getSelected() == copy [9us]);
    assert (s:.pressKey(SDLK_PAGEDOWN, SDL_KMOD_NONE, 4us) == (false)? && s.getCurrent() == (9us)?);
    assert (s:.pressKey(SDLK_PAGEUP, SDL_KMOD_NONE, 4us) == (true)? && s.getCurrent() == (5us)?);
    assert (s:.pressKey(SDLK_HOME, SDL_KMOD_NONE, 4us) == (true)? && s.getSelected() == copy [0us]);
}

__test shift_extends_and_ctrl_moves_without_selecting {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    s:.click(4us, SDL_KMOD_NONE);
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_SHIFT, 4us) == (true)?);
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_SHIFT, 4us) == (true)?);
    assert (s.getSelected() == copy [4us, 5us, 6us]);

    // Ctrl moves the current row only, Ctrl-Space toggles it, Space selects it alone
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_CTRL, 4us) == (false)?);
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_CTRL, 4us) == (false)? && s.getCurrent() == (8us)?);
    assert (s:.pressKey(SDLK_SPACE, SDL_KMOD_CTRL, 4us) == (true)?);
    assert (s.getSelected() == copy [4us, 5us, 6us, 8us]);
    assert (s:.pressKey(SDLK_SPACE, SDL_KMOD_NONE, 4us) == (true)? && s.getSelected() == copy [8us]);

    // Ctrl-A selects every row
    assert (s:.pressKey(SDLK_A, SDL_KMOD_CTRL, 4us) == (true)? && s.getRanges() == copy [(0us, 10us)]);
}

__test the_keys_a_list_does_not_use {
    let dmut s = ListSelection(count-> 10us);
    assert (!s:.pressKey(SDLK_LEFT, SDL_KMOD_NONE, 4us).hasValue);
    assert (!s:.pressKey(SDLK_DOWN, SDL_KMOD_ALT, 4us).hasValue);

    // a single list leaves Ctrl-A, Ctrl selects as without it, and Shift is ignored
    assert (!s:.pressKey(SDLK_A, SDL_KMOD_CTRL, 4us).hasValue);
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_CTRL, 4us) == (true)? && s.getSelected() == copy [0us]);
    assert (s:.pressKey(SDLK_DOWN, SDL_KMOD_SHIFT, 4us) == (true)? && s.getSelected() == copy [1us]);

    // an empty list uses no key
    let dmut empty = ListSelection();
    assert (!empty:.pressKey(SDLK_DOWN, SDL_KMOD_NONE, 4us).hasValue);
}

__test the_rows_past_the_count_are_unselected {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    s:.click(2us, SDL_KMOD_NONE);
    s:.click(8us, SDL_KMOD_SHIFT);
    assert (s:.setCount(5us));
    assert (s.getSelected() == copy [2us, 3us, 4us] && s.getCurrent() == (4us)?);
    assert (!s:.setCount(20us));

    assert (s:.setCount(0us) && s.getSelected().len == 0us && !s.getCurrent().hasValue);
}

__test a_single_list_keeps_one_row {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    s:.click(2us, SDL_KMOD_NONE);
    s:.click(5us, SDL_KMOD_SHIFT);
    assert (s:.setMultiple(false) && s.getSelected() == copy [5us]);

    // the first selected row is kept when the current row is not selected
    let dmut t = ListSelection(count-> 10us, multiple-> true);
    t:.select(copy [3us, 5us, 7us]);
    t:.click(7us, SDL_KMOD_CTRL);
    assert (t:.setMultiple(false) && t.getSelected() == copy [3us]);
}

__test the_code_selects_rows {
    let dmut s = ListSelection(count-> 10us, multiple-> true);
    assert (s:.select(copy [7us, 2us, 3us, 12us]));
    assert (s.getRanges() == copy [(2us, 4us), (7us, 8us)] && s.getCurrent() == (3us)?);
    assert (!s:.select(copy [2us, 3us, 7us]));

    let dmut single = ListSelection(count-> 10us);
    assert (single:.select(copy [1us, 4us]) && single.getSelected() == copy [4us]);
    assert (single:.clear() && !single:.clear());
}
