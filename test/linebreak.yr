in linebreak;

use balder::interface::font::linebreak;

/**
 * (text, the bytes a line can start at, true where the line before must end)
 * */
@parameters ((yield c for c in [("", []),
                                ("word", []),
                                ("a\n", []),                                                // the end of the text is not listed
                                ("a )", []),                                                // never before a closing punctuation
                                ("(\u{0x65E5}", []),                                        // never after an opening one
                                ("a\u{0xA0}b", []),                                         // no break space
                                ("hello world", copy [(6us, false)]),
                                ("a  b", copy [(3us, false)]),                              // after the run of spaces
                                ("a\nb", copy [(2us, true)]),
                                ("a\r\nb", copy [(3us, true)]),                             // CR LF is one break
                                ("a\n\nb", copy [(2us, true), (3us, true)]),
                                ("well-known", copy [(5us, false)]),
                                ("a -5", copy [(2us, false)]),                              // not between a hyphen and a digit
                                ("a\u{0x200B}b", copy [(4us, false)]),                      // zero width space
                                ("e\u{0x301} x", copy [(4us, false)]),                      // never inside a grapheme
                                ("\u{0x65E5}\u{0x672C}\u{0x8A9E}", copy [(3us, false), (6us, false)]), // between ideographs
                                ("\u{0x65E5}\u{0x672C}\u{0x3002}", copy [(3us, false)]),    // not before an ideographic full stop
                                ("ab\u{0x65E5}cd", copy [(2us, false), (5us, false)])]))    // around an ideograph
__test break_opportunities (text: [c8], expected: [(usize, bool)]) {
    assert (breakOpportunities(text) == expected);
}

/**
 * (text, start, end, the end of its visible part)
 * */
@parameters ((yield c for c in [("abc  ", 0us, 5us, 3us),
                                ("abc\n", 0us, 4us, 3us),
                                ("abc \r\n", 0us, 6us, 3us),
                                ("a\t \u{0x3000}", 0us, 6us, 1us),                           // tab and ideographic space
                                ("   ", 0us, 3us, 0us),
                                ("ab  ", 2us, 4us, 2us),                                    // never before the start
                                ("a\u{0xA0}", 0us, 3us, 3us),                               // a no break space is visible
                                ("a b", 0us, 3us, 3us)]))
__test hanging_end (text: [c8], start: usize, end: usize, expected: usize) {
    assert (hangingEnd(text, start, end) == expected);
}
