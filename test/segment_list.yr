in segment_list;

use balder::core::memory::segments;

/**
 * A range of 100 with [10, 20) reserved, so [0, 10) and [20, 100) are free
 * */
fn fragmented()-> dmut &SegmentList {
    let dmut segs = copy SegmentList(100us);
    segs:.reserve(0us, 10us, 10us);
    alias segs
}

/**
 * (size, align, expected offset or -1 when nothing fits)
 * */
@parameters ((yield c for c in [(10us, 1us, 0i64),
                                (5us, 1us, 0i64),
                                (11us, 1us, 20i64),
                                (8us, 8us, 0i64),
                                (11us, 16us, 32i64),
                                (80us, 1us, 20i64),
                                (81us, 1us, -1i64)]))
__test best_fit_alloc (size: usize, align: usize, expected: i64) {
    let dmut segs = fragmented();
    if let Ok(offset) = segs:.alloc(size, align) {
        assert (cast!i64(offset) == expected);
    } else {
        assert (expected == -1i64);
    }
}

/**
 * Order in which three adjacent reservations are freed
 * */
@parameters ((yield o for o in [[0us, 1us, 2us], [0us, 2us, 1us], [1us, 0us, 2us],
                                [1us, 2us, 0us], [2us, 0us, 1us], [2us, 1us, 0us]]))
__test free_coalesces (order: [usize; 3us]) {
    let dmut segs = copy SegmentList(90us);
    for _ in 0 .. 3 {
        segs:.alloc(30us, 1us);
    }

    for i in order {
        segs:.free(i * 30us, 30us);
    }

    assert (segs.isEmpty());
    assert (segs.getFreeSegments().len == 1us);
}

__test middle_reservation_splits {
    let dmut segs = copy SegmentList(100us);
    segs:.reserve(0us, 40us, 20us);

    let free = segs.getFreeSegments();
    assert (free.len == 2us);
    assert (free[0].start == 0us && free[0].end == 40us);
    assert (free[1].start == 60us && free[1].end == 100us);
}

__test grow_frees_the_extension {
    let dmut segs = copy SegmentList(10us);
    segs:.alloc(10us, 1us);
    assert (segs.getFreeSegments().len == 0us);

    segs:.grow(30us);
    assert (segs.getSize() == 30us);

    let free = segs.getFreeSegments();
    assert (free.len == 1us);
    assert (free[0].start == 10us && free[0].end == 30us);

    if let Ok(offset) = segs:.alloc(20us, 1us) {
        assert (offset == 10us);
    } else {
        assert (false);
    }
}

__test grow_merges_with_the_last_free_segment {
    let dmut segs = copy SegmentList(20us);
    segs:.alloc(5us, 1us);
    segs:.grow(40us);

    let free = segs.getFreeSegments();
    assert (free.len == 1us);
    assert (free[0].start == 5us && free[0].end == 40us);
}

__test grow_never_shrinks {
    let dmut segs = copy SegmentList(20us);
    segs:.grow(10us);
    assert (segs.getSize() == 20us);
}

__test nothing_reserved_ends_at_zero {
    let segs = copy SegmentList(100us);
    assert (segs.getReservedEnd() == 0us);
}

/**
 * (reservations as (offset, size), expected end of the last reservation) in a range of 100
 * */
@parameters ((yield c for c in [(copy [(0us, 10us)], 10us),
                                (copy [(0us, 10us), (40us, 20us)], 60us),
                                (copy [(80us, 20us)], 100us),
                                (copy [(0us, 100us)], 100us)]))
__test reserved_end (reservations: [(usize, usize)], expected: usize) {
    let dmut segs = copy SegmentList(100us);
    for r in reservations {
        let (succ, _, index) = segs.findFreeSegment(r.1, 1us);
        assert (succ);
        segs:.reserve(index, r.0, r.1);
    }

    assert (segs.getReservedEnd() == expected);
}
