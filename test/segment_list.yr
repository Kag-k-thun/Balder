in segment_list;

use balder::core::memory::segments;

/**
 * A range of 100 with [10, 20) reserved, so [0, 10) and [20, 100) are free
 * */
fn fragmented()-> dmut &SegmentList {
    let dmut segs = copy SegmentList(100us);
    segs:.reserve(0us, 10us, 10us);
    alias segs
}

/**
 * (size, align, expected offset or -1 when nothing fits)
 * */
@parameters ((yield c for c in [(10us, 1us, 0i64),
                                (5us, 1us, 0i64),
                                (11us, 1us, 20i64),
                                (8us, 8us, 0i64),
                                (11us, 16us, 32i64),
                                (80us, 1us, 20i64),
                                (81us, 1us, -1i64)]))
__test best_fit_alloc (size: usize, align: usize, expected: i64) {
    let dmut segs = fragmented();
    if let Ok(offset) = segs:.alloc(size, align) {
        assert (cast!i64(offset) == expected);
    } else {
        assert (expected == -1i64);
    }
}

/**
 * Order in which three adjacent reservations are freed
 * */
@parameters ((yield o for o in [[0us, 1us, 2us], [0us, 2us, 1us], [1us, 0us, 2us],
                                [1us, 2us, 0us], [2us, 0us, 1us], [2us, 1us, 0us]]))
__test free_coalesces (order: [usize; 3us]) {
    let dmut segs = copy SegmentList(90us);
    for _ in 0 .. 3 {
        segs:.alloc(30us, 1us);
    }

    for i in order {
        segs:.free(i * 30us, 30us);
    }

    assert (segs.isEmpty());
    assert (segs.getFreeSegments().len == 1us);
}

__test middle_reservation_splits {
    let dmut segs = copy SegmentList(100us);
    segs:.reserve(0us, 40us, 20us);

    let free = segs.getFreeSegments();
    assert (free.len == 2us);
    assert (free[0].start == 0us && free[0].end == 40us);
    assert (free[1].start == 60us && free[1].end == 100us);
}
