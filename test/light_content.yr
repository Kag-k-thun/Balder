in light_content;

use balder::math::vector;
use balder::scene::_;
use balder::scene::node::{_, node3D::_};
use balder::scene::utils::light::{direction, point, spot};

use std::math;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super ("")
    {}

    pub over onEnter (mut self, dmut _ : &Scene) {}
    pub over onExit (mut self, dmut _ : &Scene) {}

}

/**
 * A 3D node with no volume of its own, moving the lights it holds
 * */
class Group over Node3D {

    pub self (name : [c8], dmut parent : &Node)
        with super (name, alias parent)
    {}

    pub over onEnter (mut self, dmut _ : &Scene) {}
    pub over onExit (mut self, dmut _ : &Scene) {}

}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near (a : vec3, b : vec3)-> bool {
    (a - b).length () < 0.0001f
}

/**
 * @returns: true iif two floats are equal, give or take the rounding errors
 * */
fn near (a : f32, b : f32)-> bool {
    math::abs (a - b) < 0.0001f
}

__test a_direction_light_shines_along_its_unit_direction {
    let dmut root = copy Root ();
    let dmut light = copy Light ("sun", alias root);
    light.direction = makeVec3 (0.0f, -2.0f, 0.0f);
    light.color = makeVec3 (1.0f, 0.5f, 0.25f);
    light.intensity = 3.0f;

    let content = DirectionLightContent (light);
    assert (near (content.direction, makeVec3 (0.0f, -1.0f, 0.0f)));
    assert (near (content.color, makeVec3 (1.0f, 0.5f, 0.25f)));
    assert (content.intensity == 3.0f);
}

__test a_point_light_is_read_at_its_position_in_world_space {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);
    group.position = makeVec3 (10.0f, 0.0f, 0.0f);

    let dmut light = copy Light ("lamp", alias group);
    light.type = LightType::POINT;
    light.position = makeVec3 (0.0f, 2.0f, 0.0f);
    light.range = 8.0f;

    let content = PointLightContent (light);
    assert (near (content.position, makeVec3 (10.0f, 2.0f, 0.0f)));
    assert (content.range == 8.0f);
}

__test a_point_light_follows_the_moves_of_its_parent {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);
    let dmut light = copy Light ("lamp", alias group);
    light.position = makeVec3 (1.0f, 0.0f, 0.0f);

    group.position = makeVec3 (0.0f, 0.0f, 5.0f);
    assert (near (PointLightContent (light).position, makeVec3 (1.0f, 0.0f, 5.0f)));
}

__test the_direction_of_a_light_is_not_moved_by_its_parent {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);
    group.position = makeVec3 (3.0f, 4.0f, 5.0f);

    let dmut light = copy Light ("spot", alias group);
    light.direction = makeVec3 (1.0f, 0.0f, 0.0f);

    assert (near (SpotLightContent (light).direction, makeVec3 (1.0f, 0.0f, 0.0f)));
}

__test the_cone_of_a_spot_light_holds_the_cosines_of_its_angles {
    let dmut root = copy Root ();
    let dmut light = copy Light ("spot", alias root);
    light.innerAngle = 0.0f;
    light.outerAngle = 60.0f;

    let content = SpotLightContent (light);
    assert (near (content.cosInner, 1.0f));
    assert (near (content.cosOuter, 0.5f));
}

__test the_full_light_of_a_spot_light_stays_inside_its_light {
    let dmut root = copy Root ();
    let dmut light = copy Light ("spot", alias root);
    light.innerAngle = 40.0f;
    light.outerAngle = 30.0f;

    let content = SpotLightContent (light);
    assert (content.cosInner > content.cosOuter);
}

__test the_angles_of_a_spot_light_are_clamped_to_a_quarter_turn {
    let dmut root = copy Root ();
    let dmut light = copy Light ("spot", alias root);
    light.innerAngle = 120.0f;
    light.outerAngle = 180.0f;

    let content = SpotLightContent (light);
    assert (near (content.cosOuter, 0.0f));
    assert (content.cosInner > content.cosOuter);
}
