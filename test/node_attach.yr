in node_attach;

use balder::scene::_;
use balder::scene::node;
use balder::scene::node::node3D::empty;

use std::fs;

/**
 * A root with no scene, for the nodes of the tests to hang from, keeping the names of the nodes entering its tree
 * */
class Root over Node {

    // The names of the nodes that entered the tree, in order
    let mut _entered: [[c8]] = [];

    pub self ()
        with super::root ("")
    {}

    @field
    pub fn entered(self)-> [[c8]] {
        self._entered
    }

    over onTreeEnter(mut self, dmut who: &Node) {
        self._entered ~= [who.name.file()];
    }

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

__test a_disposed_node_leaves_its_parent_with_the_nodes_under_it {
    let dmut root = copy Root();
    let dmut a = copy Empty3D("a", alias root);
    let _b_ = copy Empty3D("b", alias a);

    a:.dispose();
    assert (!a:.getParent().hasValue);
    assert (root:.getChilds().len == 0us);
    assert (a:.find(Path("b")).hasValue);
}

__test a_detached_node_is_attached_again_with_the_nodes_under_it {
    let dmut root = copy Root();
    let dmut a = copy Empty3D("a", alias root);
    let dmut group = copy Empty3D("group", alias root);
    let c = copy Empty3D("c", alias a);

    a:.dispose();
    assert (a:.attach(alias group, at-> LAST_PLACE));
    assert (root:.find(Path("group/a/c")).hasValue);
    assert (a.name == Path("group/a") && c.name == Path("group/a/c"));
    assert (!root:.find(Path("a")).hasValue);
}

__test a_node_attached_again_enters_the_tree_before_the_nodes_under_it {
    let dmut root = copy Root();
    let dmut a = copy Empty3D("a", alias root);
    let _b_ = copy Empty3D("b", alias a);

    a:.dispose();
    let before = root.entered.len;
    assert (a:.attach(alias root, at-> LAST_PLACE));
    assert (root.entered[before .. $] == ["a", "b"]);
}

__test a_node_is_attached_neither_twice_nor_where_a_child_has_its_name {
    let dmut root = copy Root();
    let dmut a = copy Empty3D("a", alias root);
    let dmut group = copy Empty3D("group", alias root);

    // attached already
    assert (!a:.attach(alias group, at-> LAST_PLACE));

    let _twin_ = copy Empty3D("a", alias group);
    a:.dispose();
    assert (!a:.attach(alias group, at-> LAST_PLACE));
    assert (!a:.getParent().hasValue);
}
