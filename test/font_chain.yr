in font_chain;

use balder::core::error;
use balder::interface::font::{chain, face, family, registry};

// A code point of DejaVu Sans Mono that Noto Sans lacks, the armenian capital AYB
def AYB = '\u{0x531}'c32;

// A code point no shipped font has
def ZHONG = '\u{0x4E2D}'c32;

fn shipped()-> dmut &FontRegistry {
    let dmut r = copy FontRegistry(systemDirs-> []);
    r:.registerDirectory(FontRegistry::RES_FONT_DIR);
    r:.setGlobalFallbacks(copy ["DejaVu Sans Mono"]);
    alias r
}

__test primary_face_is_the_first_family {
    let dmut r = shipped();
    let dmut c = copy FontChain(alias r, copy ["No Such Family", "Noto Sans"]);
    assert (c:.getPrimary().path.file() == "NotoSans-Regular.ttf");
}

__test chain_without_face_throws {
    let dmut r = copy FontRegistry(systemDirs-> []);
    r:.setGlobalFallbacks([]);
    let dmut c = copy FontChain(alias r, copy ["No Such Family"]);
    let thrown = {
        c:.getPrimary();
        false
    } catch {
        _ : &BalderError => { true }
    };

    assert (thrown);
}

__test fallbacks_are_resolved_on_demand {
    let dmut r = shipped();
    let dmut c = copy FontChain(alias r, copy ["Noto Sans"]);
    assert (c:.findFace(copy ['A'c32]) == 0u32);
    assert (c.getNbFaces() == 1u32);

    assert (c:.findFace(copy [AYB]) == 1u32);
    assert (c.getNbFaces() == 2u32);
    assert (c:.getFace(1u32).path.file() == "DejaVuSansMono.ttf");
}

__test uncovered_code_point_takes_the_primary_face {
    let dmut r = shipped();
    let dmut c = copy FontChain(alias r, copy ["Noto Sans"]);
    assert (c:.findFace(copy [ZHONG]) == 0u32);
}

__test grapheme_stays_with_the_face_of_its_base {
    let dmut r = shipped();
    let dmut c = copy FontChain(alias r, copy ["Noto Sans"]);

    // a combining acute accent, and a variation selector no face needs a glyph for
    assert (c:.findFace(copy ['e'c32, '\u{0x301}'c32]) == 0u32);
    assert (c:.findFace(copy ['e'c32, '\u{0xFE0F}'c32]) == 0u32);
    assert (c:.findFace(copy [AYB, '\u{0x301}'c32]) == 1u32);
}

__test chain_uses_the_requested_style {
    let dmut r = shipped();
    let dmut c = copy FontChain(alias r, copy ["Noto Sans"], weight-> 700u32, style-> FontStyle::ITALIC);
    assert (c:.getPrimary().path.file() == "NotoSans-BoldItalic.ttf");
    assert (!c:.getPrimary().isSyntheticBold() && !c:.getPrimary().isSyntheticOblique());

    // the regular face of the family follows its closest face, then the fallback, both lacking the weight and the style
    assert (c:.findFace(copy [AYB]) == 2u32);
    assert (c:.getFace(1u32).path.file() == "NotoSans-Regular.ttf");
    assert (c:.getFace(2u32).path.file() == "DejaVuSansMono.ttf");
    for i in 1u32 .. 3u32 {
        assert (c:.getFace(i).isSyntheticBold() && c:.getFace(i).isSyntheticOblique());
    }
}

__test regular_face_covers_what_the_styled_face_lacks {
    // a family whose italic face is the armenian-less Noto Sans Italic, and whose regular face has armenian letters
    let dmut r = copy FontRegistry(systemDirs-> []);
    r:.setGlobalFallbacks([]);
    r:.registerFile("res:/fonts/noto/NotoSans-Italic.ttf", family-> "Mixed");
    r:.registerFile("res:/fonts/DejaVuSansMono.ttf", family-> "Mixed");

    let dmut c = copy FontChain(alias r, copy ["Mixed"], style-> FontStyle::ITALIC);
    assert (c:.findFace(copy ['a'c32]) == 0u32);
    assert (c:.findFace(copy [AYB]) == 1u32);
    assert (c:.getFace(1u32).path.file() == "DejaVuSansMono.ttf");
    assert (c:.getFace(1u32).isSyntheticOblique());
}

__test duplicated_faces_are_skipped {
    let dmut r = shipped();
    r:.setGeneric("sans-serif", copy ["Noto Sans"]);
    let dmut c = copy FontChain(alias r, copy ["Noto Sans", "sans-serif"]);
    assert (c:.findFace(copy [AYB]) == 1u32);
    assert (c:.getFace(1u32).path.file() == "DejaVuSansMono.ttf");
}
