in file_watcher;

use balder::core::dispose;
use balder::core::application::signal;
use balder::utils::watcher;

use std::fs::{errors, path, sys};
use std::time::dur;

/**
 * The files a watcher reported, in the order its signal was emitted
 * */
class Changes {

    pub let mut files: [[c8]] = [];

    pub self () {}

    pub fn onChanged(mut self, file: [c8]) {
        self.files ~= [file];
    }
}

/**
 * Emit the box until the watcher reported count changes, for two seconds at most
 * */
fn waitFor(dmut box: &SlotEmitter, changes: &Changes, count: usize) {
    for _ in 0us .. 200us {
        box:.emit();
        if changes.files.len >= count { return; }

        sleep(millis(10u64));
    }
}

/**
 * Emit the box for a fifth of a second, the time for an event that should not come
 */
fn settle(dmut box: &SlotEmitter) {
    for _ in 0us .. 20us {
        box:.emit();
        sleep(millis(10u64));
    }
}

__test a_file_written_is_reported_and_its_neighbours_are_not {
    let dir = tempDirectory(prefix-> "balder_watch_");
    let watched = dir.push("app.style").toStr();
    writeFile(Path(watched), "Box { radius: 1; }");
    writeFile(dir.push("other.style"), "");

    let dmut box = copy SlotEmitter();
    let dmut changes = copy Changes();
    let dmut w = copy FileWatcher();
    w:.changed():.connect(alias box, &changes:.onChanged);
    w:.watch(watched);

    writeFile(dir.push("other.style"), "Box { radius: 2; }");
    settle(alias box);
    assert (changes.files.len == 0us);

    writeFile(Path(watched), "Box { radius: 3; }");
    waitFor(alias box, changes, 1us);
    settle(alias box);
    assert (changes.files == [watched]);

    w:.dispose();
    removeDir(dir, recursive-> true);
}

__test a_file_replaced_by_a_rename_is_reported {
    // an editor saving through a temporary file renamed over the file replaces it
    let dir = tempDirectory(prefix-> "balder_watch_");
    let watched = dir.push("app.gui").toStr();
    writeFile(Path(watched), "Box;");

    let dmut box = copy SlotEmitter();
    let dmut changes = copy Changes();
    let dmut w = copy FileWatcher();
    w:.changed():.connect(alias box, &changes:.onChanged);
    w:.watch(watched);

    writeFile(dir.push(".app.gui.swp"), "Label;");
    rename(dir.push(".app.gui.swp"), Path(watched));
    waitFor(alias box, changes, 1us);
    assert (changes.files == [watched]);

    // the directory is watched, not the file replaced: the new file is reported as well
    writeFile(Path(watched), "Separator;");
    waitFor(alias box, changes, 2us);
    assert (changes.files == [watched, watched]);

    w:.dispose();
    removeDir(dir, recursive-> true);
}

__test a_disposed_watcher_reports_nothing {
    let dir = tempDirectory(prefix-> "balder_watch_");
    let watched = dir.push("app.style").toStr();
    writeFile(Path(watched), "");

    let dmut box = copy SlotEmitter();
    let dmut changes = copy Changes();
    let dmut w = copy FileWatcher();
    w:.changed():.connect(alias box, &changes:.onChanged);
    w:.watch(watched);
    w:.dispose();

    writeFile(Path(watched), "Box { radius: 1; }");
    settle(alias box);
    assert (changes.files.len == 0us);

    // watched again, by a thread of its own
    w:.watch(watched);
    writeFile(Path(watched), "Box { radius: 2; }");
    waitFor(alias box, changes, 1us);
    assert (changes.files == [watched]);

    w:.dispose();
    removeDir(dir, recursive-> true);
}
