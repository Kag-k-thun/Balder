in shadow_config;

use balder::core::error;
use balder::core::config::shadow;

use std::config::toml;

/**
 * The [shadow] table written in `text`
 * */
fn shadow(text: [c8])-> ShadowConfig
    throws BalderError
{
    {
        ShadowConfig(toml::parse(text))
    } catch {
        b: &BalderError => throw b;
        _ => throw copy BalderError("Malformed test configuration " ~ text);
    }
}

/**
 * @returns: true if reading the [shadow] table written in `text` throws a BalderError
 * */
fn rejects(text: [c8])-> bool {
    {
        shadow(text);
        false
    } catch {
        _: &BalderError => {
            true
        }
    }
}

__test the_defaults_draw_a_2048_atlas_up_to_50_units {
    let cfg = shadow("");
    assert (cfg.scale == 2048u32);
    assert (cfg.distance == 50.0f);

    let default = ShadowConfig();
    assert (default.scale == 2048u32 && default.distance == 50.0f);
}

__test the_scale_and_the_distance_are_read {
    let cfg = shadow("scale = 4096\ndistance = 30.5");
    assert (cfg.scale == 4096u32);
    assert (cfg.distance == 30.5f);

    // an integer distance is a number of units too
    assert (shadow("distance = 80").distance == 80.0f);
}

/**
 * A table the reading refuses: a scale odd, too small, too large or not an integer, a distance not positive
 * */
@parameters ((yield c for c in ["scale = 2047",
                                "scale = 16",
                                "scale = 32768",
                                "scale = 2048.0",
                                "scale = \"2048\"",
                                "distance = 0",
                                "distance = -10.0",
                                "distance = \"far\""]))
__test a_malformed_table_is_refused (text: [c8]) {
    assert (rejects(text));
}
