in volume_handles;

use balder::core::application::signal;
use balder::math::vector;
use balder::scene::edit::volume_edit;
use balder::scene::gizmo;
use balder::scene::gizmo::{handle, view};
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{camera, empty, volume, volume_shape};
use balder::scene::utils::post::gizmo::shape;

use std::math;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * Counts the emissions of a signal
 * */
class Counter {

    pub let mut count: usize = 0us;

    pub self () {}

    pub fn onReshaped(mut self) {
        self.count += 1us;
    }

}

/**
 * @returns: true iif two numbers are equal, give or take the rounding errors
 * */
fn near(a: f32, b: f32, tolerance: f32 = 0.001f)-> bool {
    math::abs(a - b) < tolerance
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3, tolerance: f32 = 0.001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: a camera on the Z axis 10 units from the origin, looking at it, seeing it into an image of 1280 × 720
 * */
fn cameraOf(dmut root: &Node)-> dmut &Camera {
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(0.0f, 0.0f, 10.0f);
    cam.target = makeVec3(0.0f, 0.0f, 0.0f);

    alias cam
}

/**
 * @returns: the point of the image a point of the world is seen at, the centre of the image when it is behind the camera
 * */
fn seen(view: GizmoView, p: vec3)-> vec2 {
    if let Ok(px) = view.project(p) { px } else { makeVec2(640.0f, 360.0f) }
}

/**
 * @returns: a box of side 2 centred on (3, 0, 0), under a root
 * */
fn boxOf(dmut root: &Node)-> dmut &Volume3D {
    let dmut v = copy Volume3D("box", alias root, shape-> VolumeShape(VolumeKind::BOX, makeVec3(2.0f, 2.0f, 2.0f), 0.5f, 2.0f));
    v.position = makeVec3(3.0f, 0.0f, 0.0f);

    alias v
}

/**
 * @returns: a gizmo moving a node alone
 * */
fn gizmoOn(dmut root: &Node, dmut node: &Node3D)-> dmut &TransformGizmo {
    let dmut g = copy TransformGizmo("gizmo", alias root);
    g:.setNodes(copy [alias node]);

    alias g
}

__test the_square_of_a_face_under_the_cursor_is_picked_the_closest_to_the_eye {
    let dmut root = copy Root();
    let view = GizmoView(cameraOf(alias root), 1280u32, 720u32);
    let dmut v = alias boxOf(alias root);
    let dmut g = alias gizmoOn(alias root, alias v);

    assert (g.faceAt(view, seen(view, makeVec3(4.0f, 0.0f, 0.0f))) == (0us)?);
    assert (g.faceAt(view, seen(view, makeVec3(3.0f, -1.0f, 0.0f))) == (3us)?);

    // the faces across Z are seen on top of each other, the one toward the eye picked
    assert (g.faceAt(view, seen(view, makeVec3(3.0f, 0.0f, 1.0f))) == (4us)?);
    assert (!g.faceAt(view, seen(view, makeVec3(3.0f, 0.5f, 1.0f))).hasValue);

    g:.hover(view, seen(view, makeVec3(2.0f, 0.0f, 0.0f)));
    assert (g.hovered == GizmoHandle::FACE && g.face == 1us);
}

__test the_faces_are_shown_for_a_volume_moved_alone_only {
    let dmut root = copy Root();
    let view = GizmoView(cameraOf(alias root), 1280u32, 720u32);
    let dmut v = alias boxOf(alias root);
    let dmut other = copy Empty3D("other", alias root);

    let dmut g = copy TransformGizmo("gizmo", alias root);
    g:.setNodes(copy [alias other, alias v]);
    assert (!g.volume().hasValue && !g.faceAt(view, seen(view, makeVec3(4.0f, 0.0f, 0.0f))).hasValue);
    let without = g.shapes(view).len;

    g:.setNodes(copy [alias v]);
    assert (g.volume().hasValue);

    // each face a light square over a dark one, two triangles each
    assert (g.shapes(view).len == without + VOLUME_FACES * 4us);
}

__test a_face_dragged_moves_along_its_normal_the_opposite_face_staying_where_it_is {
    let dmut root = copy Root();
    let view = GizmoView(cameraOf(alias root), 1280u32, 720u32);
    let dmut v = alias boxOf(alias root);
    let dmut g = alias gizmoOn(alias root, alias v);

    let dmut box = copy SlotEmitter();
    let dmut counter = copy Counter();
    g:.reshaped():.connect(alias box, &counter:.onReshaped);

    assert (g:.grab(view, seen(view, makeVec3(4.0f, 0.0f, 0.0f))) && g.grabbed == GizmoHandle::FACE && g.face == 0us);
    g:.drag(view, seen(view, makeVec3(5.0f, 0.0f, 0.0f)), false);
    assert (near(v.shape.size, makeVec3(3.0f, 2.0f, 2.0f), tolerance-> 0.01f));
    assert (near(v.position, makeVec3(3.5f, 0.0f, 0.0f), tolerance-> 0.01f));

    // off the normal, along it only
    g:.drag(view, seen(view, makeVec3(5.0f, 1.0f, 0.0f)), false);
    assert (near(v.position.y, 0.0f) && near(v.shape.size.y, 2.0f));

    g:.drag(view, seen(view, makeVec3(5.0f, 0.0f, 0.0f)), false);
    assert (g:.release() && !g.isDragging);
    box:.emit();
    assert (counter.count == 1us);

    if let Ok(e) = g.volumeEdit {
        assert (near(e.before.size.x, 2.0f) && near(e.after.size.x, 3.0f, tolerance-> 0.01f));
        assert (near(e.placedBefore.position, makeVec3(3.0f, 0.0f, 0.0f)));
    } else {
        assert (false);
    }
}

__test a_face_dragged_then_cancelled_gives_the_volume_back_its_shape {
    let dmut root = copy Root();
    let view = GizmoView(cameraOf(alias root), 1280u32, 720u32);
    let dmut v = alias boxOf(alias root);
    let dmut g = alias gizmoOn(alias root, alias v);

    assert (g:.grab(view, seen(view, makeVec3(3.0f, 1.0f, 0.0f))) && g.face == 2us);
    g:.drag(view, seen(view, makeVec3(3.0f, 2.0f, 0.0f)), false);
    assert (v.shape.size.y > 2.5f);

    g:.cancel();
    assert (!g.isDragging && v.shape.size == makeVec3(2.0f, 2.0f, 2.0f) && v.position == makeVec3(3.0f, 0.0f, 0.0f));
}

__test a_face_of_a_scaled_volume_moves_by_the_world_distance_the_cursor_goes {
    let dmut root = copy Root();
    let view = GizmoView(cameraOf(alias root), 1280u32, 720u32);
    let dmut v = alias boxOf(alias root);
    v.scale = makeVec3(2.0f, 1.0f, 1.0f);
    let dmut g = alias gizmoOn(alias root, alias v);

    // the -X face, at 3 - 2, pulled one unit further
    assert (g:.grab(view, seen(view, makeVec3(1.0f, 0.0f, 0.0f))) && g.face == 1us);
    g:.drag(view, seen(view, makeVec3(0.0f, 0.0f, 0.0f)), false);
    assert (near(v.shape.size.x, 2.5f, tolerance-> 0.01f));
    assert (near(v.position.x - v.shape.size.x, 0.0f, tolerance-> 0.01f));
    assert (near(v.position.x + v.shape.size.x, 5.0f, tolerance-> 0.01f));
}
