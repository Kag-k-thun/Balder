in bounding_volumes;

use balder::math::{bounds, matrix, utils, vector};

use std::math;

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3)-> bool {
    (a - b).length() < 0.0001f
}

/**
 * @returns: true iif two boxes are equal, give or take the rounding errors
 * */
fn near(a: Aabb, b: Aabb)-> bool {
    near(a.min, b.min) && near(a.max, b.max)
}

/**
 * @returns: the box of side 2 centered on a point
 * */
fn cube(center: vec3)-> Aabb {
    Aabb(center - 1.0f, center + 1.0f)
}

/**
 * @returns: the frustum of a camera at a position looking down -z, with a vertical field of view of 90° and a square
 * aspect, seeing from 1 to 10 units in front of it
 * */
fn perspectiveFrustum(eye: vec3)-> Frustum {
    let proj = perspective!{f32}(radian(90.0f), 1.0f, 1.0f, 10.0f);
    let view = lookAt!{f32}(eye, eye + makeVec3(0.0f, 0.0f, -1.0f), makeVec3(0.0f, 1.0f, 0.0f));

    Frustum(proj * view)
}

/**
 * @returns: the point of the image of a view a point of the world is seen at, in normalized device coordinates, and its
 * depth, -1 on the near plane and 1 on the far plane
 * */
fn project(viewProj: mat4, point: vec3)-> vec3 {
    let clip = viewProj * makeVec4(point, 1.0f);
    clip.xyz / clip.w
}

/**
 * @returns: the distance at which a ray enters a box, -1 when it misses it
 * */
fn entry(box: Aabb, ray: Ray)-> f32 {
    if let Ok(d) = box.intersect(ray) { d } else { -1.0f }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          AABB          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_default_box_is_empty_and_merges_into_the_other_box {
    let box = cube(makeVec3(1.0f, 2.0f, 3.0f));

    assert (Aabb().isEmpty);
    assert (!box.isEmpty);
    assert (near(Aabb().merged(box), box));
    assert (near(box.merged(Aabb()), box));
}

__test a_merged_box_encloses_both_boxes {
    let merged = cube(makeVec3(0.0f, 0.0f, 0.0f)).merged(cube(makeVec3(3.0f, -2.0f, 1.0f)));

    assert (near(merged, Aabb(makeVec3(-1.0f, -3.0f, -1.0f), makeVec3(4.0f, 1.0f, 2.0f))));
}

__test a_grown_box_keeps_its_center {
    let grown = Aabb(makeVec3(-1.0f, 0.0f, 2.0f), makeVec3(3.0f, 2.0f, 4.0f)).grown(0.5f);

    assert (near(grown, Aabb(makeVec3(-2.0f, -0.5f, 1.5f), makeVec3(4.0f, 2.5f, 4.5f))));
    assert (grown.contains(Aabb(makeVec3(-1.0f, 0.0f, 2.0f), makeVec3(3.0f, 2.0f, 4.0f))));
    assert (Aabb().grown(0.5f).isEmpty);
}

__test a_box_contains_the_boxes_inside_it {
    let box = cube(vec3());

    assert (box.contains(box));
    assert (box.contains(Aabb(makeVec3(-0.5f, 0.0f, 0.5f), makeVec3(0.5f, 1.0f, 1.0f))));
    assert (!box.contains(cube(makeVec3(0.5f, 0.0f, 0.0f))));
    assert (!box.contains(box.merged(cube(makeVec3(0.0f, 0.0f, 3.0f)))));

    // the empty box is in every box, and contains none but itself
    assert (box.contains(Aabb()));
    assert (Aabb().contains(Aabb()));
    assert (!Aabb().contains(box));
}

__test a_translated_box_keeps_its_size {
    let moved = cube(vec3()).transformed(translation(makeVec3(2.0f, 0.0f, -1.0f)));

    assert (near(moved, Aabb(makeVec3(1.0f, -1.0f, -2.0f), makeVec3(3.0f, 1.0f, 0.0f))));
}

__test a_scaled_box_scales_around_the_origin {
    let scaled = cube(makeVec3(1.0f, 0.0f, 0.0f)).transformed(scaling(makeVec3(2.0f, 3.0f, 0.5f)));

    assert (near(scaled, Aabb(makeVec3(0.0f, -3.0f, -0.5f), makeVec3(4.0f, 3.0f, 0.5f))));
}

__test a_rotated_box_encloses_its_rotated_corners {
    let rotated = cube(vec3()).transformed(rotationY(radian(45.0f)));
    let half = cast!f32(math::sqrt(2.0));

    // the diagonal of the square face of side 2 is along the x and z axes
    assert (near(rotated, Aabb(makeVec3(-half, -1.0f, -half), makeVec3(half, 1.0f, half))));

    // a quarter turn swaps the sizes along x and z
    let flat = Aabb(makeVec3(-2.0f, -1.0f, -1.0f), makeVec3(2.0f, 1.0f, 1.0f));
    assert (near(flat.transformed(rotationY(radian(90.0f))), Aabb(makeVec3(-1.0f, -1.0f, -2.0f), makeVec3(1.0f, 1.0f, 2.0f))));
}

__test a_transformed_empty_box_stays_empty {
    assert (Aabb().transformed(translation(makeVec3(1.0f, 1.0f, 1.0f))).isEmpty);
}

__test the_sphere_of_a_box_passes_through_its_corners {
    let sphere = Aabb(makeVec3(0.0f, 0.0f, 0.0f), makeVec3(2.0f, 4.0f, 4.0f)).boundingSphere;

    assert (near(sphere.center, makeVec3(1.0f, 2.0f, 2.0f)));
    assert (math::abs(sphere.radius - 3.0f) < 0.0001f);
    assert (Aabb().boundingSphere.isEmpty);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          PLANE          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_plane_is_normalized_from_its_equation {
    // 2z - 4 = 0, the plane z = 2 facing +z
    let plane = Plane(makeVec4(0.0f, 0.0f, 2.0f, -4.0f));

    assert (near(plane.normal, makeVec3(0.0f, 0.0f, 1.0f)));
    assert (math::abs(plane.signedDistance(makeVec3(7.0f, -3.0f, 5.0f)) - 3.0f) < 0.0001f);
    assert (math::abs(plane.signedDistance(makeVec3(0.0f, 0.0f, -1.0f)) + 3.0f) < 0.0001f);
}

__test every_point_is_in_front_of_the_default_plane {
    assert (Plane().signedDistance(makeVec3(-1000.0f, 1000.0f, 0.0f)) > 0.0f);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          FRUSTUM          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_planes_of_a_perspective_measure_distances {
    let frustum = perspectiveFrustum(vec3());
    let point = makeVec3(0.0f, 0.0f, -5.0f);
    let side = 5.0f / cast!f32(math::sqrt(2.0));

    // left, right, bottom, top: the sides at 45° of the axis, near at z = -1, far at z = -10
    for i in 0us .. 4us {
        assert (math::abs(frustum.planes[i].signedDistance(point) - side) < 0.0001f);
    }

    assert (math::abs(frustum.planes[4us].signedDistance(point) - 4.0f) < 0.0001f);
    assert (math::abs(frustum.planes[5us].signedDistance(point) - 5.0f) < 0.0001f);
}

@parameters ((yield c for c in [(makeVec3(0.0f, 0.0f, -5.0f), Containment::INSIDE),         // on the axis
                                (makeVec3(0.0f, 0.0f, 5.0f), Containment::OUTSIDE),         // behind the camera
                                (makeVec3(0.0f, 0.0f, -20.0f), Containment::OUTSIDE),       // past the far plane
                                (makeVec3(0.0f, 0.0f, -10.5f), Containment::INTERSECTING),  // across the far plane
                                (makeVec3(0.0f, 0.0f, -1.5f), Containment::INTERSECTING),   // across the near plane
                                (makeVec3(10.0f, 0.0f, -5.0f), Containment::OUTSIDE),       // right of the view
                                (makeVec3(-10.0f, 0.0f, -5.0f), Containment::OUTSIDE),      // left of the view
                                (makeVec3(0.0f, 10.0f, -5.0f), Containment::OUTSIDE),       // above the view
                                (makeVec3(0.0f, -10.0f, -5.0f), Containment::OUTSIDE),      // under the view
                                (makeVec3(5.0f, 0.0f, -5.0f), Containment::INTERSECTING),   // across a side
                                (makeVec3(0.0f, -5.0f, -5.0f), Containment::INTERSECTING)]))
__test a_perspective_classifies_the_spheres_and_the_boxes (center: vec3, expected: Containment) {
    let frustum = perspectiveFrustum(vec3());

    assert (frustum.classify(Sphere(center, 1.0f)) == expected);
    assert (frustum.classify(cube(center)) == expected);
    assert (frustum.intersects(Sphere(center, 1.0f)) == (expected != Containment::OUTSIDE));
    assert (frustum.intersects(cube(center)) == (expected != Containment::OUTSIDE));
}

__test a_frustum_follows_its_camera {
    let frustum = perspectiveFrustum(makeVec3(100.0f, 0.0f, 0.0f));

    assert (frustum.classify(Sphere(makeVec3(100.0f, 0.0f, -5.0f), 1.0f)) == Containment::INSIDE);
    assert (frustum.classify(Sphere(makeVec3(0.0f, 0.0f, -5.0f), 1.0f)) == Containment::OUTSIDE);
}

@parameters ((yield c for c in [(makeVec3(0.0f, 0.0f, -5.0f), Containment::INSIDE),
                                (makeVec3(2.5f, 0.0f, -5.0f), Containment::INTERSECTING),
                                (makeVec3(0.0f, 5.0f, -5.0f), Containment::OUTSIDE),
                                (makeVec3(0.0f, 0.0f, -12.0f), Containment::OUTSIDE)]))
__test an_orthographic_projection_classifies_the_boxes (center: vec3, expected: Containment) {
    let frustum = Frustum(ortho!{f32}(-3.0f, 3.0f, -3.0f, 3.0f, 1.0f, 10.0f));

    assert (frustum.classify(cube(center)) == expected);
}

__test the_default_frustum_contains_everything_but_empty_volumes {
    let frustum = Frustum();

    assert (frustum.classify(cube(makeVec3(1000.0f, -1000.0f, 1000.0f))) == Containment::INSIDE);
    assert (frustum.classify(Sphere(vec3(), 1.0f)) == Containment::INSIDE);
    assert (frustum.classify(Aabb()) == Containment::OUTSIDE);
    assert (frustum.classify(Sphere()) == Containment::OUTSIDE);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          RAYS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test a_ray_is_built_with_a_unit_direction {
    let ray = Ray(makeVec3(1.0f, 2.0f, 3.0f), makeVec3(0.0f, 0.0f, -4.0f));

    assert (near(ray.direction, makeVec3(0.0f, 0.0f, -1.0f)));
    assert (ray.length == f32::max);
    assert (near(ray.at(2.0f), makeVec3(1.0f, 2.0f, 1.0f)));
}

__test the_ray_through_the_center_of_a_perspective_goes_from_its_near_plane_to_its_far_plane {
    let proj = perspective!{f32}(radian(90.0f), 1.0f, 1.0f, 10.0f);
    let view = lookAt!{f32}(vec3(), makeVec3(0.0f, 0.0f, -1.0f), makeVec3(0.0f, 1.0f, 0.0f));
    let ray = Ray(proj * view, makeVec2(0.0f, 0.0f));

    assert (near(ray.origin, makeVec3(0.0f, 0.0f, -1.0f)));
    assert (near(ray.direction, makeVec3(0.0f, 0.0f, -1.0f)));
    assert (math::abs(ray.length - 9.0f) < 0.001f);
}

@parameters ((yield p for p in [makeVec2(-1.0f, -1.0f), makeVec2(1.0f, -1.0f), makeVec2(0.25f, 0.75f), makeVec2(-0.5f, 0.1f)]))
__test every_point_of_the_ray_through_a_pixel_is_seen_at_that_pixel (ndc: vec2) {
    let eye = makeVec3(3.0f, 2.0f, 5.0f);
    let proj = perspective!{f32}(radian(60.0f), 16.0f / 9.0f, 0.5f, 50.0f);
    let view = lookAt!{f32}(eye, makeVec3(0.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    let viewProj = proj * view;
    let ray = Ray(viewProj, ndc);

    for t in [0.0f, 0.5f, 0.9f] {
        let p = project(viewProj, ray.at(t * ray.length));
        assert (math::abs(p.x - ndc.x) < 0.001f && math::abs(p.y - ndc.y) < 0.001f);
    }

    assert (math::abs(project(viewProj, ray.origin).z + 1.0f) < 0.001f);
    assert (math::abs(project(viewProj, ray.at(ray.length)).z - 1.0f) < 0.001f);
}

__test the_rays_of_an_orthographic_projection_are_parallel {
    let viewProj = ortho!{f32}(-3.0f, 3.0f, -3.0f, 3.0f, 1.0f, 10.0f);
    let center = Ray(viewProj, makeVec2(0.0f, 0.0f));
    let corner = Ray(viewProj, makeVec2(1.0f, 1.0f));

    assert (near(center.direction, corner.direction));
    assert (near(center.origin, makeVec3(0.0f, 0.0f, -1.0f)));
    assert (near(corner.origin, makeVec3(3.0f, 3.0f, -1.0f)));
    assert (math::abs(corner.length - 9.0f) < 0.001f);
}

__test a_ray_transformed_runs_along_the_segment_transformed {
    let m = translation(makeVec3(1.0f, -2.0f, 3.0f)) * rotationY(radian(30.0f)) * scaling(makeVec3(2.0f, 0.5f, 3.0f));
    let ray = Ray(makeVec3(0.5f, 1.0f, -1.0f), makeVec3(1.0f, 2.0f, -2.0f), length-> 6.0f);
    let moved = ray.transformed(m);

    assert (math::abs(moved.direction.length() - 1.0f) < 0.0001f);
    assert (near(moved.origin, (m * makeVec4(ray.origin, 1.0f)).xyz));
    assert (near(moved.at(moved.length), (m * makeVec4(ray.at(ray.length), 1.0f)).xyz));
    assert (near(moved.transformed(m.inversed()).at(2.0f), ray.at(2.0f)));
}

__test a_half_line_transformed_stays_a_half_line {
    let ray = Ray(vec3(), makeVec3(0.0f, 0.0f, -1.0f)).transformed(scaling(makeVec3(2.0f, 2.0f, 2.0f)));

    assert (ray.length == f32::max);
    assert (near(ray.direction, makeVec3(0.0f, 0.0f, -1.0f)));
}

@parameters ((yield c for c in [(makeVec3(0.0f, 0.0f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f), 4.0f),
                                (makeVec3(0.5f, -0.5f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f), 4.0f),
                                (makeVec3(-5.0f, 0.0f, 0.0f), makeVec3(1.0f, 0.0f, 0.0f), 4.0f),
                                (makeVec3(-5.0f, -5.0f, 0.0f), makeVec3(1.0f, 1.0f, 0.0f), 5.656854f),
                                (makeVec3(0.5f, 0.5f, 0.5f), makeVec3(0.0f, 1.0f, 0.0f), 0.0f)]))
__test a_ray_enters_a_box_where_it_crosses_its_first_face (origin: vec3, direction: vec3, distance: f32) {
    let d = entry(cube(vec3()), Ray(origin, direction));
    assert (math::abs(d - distance) < 0.001f);
}

@parameters ((yield c for c in [(makeVec3(0.0f, 0.0f, 5.0f), makeVec3(0.0f, 0.0f, 1.0f)),
                                (makeVec3(0.0f, 5.0f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f)),
                                (makeVec3(-5.0f, 0.0f, 0.0f), makeVec3(1.0f, 1.0f, 0.0f)),
                                (makeVec3(1.5f, 0.0f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f))]))
__test a_ray_misses_the_boxes_beside_or_behind_it (origin: vec3, direction: vec3) {
    assert (!cube(vec3()).intersect(Ray(origin, direction)).hasValue);
}

__test a_ray_stopping_before_a_box_misses_it {
    let box = cube(vec3());
    let origin = makeVec3(0.0f, 0.0f, 5.0f);
    let direction = makeVec3(0.0f, 0.0f, -1.0f);

    assert (!box.intersect(Ray(origin, direction, length-> 3.5f)).hasValue);
    assert (math::abs(entry(box, Ray(origin, direction, length-> 4.5f)) - 4.0f) < 0.001f);
}

__test a_ray_misses_an_empty_box {
    assert (!Aabb().intersect(Ray(vec3(), makeVec3(1.0f, 0.0f, 0.0f))).hasValue);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          TRIANGLES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_box_of_a_triangle_encloses_its_points {
    let t = Triangle(makeVec3(1.0f, -2.0f, 0.5f), makeVec3(-1.0f, 3.0f, 0.0f), makeVec3(0.0f, 0.0f, -4.0f));
    assert (near(t.aabb, Aabb(makeVec3(-1.0f, -2.0f, -4.0f), makeVec3(1.0f, 3.0f, 0.5f))));
}

@parameters ((yield c for c in [(makeVec3(0.25f, 0.25f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f), 5.0f),
                                (makeVec3(0.25f, 0.25f, -3.0f), makeVec3(0.0f, 0.0f, 1.0f), 3.0f),
                                (makeVec3(0.0f, 0.0f, 2.0f), makeVec3(0.0f, 0.0f, -1.0f), 2.0f),
                                (makeVec3(-2.0f, 0.5f, 2.0f), makeVec3(1.0f, 0.0f, -1.0f), 2.828427f)]))
__test a_ray_hits_a_triangle_by_either_face_where_it_crosses_it (origin: vec3, direction: vec3, distance: f32) {
    let t = Triangle(vec3(), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    if let Ok(d) = t.intersect(Ray(origin, direction)) {
        assert (math::abs(d - distance) < 0.001f);
    } else {
        assert (false);
    }
}

@parameters ((yield c for c in [(makeVec3(0.75f, 0.75f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f)),
                                (makeVec3(-0.1f, 0.5f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f)),
                                (makeVec3(0.25f, 0.25f, 5.0f), makeVec3(0.0f, 0.0f, 1.0f)),
                                (makeVec3(-1.0f, 0.25f, 0.0f), makeVec3(1.0f, 0.0f, 0.0f))]))
__test a_ray_misses_the_triangles_beside_behind_or_along_it (origin: vec3, direction: vec3) {
    let t = Triangle(vec3(), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    assert (!t.intersect(Ray(origin, direction)).hasValue);
}

__test a_ray_stopping_before_a_triangle_misses_it {
    let t = Triangle(vec3(), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f));
    let origin = makeVec3(0.25f, 0.25f, 5.0f);
    let direction = makeVec3(0.0f, 0.0f, -1.0f);

    assert (!t.intersect(Ray(origin, direction, length-> 4.5f)).hasValue);
    assert (t.intersect(Ray(origin, direction, length-> 5.5f)).hasValue);
}

__test a_ray_misses_a_flat_triangle {
    let t = Triangle(vec3(), makeVec3(1.0f, 0.0f, 0.0f), makeVec3(2.0f, 0.0f, 0.0f));
    assert (!t.intersect(Ray(makeVec3(0.5f, 0.0f, 5.0f), makeVec3(0.0f, 0.0f, -1.0f))).hasValue);
}
