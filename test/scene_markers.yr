in scene_markers;

use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{empty, icon, marker};

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * @returns: the names of markers, in their order
 * */
fn namesOf(markers: [&Marker3D])-> [[c8]] {
    let mut names: [[c8]] = [];
    for m in markers {
        names ~= [m.name.file()];
    }

    names
}

__test the_tags_of_a_marker_are_kept_once_the_empty_ones_left_out {
    let dmut root = copy Root();
    let dmut m = copy Marker3D("m", alias root);
    m.tags = copy ["enemy", "", "boss", "enemy"];

    assert (m.tags == ["enemy", "boss"]);
    assert (m.hasTag("boss") && !m.hasTag("player") && !m.hasTag(""));
}

__test a_marker_is_found_by_its_name_under_a_node_the_first_in_the_order_of_the_nodes {
    let dmut root = copy Root();
    let dmut level = copy Empty3D("level", alias root);
    let dmut room = copy Empty3D("room", alias level);
    let deep = copy Marker3D("exit", alias room, purpose-> MarkerPurpose::WAYPOINT);
    let _other_ = copy Marker3D("exit", alias level);
    copy Empty3D("exit_sign", alias level);

    if let Ok(found) = Marker3D::find(alias root, "exit") {
        // room comes before the second exit among the children of the level, and is walked before it
        assert (found.uid == deep.uid);
    } else {
        assert (false);
    }

    assert (!Marker3D::find(alias root, "exit_sign").hasValue);
    assert (!Marker3D::find(alias root, "nowhere").hasValue);
}

__test the_markers_are_looked_up_by_their_tags_and_their_purposes_in_the_order_of_the_nodes {
    let dmut root = copy Root();
    let dmut a = copy Marker3D("a", alias root, purpose-> MarkerPurpose::SPAWN);
    a.tags = copy ["player"];
    let dmut group = copy Empty3D("group", alias root);
    let dmut b = copy Marker3D("b", alias group, purpose-> MarkerPurpose::SPAWN);
    b.tags = copy ["enemy", "player"];
    let dmut c = copy Marker3D("c", alias b, purpose-> MarkerPurpose::SOCKET);
    c.tags = copy ["player"];
    copy Marker3D("d", alias root);

    assert (namesOf(Marker3D::tagged(alias root, "player")) == ["a", "b", "c"]);
    assert (namesOf(Marker3D::tagged(alias root, "enemy")) == ["b"]);
    assert (namesOf(Marker3D::tagged(alias group, "player")) == ["b", "c"]);
    assert (namesOf(Marker3D::ofPurpose(alias root, MarkerPurpose::SPAWN)) == ["a", "b"]);
    assert (namesOf(Marker3D::ofPurpose(alias root, MarkerPurpose::GENERIC)) == ["d"]);
}

__test the_glyph_of_a_marker_follows_its_purpose {
    let dmut root = copy Root();
    let dmut m = copy Marker3D("m", alias root);
    let mut glyphs: [NodeIcon] = [];
    for p in [MarkerPurpose::GENERIC, MarkerPurpose::SPAWN, MarkerPurpose::WAYPOINT, MarkerPurpose::SOCKET] {
        m.purpose = p;
        if let Ok(icon) = m.editorIcon() {
            glyphs ~= [icon];
        }
    }

    assert (glyphs.len == 4us);
    for i in 0us .. glyphs.len {
        for j in i + 1us .. glyphs.len {
            assert (glyphs[i].shapes != glyphs[j].shapes);
        }
    }
}
