in parser_slot;

use balder::interface::loader::parser;

use std::syntax::errors;

/**
 * @returns: the values of a content
 * */
fn read(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @returns: true iif the decoding of a content as a slot reference throws a syntax error
 * */
fn rejects(content: [c8])-> bool {
    {
        SlotRef(read(content));
        false
    } catch {
        _: &SyntaxError => { true }
    }
}

__test slot_references {
    let quit = SlotRef(read("quit"));
    assert (quit.name == "quit" && quit.args.len == 0us && !quit.isNone());

    let submit = SlotRef(read("form::submit"));
    assert (submit.name == "form::submit");

    let describe = SlotRef(read("describe (\"Label: a text\", 2)"));
    assert (describe.name == "describe" && describe.args.len == 2us);
    assert (describe.args[0].toText() == "Label: a text");
    assert (describe.args[1].toInteger() == 2);

    assert (SlotRef(read("none")).isNone());
}

@parameters ((yield c for c in ["12", "\"quit\"", "none (1)", "quit reset", "$quit"]))
__test invalid_slot_references (content: [c8]) {
    assert (rejects(content));
}
