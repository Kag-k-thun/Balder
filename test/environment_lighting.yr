in environment_lighting;

use balder::core::error;
use balder::scene::utils::environment;
use balder::scene::utils::environment::utils;

/**
 * The environment cube has twice the texels of a quarter of the width of its image, a power of two from 64 to 1024
 * */
__test the_environment_cube_is_sized_by_its_image {
    assert (utils::cubeSize (1024u32) == 512u32);
    assert (utils::cubeSize (2048u32) == 1024u32);
    assert (utils::cubeSize (1500u32) == 512u32);

    assert (utils::cubeSize (8192u32) == 1024u32);
    assert (utils::cubeSize (100u32) == 64u32);
    assert (utils::cubeSize (1u32) == 64u32);
}

/**
 * A cube has a level for each halving of its size, down to a texel
 * */
__test a_cube_has_its_levels_down_to_a_texel {
    assert (utils::levelCount (1u32) == 1u32);
    assert (utils::levelCount (2u32) == 2u32);
    assert (utils::levelCount (512u32) == 10u32);
    assert (utils::levelCount (EnvironmentLighting::PREFILTERED_SIZE) == 8u32);

    // the prefiltered environment stops before its levels get smaller than 4 texels
    let last = EnvironmentLighting::PREFILTERED_SIZE >> (EnvironmentLighting::PREFILTERED_LEVELS - 1u32);
    assert (last == 4u32);
}

/**
 * The roughness of the levels of the prefiltered environment grows linearly from 0 at the first to 1 at the last, as the
 * composition reads them
 * */
__test the_prefiltered_levels_grow_rougher {
    let levels = EnvironmentLighting::PREFILTERED_LEVELS;
    assert (utils::levelRoughness (0u32, levels) == 0.0f);
    assert (utils::levelRoughness (levels - 1u32, levels) == 1.0f);
    assert (utils::levelRoughness (1u32, levels) == 0.2f);

    let mut before = -1.0f;
    for l in 0u32 .. levels {
        let r = utils::levelRoughness (l, levels);
        assert (r > before);
        before = r;
    }

    assert (utils::levelRoughness (0u32, 1u32) == 0.0f);
}

/**
 * A lighting lights nothing until an environment is loaded and its cubes computed, keeps the environment loaded before it
 * is configured, refuses a file that is not an environment, and keeps its parameters in their range
 * */
__test the_lighting_keeps_its_environment_and_its_parameters {
    let dmut env = copy EnvironmentLighting ();
    assert (env.file == "" && !env.isLit);
    assert (env.intensity == 1.0f && env.skybox);
    assert (!env.environment.hasValue && !env.irradiance.hasValue && !env.prefiltered.hasValue && !env.lut.hasValue);

    // not configured, the image is decoded and kept for the configuration
    env:.load ("res:/environments/studio_small_09_1k.hdr");
    assert (env.file == "res:/environments/studio_small_09_1k.hdr" && !env.isLit);

    let failed = {
        env:.load ("res:/config/app.toml");
        false
    } catch {
        _: &BalderError => { true }
    };

    assert (failed && env.file == "res:/environments/studio_small_09_1k.hdr");

    env:.load ("");
    assert (env.file == "");

    env.intensity = -1.0f;
    assert (env.intensity == 0.0f);
    env.intensity = 2.5f;
    assert (env.intensity == 2.5f);

    env.skybox = false;
    assert (!env.skybox);
}
