in node_bounds;

use balder::core::shader::buffers::instance_draw;
use balder::math::{bounds, vector};
use balder::scene::_;
use balder::scene::node::_;
use balder::scene::node::node3D::{_, visual};

use std::math;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super ("")
    {}

    pub over onEnter (mut self, dmut _ : &Scene) {}
    pub over onExit (mut self, dmut _ : &Scene) {}

}

/**
 * A 3D node with no volume of its own
 * */
class Group over Node3D {

    pub self (name : [c8], dmut parent : &Node)
        with super (name, alias parent)
    {}

    pub over onEnter (mut self, dmut _ : &Scene) {}
    pub over onExit (mut self, dmut _ : &Scene) {}

}

/**
 * A 3D node with the volume of the cube of side 2 centered on its origin
 * */
class Block over VisualInstance3D {

    pub self (name : [c8], dmut parent : &Node)
        with super (name, alias parent, Aabb (makeVec3 (-1.0f, -1.0f, -1.0f), makeVec3 (1.0f, 1.0f, 1.0f)), false)
    {}

    pub over onEnter (mut self, dmut _ : &Scene) {}
    pub over onExit (mut self, dmut _ : &Scene) {}

    pub over getDraws (self)-> [InstanceDraw] {
        []
    }

}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near (a : vec3, b : vec3)-> bool {
    (a - b).length () < 0.0001f
}

/**
 * @returns: true iif a box spans from a point to another, give or take the rounding errors
 * */
fn spans (box : Aabb, min : vec3, max : vec3)-> bool {
    near (box.min, min) && near (box.max, max)
}

__test a_node_without_volume_nor_children_has_empty_bounds {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);

    assert (group:.bounds ().isEmpty);
}

__test the_bounds_of_an_instance_follow_its_moves {
    let dmut root = copy Root ();
    let dmut block = copy Block ("block", alias root);

    assert (spans (block:.bounds (), makeVec3 (-1.0f, -1.0f, -1.0f), makeVec3 (1.0f, 1.0f, 1.0f)));

    block.position = makeVec3 (5.0f, 0.0f, 0.0f);
    assert (spans (block:.bounds (), makeVec3 (4.0f, -1.0f, -1.0f), makeVec3 (6.0f, 1.0f, 1.0f)));

    block.scale = makeVec3 (1.0f, 3.0f, 1.0f);
    assert (spans (block:.bounds (), makeVec3 (4.0f, -3.0f, -1.0f), makeVec3 (6.0f, 3.0f, 1.0f)));
}

__test the_bounding_sphere_of_an_instance_follows_its_scale {
    let dmut root = copy Root ();
    let dmut block = copy Block ("block", alias root);
    block.scale = makeVec3 (2.0f, 1.0f, 1.0f);

    let sphere = block:.boundingSphere ();
    assert (near (sphere.center, vec3 ()));
    assert (math::abs (sphere.radius - 2.0f * cast!f32 (math::sqrt (3.0))) < 0.0001f);
}

__test the_bounds_of_a_node_enclose_its_children {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);
    let dmut left = copy Block ("left", alias group);
    let dmut right = copy Block ("right", alias group);

    left.position = makeVec3 (-5.0f, 0.0f, 0.0f);
    right.position = makeVec3 (5.0f, 0.0f, 0.0f);
    assert (spans (group:.bounds (), makeVec3 (-6.0f, -1.0f, -1.0f), makeVec3 (6.0f, 1.0f, 1.0f)));

    // a child moving after the bounds were computed
    right.position = makeVec3 (10.0f, 2.0f, 0.0f);
    assert (spans (group:.bounds (), makeVec3 (-6.0f, -1.0f, -1.0f), makeVec3 (11.0f, 3.0f, 1.0f)));
}

__test the_bounds_of_the_children_follow_their_parent {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);
    let dmut block = copy Block ("block", alias group);

    assert (spans (group:.bounds (), makeVec3 (-1.0f, -1.0f, -1.0f), makeVec3 (1.0f, 1.0f, 1.0f)));

    group.position = makeVec3 (0.0f, 3.0f, 0.0f);
    assert (spans (block:.bounds (), makeVec3 (-1.0f, 2.0f, -1.0f), makeVec3 (1.0f, 4.0f, 1.0f)));
    assert (spans (group:.bounds (), makeVec3 (-1.0f, 2.0f, -1.0f), makeVec3 (1.0f, 4.0f, 1.0f)));
}

__test the_bounds_follow_the_children_entering_and_leaving_the_tree {
    let dmut root = copy Root ();
    let dmut group = copy Group ("group", alias root);
    let dmut first = copy Block ("first", alias group);

    assert (spans (group:.bounds (), makeVec3 (-1.0f, -1.0f, -1.0f), makeVec3 (1.0f, 1.0f, 1.0f)));

    let dmut second = copy Block ("second", alias group);
    second.position = makeVec3 (0.0f, 0.0f, 4.0f);
    assert (spans (group:.bounds (), makeVec3 (-1.0f, -1.0f, -1.0f), makeVec3 (1.0f, 1.0f, 5.0f)));

    first:.dispose ();
    assert (spans (group:.bounds (), makeVec3 (-1.0f, -1.0f, 3.0f), makeVec3 (1.0f, 1.0f, 5.0f)));
}
