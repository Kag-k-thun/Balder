in sheet_loader;

use balder::core::error;
use balder::interface::loader;
use balder::interface::loader::registry;
use balder::interface::loader::registry::error;
use balder::interface::style;
use balder::interface::style::{manager, sheets};
use balder::math::vector;

/**
 * @returns: the sheets of a .style file and of those it imports
 * */
fn load(path: [c8])-> [StyleSheet]
    throws BalderError
{
    let dmut loader = SheetLoader(WidgetRegistry());
    loader:.load(path)
}

/**
 * @returns: the error of the loading of a .style file, none when it loads
 * */
fn failure(path: [c8])-> (&LoadError)?
    throws BalderError
{
    {
        load(path);
        none
    } catch {
        e: &LoadError   => { (e)? }
        e: &BalderError => { throw e; }
    }
}

/**
 * @returns: true iif the loading of a .style file fails with reason, at line and col of file
 * */
fn refuses(path: [c8], file: [c8], reason: [c8], line: usize, col: usize)-> bool
    throws BalderError
{
    if let Ok(e) = failure(path) {
        return e.file == file && e.reason == reason && e.line == line && e.col == col;
    }

    false
}

__test the_imported_sheets_come_first_and_share_their_constants {
    let sheets = load("test/sheets/theme.style");
    assert (sheets.len == 2us);
    assert (sheets[0].rules[0].style.radius == (true, 1u32));

    let accent = makeVec4(cast!f32(0x38u32), cast!f32(0x8bu32), cast!f32(0xfdu32), 255.0f) / 255.0f;
    let border = sheets[1].rules[0].style.borderColor;
    assert (border._0 && border._1 == accent);
}

__test a_sheet_imported_twice_is_read_once {
    // main imports base, then theme which imports base again
    let sheets = load("test/sheets/main.style");
    assert (sheets.len == 3us);
    assert (sheets[0].rules[0].style.radius._0);
    assert (sheets[1].rules[0].style.borderColor._0);
    assert (sheets[2].rules[0].style.textColor._0);

    let dmut styles = copy StyleManager();
    for s in sheets {
        styles:.addSheet(s);
    }

    assert (styles.compute(copy [Element("Box")], copy Style()).radius == (true, 1u32));
}

__test the_imports_are_relative_to_the_importing_sheet {
    let sheets = load("test/sheets/nested/child.style");
    assert (sheets.len == 2us && sheets[1].rules[0].style.borderColor._0);
}

__test the_paths_of_the_imports {
    assert (SheetLoader::resolve("res:/dialog/default.style", "base.style") == "res:/dialog/base.style");
    assert (SheetLoader::resolve("a/b/c.style", "../d.style") == "a/d.style");
    assert (SheetLoader::resolve("a/b.style", "res:/x.style") == "res:/x.style");
    assert (SheetLoader::resolve("a/b.style", "/abs/x.style") == "/abs/x.style");
}

__test a_sheet_importing_itself {
    assert (refuses("test/sheets/cycle_a.style", "test/sheets/cycle_b.style",
                    "'test/sheets/cycle_a.style' imports itself: test/sheets/cycle_a.style -> test/sheets/cycle_b.style -> test/sheets/cycle_a.style",
                    2us, 1us));
}

__test the_errors_are_located_in_their_sheet {
    assert (refuses("test/sheets/broken.style", "test/sheets/broken.style",
                    "cannot read the imported sheet 'test/sheets/missing.style'", 1us, 1us));
    assert (refuses("test/sheets/imports_invalid.style", "test/sheets/invalid.style", "expected a value, found ';'", 2us, 13us));
}

__test a_missing_file {
    let failed = {
        load("test/sheets/nothing.style");
        false
    } catch {
        _: &BalderError => { true }
    };

    assert (failed);
}

__test a_gui_file_and_its_errors {
    let doc = readGuiFile("res:/dialog/message.gui");
    if let Ok(root) = doc.root {
        assert (root.typeName == "LinearLayout" && root.id == "FL");
    } else {
        assert (false);
    }

    let error = {
        readGuiFile("test/sheets/base.style");
        ""
    } catch {
        e: &LoadError   => { e.file ~ ":" ~ e.reason }
        _: &BalderError => { "" }
    };

    assert (error.len > 0us && error[0us .. 22us] == "test/sheets/base.style");
}
