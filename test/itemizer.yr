in itemizer;

use balder::interface::font::{chain, grapheme, itemizer, registry};

use ::harfbuzz::common;

/**
 * A chain of Noto Sans falling back to DejaVu Sans Mono, the only shipped font with armenian letters
 * */
fn notoThenDejaVu()-> dmut &FontChain {
    let dmut r = copy FontRegistry(systemDirs-> []);
    r:.registerDirectory(FontRegistry::RES_FONT_DIR);
    r:.setGlobalFallbacks(copy ["DejaVu Sans Mono"]);
    copy FontChain(alias r, copy ["Noto Sans"])
}

fn scripts(text: [c8])-> [hb_script_t] {
    resolveScripts(text, boundaries(text))
}

__test common_graphemes_take_the_script_before_them {
    let s = scripts("ab \u{0x3B1}\u{0x3B2}");
    assert (s.len == 5us);
    assert (s[0] == hb_script_t::HB_SCRIPT_LATIN && s[1] == hb_script_t::HB_SCRIPT_LATIN);
    assert (s[2] == hb_script_t::HB_SCRIPT_LATIN);
    assert (s[3] == hb_script_t::HB_SCRIPT_GREEK && s[4] == hb_script_t::HB_SCRIPT_GREEK);
}

__test leading_common_graphemes_take_the_first_script {
    let s = scripts("12 \u{0x3B1}");
    for x in s {
        assert (x == hb_script_t::HB_SCRIPT_GREEK);
    }
}

__test line_without_script_is_common {
    for x in scripts("12, 34") {
        assert (x == hb_script_t::HB_SCRIPT_COMMON);
    }
}

__test empty_line_has_no_item {
    let dmut c = notoThenDejaVu();
    assert (itemize(alias c, "", boundaries("")).len == 0us);
}

__test a_change_of_script_splits_an_item {
    let dmut c = notoThenDejaVu();
    let text = "abc \u{0x3B1}\u{0x3B2}\u{0x3B3}";
    let items = itemize(alias c, text, boundaries(text));
    assert (items.len == 2us);
    assert (items[0].start == 0us && items[0].end == 4us);
    assert (items[1].start == 4us && items[1].end == 10us);
    assert (items[0].face == 0u32 && items[1].face == 0u32);
    assert (items[0].script == hb_script_t::HB_SCRIPT_LATIN);
    assert (items[1].script == hb_script_t::HB_SCRIPT_GREEK);
}

__test a_fallback_face_splits_an_item {
    let dmut c = notoThenDejaVu();
    let text = "a\u{0x531}\u{0x532}b";
    let items = itemize(alias c, text, boundaries(text));
    assert (items.len == 3us);
    assert (items[0].end == 1us && items[1].start == 1us && items[1].end == 5us && items[2].start == 5us);
    assert (items[0].face == 0u32 && items[1].face == 1u32 && items[2].face == 0u32);
    assert (items[1].script == hb_script_t::HB_SCRIPT_ARMENIAN);
}
