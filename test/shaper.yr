in shaper;

use balder::core::error;
use balder::interface::font::{chain, face, registry, shaper};

use std::fs::path;

fn noto()-> dmut &FontFace
    throws BalderError
{
    copy FontFace::open(Path("res/fonts/noto/NotoSans-Regular.ttf"))
}

fn near(a: f32, b: f32, tolerance: f32)-> bool {
    let d = a - b;
    d <= tolerance && -d <= tolerance
}

__test empty_text {
    let dmut f = noto();
    let run = shapeLine(alias f, "", 16u32);
    assert (run.glyphs.len == 0us);
    assert (run.width == 0.0f);
    assert (run.getHeight() > 0.0f);
}

__test one_glyph_per_letter {
    let dmut f = noto();
    let run = shapeLine(alias f, "Balder", 16u32);
    assert (run.glyphs.len == 6us);
    for i, g in run.glyphs {
        assert (g.cluster == cast!u32(i));
        assert (g.glyph != 0u32);
        assert (g.advance > 0.0f);
    }
}

__test pen_positions_add_up {
    let dmut f = noto();
    let run = shapeLine(alias f, "Hello world", 20u32);
    let mut pen = 0.0f;
    for g in run.glyphs {
        assert (near(g.x, pen, 0.001f));
        pen += g.advance;
    }

    assert (near(run.width, pen, 0.001f));
}

__test kerning_tightens_pairs {
    let dmut f = noto();
    let pair = shapeLine(alias f, "AV", 32u32);
    let a = shapeLine(alias f, "A", 32u32);
    let v = shapeLine(alias f, "V", 32u32);
    assert (pair.width < a.width + v.width);
}

/**
 * (pixel size, the size the width is compared to)
 * */
@parameters ((yield c for c in [(16u32, 32u32), (12u32, 24u32), (20u32, 60u32)]))
__test width_scales_with_size (small: u32, large: u32) {
    let dmut f = noto();
    let a = shapeLine(alias f, "Balder engine", small);
    let b = shapeLine(alias f, "Balder engine", large);
    let ratio = cast!f32(large) / cast!f32(small);
    assert (near(b.width, a.width * ratio, a.width * ratio * 0.02f));
}

__test line_metrics {
    let dmut f = noto();
    let run = shapeLine(alias f, "g", 32u32);
    assert (run.metrics.ascender > 0.0f);
    assert (run.metrics.descender < 0.0f);
    assert (run.metrics.height >= run.getHeight() - 1.0f);
    assert (run.pixelSize == 32u32);
}

__test carets_on_clusters {
    let dmut f = noto();
    let run = shapeLine(alias f, "abc", 20u32);
    assert (run.stops == [0us, 1us, 2us, 3us]);
    assert (run.caretAt(0us) == 0.0f);
    assert (near(run.caretAt(1us), run.glyphs[0].advance, 0.001f));
    assert (run.caretAt(1us) < run.caretAt(2us));
    assert (near(run.caretAt(3us), run.width, 0.001f));
    assert (near(run.caretAt(10us), run.width, 0.001f));
}

__test empty_run_has_one_caret {
    let dmut f = noto();
    let run = shapeLine(alias f, "", 20u32);
    assert (run.stops == [0us]);
    assert (run.caretAt(0us) == 0.0f);
    assert (run.hitTest(12.0f) == 0us);
    assert (run.selectionSpans(0us, 0us).len == 0us);
}

__test combining_mark_has_no_caret_inside {
    let dmut f = noto();
    let run = shapeLine(alias f, "e\u{0x301}x", 20u32);
    let e = shapeLine(alias f, "e", 20u32);
    assert (run.stops == [0us, 3us, 4us]);
    assert (near(run.caretAt(3us), e.width, 0.5f));
    assert (run.caretAt(1us) == run.caretAt(0us));
    assert (run.caretAt(2us) == run.caretAt(0us));
    assert (run.hitTest(run.caretAt(3us) - 0.1f) == 3us);
}

__test multibyte_code_point_is_one_stop {
    let dmut f = noto();
    let run = shapeLine(alias f, "a\u{0x1F600}b", 20u32);
    assert (run.stops == [0us, 1us, 5us, 6us]);
    assert (run.caretAt(1us) < run.caretAt(5us));
    assert (run.caretAt(5us) < run.caretAt(6us));
    assert (run.glyphs[2].cluster == 5u32);
}

/**
 * Noto Sans has no "fi" ligature, but joins the Chao tone letters of a contour into one glyph
 * */
__test ligature_is_split_between_its_graphemes {
    let dmut f = noto();
    let run = shapeLine(alias f, "\u{0x2E5}\u{0x2E5}\u{0x2E6}", 40u32);
    assert (run.glyphs.len == 1us);
    assert (run.stops == [0us, 2us, 4us, 6us]);
    assert (near(run.caretAt(2us), run.width / 3.0f, 0.001f));
    assert (near(run.caretAt(4us), run.width * 2.0f / 3.0f, 0.001f));
    assert (run.hitTest(run.width * 0.2f) == 2us);
    assert (run.hitTest(run.width * 0.1f) == 0us);
}

__test right_to_left_carets {
    let dmut f = noto();
    let run = shapeLine(alias f, "\u{0x5E9}\u{0x5DC}\u{0x5D5}\u{0x5DD}", 20u32);
    assert (run.glyphs[0].cluster > run.glyphs[$ - 1us].cluster);
    assert (near(run.caretAt(0us), run.width, 0.001f));
    assert (run.caretAt(2us) < run.caretAt(0us));
    assert (near(run.caretAt(8us), 0.0f, 0.001f));
    assert (run.hitTest(run.width + 5.0f) == 0us);
    assert (run.hitTest(-5.0f) == 8us);
    assert (near(run.measure(0us, 2us), run.caretAt(0us) - run.caretAt(2us), 0.001f));

    let spans = run.selectionSpans(0us, 2us);
    assert (spans.len == 1us);
    assert (near(spans[0]._0, run.caretAt(2us), 0.001f));
    assert (near(spans[0]._1, run.width, 0.001f));
}

/**
 * (a position in the run of "abc" in parts of the advance of its first glyph, the caret it hits)
 * */
@parameters ((yield c for c in [(-3.0f, 0us),
                                (0.0f, 0us),
                                (0.4f, 0us),
                                (0.6f, 1us),
                                (1.0f, 1us),
                                (100.0f, 3us)]))
__test hit_test (x: f32, expected: usize) {
    let dmut f = noto();
    let run = shapeLine(alias f, "abc", 20u32);
    assert (run.hitTest(x * run.glyphs[0].advance) == expected);
}

__test hit_test_takes_the_closest_half {
    let dmut f = noto();
    let run = shapeLine(alias f, "abc", 20u32);
    let mid = (run.caretAt(1us) + run.caretAt(2us)) / 2.0f;
    assert (run.hitTest(mid - 0.1f) == 1us);
    assert (run.hitTest(mid + 0.1f) == 2us);
}

__test selection_spans {
    let dmut f = noto();
    let run = shapeLine(alias f, "abcd", 20u32);
    let spans = run.selectionSpans(1us, 3us);
    assert (spans.len == 1us);
    assert (near(spans[0]._0, run.caretAt(1us), 0.001f));
    assert (near(spans[0]._1, run.caretAt(3us), 0.001f));

    assert (run.selectionSpans(3us, 1us) == spans);
    assert (run.selectionSpans(2us, 2us).len == 0us);
}

__test measures_between_carets {
    let dmut f = noto();
    let run = shapeLine(alias f, "abcd", 20u32);
    assert (near(run.measure(1us, 3us), run.caretAt(3us) - run.caretAt(1us), 0.001f));
    assert (near(run.measure(0us, 4us), run.width, 0.001f));
    assert (run.measure(2us, 2us) == 0.0f);
}

__test features_turn_kerning_off {
    let dmut f = noto();
    let kerned = shapeLine(alias f, "AV", 32u32);
    let plain = shapeLine(alias f, "AV", 32u32, features-> copy ["kern=0"]);
    let a = shapeLine(alias f, "A", 32u32);
    let v = shapeLine(alias f, "V", 32u32);
    assert (near(plain.width, a.width + v.width, 0.001f));
    assert (kerned.width < plain.width);
}

__test invalid_feature_throws {
    let dmut f = noto();
    let thrown = {
        shapeLine(alias f, "AV", 32u32, features-> copy ["=1"]);
        false
    } catch {
        _ : &BalderError => { true }
    };

    assert (thrown);
}

__test merge_spans {
    let merged = mergeSpans(copy [(5.0f, 6.0f), (0.0f, 2.0f), (2.0f, 3.0f), (1.0f, 1.5f)]);
    assert (merged == [(0.0f, 3.0f), (5.0f, 6.0f)]);
    assert (mergeSpans([]).len == 0us);
}

__test shaping_does_not_disturb_rasterising {
    let dmut f = noto();
    let glyph = f:.getGlyphIndex('A'c32);
    let before = f:.rasterize(glyph, 24u32, 0u8);
    shapeLine(alias f, "A large shaped run", 64u32);
    let after = f:.rasterize(glyph, 24u32, 0u8);
    assert (before.pixels == after.pixels);
}

/**
 * (pen position, whole pixel, subpixel offset)
 * */
@parameters ((yield c for c in [(0.0f, 0.0f, 0u8),
                                (0.25f, 0.0f, 1u8),
                                (0.5f, 0.0f, 2u8),
                                (0.7f, 0.0f, 3u8),
                                (0.9f, 1.0f, 0u8),
                                (2.6f, 2.0f, 2u8),
                                (-0.25f, -1.0f, 3u8)]))
__test quantize_pen (pen: f32, whole: f32, sub: u8) {
    let (w, s) = quantizePen(pen);
    assert (w == whole);
    assert (s == sub);
}

/**
 * A chain of Noto Sans falling back to DejaVu Sans Mono, the only shipped font with armenian letters
 * */
fn notoThenDejaVu()-> dmut &FontChain {
    let dmut r = copy FontRegistry(systemDirs-> []);
    r:.registerDirectory(FontRegistry::RES_FONT_DIR);
    r:.setGlobalFallbacks(copy ["DejaVu Sans Mono"]);
    copy FontChain(alias r, copy ["Noto Sans"])
}

__test single_face_chain_marks_every_glyph_with_face_0 {
    let dmut c = notoThenDejaVu();
    let run = shapeLine(alias c, "Balder", 16u32);
    for g in run.glyphs {
        assert (g.face == 0u32);
    }

    assert (c.getNbFaces() == 1u32);
}

__test fallback_splits_the_line_into_runs {
    let dmut c = notoThenDejaVu();
    let run = shapeLine(alias c, "a\u{0x531}\u{0x532}b", 20u32);
    assert (run.glyphs.len == 4us);
    assert (run.glyphs[0].face == 0u32 && run.glyphs[1].face == 1u32);
    assert (run.glyphs[2].face == 1u32 && run.glyphs[3].face == 0u32);

    let clusters = [0u32, 1u32, 3u32, 5u32];
    for i, g in run.glyphs {
        assert (g.cluster == clusters[i]);
        assert (g.glyph != 0u32);
    }

    let mut pen = 0.0f;
    for g in run.glyphs {
        assert (near(g.x, pen, 0.001f));
        pen += g.advance;
    }

    assert (near(run.width, pen, 0.001f));
    assert (run.stops == [0us, 1us, 3us, 5us, 6us]);
}

__test fallback_keeps_the_metrics_of_the_primary_face {
    let dmut c = notoThenDejaVu();
    let latin = shapeLine(alias c, "a", 20u32);
    let mixed = shapeLine(alias c, "a\u{0x531}", 20u32);
    assert (latin.metrics.ascender == mixed.metrics.ascender);
    assert (latin.metrics.descender == mixed.metrics.descender);
}

__test right_to_left_runs_are_laid_out_from_the_right {
    let dmut c = notoThenDejaVu();

    // hebrew letters, both in Noto Sans and DejaVu Sans Mono, around an armenian letter only DejaVu Sans Mono has
    let run = shapeLine(alias c, "\u{0x5E9}\u{0x531}\u{0x5DC}", 20u32);
    assert (run.glyphs.len == 3us);
    assert (run.glyphs[0].cluster == 4u32 && run.glyphs[2].cluster == 0u32);
    assert (run.glyphs[1].face == 1u32);
    assert (near(run.caretAt(0us), run.width, 0.001f));
}
