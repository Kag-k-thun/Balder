in instance_groups;

use balder::core::shader::buffers::instance_draw;
use balder::core::shader::buffers::instance_batch::grouping;

use ::vulkan::core;

/**
 * @returns: a draw of 'count' indices from 'first', for the object word 'word'
 * */
fn draw(first: u32, count: u32, word: u32)-> InstanceDraw {
    let mut d = InstanceDraw();
    d.indexCount = count;
    d.firstIndex = first;
    d.word = word;
    d
}


/**
 * @returns: the commands and the words of draws grouped by a new grouping
 * */
fn groupInstances(draws: [(f32, InstanceDraw)])-> ([VkDrawIndexedIndirectCommand], [u32]) {
    let dmut grouping = copy DrawGrouping();
    grouping:.group(draws)
}

__test no_draw_no_command {
    let (commands, words) = groupInstances([]);
    assert (commands.len == 0us && words.len == 0us);
}

__test empty_draws_are_dropped {
    // a culled mesh draws nothing, the second draw of a mesh out of a cross-fade neither
    let (commands, words) = groupInstances(copy [(1.0f, draw(0u32, 0u32, 4u32)), (2.0f, InstanceDraw())]);
    assert (commands.len == 0us && words.len == 0us);
}

__test draws_of_a_range_share_a_command {
    let (commands, words) = groupInstances(copy [(3.0f, draw(0u32, 36u32, 4u32)),
                                                 (1.0f, draw(0u32, 36u32, 8u32)),
                                                 (2.0f, draw(0u32, 36u32, 12u32))]);

    assert (commands.len == 1us);
    assert (commands[0].indexCount == 36u32 && commands[0].firstIndex == 0u32);
    assert (commands[0].instanceCount == 3u32 && commands[0].firstInstance == 0u32);

    // the closest instance first
    assert (words == [8u32, 12u32, 4u32]);
}

__test ranges_are_drawn_closest_first {
    // the range of level 1 holds the closest instance, its command comes first
    let (commands, words) = groupInstances(copy [(5.0f, draw(0u32, 36u32, 4u32)),
                                                 (1.0f, draw(36u32, 12u32, 8u32)),
                                                 (2.0f, draw(0u32, 36u32, 12u32)),
                                                 (9.0f, draw(36u32, 12u32, 16u32))]);

    assert (commands.len == 2us);
    assert (commands[0].firstIndex == 36u32 && commands[0].instanceCount == 2u32 && commands[0].firstInstance == 0u32);
    assert (commands[1].firstIndex == 0u32 && commands[1].instanceCount == 2u32 && commands[1].firstInstance == 2u32);
    assert (words == [8u32, 16u32, 12u32, 4u32]);
}

__test vertex_offsets_split_the_ranges {
    // the same indices of two meshes placed apart in the pool are two ranges
    let mut other = draw(0u32, 36u32, 8u32);
    other.vertexOffset = 24;

    let (commands, words) = groupInstances(copy [(1.0f, draw(0u32, 36u32, 4u32)), (2.0f, other)]);
    assert (commands.len == 2us);
    assert (commands[0].vertexOffset == 0 && commands[1].vertexOffset == 24);
    assert (words == [4u32, 8u32]);
}

__test equal_distances_keep_an_order {
    // the objects at the same distance are ordered by their word, so the commands do not change from a build to the next
    let (_, words) = groupInstances(copy [(1.0f, draw(0u32, 36u32, 12u32)), (1.0f, draw(0u32, 36u32, 4u32))]);
    assert (words == [4u32, 12u32]);
}

__test a_grouping_reused_groups_each_batch_alone {
    // the buffers kept from a larger batch leave nothing of it in the next one
    let dmut grouping = copy DrawGrouping();
    let (big, bigWords) = grouping:.group(copy [(1.0f, draw(0u32, 36u32, 4u32)),
                                                (2.0f, draw(36u32, 12u32, 8u32)),
                                                (3.0f, draw(0u32, 36u32, 12u32))]);
    assert (big.len == 2us && bigWords.len == 3us);

    let (commands, words) = grouping:.group(copy [(1.0f, draw(36u32, 12u32, 16u32))]);
    assert (commands.len == 1us && commands[0].firstIndex == 36u32 && commands[0].instanceCount == 1u32);
    assert (words == [16u32]);

    let (larger, largerWords) = grouping:.group(copy [(4.0f, draw(0u32, 36u32, 4u32)),
                                                      (3.0f, draw(0u32, 36u32, 8u32)),
                                                      (2.0f, draw(0u32, 36u32, 12u32)),
                                                      (1.0f, draw(0u32, 36u32, 16u32)),
                                                      (5.0f, draw(36u32, 12u32, 20u32))]);
    assert (larger.len == 2us && larger[0].instanceCount == 4u32 && larger[1].firstInstance == 4u32);
    assert (largerWords == [16u32, 12u32, 8u32, 4u32, 20u32]);
}
