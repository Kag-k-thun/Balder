in file_dialog;

use balder::interface::dialog::file::{entry, model, utils};

use std::fs::{errors, path, sys};

/**
 * @returns: a directory holding two directories, a hidden one, and four files, a hidden one and two images
 * */
fn listedDir()-> Path
    throws FsError
{
    let dir = tempDirectory(prefix-> "balder_files_");
    createDir(dir.push("photos"));
    createDir(dir.push("Archives"));
    createDir(dir.push(".cache"));
    writeFile(dir.push("notes 10.txt"), "ten");
    writeFile(dir.push("notes 9.txt"), "nine bytes");
    writeFile(dir.push("cover.PNG"), "");
    writeFile(dir.push(".hidden"), "");
    dir
}

/**
 * @returns: the names of entries, in order
 * */
fn names(entries: [DirectoryEntry])-> [[c8]] {
    copy [e.name for e in entries]
}

__test the_directories_come_first_then_the_files_as_people_read_them {
    let dir = listedDir();
    {
        let entries = listDirectory(dir.toStr(), [], hidden-> false, directoriesOnly-> false);
        assert (names(entries) == copy ["Archives", "photos", "cover.PNG", "notes 9.txt", "notes 10.txt"]);
        assert (entries[0].isDirectory && !entries[2].isDirectory && entries[3].size == 10u64);

        let all = listDirectory(dir.toStr(), [], hidden-> true, directoriesOnly-> false);
        assert (names(all) == copy [".cache", "Archives", "photos", ".hidden", "cover.PNG", "notes 9.txt", "notes 10.txt"]);
    } exit {
        removeDir(dir, recursive-> true)?;
    }
}

__test the_filters_keep_the_files_of_their_extensions_and_every_directory {
    let dir = listedDir();
    {
        let images = listDirectory(dir.toStr(), copy ["png", "jpg"], hidden-> false, directoriesOnly-> false);
        assert (names(images) == copy ["Archives", "photos", "cover.PNG"]);

        let folders = listDirectory(dir.toStr(), [], hidden-> false, directoriesOnly-> true);
        assert (names(folders) == copy ["Archives", "photos"]);
    } exit {
        removeDir(dir, recursive-> true)?;
    }

    assert (listDirectory(dir.toStr(), [], hidden-> false, directoriesOnly-> false).len == 0us);
    assert (matchesFilters("a.tar.GZ", copy ["gz"]) && !matchesFilters("readme", copy ["txt"]) && matchesFilters("readme", []));
}

__test the_names_typed_are_read_from_the_directory_shown {
    assert (resolveName("/home/user", "") == "/home/user");
    assert (resolveName("/home/user", "notes.txt") == "/home/user/notes.txt");
    assert (resolveName("/home/user", "../other/./a.png") == "/home/other/a.png");
    assert (resolveName("/home/user", "/etc/hosts") == "/etc/hosts");

    assert (parentDirectory("/home/user") == "/home");
    assert (parentDirectory("/home") == "/");
    assert (parentDirectory("/") == "/");
}

__test the_sizes_and_the_kinds_are_written_as_people_read_them {
    assert (sizeText(0u64) == "0 B" && sizeText(1023u64) == "1023 B");
    assert (sizeText(1536u64) == "1.5 KB" && sizeText(10u64 * 1024u64) == "10 KB");
    assert (sizeText(5u64 * 1024u64 * 1024u64 + 300u64 * 1024u64) == "5.3 MB");

    assert (kindText(DirectoryEntry(name-> "src", isDirectory-> true)) == "Folder");
    assert (kindText(DirectoryEntry(name-> "cover.png")) == "PNG file");
    assert (kindText(DirectoryEntry(name-> "Makefile")) == "File");
}

__test the_model_keeps_the_directories_first_whatever_the_column {
    let dmut m = copy DirectoryModel();
    m:.setEntries(copy [DirectoryEntry(name-> "b", isDirectory-> true), DirectoryEntry(name-> "a.txt", size-> 2048u64),
                        DirectoryEntry(name-> "c.txt", size-> 10u64)]);

    assert (m.len() == 3us && m.columns() == 3us && m.header(1us) == "Size");
    assert (m.text(0us, 1us) == "" && m.text(1us, 1us) == "2.0 KB" && m.text(1us, 2us) == "TXT file");
    assert (m.compare(0us, 1us, 0us) < 0 && m.compare(1us, 0us, 1us) > 0);
    assert (m.compare(1us, 2us, 0us) < 0 && m.compare(1us, 2us, 1us) > 0);
}
