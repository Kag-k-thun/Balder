in glyph_cache;

use balder::core::error;
use balder::interface::font::cache;

fn key(glyph: u32)-> GlyphKey {
    GlyphKey(1u32, 12u32, glyph, 0u8)
}

/**
 * Inserts a glyph, false if the cache refused it
 * */
fn tryInsert(dmut c: &GlyphCache, k: GlyphKey)-> bool {
    {
        c:.insert(k, 30u32, 14u32, 0, 0);
        true
    } catch {
        _ : &BalderError => { false }
    }
}

/**
 * (guard, generations elapsed, true if the oldest glyph is evicted)
 * A single page holds two glyphs, 1 is used in generation 0, 2 in generation 1, and 3 is inserted last
 * */
@parameters ((yield c for c in [(1u64, 0u64, false),
                                (1u64, 1u64, true),
                                (2u64, 1u64, false),
                                (2u64, 2u64, true),
                                (3u64, 2u64, false),
                                (3u64, 3u64, true),
                                (2u64, 5u64, true)]))
__test eviction_guard (guard: u64, generations: u64, evicts: bool) {
    let dmut c = copy GlyphCache(32u32, 1u32, guard, 1u32);
    c:.insert(key(1u32), 30u32, 14u32, 0, 0);
    c:.insert(key(2u32), 30u32, 14u32, 0, 0);

    for i in 0u64 .. generations {
        c:.advance();
        if i == 0u64 { c:.find(key(2u32)); }
    }

    assert (tryInsert(alias c, key(3u32)) == evicts);
    if evicts {
        assert (!c.contains(key(1u32)) && c.contains(key(2u32)));
        assert (c.getEvictionCount() == 1u64);
    } else {
        assert (c.contains(key(1u32)) && c.contains(key(2u32)));
    }
}

__test evicted_region_is_reused {
    let dmut c = copy GlyphCache(32u32, 1u32, 1u64, 1u32);
    let first = c:.insert(key(1u32), 30u32, 14u32, 0, 0);
    c:.insert(key(2u32), 30u32, 14u32, 0, 0);
    c:.advance();

    let third = c:.insert(key(3u32), 30u32, 14u32, 0, 0);
    assert (third.page == first.page && third.x == first.x && third.y == first.y);
}

__test placement_includes_padding {
    let dmut c = copy GlyphCache(32u32, 1u32, 1u64, 1u32);
    let e = c:.insert(key(1u32), 30u32, 14u32, 2, 11);
    assert (e.x == 1u32 && e.y == 1u32 && e.width == 30u32 && e.height == 14u32);
    assert (e.left == 2 && e.top == 11);
    assert (e.u0 == 1.0f / 32.0f && e.u1 == 31.0f / 32.0f);
    assert (e.v0 == 1.0f / 32.0f && e.v1 == 15.0f / 32.0f);
}

__test opens_pages_before_evicting {
    let dmut c = copy GlyphCache(32u32, 2u32, 1u64, 1u32);
    let a = c:.insert(key(1u32), 30u32, 30u32, 0, 0);
    let b = c:.insert(key(2u32), 30u32, 30u32, 0, 0);
    assert (a.page == 0u32 && b.page == 1u32);
    assert (c.getNbPages() == 2u32 && c.getEvictionCount() == 0u64);
}

__test empty_glyph_takes_no_room {
    let dmut c = copy GlyphCache(32u32, 1u32, 1u64, 1u32);
    let space = c:.insert(key(1u32), 0u32, 0u32, 0, 0);
    assert (!space.isPacked() && c.contains(key(1u32)));
    assert (c.getNbPages() == 0u32);
}

__test oversized_glyph_is_refused {
    let dmut c = copy GlyphCache(32u32, 1u32, 1u64, 1u32);
    let mut refused = false;
    {
        c:.insert(key(2u32), 31u32, 4u32, 0, 0);
    } catch {
        _ : &BalderError => { refused = true; }
    }

    assert (refused);
}
