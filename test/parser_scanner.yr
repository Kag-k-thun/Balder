in parser_scanner;

use balder::interface::loader::parser;

use std::syntax::errors;

/**
 * @returns: the tokens of a content, up to its end
 * */
fn scan(content: [c8])-> [Token]
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let mut tokens: [Token] = [];
    loop {
        let tok = scanner:.next();
        if tok.kind == TokenKind::EOF { break; }
        tokens = tokens ~ [tok];
    }

    tokens
}

/**
 * @returns: the text of each token of a content
 * */
fn texts(content: [c8])-> [[c8]]
    throws SyntaxError
{
    let mut result: [[c8]] = [];
    for tok in scan(content) {
        result = result ~ [tok.text];
    }

    result
}

/**
 * @returns: the error of a content that cannot be split, or none
 * */
fn failure(content: [c8])-> (&SyntaxError)? {
    {
        scan(content);
        none
    } catch {
        e: &SyntaxError => { (e)? }
    }
}

__test kinds_of_tokens {
    let tokens = scan("PushButton #YES .yes \"Yes\" $accent @import 12;");
    let kinds = copy [TokenKind::IDENT, TokenKind::HASH, TokenKind::DELIM, TokenKind::IDENT, TokenKind::STRING,
                      TokenKind::CONSTANT, TokenKind::DIRECTIVE, TokenKind::NUMBER, TokenKind::DELIM];
    assert (tokens.len == kinds.len);
    for i in 0us .. kinds.len {
        assert (tokens[i].kind == kinds[i]);
    }

    assert (texts("PushButton #YES .yes \"Yes\" $accent @import 12;") == ["PushButton", "YES", ".", "yes", "Yes", "accent", "import", "12", ";"]);
}

/**
 * (content, number, unit)
 * */
@parameters ((yield c for c in [("12", "12", ""), ("12px", "12", "px"), ("40%", "40", "%"), ("1fr", "1", "fr"),
                                ("0.5", "0.5", ""), ("-4", "-4", ""), ("-1.25px", "-1.25", "px")]))
__test numbers_keep_their_unit_apart (content: [c8], number: [c8], unit: [c8]) {
    let tokens = scan(content);
    assert (tokens.len == 1us);
    assert (tokens[0].kind == TokenKind::NUMBER);
    assert (tokens[0].text == number);
    assert (tokens[0].unit == unit);
}

__test a_number_needs_a_leading_digit {
    assert (texts(".5") == [".", "5"]);
    assert (texts("1 .5") == ["1", ".", "5"]);
}

__test names_keep_their_dashes {
    assert (texts("min-content on-click -webkit _x Scene3D") == ["min-content", "on-click", "-webkit", "_x", "Scene3D"]);
}

__test punctuations_of_two_characters {
    assert (texts("a::b <= >= == != < > ! / *") == ["a", "::", "b", "<=", ">=", "==", "!=", "<", ">", "!", "/", "*"]);
    assert (texts("grey!10 / 40%") == ["grey", "!", "10", "/", "40"]);
}

__test spaces_and_comments_separate_the_tokens {
    let tokens = scan("PushButton.yes:hover .sidebar /* note */ Label// end\n;");
    assert (texts("PushButton.yes:hover .sidebar /* note */ Label// end\n;") == ["PushButton", ".", "yes", ":", "hover", ".", "sidebar", "Label", ";"]);
    assert (!tokens[1].spaced && !tokens[2].spaced && !tokens[3].spaced);
    assert (tokens[5].spaced && tokens[7].spaced && tokens[8].spaced);
}

__test tokens_are_located {
    let tokens = scan("a {\n  width: 40%;\n}");
    assert (tokens[2].line == 2us && tokens[2].col == 3us);
    assert (tokens[4].line == 2us && tokens[4].col == 10us);
    assert (tokens[6].line == 3us && tokens[6].col == 1us);
}

__test the_source_of_a_token_includes_its_sigil_and_quotes {
    let content = "#388bfd \"a b\" 0.5px";
    let dmut scanner = copy Scanner(content);
    for expected in ["#388bfd", "\"a b\"", "0.5px"] {
        let tok = scanner:.next();
        assert (scanner.source(tok.start, tok.end) == expected);
    }
}

__test strings_resolve_their_escapes {
    assert (texts("\"say \\\"hi\\\"\\n\" \"a // b /* c */\"") == ["say \"hi\"\n", "a // b /* c */"]);
}

__test peek_does_not_consume {
    let dmut scanner = copy Scanner("a : b");
    assert (scanner:.peek(1us).text == ":");
    assert (scanner:.peek().text == "a");
    assert (scanner:.next().text == "a");
    assert (scanner:.next().text == ":");
    assert (scanner:.next().text == "b");
    assert (scanner:.next().kind == TokenKind::EOF);
}

/**
 * (content, line, column)
 * */
@parameters ((yield c for c in [("a ? b", 1us, 3us), ("\"open", 1us, 1us), ("\"\\q\"", 1us, 2us), ("# a", 1us, 1us),
                                ("$1", 1us, 1us), ("12p%", 1us, 1us), ("a = b", 1us, 3us), ("\n  \\", 2us, 3us)]))
__test invalid_contents (content: [c8], line: usize, col: usize) {
    if let Ok(e) = failure(content) {
        assert (e.line == line && e.col == col);
    } else {
        assert (false);
    }
}
