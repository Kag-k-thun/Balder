in post_chain;

use balder::core::error;
use balder::core::driver::graph;
use balder::scene::utils::post::_;

use std::math;

use ::vulkan::core;

def COMPUTE      = 0x00000800u32; // VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
def SHADER_WRITE = 0x00000040u32; // VK_ACCESS_SHADER_WRITE_BIT

/**
 * An effect in HDR space reading the depth of the g-buffer, as a fog would
 * */
class FogEffect over PostEffect {
    pub self (name : [c8] = "fog")
        with super (name, PostSpace::HDR, "shaders:/fog.toml", reads-> copy [PostInput::DEPTH])
    {}
}

/**
 * @returns: the names around the chain of a scene named "scene"
 * */
fn sources ()-> PostSources {
    PostSources (scene-> "scene",
                 submission-> "compose",
                 radiance-> "radiance",
                 output-> "output",
                 depth-> "depth",
                 normals-> "normals",
                 velocity-> "velocity")
}

/**
 * @returns: the names of the effects of the stages of a plan, in their order
 * */
fn effectsOf (plan : PostPlan)-> [[c8]] {
    let mut result : [[c8]] = [];
    for s in plan.stages {
        result = result ~ [s.effect];
    }

    result
}

/**
 * @returns: the stage of an effect in a plan, an empty stage if there is none
 * */
fn stageOf (plan : PostPlan, effect : [c8])-> PostStage {
    for s in plan.stages if s.effect == effect {
        return s;
    }

    PostStage ()
}

/**
 * @returns: the pass of a chain named name in the render graph, an empty pass if there is none
 * */
fn passOf (chain : &PostChain, name : [c8])-> PostPass {
    for p in chain.passes (sources (), 32u32, 32u32) if p.name == name {
        return p;
    }

    PostPass ()
}

/**
 * @returns: the graph of a scene, its g-buffer writing the depth and the velocity and its composition the light, the
 * passes of a chain declared after them in the subpass of the composition, and the screen reading the output
 * */
fn graphOf (chain : &PostChain)-> dmut &RenderGraph
    throws BalderError
{
    let dmut g = copy RenderGraph ("screen");
    g:.addSubmission ("screen");
    g:.addSubmission ("deferred");
    g:.addSubmission ("compose");

    g:.createImage ("depth", ImageDesc (width-> 32u32, height-> 32u32, depth-> true));
    g:.createImage ("velocity", ImageDesc (format-> VkFormat::VK_FORMAT_R16G16_SFLOAT, width-> 32u32, height-> 32u32));
    g:.createImage ("radiance", ImageDesc (format-> VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT, width-> 32u32, height-> 32u32, storage-> true));
    g:.importImage ("output");

    g:.declarePass (GraphPass (name-> "screen",
                               submission-> "screen",
                               uses-> copy [ResourceUse (resource-> "output", usage-> Usage::SAMPLED_FRAGMENT)]));
    g:.declarePass (GraphPass (name-> "gbuffer",
                               submission-> "deferred",
                               uses-> copy [ResourceUse (resource-> "depth", usage-> Usage::DEPTH_ATTACHMENT),
                                            ResourceUse (resource-> "velocity", usage-> Usage::COLOR_ATTACHMENT)]));
    g:.declarePass (GraphPass (name-> "compose",
                               submission-> "compose",
                               kind-> PassKind::COMPUTE,
                               uses-> copy [ResourceUse (resource-> "depth", usage-> Usage::SAMPLED_COMPUTE),
                                            ResourceUse (resource-> "radiance", usage-> Usage::STORAGE_WRITE)]));

    for p in chain.passes (sources (), 32u32, 32u32) {
        if !p.imported {
            g:.createImage (p.output, p.image);
        }

        g:.declarePass (p.toPass ("compose", none));
    }

    alias g
}

/**
 * @returns: the barrier of a resource before a pass, a barrier of no stage if there is none
 * */
fn barrierOf (s : RenderSchedule, pass : [c8], resource : [c8])-> GraphBarrier {
    for sub in s.submissions {
        for p in sub.passes if p.name == pass {
            for b in p.barriers if b.resource == resource {
                return b;
            }
        }
    }

    GraphBarrier ()
}

/**
 * @returns: the names of the passes of a subpass of a schedule, in their order
 * */
fn passNames (s : RenderSchedule, submission : [c8])-> [[c8]] {
    let mut result : [[c8]] = [];
    for sub in s.submissions if sub.name == submission {
        for p in sub.passes {
            result = result ~ [p.name];
        }
    }

    result
}

/**
 * A chain without effects tone maps the light the composition wrote straight into the output
 * */
__test the_tone_mapping_alone_writes_the_output {
    let chain = PostChain ();
    let plan = chain.plan (sources ());

    assert (plan.passes () == ["post_tonemap_scene"]);
    let s = plan.stages [0];
    assert (s.input == "radiance" && s.output == "output" && s.last);
    assert (s.space == PostSpace::DISPLAY);
}

/**
 * The effects in HDR space run before the tone mapping and those in display space after it, whatever the order they
 * were added in, each reading the image the stage before it wrote
 * */
__test the_spaces_place_the_effects_around_the_tone_mapping {
    let dmut chain = PostChain ();
    chain:.add (copy InvertEffect ());
    chain:.add (copy VignetteEffect ());
    chain:.add (copy FogEffect ());

    let plan = chain.plan (sources ());
    assert (effectsOf (plan) == ["vignette", "fog", "tonemap", "invert"]);
    assert (plan.passes () == ["post_vignette_scene", "post_fog_scene", "post_tonemap_scene", "post_invert_scene"]);

    let vignette = stageOf (plan, "vignette");
    assert (vignette.input == "radiance" && vignette.output == "post_vignette_out_scene" && !vignette.last);
    assert (vignette.space == PostSpace::HDR);
    assert (vignette.image (32u32, 32u32).format == VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT);

    let fog = stageOf (plan, "fog");
    assert (fog.input == "post_vignette_out_scene" && fog.reads == ["depth"]);
    let fogPass = passOf (chain, "post_fog_scene");
    assert (fogPass.textures == ["input", "depth"] && fogPass.images == ["post_vignette_out_scene", "depth"]);
    let uses = fogPass.uses ();
    assert (uses.len == 3us);
    assert (uses [0].resource == "post_vignette_out_scene" && uses [0].usage == Usage::SAMPLED_COMPUTE);
    assert (uses [1].resource == "depth" && uses [1].usage == Usage::SAMPLED_COMPUTE);
    assert (uses [2].resource == "post_fog_out_scene" && uses [2].usage == Usage::STORAGE_WRITE);

    let tonemap = stageOf (plan, "tonemap");
    assert (tonemap.input == "post_fog_out_scene" && tonemap.output == "post_tonemap_out_scene");
    assert (tonemap.space == PostSpace::DISPLAY);
    assert (tonemap.image (32u32, 32u32).format == VkFormat::VK_FORMAT_R8G8B8A8_UNORM);

    let invert = stageOf (plan, "invert");
    assert (invert.input == "post_tonemap_out_scene" && invert.output == "output" && invert.last);
}

/**
 * A disabled effect is skipped, the stage after it reading what the stage before it wrote, until it is enabled again
 * */
__test disabled_effects_are_skipped {
    let dmut chain = PostChain ();
    chain:.add (copy VignetteEffect ());
    chain:.add (copy InvertEffect (), enabled-> false);

    assert (!chain.isEnabled ("invert") && chain.isEnabled ("vignette"));
    assert (effectsOf (chain.plan (sources ())) == ["vignette", "tonemap"]);
    assert (stageOf (chain.plan (sources ()), "tonemap").output == "output");

    assert (chain:.enable ("vignette", false));
    assert (chain:.enable ("invert", true));
    assert (effectsOf (chain.plan (sources ())) == ["tonemap", "invert"]);
    assert (stageOf (chain.plan (sources ()), "tonemap").input == "radiance");

    assert (!chain:.enable ("bloom", true));
}

/**
 * Effects are reordered within their space and removed, their names unique in the chain, the tone mapping's included
 * */
__test effects_are_reordered_and_removed {
    let dmut chain = PostChain ();
    chain:.add (copy VignetteEffect ());
    chain:.add (copy FogEffect ());
    chain:.add (copy FogEffect (name-> "mist"));

    assert (chain:.reorder ("mist", 0us));
    assert (effectsOf (chain.plan (sources ())) == ["mist", "vignette", "fog", "tonemap"]);

    assert (chain:.reorder ("mist", 10us));
    assert (effectsOf (chain.plan (sources ())) == ["vignette", "fog", "mist", "tonemap"]);

    assert (chain:.remove ("fog"));
    assert (!chain:.remove ("fog"));
    assert (effectsOf (chain.plan (sources ())) == ["vignette", "mist", "tonemap"]);
    assert (chain:.get ("mist").hasValue && !chain:.get ("fog").hasValue);

    let mut refused = 0;
    for name in ["vignette", "tonemap"] {
        {
            chain:.add (copy VignetteEffect (name-> name));
        } catch {
            _ : &BalderError => { refused += 1; }
        }
    }

    assert (refused == 2);
    assert (chain.effects.len == 2us);
}

/**
 * The passes of a chain are compute passes of the subpass of the composition, the render graph ordering them by the
 * images they read and write: each pass samples what the one before it stored, and the screen reads the output
 * */
__test the_render_graph_chains_the_passes {
    let dmut chain = PostChain ();
    chain:.add (copy InvertEffect ());
    chain:.add (copy FogEffect ());

    let g = graphOf (chain);
    let s = g.compile ();
    assert (passNames (s, "compose") == ["compose", "post_fog_scene", "post_tonemap_scene", "post_invert_scene"]);

    for link in [("post_fog_scene", "radiance"),
                 ("post_tonemap_scene", "post_fog_out_scene"),
                 ("post_invert_scene", "post_tonemap_out_scene")] {
        let read = barrierOf (s, link._0, link._1);
        assert (read.srcStage == COMPUTE && read.srcAccess == SHADER_WRITE && read.dstStage == COMPUTE);
        assert (read.oldLayout == VkImageLayout::VK_IMAGE_LAYOUT_GENERAL);
        assert (read.newLayout == VkImageLayout::VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    }

    // the last pass stores the output
    assert (barrierOf (s, "post_invert_scene", "output").newLayout == VkImageLayout::VK_IMAGE_LAYOUT_GENERAL);
}

/**
 * The registry creates the effects a scene description names, with their parameters, those missing taking their default
 * */
__test the_registry_creates_the_described_effects {
    let dmut registry = PostRegistry ();

    if let Ok (v : &VignetteEffect) = registry.create (PostDescription (kind-> "vignette", params-> copy [0.8f, 0.2f])) {
        assert (v.name == "vignette" && v.intensity == 0.8f && v.radius == 0.2f && v.softness == 0.6f);
    } else {
        assert (false);
    }

    if let Ok (i) = registry.create (PostDescription (kind-> "invert")) {
        assert (i.space == PostSpace::DISPLAY);
    } else {
        assert (false);
    }

    assert (!registry.create (PostDescription (kind-> "fog")).hasValue);
    registry:.register ("fog", |_|-> dmut &PostEffect => copy FogEffect ());
    assert (registry.has ("fog") && registry.create (PostDescription (kind-> "fog")).hasValue);
}

/**
 * @returns: the names of the passes of a chain in the render graph, in their order
 * */
fn passNamesOf (chain : &PostChain)-> [[c8]] {
    let mut result : [[c8]] = [];
    for p in chain.passes (sources (), 32u32, 32u32) {
        result = result ~ [p.name];
    }

    result
}

/**
 * A bloom of n levels runs 2n passes: n downsamplings, each writing a level half the size of the one it reads, the
 * first one reading the light; n - 1 upsamplings from the smallest level, each adding the blurred levels below to a level;
 * and the pass of its stage adding the bloom to the light
 * */
__test the_bloom_downsamples_then_upsamples_its_levels {
    let dmut chain = PostChain ();
    chain:.add (copy BloomEffect (levels-> 3u32));

    assert (passNamesOf (chain) == ["post_bloom_scene_down0", "post_bloom_scene_down1", "post_bloom_scene_down2",
                                    "post_bloom_scene_up2", "post_bloom_scene_up1", "post_bloom_scene",
                                    "post_tonemap_scene"]);

    let down0 = passOf (chain, "post_bloom_scene_down0");
    assert (down0.images == ["radiance"] && down0.textures == ["input"] && down0.output == "post_bloom_scene_mip1");
    assert (down0.shader == 0us && down0.level == 0u32 && down0.index == 0us && !down0.imported);
    assert (down0.image.width == 16u32 && down0.image.height == 16u32);
    assert (down0.image.format == VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT && down0.image.storage);

    let down2 = passOf (chain, "post_bloom_scene_down2");
    assert (down2.images == ["post_bloom_scene_mip2"] && down2.output == "post_bloom_scene_mip3");
    assert (down2.level == 2u32 && down2.image.width == 4u32);

    let up2 = passOf (chain, "post_bloom_scene_up2");
    assert (up2.textures == ["input", "low"] && up2.images == ["post_bloom_scene_mip2", "post_bloom_scene_mip3"]);
    assert (up2.output == "post_bloom_scene_up2" && up2.shader == 1us && up2.level == 2u32 && up2.image.width == 8u32);

    let up1 = passOf (chain, "post_bloom_scene_up1");
    assert (up1.images == ["post_bloom_scene_mip1", "post_bloom_scene_up2"] && up1.image.width == 16u32);

    let last = passOf (chain, "post_bloom_scene");
    assert (last.images == ["radiance", "post_bloom_scene_up1"] && last.output == "post_bloom_out_scene");
    assert (last.shader == 1us && last.level == 0u32 && last.index == 5us && last.image.width == 32u32);
    assert (passOf (chain, "post_tonemap_scene").images == ["post_bloom_out_scene"]);
}

/**
 * A bloom has at most its levels, fewer when a level would get under a texel, one at least
 * */
__test the_levels_of_a_bloom_fit_the_images {
    let bloom = BloomEffect (levels-> 6u32);
    assert (bloom.levelsOf (1280u32, 720u32) == 6u32);
    assert (bloom.levelsOf (32u32, 32u32) == 5u32);
    assert (bloom.levelsOf (32u32, 4u32) == 2u32);
    assert (bloom.levelsOf (1u32, 1u32) == 1u32);
    assert (BloomEffect (levels-> 0u32).levels == 1u32);

    let dmut chain = PostChain ();
    chain:.add (copy BloomEffect (levels-> 1u32));
    assert (passNamesOf (chain) == ["post_bloom_scene_down0", "post_bloom_scene", "post_tonemap_scene"]);
    assert (passOf (chain, "post_bloom_scene").images == ["radiance", "post_bloom_scene_mip1"]);
}

/**
 * The render graph orders the passes of a bloom by the levels they read and write, each level sampled once written
 * */
__test the_render_graph_chains_the_levels_of_a_bloom {
    let dmut chain = PostChain ();
    chain:.add (copy BloomEffect (levels-> 2u32));
    chain:.add (copy FxaaEffect ());
    chain:.add (copy LutEffect ());

    let s = graphOf (chain).compile ();
    assert (passNames (s, "compose") == ["compose", "post_bloom_scene_down0", "post_bloom_scene_down1",
                                         "post_bloom_scene_up1", "post_bloom_scene", "post_tonemap_scene",
                                         "post_fxaa_scene", "post_lut_scene"]);

    for link in [("post_bloom_scene_down1", "post_bloom_scene_mip1"),
                 ("post_bloom_scene_up1", "post_bloom_scene_mip2"),
                 ("post_bloom_scene", "post_bloom_scene_up1"),
                 ("post_tonemap_scene", "post_bloom_out_scene")] {
        let read = barrierOf (s, link._0, link._1);
        assert (read.srcStage == COMPUTE && read.srcAccess == SHADER_WRITE && read.dstStage == COMPUTE);
        assert (read.newLayout == VkImageLayout::VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    }

    // the grading, last, stores the output
    assert (barrierOf (s, "post_lut_scene", "output").newLayout == VkImageLayout::VK_IMAGE_LAYOUT_GENERAL);
}

/**
 * The anti-aliasing and the grading run in display space after the tone mapping, in the order they were added, the
 * bloom in HDR space before it
 * */
__test the_effects_of_balder_take_their_space {
    let dmut chain = PostChain ();
    chain:.add (copy LutEffect ());
    chain:.add (copy FxaaEffect ());
    chain:.add (copy BloomEffect ());

    assert (effectsOf (chain.plan (sources ())) == ["bloom", "tonemap", "lut", "fxaa"]);
    let fxaa = stageOf (chain.plan (sources ()), "fxaa");
    assert (fxaa.input == "post_lut_out_scene" && fxaa.output == "output" && fxaa.last);
    assert (passOf (chain, "post_fxaa_scene").imported);
}

/**
 * The temporal anti-aliasing runs first among the effects in HDR space whatever its place in the chain, before the bloom
 * spreads the samples of the jittered frame, the other effects keeping their order
 * */
__test the_temporal_anti_aliasing_runs_first_in_its_space {
    let dmut chain = PostChain ();
    chain:.add (copy BloomEffect ());
    chain:.add (copy VignetteEffect ());
    chain:.add (copy FxaaEffect ());
    chain:.add (copy TaaEffect ());

    assert (effectsOf (chain.plan (sources ())) == ["taa", "bloom", "vignette", "tonemap", "fxaa"]);
    let taa = stageOf (chain.plan (sources ()), "taa");
    assert (taa.input == "radiance" && taa.space == PostSpace::HDR);

    chain:.reorder ("taa", 2us);
    assert (effectsOf (chain.plan (sources ())) == ["taa", "bloom", "vignette", "tonemap", "fxaa"]);
}

/**
 * The temporal anti-aliasing blends the light with the history, reading the depth and the velocity of the g-buffer,
 * copies the blend into the history, a persistent image, and sharpens it into the image of its stage
 * */
__test the_temporal_anti_aliasing_keeps_a_history {
    let dmut chain = PostChain ();
    chain:.add (copy TaaEffect ());

    assert (passNamesOf (chain) == ["post_taa_scene_resolve", "post_taa_scene_history", "post_taa_scene",
                                    "post_tonemap_scene"]);

    let resolve = passOf (chain, "post_taa_scene_resolve");
    assert (resolve.textures == ["input", "depth", "velocity", "history"]);
    assert (resolve.images == ["radiance", "depth", "velocity", "post_taa_scene_history"]);
    assert (resolve.output == "post_taa_scene_resolved" && resolve.shader == 0us && !resolve.image.persistent);
    assert (resolve.image.format == VkFormat::VK_FORMAT_R16G16B16A16_SFLOAT && resolve.image.storage);

    let history = passOf (chain, "post_taa_scene_history");
    assert (history.images == ["post_taa_scene_resolved"] && history.output == "post_taa_scene_history");
    assert (history.shader == 1us && history.level == 0u32 && history.image.persistent);

    let last = passOf (chain, "post_taa_scene");
    assert (last.images == ["post_taa_scene_resolved"] && last.output == "post_taa_out_scene");
    assert (last.shader == 1us && last.level == 1u32 && !last.image.persistent);
}

/**
 * The resolve reads the history the frame before stored, before the copy of the blend stores it again
 * */
__test the_render_graph_carries_the_history_over_the_frames {
    let dmut chain = PostChain ();
    chain:.add (copy TaaEffect ());

    let s = graphOf (chain).compile ();
    assert (passNames (s, "compose") == ["compose", "post_taa_scene_resolve", "post_taa_scene_history",
                                         "post_taa_scene", "post_tonemap_scene"]);

    let read = barrierOf (s, "post_taa_scene_resolve", "post_taa_scene_history");
    assert (read.oldLayout == VkImageLayout::VK_IMAGE_LAYOUT_GENERAL);
    assert (read.srcStage == COMPUTE && read.srcAccess == SHADER_WRITE);
    assert (barrierOf (s, "post_taa_scene_history", "post_taa_scene_history").newLayout == VkImageLayout::VK_IMAGE_LAYOUT_GENERAL);
}

/**
 * The jitters are the points of the Halton (2, 3) sequence from its second, centered on the pixel and scaled to a pixel
 * in normalized device coordinates, the sequence starting again after its samples
 * */
__test the_jitters_follow_a_halton_sequence {
    assert (halton (1u32, 2u32) == 0.5f && halton (2u32, 2u32) == 0.25f && halton (3u32, 2u32) == 0.75f);
    assert (math::abs (halton (4u32, 3u32) - 4.0f / 9.0f) < 1.0e-6f);

    let first = jitterOf (0u32, 4u32, 3u32);
    assert (first.x == 0.0f && math::abs (first.y + 1.0f / 9.0f) < 1.0e-6f);

    let second = jitterOf (1u32, 4u32, 3u32);
    assert (second.x == -0.125f && math::abs (second.y - 1.0f / 9.0f) < 1.0e-6f);

    let again = jitterOf (JITTER_SAMPLES, 4u32, 3u32);
    assert (again.x == first.x && again.y == first.y);

    let unsized = jitterOf (3u32, 0u32, 0u32);
    assert (unsized.x == 0.0f && unsized.y == 0.0f);
}

/**
 * The frames drawn after a change for the history to converge bring the weight of the frames before it under a step of
 * an 8 bits colour, a sequence of jitters at least and 256 at most
 * */
__test the_history_settles_in_a_number_of_frames {
    assert (TaaEffect (blend-> 0.1f).settleFrames () == 53u32);
    assert (TaaEffect (blend-> 0.9f).settleFrames () == JITTER_SAMPLES);
    assert (TaaEffect (blend-> 1.0f).settleFrames () == JITTER_SAMPLES);
    assert (TaaEffect (blend-> 0.0f).settleFrames () == 256u32);
    assert (TaaEffect (blend-> 2.0f).blend == 1.0f && TaaEffect (blend-> -1.0f).blend == 0.0f);
}

/**
 * The registry creates the anti-aliasing, the bloom and the grading with their numbers and their texts
 * */
__test the_registry_creates_the_effects_of_balder {
    let registry = PostRegistry ();

    if let Ok (f : &FxaaEffect) = registry.create (PostDescription (kind-> "fxaa", params-> copy [0.5f])) {
        assert (f.subpix == 0.5f && f.edgeThreshold == 0.166f && f.edgeThresholdMin == 0.0833f);
        assert (f.space == PostSpace::DISPLAY);
    } else {
        assert (false);
    }

    if let Ok (b : &BloomEffect) = registry.create (PostDescription (kind-> "bloom", params-> copy [1.5f, 0.2f, 0.1f, 2.0f, 4.0f])) {
        assert (b.threshold == 1.5f && b.knee == 0.2f && b.intensity == 0.1f && b.radius == 2.0f && b.levels == 4u32);
        assert (b.space == PostSpace::HDR);
    } else {
        assert (false);
    }

    if let Ok (l : &LutEffect) = registry.create (PostDescription (kind-> "lut", params-> copy [0.5f], texts-> copy ["res:/lut/film.png"])) {
        assert (l.path == "res:/lut/film.png" && l.contribution == 0.5f && l.space == PostSpace::DISPLAY);
    } else {
        assert (false);
    }

    if let Ok (l : &LutEffect) = registry.create (PostDescription (kind-> "lut")) {
        assert (l.path == NEUTRAL_LUT && l.contribution == 1.0f);
    } else {
        assert (false);
    }

    if let Ok (t : &TaaEffect) = registry.create (PostDescription (kind-> "taa", params-> copy [0.05f, 1.25f, 0.15f])) {
        assert (t.blend == 0.05f && t.clip == 1.25f && t.sharpness == 0.15f);
        assert (t.space == PostSpace::HDR && t.runsFirst && t.reads == [PostInput::DEPTH, PostInput::VELOCITY]);
    } else {
        assert (false);
    }

    if let Ok (t : &TaaEffect) = registry.create (PostDescription (kind-> "taa")) {
        assert (t.blend == 0.1f && t.clip == 1.0f && t.sharpness == 0.25f);
    } else {
        assert (false);
    }
}
