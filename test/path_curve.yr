in path_curve;

use balder::math::{curve, vector};

use std::math;

/**
 * @returns: true iif two numbers are equal, give or take the rounding errors
 * */
fn near(a: f32, b: f32, tolerance: f32 = 0.001f)-> bool {
    math::abs(a - b) < tolerance
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3, tolerance: f32 = 0.001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: four points on the corners of a square of side 2 about the origin, in the XZ plane, turning about Y
 * */
fn square()-> [vec3] {
    copy [makeVec3(-1.0f, 0.0f, -1.0f), makeVec3(1.0f, 0.0f, -1.0f), makeVec3(1.0f, 0.0f, 1.0f), makeVec3(-1.0f, 0.0f, 1.0f)]
}

__test a_curve_goes_through_its_points_at_the_ends_of_its_spans {
    let points = square();
    let c = Curve(CurveKind::CATMULL_ROM, points, subdivisions-> 8us);
    let samples = c.samples;

    assert (samples.len == 3us * 8us + 1us);
    for i, p in points {
        assert (near(samples[i * 8us], p));
    }
}

__test a_curve_of_points_on_a_line_is_the_line {
    let points = copy [makeVec3(0.0f, 0.0f, 0.0f), makeVec3(2.0f, 0.0f, 0.0f), makeVec3(4.0f, 0.0f, 0.0f)];
    for kind in [CurveKind::CATMULL_ROM, CurveKind::BEZIER] {
        let c = Curve(kind, points);
        assert (near(c.length, 4.0f));
        assert (near(c.pointAt(1.0f), makeVec3(1.0f, 0.0f, 0.0f), tolerance-> 0.01f));
        assert (near(c.pointAt(3.0f), makeVec3(3.0f, 0.0f, 0.0f), tolerance-> 0.01f));
        if let Ok(d) = c.directionAt(2.5f) {
            assert (near(d, makeVec3(1.0f, 0.0f, 0.0f)));
        } else {
            assert (false);
        }
    }
}

__test the_distances_past_the_ends_of_an_open_curve_are_kept_to_them {
    let c = Curve(CurveKind::CATMULL_ROM, square());
    assert (!c.closed);
    assert (near(c.pointAt(-3.0f), makeVec3(-1.0f, 0.0f, -1.0f)));
    assert (near(c.pointAt(c.length + 3.0f), makeVec3(-1.0f, 0.0f, 1.0f)));
}

__test a_closed_curve_goes_back_to_its_first_point_and_turns_around {
    let c = Curve(CurveKind::CATMULL_ROM, square(), closed-> true, subdivisions-> 8us);
    let samples = c.samples;

    assert (c.closed && samples.len == 4us * 8us + 1us);
    assert (near(samples[samples.len - 1us], makeVec3(-1.0f, 0.0f, -1.0f)));
    assert (near(c.pointAt(c.length + 0.7f), c.pointAt(0.7f)));
    assert (near(c.pointAt(-0.7f), c.pointAt(c.length - 0.7f)));

    // through the corners of the square, each one at the same distance from the centre, the curve bulges out between them
    let between = c.pointAt(c.length / 8.0f);
    assert (makeVec3(between.x, 0.0f, between.z).length() > 1.0f);
}

__test a_bezier_curve_leaves_each_point_along_its_handle {
    let points = copy [makeVec3(0.0f, 0.0f, 0.0f), makeVec3(4.0f, 0.0f, 0.0f)];
    let handles = copy [makeVec3(0.0f, 2.0f, 0.0f), makeVec3(0.0f, -2.0f, 0.0f)];
    let c = Curve(CurveKind::BEZIER, points, handles-> handles, subdivisions-> 64us);

    if let Ok(d) = c.directionAt(0.0f) {
        assert (d.y > 0.9f);
    } else {
        assert (false);
    }

    // the curve comes into its last point from the point minus its handle, from above too
    if let Ok(d) = c.directionAt(c.length) {
        assert (d.y < -0.9f);
    } else {
        assert (false);
    }

    assert (c.pointAt(c.length / 2.0f).y > 0.5f);
}

__test a_curve_of_one_point_or_of_none_has_no_length {
    let one = Curve(CurveKind::CATMULL_ROM, copy [makeVec3(1.0f, 2.0f, 3.0f)], closed-> true);
    assert (one.length == 0.0f && !one.closed && one.samples.len == 1us);
    assert (one.pointAt(5.0f) == makeVec3(1.0f, 2.0f, 3.0f));
    assert (!one.directionAt(0.0f).hasValue);

    let none_ = Curve(CurveKind::BEZIER, []);
    assert (none_.length == 0.0f && none_.samples.len == 0us && none_.pointAt(1.0f) == vec3());
}
