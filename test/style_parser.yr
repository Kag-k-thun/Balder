in style_parser;

use balder::core::error;
use balder::interface::style;
use balder::interface::font::family;
use balder::interface::widget::alignement;

fn parse(content: [c8])-> dmut &StyleManager
    throws BalderError
{
    let dmut m = copy StyleManager();
    let mut p = StyleParser(alias m, content);
    p:.load();
    alias m
}

fn rejects(content: [c8])-> bool {
    {
        parse(content);
        false
    } catch {
        _ : &BalderError => { true }
    }
}

__test font_properties {
    let dmut m = parse("Label .title { font-family: \"Noto Sans\", 'DejaVu Sans Mono', sans-serif; font-weight: 600; font-style: italic; font-size: 20; }");
    let s = m.get("Label", copy ["title"], false, false, false);
    assert (s.fontFamily._1 == ["Noto Sans", "DejaVu Sans Mono", "sans-serif"]);
    assert (s.fontWeight._1 == 600u32);
    assert (s.fontStyle._1 == FontStyle::ITALIC);
    assert (s.fontSize._1 == 20u32);
}

__test unquoted_family_of_several_words {
    let dmut m = parse("Label .a { font-family: Noto Sans, monospace; }");
    assert (m.get("Label", copy ["a"], false, false, false).fontFamily._1 == ["Noto Sans", "monospace"]);
}

/**
 * (font-weight value, weight)
 * */
@parameters ((yield c for c in [("normal", 400u32), ("bold", 700u32), ("100", 100u32), ("950", 950u32)]))
__test font_weight_keywords (value: [c8], weight: u32) {
    let dmut m = parse("Label .a { font-weight: " ~ value ~ "; }");
    assert (m.get("Label", copy ["a"], false, false, false).fontWeight._1 == weight);
}

__test default_font_is_regular_sans_serif {
    let dmut m = parse("Label .a { font-size: 12; }");
    let s = m.get("Label", copy ["a"], false, false, false);
    assert (s.fontFamily._1 == ["sans-serif"]);
    assert (s.fontWeight._1 == FONT_WEIGHT_NORMAL);
    assert (s.fontStyle._1 == FontStyle::NORMAL);
}

__test merged_font_keeps_the_unset_properties {
    let dmut m = parse("Label .a { font-family: \"Noto Sans\"; font-weight: bold; } Label .b { font-style: oblique; }");
    let s = m.get("Label", copy ["a", "b"], false, false, false);
    assert (s.fontFamily._1 == ["Noto Sans"]);
    assert (s.fontWeight._1 == 700u32);
    assert (s.fontStyle._1 == FontStyle::OBLIQUE);
}

@parameters ((yield c for c in ["Label .a { font-weight: heavy; }",
                                "Label .a { font-weight: 0; }",
                                "Label .a { font-style: slanted; }",
                                "Label .a { font-family: ; }",
                                "Label .a { font-family: \"Noto Sans\" monospace; }",
                                "Label .a { font: \"res:/fonts/DejaVuSansMono.ttf\"; }"]))
__test invalid_font_properties (content: [c8]) {
    assert (rejects(content));
}

__test font_face_rules {
    let dmut m = parse("@font-face { font-family: \"Title\"; src: \"res:/fonts/noto/NotoSans-Bold.ttf\"; font-weight: 500; }\n"
                       ~ "@font-face { src: \"res:/fonts/noto/NotoSans-Italic.ttf\"; font-family: Title; font-style: normal; }\n"
                       ~ "Label .a { font-family: Title; }");

    let rules = m:.takeFontFaces();
    assert (rules.len == 2us);
    assert (rules[0].family == "Title" && rules[0].src == "res:/fonts/noto/NotoSans-Bold.ttf");
    assert (rules[0].weight == (500u32)? && !rules[0].style.hasValue);
    assert (!rules[1].weight.hasValue && rules[1].style == (FontStyle::NORMAL)?);

    assert (m:.takeFontFaces().len == 0us);
    assert (m.get("Label", copy ["a"], false, false, false).fontFamily._1 == ["Title"]);
}

@parameters ((yield c for c in ["@font-face { src: \"res:/fonts/DejaVuSansMono.ttf\"; }",
                                "@font-face { font-family: \"Mono\"; }",
                                "@font-face { font-family: \"A\", \"B\"; src: \"res:/fonts/DejaVuSansMono.ttf\"; }",
                                "@font-face { font-family: \"Mono\"; src: \"res:/fonts/DejaVuSansMono.ttf\"; font-size: 12; }"]))
__test invalid_font_face (content: [c8]) {
    assert (rejects(content));
}

__test text_wrap {
    let dmut m = parse("Label .a { text-wrap: wrap; } Label .b { text-wrap: nowrap; } Label .c { font-size: 12; }");
    assert (m.get("Label", copy ["a"], false, false, false).textWrap == (true, true));
    assert (m.get("Label", copy ["b"], false, false, false).textWrap == (true, false));
    assert (m.get("Label", copy ["c"], false, false, false).textWrap._1 == false);
    assert (m.get("Label", copy ["c", "a"], false, false, false).textWrap._1 == true);
}

__test rejects_an_unknown_text_wrap {
    assert (rejects("Label .a { text-wrap: balance; }"));
}

__test content_sizes {
    let dmut m = parse("Label .a { width: auto; height: max-content; } Label .b { width: min-content; } Label .c { width: { fit: max-content; min: 20; max: 300; } }");
    let a = m.get("Label", copy ["a"], false, false, false);
    assert (a.getWidth().kind == SizeKind::AUTO);
    assert (a.getHeight().kind == SizeKind::MAX_CONTENT);
    assert (m.get("Label", copy ["b"], false, false, false).getWidth().kind == SizeKind::MIN_CONTENT);

    let c = m.get("Label", copy ["c"], false, false, false).getWidth();
    assert (c.kind == SizeKind::MAX_CONTENT && c.minPix == 20u32 && c.maxPix == 300u32);
}

__test flex_properties {
    let dmut m = parse("Label .a { flex-grow: 2; flex-shrink: 0.5; flex-basis: 120; } Label .b { flex-basis: auto; }");
    let a = m.get("Label", copy ["a"], false, false, false);
    assert (a.flexGrow == (true, 2.0f));
    assert (a.flexShrink == (true, 0.5f));
    assert (a.flexBasis.0 && a.flexBasis.1 == WidgetSize(pix-> 120u32));
    assert ((m.get("Label", copy ["b"], false, false, false).flexBasis.1).kind == SizeKind::AUTO);
}

__test flex_defaults_keep_the_bases_and_shrink_them_evenly {
    let dmut m = parse("Label .a { font-size: 12; }");
    let a = m.get("Label", copy ["a"], false, false, false);
    assert (a.flexGrow._1 == 0.0f);
    assert (a.flexShrink._1 == 1.0f);
    assert (!a.flexBasis._0);
}

__test merged_flex_keeps_the_unset_properties {
    let dmut m = parse("Label .a { flex-grow: 1; } Label .b { flex-shrink: 0; }");
    let s = m.get("Label", copy ["a", "b"], false, false, false);
    assert (s.flexGrow._1 == 1.0f && s.flexShrink._1 == 0.0f);
}

@parameters ((yield c for c in ["Label .a { flex-grow: -1; }",
                                "Label .a { flex-grow: auto; }",
                                "Label .a { width: fit-content; }",
                                "Label .a { width: { fit: 12; } }",
                                "Label :hover .a { flex-grow: 1; }"]))
__test invalid_sizes_and_flex_properties (content: [c8]) {
    assert (rejects(content));
}
