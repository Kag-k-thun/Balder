in tree_dragging;

use balder::interface::widget::tree::{dragging, drop};

__test the_edges_of_a_row_drop_between_rows_its_middle_under_its_node {
    // the top quarter goes before the node, among its siblings
    let before = dropOnRow(copy [1us, 2us], 0.1f, 0us, false);
    assert (before.parent == copy [1us] && before.index == 2us && !before.onto);

    // the bottom quarter goes after it
    let after = dropOnRow(copy [1us, 2us], 0.9f, 0us, false);
    assert (after.parent == copy [1us] && after.index == 3us && !after.onto);

    // the middle goes under it, after its children
    let onto = dropOnRow(copy [1us, 2us], 0.5f, 4us, false);
    assert (onto.parent == copy [1us, 2us] && onto.index == 4us && onto.onto);
}

__test the_bottom_of_a_node_expanded_goes_before_its_first_child {
    let first = dropOnRow(copy [0us], 0.9f, 3us, true);
    assert (first.parent == copy [0us] && first.index == 0us && !first.onto);

    // collapsed, or expanded without children, it goes after the node
    let collapsed = dropOnRow(copy [0us], 0.9f, 3us, false);
    assert (collapsed.parent == [] && collapsed.index == 1us);
    let empty = dropOnRow(copy [0us], 0.9f, 0us, true);
    assert (empty.parent == [] && empty.index == 1us);
}

__test below_the_rows_goes_after_the_last_node_of_the_first_level {
    let below = dropBelowRows(5us);
    assert (below.parent == [] && below.index == 5us && !below.onto);
}

__test a_drop_under_a_node_dragged_is_refused {
    let nodes = copy [copy [1us], copy [3us, 0us]];
    assert (isUnderDragged(TreeDrop(nodes-> nodes, parent-> copy [1us])));
    assert (isUnderDragged(TreeDrop(nodes-> nodes, parent-> copy [1us, 4us, 2us])));
    assert (isUnderDragged(TreeDrop(nodes-> nodes, parent-> copy [3us, 0us])));

    // beside them, or under their parents, they can go
    assert (!isUnderDragged(TreeDrop(nodes-> nodes, parent-> [])));
    assert (!isUnderDragged(TreeDrop(nodes-> nodes, parent-> copy [3us])));
    assert (!isUnderDragged(TreeDrop(nodes-> nodes, parent-> copy [3us, 1us])));
    assert (!isUnderDragged(TreeDrop(nodes-> nodes, parent-> copy [2us, 0us])));
}

__test the_nodes_under_another_node_selected_follow_it {
    let selected = copy [copy [0us], copy [0us, 1us], copy [0us, 1us, 0us], copy [2us, 0us], copy [3us]];
    assert (draggedOf(selected) == copy [copy [0us], copy [2us, 0us], copy [3us]]);
    assert (draggedOf([]) == []);
}

__test the_rows_scroll_faster_as_the_cursor_goes_past_their_edges {
    // 10 rows of 20 pixels: the top and the bottom rows scroll, the others not
    assert (edgeScroll(100.0f, 200.0f, 20.0f) == 0.0);
    assert (edgeScroll(25.0f, 200.0f, 20.0f) == 0.0);

    let top = edgeScroll(10.0f, 200.0f, 20.0f);
    let edge = edgeScroll(0.0f, 200.0f, 20.0f);
    let above = edgeScroll(-40.0f, 200.0f, 20.0f);
    assert (top < 0.0 && edge < top && above < edge);

    // twice the speed of the edge at most
    assert (edgeScroll(-1000.0f, 200.0f, 20.0f) == above);
    assert (above == -2.0 * SCROLL_ROWS * 20.0);

    let bottom = edgeScroll(190.0f, 200.0f, 20.0f);
    assert (bottom > 0.0 && bottom == -top);

    // nothing to scroll in no room
    assert (edgeScroll(0.0f, 0.0f, 20.0f) == 0.0 && edgeScroll(0.0f, 200.0f, 0.0f) == 0.0);
}
