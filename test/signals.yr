in signals;

use balder::core::application::signal;
use balder::interface::loader::{parser, registry::_, registry::behavior, registry::connection, registry::error, registry::handler};
use balder::interface::widget::{button::_, text::_};
use balder::math::vector;

use std::syntax::errors;

/**
 * FieldRow, a component forwarding the signal of its input through a parameter, on the lines 1 to 6 of the contents
 * using it
 * */
def FIELD_ROW = "@component FieldRow ($label, $on-validate: none) {\n"
    ~ "    LinearLayout {\n"
    ~ "        Label $label;\n"
    ~ "        InputText #INPUT { on-validate: $on-validate; }\n"
    ~ "    }\n"
    ~ "}\n";

/**
 * The slots of the tests, recording their calls
 * */
class Recorder {

    // The calls received, in order
    let mut _calls: [[c8]] = [];

    pub self () {}

    pub fn onClick(mut self, b: u8) {
        self._calls ~= [std::format::format("click {}", b)];
    }

    pub fn onValidate(mut self, text: [c8]) {
        self._calls ~= ["validate " ~ text];
    }

    pub fn onDescribe(mut self, text: [c8], b: u8) {
        self._calls ~= [std::format::format("describe {} {}", text, b)];
    }

    pub fn onHello(mut self, text: [c8]) {
        self._calls ~= ["hello " ~ text];
    }

    pub fn onFocus(mut self) {
        self._calls ~= ["focus"];
    }

    pub fn onNumbers(mut self, i: i32, f: f64, flag: bool, b: u8) {
        self._calls ~= [std::format::format("numbers {} {} {} {}", i, f, flag, b)];
    }

    pub fn onHover(mut self, name: [c8], pos: vec2) {
        self._calls ~= [std::format::format("hover {} {} {}", name, cast!i32(pos.x), cast!i32(pos.y))];
    }

    pub fn calls(self)-> [[c8]] {
        self._calls
    }
}

/**
 * A behavior registering its slots in its constructor, mounted under a name
 * */
class FormBehavior over Behavior {

    pub self (dmut recorder: &Recorder) {
        self:.slot("submit", &recorder:.onClick);
        self:.slot("name-set", &recorder:.onValidate);
    }
}

/**
 * @returns: a behavior with the slots of a recorder: quit, validate, describe, hello, focus, numbers and hover
 * */
fn slots(dmut recorder: &Recorder)-> dmut &Behavior {
    let dmut b = copy Behavior();
    b:.slot("quit", &recorder:.onClick);
    b:.slot("validate", &recorder:.onValidate);
    b:.slot("describe", &recorder:.onDescribe);
    b:.slot("hello", &recorder:.onHello);
    b:.slot("focus", &recorder:.onFocus);
    b:.slot("numbers", &recorder:.onNumbers);
    b:.slot("hover", &recorder:.onHover);
    alias b
}

/**
 * @returns: the value of a content
 * */
fn value(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @returns: the error of the check of a .gui content against the slots of a behavior, none when it is accepted
 * @params:
 *    - behavior: the slots, none to check only the syntax of the slot references
 * */
fn failure(content: [c8], behavior: (&Behavior)?)-> (&LoadError)?
    throws SyntaxError
{
    let doc = {
        let dmut reader = GuiReader(content);
        reader:.read()
    };

    {
        let dmut registry = WidgetRegistry();
        registry:.check(doc, "test.gui", behavior-> behavior);
        none
    } catch {
        e: &LoadError => { (e)? }
    }
}

/**
 * @returns: true iif a content is accepted against the slots of a recorder
 * */
fn accepts(content: [c8])-> bool
    throws SyntaxError
{
    let dmut recorder = copy Recorder();
    !failure(content, (slots(alias recorder))?).hasValue
}

/**
 * @returns: true iif a content is refused against the slots of a recorder with reason, at line and col
 * */
fn refuses(content: [c8], reason: [c8], line: usize, col: usize)-> bool
    throws SyntaxError
{
    let dmut recorder = copy Recorder();
    if let Ok(e) = failure(content, (slots(alias recorder))?) {
        return e.reason == reason && e.line == line && e.col == col && e.file == "test.gui";
    }

    false
}

/**
 * @returns: the connection of the slot named name of a behavior to the arguments of a slot reference
 * @throws: when there is no such slot, or an argument does not decode to its parameter
 * */
fn connection(behavior: &Behavior, reference: [c8])-> &Connection
    throws SyntaxError
{
    let target = SlotRef(value(reference));
    if let Ok(h) = behavior.find(target.name) {
        return h.bind(target.args);
    }

    throw copy SyntaxError("no slot " ~ target.name, 0us, 0us);
}

/**
 * Emit a signal of payload P connected to a connection, through an emitter, as a widget does
 * @returns: false iif the connection does not take a P
 * */
fn emit {P} (c: &Connection, payload: P)-> bool {
    let dmut box = copy SlotEmitter();
    let dmut signal = copy Signal!{P} ();
    if let k: &Connection!{P} = c {
        signal:.connect(alias box, &k.fire);
        signal:.emit(payload);
        box:.emit();
        return true;
    }

    false
}

/**
 * Emit a signal without payload connected to a connection, through an emitter
 * @returns: false iif the connection takes a payload
 * */
fn emit(c: &Connection)-> bool {
    let dmut box = copy SlotEmitter();
    let dmut signal = copy Signal!{()} ();
    if let k: &Connection!{()} = c {
        signal:.connect(alias box, &k.fire);
        signal:.emit();
        box:.emit();
        return true;
    }

    false
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          REGISTRATION          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_slots_are_registered_with_their_parameters {
    let dmut recorder = copy Recorder();
    let b = slots(alias recorder);

    if let Ok(h) = b.find("describe") {
        assert (h.signature() == "([c8], u8)");
    } else {
        assert (false);
    }

    if let Ok(h) = b.find("focus") {
        assert (h.params.len == 0us && h.signature() == "()");
    } else {
        assert (false);
    }

    assert (!b.find("nope").hasValue);
}

__test the_widgets_register_their_signals {
    let push = PushButton::schema();
    if let Ok(click) = push.signal("on-click") {
        assert (click.payload.len == 1us && click.payload[0].name == "u8");
    } else {
        assert (false);
    }

    if let Ok(focus) = push.signal("on-focus") {
        assert (focus.payload.len == 0us);
    } else {
        assert (false);
    }

    assert (push.signal("on-blur").hasValue && push.signal("on-double-click").hasValue);
    assert (!push.signal("on-validate").hasValue);

    if let Ok(validate) = InputText::schema().signal("on-validate") {
        assert (validate.payload.len == 1us && validate.payload[0].name == "[c8]");
    } else {
        assert (false);
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          TYPE CHECK          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_slots_matching_the_signals_are_accepted {
    assert (accepts("PushButton { on-click: quit; }"));
    assert (accepts("PushButton { on-focus: focus; on-blur: focus; on-double-click: focus; }"));
    assert (accepts("InputText { on-validate: validate; }"));
    assert (accepts("MenuLayout { on-menu-open: focus; on-menu-close: focus; Box; Box; }"));

    // none leaves the signal unconnected
    assert (accepts("PushButton { on-click: none; }"));
}

__test the_slots_refused {
    assert (refuses("PushButton { on-click: qit; }", "no slot 'qit' for the attribute 'on-click' of 'PushButton'", 1us, 14us));
    assert (refuses("InputText { on-validate: quit; }",
                    "the slot 'quit' takes (u8), the attribute 'on-validate' of 'InputText' gives ([c8])", 1us, 13us));
    assert (refuses("PushButton { on-focus: quit; }",
                    "the slot 'quit' takes (u8), the attribute 'on-focus' of 'PushButton' gives ()", 1us, 14us));
    assert (refuses("PushButton { on-click: focus; }",
                    "the slot 'focus' takes (), the attribute 'on-click' of 'PushButton' gives (u8)", 1us, 14us));

    // a signal the type does not emit
    assert (refuses("Label { on-validate: validate; }", "unknown attribute 'on-validate' of 'Label'", 1us, 9us));

    // a value that is not a slot reference
    assert (refuses("PushButton { on-click: \"quit\"; }", "attribute 'on-click' of 'PushButton': expected a slot, found '\"quit\"'", 1us, 24us));
}

__test without_behavior_only_the_syntax_is_checked {
    assert (!failure("PushButton { on-click: nope (1, 2); }", none).hasValue);
    if let Ok(e) = failure("PushButton { on-click: 12; }", none) {
        assert (e.reason == "attribute 'on-click' of 'PushButton': expected a slot, found '12'");
    } else {
        assert (false);
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===============================          BOUND ARGUMENTS          =================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_bound_arguments_are_checked {
    assert (accepts("PushButton { on-click: describe (\"Label\"); }"));
    assert (accepts("PushButton { on-focus: describe (\"Label\", 2); }"));
    assert (accepts("PushButton { on-click: numbers (-3, 2.5, true); }"));

    assert (refuses("PushButton { on-click: describe (2); }",
                    "argument of the slot 'describe' for the attribute 'on-click' of 'PushButton': expected a string, found '2'", 1us, 34us));
    assert (refuses("PushButton { on-click: describe; }",
                    "the slot 'describe' takes ([c8], u8), the attribute 'on-click' of 'PushButton' gives (u8)", 1us, 14us));
    assert (refuses("PushButton { on-click: quit (1); }",
                    "the slot 'quit' takes (u8), the attribute 'on-click' of 'PushButton' gives (u8) after 1 bound argument", 1us, 14us));
    assert (refuses("PushButton { on-click: describe (\"a\", 1, 2); }",
                    "the slot 'describe' takes ([c8], u8), the attribute 'on-click' of 'PushButton' gives (u8) after 3 bound arguments", 1us, 14us));
}

__test the_bound_arguments_are_passed_before_the_payload {
    let dmut recorder = copy Recorder();
    let b = slots(alias recorder);

    assert (emit(connection(b, "quit"), 3u8));
    assert (emit(connection(b, "describe (\"Label\")"), 1u8));
    assert (emit(connection(b, "numbers (-3, 2.5, true)"), 2u8));
    assert (emit(connection(b, "validate"), "Ada"));

    // every parameter bound, for a signal without payload
    assert (emit(connection(b, "hello (\"world\")")));
    assert (emit(connection(b, "describe (\"Box\", 4)")));
    assert (emit(connection(b, "focus")));

    assert (recorder.calls() == ["click 3", "describe Label 1", "numbers -3 2.500000 true 2", "validate Ada",
                                 "hello world", "describe Box 4", "focus"]);
}

__test a_payload_of_any_type {
    let dmut recorder = copy Recorder();
    let b = slots(alias recorder);

    assert (emit(connection(b, "hover (\"map\")"), makeVec2(1.0f, 2.0f)));
    assert (recorder.calls() == ["hover map 1 2"]);

    // a payload of another type does not take the connection
    assert (!emit(connection(b, "hover (\"map\")"), 1u8));

    // no value of the .gui files decodes to a vec2, given only by a payload
    let msg = {
        connection(b, "hover (\"map\", \"pos\")");
        ""
    } catch {
        e: &SyntaxError => { e.msg }
    };

    assert (msg == "'\"pos\"' cannot be bound to a parameter of type " ~ vec2::typeid ~ ", given only by the payload of a signal");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          LOOKUP          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test the_slots_of_the_behaviors_are_looked_up_by_path {
    let dmut recorder = copy Recorder();
    let dmut b = slots(alias recorder);
    b:.behavior("form", copy FormBehavior(alias recorder));

    assert (b.find("form::submit").hasValue && b.find("form::name-set").hasValue);

    // a path is not looked up anywhere else than where it leads
    assert (!b.find("submit").hasValue && !b.find("form::quit").hasValue && !b.find("form").hasValue);

    // a slot registered by path goes to the behavior mounted on the way, or creates the missing ones
    b:.slot("form::reset", &recorder:.onClick);
    b:.slot("view::scene::reset", &recorder:.onClick);
    assert (b.find("form::reset").hasValue && b.find("form::submit").hasValue);
    assert (b.find("view::scene::reset").hasValue && !b.find("view::reset").hasValue);

    // mounting a behavior replaces the one mounted there, and its slots
    b:.behavior("form", copy Behavior());
    assert (!b.find("form::submit").hasValue && !b.find("form::reset").hasValue);
}

__test the_attributes_name_the_slots_by_path {
    let dmut recorder = copy Recorder();
    let dmut b = slots(alias recorder);
    b:.behavior("form", copy FormBehavior(alias recorder));

    assert (!failure("PushButton { on-click: form::submit; }", (b)?).hasValue);
    if let Ok(e) = failure("PushButton { on-click: form::quit; }", (b)?) {
        assert (e.reason == "no slot 'form::quit' for the attribute 'on-click' of 'PushButton'");
    } else {
        assert (false);
    }
}

__test a_component_forwards_a_signal_through_a_parameter {
    // left unconnected by the default of the parameter
    assert (accepts(FIELD_ROW ~ "FieldRow #NAME \"Name\";"));
    assert (accepts(FIELD_ROW ~ "FieldRow #NAME \"Name\" { on-validate: validate; }"));

    // refused where the instance gives the slot
    assert (refuses(FIELD_ROW ~ "FieldRow #AGE \"Age\" { on-validate: nope; }",
                    "parameter '$on-validate' of 'FieldRow': no slot 'nope' for the attribute 'on-validate' of 'InputText'", 7us, 36us));
    assert (refuses(FIELD_ROW ~ "FieldRow #AGE \"Age\" { on-validate: quit; }",
                    "parameter '$on-validate' of 'FieldRow': the slot 'quit' takes (u8), the attribute 'on-validate' of 'InputText' gives ([c8])",
                    7us, 36us));
}
