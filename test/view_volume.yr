in view_volume;

use balder::math::{bounds, utils, vector};

use std::math;

/**
 * @returns: true iif two sizes are equal, give or take the rounding errors
 * */
fn near(a: f32, b: f32)-> bool {
    math::abs(a - b) < 0.001f
}

/**
 * @returns: the box of side 2 centered on a point
 * */
fn cube(center: vec3)-> Aabb {
    Aabb(center - 1.0f, center + 1.0f)
}

/**
 * @returns: the view of a camera at the origin looking down -z, with a vertical field of view of 90°, a square aspect,
 * seeing from 1 to 100 units in front of it, on 100 pixels of height
 * */
fn perspectiveView()-> ViewVolume {
    let proj = perspective!{f32}(radian(90.0f), 1.0f, 1.0f, 100.0f);
    let view = lookAt!{f32}(vec3(), makeVec3(0.0f, 0.0f, -1.0f), makeVec3(0.0f, 1.0f, 0.0f));

    ViewVolume(proj * view, 100.0f)
}

__test the_default_view_sees_every_box_larger_than_any_size {
    let view = ViewVolume();

    assert (view.pixelSize(cube(makeVec3(0.0f, 0.0f, -1000.0f))) > 1000000.0f);
    assert (view.frustum.intersects(cube(makeVec3(1000.0f, 0.0f, 0.0f))));
}

__test an_empty_box_has_no_size_on_screen {
    assert (perspectiveView().pixelSize(Aabb()) == 0.0f);
}

__test the_size_of_a_box_is_its_diameter_seen_at_its_closest_point {
    // the closest face is 4 units away, where the 100 pixels see 8 units: the diameter 2√3 covers 2√3 * 100 / 8
    let size = perspectiveView().pixelSize(cube(makeVec3(0.0f, 0.0f, -5.0f)));

    assert (near(size, 25.0f * cast!f32(math::sqrt(3.0))));
}

__test the_size_of_a_box_shrinks_with_its_distance {
    let view = perspectiveView();
    let close = view.pixelSize(cube(makeVec3(0.0f, 0.0f, -5.0f)));
    let far = view.pixelSize(cube(makeVec3(0.0f, 0.0f, -9.0f)));

    assert (near(far * 2.0f, close));
}

__test a_box_reaching_the_plane_of_the_eye_has_an_unbounded_size {
    let view = perspectiveView();

    assert (view.pixelSize(cube(makeVec3(0.0f, 0.0f, -0.5f))) == f32::max);
    assert (view.pixelSize(cube(makeVec3(0.0f, 0.0f, 5.0f))) == f32::max);
}

__test the_size_of_a_box_seen_by_an_orthographic_view_ignores_its_distance {
    // the 100 pixels see 20 units, 5 pixels a unit
    let view = ViewVolume(ortho!{f32}(-10.0f, 10.0f, -10.0f, 10.0f, 1.0f, 100.0f), 100.0f);
    let expected = 10.0f * cast!f32(math::sqrt(3.0));

    assert (near(view.pixelSize(cube(makeVec3(0.0f, 0.0f, -5.0f))), expected));
    assert (near(view.pixelSize(cube(makeVec3(3.0f, 0.0f, -50.0f))), expected));
}
