in flex_line;

use balder::interface::loader::parser;
use balder::interface::widget::sizing;
use balder::interface::widget::layout::flex;

/**
 * @returns: a size of a length in pixels
 * */
fn px(amount: f32)-> Size {
    Size(Sizing::LENGTH, length-> Length(amount))
}

/**
 * @returns: the item of a widget whose content is between 60 and 200 pixels, its bounds being auto
 * @params:
 *    - size: its width
 *    - basis: its flex basis
 *    - grow: its growth factor
 *    - shrink: its shrink factor
 * */
fn item(size: Size, basis: Size, grow: f32 = 0.0f, shrink: f32 = 1.0f)-> FlexItem {
    let auto = Size(Sizing::AUTO);
    flexItemOf(size, basis, auto, auto, 400.0f, 0.0f, (60.0f, 200.0f), grow, shrink)
}

fn near(a: [f32], b: [f32])-> bool {
    if a.len != b.len { return false; }
    for i in 0us .. a.len {
        let d = a[i] - b[i];
        if d > 0.001f || -d > 0.001f { return false; }
    }

    true
}

__test free_space_is_shared_by_the_growth_factors {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 100.0f, grow-> 1.0f), FlexItem(basis-> 100.0f, grow-> 3.0f)], 600.0f);
    assert (near(sizes, copy [200.0f, 400.0f]));
}

__test items_without_growth_keep_their_basis {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 100.0f), FlexItem(basis-> 150.0f)], 600.0f);
    assert (near(sizes, copy [100.0f, 150.0f]));
}

__test growth_factors_below_one_take_that_part_of_the_free_space {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 100.0f, grow-> 0.5f)], 300.0f);
    assert (near(sizes, copy [200.0f]));
}

__test overflow_is_shared_by_the_shrink_factors_weighted_by_the_bases {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 100.0f), FlexItem(basis-> 300.0f)], 200.0f);
    assert (near(sizes, copy [50.0f, 150.0f]));
}

__test items_without_shrink_overflow {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 100.0f, shrink-> 0.0f), FlexItem(basis-> 300.0f, shrink-> 0.0f)], 200.0f);
    assert (near(sizes, copy [100.0f, 300.0f]));
}

__test an_item_grown_to_its_max_leaves_the_rest_to_the_others {
    let sizes = resolveFlexibleLengths(copy [FlexItem(grow-> 1.0f, max-> 50.0f), FlexItem(grow-> 1.0f)], 300.0f);
    assert (near(sizes, copy [50.0f, 250.0f]));
}

__test an_item_shrunk_to_its_min_leaves_the_overflow_to_the_others {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 200.0f, min-> 150.0f), FlexItem(basis-> 200.0f)], 200.0f);
    assert (near(sizes, copy [150.0f, 50.0f]));
}

__test bases_are_clamped_to_the_bounds {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 10.0f, min-> 50.0f), FlexItem(basis-> 500.0f, max-> 100.0f)], 1000.0f);
    assert (near(sizes, copy [50.0f, 100.0f]));
}

__test the_min_wins_over_the_max {
    let sizes = resolveFlexibleLengths(copy [FlexItem(basis-> 100.0f, min-> 80.0f, max-> 40.0f)], 100.0f);
    assert (near(sizes, copy [80.0f]));
}

__test an_empty_line_has_no_size {
    let items: [FlexItem] = [];
    assert (resolveFlexibleLengths(items, 100.0f).len == 0us);
}

__test a_length_is_a_basis_shrinking_down_to_the_min_content {
    let it = item(px(120.0f), Size(Sizing::AUTO));
    assert (it.basis == 120.0f && it.min == 60.0f && it.max == f32::max);
    assert (near(resolveFlexibleLengths(copy [it], 80.0f), copy [80.0f]));
    assert (near(resolveFlexibleLengths(copy [it], 40.0f), copy [60.0f]));
}

__test a_length_below_its_min_content_does_not_grow_to_it {
    let it = item(px(30.0f), Size(Sizing::AUTO));
    assert (it.basis == 30.0f && it.min == 30.0f);
}

__test flex_none_keeps_a_length_rigid {
    let it = item(px(120.0f), Size(Sizing::AUTO), shrink-> 0.0f);
    assert (near(resolveFlexibleLengths(copy [it], 80.0f), copy [120.0f]));
}

__test an_auto_size_is_its_max_content_shrinking_down_to_its_min_content {
    let auto = Size(Sizing::AUTO);
    let it = flexItemOf(auto, auto, auto, auto, 400.0f, 10.0f, (60.0f, 200.0f), 0.0f, 1.0f);
    assert (it.basis == 210.0f && it.min == 70.0f);
}

__test a_flex_basis_replaces_the_size {
    let it = item(px(120.0f), px(0.0f), grow-> 1.0f);
    assert (it.basis == 0.0f && it.min == 60.0f && it.grow == 1.0f);

    // flex: 1 shares the free space, never below the min-content
    let other = item(Size(Sizing::AUTO), px(0.0f), grow-> 1.0f);
    assert (near(resolveFlexibleLengths(copy [it, other], 400.0f), copy [200.0f, 200.0f]));
    assert (near(resolveFlexibleLengths(copy [it, other], 100.0f), copy [60.0f, 60.0f]));
}

__test a_lower_bound_replaces_the_min_content {
    let auto = Size(Sizing::AUTO);
    let it = flexItemOf(auto, auto, px(0.0f), px(150.0f), 400.0f, 0.0f, (60.0f, 200.0f), 0.0f, 1.0f);
    assert (it.min == 0.0f && it.max == 150.0f);
    assert (near(resolveFlexibleLengths(copy [it], 400.0f), copy [150.0f]));
}

__test a_percentage_basis_is_a_part_of_the_line {
    let it = item(Size(Sizing::LENGTH, length-> Length(50.0f, unit-> Unit::PERCENT)), Size(Sizing::AUTO));
    assert (it.basis == 200.0f);
}
