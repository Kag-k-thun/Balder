in text_layout;

use balder::core::error;
use balder::interface::font::{face, layout, linebreak, shaper};

use std::algorithm::comparison;
use std::fs::path;

fn noto()-> dmut &FontFace
    throws BalderError
{
    copy FontFace::open(Path("res/fonts/noto/NotoSans-Regular.ttf"))
}

fn near(a: f32, b: f32, tolerance: f32)-> bool {
    let d = a - b;
    d <= tolerance && -d <= tolerance
}

__test one_paragraph_without_line_break {
    let p = splitParagraphs("a b");
    assert (p.len == 1us);
    assert (p[0]._0 == 0us && p[0]._1 == 3us && p[0]._2 == [2us]);
}

__test paragraphs_end_before_their_line_break {
    let p = splitParagraphs("a b \nc\r\n\nd");
    assert (p.len == 4us);
    assert (p[0]._0 == 0us && p[0]._1 == 3us && p[0]._2 == [2us]);
    assert (p[1]._0 == 5us && p[1]._1 == 6us);
    assert (p[2]._0 == 8us && p[2]._1 == 8us);
    let (start, end, breaks) = p[3];
    assert (start == 9us && end == 10us && breaks.len == 0us);
}

__test trailing_line_break_adds_no_paragraph {
    let p = splitParagraphs("a\n");
    assert (p.len == 1us);
    assert (p[0]._0 == 0us && p[0]._1 == 1us);
}

__test a_line_that_fits_is_not_wrapped {
    let dmut f = noto();
    let text = "aaa bbb ccc";
    let run = shapeLine(alias f, text, 20u32);
    assert (wrapLine(text, run, copy [4us, 8us], run.width) == [(0us, 11us)]);
    assert (wrapLine(text, run, copy [4us, 8us], f32::max) == [(0us, 11us)]);
}

__test lines_take_as_many_words_as_fit {
    let dmut f = noto();
    let text = "aaa bbb ccc";
    let run = shapeLine(alias f, text, 20u32);

    // the spaces after "bbb" hang, they do not need to fit
    let lines = wrapLine(text, run, copy [4us, 8us], run.measure(0us, 7us) + 0.5f);
    assert (lines == [(0us, 7us), (8us, 11us)]);

    let widest = max(run.measure(0us, 3us), max(run.measure(4us, 7us), run.measure(8us, 11us)));
    let narrow = wrapLine(text, run, copy [4us, 8us], widest + 0.5f);
    assert (narrow == [(0us, 3us), (4us, 7us), (8us, 11us)]);
}

__test words_wider_than_the_line_are_cut_between_graphemes {
    let dmut f = noto();
    let text = "aaa aaa aaa";
    let run = shapeLine(alias f, text, 20u32);
    let lines = wrapLine(text, run, copy [4us, 8us], run.measure(0us, 2us) + 0.1f);
    assert (lines == [(0us, 2us), (2us, 3us), (4us, 6us), (6us, 7us), (8us, 10us), (10us, 11us)]);
}

__test a_line_holds_one_grapheme_at_least {
    let dmut f = noto();
    let text = "e\u{0x301}x";
    let run = shapeLine(alias f, text, 20u32);
    assert (wrapLine(text, run, [], 0.0f) == [(0us, 3us), (3us, 4us)]);
}

__test lines_are_stacked_and_aligned {
    let dmut f = noto();
    let a = shapeLine(alias f, "a", 20u32);
    let abc = shapeLine(alias f, "abc", 20u32);

    let centered = stackLines(copy [(a, 0us, 1us), (abc, 2us, 5us)], 0.5f);
    assert (centered.lines.len == 2us);
    assert (centered.width == abc.width);
    assert (near(centered.lines[0].x, (abc.width - a.width) / 2.0f, 0.001f));
    assert (centered.lines[1].x == 0.0f);
    assert (centered.lines[0].y == 0.0f);
    assert (centered.lines[1].y == a.metrics.height);
    assert (near(centered.height, a.metrics.height + abc.getHeight(), 0.001f));

    let right = stackLines(copy [(a, 0us, 1us), (abc, 2us, 5us)], 1.0f);
    assert (near(right.lines[0].x, abc.width - a.width, 0.001f));

    let left = stackLines(copy [(a, 0us, 1us), (abc, 2us, 5us)], 0.0f);
    assert (left.lines[0].x == 0.0f);
}
