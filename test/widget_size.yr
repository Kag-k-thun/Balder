in widget_size;

use balder::interface::loader::parser;
use balder::interface::widget;
use balder::interface::widget::sizing;

/**
 * @returns: a size of a length in pixels
 * */
fn px(amount: f32)-> Size {
    Size(Sizing::LENGTH, length-> Length(amount))
}

/**
 * @returns: a size of a percentage of the container
 * */
fn percent(amount: f32)-> Size {
    Size(Sizing::LENGTH, length-> Length(amount, unit-> Unit::PERCENT))
}

// The min-content and max-content of a content box between 40 and 100 pixels
def CONTENT = (40.0f, 100.0f);

__test a_length_is_the_border_box {
    // the borders and the paddings are inside the size, the margins outside it
    assert (resolveBox(px(120.0f), 400.0f, 20.0f, CONTENT) == (120.0f)?);
}

__test a_border_box_holds_its_borders_and_paddings {
    assert (resolveBox(px(10.0f), 400.0f, 30.0f, CONTENT) == (30.0f)?);
}

__test a_percentage_is_a_part_of_the_content_box_of_the_parent {
    assert (resolveBox(percent(25.0f), 400.0f, 0.0f, CONTENT) == (100.0f)?);
    assert (Length(10.0f, unit-> Unit::PERCENT).resolve(200.0f) == 20.0f);
    assert (Length(12.0f).resolve(200.0f) == 12.0f);
}

__test a_percentage_of_an_indefinite_parent_is_auto {
    assert (!resolveBox(percent(25.0f), INDEFINITE_SIZE, 0.0f, CONTENT).hasValue);
    assert (resolveBox(px(30.0f), INDEFINITE_SIZE, 0.0f, CONTENT) == (30.0f)?);

    // a margin or a padding of an indefinite parent is 0
    assert (Length(10.0f, unit-> Unit::PERCENT).resolve(INDEFINITE_SIZE) == 0.0f);
}

__test auto_is_resolved_by_the_parent {
    assert (!resolveBox(Size(Sizing::AUTO), 400.0f, 0.0f, CONTENT).hasValue);
    assert (!needsContent(Size(Sizing::AUTO)) && !needsContent(px(12.0f)));
}

__test the_content_sizes_are_the_content_with_its_frame {
    assert (resolveBox(Size(Sizing::MIN_CONTENT), 400.0f, 10.0f, CONTENT) == (50.0f)?);
    assert (resolveBox(Size(Sizing::MAX_CONTENT), 400.0f, 10.0f, CONTENT) == (110.0f)?);
    assert (needsContent(Size(Sizing::MIN_CONTENT)) && needsContent(Size(Sizing::MAX_CONTENT)));
}

/**
 * (space of the margin box, border box of an auto size fitted to its content, its margins being 8 and its frame 10)
 * */
@parameters ((yield c for c in [(200.0f, 110.0f),           // as large as its content
                                (60.0f, 52.0f),             // its lines wrapped to the space
                                (10.0f, 50.0f),             // never narrower than its min-content
                                (INDEFINITE_SIZE, 110.0f)])) // its max-content in an indefinite space
__test an_auto_size_fits_the_content_in_the_space (space: f32, expected: f32) {
    assert (autoBox(space, 8.0f, 10.0f, CONTENT, stretch-> false) == expected);
}

__test a_stretched_auto_size_fills_the_space_less_its_margins {
    assert (autoBox(200.0f, 8.0f, 10.0f, CONTENT, stretch-> true) == 192.0f);
    assert (autoBox(12.0f, 8.0f, 10.0f, CONTENT, stretch-> true) == 10.0f);
}

__test the_bounds_are_sizes {
    assert (boundsOf(px(80.0f), percent(50.0f), 400.0f, 0.0f, CONTENT) == (80.0f, 200.0f));
    assert (boundsOf(Size(Sizing::MIN_CONTENT), Size(Sizing::MAX_CONTENT), 400.0f, 2.0f, CONTENT) == (42.0f, 102.0f));
}

__test auto_bounds_are_the_automatic_minimum_and_no_maximum {
    let auto = Size(Sizing::AUTO);
    assert (boundsOf(auto, auto, 400.0f, 10.0f, CONTENT, automatic-> 50.0f) == (50.0f, f32::max));

    // a border box is never smaller than its borders and paddings
    assert (boundsOf(auto, auto, 400.0f, 30.0f, CONTENT, automatic-> 10.0f)._0 == 30.0f);
}

__test the_lower_bound_wins_over_the_upper_one {
    assert (clampBox(100.0f, (80.0f, 40.0f)) == 80.0f);
    assert (clampBox(100.0f, (20.0f, 40.0f)) == 40.0f);
    assert (clampBox(10.0f, (20.0f, 40.0f)) == 20.0f);
}

__test the_automatic_minimum_is_the_min_content_capped_by_the_size {
    assert (automaticMin((120.0f)?, 60.0f) == 60.0f);
    assert (automaticMin((40.0f)?, 60.0f) == 40.0f);
    assert (automaticMin(none, 60.0f) == 60.0f);
}
