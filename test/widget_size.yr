in widget_size;

use balder::interface::widget::alignement;

__test relative_sizes_are_parts_of_the_parent {
    assert (WidgetSize(relative-> 0.5f).resolve(200.0f) == 100.0f);
    assert (WidgetSize(pix-> 30u32).resolve(200.0f) == 30.0f);
    assert (WidgetSize(relative-> 0.5f, minPix-> 120u32).resolve(200.0f) == 120.0f);
    assert (WidgetSize(relative-> 0.5f, maxPix-> 80u32).resolve(200.0f) == 80.0f);
}

__test relative_sizes_ignore_the_content {
    assert (WidgetSize(relative-> 0.5f).resolve(200.0f, minContent-> 150.0f, maxContent-> 300.0f) == 100.0f);
}

/**
 * (size of the parent, size of an auto widget whose content is between 40 and 100 pixels)
 * */
@parameters ((yield c for c in [(200.0f, 100.0f),  // as wide as its content
                                (60.0f, 60.0f),    // its lines wrapped to the parent
                                (10.0f, 40.0f)]))  // never narrower than its widest word
__test auto_sizes_fit_the_content_in_the_parent (parent: f32, expected: f32) {
    let size = WidgetSize(kind-> SizeKind::AUTO);
    assert (size.resolve(parent, minContent-> 40.0f, maxContent-> 100.0f) == expected);
}

__test content_sizes_ignore_the_parent {
    let minSize = WidgetSize(kind-> SizeKind::MIN_CONTENT);
    let maxSize = WidgetSize(kind-> SizeKind::MAX_CONTENT);
    for parent in [10.0f, 200.0f] {
        assert (minSize.resolve(parent, minContent-> 40.0f, maxContent-> 100.0f) == 40.0f);
        assert (maxSize.resolve(parent, minContent-> 40.0f, maxContent-> 100.0f) == 100.0f);
    }
}

__test content_sizes_are_clamped_to_their_bounds {
    let size = WidgetSize(kind-> SizeKind::MAX_CONTENT, minPix-> 20u32, maxPix-> 50u32);
    assert (size.resolve(200.0f, minContent-> 40.0f, maxContent-> 100.0f) == 50.0f);
    assert (size.resolve(200.0f, minContent-> 5.0f, maxContent-> 10.0f) == 20.0f);
}

__test relative_sizes_contribute_their_content_to_a_parent_sized_to_its_content {
    assert (WidgetSize(relative-> 1.0f).contribute(40.0f, 100.0f) == (40.0f, 100.0f));
    assert (WidgetSize(pix-> 30u32).contribute(40.0f, 100.0f) == (30.0f, 30.0f));
    assert (WidgetSize(kind-> SizeKind::AUTO).contribute(40.0f, 100.0f) == (40.0f, 100.0f));
    assert (WidgetSize(kind-> SizeKind::MIN_CONTENT).contribute(40.0f, 100.0f) == (40.0f, 40.0f));
    assert (WidgetSize(kind-> SizeKind::MAX_CONTENT).contribute(40.0f, 100.0f) == (100.0f, 100.0f));
}

__test the_kind_tells_the_sizes_apart {
    assert (!WidgetSize(relative-> 1.0f).isContent());
    assert (WidgetSize(kind-> SizeKind::AUTO).isContent());
    assert (WidgetSize(kind-> SizeKind::AUTO) != WidgetSize(kind-> SizeKind::MAX_CONTENT));
    assert (WidgetSize(kind-> SizeKind::AUTO) == WidgetSize(kind-> SizeKind::AUTO));
}
