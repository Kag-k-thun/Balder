in rigid_transform;

use balder::math::{inertia, quaternion, rigid_transform, utils, vector};

use std::math;

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3)-> bool {
    (a - b).length() < 0.0001f
}

__test a_rigid_transform_moves_a_point_as_its_matrix {
    let t = RigidTransform(position-> makeVec3(1.0f, -2.0f, 3.0f),
                           rotation-> Quaternion::fromAxisAngle(0.8f, makeVec3(1.0f, 1.0f, 0.0f)));
    let p = makeVec3(0.5f, 4.0f, -1.0f);
    assert(near(t.transformPoint(p), (t.matrix() * makeVec4(p, 1.0f)).xyz));
    assert(near(t.transformDirection(p), (t.matrix() * makeVec4(p, 0.0f)).xyz));
}

__test a_rigid_transform_after_its_inverse_is_the_identity {
    let t = RigidTransform(position-> makeVec3(1.0f, -2.0f, 3.0f),
                           rotation-> Quaternion::fromAxisAngle(0.8f, makeVec3(1.0f, 1.0f, 0.0f)));
    let p = makeVec3(0.5f, 4.0f, -1.0f);
    assert(near(t.inversed().transformPoint(t.transformPoint(p)), p));
    assert(near((t * t.inversed()).position, vec3()));
}

__test the_rigid_part_of_a_scaled_transformation_drops_its_scale {
    let q = Quaternion::fromAxisAngle(0.6f, makeVec3(0.0f, 1.0f, 0.0f));
    let m = translation(makeVec3(4.0f, 0.0f, 1.0f)) * q.matrix() * scaling(makeVec3(2.0f, 3.0f, 0.5f));
    let t = RigidTransform(m);
    assert(near(t.position, makeVec3(4.0f, 0.0f, 1.0f)));
    assert(abs(abs(t.rotation.dot(q)) - 1.0f) < 0.0001f);
}

__test the_inertia_of_a_cube_is_a_sixth_of_its_mass_times_its_side_squared {
    // 3 kg, sides of 2: 3 * 4 / 6
    assert(near(boxInertia(3.0f, makeVec3(2.0f, 2.0f, 2.0f)), makeVec3(2.0f, 2.0f, 2.0f)));
}

__test a_capsule_without_a_cylinder_has_the_inertia_of_its_sphere {
    assert(near(capsuleInertia(5.0f, 0.5f, 1.0f), sphereInertia(5.0f, 0.5f)));
}

__test a_long_capsule_turns_like_its_cylinder {
    // the caps weigh little next to a cylinder fifty radii long
    let c = capsuleInertia(1.0f, 0.1f, 10.0f);
    let k = cylinderInertia(1.0f, 0.1f, 10.0f);
    assert(abs(c.x - k.x) / k.x < 0.05f);
}

__test the_world_inertia_of_a_turned_body_turns_with_it {
    let inverse = inverseMoments(boxInertia(1.0f, makeVec3(1.0f, 2.0f, 4.0f)));
    let quarter = Quaternion::fromAxisAngle(1.5707963f, makeVec3(0.0f, 0.0f, 1.0f));
    let w = worldInverseInertia(quarter, inverse);

    // a quarter turn about Z swaps the moments of X and Y
    assert(abs(w.a1 - inverse.y) < 0.0001f && abs(w.b2 - inverse.x) < 0.0001f && abs(w.c3 - inverse.z) < 0.0001f);
    assert(near(inverseMoments(vec3()), vec3()));
}
