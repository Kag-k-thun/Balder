in frame_ranges;

use balder::core::memory::in_flight;

__test clean_until_marked {
    let dmut ranges = FrameRanges(3u32);
    for f in 0u32 .. 3u32 {
        assert (ranges.isClean(f));
        assert (!ranges:.take(f).hasValue);
    }
}

__test mark_reaches_every_frame {
    let dmut ranges = FrameRanges(3u32);
    ranges:.mark(8us, 16us);

    for f in 0u32 .. 3u32 {
        if let Ok((start, end)) = ranges:.take(f) {
            assert (start == 8us && end == 16us);
        } else {
            assert (false);
        }

        assert (ranges.isClean(f));
    }
}

__test marks_merge_into_one_range {
    let dmut ranges = FrameRanges(2u32);
    ranges:.mark(40us, 60us);
    ranges:.mark(8us, 16us);

    if let Ok((start, end)) = ranges:.take(1u32) {
        assert (start == 8us && end == 60us);
    } else {
        assert (false);
    }
}

__test a_frame_taken_waits_for_the_next_mark {
    let dmut ranges = FrameRanges(2u32);
    ranges:.mark(0us, 4us);
    ranges:.take(0u32);
    ranges:.mark(20us, 24us);

    // frame 0 was written, it only has the second mark to write; frame 1 has both
    if let Ok((start, end)) = ranges:.take(0u32) {
        assert (start == 20us && end == 24us);
    } else {
        assert (false);
    }

    if let Ok((start, end)) = ranges:.take(1u32) {
        assert (start == 0us && end == 24us);
    } else {
        assert (false);
    }
}

__test mark_frame_reaches_that_frame_only {
    let dmut ranges = FrameRanges(2u32);
    ranges:.markFrame(1u32, 20us, 40us);

    assert (ranges.isClean(0u32));
    assert (!ranges.isClean(1u32));
}

__test empty_mark_is_ignored {
    let dmut ranges = FrameRanges(1u32);
    ranges:.mark(10us, 10us);
    assert (ranges.isClean(0u32));
}
