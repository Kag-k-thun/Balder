in quaternions;

use balder::math::{matrix, quaternion, utils, vector};

use std::math;

/**
 * @returns: true iif two matrices are equal, give or take the rounding errors
 * */
fn near(a: mat4, b: mat4)-> bool {
    let d = a - b;
    let cols = [makeVec4(d.a1, d.b1, d.c1, d.d1), makeVec4(d.a2, d.b2, d.c2, d.d2),
                makeVec4(d.a3, d.b3, d.c3, d.d3), makeVec4(d.a4, d.b4, d.c4, d.d4)];
    for c in cols {
        if c.length() > 0.0001f { return false; }
    }

    true
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3)-> bool {
    (a - b).length() < 0.0001f
}

/**
 * @returns: true iif two quaternions are the same rotation, a quaternion and its opposite giving the same one
 * */
fn sameRotation(a: Quaternion, b: Quaternion)-> bool {
    abs(a.dot(b)) > 0.99999f
}

__test the_rotation_of_an_axis_and_an_angle_turns_as_its_matrix {
    let axis = makeVec3(1.0f, -2.0f, 0.5f);
    let q = Quaternion::fromAxisAngle(1.2f, axis);
    assert (near(q.matrix(), rotation(1.2f, axis)));
    assert (abs(q.length() - 1.0f) < 0.0001f);

    let v = makeVec3(0.3f, 4.0f, -1.0f);
    assert (near(q * v, (rotation(1.2f, axis) * makeVec4(v, 0.0f)).xyz));

    // the identity turns nothing
    assert (near(Quaternion().matrix(), mat4()));
    assert (near(Quaternion() * v, v));
}

__test the_product_turns_by_the_right_then_by_the_left {
    let a = Quaternion::fromAxisAngle(0.7f, makeVec3(0.0f, 1.0f, 0.0f));
    let b = Quaternion::fromAxisAngle(-1.9f, makeVec3(1.0f, 1.0f, 0.0f));
    assert (near((a * b).matrix(), a.matrix() * b.matrix()));
    assert (sameRotation(a.conjugate() * a, Quaternion()));
}

__test the_rotation_of_a_matrix_gives_the_quaternion_back {
    // the four branches: w, x, y and z the largest
    let samples = [Quaternion::fromAxisAngle(0.4f, makeVec3(1.0f, 2.0f, 3.0f)),
                   Quaternion::fromAxisAngle(3.0f, makeVec3(1.0f, 0.1f, 0.2f)),
                   Quaternion::fromAxisAngle(3.0f, makeVec3(0.1f, 1.0f, -0.2f)),
                   Quaternion::fromAxisAngle(-3.1f, makeVec3(0.2f, 0.1f, 1.0f)),
                   Quaternion::fromAxisAngle(3.14159265f, makeVec3(0.0f, 0.0f, 1.0f))];
    for q in samples {
        let back = Quaternion::fromRotation(q.matrix());
        assert (sameRotation(back, q));
        assert (back.w >= 0.0f);
        assert (near(back.matrix(), q.matrix()));
    }
}

__test the_spherical_interpolation_turns_at_a_constant_speed {
    let up = makeVec3(0.0f, 1.0f, 0.0f);
    let from = Quaternion();
    let to = Quaternion::fromAxisAngle(1.6f, up);

    assert (sameRotation(from.slerp(to, 0.0f), from));
    assert (sameRotation(from.slerp(to, 1.0f), to));
    assert (sameRotation(from.slerp(to, 0.5f), Quaternion::fromAxisAngle(0.8f, up)));
    assert (sameRotation(from.slerp(to, 0.25f), Quaternion::fromAxisAngle(0.4f, up)));

    // the normalized linear interpolation meets it halfway, not at a quarter
    assert (sameRotation(from.nlerp(to, 0.5f), from.slerp(to, 0.5f)));
    assert (!sameRotation(from.nlerp(to, 0.25f), from.slerp(to, 0.25f)));
}

__test the_interpolations_take_the_shortest_path {
    let up = makeVec3(0.0f, 1.0f, 0.0f);
    let from = Quaternion::fromAxisAngle(0.2f, up);
    let to = Quaternion::fromAxisAngle(0.6f, up);
    let opposite = Quaternion(x-> -to.x, y-> -to.y, z-> -to.z, w-> -to.w);

    // the opposite of a quaternion is the same rotation, reached the same way
    assert (sameRotation(from.slerp(opposite, 0.5f), Quaternion::fromAxisAngle(0.4f, up)));
    assert (sameRotation(from.nlerp(opposite, 0.5f), Quaternion::fromAxisAngle(0.4f, up)));

    // two rotations too close for a sine to divide are interpolated linearly
    let close = Quaternion::fromAxisAngle(0.2001f, up);
    assert (sameRotation(from.slerp(close, 0.5f), Quaternion::fromAxisAngle(0.20005f, up)));
}
