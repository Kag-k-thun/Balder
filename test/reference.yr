in reference;

use balder::interface::loader;
use balder::interface::loader::registry;
use balder::interface::loader::registry::reference;

__test the_reference_of_doc_gui_is_up_to_date {
    // when it fails, `gyllir run reference` in tools/ writes the reference again from the code
    let doc = readFile("doc/gui.md");
    if let Ok(generated) = generatedPart(doc) {
        assert (generated == reference(WidgetRegistry()));
    } else {
        assert (false);
    }
}

__test the_reference_replaces_what_follows_the_marker {
    let doc = "# Title\n\nWritten by hand.\n\n" ~ MARKER ~ "\n\nThe old reference\n";
    assert (splice(doc, "The new one\n") == "# Title\n\nWritten by hand.\n\n" ~ MARKER ~ "\n\nThe new one\n");
    assert (generatedPart(doc) == ("The old reference\n")?);

    // a document without a marker gets one
    assert (splice("# Title\n", "Generated\n") == "# Title\n\n" ~ MARKER ~ "\n\nGenerated\n");
    assert (!generatedPart("# Title\n").hasValue);
}
