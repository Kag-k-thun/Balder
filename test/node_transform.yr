in node_transform;

use balder::math::{matrix, utils, vector};
use balder::scene::_;
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{group, transform};

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3)-> bool {
    (a - b).length() < 0.0001f
}

/**
 * @returns: true iif two matrices are equal, give or take the rounding errors
 * */
fn near(a: mat4, b: mat4)-> bool {
    let d = a - b;
    let cols = [makeVec4(d.a1, d.b1, d.c1, d.d1), makeVec4(d.a2, d.b2, d.c2, d.d2),
                makeVec4(d.a3, d.b3, d.c3, d.d3), makeVec4(d.a4, d.b4, d.c4, d.d4)];
    for c in cols {
        if c.length() > 0.0001f { return false; }
    }

    true
}

__test the_transform_of_a_transformation_composes_it_back {
    let samples = [NodeTransform(makeVec3(1.0f, -2.0f, 3.0f), makeVec3(0.3f, -0.7f, 1.1f), makeVec3(2.0f, 0.5f, 3.0f)),
                   NodeTransform(vec3(), vec3(), makeVec3(1.0f, 1.0f, 1.0f)),
                   NodeTransform(makeVec3(0.0f, 4.0f, 0.0f), makeVec3(-2.9f, 1.2f, 0.4f), makeVec3(1.0f, 1.0f, 1.0f))];
    for t in samples {
        let local = translation(t.position) * eulerRotation(t.rotation) * scaling(t.scale);
        let back = NodeTransform(local);
        assert (near(back.position, t.position) && near(back.rotation, t.rotation) && near(back.scale, t.scale));
    }
}

__test a_transformation_mirroring_the_space_scales_its_x_axis_by_a_negative_factor {
    let local = scaling(makeVec3(-2.0f, 1.0f, 1.0f));
    let t = NodeTransform(local);
    assert (near(t.scale, makeVec3(-2.0f, 1.0f, 1.0f)) && near(t.rotation, vec3()));
}

__test a_node_keeps_its_transformation_in_the_world_under_a_new_parent {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut group = copy Group3D("group", alias root);
    group:.setTransform(makeVec3(1.0f, 2.0f, 3.0f), makeVec3(0.2f, 0.5f, -0.4f), makeVec3(2.0f, 2.0f, 2.0f));
    a:.setTransform(makeVec3(-1.0f, 1.0f, 4.0f), makeVec3(0.1f, -0.3f, 0.6f), makeVec3(1.0f, 3.0f, 1.0f));

    let world = a.transformation;
    assert (a:.moveUnder(alias group, at-> LAST_PLACE));
    NodeTransform::inParent(world, a.parentTransformation).applyTo(alias a);
    assert (near(a.transformation, world));
}
