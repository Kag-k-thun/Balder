in scene_selection;

use balder::core::application::signal;
use balder::scene::{_, node::_, node::node3D, selection};

use ::sdl3::keycode;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * A 3D node with no volume, to select
 * */
class Item over Node3D {

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * Counts the emissions of a signal
 * */
class Counter {

    pub let mut count: usize = 0us;

    pub self () {}

    pub fn onChanged(mut self) {
        self.count += 1us;
    }

}

/**
 * @returns: the uniq ids of the selected nodes, in the order they were selected
 * */
fn selected(s: &Selection)-> [usize] {
    let mut result: [usize] = [];
    for n in s.nodes {
        result ~= [n.uid];
    }

    result
}

__test a_click_selects_the_node_alone {
    let dmut root = copy Root();
    let dmut a = copy Item("a", alias root);
    let dmut b = copy Item("b", alias root);

    let dmut s = copy Selection();
    assert (s:.click((alias a)?, SDL_KMOD_NONE));
    assert (s:.click((alias b)?, SDL_KMOD_NONE));
    assert (selected(s) == copy [b.uid]);
    assert (s.contains(b) && !s.contains(a));

    // clicking the node selected alone changes nothing
    assert (!s:.click((alias b)?, SDL_KMOD_NONE) && s.len == 1us);
}

__test ctrl_toggles_the_node_clicked {
    let dmut root = copy Root();
    let dmut a = copy Item("a", alias root);
    let dmut b = copy Item("b", alias root);
    let dmut c = copy Item("c", alias root);

    let dmut s = copy Selection();
    s:.click((alias a)?, SDL_KMOD_NONE);
    assert (s:.click((alias c)?, SDL_KMOD_CTRL));
    assert (s:.click((alias b)?, SDL_KMOD_LCTRL));
    assert (selected(s) == copy [a.uid, c.uid, b.uid]);

    assert (s:.click((alias c)?, SDL_KMOD_CTRL));
    assert (selected(s) == copy [a.uid, b.uid]);

    // Command toggles as Ctrl does
    assert (s:.click((alias a)?, SDL_KMOD_GUI) && selected(s) == copy [b.uid]);
}

__test a_click_on_no_node_clears_the_selection_unless_ctrl_is_held {
    let dmut root = copy Root();
    let dmut a = copy Item("a", alias root);
    let dmut b = copy Item("b", alias root);

    let dmut s = copy Selection();
    s:.click((alias a)?, SDL_KMOD_NONE);
    s:.click((alias b)?, SDL_KMOD_CTRL);

    assert (!s:.click(none, SDL_KMOD_CTRL) && s.len == 2us);
    assert (s:.click(none, SDL_KMOD_NONE) && s.len == 0us);
    assert (!s:.click(none, SDL_KMOD_NONE));
}

__test a_node_removed_leaves_the_selection {
    let dmut root = copy Root();
    let dmut a = copy Item("a", alias root);
    let dmut b = copy Item("b", alias root);
    let dmut c = copy Item("c", alias root);

    let dmut s = copy Selection();
    s:.add(alias a);
    s:.add(alias b);
    s:.add(alias c);

    assert (!s:.add(alias b) && s.len == 3us);
    assert (s:.remove(b) && selected(s) == copy [a.uid, c.uid]);
    assert (!s:.remove(b));
}

__test changed_is_emitted_when_the_selection_changes_only {
    let dmut root = copy Root();
    let dmut a = copy Item("a", alias root);
    let dmut b = copy Item("b", alias root);

    let dmut box = copy SlotEmitter();
    let dmut counter = copy Counter();
    let dmut s = copy Selection();
    s:.changed():.connect(alias box, &counter:.onChanged);

    s:.select(alias a);
    s:.select(alias a);
    s:.toggle(alias b);
    s:.remove(a);
    s:.remove(a);
    s:.clear();
    s:.clear();

    box:.emit();
    assert (counter.count == 4us);
}
