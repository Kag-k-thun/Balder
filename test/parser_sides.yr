in parser_sides;

use balder::interface::loader::parser;

use std::syntax::errors;

/**
 * @returns: the values of a content
 * */
fn read(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @params:
 *    - kind: the kind the content is decoded as
 * @returns: true iif the decoding of a content throws a syntax error
 * */
fn rejects(content: [c8], kind: [c8])-> bool {
    {
        let v = read(content);
        match kind {
            "sides" => { Sides(v); }
            _       => { Length(Sides(v).top); }
        }

        false
    } catch {
        _: &SyntaxError => { true }
    }
}

/**
 * (shorthand, top, right, bottom, left)
 * */
@parameters ((yield c for c in [("6", ("6", "6", "6", "6")),
                                ("6 14", ("6", "14", "6", "14")),
                                ("1 2 3", ("1", "2", "3", "2")),
                                ("1 2 3 4", ("1", "2", "3", "4"))]))
__test sides_follow_the_css_order (content: [c8], expected: ([c8], [c8], [c8], [c8])) {
    let s = Sides(read(content));
    assert (s.top.getSource() == expected._0 && s.right.getSource() == expected._1);
    assert (s.bottom.getSource() == expected._2 && s.left.getSource() == expected._3);
}

__test sides_take_one_to_four_values {
    assert (rejects("1 2 3 4 5", "sides"));
    assert (!rejects("1, 2", "sides"));
    assert (rejects("1, 2", "margin"));
    assert (!rejects("1 2", "margin"));
}
