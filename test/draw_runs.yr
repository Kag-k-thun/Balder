in draw_runs;

use balder::interface::{drawer, shape};

use ::vulkan::core;

fn draw(kind: ShapeKind, key: usize)-> ShapeDraw {
    ShapeDraw(kind, key, VkDrawIndexedIndirectCommand())
}

__test no_draw_no_run {
    assert (splitRuns([]).len == 0us);
}

__test consecutive_draws_share_a_run {
    let runs = splitRuns(copy [draw(ShapeKind::COLOR, 0us), draw(ShapeKind::COLOR, 0us), draw(ShapeKind::COLOR, 0us)]);
    assert (runs.len == 1us);
    assert (runs[0].first == 0u32 && runs[0].count == 3u32);
}

__test runs_keep_the_drawing_order {
    // color, then text of page 0 twice, then color again: the second color run is not merged with the first one
    let runs = splitRuns(copy [draw(ShapeKind::COLOR, 0us),
                               draw(ShapeKind::TEXT, 0us),
                               draw(ShapeKind::TEXT, 0us),
                               draw(ShapeKind::COLOR, 0us)]);

    assert (runs.len == 3us);
    assert (runs[0].kind == ShapeKind::COLOR && runs[0].first == 0u32 && runs[0].count == 1u32);
    assert (runs[1].kind == ShapeKind::TEXT && runs[1].first == 1u32 && runs[1].count == 2u32);
    assert (runs[2].kind == ShapeKind::COLOR && runs[2].first == 3u32 && runs[2].count == 1u32);
}

__test a_descriptor_set_change_splits_a_run {
    // two pages of the atlas, two textures: same pipeline, another descriptor set
    let runs = splitRuns(copy [draw(ShapeKind::TEXT, 0us),
                               draw(ShapeKind::TEXT, 1us),
                               draw(ShapeKind::TEXTURE, 7us),
                               draw(ShapeKind::TEXTURE, 8us)]);

    assert (runs.len == 4us);
    for i, r in runs {
        assert (r.first == cast!u32(i) && r.count == 1u32);
    }
}
