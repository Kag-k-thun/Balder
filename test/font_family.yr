in font_family;

use balder::interface::font::family;

fn face(weight: u32, style: FontStyle, width: u32 = FONT_WIDTH_NORMAL)-> FaceInfo {
    let s = match style {
        FontStyle::ITALIC  => { "italic" }
        FontStyle::OBLIQUE => { "oblique" }
        _                  => { "normal" }
    };

    FaceInfo("Family", std::format::format("{}-{}-{}.ttf", weight, s, width), 0i64, weight, style, width)
}

/**
 * The faces of a family with every weight of a multiple of 100, upright
 * */
fn weights(ws: [u32])-> [FaceInfo] {
    copy [face(w, FontStyle::NORMAL) for w in ws]
}

__test empty_family_has_no_match {
    assert (!matchFace([], 400u32, FontStyle::NORMAL).hasValue);
}

/**
 * (weights of the family, requested weight, weight of the match)
 * */
@parameters ((yield c for c in [(copy [300u32, 400u32, 700u32], 400u32, 400u32),
                                (copy [300u32, 500u32, 700u32], 400u32, 500u32), // 400 tries up to 500 first
                                (copy [300u32, 600u32], 400u32, 300u32),         // then the lighter weights
                                (copy [600u32, 700u32], 400u32, 600u32),         // then the heavier ones
                                (copy [400u32, 600u32], 500u32, 400u32),
                                (copy [100u32, 200u32, 400u32], 300u32, 200u32), // under 400 tries the lighter weights first
                                (copy [400u32, 500u32], 300u32, 400u32),
                                (copy [400u32, 700u32, 900u32], 600u32, 700u32), // over 500 tries the heavier weights first
                                (copy [400u32, 500u32], 800u32, 500u32),
                                (copy [700u32], 100u32, 700u32)]))
__test closest_weight (ws: [u32], requested: u32, expected: u32) {
    if let Ok(m) = matchFace(weights(ws), requested, FontStyle::NORMAL) {
        assert (m.face.weight == expected);
    } else {
        assert (false);
    }
}

/**
 * (styles of the family, requested style, style of the match)
 * */
@parameters ((yield c for c in [(copy [FontStyle::NORMAL, FontStyle::ITALIC, FontStyle::OBLIQUE], FontStyle::ITALIC, FontStyle::ITALIC),
                                (copy [FontStyle::NORMAL, FontStyle::OBLIQUE], FontStyle::ITALIC, FontStyle::OBLIQUE),
                                (copy [FontStyle::NORMAL, FontStyle::ITALIC], FontStyle::OBLIQUE, FontStyle::ITALIC),
                                (copy [FontStyle::ITALIC, FontStyle::OBLIQUE], FontStyle::NORMAL, FontStyle::OBLIQUE),
                                (copy [FontStyle::ITALIC], FontStyle::NORMAL, FontStyle::ITALIC),
                                (copy [FontStyle::NORMAL], FontStyle::ITALIC, FontStyle::NORMAL)]))
__test closest_style (styles: [FontStyle], requested: FontStyle, expected: FontStyle) {
    let faces = copy [face(400u32, s) for s in styles];
    if let Ok(m) = matchFace(faces, 400u32, requested) {
        assert (m.face.style == expected);
    } else {
        assert (false);
    }
}

__test style_before_weight {
    let faces = copy [face(700u32, FontStyle::NORMAL), face(300u32, FontStyle::ITALIC)];
    if let Ok(m) = matchFace(faces, 700u32, FontStyle::ITALIC) {
        assert (m.face.style == FontStyle::ITALIC && m.face.weight == 300u32);
        assert (m.syntheticBold);
        assert (!m.syntheticOblique);
    } else {
        assert (false);
    }
}

__test normal_width_before_style {
    let faces = copy [face(400u32, FontStyle::ITALIC, width-> 3u32), face(400u32, FontStyle::NORMAL)];
    if let Ok(m) = matchFace(faces, 400u32, FontStyle::ITALIC) {
        assert (m.face.width == FONT_WIDTH_NORMAL);
        assert (m.syntheticOblique);
    } else {
        assert (false);
    }
}

/**
 * (weight of the only face, requested weight, true if the face is emboldened)
 * */
@parameters ((yield c for c in [(400u32, 700u32, true), (500u32, 600u32, true), (400u32, 500u32, false),
                                (600u32, 900u32, false), (700u32, 700u32, false), (700u32, 400u32, false)]))
__test synthetic_bold (actual: u32, requested: u32, synthetic: bool) {
    if let Ok(m) = matchFace(weights(copy [actual]), requested, FontStyle::NORMAL) {
        assert (m.syntheticBold == synthetic);
        assert (!m.syntheticOblique);
    } else {
        assert (false);
    }
}

/**
 * (style of the only face, requested style, true if the face is slanted)
 * */
@parameters ((yield c for c in [(FontStyle::NORMAL, FontStyle::ITALIC, true), (FontStyle::NORMAL, FontStyle::OBLIQUE, true),
                                (FontStyle::ITALIC, FontStyle::OBLIQUE, false), (FontStyle::NORMAL, FontStyle::NORMAL, false),
                                (FontStyle::ITALIC, FontStyle::NORMAL, false)]))
__test synthetic_oblique (actual: FontStyle, requested: FontStyle, synthetic: bool) {
    if let Ok(m) = matchFace(copy [face(400u32, actual)], 400u32, requested) {
        assert (m.syntheticOblique == synthetic);
    } else {
        assert (false);
    }
}

/**
 * (style name, weight)
 * */
@parameters ((yield c for c in [("Regular", 400u32), ("Book", 400u32), ("Thin", 100u32), ("ExtraLight", 200u32),
                                ("Light Italic", 300u32), ("Medium", 500u32), ("SemiBold", 600u32), ("Demi Bold", 600u32),
                                ("Bold", 700u32), ("Bold Oblique", 700u32), ("ExtraBold", 800u32), ("Black", 900u32)]))
__test weight_of_style_name (name: [c8], weight: u32) {
    assert (weightOfStyleName(name) == weight);
}

__test oblique_style_name {
    assert (isObliqueStyleName("Bold Oblique"));
    assert (!isObliqueStyleName("Italic"));
}

__test family_keys_ignore_case {
    assert (familyKey("Noto Sans") == familyKey("noto SANS"));
    assert (familyKey("Noto Sans") != familyKey("Noto Serif"));
}

__test closest_then_regular_faces {
    let faces = copy [face(400u32, FontStyle::NORMAL), face(700u32, FontStyle::ITALIC), face(300u32, FontStyle::NORMAL)];
    let all = matchFaces(faces, 700u32, FontStyle::ITALIC);
    assert (all.len == 2us);
    assert (all[0].face.weight == 700u32 && all[0].face.style == FontStyle::ITALIC);
    assert (!all[0].syntheticBold && !all[0].syntheticOblique);
    assert (all[1].face.weight == 400u32 && all[1].face.style == FontStyle::NORMAL);
    assert (all[1].syntheticBold && all[1].syntheticOblique);
}

__test regular_face_is_not_repeated {
    let faces = copy [face(400u32, FontStyle::NORMAL), face(700u32, FontStyle::NORMAL)];
    assert (matchFaces(faces, 400u32, FontStyle::NORMAL).len == 1us);
    assert (matchFaces(faces, 700u32, FontStyle::NORMAL).len == 2us);
    assert (matchFaces([], 400u32, FontStyle::NORMAL).len == 0us);
}
