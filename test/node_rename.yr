in node_rename;

use balder::scene::_;
use balder::scene::node;
use balder::scene::node::node3D::group;

use std::fs::path;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

__test a_renamed_node_is_found_under_its_new_name {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);

    assert (a:.rename("b"));
    assert (a.name.file() == "b");
    assert (root:.find(Path("b")).hasValue);
    assert (!root:.find(Path("a")).hasValue);
}

__test the_nodes_under_a_renamed_node_follow_its_path {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut b = copy Group3D("b", alias a);
    let dmut c = copy Group3D("c", alias b);

    assert (a:.rename("z"));
    assert (b.name == Path("z/b") && c.name == Path("z/b/c"));
    assert (root:.find(Path("z/b/c")).hasValue);
}

__test a_node_keeps_its_name_when_a_sibling_has_the_new_one {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);
    let dmut _b_ = copy Group3D("b", alias root);

    assert (!a:.rename("b"));
    assert (a.name.file() == "a");
    assert (root:.getChilds().len == 2us);
}

__test a_node_keeps_its_name_when_the_new_one_is_not_valid {
    let dmut root = copy Root();
    let dmut a = copy Group3D("a", alias root);

    assert (!a:.rename(""));
    assert (!a:.rename("x/y"));
    assert (a.name.file() == "a");

    // the name it has already is kept
    assert (a:.rename("a"));
}

__test a_name_is_valid_when_not_empty_and_without_a_separator {
    assert (isValidName("cube_2"));
    assert (!isValidName(""));
    assert (!isValidName("a/b"));
}
