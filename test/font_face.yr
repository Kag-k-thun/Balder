in font_face;

use balder::core::error;
use balder::interface::font::{face, family, shaper};

use std::fs::path;

fn noto()-> dmut &FontFace
    throws BalderError
{
    copy FontFace::open(Path("res/fonts/noto/NotoSans-Regular.ttf"))
}

fn inked(bmp: GlyphBitmap)-> usize {
    let mut n = 0us;
    for p in bmp.pixels {
        if p > 128u8 { n += 1us; }
    }

    n
}

/**
 * (character, pixel size)
 * */
@parameters ((yield c for c in [('A'c32, 12u32), ('A'c32, 32u32), ('A'c32, 64u32),
                                ('g'c32, 16u32), ('W'c32, 24u32), ('.'c32, 32u32)]))
__test rasterize (c: c32, size: u32) {
    let dmut f = noto();
    let glyph = f:.getGlyphIndex(c);
    assert (glyph != 0u32);

    let bmp = f:.rasterize(glyph, size, 0u8);
    assert (bmp.width > 0u32 && bmp.height > 0u32);
    assert (bmp.width <= 2u32 * size && bmp.height <= 2u32 * size);
    assert (bmp.pixels.len == cast!usize(bmp.width * bmp.height));
    assert (inked(bmp) > 0us);
}

/**
 * (subpixel offset, true if the coverage differs from the one at offset 0)
 * */
@parameters ((yield c for c in [(1u8, true), (2u8, true), (3u8, true), (4u8, false)]))
__test subpixel_offset (subpixel: u8, differs: bool) {
    let dmut f = noto();
    let glyph = f:.getGlyphIndex('l'c32);

    let base = f:.rasterize(glyph, 32u32, 0u8);
    let moved = f:.rasterize(glyph, 32u32, subpixel);
    let same = base.left == moved.left && base.width == moved.width && base.pixels == moved.pixels;
    assert (same != differs);
}

__test descender_below_baseline {
    let dmut f = noto();
    let bmp = f:.rasterize(f:.getGlyphIndex('g'c32), 32u32, 0u8);
    assert (bmp.top > 0 && cast!i32(bmp.height) > bmp.top);
}

__test space_has_no_bitmap {
    let dmut f = noto();
    let bmp = f:.rasterize(f:.getGlyphIndex(' 'c32), 32u32, 0u8);
    assert (bmp.width == 0u32 || bmp.height == 0u32);
    assert (bmp.pixels.len == 0us);
}

__test faces_have_distinct_ids {
    let dmut a = noto();
    let dmut b = noto();
    assert (a.getUniqId() != b.getUniqId());
}

__test synthetic_bold_thickens_the_glyphs {
    let dmut f = noto();
    let dmut b = copy FontFace::open(Path("res/fonts/noto/NotoSans-Regular.ttf"), syntheticBold-> true);
    let glyph = f:.getGlyphIndex('l'c32);

    let regular = f:.rasterize(glyph, 32u32, 0u8);
    let bold = b:.rasterize(glyph, 32u32, 0u8);
    assert (inked(bold) > inked(regular));
    assert (bold.width > regular.width);
    assert (bold.left == regular.left);
}

__test synthetic_bold_widens_the_advances {
    let dmut f = noto();
    let dmut b = copy FontFace::open(Path("res/fonts/noto/NotoSans-Regular.ttf"), syntheticBold-> true);
    let regular = shapeLine(alias f, "Balder", 32u32);
    let bold = shapeLine(alias b, "Balder", 32u32);
    assert (bold.width > regular.width);
}

__test synthetic_oblique_slants_the_glyphs {
    let dmut f = noto();
    let dmut o = copy FontFace::open(Path("res/fonts/noto/NotoSans-Regular.ttf"), syntheticOblique-> true);
    let glyph = f:.getGlyphIndex('l'c32);

    let regular = f:.rasterize(glyph, 32u32, 0u8);
    let slanted = o:.rasterize(glyph, 32u32, 0u8);
    assert (slanted.width > regular.width);
    assert (slanted.height == regular.height);
}

/**
 * (file, family, weight, style)
 * */
@parameters ((yield c for c in [("res/fonts/noto/NotoSans-Regular.ttf", "Noto Sans", 400u32, FontStyle::NORMAL),
                                ("res/fonts/noto/NotoSans-Bold.ttf", "Noto Sans", 700u32, FontStyle::NORMAL),
                                ("res/fonts/noto/NotoSans-Italic.ttf", "Noto Sans", 400u32, FontStyle::ITALIC),
                                ("res/fonts/noto/NotoSans-BoldItalic.ttf", "Noto Sans", 700u32, FontStyle::ITALIC),
                                ("res/fonts/DejaVuSansMono.ttf", "DejaVu Sans Mono", 400u32, FontStyle::NORMAL)]))
__test describe (file: [c8], family: [c8], weight: u32, style: FontStyle) {
    let dmut f = copy FontFace::open(Path(file));
    let info = f:.describe(file, 0i64);
    assert (info.family == family);
    assert (info.weight == weight);
    assert (info.style == style);
    assert (info.width == FONT_WIDTH_NORMAL);
    assert (info.path == file && info.index == 0i64);
    assert (f.getNbFaces() == 1i64);
}

__test has_glyph {
    let dmut f = noto();
    assert (f:.hasGlyph('A'c32));
    assert (!f:.hasGlyph('\u{0x531}'c32));
}
