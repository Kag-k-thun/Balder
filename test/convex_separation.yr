in convex_separation;

use balder::math::{quaternion, vector};
use balder::scene::physics;
use balder::scene::physics::gjk;

use std::math;

/**
 * @returns: true iif two numbers are equal, give or take the rounding errors
 * */
fn near(a: f32, b: f32, tolerance: f32 = 0.001f)-> bool {
    math::abs(a - b) < tolerance
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3, tolerance: f32 = 0.001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: a pseudo random number in [-range, range), the state moved to the next one
 * */
fn next(ref mut state: u64, range: f32)-> f32 {
    state = (state * 1103515245u64 + 12345u64) % 2147483648u64;
    let unit = cast!f32((state >> 15u64) & 0xffffu64) / 65536.0f;

    (unit * 2.0f - 1.0f) * range
}

/**
 * @returns: a box of the world turned by a rotation, of a half side along each of its axes
 * */
fn cube(centre: vec3, half: f32, rotation: Quaternion = Quaternion())-> Convex {
    Convex::box(centre, rotation * makeVec3(half, 0.0f, 0.0f), rotation * makeVec3(0.0f, half, 0.0f),
                rotation * makeVec3(0.0f, 0.0f, half))
}

/**
 * @returns: the distance from a point to a segment
 * */
fn toSegment(point: vec3, p: vec3, q: vec3)-> f32 {
    let d = q - p;
    let t = (point - p).dot(d) / d.dot(d);
    let clamped = if t < 0.0f { 0.0f } else if t > 1.0f { 1.0f } else { t };
    (point - (p + d * clamped)).length()
}

__test two_spheres_are_apart_by_the_distance_between_their_centres_less_their_radii {
    let s = gjk::separation(Convex::sphere(vec3(), 1.0f), Convex::sphere(makeVec3(5.0f, 0.0f, 0.0f), 2.0f));
    assert (!s.overlapping && near(s.distance, 2.0f));
    assert (near(s.pointA, makeVec3(1.0f, 0.0f, 0.0f)) && near(s.pointB, makeVec3(3.0f, 0.0f, 0.0f)));
    assert (near(s.normal, makeVec3(1.0f, 0.0f, 0.0f)));

    assert (gjk::separation(Convex::sphere(vec3(), 1.0f), Convex::sphere(makeVec3(2.5f, 0.0f, 0.0f), 2.0f)).overlapping);
    assert (gjk::separation(Convex::sphere(vec3(), 1.0f), Convex::sphere(vec3(), 1.0f)).overlapping);
}

__test two_boxes_are_apart_by_the_gap_between_their_faces_edges_or_corners {
    let faces = gjk::separation(cube(vec3(), 1.0f), cube(makeVec3(3.0f, 0.0f, 0.0f), 1.0f));
    assert (!faces.overlapping && near(faces.distance, 1.0f) && near(faces.normal, makeVec3(1.0f, 0.0f, 0.0f)));
    assert (near(faces.pointA.x, 1.0f) && near(faces.pointB.x, 2.0f));

    let corners = gjk::separation(cube(vec3(), 1.0f), cube(makeVec3(3.0f, 3.0f, 3.0f), 1.0f));
    assert (near(corners.distance, math::sqrt(3.0f)));
    assert (near(corners.pointA, makeVec3(1.0f, 1.0f, 1.0f)) && near(corners.pointB, makeVec3(2.0f, 2.0f, 2.0f)));

    // turned by 45° about Z, the corner of the second box reaches 3 - sqrt (2) along X
    let turned = cube(makeVec3(3.0f, 0.0f, 0.0f), 1.0f, rotation-> Quaternion::fromAxisAngle(cast!f32(math::PI) / 4.0f, makeVec3(0.0f, 0.0f, 1.0f)));
    assert (near(gjk::separation(cube(vec3(), 1.0f), turned).distance, 2.0f - math::sqrt(2.0f)));

    assert (gjk::separation(cube(vec3(), 1.0f), cube(makeVec3(1.5f, 0.5f, 0.0f), 1.0f)).overlapping);
    assert (gjk::separation(cube(vec3(), 1.0f), cube(vec3(), 0.25f)).overlapping);
}

__test a_capsule_is_apart_from_a_box_by_the_gap_from_its_segment_less_its_radius {
    let upright = Convex::capsule(makeVec3(0.0f, -1.0f, 0.0f), makeVec3(0.0f, 1.0f, 0.0f), 0.5f);
    assert (near(gjk::separation(upright, cube(makeVec3(2.0f, 0.0f, 0.0f), 1.0f)).distance, 0.5f));

    // the end of the segment closest to the corner (1, 1, 0) of the box
    let lying = Convex::capsule(makeVec3(3.0f, 5.0f, 0.0f), makeVec3(6.0f, 5.0f, 0.0f), 1.0f);
    assert (near(gjk::separation(lying, cube(vec3(), 1.0f)).distance, math::sqrt(20.0f) - 1.0f));

    assert (gjk::separation(upright, cube(makeVec3(1.2f, 1.2f, 0.0f), 1.0f)).overlapping);
}

__test a_sphere_touches_a_triangle_when_it_crosses_it {
    let t = Convex::triangle(makeVec3(-1.0f, 0.0f, -1.0f), makeVec3(1.0f, 0.0f, -1.0f), makeVec3(0.0f, 0.0f, 1.0f));

    let above = gjk::separation(t, Convex::sphere(makeVec3(0.0f, 2.0f, 0.0f), 1.0f));
    assert (near(above.distance, 1.0f) && near(above.normal, makeVec3(0.0f, 1.0f, 0.0f)));

    // beyond the corner (0, 0, 1)
    assert (near(gjk::separation(t, Convex::sphere(makeVec3(0.0f, 0.0f, 3.0f), 1.0f)).distance, 1.0f));

    assert (gjk::separation(t, Convex::sphere(makeVec3(0.0f, 0.5f, 0.0f), 1.0f)).overlapping);
    assert (!gjk::separation(t, Convex::sphere(makeVec3(0.0f, 1.5f, 0.0f), 1.0f)).overlapping);
}

__test the_separation_of_spheres_and_capsules_scattered_is_their_exact_distance {
    let mut state = 5u64;
    for _ in 0us .. 200us {
        let c = makeVec3(next(ref state, 10.0f), next(ref state, 10.0f), next(ref state, 10.0f));
        let p = makeVec3(next(ref state, 10.0f), next(ref state, 10.0f), next(ref state, 10.0f));
        let q = p + makeVec3(next(ref state, 4.0f), next(ref state, 4.0f), next(ref state, 4.0f));
        let r1 = 1.0f + next(ref state, 0.9f);
        let r2 = 1.0f + next(ref state, 0.9f);

        let expected = toSegment(c, p, q) - r1 - r2;
        let s = gjk::separation(Convex::sphere(c, r1), Convex::capsule(p, q, r2));
        if expected > 0.01f {
            assert (!s.overlapping && near(s.distance, expected));
        } else if expected < -0.01f {
            assert (s.overlapping);
        }
    }
}

__test the_separation_of_two_boxes_does_not_depend_on_their_order {
    let mut state = 9u64;
    for _ in 0us .. 100us {
        let axis = makeVec3(next(ref state, 1.0f), next(ref state, 1.0f), 1.5f).normalized();
        let a = cube(vec3(), 1.0f, rotation-> Quaternion::fromAxisAngle(next(ref state, 3.0f), axis));
        let b = cube(makeVec3(next(ref state, 6.0f), next(ref state, 6.0f), next(ref state, 6.0f)), 0.5f + next(ref state, 0.4f),
                     rotation-> Quaternion::fromAxisAngle(next(ref state, 3.0f), axis.cross(makeVec3(1.0f, 0.0f, 0.0f)).normalized()));

        let ab = gjk::separation(a, b), ba = gjk::separation(b, a);
        assert (ab.overlapping == ba.overlapping);
        assert (near(ab.distance, ba.distance, tolerance-> 0.002f));
        if !ab.overlapping {
            assert (near((ab.pointB - ab.pointA).length(), ab.distance, tolerance-> 0.002f));
        }
    }
}

__test a_sphere_swept_onto_a_box_stops_against_its_face {
    if let Ok(hit) = gjk::sweep(Convex::sphere(makeVec3(-5.0f, 0.0f, 0.0f), 1.0f), makeVec3(1.0f, 0.0f, 0.0f), 10.0f, cube(vec3(), 1.0f)) {
        assert (near(hit.distance, 3.0f));
        assert (near(hit.point, makeVec3(-1.0f, 0.0f, 0.0f)) && near(hit.normal, makeVec3(-1.0f, 0.0f, 0.0f)));
    } else {
        assert (false);
    }
}

__test a_box_swept_onto_a_turned_box_stops_where_its_face_meets_the_top_edge {
    let turned = cube(vec3(), 1.0f, rotation-> Quaternion::fromAxisAngle(cast!f32(math::PI) / 4.0f, makeVec3(0.0f, 0.0f, 1.0f)));
    if let Ok(hit) = gjk::sweep(cube(makeVec3(0.0f, 5.0f, 0.0f), 1.0f), makeVec3(0.0f, -1.0f, 0.0f), 10.0f, turned) {
        assert (near(hit.distance, 4.0f - math::sqrt(2.0f)));

        // the top edge of the turned box runs along Z, met all along by the face
        assert (near(hit.point.x, 0.0f) && near(hit.point.y, math::sqrt(2.0f)) && near(hit.normal, makeVec3(0.0f, 1.0f, 0.0f)));
    } else {
        assert (false);
    }
}

__test a_swept_shape_misses_what_it_passes_by_moves_away_from_or_does_not_reach {
    let box = cube(vec3(), 1.0f);
    let right = makeVec3(1.0f, 0.0f, 0.0f);

    assert (!gjk::sweep(Convex::sphere(makeVec3(-5.0f, 3.0f, 0.0f), 1.0f), right, 10.0f, box).hasValue);
    assert (!gjk::sweep(Convex::sphere(makeVec3(-5.0f, 0.0f, 0.0f), 1.0f), -right, 10.0f, box).hasValue);
    assert (!gjk::sweep(Convex::sphere(makeVec3(-5.0f, 0.0f, 0.0f), 1.0f), right, 2.0f, box).hasValue);
}

__test a_shape_swept_from_inside_another_hits_it_at_once {
    let right = makeVec3(1.0f, 0.0f, 0.0f);
    if let Ok(hit) = gjk::sweep(Convex::sphere(makeVec3(0.5f, 0.0f, 0.0f), 1.0f), right, 10.0f, cube(vec3(), 1.0f)) {
        assert (hit.distance == 0.0f && near(hit.normal, -right));
    } else {
        assert (false);
    }
}
