in color_dialog;

use balder::interface::dialog::color::utils;
use balder::math::vector;

/**
 * @returns: true iif two colours are equal, up to the rounding of their channels
 * */
fn near(a: vec4, b: vec4)-> bool {
    let d = a - b;
    for c in [d.x, d.y, d.z, d.w] {
        if c > 0.002f || c < -0.002f { return false; }
    }

    true
}

__test a_colour_is_written_in_hexadecimal_its_opacity_when_it_has_one {
    assert (hexText(makeVec4(1.0f, 0.0f, 0.5f, 1.0f)) == "#ff0080");
    assert (hexText(makeVec4(0.2f, 0.4f, 0.6f, 0.5f)) == "#33669980");
    assert (hexText(makeVec4(2.0f, -1.0f, 0.0f, 1.0f)) == "#ff0000");
    assert (toByte(0.5f) == 128u32 && toByte(1.0f) == 255u32);
}

__test a_colour_typed_is_read_as_in_the_style_sheets {
    if let Ok(c) = parseColor("#3380e6") {
        assert (near(c, makeVec4(0.2f, 0.502f, 0.902f, 1.0f)));
    } else { assert (false); }

    if let Ok(c) = parseColor("  3380e680 ") {
        assert (near(c, makeVec4(0.2f, 0.502f, 0.902f, 0.502f)));
    } else { assert (false); }

    if let Ok(c) = parseColor("steelblue / 50%") {
        assert (near(c, makeVec4(0.275f, 0.510f, 0.706f, 0.5f)));
    } else { assert (false); }

    if let Ok(c) = parseColor("rgb(255 0 0)") {
        assert (near(c, makeVec4(1.0f, 0.0f, 0.0f, 1.0f)));
    } else { assert (false); }

    assert (!parseColor("").hasValue && !parseColor("not a colour").hasValue && !parseColor("#12").hasValue);
}
