in grid_tracks;

use balder::interface::widget::alignement;
use balder::interface::widget::layout::grid;

/**
 * @returns: a track in pixels
 * */
fn px(amount: f32)-> Track {
    Track(TrackKind::PIXELS, amount)
}

/**
 * @returns: a share of the free space
 * */
fn fr(amount: f32)-> Track {
    Track(TrackKind::SHARE, amount)
}

/**
 * @returns: a track sized by its content
 * */
fn auto()-> Track {
    Track(TrackKind::AUTO, 0.0f)
}

/**
 * @returns: the contents of tracks whose cells are empty
 * */
fn empty(count: usize)-> [(f32, f32)] {
    copy [(0.0f, 0.0f) ; count]
}

__test the_shares_split_the_free_space {
    assert (GridLayout::resolveTracks(copy [fr(1.0f), fr(2.0f)], 2u32, 300.0f, empty(2us)) == [100.0f, 200.0f]);
}

__test the_lengths_are_taken_before_the_shares {
    let tracks = copy [px(120.0f), Track(TrackKind::PERCENT, 25.0f), fr(1.0f)];
    assert (GridLayout::resolveTracks(tracks, 3u32, 400.0f, empty(3us)) == [120.0f, 100.0f, 180.0f]);
}

__test the_tracks_past_those_given_take_a_share {
    assert (GridLayout::resolveTracks(copy [px(100.0f)], 3u32, 300.0f, empty(3us)) == [100.0f, 100.0f, 100.0f]);

    // a grid given no track has cells of equal size
    assert (GridLayout::resolveTracks([], 3u32, 300.0f, empty(3us)) == [100.0f, 100.0f, 100.0f]);
}

__test an_auto_track_takes_its_content_then_the_shares_the_rest {
    let contents = copy [(20.0f, 80.0f), (0.0f, 0.0f)];
    assert (GridLayout::resolveTracks(copy [auto(), fr(1.0f)], 2u32, 300.0f, contents) == [80.0f, 220.0f]);
}

__test the_auto_tracks_share_the_space_from_their_min_content {
    let contents = copy [(20.0f, 80.0f), (40.0f, 100.0f)];

    // 60 of min-content, the 40 left shared equally
    assert (GridLayout::resolveTracks(copy [auto(), auto()], 2u32, 100.0f, contents) == [40.0f, 60.0f]);
    assert (GridLayout::resolveTracks(copy [auto(), auto()], 2u32, 150.0f, contents) == [65.0f, 85.0f]);

    // a track stops at its max-content, the others taking what it leaves
    let narrow = copy [(20.0f, 30.0f), (40.0f, 200.0f)];
    assert (GridLayout::resolveTracks(copy [auto(), auto()], 2u32, 200.0f, narrow) == [30.0f, 170.0f]);

    // below the min-contents, the tracks overflow the grid
    assert (GridLayout::resolveTracks(copy [auto(), auto()], 2u32, 50.0f, contents) == [20.0f, 40.0f]);
}

__test the_auto_tracks_stretch_without_a_share {
    let contents = copy [(10.0f, 50.0f), (0.0f, 0.0f)];
    assert (GridLayout::resolveTracks(copy [auto(), px(100.0f)], 2u32, 300.0f, contents) == [200.0f, 100.0f]);
}

__test the_content_sizes {
    let tracks = copy [Track(TrackKind::MIN_CONTENT, 0.0f), Track(TrackKind::MAX_CONTENT, 0.0f), fr(1.0f)];
    let contents = copy [(30.0f, 90.0f), (30.0f, 90.0f), (30.0f, 90.0f)];
    assert (GridLayout::resolveTracks(tracks, 3u32, 300.0f, contents) == [30.0f, 90.0f, 180.0f]);
}

__test shares_under_one_take_a_part_of_the_free_space {
    assert (GridLayout::resolveTracks(copy [Track(TrackKind::SHARE, 0.5f)], 1u32, 200.0f, empty(1us)) == [100.0f]);
}

__test the_tracks_overflow_a_short_grid {
    assert (GridLayout::resolveTracks(copy [px(200.0f), px(200.0f)], 2u32, 300.0f, empty(2us)) == [200.0f, 200.0f]);

    // a share may be smaller than its content
    let contents = copy [(0.0f, 0.0f), (50.0f, 50.0f)];
    assert (GridLayout::resolveTracks(copy [px(200.0f), fr(1.0f)], 2u32, 100.0f, contents) == [200.0f, 0.0f]);
}

__test the_size_of_a_grid_sized_to_its_content {
    // a share is as large as the largest content per fr
    let contents = copy [(10.0f, 60.0f), (10.0f, 60.0f)];
    assert (GridLayout::measureTracks(copy [fr(1.0f), fr(2.0f)], 2u32, contents, minimum-> false) == 180.0f);
    assert (GridLayout::measureTracks(copy [fr(1.0f), fr(2.0f)], 2u32, contents, minimum-> true) == 30.0f);

    // the lengths, then the contents of the auto tracks
    let content = copy [(0.0f, 0.0f), (20.0f, 80.0f)];
    assert (GridLayout::measureTracks(copy [px(120.0f), auto()], 2u32, content, minimum-> false) == 200.0f);
    assert (GridLayout::measureTracks(copy [px(120.0f), auto()], 2u32, content, minimum-> true) == 140.0f);

    // the tracks past those given take a share
    assert (GridLayout::measureTracks([], 3u32, contents ~ [(10.0f, 40.0f)], minimum-> false) == 180.0f);
}

__test the_positions_of_the_tracks {
    let sizes = copy [10.0f, 20.0f, 30.0f];
    let offsets = GridLayout::offsets(sizes);
    assert (offsets == [0.0f, 10.0f, 30.0f]);

    assert (GridLayout::trackAt(offsets, sizes, 5.0f) == (0us)?);
    assert (GridLayout::trackAt(offsets, sizes, 25.0f) == (1us)?);
    assert (GridLayout::trackAt(offsets, sizes, 59.0f) == (2us)?);
    assert (!GridLayout::trackAt(offsets, sizes, 61.0f).hasValue);
}
