in node_icons;

use balder::math::vector;
use balder::scene::gizmo::{icons, view};
use balder::scene::node::_;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{camera, empty, guide, light};
use balder::scene::utils::post::gizmo;
use balder::scene::utils::post::gizmo::shape;

use std::math;

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * A 3D node seen by a geometry of its own, without icon
 * */
class Item over Node3D {

    pub self (name: [c8], dmut parent: &Node)
        with super(name, alias parent)
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * @returns: true iif two numbers are equal, give or take the rounding errors
 * */
fn near(a: f32, b: f32, tolerance: f32 = 0.001f)-> bool {
    math::abs(a - b) < tolerance
}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3, tolerance: f32 = 0.001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: a camera on the Z axis 10 units from the origin, looking at it, seeing it into an image of 1280 × 720
 * */
fn cameraOf(dmut root: &Node)-> dmut &Camera {
    let dmut cam = copy PerspectiveCamera("cam", alias root);
    cam.position = makeVec3(0.0f, 0.0f, 10.0f);
    cam.target = makeVec3(0.0f, 0.0f, 0.0f);

    alias cam
}

/**
 * @returns: the point of the image a point of the world is seen at, the top left corner when it is behind the camera
 * */
fn seen(view: GizmoView, p: vec3)-> vec2 {
    if let Ok(px) = view.project(p) { px } else { vec2() }
}

/**
 * @returns: the number of shapes of a kind among shapes
 * */
fn countOf(shapes: [GizmoShape], kind: GizmoShapeKind)-> usize {
    let mut n = 0us;
    for s in shapes if s.kind == kind {
        n += 1us;
    }

    n
}

__test the_nodes_without_geometry_have_an_icon_of_their_class {
    let dmut root = copy Root();
    let item = copy Item("item", alias root);
    let empty = copy Empty3D("empty", alias root);
    let dmut sun = copy Light("sun", alias root);
    let cam = cameraOf(alias root);

    assert (!item.editorIcon().hasValue);
    assert (empty.editorIcon().hasValue && cam.editorIcon().hasValue);

    // the glyph of a light follows its type
    let sunShapes = if let Ok(i) = sun.editorIcon() { i.shapes } else { [] };
    sun.type = LightType::POINT;
    let bulbShapes = if let Ok(i) = sun.editorIcon() { i.shapes } else { [] };
    assert (sunShapes.len != 0us && bulbShapes.len != 0us && sunShapes.len != bulbShapes.len);
}

__test the_icons_leave_out_the_tools_and_the_camera_of_the_view {
    let dmut root = copy Root();
    let cam = cameraOf(alias root);
    let view = GizmoView(cam, 1280u32, 720u32);

    let dmut empty = copy Empty3D("empty", alias root);
    let sun = copy Light("sun", alias empty);
    copy Item("item", alias empty);
    copy Empty3D("__tool__", alias root);
    let dmut icons = copy NodeIcons("__icons__", alias root);

    // the empty and the light under it, not the item, the tool, the icons nor the eye
    let nodes = icons:.nodes(view);
    assert (nodes.len == 2us);
    let mut found = 0us;
    for n in nodes if n.uid == empty.uid || n.uid == sun.uid {
        found += 1us;
    }

    assert (found == 2us);
}

__test a_click_picks_the_icon_closest_to_the_eye {
    let dmut root = copy Root();
    let cam = cameraOf(alias root);
    let view = GizmoView(cam, 1280u32, 720u32);
    let dmut icons = copy NodeIcons("__icons__", alias root);

    let dmut back = copy Empty3D("back", alias root);
    back.position = makeVec3(0.0f, 0.0f, -5.0f);
    let dmut front = copy Light("front", alias root);
    front.position = makeVec3(0.0f, 0.0f, 2.0f);
    let dmut aside = copy Empty3D("aside", alias root);
    aside.position = makeVec3(3.0f, 0.0f, 0.0f);

    // the two icons over each other, the one in front over the other
    let centre = seen(view, makeVec3(0.0f, 0.0f, 0.0f));
    if let Ok(n) = icons:.iconAt(view, centre + makeVec2(5.0f, 5.0f)) {
        assert (n.uid == front.uid);
    } else {
        assert (false);
    }

    if let Ok(n) = icons:.iconAt(view, seen(view, aside.position)) {
        assert (n.uid == aside.uid);
    } else {
        assert (false);
    }

    assert (!icons:.iconAt(view, centre + makeVec2(40.0f, 0.0f)).hasValue);

    // the cursor over an icon, then off it
    assert (icons:.hover(view, seen(view, aside.position)) == aside.uid?);
    assert (!icons:.hover(view, makeVec2(5.0f, 5.0f)).hasValue && !icons.hovered.hasValue);
}

__test an_icon_keeps_its_aspect_on_screen {
    let dmut root = copy Root();
    let cam = cameraOf(alias root);
    let dmut icons = copy NodeIcons("__icons__", alias root);
    copy Empty3D("empty", alias root);

    // the texels twice as wide on screen as they are high, the icon half as many texels wide
    let square = icons:.shapes(GizmoView(cam, 1280u32, 720u32));
    let wide = icons:.shapes(GizmoView(cam, 1280u32, 720u32, texelAspect-> 2.0f));
    assert (square.len == wide.len && square.len > 0us);

    let badge = square[0], stretched = wide[0];
    assert (badge.kind == GizmoShapeKind::RING && stretched.kind == GizmoShapeKind::RING);
    assert (near(stretched.p2.x - stretched.p1.x, (badge.p2.x - badge.p1.x) / 2.0f));
    assert (near(stretched.p2.y - stretched.p1.y, badge.p2.y - badge.p1.y));

    // picked as far on screen: 12 heights of a texel across is 6 texels of the wider ones
    let at = seen(GizmoView(cam, 1280u32, 720u32), vec3());
    assert (icons:.iconAt(GizmoView(cam, 1280u32, 720u32), at + makeVec2(12.0f, 0.0f)).hasValue);
    assert (!icons:.iconAt(GizmoView(cam, 1280u32, 720u32, texelAspect-> 2.0f), at + makeVec2(12.0f, 0.0f)).hasValue);
}

__test a_selected_node_is_drawn_with_its_guides_under_the_icons {
    let dmut root = copy Root();
    let cam = cameraOf(alias root);
    let view = GizmoView(cam, 1280u32, 720u32);
    let dmut icons = copy NodeIcons("__icons__", alias root);

    let dmut bulb = copy Light("bulb", alias root);
    bulb.type = LightType::POINT;
    bulb.range = 2.0f;
    let unselected = icons:.shapes(view);

    icons:.setSelected(copy [alias bulb]);
    let shapes = icons:.shapes(view);

    // the three circles of the range, then the icon and the ring of the selection
    let guides = bulb.editorGuides(1.0f).len;
    assert (guides == 96us);
    assert (shapes.len == unselected.len + guides + 1us);
    assert (shapes[0].kind == GizmoShapeKind::SEGMENT && shapes[guides].kind == GizmoShapeKind::RING);
    assert (countOf(shapes, GizmoShapeKind::RING) == countOf(unselected, GizmoShapeKind::RING) + 1us);
}

__test the_shapes_keep_the_icons_closest_to_the_eye {
    let dmut root = copy Root();
    let cam = cameraOf(alias root);
    let view = GizmoView(cam, 1280u32, 720u32);
    let dmut icons = copy NodeIcons("__icons__", alias root);

    // more empties than the effect draws shapes, each farther than the last
    let probe = copy Empty3D("probe", alias root);
    let per = if let Ok(i) = probe.editorIcon() { i.shapes.len + 1us } else { 1us };
    for k in 0us .. MAX_GIZMO_SHAPES / per + 4us {
        let dmut g = copy Empty3D(f"g${k}", alias root);
        g.position = makeVec3(0.0f, 0.0f, -cast!f32(cast!u64(k)));
    }

    let shapes = icons:.shapes(view);
    assert (shapes.len <= MAX_GIZMO_SHAPES && shapes.len + per > MAX_GIZMO_SHAPES);
}

__test a_light_has_the_guides_of_its_type {
    let dmut root = copy Root();
    let dmut l = copy Light("light", alias root);
    l.position = makeVec3(1.0f, 2.0f, 3.0f);
    l.direction = makeVec3(0.0f, -1.0f, 0.0f);
    l.range = 4.0f;

    // five arrows along the direction, as long as the size asked
    let arrows = l.editorGuides(2.0f);
    assert (arrows.len == 25us);
    assert (near(arrows[0].to - arrows[0].from, makeVec3(0.0f, -2.0f, 0.0f)));

    // the circles of the range about the light
    l.type = LightType::POINT;
    for g in l.editorGuides(2.0f) {
        assert (near((g.from - l.position).length(), 4.0f) && !g.faint);
    }

    // the cones up to the range, the full light fainter
    l.type = LightType::SPOT;
    l.innerAngle = 20.0f;
    l.outerAngle = 30.0f;
    let cones = l.editorGuides(2.0f);
    assert (cones.len == 72us);

    let mut faint = 0us;
    for g in cones {
        assert (near((g.to - l.position).length(), 4.0f));
        if g.faint { faint += 1us; }
    }

    assert (faint == 36us);
}

__test a_camera_shows_its_frustum {
    let dmut root = copy Root();
    let dmut cam = copy PerspectiveCamera("other", alias root);
    cam.position = makeVec3(0.0f, 0.0f, 0.0f);
    cam.target = makeVec3(0.0f, 0.0f, -1.0f);
    cam.near = 1.0f;
    cam.far = 10.0f;

    // the edges of the near and far planes and the lines joining them
    let lines = cam.editorGuides(1.0f);
    assert (lines.len == 12us);
    for g in lines {
        assert (near(g.from.z, -1.0f, tolerance-> 0.01f) || near(g.from.z, -10.0f, tolerance-> 0.05f));
        assert (g.to.z < -0.99f);
    }
}

__test a_segment_crossing_the_near_plane_is_cut {
    let dmut root = copy Root();
    let cam = cameraOf(alias root);
    let view = GizmoView(cam, 1280u32, 720u32);

    // in front of the camera, the ends where project sees them
    if let Ok(ends) = view.projectSegment(makeVec3(-1.0f, 0.0f, 0.0f), makeVec3(1.0f, 0.0f, 0.0f)) {
        assert (ends._0 == seen(view, makeVec3(-1.0f, 0.0f, 0.0f)) && ends._1 == seen(view, makeVec3(1.0f, 0.0f, 0.0f)));
    } else {
        assert (false);
    }

    // from in front of the camera to behind it, cut at its near plane, the end in front kept
    if let Ok(ends) = view.projectSegment(makeVec3(1.0f, 0.0f, 0.0f), makeVec3(1.0f, 0.0f, 20.0f)) {
        assert (ends._0 == seen(view, makeVec3(1.0f, 0.0f, 0.0f)) && (ends._1).x != (ends._0).x);
    } else {
        assert (false);
    }

    // behind it whole
    assert (!view.projectSegment(makeVec3(0.0f, 0.0f, 12.0f), makeVec3(1.0f, 0.0f, 15.0f)).hasValue);
}

__test a_ring_is_placed_by_the_square_enclosing_it {
    let r = GizmoShape::ring(makeVec2(1.0f, 2.0f), 3.0f, 1.0f, makeVec4(1.0f, 1.0f, 1.0f, 0.5f));
    assert (r.kind == GizmoShapeKind::RING && near(r.radius, 3.0f) && near(r.width, 0.5f));
    assert (r.lowCorner() == makeVec2(-2.5f, -1.5f) && r.highCorner() == makeVec2(4.5f, 5.5f));

    // scaled about the origin, then moved, its width scaled as along y, its colour tinted
    let p = r.placed(makeVec2(10.0f, 10.0f), makeVec2(1.0f, 2.0f), makeVec4(0.5f, 1.0f, 1.0f, 1.0f));
    assert (p.p0 == makeVec2(11.0f, 14.0f) && near(p.radius, 6.0f) && near(p.width, 1.0f));
    assert (p.color == makeVec4(0.5f, 1.0f, 1.0f, 0.5f));
}
