in parser_selector;

use balder::interface::loader::parser;

use std::syntax::errors;

/**
 * @returns: the selectors of a content, checking they end it or stop before a '{'
 * */
fn read(content: [c8])-> [Selector]
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = SelectorReader(alias scanner);
    let selectors = reader:.readList();
    let rest = scanner:.next();
    if rest.kind != TokenKind::EOF && rest.text != "{" {
        throw copy SyntaxError("selectors followed by '" ~ rest.text ~ "'", rest.line, rest.col);
    }

    selectors
}

/**
 * @returns: the compounds of a content holding a single selector
 * */
fn compounds(content: [c8])-> [Compound]
    throws SyntaxError
{
    read(content)[0].compounds
}

/**
 * @returns: the error of selectors that cannot be read, or none
 * */
fn failure(content: [c8])-> (&SyntaxError)? {
    {
        read(content);
        none
    } catch {
        e: &SyntaxError => { (e)? }
    }
}

__test a_compound_glued_in_css_order {
    let c = compounds("PushButton#YES.yes.primary:hover:focus::label");
    assert (c.len == 1us);
    assert (c[0].combinator == Combinator::NONE);
    assert (c[0].typeName == "PushButton" && c[0].id == "YES");
    assert (c[0].classes == ["yes", "primary"]);
    assert (c[0].states == ["hover", "focus"]);
    assert (c[0].part == "label");
}

__test any_type {
    let star = compounds("*.a")[0];
    assert (star.typeName == "" && star.classes == ["a"]);

    let bare = compounds(":hover")[0];
    assert (bare.typeName == "" && bare.states == ["hover"]);

    let id = compounds("#ROOT")[0];
    assert (id.typeName == "" && id.id == "ROOT");
}

__test spaces_and_angles_join_compounds {
    let descendant = compounds(".sidebar  PushButton");
    assert (descendant.len == 2us);
    assert (descendant[0].classes == ["sidebar"] && descendant[0].combinator == Combinator::NONE);
    assert (descendant[1].typeName == "PushButton" && descendant[1].combinator == Combinator::DESCENDANT);
    assert (descendant[1].col == 11us);

    for content in ["LinearLayout.bar > Label", "LinearLayout.bar>Label"] {
        let child = compounds(content);
        assert (child.len == 2us && child[1].combinator == Combinator::CHILD && child[1].typeName == "Label");
    }

    // the v1 spelling now reads as four compounds
    let old = compounds("PushButton :hover ::label .yes");
    assert (old.len == 4us && old[1].states == ["hover"] && old[2].part == "label" && old[3].classes == ["yes"]);
}

__test a_part_takes_its_states_after_it {
    let c = compounds("TabLayout.tabs:hover::tab:selected:hover")[0];
    assert (c.states == ["hover"] && c.part == "tab");
    assert (c.partStates == ["selected", "hover"]);

    let plain = compounds("PushButton:hover::label")[0];
    assert (plain.states == ["hover"] && plain.partStates.len == 0us);
}

__test commas_list_the_selectors_of_a_block {
    let list = read("PushButton.yes,\n PushButton.no:hover {");
    assert (list.len == 2us);
    assert (list[0].source == "PushButton.yes" && list[0].line == 1us);
    assert (list[1].source == "PushButton.no:hover" && list[1].line == 2us && list[1].col == 2us);
    assert (list[1].compounds[0].states == ["hover"]);

    assert (read(".a > .b .c {")[0].source == ".a > .b .c");
}

/**
 * (content, line, column)
 * */
@parameters ((yield c for c in [("", 1us, 1us),
                                ("{", 1us, 1us),
                                ("a, {", 1us, 4us),
                                ("a >", 1us, 4us),
                                ("a > > b", 1us, 5us),
                                (". a", 1us, 3us),                 // a class apart from its '.'
                                ("a: hover", 1us, 4us),
                                ("a::label.b", 1us, 9us),          // a part ends its compound
                                ("a::tab:hover.b", 1us, 13us),     // only the states of the part follow it
                                ("a::tab:hover::b", 1us, 13us),
                                ("#A#B", 1us, 3us),                // a second id
                                ("#388", 1us, 1us),                // an id that is no name
                                ("a!", 1us, 2us)]))
__test invalid_selectors (content: [c8], line: usize, col: usize) {
    if let Ok(e) = failure(content) {
        assert (e.line == line && e.col == col);
    } else {
        assert (false);
    }
}
