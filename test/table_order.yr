in table_order;

use balder::interface::widget::table::{order, texts};

// The names and the sizes of four rows, the first and the third of the same size
def NAMES = ["b", "a", "c", "a"];
def SIZES = ["10", "9", "10", "100"];

__test the_texts_compare_as_people_read_them {
    assert (compareTexts("Row 9", "Row 10") < 0 && compareTexts("Row 10", "Row 9") > 0);
    assert (compareTexts("apple", "Banana") < 0 && compareTexts("Apple", "apple") == 0);
    assert (compareTexts("file-007", "file-7") == 0 && compareTexts("file-8", "file-07") > 0);
    assert (compareTexts("abc", "abcd") < 0 && compareTexts("", "") == 0);
    assert (compareTexts("120 KB", "99 KB") > 0);
}

__test the_rows_are_sorted_stably {
    assert (sortRows(4us, |a, b| => compareTexts(NAMES[a], NAMES[b])) == copy [1us, 3us, 0us, 2us]);
    assert (sortRows(4us, |a, b| => compareTexts(SIZES[a], SIZES[b])) == copy [1us, 0us, 2us, 3us]);

    // in decreasing order, the rows equal keep their order
    assert (sortRows(4us, |a, b| => compareTexts(SIZES[a], SIZES[b]), descending-> true) == copy [3us, 0us, 2us, 1us]);
    assert (sortRows(0us, |a, b| => compareTexts(NAMES[a], NAMES[b])).len == 0us);
}

__test a_text_model_compares_its_texts {
    let model = copy TextTableModel(headers-> copy ["Name", "Size"],
                                    rows-> copy [copy ["b", "10"], copy ["a", "9"], copy ["c"]]);
    assert (model.columns() == 2us && model.len() == 3us && model.text(2us, 1us) == "");
    assert (model.compare(0us, 1us, 0us) > 0 && model.compare(0us, 1us, 1us) > 0 && model.compare(1us, 2us, 1us) > 0);
}

__test an_order_is_inverted {
    assert (invertOrder(copy [2us, 0us, 3us, 1us]) == copy [1us, 3us, 0us, 2us]);
}
