in value_range;

use balder::interface::widget::range;

/**
 * @returns: true iif two values are within a thousandth of each other
 * */
fn near(a: f32, b: f32)-> bool {
    let d = a - b;
    d < 0.001f && -d < 0.001f
}

__test a_value_is_kept_between_the_bounds {
    let r = ValueRange(lower-> -10.0f, upper-> 10.0f);
    assert (near(r.snap(3.25f), 3.25f));
    assert (near(r.snap(-40.0f), -10.0f) && near(r.snap(40.0f), 10.0f));
    assert (near(r.span(), 20.0f));
}

__test a_value_is_a_whole_number_of_steps_from_the_lowest_one {
    let r = ValueRange(lower-> 1.0f, upper-> 10.0f, step-> 2.0f);
    assert (near(r.snap(3.9f), 3.0f) && near(r.snap(4.1f), 5.0f));
    assert (near(r.snap(1.0f), 1.0f));

    // the highest value is not a whole number of steps away, the last step under it is taken instead
    assert (near(r.snap(10.0f), 9.0f) && near(r.snap(9.9f), 9.0f));
}

__test an_upper_bound_under_the_lower_one_leaves_a_single_value {
    let r = ValueRange(lower-> 5.0f, upper-> 2.0f);
    assert (near(r.top(), 5.0f) && near(r.span(), 0.0f));
    assert (near(r.snap(0.0f), 5.0f) && near(r.snap(8.0f), 5.0f));
    assert (near(r.fractionOf(5.0f), 0.0f));
    assert (near(r.valueAt(0.7f), 5.0f));
}

__test the_fraction_of_a_value_and_the_value_at_a_fraction {
    let r = ValueRange(lower-> 0.0f, upper-> 200.0f, step-> 10.0f);
    assert (near(r.fractionOf(50.0f), 0.25f));
    assert (near(r.fractionOf(53.0f), 0.25f));
    assert (near(r.fractionOf(-5.0f), 0.0f) && near(r.fractionOf(500.0f), 1.0f));

    assert (near(r.valueAt(0.5f), 100.0f));
    assert (near(r.valueAt(0.26f), 50.0f));
    assert (near(r.valueAt(-1.0f), 0.0f) && near(r.valueAt(2.0f), 200.0f));
}

__test a_value_moves_by_steps {
    let r = ValueRange(lower-> 0.0f, upper-> 10.0f, step-> 2.0f);
    assert (near(r.moveBy(4.0f, 1), 6.0f) && near(r.moveBy(4.0f, -2), 0.0f));
    assert (near(r.moveBy(10.0f, 3), 10.0f));

    // a range without step moves by a hundredth of its span
    let continuous = ValueRange(lower-> 0.0f, upper-> 50.0f);
    assert (near(continuous.moveBy(10.0f, 1), 10.5f) && near(continuous.moveBy(10.0f, -4), 8.0f));
}

__test the_default_range {
    let r = ValueRange();
    assert (near(r.lower, 0.0f) && near(r.upper, 100.0f) && near(r.step, 0.0f));
}
