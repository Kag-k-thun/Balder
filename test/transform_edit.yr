in transform_edit;

use balder::math::vector;
use balder::scene::{_, edit};
use balder::scene::node;
use balder::scene::node::node3D::{empty, transform};

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

__test an_edit_extended_goes_from_its_transform_before_to_the_transform_after_the_next_one {
    let dmut root = copy Root();
    let dmut a = copy Empty3D("a", alias root);
    let one = makeVec3(1.0f, 0.0f, 0.0f);
    let two = makeVec3(2.0f, 0.0f, 0.0f);

    let mut first = TransformEdit(alias a, NodeTransform(one, vec3(), makeVec3(1.0f, 1.0f, 1.0f)));
    first:.apply();
    let second = TransformEdit(alias a, NodeTransform(two, vec3(), makeVec3(1.0f, 1.0f, 1.0f)));

    let mut merged = first:.extendedTo(second.after);
    assert (merged.before.position == vec3() && merged.after.position == two);

    merged:.apply();
    assert (a.position == two);
    merged:.revert();
    assert (a.position == vec3());
}
