in shader_skin;

use balder::core::error;
use balder::core::config::shader::_;

/**
 * @returns: true iif loading a raster shader configuration fails
 * */
fn refused(path: [c8])-> bool {
    {
        let _ = loadRasterShaderConfig(path);
    } catch {
        _: &BalderError => {
            return true;
        }
    }

    false
}

/**
 * The skin variant of a shader holds the vertex entries of the shader and the position of the frame before after them,
 * its vertex pass replaced, its other passes, its prepass and its sets those of the shader
 * */
__test the_skin_of_a_shader_draws_its_vertices_with_their_previous_position {
    let base = loadRasterShaderConfig(DefaultShaders::PBR_3D);
    assert (base.skin.hasValue);
    assert (VertexEntry::PREVIOUS !in base.entries);

    if let Ok(skin) = base.skin {
        assert (skin.name == DefaultShaders::PBR_3D ~ SKIN_SUFFIX);
        assert (!skin.skin.hasValue);

        for e, t in base.entries {
            if let Ok(s) = skin.entries[e] {
                assert (s._1 == t._1);
            } else {
                assert (false);
            }
        }

        if let Ok(previous) = skin.entries[VertexEntry::PREVIOUS] {
            assert (previous._1 == 12u32);
        } else {
            assert (false);
        }

        assert (skin.entries.len == base.entries.len + 1us);
        assert (skin.passes.len == base.passes.len);
        assert (skin.passes[0us].shaderFile == "shaders:/base/3D/pbr/pbr_skin.vert.spv");
        assert (skin.passes[1us].shaderFile == base.passes[1us].shaderFile);
        assert (skin.prepass.len == base.prepass.len);
        assert (skin.prepass[0us].shaderFile == base.prepass[0us].shaderFile);
        assert (skin.descSet.len == base.descSet.len);
        assert (skin.depth == base.depth);
    }
}

/**
 * The three shaders of the materials of the models draw skinned vertices, each with a vertex pass of its own
 * */
__test the_shaders_of_the_materials_draw_skinned_vertices {
    for path, vert in copy ["shaders:/base/3D/color.toml" => "shaders:/base/3D/color/color_skin.vert.spv",
                            "shaders:/base/3D/texture.toml" => "shaders:/base/3D/texture/texture_skin.vert.spv",
                            "shaders:/base/3D/pbr.toml" => "shaders:/base/3D/pbr/pbr_skin.vert.spv"] {
        let base = loadRasterShaderConfig(path);
        if let Ok(skin) = base.skin {
            assert (skin.passes[0us].shaderFile == vert);
            assert (VertexEntry::PREVIOUS in skin.entries);
        } else {
            assert (false);
        }
    }
}

/**
 * A shader without a [skin] table draws rigid vertices only
 * */
__test a_shader_without_skin_draws_rigid_vertices_only {
    let base = loadRasterShaderConfig(DefaultShaders::COLOR_2D);
    assert (!base.skin.hasValue);
}

/**
 * A skin replacing a stage the shader does not have is refused with the shader
 * */
__test a_skin_replacing_a_missing_stage_is_refused {
    assert (refused("test/shaders/skin_missing_stage.toml"));
}
