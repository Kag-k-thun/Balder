in parser_constants;

use balder::interface::loader::parser;

use std::syntax::errors;

/**
 * @returns: the values of a content
 * */
fn read(content: [c8])-> &Value
    throws SyntaxError
{
    let dmut scanner = copy Scanner(content);
    let dmut reader = ValueReader(alias scanner);
    reader:.read()
}

/**
 * @returns: the source of each value of a slice
 * */
fn sources(values: [&Value])-> [[c8]] {
    let mut result: [[c8]] = [];
    for v in values {
        result = result ~ [v.getSource()];
    }

    result
}

__test constants_are_substituted {
    let dmut scope = copy Constants();
    scope:.define("edge", read("#4a5259"));
    assert (scope.contains("edge"));
    assert (!scope.contains("surface"));

    assert (scope.resolve(read("$edge")).getSource() == "#4a5259");
    assert (sources(scope.resolve(read("2 $edge")).toTuple()) == ["2", "#4a5259"]);
    assert (scope.resolve(read("$edge / 40%")).getSource() == "$edge / 40%");
    match scope.resolve(read("$edge / 40%")) {
        Alpha(base-> b) => { assert (b.getSource() == "#4a5259"); }
        _ => { assert (false); }
    }

    match scope.resolve(read("describe ($edge, 1)")) {
        Call(args-> a) => { assert (sources(a) == ["#4a5259", "1"]); }
        _ => { assert (false); }
    }
}

__test tuples_and_lists_are_spliced {
    let dmut scope = copy Constants();
    scope:.define("pad", read("6 14"));
    scope:.define("mono", read("\"DejaVu Sans Mono\", monospace"));

    assert (sources(scope.resolve(read("$pad")).toTuple()) == ["6", "14"]);
    assert (sources(scope.resolve(read("0 $pad")).toTuple()) == ["0", "6", "14"]);
    assert (sources(scope.resolve(read("\"Noto Sans\", $mono")).toList()) == ["\"Noto Sans\"", "\"DejaVu Sans Mono\"", "monospace"]);
}

__test a_constant_uses_the_ones_defined_before_it {
    let dmut scope = copy Constants();
    scope:.define("narrow", read("500"));
    scope:.define("breakpoint", read("$narrow"));
    scope:.define("narrow", read("320"));
    assert (scope.resolve(read("$breakpoint")).toInteger() == 500);
    assert (scope.resolve(read("$narrow")).toInteger() == 320);
}

__test unknown_constants_are_located_at_their_use {
    let scope = copy Constants();
    let error = {
        scope.resolve(read("2  $edge"));
        none
    } catch {
        e: &SyntaxError => { (e)? }
    };

    if let Ok(e) = error {
        assert (e.msg == "unknown constant '$edge'");
        assert (e.line == 1us && e.col == 4us);
    } else {
        assert (false);
    }
}
