in path_nodes;

use balder::math::{curve, vector};
use balder::scene::node;
use balder::scene::node::node3D;
use balder::scene::node::node3D::{empty, guide, path, path_point};

use std::{fs, math};

/**
 * A root with no scene, for the nodes of the tests to hang from
 * */
class Root over Node {

    pub self ()
        with super::root ("")
    {}

    pub over onEnter(mut self, dmut _: &Scene) {}
    pub over onExit(mut self, dmut _: &Scene) {}

}

/**
 * @returns: true iif two vectors are equal, give or take the rounding errors
 * */
fn near(a: vec3, b: vec3, tolerance: f32 = 0.001f)-> bool {
    (a - b).length() < tolerance
}

/**
 * @returns: a path of three points on the X axis, -2, 0 and 2, under a root, then the node of its middle point
 * */
fn line(dmut root: &Node)-> dmut &Path3D {
    let dmut path = copy Path3D("path", alias root);
    let dmut a = copy PathPoint3D("a", alias path);
    a.position = makeVec3(-2.0f, 0.0f, 0.0f);
    copy PathPoint3D("b", alias path);
    let dmut c = copy PathPoint3D("c", alias path);
    c.position = makeVec3(2.0f, 0.0f, 0.0f);

    alias path
}

__test the_points_of_a_path_are_its_path_points_in_their_order {
    let dmut root = copy Root();
    let dmut path = alias line(alias root);
    copy Empty3D("decor", alias path);
    if let Ok(dmut c) = alias path:.find(Path("c")) {
        c:.moveUnder(alias path, at-> 0us);
    }

    let mut names: [[c8]] = [];
    for p in path.points() {
        names ~= [p.name.file()];
    }

    assert (names == ["c", "a", "b"]);
}

__test the_curve_of_a_path_goes_through_its_points_in_the_world {
    let dmut root = copy Root();
    let dmut path = alias line(alias root);
    path.position = makeVec3(0.0f, 5.0f, 0.0f);

    let c = path.curve();
    assert (near(c.pointAt(0.0f), makeVec3(-2.0f, 5.0f, 0.0f)));
    assert (near(c.pointAt(c.length), makeVec3(2.0f, 5.0f, 0.0f)));
    assert (math::abs(path.length() - 4.0f) < 0.01f);
    assert (near(path.pointAt(2.0f), makeVec3(0.0f, 5.0f, 0.0f), tolerance-> 0.01f));
    if let Ok(d) = path.directionAt(1.0f) {
        assert (near(d, makeVec3(1.0f, 0.0f, 0.0f)));
    } else {
        assert (false);
    }
}

__test a_point_of_a_bezier_path_has_its_x_axis_for_handle {
    let dmut root = copy Root();
    let dmut path = alias line(alias root);
    path.curveKind = CurveKind::BEZIER;

    let points = path.points();
    if let Ok(dmut b: &PathPoint3D) = alias path:.find(Path("b")) {
        // a quarter turn about Z: the curve leaves the middle point upward, twice as far
        b:.setTransform(vec3(), makeVec3(0.0f, 0.0f, 1.5707964f), makeVec3(2.0f, 1.0f, 1.0f));
        assert (near(b.worldHandle, makeVec3(0.0f, 2.0f, 0.0f)));
    }

    // coming into the middle point from below, leaving it upward
    let c = path.curve();
    assert (points.len == 3us && c.pointAt(c.length * 0.3f).y < -0.1f && c.pointAt(c.length * 0.7f).y > 0.1f);
}

__test an_editor_draws_the_curve_of_a_path_and_the_handles_of_a_bezier_one {
    let dmut root = copy Root();
    let dmut path = alias line(alias root);

    let wires = path.editorWires();
    assert (wires.len == 2us * 8us);
    assert (near(wires[0].from, makeVec3(-2.0f, 0.0f, 0.0f)) && near(wires[$ - 1us].to, makeVec3(2.0f, 0.0f, 0.0f)));

    path.curveKind = CurveKind::BEZIER;
    let bezier = path.editorWires();
    assert (bezier.len == 2us * 8us + 3us);
    assert (bezier[$ - 1us].faint && near(bezier[$ - 1us].from, makeVec3(1.0f, 0.0f, 0.0f)));

    path.closed = true;
    assert (path.editorWires().len == 3us * 8us + 3us);
}

__test a_path_is_framed_by_its_points {
    let dmut root = copy Root();
    let dmut path = alias line(alias root);
    let bounds = path:.bounds();
    assert (!bounds.isEmpty && near(bounds.min, makeVec3(-2.0f, 0.0f, 0.0f)) && near(bounds.max, makeVec3(2.0f, 0.0f, 0.0f)));
}
