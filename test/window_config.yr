in window_config;

use balder::core::error;
use balder::core::config::window;

use std::config::toml;

/**
 * The [window] table written in `text`
 * */
fn window(text: [c8])-> WindowConfig
    throws BalderError
{
    {
        WindowConfig(toml::parse(text))
    } catch {
        b: &BalderError => throw b;
        _ => throw copy BalderError("Malformed test configuration " ~ text);
    }
}

/**
 * @returns: true if `text` contains `sub`
 * */
fn contains(text: [c8], sub: [c8])-> bool {
    if sub.len > text.len { return false; }
    for i in 0us .. (text.len - sub.len + 1us) {
        if text[i .. i + sub.len] == sub { return true; }
    }

    false
}

/**
 * @returns: true if reading the [window] table written in `text` throws a BalderError naming `entry`
 * */
fn rejects(text: [c8], entry: [c8])-> bool {
    {
        window(text);
        false
    } catch {
        b: &BalderError => {
            contains(b.msg, entry)
        }
    }
}

__test default_size_in_pixels {
    let cfg = window("");
    assert (cfg.width.resolve(4000u32) == 1024u32);
    assert (cfg.height.resolve(4000u32) == 768u32);
}

/**
 * (display length, expected size): a plain integer ignores the display
 * */
@parameters ((yield c for c in [(0u32, 1280u32), (800u32, 1280u32), (3840u32, 1280u32)]))
__test pixels_ignore_the_display (display: u32, expected: u32) {
    let cfg = window("width = 1280\nheight = 720");
    assert (cfg.width.resolve(display) == expected);
    assert (cfg.height.resolve(display) == 720u32);
}

/**
 * (display length, expected size) of {relative = 0.6, min = 800, max = 1920}
 * */
@parameters ((yield c for c in [(1000u32, 800u32),
                                (1920u32, 1152u32),
                                (2560u32, 1536u32),
                                (3840u32, 1920u32),
                                (0u32, 800u32)]))
__test relative_is_clamped (display: u32, expected: u32) {
    let cfg = window("width = {relative = 0.6, min = 800, max = 1920}");
    assert (cfg.width.resolve(display) == expected);
}

__test relative_rounds_to_nearest {
    let cfg = window("width = {relative = 0.5}");
    assert (cfg.width.resolve(1001u32) == 501u32);
    assert (cfg.width.resolve(1000u32) == 500u32);
}

__test relative_without_bounds {
    let cfg = window("width = {relative = 1}\nheight = {relative = 0.25}");
    assert (cfg.width.relative == 1.0);
    assert (cfg.width.resolve(1920u32) == 1920u32);
    assert (cfg.height.resolve(1080u32) == 270u32);
}

__test relative_defaults_to_the_whole_display {
    let cfg = window("width = {max = 1000}");
    assert (cfg.width.relative == 1.0);
    assert (cfg.width.resolve(800u32) == 800u32);
    assert (cfg.width.resolve(1500u32) == 1000u32);
}

/**
 * (configuration, entry the error must name)
 * */
@parameters ((yield c for c in [("width = {relative = 0}", "width.relative"),
                                ("width = {relative = 1.5}", "width.relative"),
                                ("height = {relative = -0.5}", "height.relative"),
                                ("width = {relative = \"half\"}", "width.relative"),
                                ("width = {relative = 0.5, min = 900, max = 800}", "width"),
                                ("height = {min = 0}", "height.min"),
                                ("height = {max = -1}", "height.max"),
                                ("width = {max = 1.5}", "width.max"),
                                ("width = {min = 3000000000}", "width.min"),
                                ("width = {relativ = 0.5}", "width.relativ"),
                                ("width = 0", "width"),
                                ("height = -720", "height"),
                                ("width = \"big\"", "width"),
                                ("width = 0.5", "width")]))
__test malformed_size_throws (text: [c8], entry: [c8]) {
    assert (rejects(text, entry));
}
