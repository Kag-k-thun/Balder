in primitive_meshes;

use balder::math::vector;
use balder::scene::node::node3D::visual::{array, primitive};

/**
 * @returns: true iif two numbers are within a millionth of each other
 * */
fn near(a: f32, b: f32)-> bool {
    (a - b) < 1.0e-5f && (b - a) < 1.0e-5f
}

/**
 * @returns: true iif two vectors are within a millionth of each other
 * */
fn near(a: vec3, b: vec3)-> bool {
    near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z)
}

/**
 * @returns: true iif every triangle of a mesh of some area faces away from a point inside it
 * */
fn facesAwayFrom(mesh: (MeshArray, [u32]), inside: vec3)-> bool {
    let (array, indices) = mesh;
    let p = array.positions;
    for t in 0us .. indices.len / 3us {
        let a = p[indices[3us * t]], b = p[indices[3us * t + 1us]], c = p[indices[3us * t + 2us]];
        let n = (b - a).cross(c - a);
        if n.length() > 1.0e-6f && n.dot((a + b + c) / 3.0f - inside) <= 0.0f {
            return false;
        }
    }

    true
}

__test a_cube_fills_the_unit_box_standing_on_its_origin {
    let (array, indices) = cubeMesh();
    let box = array.aabb();

    assert (near(box.min, makeVec3(-0.5f, 0.0f, -0.5f)) && near(box.max, makeVec3(0.5f, 1.0f, 0.5f)));
    assert (array.positions.len == 24us && array.normals.len == 24us);
    assert (indices.len == 36us);
}

__test the_triangles_of_a_cube_face_outward {
    assert (facesAwayFrom(cubeMesh(), makeVec3(0.0f, 0.5f, 0.0f)));
}

__test a_sphere_is_one_unit_wide_on_its_origin {
    let (array, indices) = sphereMesh(rings-> 8u32, segments-> 16u32);
    let box = array.aabb();

    assert (near(box.min.y, 0.0f) && near(box.max.y, 1.0f));
    assert (near(box.max.x, 0.5f) && near(box.min.x, -0.5f));
    assert (indices.len == 8us * 16us * 6us);
    for i, n in array.normals {
        assert (near(array.positions[i], makeVec3(0.0f, 0.5f, 0.0f) + n * 0.5f));
    }
}

__test the_triangles_of_a_sphere_face_outward {
    assert (facesAwayFrom(sphereMesh(rings-> 8u32, segments-> 16u32), makeVec3(0.0f, 0.5f, 0.0f)));
}

__test a_plane_lies_at_the_base_of_the_unit_box_facing_up {
    let (array, indices) = planeMesh();
    let box = array.aabb();

    assert (near(box.min, makeVec3(-0.5f, 0.0f, -0.5f)) && near(box.max, makeVec3(0.5f, 0.0f, 0.5f)));
    assert (facesAwayFrom((array, indices), makeVec3(0.0f, -1.0f, 0.0f)));
    for n in array.normals {
        assert (near(n, makeVec3(0.0f, 1.0f, 0.0f)));
    }
}
