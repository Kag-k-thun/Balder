in tree_expansion;

use balder::interface::widget::tree::expansion;

/**
 * @returns: a tree of three nodes on its first level, expanded to show the rows:
 * 0 [0], 1 [1], 2 [1, 0], 3 [1, 1], 4 [1, 1, 0], 5 [1, 1, 1], 6 [1, 2], 7 [2]
 * */
fn sample()-> dmut &TreeExpansion {
    let dmut e = TreeExpansion(count-> 3us);
    e:.expandNode(copy [1us], 3us);
    e:.expandNode(copy [1us, 1us], 2us);
    alias e
}

__test the_rows_of_the_first_level {
    let e = TreeExpansion(count-> 1000000us);
    assert (e.getRowCount() == 1000000us);
    assert (e.pathOf(999999us) == copy [999999us]);
    assert (e.rowOf(copy [42us]) == (42us)?);
    assert (!e.rowOf(copy [1000000us]).hasValue && !e.rowOf([]).hasValue);
}

__test the_rows_follow_the_nodes_expanded {
    let e = sample();
    assert (e.getRowCount() == 8us);

    let paths = copy [copy [0us], copy [1us], copy [1us, 0us], copy [1us, 1us], copy [1us, 1us, 0us], copy [1us, 1us, 1us],
                      copy [1us, 2us], copy [2us]];
    for row, p in paths {
        assert (e.pathOf(row) == p);
        assert (e.rowOf(p) == (row)?);
    }

    // a node under a node collapsed has no row
    assert (!e.rowOf(copy [0us, 0us]).hasValue && !e.rowOf(copy [1us, 0us, 0us]).hasValue);
    assert (e.isExpanded(copy [1us, 1us]) && !e.isExpanded(copy [1us, 0us]) && e.isExpanded([]));
}

__test expanding_gives_the_rows_inserted {
    let dmut e = alias sample();
    assert (e:.expandNode(copy [2us], 4us) == (8us, 4us)?);
    assert (e:.expandNode(copy [0us], 2us) == (1us, 2us)?);
    assert (e.getRowCount() == 14us && e.pathOf(3us) == copy [1us] && e.pathOf(13us) == copy [2us, 3us]);

    // a node expanded, without children, hidden or past its siblings is not expanded
    assert (!e:.expandNode(copy [0us], 2us).hasValue);
    assert (!e:.expandNode(copy [1us, 0us], 0us).hasValue);
    assert (!e:.expandNode(copy [1us, 0us, 0us], 2us).hasValue);
    assert (!e:.expandNode(copy [3us], 2us).hasValue);
    assert (e.getRowCount() == 14us);
}

__test collapsing_hides_the_rows_under_the_node {
    let dmut e = alias sample();
    assert (e:.collapseNode(copy [1us]) == (2us, 5us)?);
    assert (e.getRowCount() == 3us && e.pathOf(2us) == copy [2us]);

    // the nodes expanded under it are forgotten
    assert (e:.expandNode(copy [1us], 3us) == (2us, 3us)?);
    assert (!e.isExpanded(copy [1us, 1us]) && e.getRowCount() == 6us);
    assert (!e:.collapseNode(copy [0us]).hasValue);
}

__test the_nodes_changed_are_read_again {
    let dmut e = alias sample();

    // the node [1] has a single child left, its child [1, 1] being collapsed
    e:.update(|p| { if p.len == 0us { 3us } else if p == copy [1us] { 1us } else { 2us } });
    assert (e.getRowCount() == 4us && !e.isExpanded(copy [1us, 1us]));

    e:.reset(2us);
    assert (e.getRowCount() == 2us && !e.isExpanded(copy [1us]));
}
