in frame_series;

use balder::interface::widget::graph;

/**
 * @returns: the values held by a series, the oldest first
 * */
fn values(s: FrameSeries)-> [f32] {
    let mut result: [f32] = [];
    for i in 0us .. s.len() {
        result ~= [s.get(i)];
    }

    result
}

__test an_empty_series {
    let s = FrameSeries(4us);
    assert (s.len() == 0us);
    assert (s.last() == 0.0f);
    assert (s.scale(16.0f) == 16.0f);
    assert (s.scale(0.0f) == 0.0f);
}

__test a_series_keeps_its_values_in_order_until_it_is_full {
    let mut s = FrameSeries(4us);
    s:.push(1.0f);
    s:.push(2.0f);
    s:.push(3.0f);

    assert (values(s) == [1.0f, 2.0f, 3.0f]);
    assert (s.last() == 3.0f);
}

__test a_full_series_drops_its_oldest_values {
    let mut s = FrameSeries(3us);
    for v in [1.0f, 2.0f, 3.0f, 4.0f, 5.0f] {
        s:.push(v);
    }

    assert (s.len() == 3us);
    assert (values(s) == [3.0f, 4.0f, 5.0f]);
    assert (s.last() == 5.0f);
}

__test the_scale_of_a_series_is_its_largest_value_or_the_reference {
    let mut s = FrameSeries(3us);
    for v in [9.0f, 2.0f, 3.0f, 4.0f] {
        s:.push(v);
    }

    // 9 was dropped
    assert (s.scale(0.0f) == 4.0f);
    assert (s.scale(16.6f) == 16.6f);
}

__test a_series_of_no_capacity_holds_nothing {
    let mut s = FrameSeries(0us);
    s:.push(1.0f);
    assert (s.len() == 0us);
    assert (s.last() == 0.0f);
}
