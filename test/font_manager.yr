in font_manager;

use balder::core::error;
use balder::interface::font;
use balder::interface::font::{chain, face, family, registry, shaper};

def NOTO = "res:/fonts/noto/NotoSans-Regular.ttf";

/**
 * (font size, pixel ratio, pixel size)
 * */
@parameters ((yield c for c in [(12u32, 1.0f, 12u32),
                                (12u32, 1.5f, 18u32),
                                (13u32, 1.25f, 16u32),
                                (16u32, 2.0f, 32u32),
                                (12u32, 0.01f, 1u32)]))
__test pixel_size (fontSize: u32, ratio: f32, expected: u32) {
    let m = copy FontManager();
    assert (m.getPixelSize(fontSize, pixelRatio-> ratio) == expected);
}

__test faces_are_reused {
    let dmut m = copy FontManager();
    let a = m:.loadFace(NOTO).getUniqId();
    let b = m:.loadFace(NOTO).getUniqId();
    assert (a == b);
}

__test missing_font_throws {
    let dmut m = copy FontManager();
    let thrown = {
        m:.loadFace("res:/fonts/missing.ttf");
        false
    } catch {
        _ : &BalderError => { true }
    };

    assert (thrown);
}

__test shapes_at_the_pixel_ratio {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let single = m:.shape("Balder", alias c, 16u32);
    let double = m:.shape("Balder", alias c, 16u32, pixelRatio-> 2.0f);
    assert (single.pixelSize == 16u32);
    assert (double.pixelSize == 32u32);
    assert (double.width > single.width * 1.9f && double.width < single.width * 2.1f);
}

__test chains_are_shared {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut a = m:.getChain(copy ["Noto Sans"], weight-> 700u32);
    let dmut b = m:.getChain(copy ["Noto Sans"], weight-> 700u32);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    assert (a is b);
    assert (!(a is c));
    assert (a:.getPrimary().path.file() == "NotoSans-Bold.ttf");
}

__test registry_changes_renew_the_chains {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut a = m:.getChain(copy ["Title"]);
    m:.getRegistry():.registerFile(NOTO, family-> "Title");
    let dmut b = m:.getChain(copy ["Title"]);
    assert (!(a is b));
    assert (b:.getPrimary().path.file() == "NotoSans-Regular.ttf");
}
