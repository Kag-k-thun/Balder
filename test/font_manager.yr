in font_manager;

use balder::core::error;
use balder::interface::font;
use balder::interface::font::{face, shaper};

def NOTO = "res:/fonts/noto/NotoSans-Regular.ttf";

/**
 * (font size, pixel ratio, pixel size)
 * */
@parameters ((yield c for c in [(12u32, 1.0f, 12u32),
                                (12u32, 1.5f, 18u32),
                                (13u32, 1.25f, 16u32),
                                (16u32, 2.0f, 32u32),
                                (12u32, 0.01f, 1u32)]))
__test pixel_size (fontSize: u32, ratio: f32, expected: u32) {
    let m = copy FontManager();
    assert (m.getPixelSize(fontSize, pixelRatio-> ratio) == expected);
}

__test faces_are_reused {
    let dmut m = copy FontManager();
    let a = m:.loadFace(NOTO).getUniqId();
    let b = m:.loadFace(NOTO).getUniqId();
    assert (a == b);
}

__test missing_font_throws {
    let dmut m = copy FontManager();
    let thrown = {
        m:.loadFace("res:/fonts/missing.ttf");
        false
    } catch {
        _ : &BalderError => { true }
    };

    assert (thrown);
}

__test shapes_at_the_pixel_ratio {
    let dmut m = copy FontManager();
    let single = m:.shape("Balder", NOTO, 16u32);
    let double = m:.shape("Balder", NOTO, 16u32, pixelRatio-> 2.0f);
    assert (single.pixelSize == 16u32);
    assert (double.pixelSize == 32u32);
    assert (double.width > single.width * 1.9f && double.width < single.width * 2.1f);
}
