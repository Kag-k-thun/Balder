in font_manager;

use balder::core::error;
use balder::interface::font;
use balder::interface::font::{chain, face, family, registry, shaper};

def NOTO = "res:/fonts/noto/NotoSans-Regular.ttf";

/**
 * (font size, pixel ratio, pixel size)
 * */
@parameters ((yield c for c in [(12u32, 1.0f, 12u32),
                                (12u32, 1.5f, 18u32),
                                (13u32, 1.25f, 16u32),
                                (16u32, 2.0f, 32u32),
                                (12u32, 0.01f, 1u32)]))
__test pixel_size (fontSize: u32, ratio: f32, expected: u32) {
    let m = copy FontManager();
    assert (m.getPixelSize(fontSize, pixelRatio-> ratio) == expected);
}

__test faces_are_reused {
    let dmut m = copy FontManager();
    let a = m:.loadFace(NOTO).getUniqId();
    let b = m:.loadFace(NOTO).getUniqId();
    assert (a == b);
}

__test missing_font_throws {
    let dmut m = copy FontManager();
    let thrown = {
        m:.loadFace("res:/fonts/missing.ttf");
        false
    } catch {
        _ : &BalderError => { true }
    };

    assert (thrown);
}

__test shapes_at_the_pixel_ratio {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let single = m:.shape("Balder", alias c, 16u32);
    let double = m:.shape("Balder", alias c, 16u32, pixelRatio-> 2.0f);
    assert (single.pixelSize == 16u32);
    assert (double.pixelSize == 32u32);
    assert (double.width > single.width * 1.9f && double.width < single.width * 2.1f);
}

__test chains_are_shared {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut a = m:.getChain(copy ["Noto Sans"], weight-> 700u32);
    let dmut b = m:.getChain(copy ["Noto Sans"], weight-> 700u32);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    assert (a is b);
    assert (!(a is c));
    assert (a:.getPrimary().path.file() == "NotoSans-Bold.ttf");
}

__test registry_changes_renew_the_chains {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut a = m:.getChain(copy ["Title"]);
    m:.getRegistry():.registerFile(NOTO, family-> "Title");
    let dmut b = m:.getChain(copy ["Title"]);
    assert (!(a is b));
    assert (b:.getPrimary().path.file() == "NotoSans-Regular.ttf");
}

__test lays_out_a_line_as_its_shaped_run {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let run = m:.shape("Balder engine", alias c, 16u32);
    let text = m:.layout("Balder engine", alias c, 16u32);
    assert (text.lines.len == 1us);
    assert (text.lines[0].run.glyphs.len == run.glyphs.len);
    for i, g in run.glyphs {
        assert (text.lines[0].run.glyphs[i].glyph == g.glyph && text.lines[0].run.glyphs[i].x == g.x);
    }
    assert (text.width == run.width);
    assert (text.height == run.getHeight());
}

__test breaks_lines_at_the_line_breaks {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let text = m:.layout("first line\nsecond", alias c, 16u32);
    assert (text.lines.len == 2us);
    assert (text.lines[0].start == 0us && text.lines[0].end == 10us);
    assert (text.lines[1].start == 11us && text.lines[1].end == 17us);
    assert (text.lines[1].y == text.lines[0].run.metrics.height);
    assert (text.width == text.lines[0].run.width);
}

__test wraps_lines_to_a_width {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let words = m:.shape("one two", alias c, 16u32, pixelRatio-> 2.0f);
    let text = m:.layout("one two three", alias c, 16u32, pixelRatio-> 2.0f, maxWidth-> words.width + 1.0f);
    assert (text.lines.len == 2us);
    assert (text.lines[0].end == 7us && text.lines[1].start == 8us);
    assert (text.lines[0].run.pixelSize == 32u32);

    // each line is shaped on its own
    assert (text.lines[0].run.width == words.width);
    for l in text.lines {
        assert (l.run.width <= words.width + 1.0f);
    }
}

/**
 * (alignment, the part of its free space put on the left of a line)
 * */
@parameters ((yield c for c in [(0.0f, 0.0f),    // left
                                (0.5f, 0.5f),    // center
                                (1.0f, 1.0f)]))  // right
__test wrapped_lines_are_aligned (align: f32, part: f32) {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let words = m:.shape("a wide line", alias c, 16u32);
    let text = m:.layout("a wide line of a few words, then a short one", alias c, 16u32, maxWidth-> words.width + 1.0f, align-> align);
    assert (text.lines.len > 2us);

    let mut narrower = false;
    for l in text.lines {
        let free = text.width - l.run.width;
        assert (free >= 0.0f);
        assert (l.x == free * part);
        if align == 0.0f { assert (l.x == 0.0f); }
        if align == 1.0f { assert (l.x + l.run.width == text.width); }
        narrower = narrower || free > 1.0f;
    }

    // the lines do not all have the width of the widest, or the alignment would not show
    assert (narrower);
}

__test measures_the_widest_word_of_all_the_paragraphs {
    let dmut m = copy FontManager(systemDirs-> []);
    let dmut c = m:.getChain(copy ["Noto Sans"]);
    let widest = m:.shape("paragraphs", alias c, 16u32, pixelRatio-> 2.0f);
    let width = m:.measureMinContent("two\nshort paragraphs", alias c, 16u32, pixelRatio-> 2.0f);
    assert (width == widest.width);
}
